uncorrelated SQ, 3-way join
the number of buffer refills > partial join size of t3, move
join_tab->cache_select->cond to t3
set @@join_buffer_size=128;
explain extended
SELECT count(*)
FROM t1 straight_join t2 straight_join t3
WHERE a1 = b1 and b2 = c1 and c2 < '6' and c3 < '4' and c4 < '2' and
b2 <= (select count(*) from sq where s1 > 0);
