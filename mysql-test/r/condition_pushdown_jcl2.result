3	SUBQUERY	t1	ALL	NULL	NULL	NULL	NULL	2	100.00	
Warnings:
Note	1003	select `test`.`t1a`.`x` AS `x`,`test`.`t1a`.`y` AS `y`,`test`.`t1`.`x` AS `x`,`test`.`t1`.`y` AS `y` from `test`.`t1` `t1a` join `test`.`t1` where ((`test`.`t1a`.`x` = (select sum(`test`.`t1`.`x`) from `test`.`t1`)) or (`test`.`t1a`.`x` <= `test`.`t1a`.`y`))
SELECT * FROM t1 t1a, ( SELECT * FROM t1 ) AS t1b 
WHERE t1a.x = ( SELECT SUM(x) FROM t1 ) OR t1a.x <= t1a.y;
