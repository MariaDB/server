--source include/have_sequence.inc
--source include/not_embedded.inc

--echo #
--echo # MDEV-38975: Blob/text operations exercising HEAP internal temp tables
--echo #

CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, k INT, text_col TEXT);
INSERT INTO t1 (k, text_col) VALUES
  (1, 'alpha'), (1, 'alpha '), (1, 'beta'),
  (2, 'gamma'), (2, 'gamma '), (2, 'delta'),
  (3, 'alpha'), (3, 'epsilon'), (3, NULL),
  (4, NULL), (4, NULL), (4, 'beta');

--echo #
--echo # COUNT(DISTINCT text_col)
--echo #
SELECT COUNT(DISTINCT text_col) FROM t1;

--echo #
--echo # COUNT(DISTINCT text_col) with GROUP BY
--echo #
SELECT k, COUNT(DISTINCT text_col) FROM t1 GROUP BY k ORDER BY k;

--echo #
--echo # IN-subquery with blob/text
--echo #
CREATE TABLE t2 (text_col TEXT);
INSERT INTO t2 VALUES ('alpha'), ('delta');
SELECT id, text_col FROM t1 WHERE text_col IN (SELECT text_col FROM t2) ORDER BY id;

--echo #
--echo # GROUP BY text_col ORDER BY aggregate LIMIT
--echo #
SELECT text_col, COUNT(*) AS cnt FROM t1 GROUP BY text_col ORDER BY cnt DESC, text_col LIMIT 3;

--echo #
--echo # GROUP BY text_col WITH ROLLUP
--echo #
--sorted_result
SELECT text_col, COUNT(*) FROM t1 GROUP BY text_col WITH ROLLUP;

--echo #
--echo # GROUP BY multiple columns WITH ROLLUP
--echo #
--sorted_result
SELECT k, text_col, COUNT(*) FROM t1 GROUP BY k, text_col WITH ROLLUP;

--echo #
--echo # Window function with blob in SELECT list
--echo #
SELECT id, text_col, ROW_NUMBER() OVER (PARTITION BY k ORDER BY id) AS rn
FROM t1 WHERE k <= 2 ORDER BY id;

--echo #
--echo # RANK with blob column
--echo #
SELECT text_col, k, RANK() OVER (ORDER BY text_col) AS rnk
FROM t1 WHERE text_col IS NOT NULL ORDER BY text_col, k, id;

--echo #
--echo # Non-recursive CTE materializing blob column
--echo #
WITH cte AS (SELECT text_col, k FROM t1 WHERE k <= 2)
SELECT DISTINCT text_col FROM cte ORDER BY text_col;

--echo #
--echo # CTE with self-join on blob column
--echo #
WITH cte AS (SELECT text_col, k FROM t1 WHERE text_col IS NOT NULL)
SELECT COUNT(*) FROM cte a JOIN cte b ON a.k = b.k AND a.text_col = b.text_col;

--echo #
--echo # CTE referenced twice (forces materialization)
--echo #
WITH cte AS (SELECT DISTINCT text_col FROM t1 WHERE text_col IS NOT NULL)
SELECT a.text_col, b.text_col
FROM cte a JOIN cte b ON a.text_col > b.text_col ORDER BY a.text_col, b.text_col;

DROP TABLE t1, t2;

--echo #
--echo # PAD SPACE: COUNT(DISTINCT) on TEXT with trailing-space variants
--echo # PAD SPACE collations (latin1 default) treat trailing spaces as
--echo # insignificant, so 'abc' and 'abc   ' are the same value.
--echo #
CREATE TABLE t_pad (id INT AUTO_INCREMENT PRIMARY KEY, t TEXT);
INSERT INTO t_pad (t) VALUES ('abc'), ('abc   '), ('abc      '), ('def'), ('def  ');
--echo # Must return 2 (not 5): 'abc' variants = 1 group, 'def' variants = 1 group
SELECT COUNT(DISTINCT t) FROM t_pad;
DROP TABLE t_pad;

--echo #
--echo # GROUP BY text_col must use HEAP (not Aria) for internal tmp tables
--echo #
CREATE TABLE t_grp (id INT AUTO_INCREMENT PRIMARY KEY, t TEXT);
INSERT INTO t_grp (t) VALUES ('alpha'), ('alpha'), ('beta'), ('gamma'), ('gamma');
FLUSH STATUS;
SELECT t, COUNT(*) AS cnt FROM t_grp GROUP BY t ORDER BY t;
SHOW STATUS LIKE 'Created_tmp_disk_tables';

--echo #
--echo # DISTINCT text_col must use HEAP (not Aria) for internal tmp tables
--echo #
FLUSH STATUS;
SELECT DISTINCT t FROM t_grp ORDER BY t;
SHOW STATUS LIKE 'Created_tmp_disk_tables';

--echo #
--echo # GROUP BY text_col with PAD SPACE trailing-space data
--echo # PAD SPACE collations collapse 'abc' and 'abc   ' into one group
--echo #
CREATE TABLE t_grp_pad (id INT AUTO_INCREMENT PRIMARY KEY, t TEXT);
INSERT INTO t_grp_pad (t) VALUES ('abc'), ('abc   '), ('abc      '), ('def'), ('def  ');
FLUSH STATUS;
--echo # Must return 2 groups, not 5
SELECT t, COUNT(*) AS cnt FROM t_grp_pad GROUP BY t ORDER BY t;
SHOW STATUS LIKE 'Created_tmp_disk_tables';
DROP TABLE t_grp, t_grp_pad;

--echo #
--echo # MDEV-41297 Wrong result upon DISTINCT/GROUP BY/UNION on TEXT with
--echo # empty and all-space values
--echo #
--echo # PAD SPACE: an empty value and an all-space value are one value.
--echo # A stored empty value has no data of its own, and must still
--echo # compare equal to the other one, whichever of the two is stored.
--echo #
CREATE TABLE t_empty (id INT AUTO_INCREMENT PRIMARY KEY,
                      l TEXT CHARACTER SET latin1,
                      u TEXT CHARACTER SET utf8mb4);
INSERT INTO t_empty (l, u) VALUES ('', ''), ('   ', '   ');
CREATE TABLE t_empty_rev LIKE t_empty;
INSERT INTO t_empty_rev (l, u) VALUES ('   ', '   '), ('', '');
FLUSH STATUS;
--echo # Every count must be 1
SELECT COUNT(*) FROM (SELECT DISTINCT l FROM t_empty) AS d;
SELECT COUNT(*) FROM (SELECT DISTINCT u FROM t_empty) AS d;
SELECT COUNT(DISTINCT l), COUNT(DISTINCT u) FROM t_empty;
SELECT COUNT(*) FROM (SELECT l FROM t_empty GROUP BY l) AS g;
SELECT COUNT(*) FROM (SELECT u FROM t_empty GROUP BY u) AS g;
SELECT COUNT(*) FROM (SELECT l FROM t_empty WHERE LENGTH(l)=0
                      UNION SELECT l FROM t_empty WHERE LENGTH(l)=3) AS un;
SELECT COUNT(*) FROM (SELECT u FROM t_empty WHERE LENGTH(u)=0
                      UNION SELECT u FROM t_empty WHERE LENGTH(u)=3) AS un;
SELECT COUNT(*) FROM (SELECT DISTINCT l FROM t_empty_rev) AS d;
SELECT COUNT(*) FROM (SELECT DISTINCT u FROM t_empty_rev) AS d;
SELECT COUNT(DISTINCT l), COUNT(DISTINCT u) FROM t_empty_rev;
SELECT COUNT(*) FROM (SELECT l FROM t_empty_rev GROUP BY l) AS g;
SELECT COUNT(*) FROM (SELECT u FROM t_empty_rev GROUP BY u) AS g;
SELECT COUNT(*) FROM (SELECT l FROM t_empty_rev WHERE LENGTH(l)=3
                      UNION SELECT l FROM t_empty_rev WHERE LENGTH(l)=0) AS un;
SELECT COUNT(*) FROM (SELECT u FROM t_empty_rev WHERE LENGTH(u)=3
                      UNION SELECT u FROM t_empty_rev WHERE LENGTH(u)=0) AS un;
--echo # All temporary tables stayed in MEMORY
SHOW STATUS LIKE 'Created_tmp_disk_tables';
DROP TABLE t_empty, t_empty_rev;

--echo #
--echo # NO PAD: an empty value and an all-space value are two values,
--echo # whichever of the two is stored
--echo #
CREATE TABLE t_nopad (id INT AUTO_INCREMENT PRIMARY KEY,
                      n TEXT CHARACTER SET latin1
                        COLLATE latin1_swedish_nopad_ci);
INSERT INTO t_nopad (n) VALUES (''), ('   ');
CREATE TABLE t_nopad_rev LIKE t_nopad;
INSERT INTO t_nopad_rev (n) VALUES ('   '), ('');
FLUSH STATUS;
--echo # Every count must be 2
SELECT COUNT(*) FROM (SELECT DISTINCT n FROM t_nopad) AS d;
SELECT COUNT(DISTINCT n) FROM t_nopad;
SELECT COUNT(*) FROM (SELECT n FROM t_nopad GROUP BY n) AS g;
SELECT COUNT(*) FROM (SELECT n FROM t_nopad WHERE LENGTH(n)=0
                      UNION SELECT n FROM t_nopad WHERE LENGTH(n)=3) AS un;
SELECT COUNT(*) FROM (SELECT DISTINCT n FROM t_nopad_rev) AS d;
SELECT COUNT(DISTINCT n) FROM t_nopad_rev;
SELECT COUNT(*) FROM (SELECT n FROM t_nopad_rev GROUP BY n) AS g;
SELECT COUNT(*) FROM (SELECT n FROM t_nopad_rev WHERE LENGTH(n)=3
                      UNION SELECT n FROM t_nopad_rev WHERE LENGTH(n)=0) AS un;
--echo # All temporary tables stayed in MEMORY
SHOW STATUS LIKE 'Created_tmp_disk_tables';
DROP TABLE t_nopad, t_nopad_rev;

--echo # End of MDEV-38975 blob operations tests
