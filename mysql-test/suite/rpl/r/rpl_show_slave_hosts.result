include/master-slave.inc
[connection master]
connect  slave2,127.0.0.1,root,,test,$SLAVE_MYPORT2,;
connection slave2;
RESET SLAVE;
CHANGE MASTER TO master_host='127.0.0.1',master_port=MASTER_PORT,master_user='root', master_ssl_verify_server_cert=0;
START SLAVE IO_THREAD;
include/wait_for_slave_io_to_start.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
3	slave2	SLAVE_PORT	1	master-bin.000001:330	NULL
2	localhost	SLAVE_PORT	1	master-bin.000001:330	NULL
connection slave2;
include/stop_slave_io.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
2	localhost	SLAVE_PORT	1	master-bin.000001:330	NULL
include/rpl_end.inc
