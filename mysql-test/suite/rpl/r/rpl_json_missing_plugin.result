include/master-slave.inc
[connection master]
connection slave;
include/stop_slave.inc
connection master;
include/rpl_stop_server.inc [server_number=1]
include/rpl_start_server.inc [server_number=1]
connection slave;
CHANGE MASTER TO Master_log_file='master-bin.000001', Master_log_pos=4, Master_use_gtid=No;
call mtr.add_suppression("plugin needed to decode it is not installed");
call mtr.add_suppression("Slave SQL.*Error executing row event");
START SLAVE;
include/wait_for_slave_sql_error.inc [errno=4254]
# Slave stopped, Last_SQL_Error names the missing plugin:
# Table structure for binlog event is not compatible with the table definition on this slave: In RBR mode, Slave received a MySQL binary JSON column (type 245) for column Name: testdb.tj.j, but the MYSQL_JSON plugin needed to decode it is not installed. Run INSTALL SONAME 'type_mysql_json' on the slave.
#
# The table exists (DDL applied) but holds no rows - the row event
# that needed the plugin never got that far.
SELECT * FROM testdb.tj;
id	j
connection slave;
STOP SLAVE IO_THREAD;
include/wait_for_slave_io_to_stop.inc
DROP DATABASE testdb;
CHANGE MASTER TO Master_log_file='master-bin.000002', Master_log_pos=4, Master_use_gtid=No;
START SLAVE;
connection master;
connection slave;
include/rpl_end.inc
