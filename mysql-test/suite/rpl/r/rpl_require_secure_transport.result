include/master-slave.inc
[connection master]
#
# MDEV-40530 Bind the client authentication response to the server certificate
#
connection master;
call mtr.add_suppression("Invalid ssl_info_client from 'repl'@'localhost': malformed");
create user repl@'%' identified by 'pw';
grant replication slave on *.* to repl@'%';
create table t1 (a int);
set global require_secure_transport=on;
connection slave;
call mtr.add_suppression("Slave I/O: Master command COM_REGISTER_SLAVE failed");
include/stop_slave.inc
# the replica has verified the master certificate
change master to master_user='repl', master_password='pw', master_ssl=1,
master_ssl_verify_server_cert=1,
master_ssl_ca='MYSQL_TEST_DIR/std_data/cacert.pem';
include/start_slave.inc
connection master;
insert t1 values (1);
connection slave;
select * from t1;
a
1
include/stop_slave.inc
# the replica does not verify the master certificate
change master to master_ssl_verify_server_cert=0, master_ssl_ca='';
include/start_slave.inc
connection master;
insert t1 values (2);
connection slave;
select * from t1;
a
1
2
include/stop_slave.inc
# no password hash to prove anything with
change master to master_user='root', master_password='';
start slave io_thread;
include/wait_for_slave_io_error.inc [errno=3159]
include/stop_slave_io.inc
# MitM cannot use the replica connection
>> MitM active <<
change master to master_user='repl', master_password='pw',
master_port=MITM_PORT, master_connect_retry=1;
start slave io_thread;
include/wait_for_slave_io_error.inc [errno=2003, 2013, 3159]
include/stop_slave_io.inc
connection master;
show tables like 'hijacked';
Tables_in_test (hijacked)
set global require_secure_transport=off;
connection slave;
change master to master_user='root', master_password='', master_port=MASTER_PORT,
master_ssl_verify_server_cert=0, master_connect_retry=60;
include/start_slave.inc
connection master;
drop table t1;
drop user repl@'%';
include/rpl_end.inc
# End of 11.4 tests
