# Bug#55478 Row events wrongly apply on the temporary table of the same name
# ==========================================================================
connection master;
# The statement should be binlogged
CREATE TEMPORARY TABLE t1(c1 INT) ENGINE=InnoDB;

# Case 1: CREATE TABLE t1 ... SELECT
# ----------------------------------

# The statement generates row events on t1. And the rows events should
# be inserted into the base table on slave.
CREATE TABLE t1 ENGINE=MyISAM SELECT rand();
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
master-bin.000001	#	Query	#	#	use `test`; CREATE TABLE `t1` (
  `rand()` double NOT NULL
) ENGINE=MyISAM
master-bin.000001	#	Annotate_rows	#	#	CREATE TABLE t1 ENGINE=MyISAM SELECT rand()
master-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
master-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
master-bin.000001	#	Query	#	#	COMMIT

# Case 2: DROP TEMPORARY TABLE in a transaction
# ----------------------------------------------

BEGIN;
DROP TEMPORARY TABLE t1;
# The rows event will binlogged after 'INSERT INTO t1 VALUES(1)'
INSERT IGNORE INTO t1 VALUES(SYS_GUID()+0);
COMMIT;
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
master-bin.000001	#	Annotate_rows	#	#	INSERT IGNORE INTO t1 VALUES(SYS_GUID()+0)
master-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
master-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
master-bin.000001	#	Query	#	#	COMMIT
master-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
master-bin.000001	#	Query	#	#	DROP TEMPORARY TABLE IF EXISTS `test`.`t1` /* generated by server */
master-bin.000001	#	Query	#	#	COMMIT
connection slave;
# Compare the base table.
include/diff_tables.inc [master:t1, slave:t1]

connection master;
DROP TABLE t1;
#
# MDEV-40860 INSERT/REPLACE ... SELECT into temporary table may cause
# silent master/slave divergence
#
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE t2 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1,101),(2,202),(3,303);
# REPLACE ... SELECT is unsafe, so it is not binlogged. tmp is then not
# up to date in the binlog, and the INSERT reading it must be row logged.
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO tmp VALUES (1,10),(2,20);
REPLACE INTO tmp SELECT id, v + 1 FROM t2;
INSERT INTO t1 SELECT * FROM tmp;
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
master-bin.000001	#	Annotate_rows	#	#	INSERT INTO t1 SELECT * FROM tmp
master-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
master-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
master-bin.000001	#	Xid	#	#	COMMIT /* XID */
DROP TEMPORARY TABLE tmp;
connection slave;
include/diff_tables.inc [master:t1, slave:t1]
connection master;
DELETE FROM t1;
# INSERT IGNORE ... SELECT
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO tmp VALUES (1,10),(2,20);
INSERT IGNORE INTO tmp SELECT id, v + 1 FROM t2;
Warnings:
Warning	1062	Duplicate entry '1' for key 'PRIMARY'
Warning	1062	Duplicate entry '2' for key 'PRIMARY'
INSERT INTO t1 SELECT * FROM tmp;
DROP TEMPORARY TABLE tmp;
connection slave;
include/diff_tables.inc [master:t1, slave:t1]
connection master;
DELETE FROM t1;
# INSERT ... SELECT ... ON DUPLICATE KEY UPDATE
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO tmp VALUES (1,10),(2,20);
INSERT INTO tmp SELECT id, v + 1 FROM t2 ON DUPLICATE KEY UPDATE v= VALUES(v);
INSERT INTO t1 SELECT * FROM tmp;
DROP TEMPORARY TABLE tmp;
connection slave;
include/diff_tables.inc [master:t1, slave:t1]
connection master;
DELETE FROM t1;
# INSERT IGNORE ... SELECT that changes nothing keeps tmp up to date,
# so the INSERT reading it is still logged as a statement.
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO tmp VALUES (1,10),(2,20),(3,30);
INSERT IGNORE INTO tmp SELECT id, v + 1 FROM t2;
Warnings:
Warning	1062	Duplicate entry '1' for key 'PRIMARY'
Warning	1062	Duplicate entry '2' for key 'PRIMARY'
Warning	1062	Duplicate entry '3' for key 'PRIMARY'
INSERT INTO t1 SELECT * FROM tmp;
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
master-bin.000001	#	Query	#	#	use `test`; INSERT INTO t1 SELECT * FROM tmp
master-bin.000001	#	Xid	#	#	COMMIT /* XID */
DROP TEMPORARY TABLE tmp;
connection slave;
include/diff_tables.inc [master:t1, slave:t1]
connection master;
DROP TABLE t1, t2;
include/rpl_end.inc
