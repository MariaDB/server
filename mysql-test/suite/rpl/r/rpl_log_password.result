include/master-slave.inc
[connection master]
#
# MDEV-10584 Obscure plain text passwords from server logs
#
connection slave;
call mtr.add_suppression("Slave SQL: Error 'Operation CREATE USER failed");
call mtr.add_suppression("Slave: Operation CREATE USER failed");
call mtr.add_suppression("Error running query, slave SQL thread aborted");
CREATE USER u1@localhost;
connection master;
CREATE USER u1@localhost IDENTIFIED BY 'pw01';
connection slave;
include/wait_for_slave_sql_error.inc [errno=1396]
NOT FOUND /pw01/ in mysqld.2.err
FOUND 1 /IDENTIFIED BY '<secret>'/ in mysqld.2.err
SET GLOBAL sql_slave_skip_counter= 1;
include/start_slave.inc
# The binary log still carries the password
connection master;
CREATE USER u2@localhost IDENTIFIED BY 'pw02';
include/sync_slave_sql_with_master.inc
connect  slave_u2,localhost,u2,pw02,,$SLAVE_MYPORT,$SLAVE_MYSOCK;
SELECT CURRENT_USER();
CURRENT_USER()
u2@localhost
disconnect slave_u2;
connection master;
DROP USER u1@localhost, u2@localhost;
# End of 13.3 tests
include/rpl_end.inc
