include/master-slave.inc
[connection master]
connection slave;
include/stop_slave.inc
connection master;
include/rpl_stop_server.inc [server_number=1]
include/rpl_start_server.inc [server_number=1]
connection slave;
CREATE DATABASE testdb;
CREATE TABLE testdb.tj (id INT PRIMARY KEY, j VARCHAR(10));
SET GLOBAL slave_type_conversions= 'ALL_NON_LOSSY';
CHANGE MASTER TO Master_log_file='master-bin.000001', Master_log_pos=799, Master_use_gtid=No;
call mtr.add_suppression("Column .* of table .* cannot be converted");
call mtr.add_suppression("Slave SQL.*Error executing row event");
START SLAVE;
include/wait_for_slave_sql_error.inc [errno=1677]
# Slave stopped, Last_SQL_Error matches the expected refusal:
# Column 1 of table 'testdb.tj' cannot be converted from type 'MYSQL_JSON' to type 'varchar(40 octets) character set utf8mb4'
#
# Nothing was applied - the table is still empty, not holding a
# silently truncated value.
SELECT * FROM testdb.tj;
id	j
connection slave;
STOP SLAVE IO_THREAD;
include/wait_for_slave_io_to_stop.inc
SET GLOBAL slave_type_conversions= DEFAULT;
DROP DATABASE testdb;
CHANGE MASTER TO Master_log_file='master-bin.000002', Master_log_pos=4, Master_use_gtid=No;
START SLAVE;
connection master;
connection slave;
include/rpl_end.inc
