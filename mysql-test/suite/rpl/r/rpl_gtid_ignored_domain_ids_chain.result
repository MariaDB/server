include/rpl_init.inc [topology=1->2->3]
connection server_3;
call mtr.add_suppression("Got fatal error 1236 from master when reading data from binary log");
connection server_1;
SET SESSION gtid_domain_id= 1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=InnoDB;
include/save_master_gtid.inc
connection server_2;
include/sync_with_master_gtid.inc
include/save_master_gtid.inc
connection server_3;
include/sync_with_master_gtid.inc
*** Let B and C filter away domain 2 ***
connection server_2;
include/stop_slave.inc
CHANGE MASTER TO IGNORE_DOMAIN_IDS=(2), MASTER_USE_GTID=slave_pos;
include/start_slave.inc
connection server_3;
include/stop_slave.inc
CHANGE MASTER TO IGNORE_DOMAIN_IDS=(2), MASTER_USE_GTID=slave_pos;
include/start_slave.inc
connection server_1;
SET SESSION gtid_domain_id= 1;
INSERT INTO t1 VALUES (1);
SET SESSION gtid_domain_id= 2;
INSERT INTO t2 VALUES (1);
SET SESSION gtid_domain_id= 1;
INSERT INTO t1 VALUES (2);
include/save_master_gtid.inc
connection server_2;
include/sync_with_master_gtid.inc
include/save_master_gtid.inc
connection server_3;
include/sync_with_master_gtid.inc
*** C is up to date in domain 1 and has never heard of domain 2 ***
connection server_3;
SELECT * FROM t1 ORDER BY a;
a
1
2
SELECT * FROM t2 ORDER BY a;
a
# C is not behind -- it simply has no position in domain 2, because
# B filtered that domain away and so never binlogged anything from it.
SELECT @@GLOBAL.gtid_slave_pos RLIKE '(^|,)2-' AS has_domain_2_pos;
has_domain_2_pos
0
*** B is lost; A rotates and purges its old binlogs ***
connection server_2;
include/stop_slave.inc
connection server_1;
FLUSH LOGS;
SET SESSION gtid_domain_id= 1;
INSERT INTO t1 VALUES (3);
include/wait_for_purge.inc "master-bin.000002"
*** Re-point C directly at A ***
connection server_3;
include/stop_slave.inc
include/rpl_change_topology.inc [new topology=1->2,1->3]
CHANGE MASTER TO master_host='127.0.0.1', master_port=MASTER_PORT,
MASTER_USE_GTID=slave_pos;
# Dropping the filter shows what A would otherwise answer: C has no
# position in domain 2, and A no longer has the start of that domain.
CHANGE MASTER TO IGNORE_DOMAIN_IDS=();
START SLAVE;
include/wait_for_slave_io_error.inc [errno=1236]
include/stop_slave_sql.inc
# With the domain filtered away again, C connects and catches up.
CHANGE MASTER TO IGNORE_DOMAIN_IDS=(2);
include/start_slave.inc
include/sync_with_master_gtid.inc
SELECT * FROM t1 ORDER BY a;
a
1
2
3
*** New transactions in the filtered domain do not disturb C ***
connection server_1;
SET SESSION gtid_domain_id= 2;
INSERT INTO t2 VALUES (2);
SET SESSION gtid_domain_id= 1;
INSERT INTO t1 VALUES (4);
include/save_master_gtid.inc
connection server_3;
include/sync_with_master_gtid.inc
SELECT * FROM t1 ORDER BY a;
a
1
2
3
4
SELECT * FROM t2 ORDER BY a;
a
*** Cleanup ***
connection server_3;
include/stop_slave.inc
CHANGE MASTER TO IGNORE_DOMAIN_IDS=();
include/start_slave.inc
connection server_2;
CHANGE MASTER TO IGNORE_DOMAIN_IDS=();
include/start_slave.inc
connection server_1;
SET SESSION gtid_domain_id= 0;
DROP TABLE t1, t2;
include/save_master_gtid.inc
connection server_2;
include/sync_with_master_gtid.inc
connection server_3;
include/sync_with_master_gtid.inc
include/rpl_end.inc
