include/master-slave.inc
[connection master]
connection master;
create role r1;
grant create view, select, execute on *.* to r1;
create definer=r1 procedure p1()
begin
create view v1 as select 1;
end|
call p1();
show warnings;
Level	Code	Message
show create view v1;
View	Create View	character_set_client	collation_connection
v1	CREATE ALGORITHM=UNDEFINED DEFINER=`r1` SQL SECURITY DEFINER VIEW `v1` AS select 1 AS `1`	latin1	latin1_swedish_ci
connection slave;
connection slave;
show create view v1;
View	Create View	character_set_client	collation_connection
v1	CREATE ALGORITHM=UNDEFINED DEFINER=`r1` SQL SECURITY DEFINER VIEW `v1` AS select 1 AS `1`	latin1	latin1_swedish_ci
connection master;
drop view v1;
drop procedure p1;
drop role r1;
connection slave;
connection master;
include/rpl_end.inc
