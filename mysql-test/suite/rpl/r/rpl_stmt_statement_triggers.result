#
# MDEV-41218 BEFORE COMMIT triggers with binlog_format=MIXED
#
# With binlog_format=MIXED the format is chosen for each statement,
# and a replica captures no rows from row events.  A transaction that
# captured rows for one trigger with a statement logged as a statement
# and with one logged in row format would fire the replica's trigger
# over a part of its rows.  So every statement that may capture a row
# for a BEFORE COMMIT trigger is logged in row format, here also the
# one that is safe to log as a statement, and the replica fires no
# trigger for the transaction.
connection master;
SET binlog_format= MIXED;
BEGIN;
INSERT INTO t2 VALUES (11), (12);
INSERT INTO t2 SELECT a + 20 + 0 * LENGTH(UUID()) FROM t2_src;
COMMIT;
