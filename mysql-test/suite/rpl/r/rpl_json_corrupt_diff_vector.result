include/master-slave.inc
[connection master]
connection slave;
include/stop_slave.inc
connection master;
include/rpl_stop_server.inc [server_number=1]
include/rpl_start_server.inc [server_number=1]
connection slave;
CHANGE MASTER TO Master_log_file='master-bin.000001', Master_log_pos=4, Master_use_gtid=No;
call mtr.add_suppression("the diff vector is truncated or corrupt");
call mtr.add_suppression("Slave SQL.*Error executing row event");
START SLAVE;
include/wait_for_slave_sql_error.inc [errno=1105]
# Slave stopped, Last_SQL_Error matches the expected refusal:
# Could not execute MySQL Update_rows_partial event on table jsontest.t1; Could not apply a partial JSON update to column 'j' of table 'jsontest.t1': the diff vector is truncated or corrupt, Error_code: 1105; handler error HA_ERR_CORRUPT_EVENT; the event's master log master-bin.000001, end_log_pos 1630
#
# The server is still alive and responsive - the corrupt vector did
# not crash it.
SELECT 1;
1
1
connection slave;
STOP SLAVE IO_THREAD;
include/wait_for_slave_io_to_stop.inc
DROP DATABASE jsontest;
CHANGE MASTER TO Master_log_file='master-bin.000002', Master_log_pos=4, Master_use_gtid=No;
START SLAVE;
connection master;
connection slave;
include/rpl_end.inc
