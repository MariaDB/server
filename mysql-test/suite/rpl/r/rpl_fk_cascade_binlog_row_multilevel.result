include/master-slave.inc
[connection master]
SET @old_rpl_use_binlog_events_for_fk_cascade := @@session.rpl_use_binlog_events_for_fk_cascade;
SET SESSION default_storage_engine=InnoDB;
SET SESSION binlog_format=ROW;
SET SESSION rpl_use_binlog_events_for_fk_cascade=1;
#
# Case 1: ON DELETE CASCADE through 4 levels, growing row width
#
CREATE TABLE l0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE l1 (id INT PRIMARY KEY, pid INT, pad CHAR(100) DEFAULT 'l1', KEY(pid),
FOREIGN KEY (pid) REFERENCES l0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE l2 (id INT PRIMARY KEY, pid INT, pad CHAR(200) DEFAULT 'l2', KEY(pid),
FOREIGN KEY (pid) REFERENCES l1(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE l3 (id INT PRIMARY KEY, pid INT, pad CHAR(255) DEFAULT 'l3',
pad2 CHAR(255) DEFAULT 'l3', KEY(pid),
FOREIGN KEY (pid) REFERENCES l2(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO l0 VALUES (1),(2);
INSERT INTO l1 (id,pid) VALUES (10,1),(11,1),(20,2);
INSERT INTO l2 (id,pid) VALUES (100,10),(101,10),(110,11),(200,20);
INSERT INTO l3 (id,pid) VALUES (1000,100),(1001,101),(1100,110),(2000,200);
connection slave;
connection master;
FLUSH BINARY LOGS;
DELETE FROM l0 WHERE id=1;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT id, pid FROM l1 ORDER BY id;
id	pid
20	2
SELECT id, pid FROM l2 ORDER BY id;
id	pid
200	20
SELECT id, pid FROM l3 ORDER BY id;
id	pid
2000	200
include/diff_tables.inc [master:l1, slave:l1]
include/diff_tables.inc [master:l2, slave:l2]
include/diff_tables.inc [master:l3, slave:l3]
connection master;
FLUSH BINARY LOGS;
FOUND 2 /### DELETE FROM `test`.`l1`/ in fk_cascade_multilevel.sql
FOUND 3 /### DELETE FROM `test`.`l2`/ in fk_cascade_multilevel.sql
FOUND 3 /### DELETE FROM `test`.`l3`/ in fk_cascade_multilevel.sql
DROP TABLE l3, l2, l1, l0;
connection slave;
#
# Case 2: ON UPDATE CASCADE through 3 levels
#
connection master;
CREATE TABLE u0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE u1 (id INT PRIMARY KEY, pid INT, pad CHAR(100) DEFAULT 'u1', KEY(pid),
FOREIGN KEY (pid) REFERENCES u0(id) ON UPDATE CASCADE) ENGINE=InnoDB;
CREATE TABLE u2 (id INT PRIMARY KEY, ppid INT, pad CHAR(255) DEFAULT 'u2', KEY(ppid),
FOREIGN KEY (ppid) REFERENCES u1(pid) ON UPDATE CASCADE) ENGINE=InnoDB;
INSERT INTO u0 VALUES (1),(2);
INSERT INTO u1 (id,pid) VALUES (10,1),(20,2);
INSERT INTO u2 (id,ppid) VALUES (100,1),(101,1),(200,2);
connection slave;
connection master;
UPDATE u0 SET id=5 WHERE id=1;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT id, pid FROM u1 ORDER BY id;
id	pid
10	5
20	2
SELECT id, ppid FROM u2 ORDER BY id;
id	ppid
100	5
101	5
200	2
include/diff_tables.inc [master:u1, slave:u1]
include/diff_tables.inc [master:u2, slave:u2]
connection master;
DROP TABLE u2, u1, u0;
connection slave;
#
# Case 3: CASCADE into SET NULL, and a diamond
#
connection master;
CREATE TABLE d0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE da (id INT PRIMARY KEY, pid INT, KEY(pid),
FOREIGN KEY (pid) REFERENCES d0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE db (id INT PRIMARY KEY, pid INT, KEY(pid),
FOREIGN KEY (pid) REFERENCES d0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE dc (id INT PRIMARY KEY, a_id INT, b_id INT, pad CHAR(255) DEFAULT 'dc',
KEY(a_id), KEY(b_id),
FOREIGN KEY (a_id) REFERENCES da(id) ON DELETE CASCADE,
FOREIGN KEY (b_id) REFERENCES db(id) ON DELETE SET NULL) ENGINE=InnoDB;
INSERT INTO d0 VALUES (1),(2);
INSERT INTO da VALUES (10,1),(20,2);
INSERT INTO db VALUES (10,1),(20,2);
INSERT INTO dc (id,a_id,b_id) VALUES (1,10,10),(2,20,10),(3,10,20),(4,20,20);
connection slave;
connection master;
DELETE FROM d0 WHERE id=1;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT * FROM da ORDER BY id;
id	pid
20	2
SELECT * FROM db ORDER BY id;
id	pid
20	2
SELECT id, a_id, b_id FROM dc ORDER BY id;
id	a_id	b_id
2	20	NULL
4	20	20
include/diff_tables.inc [master:da, slave:da]
include/diff_tables.inc [master:db, slave:db]
include/diff_tables.inc [master:dc, slave:dc]
connection master;
DROP TABLE dc, da, db, d0;
connection slave;
#
# Case 4: multi-level cascades in a transaction with a savepoint rollback
#
connection master;
CREATE TABLE t0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t1 (id INT PRIMARY KEY, pid INT, KEY(pid),
FOREIGN KEY (pid) REFERENCES t0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE t2 (id INT PRIMARY KEY, pid INT, pad CHAR(255) DEFAULT 't2', KEY(pid),
FOREIGN KEY (pid) REFERENCES t1(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO t0 VALUES (1),(2),(3);
INSERT INTO t1 VALUES (10,1),(20,2),(30,3);
INSERT INTO t2 (id,pid) VALUES (100,10),(200,20),(300,30);
connection slave;
connection master;
BEGIN;
DELETE FROM t0 WHERE id=1;
SAVEPOINT s1;
DELETE FROM t0 WHERE id=2;
ROLLBACK TO SAVEPOINT s1;
DELETE FROM t0 WHERE id=3;
COMMIT;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT * FROM t1 ORDER BY id;
id	pid
20	2
SELECT id, pid FROM t2 ORDER BY id;
id	pid
200	20
include/diff_tables.inc [master:t1, slave:t1]
include/diff_tables.inc [master:t2, slave:t2]
connection master;
DROP TABLE t2, t1, t0;
#
