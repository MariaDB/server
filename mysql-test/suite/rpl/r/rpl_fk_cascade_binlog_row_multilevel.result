#
# Case 7: a self-referencing foreign key. The child is the table the
# statement itself changes, through its own instance opened for the
# foreign key.
#
connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, pad CHAR(100) DEFAULT 's',
KEY(parent_id),
FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO s (id, parent_id) VALUES (1,NULL),(2,1),(3,2),(4,2),(5,NULL),(6,5);
connection slave;
connection master;
FLUSH BINARY LOGS;
DELETE FROM s WHERE id=1;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
id	parent_id
5	NULL
6	5
include/diff_tables.inc [master:s, slave:s]
connection master;
FLUSH BINARY LOGS;
FOUND 4 /### DELETE FROM `test`.`s`/ in fk_cascade_multilevel.sql
DROP TABLE s;
connection slave;
#
# Case 8: a self-referencing table with another child. The cascade into
# the other child flags the statement, so the replica does not re-run
# any cascade of it: the self-referencing rows must be logged too.
#
connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, KEY(parent_id),
FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE o (id INT PRIMARY KEY, s_id INT, KEY(s_id),
FOREIGN KEY (s_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO s VALUES (1,NULL),(2,1),(3,2),(4,NULL);
INSERT INTO o VALUES (10,1),(20,2),(30,3),(40,4);
connection slave;
connection master;
DELETE FROM s WHERE id=1;
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
id	parent_id
4	NULL
SELECT id, s_id FROM o ORDER BY id;
id	s_id
40	4
include/diff_tables.inc [master:s, slave:s]
include/diff_tables.inc [master:o, slave:o]
connection master;
DROP TABLE o, s;
connection slave;
#
# Case 9: a cascade changes a row the statement changes after it. The
# cascaded rows must precede the row whose change ran the cascade, or
# the replica updates a row it has already deleted.
#
connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, KEY(parent_id),
FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE SET NULL) ENGINE=InnoDB;
INSERT INTO s VALUES (1,NULL),(2,1),(3,1),(4,NULL);
connection slave;
connection master;
FLUSH BINARY LOGS;
DELETE FROM s WHERE id IN (1,2);
connection slave;
# Last_SQL_Errno = 0 (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
id	parent_id
3	NULL
4	NULL
include/diff_tables.inc [master:s, slave:s]
# The row events in the order of execution
connection master;
FLUSH BINARY LOGS;
UPDATE s id=2
UPDATE s id=3
DELETE FROM s id=1
DELETE FROM s id=2
DROP TABLE s;
SET SESSION rpl_use_binlog_events_for_fk_cascade=@old_rpl_use_binlog_events_for_fk_cascade;
include/rpl_end.inc
