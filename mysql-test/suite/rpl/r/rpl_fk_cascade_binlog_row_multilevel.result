#
# Case 6: one level too deep. The statement fails inside the nested
# cascades; nothing may be logged or changed, and the session must go
# on capturing cascades correctly afterwards.
#
connection master;
call mtr.add_suppression("InnoDB: Cannot delete/update rows with cascading foreign key constraints that exceed max depth of 15");
