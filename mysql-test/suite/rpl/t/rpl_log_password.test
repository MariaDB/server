--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc

--echo #
--echo # MDEV-10584 Obscure plain text passwords from server logs
--echo #

--connection slave
call mtr.add_suppression("Slave SQL: Error 'Operation CREATE USER failed");
call mtr.add_suppression("Slave: Operation CREATE USER failed");
call mtr.add_suppression("Error running query, slave SQL thread aborted");
CREATE USER u1@localhost;

--connection master
CREATE USER u1@localhost IDENTIFIED BY 'pw01';

--connection slave
--let $slave_sql_errno= 1396
--source include/wait_for_slave_sql_error.inc
--let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let SEARCH_PATTERN= pw01
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= IDENTIFIED BY '<secret>'
--source include/search_pattern_in_file.inc
SET GLOBAL sql_slave_skip_counter= 1;
--source include/start_slave.inc

--echo # The binary log still carries the password
--connection master
CREATE USER u2@localhost IDENTIFIED BY 'pw02';
--source include/sync_slave_sql_with_master.inc
connect (slave_u2,localhost,u2,pw02,,$SLAVE_MYPORT,$SLAVE_MYSOCK);
SELECT CURRENT_USER();
disconnect slave_u2;

--connection master
DROP USER u1@localhost, u2@localhost;

--echo # End of 13.3 tests
--source include/rpl_end.inc
