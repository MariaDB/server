#
#   With log_bin_compress=ON, a row event larger than
# binlog_row_event_fragment_threshold must be compressed before it is
# fragmented into Partial_rows_log_events.
#
#   Test cases:
#   1: If the compressed rows fit under binlog_row_event_fragment_threshold,
#      the event is written whole as a compressed row event, without
#      fragments.
#   2: Otherwise the compressed rows are fragmented, so the event takes fewer
#      fragments than with log_bin_compress=OFF, and the slave re-assembles
#      and uncompresses them for Write_rows, Update_rows and Delete_rows.
#
# References:
#   MDEV-40851: Fragmented Compressed Row Events Aren't Actually Compressed
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--connection master
--let $old_compress= `SELECT @@global.log_bin_compress`
create table t1 (a int, b longblob) engine=innodb;
--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--echo #
--echo # Test case 1) Compressed rows that fit under the threshold are written
--echo # as one compressed event, without fragments
--connection master
set @@global.log_bin_compress= 1;
--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
insert into t1 values (1, repeat('a', 10000));
--source include/show_binlog_events.inc

--echo #
--echo # Test case 2) Compressed rows that don't fit are fragmented, and take
--echo # fewer fragments than uncompressed rows
--echo # The number of fragments of compressed rows depends on the zlib
--echo # library, so the fragment counts are compared instead of shown.
--echo # Each event is Gtid, Annotate_rows, Table_map, then the fragments.

--echo # Uncompressed
set @@global.log_bin_compress= 0;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
insert into t1 select 2, group_concat(sha2(seq,512) separator '')
               from seq_1_to_40;
--let $uncompressed_frag= query_get_value(SHOW BINLOG EVENTS IN '$binlog_file' FROM $binlog_start, Info, 4)

--echo # Compressed
set @@global.log_bin_compress= 1;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
insert into t1 select 3, group_concat(sha2(seq,512) separator '')
               from seq_1_to_40;
--let $insert_frag= query_get_value(SHOW BINLOG EVENTS IN '$binlog_file' FROM $binlog_start, Info, 4)

--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
update t1 set a= a + 10 where a = 3;
--let $update_frag= query_get_value(SHOW BINLOG EVENTS IN '$binlog_file' FROM $binlog_start, Info, 4)

--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
delete from t1 where a = 2;
--let $delete_frag= query_get_value(SHOW BINLOG EVENTS IN '$binlog_file' FROM $binlog_start, Info, 4)
--source include/save_master_gtid.inc

--disable_query_log
--eval select '$uncompressed_frag' like 'Fragment 1 of %' as uncompressed_fragmented, '$insert_frag' like 'Fragment 1 of %' as insert_fragmented, '$update_frag' like 'Fragment 1 of %' as update_fragmented, '$delete_frag' like 'Fragment 1 of %' as delete_fragmented
--eval select substring_index('$insert_frag', ' ', -1) + 0 < substring_index('$uncompressed_frag', ' ', -1) + 0 as compressed_takes_fewer_fragments
--enable_query_log

--connection slave
--source include/sync_with_master_gtid.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--echo #
--echo # Cleanup
--connection master
--eval set @@global.log_bin_compress= $old_compress
drop table t1;
--source include/rpl_end.inc
--echo # End of rpl_fragment_row_event_compress.test
