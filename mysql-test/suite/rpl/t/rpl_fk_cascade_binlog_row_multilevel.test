--source include/have_innodb.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--source include/master-slave.inc

#
# MDEV-38243: cascades that recurse through more than one level.
#
# InnoDB performs a nested cascade from inside the outer one: while the
# before-image of the outer child row is captured and not yet reported, the
# cascade into the grandchild captures and reports its own rows. Every level
# must end up in the binary log; since the events carry FK_CASCADE_EVENTS_F
# the replica does not re-run the cascade, so any missing level would silently
# diverge.
#
# The child tables have wider rows than their parents so that a nested capture
# reusing the outer row buffer would overrun it.
#

SET @old_rpl_use_binlog_events_for_fk_cascade := @@session.rpl_use_binlog_events_for_fk_cascade;
SET SESSION default_storage_engine=InnoDB;
SET SESSION binlog_format=ROW;
SET SESSION rpl_use_binlog_events_for_fk_cascade=1;

--let $datadir = `SELECT @@datadir`
--let $tmpfile = $MYSQLTEST_VARDIR/tmp/fk_cascade_multilevel.sql

--echo #
--echo # Case 1: ON DELETE CASCADE through 4 levels, growing row width
--echo #

CREATE TABLE l0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE l1 (id INT PRIMARY KEY, pid INT, pad CHAR(100) DEFAULT 'l1', KEY(pid),
  FOREIGN KEY (pid) REFERENCES l0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE l2 (id INT PRIMARY KEY, pid INT, pad CHAR(200) DEFAULT 'l2', KEY(pid),
  FOREIGN KEY (pid) REFERENCES l1(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE l3 (id INT PRIMARY KEY, pid INT, pad CHAR(255) DEFAULT 'l3',
  pad2 CHAR(255) DEFAULT 'l3', KEY(pid),
  FOREIGN KEY (pid) REFERENCES l2(id) ON DELETE CASCADE) ENGINE=InnoDB;

INSERT INTO l0 VALUES (1),(2);
INSERT INTO l1 (id,pid) VALUES (10,1),(11,1),(20,2);
INSERT INTO l2 (id,pid) VALUES (100,10),(101,10),(110,11),(200,20);
INSERT INTO l3 (id,pid) VALUES (1000,100),(1001,101),(1100,110),(2000,200);
sync_slave_with_master;

connection master;
FLUSH BINARY LOGS;
--let $binlog = query_get_value(SHOW MASTER STATUS, File, 1)

DELETE FROM l0 WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, pid FROM l1 ORDER BY id;
SELECT id, pid FROM l2 ORDER BY id;
SELECT id, pid FROM l3 ORDER BY id;
--let $diff_tables= master:l1, slave:l1
--source include/diff_tables.inc
--let $diff_tables= master:l2, slave:l2
--source include/diff_tables.inc
--let $diff_tables= master:l3, slave:l3
--source include/diff_tables.inc

# Every level is logged: 2 rows of l1, 3 of l2, 3 of l3.
connection master;
FLUSH BINARY LOGS;
--exec $MYSQL_BINLOG --verbose --base64-output=DECODE-ROWS $datadir/$binlog > $tmpfile
--let SEARCH_FILE= $tmpfile
--let SEARCH_PATTERN= ### DELETE FROM `test`.`l1`
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= ### DELETE FROM `test`.`l2`
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= ### DELETE FROM `test`.`l3`
--source include/search_pattern_in_file.inc
--remove_file $tmpfile

DROP TABLE l3, l2, l1, l0;
sync_slave_with_master;

--echo #
--echo # Case 2: ON UPDATE CASCADE through 3 levels
--echo #

connection master;
CREATE TABLE u0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE u1 (id INT PRIMARY KEY, pid INT, pad CHAR(100) DEFAULT 'u1', KEY(pid),
  FOREIGN KEY (pid) REFERENCES u0(id) ON UPDATE CASCADE) ENGINE=InnoDB;
# References the non-unique u1.pid, so updating u0.id cascades two levels.
CREATE TABLE u2 (id INT PRIMARY KEY, ppid INT, pad CHAR(255) DEFAULT 'u2', KEY(ppid),
  FOREIGN KEY (ppid) REFERENCES u1(pid) ON UPDATE CASCADE) ENGINE=InnoDB;

INSERT INTO u0 VALUES (1),(2);
INSERT INTO u1 (id,pid) VALUES (10,1),(20,2);
INSERT INTO u2 (id,ppid) VALUES (100,1),(101,1),(200,2);
sync_slave_with_master;

connection master;
UPDATE u0 SET id=5 WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, pid FROM u1 ORDER BY id;
SELECT id, ppid FROM u2 ORDER BY id;
--let $diff_tables= master:u1, slave:u1
--source include/diff_tables.inc
--let $diff_tables= master:u2, slave:u2
--source include/diff_tables.inc

connection master;
DROP TABLE u2, u1, u0;
sync_slave_with_master;

--echo #
--echo # Case 3: CASCADE into SET NULL, and a diamond
--echo #

connection master;
CREATE TABLE d0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE da (id INT PRIMARY KEY, pid INT, KEY(pid),
  FOREIGN KEY (pid) REFERENCES d0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE db (id INT PRIMARY KEY, pid INT, KEY(pid),
  FOREIGN KEY (pid) REFERENCES d0(id) ON DELETE CASCADE) ENGINE=InnoDB;
# Reached from d0 both through da (CASCADE) and through db (SET NULL).
CREATE TABLE dc (id INT PRIMARY KEY, a_id INT, b_id INT, pad CHAR(255) DEFAULT 'dc',
  KEY(a_id), KEY(b_id),
  FOREIGN KEY (a_id) REFERENCES da(id) ON DELETE CASCADE,
  FOREIGN KEY (b_id) REFERENCES db(id) ON DELETE SET NULL) ENGINE=InnoDB;

INSERT INTO d0 VALUES (1),(2);
INSERT INTO da VALUES (10,1),(20,2);
INSERT INTO db VALUES (10,1),(20,2);
INSERT INTO dc (id,a_id,b_id) VALUES (1,10,10),(2,20,10),(3,10,20),(4,20,20);
sync_slave_with_master;

connection master;
DELETE FROM d0 WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT * FROM da ORDER BY id;
SELECT * FROM db ORDER BY id;
SELECT id, a_id, b_id FROM dc ORDER BY id;
--let $diff_tables= master:da, slave:da
--source include/diff_tables.inc
--let $diff_tables= master:db, slave:db
--source include/diff_tables.inc
--let $diff_tables= master:dc, slave:dc
--source include/diff_tables.inc

connection master;
DROP TABLE dc, da, db, d0;
sync_slave_with_master;

--echo #
--echo # Case 4: multi-level cascades in a transaction with a savepoint rollback
--echo #

connection master;
CREATE TABLE t0 (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t1 (id INT PRIMARY KEY, pid INT, KEY(pid),
  FOREIGN KEY (pid) REFERENCES t0(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE t2 (id INT PRIMARY KEY, pid INT, pad CHAR(255) DEFAULT 't2', KEY(pid),
  FOREIGN KEY (pid) REFERENCES t1(id) ON DELETE CASCADE) ENGINE=InnoDB;

INSERT INTO t0 VALUES (1),(2),(3);
INSERT INTO t1 VALUES (10,1),(20,2),(30,3);
INSERT INTO t2 (id,pid) VALUES (100,10),(200,20),(300,30);
sync_slave_with_master;

connection master;
BEGIN;
DELETE FROM t0 WHERE id=1;
SAVEPOINT s1;
DELETE FROM t0 WHERE id=2;
ROLLBACK TO SAVEPOINT s1;
DELETE FROM t0 WHERE id=3;
COMMIT;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT * FROM t1 ORDER BY id;
SELECT id, pid FROM t2 ORDER BY id;
--let $diff_tables= master:t1, slave:t1
--source include/diff_tables.inc
--let $diff_tables= master:t2, slave:t2
--source include/diff_tables.inc

connection master;
DROP TABLE t2, t1, t0;

--echo #
--echo # Case 5: the deepest chain InnoDB allows, 14 cascade levels below the
--echo # parent (FK_MAX_CASCADE_DEL is 15, counting the parent)
--echo #

connection master;
CREATE TABLE c0 (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO c0 VALUES (1),(2);
--let $i= 1
while ($i <= 14)
{
  --let $p= `SELECT $i - 1`
  --eval CREATE TABLE c$i (id INT PRIMARY KEY, pid INT, pad CHAR(20) DEFAULT 'c$i', KEY(pid), FOREIGN KEY (pid) REFERENCES c$p(id) ON DELETE CASCADE) ENGINE=InnoDB
  --eval INSERT INTO c$i (id,pid) VALUES (1,1),(2,2)
  --inc $i
}
sync_slave_with_master;

connection master;
FLUSH BINARY LOGS;
--let $binlog = query_get_value(SHOW MASTER STATUS, File, 1)

DELETE FROM c0 WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, pid FROM c14 ORDER BY id;
--let $i= 1
while ($i <= 14)
{
  --let $diff_tables= master:c$i, slave:c$i
  --source include/diff_tables.inc
  --inc $i
}

# One row of each of the 15 tables: c0 itself and the 14 cascade levels.
connection master;
FLUSH BINARY LOGS;
--exec $MYSQL_BINLOG --verbose --base64-output=DECODE-ROWS $datadir/$binlog > $tmpfile
--let SEARCH_FILE= $tmpfile
--let SEARCH_PATTERN= ### DELETE FROM `test`.`c[0-9]+`
--source include/search_pattern_in_file.inc
--remove_file $tmpfile

--let $i= 14
while ($i >= 0)
{
  --eval DROP TABLE c$i
  --dec $i
}
sync_slave_with_master;

--echo #
--echo # Case 6: one level too deep. The statement fails inside the nested
--echo # cascades; nothing may be logged or changed, and the session must go
--echo # on capturing cascades correctly afterwards.
--echo #

connection master;
call mtr.add_suppression("InnoDB: Cannot delete/update rows with cascading foreign key constraints that exceed max depth of 15");
CREATE TABLE e0 (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO e0 VALUES (1),(2);
--let $i= 1
while ($i <= 15)
{
  --let $p= `SELECT $i - 1`
  --eval CREATE TABLE e$i (id INT PRIMARY KEY, pid INT, pad CHAR(20) DEFAULT 'e$i', KEY(pid), FOREIGN KEY (pid) REFERENCES e$p(id) ON DELETE CASCADE) ENGINE=InnoDB
  --eval INSERT INTO e$i (id,pid) VALUES (1,1),(2,2)
  --inc $i
}
sync_slave_with_master;

connection master;
FLUSH BINARY LOGS;
--let $binlog = query_get_value(SHOW MASTER STATUS, File, 1)

# Unnamed constraints are named e15_ibfk_1 in 11.8 and 1 in newer versions
--replace_regex /CONSTRAINT `[^`]*`/CONSTRAINT `e15_ibfk_1`/
--error ER_GET_ERRMSG
DELETE FROM e0 WHERE id=1;
SELECT COUNT(*) FROM e15;

# 11 levels below e4 are within the limit
DELETE FROM e4 WHERE id=2;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, pid FROM e15 ORDER BY id;
--let $i= 0
while ($i <= 15)
{
  --let $diff_tables= master:e$i, slave:e$i
  --source include/diff_tables.inc
  --inc $i
}

# Only the second statement is logged: one row of each of e4 .. e15.
connection master;
FLUSH BINARY LOGS;
--exec $MYSQL_BINLOG --verbose --base64-output=DECODE-ROWS $datadir/$binlog > $tmpfile
--let SEARCH_FILE= $tmpfile
--let SEARCH_PATTERN= ### DELETE FROM `test`.`e[0-9]+`
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= ### DELETE FROM `test`.`e[0-3]`
--source include/search_pattern_in_file.inc
--remove_file $tmpfile

--let $i= 15
while ($i >= 0)
{
  --eval DROP TABLE e$i
  --dec $i
}

sync_slave_with_master;

--echo #
--echo # Case 7: a self-referencing foreign key. The child is the table the
--echo # statement itself changes, through its own instance opened for the
--echo # foreign key.
--echo #

connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, pad CHAR(100) DEFAULT 's',
  KEY(parent_id),
  FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO s (id, parent_id) VALUES (1,NULL),(2,1),(3,2),(4,2),(5,NULL),(6,5);
sync_slave_with_master;

connection master;
FLUSH BINARY LOGS;
--let $binlog = query_get_value(SHOW MASTER STATUS, File, 1)

DELETE FROM s WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
--let $diff_tables= master:s, slave:s
--source include/diff_tables.inc

# The row the statement deletes and its 3 descendants.
connection master;
FLUSH BINARY LOGS;
--exec $MYSQL_BINLOG --verbose --base64-output=DECODE-ROWS $datadir/$binlog > $tmpfile
--let SEARCH_FILE= $tmpfile
--let SEARCH_PATTERN= ### DELETE FROM `test`.`s`
--source include/search_pattern_in_file.inc
--remove_file $tmpfile

DROP TABLE s;
sync_slave_with_master;

--echo #
--echo # Case 8: a self-referencing table with another child. The cascade into
--echo # the other child flags the statement, so the replica does not re-run
--echo # any cascade of it: the self-referencing rows must be logged too.
--echo #

connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, KEY(parent_id),
  FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
CREATE TABLE o (id INT PRIMARY KEY, s_id INT, KEY(s_id),
  FOREIGN KEY (s_id) REFERENCES s(id) ON DELETE CASCADE) ENGINE=InnoDB;
INSERT INTO s VALUES (1,NULL),(2,1),(3,2),(4,NULL);
INSERT INTO o VALUES (10,1),(20,2),(30,3),(40,4);
sync_slave_with_master;

connection master;
DELETE FROM s WHERE id=1;

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
SELECT id, s_id FROM o ORDER BY id;
--let $diff_tables= master:s, slave:s
--source include/diff_tables.inc
--let $diff_tables= master:o, slave:o
--source include/diff_tables.inc

connection master;
DROP TABLE o, s;
sync_slave_with_master;

--echo #
--echo # Case 9: a cascade changes a row the statement changes after it. The
--echo # cascaded rows must precede the row whose change ran the cascade, or
--echo # the replica updates a row it has already deleted.
--echo #

connection master;
CREATE TABLE s (id INT PRIMARY KEY, parent_id INT, KEY(parent_id),
  FOREIGN KEY (parent_id) REFERENCES s(id) ON DELETE SET NULL) ENGINE=InnoDB;
INSERT INTO s VALUES (1,NULL),(2,1),(3,1),(4,NULL);
sync_slave_with_master;

connection master;
FLUSH BINARY LOGS;
--let $binlog = query_get_value(SHOW MASTER STATUS, File, 1)

DELETE FROM s WHERE id IN (1,2);

sync_slave_with_master;
--let $errno= query_get_value(SHOW SLAVE STATUS, Last_SQL_Errno, 1)
--echo # Last_SQL_Errno = $errno (expected 0)
SELECT id, parent_id FROM s ORDER BY id;
--let $diff_tables= master:s, slave:s
--source include/diff_tables.inc

--echo # The row events in the order of execution
connection master;
FLUSH BINARY LOGS;
--exec $MYSQL_BINLOG --verbose --base64-output=DECODE-ROWS $datadir/$binlog > $tmpfile
--let ROW_EVENTS_FILE= $tmpfile
--perl
open(my $f, '<', $ENV{ROW_EVENTS_FILE}) or die "cannot open: $!";
my $event= '';
while (<$f>)
{
  if (/^### (DELETE FROM|UPDATE) \S+/) { $event= "$1 s"; }
  elsif ($event && /^###   \@1=(\d+)/) { print "$event id=$1\n"; $event= ''; }
}
close($f);
EOF
--remove_file $tmpfile

DROP TABLE s;

SET SESSION rpl_use_binlog_events_for_fk_cascade=@old_rpl_use_binlog_events_for_fk_cascade;
--source include/rpl_end.inc
