#
# WL#5096
#

#
#  Tests for different storage engines on each server, 
#  but same index structure on tables. The tests are conducted
#  using NOBLOB binlog-row-image on all servers.
#

-- let $row_img_set=server_1:NOBLOB:N,server_2:NOBLOB:Y,server_3:NOBLOB:Y
-- source include/rpl_row_img_set.inc

-- let $row_img_test_script= include/rpl_row_img.test
-- source include/rpl_row_img_general_loop.inc

-- let $row_img_set=server_1:FULL:N,server_2:FULL:Y,server_3:FULL:Y
-- source include/rpl_row_img_set.inc


--echo #
--echo # MDEV-38899: Assert in prepare_record() with RBR NOBLOB and UNIQUE BLOB column
--echo #
--connection server_1
SET binlog_row_image= NOBLOB;
CREATE TABLE t_mdev38899 (id INT PRIMARY KEY, b BLOB NOT NULL,
  UNIQUE KEY u (b(64))) ENGINE=InnoDB;
INSERT INTO t_mdev38899 VALUES (1, 'hello'), (2, 'world');
--source include/rpl_sync.inc
--connection server_2
SELECT id, CONVERT(b USING utf8) AS b FROM t_mdev38899 ORDER BY id;
--connection server_1
UPDATE t_mdev38899 SET id= 10 WHERE id= 1;
--source include/rpl_sync.inc
--connection server_2
SELECT id, CONVERT(b USING utf8) AS b FROM t_mdev38899 ORDER BY id;
--connection server_1
SET binlog_row_image= DEFAULT;
DROP TABLE t_mdev38899;
--source include/rpl_sync.inc

--source include/rpl_end.inc
