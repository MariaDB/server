--source include/have_debug.inc
--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc
--source include/have_innodb_binlog.inc

--echo ### MDEV-41562: No error when old semi-sync slave without GTID ack capability connects to binlog-in-engine master

--connection master
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
SET @old_semisync_timeout= @@GLOBAL.rpl_semi_sync_master_timeout;
SET GLOBAL rpl_semi_sync_master_timeout= 5000;
SET @old_semisync_enabled= @@GLOBAL.rpl_semi_sync_master_enabled;
SET GLOBAL rpl_semi_sync_master_enabled= 1;
--sync_slave_with_master

--source include/stop_slave.inc
SET STATEMENT sql_log_bin=0 FOR
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
SET STATEMENT sql_log_bin=0 FOR
  CALL mtr.add_suppression('MariaDB >= 13.2.1 is required on semi-sync slave when master uses --binlog-storage-engine');
SET @old_semisync_enabled= @@GLOBAL.rpl_semi_sync_slave_enabled;
SET GLOBAL rpl_semi_sync_slave_enabled= 1;
# Simulate old slave, has no capability to ACK with GTID.
SET @old_dbug= @@GLOBAL.debug_dbug;
SET GLOBAL debug_dbug= '+d,simulate_slave_capability_old_12_3';
START SLAVE;

--connection master
send INSERT INTO t1 VALUES (1, 0);

--connection slave
--source include/wait_for_slave_sql_to_start.inc
--let $slave_io_errno= 1236
--source include/wait_for_slave_io_error.inc

STOP SLAVE SQL_THREAD;
SET GLOBAL debug_dbug= @old_dbug;
--source include/start_slave.inc

--connection master
--reap;
--sync_slave_with_master

SELECT * FROM t1 ORDER BY a;

# Cleanup
--connection slave
--source include/stop_slave.inc
SET GLOBAL rpl_semi_sync_slave_enabled= @old_semisync_enabled;
--source include/start_slave.inc

--connection master
SET GLOBAL rpl_semi_sync_master_timeout= @old_semisync_timeout;
SET GLOBAL rpl_semi_sync_master_enabled= @old_semisync_enabled;
DROP TABLE t1;

--source include/rpl_end.inc
