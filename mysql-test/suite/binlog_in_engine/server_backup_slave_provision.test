--source include/not_embedded.inc
--source include/have_innodb_binlog.inc
# Test does a lot of queries that take a lot of CPU under Valgrind.
--source include/not_valgrind.inc

--source include/reset_master.inc

--echo *** Provision a new slave from a backup of a master

--let $datadir_1= `SELECT @@datadir`
--connect (server2,127.0.0.1,root,,,$SERVER_MYPORT_2)
--let $datadir_2= `SELECT @@datadir`

--echo *** Stopping to-be-provisioned server
--source include/shutdown_mysqld.inc

--echo *** Removing old datadir for provisioned server
--rmdir $datadir_2

--connection default
ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
CREATE TABLE t1(a varchar(60) PRIMARY KEY, b VARCHAR(60)) ENGINE INNODB;
INSERT INTO t1 VALUES(1, NULL);
CREATE TABLE t2 (val INT) ENGINE=InnoDB;
INSERT INTO t2 VALUES (0);

--disable_query_log
--delimiter //
CREATE PROCEDURE gen_load()
  MODIFIES SQL DATA
  BEGIN
    DECLARE i INT;
    DECLARE flag TYPE OF t2.val;
    SET i = 0;
    load_loop: LOOP
      SELECT val INTO flag FROM t2;
      IF NOT (flag=0) THEN
        LEAVE load_loop;
      END IF;
      START TRANSACTION;
      INSERT INTO t1 VALUES (CONCAT("AbAdCaFe", LPAD(i, 6, "0")), @@SESSION.last_gtid);
      COMMIT;
      SET i = i + 1;
    END LOOP;
  END
//
--delimiter ;
--enable_query_log

connect (con1,localhost,root,,);
--echo *** Start a background load...
send CALL gen_load();

# A bit of time for some data to accumulate for the backup.
--sleep 2
--connection default
--echo *** Doing backup...
evalp BACKUP SERVER TO '$datadir_2' 4 CONCURRENT;

--echo *** Stop the background load...
# A bit of time for extra data to accumulate for replicating to the newly provisioned slave.
--sleep 1
UPDATE t2 SET val=1;
--connection con1
reap;
--connection default
disconnect con1;
--let $count_master= `SELECT COUNT(*) FROM t1`

--echo *** Provision a new slave from the backup
--connection server2
--let $restart_parameters= --skip-slave-start
--source include/start_mysqld.inc

SET GLOBAL gtid_slave_pos= @@GLOBAL.gtid_binlog_pos;
evalp CHANGE MASTER TO
  master_ssl_verify_server_cert=0,
  master_port=$SERVER_MYPORT_1, master_host='127.0.0.1', master_user='root',
  master_use_gtid= Slave_pos;
START SLAVE;

--connection default
--source include/save_master_gtid.inc

--connection server2
--source include/sync_with_master_gtid.inc
--let $count_slave= `SELECT COUNT(*) FROM t1`
if ($count_master != $count_slave) {
  --echo *** ERROR: Table on master has $count_master rows, but table on provisioned slave has $count_slave rows
  --die Row difference on provisioned slave.
}


--echo *** Provision a new slave from a backup of another slave
--connection server2
STOP SLAVE;
RESET SLAVE ALL;

--connection default
--echo *** Stopping to-be-provisioned server
--source include/shutdown_mysqld.inc

--echo *** Removing old datadir for provisioned server
--rmdir $datadir_1

--connection server2
--echo *** Doing backup...
evalp BACKUP SERVER TO '$datadir_1';

--echo *** Provision a new slave from the backup
--connection default
--let $restart_parameters= --skip-slave-start
--source include/start_mysqld.inc

# The slave starting position is already in mysql.gtid_slave_pos from the backup.
evalp CHANGE MASTER TO
  master_ssl_verify_server_cert=0,
  master_port=$SERVER_MYPORT_2, master_host='127.0.0.1', master_user='root',
  master_use_gtid= Slave_pos;
START SLAVE;

--connection server2
CREATE TABLE t3 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t3 VALUES (42);
--source include/save_master_gtid.inc

--connection default
--source include/sync_with_master_gtid.inc
SELECT * FROM t3 ORDER BY a;
STOP SLAVE;
RESET SLAVE ALL;


# Cleanup

--connection default
DROP PROCEDURE gen_load;
DROP TABLE t1, t2, t3;

--connection server2
DROP PROCEDURE gen_load;
DROP TABLE t1, t2, t3;
