# MDEV-37605
#
# Verify that mariadb-binlog rejects options which are incompatible with
# --convert-engine-binlog. Option validation happens before the input file is
# opened, so a placeholder input name is sufficient.
--source include/have_innodb_binlog.inc

--echo *** --read-from-remote-server is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --read-from-remote-server placeholder.ibb 2>&1

--echo *** --raw is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --raw placeholder.ibb 2>&1

--echo *** --flashback is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --flashback placeholder.ibb 2>&1

--echo *** --database is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --database=test placeholder.ibb 2>&1

--echo *** --table is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --table=t1 placeholder.ibb 2>&1

--echo *** Numeric --start-position is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --start-position=100 placeholder.ibb 2>&1

--echo *** --start-datetime is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --start-datetime="2020-01-01 00:00:00" placeholder.ibb 2>&1

--echo *** --stop-datetime is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --stop-datetime="2030-01-01 00:00:00" placeholder.ibb 2>&1

--echo *** Numeric --stop-position is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --stop-position=100 placeholder.ibb 2>&1

--echo *** --offset is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --offset=1 placeholder.ibb 2>&1

--echo *** Explicit zero --offset is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --offset=0 placeholder.ibb 2>&1

--echo *** --do-domain-ids is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --do-domain-ids=1 placeholder.ibb 2>&1

--echo *** --ignore-domain-ids is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --ignore-domain-ids=1 placeholder.ibb 2>&1

--echo *** --do-server-ids is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --do-server-ids=1 placeholder.ibb 2>&1

--echo *** --ignore-server-ids is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --ignore-server-ids=1 placeholder.ibb 2>&1

--echo *** --server-id is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --server-id=1 placeholder.ibb 2>&1

--echo *** --rewrite-db is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --rewrite-db='test1->test2' placeholder.ibb 2>&1

--echo *** --skip-annotate-row-events is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --skip-annotate-row-events placeholder.ibb 2>&1

--echo *** GTID --start-position is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --start-position=0-1-1 placeholder.ibb 2>&1

--echo *** GTID --stop-position is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog --stop-position=0-1-1 placeholder.ibb 2>&1

--echo *** Legacy binlog input is unsupported
--error 1
--exec $MYSQL_BINLOG --convert-engine-binlog $MYSQL_TEST_DIR/std_data/mariadb-5.5-binlog.000001 2>&1
