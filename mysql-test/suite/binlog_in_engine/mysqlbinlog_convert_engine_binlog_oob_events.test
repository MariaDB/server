# MDEV-37605
#
# Verify that while conversion, a legacy binlog generated from an 
# InnoDB-format binlog containing out-of-band (OOB) records is accurate

--source include/have_binlog_format_row.inc
--source include/have_innodb_binlog.inc

--let $datadir= `SELECT @@datadir`

--source include/reset_master.inc

CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL, c TEXT, PRIMARY KEY(a, b)) ENGINE=InnoDB;

--echo *** Generate one large transaction whose OOB data spans two binlog files ***
# The transaction writes 200 pieces of 2000 bytes (~400K of row events).
# Each time the trx cache (default @@binlog_cache_size, 32K) fills up, its
# contents are written to the binlog as an OOB record while the transaction
# is still running. As ~400K is larger than the 256K (262144 bytes) binlog
# file size used in this suite, the OOB records must span (at least) two
# binlog files, and the commit record ends up in a later file than the
# first OOB record.
--let $file_before= query_get_value(SHOW MASTER STATUS, File, 1)
--disable_query_log
BEGIN;
--let $p= 1
while ($p <= 200) {
  eval INSERT INTO t1 VALUES (1, $p, REPEAT(CHR(65 + ($p MOD 26)), 2000));
  --inc $p
}
COMMIT;
--enable_query_log
--let $file_after= query_get_value(SHOW MASTER STATUS, File, 1)

if ($file_before == $file_after) {
  --die The large transaction did not span two engine binlog files
}

SELECT COUNT(*) FROM t1;
--echo Transaction started in $file_before and ended in $file_after

# Rotate so the files containing the transaction are complete on disk and
# can be inspected directly 
FLUSH BINARY LOGS;

# Wait for binlog-000003.ibb to guarantee that all data in binlog-000001.ibb
# is available to read from disk
--let $binlog_name= binlog-000003.ibb
--let $binlog_size= 262144
--source include/wait_for_engine_binlog.inc

--let $first_binlog= query_get_value(SHOW BINARY LOGS, Log_name, 1)
--let $second_binlog= query_get_value(SHOW BINARY LOGS, Log_name, 2)
if ($first_binlog != $file_before) {
  --die The first engine binlog file was not found
}
if ($second_binlog != $file_after) {
  --die The second engine binlog file was not found
}

--echo Found two engine binlog files: $first_binlog and $second_binlog

--echo *** Convert the OOB engine binlogs to legacy format ***
# This will produce a single legacy binlog file
--exec $MYSQL_BINLOG --convert-engine-binlog --result-file=$MYSQL_TMP_DIR/oob_conv $datadir/$first_binlog $datadir/$second_binlog

--echo *** Converted file contains the synthesized header events ***
--exec $MYSQL_BINLOG --verbose $MYSQL_TMP_DIR/oob_conv.000001 > $MYSQL_TMP_DIR/oob_conv_listing.txt
--let SEARCH_FILE= $MYSQL_TMP_DIR/oob_conv_listing.txt
--let SEARCH_PATTERN= Gtid list
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= Binlog checkpoint
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN= Start: binlog v 4
--source include/search_pattern_in_file.inc
--remove_file $MYSQL_TMP_DIR/oob_conv_listing.txt

--echo *** Round-trip: replay the converted files and check row count ***
# The replayed GTIDs duplicate the originals, so the replay must not use
# GTID strict mode (same as in binlog_in_engine.mysqlbinlog).
--exec $MYSQL_BINLOG --gtid-strict-mode=0 $MYSQL_TMP_DIR/oob_conv.000001 > $MYSQLTEST_VARDIR/tmp/binlog_oob_simple_replay.sql
DROP TABLE t1;
--exec $MYSQL --abort-source-on-error -e "source $MYSQLTEST_VARDIR/tmp/binlog_oob_simple_replay.sql;" test
--remove_file $MYSQLTEST_VARDIR/tmp/binlog_oob_simple_replay.sql

SELECT COUNT(*) FROM t1;

--remove_file $MYSQL_TMP_DIR/oob_conv.000001
DROP TABLE t1;
