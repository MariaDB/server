include/rpl_init.inc [topology=1->2, 1->3]
connection server_1;
SET @@GLOBAL.gtid_binlog_state= '9-1-1';
CREATE TABLE t (a INT);
include/save_master_gtid.inc
SET @orig_master_enabled= @@GLOBAL.rpl_semi_sync_master_enabled;
SET @@GLOBAL.rpl_semi_sync_master_enabled= ON;
SET @orig_debug_dbug= @@GLOBAL.debug_dbug;
SET @@GLOBAL.debug_dbug= '+d,'
  'pause_dump_thread_after_start,pause_dump_thread_before_update_sync_header';
# Test start-up with one async slave and one semi-sync slave
connection server_2;
CREATE TABLE t (a INT);
SET @orig_slave_enabled= @@GLOBAL.rpl_semi_sync_slave_enabled;
SET @@GLOBAL.rpl_semi_sync_slave_enabled= OFF;
SET @@GLOBAL.gtid_slave_pos= '9-1-1';
Warnings:
Warning	1948	Specified value for @@gtid_slave_pos contains no value for replication domain 0. This conflicts with the binary log which contains GTID 0-2-1. If MASTER_GTID_POS=CURRENT_POS is used, the binlog position will override the new value of @@gtid_slave_pos
START SLAVE;
include/wait_for_slave_sql_to_start.inc
connection server_1;
SET @@SESSION.debug_sync= 'now WAIT_FOR at_dump_thread_after_start';
connection server_3;
SET @orig_slave_enabled= @@GLOBAL.rpl_semi_sync_slave_enabled;
SET @@GLOBAL.rpl_semi_sync_slave_enabled= ON;
SET @@GLOBAL.gtid_slave_pos= '9-1-1';
START SLAVE IO_THREAD;
connection server_1;
SET @@SESSION.debug_sync= 'now WAIT_FOR at_dump_thread_after_start';
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
3	127.0.0.3	19003	1	9-1-1	9-1-1
2	127.0.0.2	19002	1	9-1-1	NULL
SET @@SESSION.debug_sync=
'now SIGNAL continue_dump_thread_after_start '
  'WAIT_FOR at_dump_thread_before_update_sync_header';
connection server_2;
connection server_1;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
3	127.0.0.3	19003	1	9-1-1	9-1-1
2	127.0.0.2	19002	1	9-1-1,0-1-1	NULL
SET @@GLOBAL.debug_dbug= @orig_debug_dbug;
SET @@SESSION.debug_sync=
'now SIGNAL continue_dump_thread_before_update_sync_header';
# Test a transaction with mixed async and semi-sync
SET STATEMENT server_id=9 FOR INSERT INTO t VALUES (1);
connection server_2;
SELECT CONCAT(Master_Log_File, ':', Read_Master_Log_Pos) AS Legacy_IO_Pos,
Gtid_IO_Pos FROM information_schema.slave_status;
Legacy_IO_Pos	Gtid_IO_Pos
binlog-000000.ibb:224	9-1-1,0-9-2
connection server_1;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
3	127.0.0.3	19003	1	9-1-1,0-9-2	9-1-1,0-9-2
2	127.0.0.2	19002	1	9-1-1,0-9-2	NULL
# Test restarting the async slave to a second but lagging semi-sync slave
connection server_2;
include/stop_slave_io.inc
connection server_1;
INSERT INTO t VALUES (-1);
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
3	127.0.0.3	19003	1	9-1-1,0-1-3	9-1-1,0-1-3
connection server_2;
SET @@GLOBAL.rpl_semi_sync_slave_enabled= ON;
SET @orig_debug_dbug= @@GLOBAL.debug_dbug;
SET @@GLOBAL.debug_dbug= '+d,simulate_delay_semisync_slave_reply';
START SLAVE IO_THREAD;
include/wait_for_slave_io_to_start.inc
connection server_1;
DROP TABLE t;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Sent_pos	Ack_pos
2	127.0.0.2	19002	1	9-1-1,0-1-4	9-1-1,0-9-2
3	127.0.0.3	19003	1	9-1-1,0-1-4	9-1-1,0-1-4
# Cleanup
SET @@SESSION.debug_sync= 'RESET';
SET @@GLOBAL.rpl_semi_sync_master_enabled= @orig_master_enabled;
connection server_2;
SET @@SESSION.debug_sync= 'now WAIT_FOR io_thd_at_slave_reply';
SET @@GLOBAL.debug_dbug= @orig_debug_dbug;
SET @@SESSION.debug_sync= 'now SIGNAL io_thd_do_reply';
include/stop_slave.inc
SET @@GLOBAL.rpl_semi_sync_slave_enabled= @orig_slave_enabled;
connection server_3;
include/stop_slave_io.inc
SET @@SESSION.debug_sync= 'RESET';
SET @@GLOBAL.rpl_semi_sync_slave_enabled= @orig_slave_enabled;
include/rpl_end.inc
