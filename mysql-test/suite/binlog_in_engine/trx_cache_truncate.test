--source include/have_binlog_format_row.inc
--source include/have_innodb_binlog.inc

--echo #
--echo # MDEV-40930: my_seek() on invalid file handle during COM_CHANGE_USER /
--echo # COM_RESET_CONNECTION (connection pool reset) with
--echo # binlog_storage_engine=innodb.
--echo #

CREATE TABLE t1 (a INT, b VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'x');

--echo # COM_CHANGE_USER
--change_user root,,test
SELECT * FROM t1 ORDER BY a;

INSERT INTO t1 VALUES (2, 'y');

--echo # COM_RESET_CONNECTION -- dispatches to the same THD::change_user()
reset_connection;
SELECT * FROM t1 ORDER BY a;

DROP TABLE t1;
