--source include/not_embedded.inc
--source include/have_innodb_binlog.inc

--source include/reset_master.inc

--echo ### Various tests for BACKUP SERVER with binlog-in-engine.

# The test is running with --binlog-directory=binlogs, so binlogs are in a
# sub-directory. This is to test that the binlog files in the backup are
# placed in the basedir.

--let $target_directory=$MYSQLTEST_VARDIR/tmp/backup_dir

evalp BACKUP SERVER TO '$target_directory' OPTIONS BINLOG=NONE;
--echo # There should be no binlog files when BINLOG=NONE
--list_files  $target_directory *.ibb
--rmdir $target_directory

FLUSH BINARY LOGS;
FLUSH BINARY LOGS;
--let $binlog_name= binlog-000003.ibb
--let $binlog_size= 262144
--source include/wait_for_engine_binlog.inc

evalp BACKUP SERVER TO '$target_directory' OPTIONS BINLOG=MINIMAL;
--echo # Only most recent binlog file with MINIMAL.
--list_files  $target_directory *.ibb
--rmdir $target_directory

evalp BACKUP SERVER TO '$target_directory' OPTIONS BINLOG=FULL;
--echo # All binlog files in FULL.
--list_files  $target_directory *.ibb
--rmdir $target_directory

evalp BACKUP SERVER TO '$target_directory';
--echo # No options default to FULL.
--list_files  $target_directory *.ibb
--rmdir $target_directory

evalp BACKUP SERVER TO '$target_directory'
  OPTIONS BINLOG=FULL, BINLOG=NONE, BINLOG=NONE,
  BINLOG=FULL, BINLOG=MINIMAL;
--echo # Only most recent binlog file, repeated option override.
--list_files  $target_directory *.ibb
--rmdir $target_directory
