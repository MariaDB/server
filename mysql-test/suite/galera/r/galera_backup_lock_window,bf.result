connection node_2;
connection node_1;
connection node_1;
CALL mtr.add_suppression("WSREP: ALTER TABLE isolation failure");
CREATE TABLE t_i (a INT PRIMARY KEY AUTO_INCREMENT) ENGINE=InnoDB;
CREATE TABLE t_at (a INT PRIMARY KEY AUTO_INCREMENT) ENGINE=Aria TRANSACTIONAL=1;
CREATE TABLE t_an (a INT PRIMARY KEY AUTO_INCREMENT) ENGINE=Aria TRANSACTIONAL=0;
CREATE TABLE t_m (a INT PRIMARY KEY AUTO_INCREMENT) ENGINE=MyISAM;
CREATE USER u1, u2;
connect  node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
connect  node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
SET @debug_dbug_saved= @@GLOBAL.debug_dbug;
# Local writes on node 1
START local innodb: lock:ok write:committed
FLUSH local innodb: lock:ok write:committed
BLOCK_DDL local innodb: lock:ok write:committed
BLOCK_COMMIT local innodb: lock:ok write:waits:certification,then:committed
FTWRL local innodb: lock:FTWRL waits:backup_lock,then:ok write:committed
START local aria_trans: lock:ok write:committed
FLUSH local aria_trans: lock:ok write:committed
BLOCK_DDL local aria_trans: lock:ok write:committed
BLOCK_COMMIT local aria_trans: lock:ok write:waits:backup_lock,then:committed
FTWRL local aria_trans: lock:FTWRL waits:backup_lock,then:ok write:committed
START local aria_nontrans: lock:ok write:committed
FLUSH local aria_nontrans: lock:ok write:committed
BLOCK_DDL local aria_nontrans: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
BLOCK_COMMIT local aria_nontrans: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
FTWRL local aria_nontrans: lock:FTWRL waits:backup_lock,then:ok write:committed
START local myisam: lock:ok write:committed
FLUSH local myisam: lock:ok write:committed
BLOCK_DDL local myisam: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
BLOCK_COMMIT local myisam: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
FTWRL local myisam: lock:FTWRL waits:backup_lock,then:ok write:committed
START local toi_aria_trans: lock:ok write:committed
FLUSH local toi_aria_trans: lock:ok write:committed
BLOCK_DDL local toi_aria_trans: lock:ok write:committed
BLOCK_COMMIT local toi_aria_trans: lock:BLOCK_COMMIT waits:pause,then:ok write:committed
FTWRL local toi_aria_trans: lock:FTWRL waits:backup_lock,then:ok write:committed
START local toi_aria_nontrans: lock:ok write:committed
FLUSH local toi_aria_nontrans: lock:ok write:committed
BLOCK_DDL local toi_aria_nontrans: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
BLOCK_COMMIT local toi_aria_nontrans: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
FTWRL local toi_aria_nontrans: lock:FTWRL waits:backup_lock,then:ok write:committed
START local toi_myisam: lock:ok write:committed
FLUSH local toi_myisam: lock:ok write:committed
BLOCK_DDL local toi_myisam: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
BLOCK_COMMIT local toi_myisam: lock:BLOCK_DDL waits:backup_lock,then:ok write:committed
FTWRL local toi_myisam: lock:FTWRL waits:backup_lock,then:ok write:committed
START local toi_ddl: lock:ok write:committed
FLUSH local toi_ddl: lock:ok write:committed
BLOCK_DDL local toi_ddl: lock:ok write:waits:backup_lock,then:committed
START local toi_grant: lock:ok write:committed
FLUSH local toi_grant: lock:ok write:committed
BLOCK_DDL local toi_grant: lock:ok write:committed
BLOCK_COMMIT local toi_grant: lock:BLOCK_COMMIT waits:pause,then:ok write:committed
# Writes on node 2, applied on node 1
START applier innodb: lock:ok write:committed
FLUSH applier innodb: lock:ok write:committed
BLOCK_DDL applier innodb: lock:ok write:committed
BLOCK_COMMIT applier innodb: lock:BLOCK_COMMIT waits:pause,then:ok write:committed
START applier toi_aria_trans: lock:ok write:committed
FLUSH applier toi_aria_trans: lock:ok write:committed
BLOCK_DDL applier toi_aria_trans: lock:ok write:committed
BLOCK_COMMIT applier toi_aria_trans: lock:BLOCK_COMMIT waits:pause,then:ok write:committed
START applier toi_aria_nontrans: lock:ok write:committed
FLUSH applier toi_aria_nontrans: lock:ok write:waits:backup_lock
BLOCK_DDL applier toi_aria_nontrans: lock:ok write:waits:backup_lock
START applier toi_myisam: lock:ok write:committed
FLUSH applier toi_myisam: lock:ok write:waits:backup_lock
BLOCK_DDL applier toi_myisam: lock:ok write:waits:backup_lock
START applier toi_ddl: lock:ok write:committed
FLUSH applier toi_ddl: lock:ok write:committed
BLOCK_DDL applier toi_ddl: lock:ok write:waits:backup_lock
START applier toi_grant: lock:ok write:committed
FLUSH applier toi_grant: lock:ok write:committed
BLOCK_DDL applier toi_grant: lock:ok write:committed
BLOCK_COMMIT applier toi_grant: lock:BLOCK_COMMIT waits:pause,then:ok write:committed
connection node_1b;
SET GLOBAL debug_dbug= @debug_dbug_saved;
disconnect node_1a;
disconnect node_1b;
connection node_1;
DROP USER u1, u2;
DROP TABLE t_i, t_at, t_an, t_m;
