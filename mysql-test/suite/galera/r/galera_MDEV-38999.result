connection node_2;
connection node_1;
connection node_1;
CREATE TABLE t1 (id INT PRIMARY KEY, f1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 100);
connection node_2;
SET GLOBAL wsrep_provider_options = "repl.causal_read_timeout=PT1S";
SET SESSION wsrep_sync_wait = 2;
connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2;
#
# Control case: standalone (autocommit) UPDATE correctly waits.
#
connection node_2;
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";
connection node_1;
INSERT INTO t1 VALUES (2, 200);
connection node_2a;
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
connection node_2;
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection node_2a;
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";
connection node_2;
#
# Fixed case: the SAME UPDATE, issued inside an explicit BEGIN, must
# still wait - bit 2 (UPDATE/DELETE) hasn't been satisfied yet in this
# transaction (BEGIN only ever checks bit 1).
#
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";
connection node_1;
INSERT INTO t1 VALUES (3, 300);
connection node_2a;
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
connection node_2;
BEGIN;
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
connection node_2a;
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";
connection node_2;
#
# Same scenario again, but via an implicit (autocommit=0) transaction
# instead of an explicit BEGIN.
#
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";
connection node_1;
INSERT INTO t1 VALUES (4, 400);
connection node_2a;
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
connection node_2;
SET SESSION autocommit = 0;
SELECT COUNT(*) FROM t1 WHERE id = 1;
COUNT(*)
1
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
SET SESSION autocommit = 1;
connection node_2a;
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";
connection node_2;
#
# wsrep_sync_wait=1 (READ only): two reads in a row inside one explicit
# transaction must each independently wait - the second one is not
# exempted just because the first already waited.
#
SET SESSION wsrep_sync_wait = 1;
connection node_2;
BEGIN;
SELECT COUNT(*) FROM t1;
COUNT(*)
4
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";
connection node_1;
INSERT INTO t1 VALUES (5, 500);
connection node_2a;
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
connection node_2;
SELECT COUNT(*) FROM t1;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
connection node_2a;
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";
connection node_2;
connection node_1;
DROP TABLE t1;
disconnect node_2a;
