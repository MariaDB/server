connection node_2;
connection node_1;
connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2;
connection node_1;
CREATE TABLE t1 (f1 INT PRIMARY KEY, f2 INT) ENGINE=InnoDB;
connection node_2;
#
# A. CREATE VIEW holds MDL on t1 before TOI
#
connection node_1;
SET DEBUG_SYNC = 'create_view_before_toi SIGNAL cv_parked WAIT_FOR cv_go';
CREATE VIEW v1 AS SELECT f1, f2 FROM t1;
connection node_1a;
SET SESSION wsrep_sync_wait = 0;
SET DEBUG_SYNC = 'now WAIT_FOR cv_parked';
connection node_2;
ALTER TABLE t1 ADD COLUMN f3 INT;
# The applier on node_1 BF-aborts CREATE VIEW and applies the ALTER
connection node_1a;
SET DEBUG_SYNC = 'now SIGNAL cv_go';
connection node_1;
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
connection node_1a;
SELECT COUNT(*) AS EXPECT_0 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v1';
EXPECT_0
0
connection node_2;
SELECT COUNT(*) AS EXPECT_0 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v1';
EXPECT_0
0
#
# B. CREATE VIEW waits in TOI for an earlier DDL on t1
#
connection node_1a;
# Park the applier on node_1 before it applies the DDL from node_2
SET GLOBAL wsrep_provider_options = 'dbug=d,apply_monitor_slave_enter_sync';
connection node_2;
ALTER TABLE t1 ADD COLUMN f4 INT;
connection node_1a;
SET SESSION wsrep_on = 0;
SET SESSION wsrep_on = 1;
SET GLOBAL wsrep_provider_options = 'dbug=';
# CREATE VIEW is ordered after the ALTER and waits for it in TOI
connection node_1;
CREATE VIEW v2 AS SELECT f1, f2 FROM t1;
# The CREATE VIEW has been ordered: node_2 has applied it
connection node_2a;
# Release the ALTER, its applier needs an exclusive MDL on t1
connection node_1a;
SET GLOBAL wsrep_provider_options = 'signal=apply_monitor_slave_enter_sync';
SELECT COUNT(*) AS EXPECT_4 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 't1';
EXPECT_4
4
connection node_1;
connection node_1a;
SELECT COUNT(*) AS EXPECT_1 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v2';
EXPECT_1
1
connection node_2;
SELECT COUNT(*) AS EXPECT_1 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v2';
EXPECT_1
1
#
# C. CREATE VIEW waits in TOI for an earlier DDL dropping a column
#
connection node_1a;
SET GLOBAL wsrep_provider_options = 'dbug=d,apply_monitor_slave_enter_sync';
connection node_2;
ALTER TABLE t1 DROP COLUMN f3;
connection node_1a;
SET SESSION wsrep_on = 0;
SET SESSION wsrep_on = 1;
SET GLOBAL wsrep_provider_options = 'dbug=';
connection node_2a;
# f3 still exists on node_1 when CREATE VIEW opens t1
connection node_1;
CREATE VIEW v3 AS SELECT f1, f3 FROM t1;
# The CREATE VIEW has been ordered: node_2 has processed it,
# and refused it, because it applied the ALTER first
connection node_2a;
connection node_1a;
SET GLOBAL wsrep_provider_options = 'signal=apply_monitor_slave_enter_sync';
connection node_1;
ERROR 42S22: Unknown column 'f3' in 'SELECT'
connection node_1a;
SELECT COUNT(*) AS EXPECT_0 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v3';
EXPECT_0
0
SELECT COUNT(*) AS EXPECT_3 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 't1';
EXPECT_3
3
connection node_2;
SELECT COUNT(*) AS EXPECT_0 FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME = 'v3';
EXPECT_0
0
SELECT COUNT(*) AS EXPECT_3 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 't1';
EXPECT_3
3
#
# D. Tables are opened again after TOI has begun
#
connection node_1;
CREATE FUNCTION f_one() RETURNS INT DETERMINISTIC RETURN 1;
CREATE VIEW v4 AS SELECT f1, f_one() AS one FROM v2;
CREATE OR REPLACE VIEW v4 AS SELECT v2.f1, f_one() AS one FROM v2 JOIN t1 USING (f1);
ALTER VIEW v4 AS SELECT f1 FROM v2;
PREPARE stmt FROM 'CREATE OR REPLACE VIEW v5 AS SELECT f1, f_one() AS one FROM v4';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
CREATE PROCEDURE p1() CREATE OR REPLACE VIEW v6 AS SELECT f1 FROM v5;
CALL p1();
CALL p1();
INSERT INTO t1 (f1, f2) VALUES (1, 10);
connection node_2;
SELECT TABLE_NAME, VIEW_DEFINITION FROM INFORMATION_SCHEMA.VIEWS
WHERE TABLE_SCHEMA = 'test' ORDER BY TABLE_NAME;
TABLE_NAME	VIEW_DEFINITION
v2	select `test`.`t1`.`f1` AS `f1`,`test`.`t1`.`f2` AS `f2` from `test`.`t1`
v4	select `v2`.`f1` AS `f1` from `test`.`v2`
v5	select `v4`.`f1` AS `f1`,`f_one`() AS `one` from `test`.`v4`
v6	select `v5`.`f1` AS `f1` from `test`.`v5`
SELECT * FROM v5;
f1	one
1	1
connection node_1;
SELECT TABLE_NAME, VIEW_DEFINITION FROM INFORMATION_SCHEMA.VIEWS
WHERE TABLE_SCHEMA = 'test' ORDER BY TABLE_NAME;
TABLE_NAME	VIEW_DEFINITION
v2	select `test`.`t1`.`f1` AS `f1`,`test`.`t1`.`f2` AS `f2` from `test`.`t1`
v4	select `v2`.`f1` AS `f1` from `test`.`v2`
v5	select `v4`.`f1` AS `f1`,`f_one`() AS `one` from `test`.`v4`
v6	select `v5`.`f1` AS `f1` from `test`.`v5`
SELECT * FROM v5;
f1	one
1	1
#
# E. Warnings and errors of the dry run
#
connection node_1;
CREATE ALGORITHM=MERGE VIEW v7 AS SELECT COUNT(*) AS c FROM t1;
Warnings:
Warning	1354	View merge algorithm can't be used here for now (assumed undefined algorithm)
SHOW WARNINGS;
Level	Code	Message
Warning	1354	View merge algorithm can't be used here for now (assumed undefined algorithm)
CREATE VIEW v8 AS SELECT * FROM t_none;
ERROR 42S02: Table 'test.t_none' doesn't exist
SHOW WARNINGS;
Level	Code	Message
Error	1146	Table 'test.t_none' doesn't exist
CREATE TABLE t_none (f1 INT) ENGINE=InnoDB;
PREPARE stmt FROM 'CREATE VIEW v8 AS SELECT f1 FROM t_none';
DROP TABLE t_none;
EXECUTE stmt;
ERROR 42S02: Table 'test.t_none' doesn't exist
CREATE TABLE t_none (f1 INT) ENGINE=InnoDB;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
connection node_2;
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.VIEWS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('v6', 'v7', 'v8')
ORDER BY TABLE_NAME;
TABLE_NAME
v6
v7
v8
connection node_1;
DROP VIEW v8, v7, v6, v5, v4, v2;
DROP TABLE t_none;
DROP PROCEDURE p1;
DROP FUNCTION f_one;
DROP TABLE t1;
disconnect node_1a;
disconnect node_2a;
