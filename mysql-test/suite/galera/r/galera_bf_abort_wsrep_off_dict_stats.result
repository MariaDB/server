connection node_2;
connection node_1;
#
# MDEV-42061: BF immunity of local sessions with wsrep_on = OFF
#
# The wsrep_on=OFF idle-victim code path must only ever apply to a
# real user session, never to one of InnoDB's own background
# threads (persistent statistics recalculation, purge, ...), which
# also run with wsrep_on=OFF but are not a client connection to
# kill. Pause the statistics recalculation thread while it holds
# the lock on mysql.innodb_table_stats/innodb_index_stats, then
# conflict with it from node_2 two different ways: a TOI-applied
# DDL-like statement (ANALYZE TABLE) and a plain replicated DML
# statement (certification-based row replication) against the
# exact stats row the recalculation is about to write. Both are a
# different kind of wsrep high-priority applier. Either way, the
# incoming statement must simply wait for the lock; the background
# recalculation must be left to finish normally and remain usable
# afterwards.
#
connection node_1;
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB
STATS_PERSISTENT=1 STATS_AUTO_RECALC=1;
INSERT INTO t1 SELECT seq, seq FROM seq_1_to_100;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
connect node_1a,127.0.0.1,root,,test,$NODE_MYPORT_1;
# Phase 1: conflict via a TOI-applied statement (ANALYZE TABLE).
connection node_1;
SET GLOBAL debug_dbug = '+d,dict_stats_save_locked_notify_and_wait';
DELETE FROM t1;
INSERT INTO t1 SELECT seq, seq FROM seq_1_to_100;
connection node_1a;
SET DEBUG_SYNC = 'now WAIT_FOR dict_stats_save_locked';
connection node_2;
ANALYZE TABLE t1;
connection node_1a;
SET DEBUG_SYNC = 'now SIGNAL dict_stats_save_locked_continue';
connection node_1;
connection node_2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
connection node_1;
SELECT COUNT(*) FROM t1;
COUNT(*)
100
# Phase 2: conflict via a plain replicated DML statement (not TOI)
# against the exact row the recalculation is about to write.
connection node_1;
SET GLOBAL debug_dbug = '+d,dict_stats_save_locked_notify_and_wait';
DELETE FROM t1;
INSERT INTO t1 SELECT seq, seq FROM seq_1_to_100;
connection node_1a;
SET DEBUG_SYNC = 'now WAIT_FOR dict_stats_save_locked';
connection node_2;
UPDATE mysql.innodb_table_stats SET n_rows = n_rows WHERE database_name = 'test' AND table_name = 't1';
connection node_1a;
SET DEBUG_SYNC = 'now SIGNAL dict_stats_save_locked_continue';
connection node_1;
connection node_2;
connection node_1;
SELECT COUNT(*) FROM t1;
COUNT(*)
100
# The background stats thread must still be usable afterwards.
DELETE FROM t1;
INSERT INTO t1 SELECT seq, seq FROM seq_1_to_100;
connection node_1a;
SET DEBUG_SYNC = 'RESET';
disconnect node_1a;
connection node_1;
DROP TABLE t1;
disconnect node_2;
disconnect node_1;
