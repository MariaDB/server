connection node_2;
connection node_1;
connection node_1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=MyISAM;
connect  node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
connect  node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
# FTWRL, then UNLOCK TABLES
connection node_1;
FLUSH TABLES WITH READ LOCK;
connection node_1a;
INSERT INTO t1 VALUES (1);
connection node_1b;
connection node_1;
SET DEBUG_SYNC= 'wsrep_unlock_global_read_lock_before_resume SIGNAL unlocked WAIT_FOR resume';
UNLOCK TABLES;
connection node_1b;
SET DEBUG_SYNC= 'now WAIT_FOR unlocked';
INSERT committed
# BACKUP STAGE BLOCK_DDL, then BACKUP STAGE END
connection node_1;
BACKUP STAGE START;
BACKUP STAGE FLUSH;
BACKUP STAGE BLOCK_DDL;
connection node_1a;
INSERT INTO t1 VALUES (2);
connection node_1b;
connection node_1;
SET DEBUG_SYNC= 'wsrep_backup_stage_before_resume_and_resync SIGNAL unlocked WAIT_FOR resume';
BACKUP STAGE END;
connection node_1b;
SET DEBUG_SYNC= 'now WAIT_FOR unlocked';
INSERT committed
connection node_1;
SELECT COUNT(*) FROM t1;
COUNT(*)
2
connection node_2;
SELECT COUNT(*) FROM t1;
COUNT(*)
2
disconnect node_1a;
disconnect node_1b;
connection node_1;
SET DEBUG_SYNC= 'RESET';
DROP TABLE t1;
