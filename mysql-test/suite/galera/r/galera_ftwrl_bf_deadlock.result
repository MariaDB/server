connection node_2;
connection node_1;
connection node_1;
connection node_2;
connection node_1;
CREATE TABLE t1 (a INT PRIMARY KEY AUTO_INCREMENT) ENGINE=InnoDB;
CREATE USER u1;
connection node_2;
SET SESSION wsrep_sync_wait= 0;
# Applier: InnoDB INSERT, held before apply
connect  node_1_lock, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connection node_1;
SET GLOBAL debug_dbug= '+d,sync.wsrep_apply_cb';
connection node_2;
INSERT INTO t1 VALUES (NULL);
connection node_1;
SET SESSION wsrep_sync_wait= 0;
SET DEBUG_SYNC= 'now WAIT_FOR sync.wsrep_apply_cb_reached';
SET GLOBAL debug_dbug= '';
connection node_1_lock;
FLUSH TABLES WITH READ LOCK;
connection node_1;
SET DEBUG_SYNC= 'now SIGNAL signal.wsrep_apply_cb';
FTWRL applier innodb: no deadlock
Killing server ...
connection node_2;
connection node_1;
connection node_2;
disconnect node_1_lock;
# Local TOI: ALTER TABLE, held before it opens the table
connect  node_1_lock, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connect  node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET DEBUG_SYNC= 'alter_table_before_open_tables SIGNAL op_held WAIT_FOR op_go';
ALTER TABLE t1 COMMENT 'local';
connection node_1;
SET SESSION wsrep_sync_wait= 0;
SET DEBUG_SYNC= 'now WAIT_FOR op_held';
connection node_1_lock;
FLUSH TABLES WITH READ LOCK;
connection node_1;
SET DEBUG_SYNC= 'now SIGNAL op_go';
FTWRL local toi_ddl: no deadlock
Killing server ...
connection node_2;
connection node_1;
connection node_2;
disconnect node_1_lock;
disconnect node_1a;
# Local TOI: GRANT, held before it opens the privilege tables
connect  node_1_lock, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connect  node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET DEBUG_SYNC= 'open_and_process_table SIGNAL op_held WAIT_FOR op_go';
GRANT SELECT (a) ON test.t1 TO u1;
connection node_1;
SET SESSION wsrep_sync_wait= 0;
SET DEBUG_SYNC= 'now WAIT_FOR op_held';
connection node_1_lock;
FLUSH TABLES WITH READ LOCK;
connection node_1;
SET DEBUG_SYNC= 'now SIGNAL op_go';
FTWRL local toi_grant: no deadlock
Killing server ...
connection node_2;
connection node_1;
connection node_2;
disconnect node_1_lock;
disconnect node_1a;
connection node_1;
SELECT COUNT(*) FROM t1;
COUNT(*)
1
