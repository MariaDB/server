#
# Foreign keys on FLOAT, DOUBLE, TIMESTAMP, DATE and DATETIME. These
# are fixed width and not collated, so wsrep_store_key_val_for_row()
# and wsrep_rec_get_foreign_key() never cut the key for them; the
# point is to show the same key-building code path used above still
# produces a working, replicated foreign key for these types.
#
connection node_1;
CREATE TABLE fp_num (a FLOAT,
b DOUBLE,
c TIMESTAMP,
dt DATE,
e DATETIME,
f INT,
PRIMARY KEY (a,b,c,dt,e)) ENGINE=InnoDB;
CREATE TABLE fc_num (id INT AUTO_INCREMENT PRIMARY KEY,
a FLOAT,
b DOUBLE,
c TIMESTAMP,
dt DATE,
e DATETIME,
KEY k (a,b,c,dt,e),
FOREIGN KEY (a,b,c,dt,e)
REFERENCES fp_num (a,b,c,dt,e)) ENGINE=InnoDB;
INSERT INTO fp_num (a,b,c,dt,e,f) VALUES
(1.5, 2.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00', 1);
INSERT INTO fc_num (a,b,c,dt,e) VALUES
(1.5, 2.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00');
# No matching parent row for this combination, the insert is rejected
INSERT INTO fc_num (a,b,c,dt,e) VALUES
(9.5, 9.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00');
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`fc_num`, CONSTRAINT `fc_num_ibfk_1` FOREIGN KEY (`a`, `b`, `c`, `dt`, `e`) REFERENCES `fp_num` (`a`, `b`, `c`, `dt`, `e`))
connection node_2;
SELECT COUNT(*) AS EXPECT_1 FROM fp_num;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_1 FROM fc_num;
EXPECT_1
1
#
# Foreign key where part of the key is NULL. InnoDB foreign keys use
# MATCH SIMPLE: when any column of a multi-column foreign key is
# NULL, the row is not checked against the parent at all, whether or
# not a matching parent row exists.
#
connection node_1;
CREATE TABLE fp_n (a INT, b INT, c INT, d INT,
PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE fc_n (id INT AUTO_INCREMENT PRIMARY KEY,
a INT, b INT, c INT,
KEY k (a,b,c),
FOREIGN KEY (a,b,c) REFERENCES fp_n (a,b,c)) ENGINE=InnoDB;
# No parent row for (1,2,3) at all, but c is NULL so the row is
# accepted anyway
INSERT INTO fc_n (a,b,c) VALUES (1,2,NULL);
# A parent row exists for (10,20,30), but the child is still not
# checked against it because c is NULL
INSERT INTO fp_n (a,b,c,d) VALUES (10,20,30,1);
INSERT INTO fc_n (a,b,c) VALUES (10,20,NULL);
# A row with every foreign key column NULL is accepted the same way
INSERT INTO fc_n (a,b,c) VALUES (NULL,NULL,NULL);
connection node_2;
SELECT COUNT(*) AS EXPECT_1 FROM fp_n;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_3 FROM fc_n;
EXPECT_3
3
#
# The same MATCH SIMPLE rule with only the last column of the
# foreign key nullable, the other columns NOT NULL. Position does
# not matter: any NULL column, first, middle or last, is enough to
# skip the check.
#
connection node_1;
CREATE TABLE mfp (a INT, b INT, c INT, PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE mfc (id INT AUTO_INCREMENT PRIMARY KEY,
a INT NOT NULL, b INT NOT NULL, c INT,
KEY k (a,b,c),
FOREIGN KEY (a,b,c) REFERENCES mfp (a,b,c)) ENGINE=InnoDB;
INSERT INTO mfp VALUES (1,2,3);
# Last column (c) is NULL: no matching parent row required
INSERT INTO mfc (a,b,c) VALUES (9,9,NULL);
# Last column (c) is non-NULL and matches: the constraint is
# checked and passes
INSERT INTO mfc (a,b,c) VALUES (1,2,3);
# Last column (c) is non-NULL and does not match: the constraint is
# checked and fails
INSERT INTO mfc (a,b,c) VALUES (1,2,99);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`mfc`, CONSTRAINT `mfc_ibfk_1` FOREIGN KEY (`a`, `b`, `c`) REFERENCES `mfp` (`a`, `b`, `c`))
connection node_2;
SELECT COUNT(*) AS EXPECT_1 FROM mfp;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_2 FROM mfc;
EXPECT_2
2
#
# Every remaining fixed width data type built into the server, in a
# primary key, in a unique key, in a plain key on a table with no
# primary key, and in a foreign key that references a primary key
# and one that references a unique key. wsrep_store_key_val_for_row()
# copies these types with a plain memcpy (TINYINT .. VARBINARY below)
# or through the ENUM/SET branch that skips collation; FLOAT, DOUBLE,
# TIMESTAMP, DATE and DATETIME were already covered above. UUID and
# INET6 are in galera_ws_datatypes_plugin.test.
#
connection node_1;
CREATE TABLE g1_pk (ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
bi BIGINT, de DECIMAL(10,2), bt BIT(8),
bn BINARY(4), vb VARBINARY(8), f INT,
PRIMARY KEY (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;
CREATE TABLE g1_pk_child (id INT AUTO_INCREMENT PRIMARY KEY,
ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
bi BIGINT, de DECIMAL(10,2), bt BIT(8),
bn BINARY(4), vb VARBINARY(8),
KEY k (ti,si,mi,ii,bi,de,bt,bn,vb),
FOREIGN KEY (ti,si,mi,ii,bi,de,bt,bn,vb)
REFERENCES g1_pk (ti,si,mi,ii,bi,de,bt,bn,vb))
ENGINE=InnoDB;
CREATE TABLE g1_uk (id INT AUTO_INCREMENT PRIMARY KEY,
ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
bi BIGINT, de DECIMAL(10,2), bt BIT(8),
bn BINARY(4), vb VARBINARY(8),
UNIQUE KEY u (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;
CREATE TABLE g1_uk_child (id INT AUTO_INCREMENT PRIMARY KEY,
ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
bi BIGINT, de DECIMAL(10,2), bt BIT(8),
bn BINARY(4), vb VARBINARY(8),
KEY k (ti,si,mi,ii,bi,de,bt,bn,vb),
FOREIGN KEY (ti,si,mi,ii,bi,de,bt,bn,vb)
REFERENCES g1_uk (ti,si,mi,ii,bi,de,bt,bn,vb))
ENGINE=InnoDB;
CREATE TABLE g1_key (ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
bi BIGINT, de DECIMAL(10,2), bt BIT(8),
bn BINARY(4), vb VARBINARY(8),
KEY k (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;
# TINYINT, SMALLINT, MEDIUMINT, INT, BIGINT, DECIMAL, BIT, BINARY,
# VARBINARY together, in a primary key and a foreign key that
# references it
INSERT INTO g1_pk (ti,si,mi,ii,bi,de,bt,bn,vb,f)
VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh',1);
INSERT INTO g1_pk_child (ti,si,mi,ii,bi,de,bt,bn,vb)
VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');
# The same types in a unique key and a foreign key that references it
INSERT INTO g1_uk (ti,si,mi,ii,bi,de,bt,bn,vb)
VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');
INSERT INTO g1_uk_child (ti,si,mi,ii,bi,de,bt,bn,vb)
VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');
# The same types in a plain, non-unique key on a table with no
# primary key
INSERT INTO g1_key (ti,si,mi,ii,bi,de,bt,bn,vb)
VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');
connection node_2;
SELECT COUNT(*) AS EXPECT_1 FROM g1_pk;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_1 FROM g1_pk_child;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_1 FROM g1_uk;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_1 FROM g1_uk_child;
EXPECT_1
1
SELECT COUNT(*) AS EXPECT_1 FROM g1_key;
EXPECT_1
1
#
# TIME, YEAR, ENUM and SET, the same way. UUID and INET6 are provided
# by the mandatory type_uuid and type_inet plugins rather than being
