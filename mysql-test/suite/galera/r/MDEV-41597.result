connection node_2;
connection node_1;
connection node_1;
CREATE ROLE r1;
GRANT ALL ON *.* TO r1;
CREATE USER u1@localhost;
CREATE DATABASE d1;
CREATE TABLE d1.t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO d1.t1 VALUES (1);
connection node_2;
connect  con1,127.0.0.1,u1,,,$NODE_MYPORT_1;
connection con1;
SELECT PRIVILEGE_TYPE FROM information_schema.USER_PRIVILEGES WHERE GRANTEE = "'u1'@'localhost'";
PRIVILEGE_TYPE
USAGE
GRANT r1 TO u1@localhost;
ERROR 28000: Access denied for user 'u1'@'localhost'
connection node_1;
# node_1 roles_mapping after the refused statement
SELECT User, Role FROM mysql.roles_mapping WHERE User = 'u1';
User	Role
connection node_2;
# node_2 roles_mapping after the same statement
SELECT User, Role FROM mysql.roles_mapping WHERE User = 'u1';
User	Role
connect  con2,127.0.0.1,u1,,,$NODE_MYPORT_2;
connection con2;
SET ROLE r1;
ERROR OP000: Invalid role specification `r1`
SELECT a FROM d1.t1;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `d1`.`t1`
SELECT COUNT(*) AS c FROM mysql.global_priv;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `mysql`.`global_priv`
#
# Race: the granting user loses the admin option after the
# privilege check, but before the GRANT enters TOI. All nodes
# must reach the same outcome.
#
connection node_1;
CREATE USER admin@localhost;
GRANT SUPER ON *.* TO admin@localhost;
GRANT r1 TO admin@localhost WITH ADMIN OPTION;
CREATE USER u2@localhost;
connection node_2;
connect  con_admin,127.0.0.1,admin,,,$NODE_MYPORT_1;
connection con_admin;
SET DEBUG_SYNC = 'grant_role_before_toi SIGNAL checked WAIT_FOR go';
GRANT r1 TO u2@localhost;
connection node_1;
SET DEBUG_SYNC = 'now WAIT_FOR checked';
connection node_2;
REVOKE ADMIN OPTION FOR r1 FROM admin@localhost;
connection node_1;
SET DEBUG_SYNC = 'now SIGNAL go';
connection con_admin;
connection node_1;
# node_1 roles_mapping after the race
SELECT User, Role FROM mysql.roles_mapping WHERE User = 'u2';
User	Role
u2	r1
connection node_2;
# node_2 roles_mapping after the race
SELECT User, Role FROM mysql.roles_mapping WHERE User = 'u2';
User	Role
u2	r1
connection node_1;
disconnect con_admin;
SET DEBUG_SYNC = 'RESET';
DROP USER admin@localhost;
DROP USER u2@localhost;
connection node_1;
disconnect con1;
disconnect con2;
DROP USER u1@localhost;
DROP ROLE r1;
DROP DATABASE d1;
# rows granting r1 to u1 on node_2: 0
