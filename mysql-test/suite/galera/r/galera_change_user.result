connection node_2;
connection node_1;
connection node_1;
CREATE USER user1;
CREATE TABLE t1 (f1 INT PRIMARY KEY) ENGINE=InnoDB;
connect node_1a, 127.0.0.1, root, , test, $MYPORT_NODE_1;
disconnect node_1a;
connect node_1a, 127.0.0.1, root, , test, $MYPORT_NODE_1;
START TRANSACTION;
INSERT INTO t1 VALUES (1);
disconnect node_1a;
connection node_1;
GRANT SELECT ON test.t1 TO user1;
connect node_1a, 127.0.0.1, root, , test, $MYPORT_NODE_1;
# Fresh connection
SET SESSION wsrep_sync_wait = 1;
SELECT COUNT(*) FROM test.t1;
COUNT(*)
0
include/assert.inc [SELECT did a causal read on a fresh connection]
# After COM_CHANGE_USER
SET SESSION wsrep_sync_wait = 1;
SELECT COUNT(*) FROM test.t1;
COUNT(*)
0
include/assert.inc [SELECT did a causal read after COM_CHANGE_USER]
# After COM_RESET_CONNECTION
SET SESSION wsrep_sync_wait = 1;
SELECT COUNT(*) FROM test.t1;
COUNT(*)
0
include/assert.inc [SELECT did a causal read after COM_RESET_CONNECTION]
disconnect node_1a;
connection node_1;
DROP TABLE t1;
DROP USER user1;
