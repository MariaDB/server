connection node_2;
connection node_1;
connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2;
connection node_1;
SET @save_wsrep_mode = @@GLOBAL.wsrep_mode;
SET GLOBAL wsrep_mode = REPLICATE_MYISAM;
SET SESSION wsrep_sync_wait = 0;
connection node_2;
SET @save_wsrep_mode = @@GLOBAL.wsrep_mode;
SET GLOBAL wsrep_mode = REPLICATE_MYISAM;
connection node_1a;
SET SESSION wsrep_sync_wait = 0;
connection node_2a;
SET SESSION wsrep_sync_wait = 0;
connection node_1;
CREATE TABLE t1 (f1 INT PRIMARY KEY) ENGINE=MyISAM;
CREATE TABLE t2 (f1 INT PRIMARY KEY) ENGINE=MyISAM;
CREATE TABLE t3 (f1 INT PRIMARY KEY) ENGINE=MyISAM;
INSERT INTO t2 VALUES (2);
connection node_2;
#
# A. INSERT ordered after ALTER TABLE on the table
#
connection node_1a;
SET GLOBAL wsrep_provider_options = 'dbug=d,apply_monitor_slave_enter_sync';
connection node_2;
ALTER TABLE t1 ADD COLUMN f2 INT;
connection node_1a;
SET SESSION wsrep_on = 0;
SET SESSION wsrep_on = 1;
SET GLOBAL wsrep_provider_options = 'dbug=';
connection node_2a;
connection node_1;
INSERT INTO t1 (f1) VALUES (1);
# Ordered in TOI after it: node_2 has processed it
connection node_2a;
connection node_1a;
SET GLOBAL wsrep_provider_options = 'signal=apply_monitor_slave_enter_sync';
connection node_1;
#
# B. INSERT ... SELECT ordered after ALTER TABLE on the source table
#
connection node_1a;
SET GLOBAL wsrep_provider_options = 'dbug=d,apply_monitor_slave_enter_sync';
connection node_2;
ALTER TABLE t2 ADD COLUMN f2 INT;
connection node_1a;
SET SESSION wsrep_on = 0;
SET SESSION wsrep_on = 1;
SET GLOBAL wsrep_provider_options = 'dbug=';
connection node_2a;
connection node_1;
INSERT INTO t1 (f1) SELECT f1 FROM t2;
# Ordered in TOI after it: node_2 has processed it
connection node_2a;
connection node_1a;
SET GLOBAL wsrep_provider_options = 'signal=apply_monitor_slave_enter_sync';
connection node_1;
#
# C. INSERT ordered after ALTER TABLE on a table written by a trigger
#
connection node_1;
CREATE TRIGGER tr1 AFTER INSERT ON t1 FOR EACH ROW INSERT INTO t3 (f1) VALUES (NEW.f1);
connection node_2;
connection node_1a;
SET GLOBAL wsrep_provider_options = 'dbug=d,apply_monitor_slave_enter_sync';
connection node_2;
ALTER TABLE t3 ADD COLUMN f2 INT;
connection node_1a;
SET SESSION wsrep_on = 0;
SET SESSION wsrep_on = 1;
SET GLOBAL wsrep_provider_options = 'dbug=';
connection node_2a;
connection node_1;
INSERT INTO t1 (f1) VALUES (3);
# Ordered in TOI after it: node_2 has processed it
connection node_2a;
connection node_1a;
SET GLOBAL wsrep_provider_options = 'signal=apply_monitor_slave_enter_sync';
connection node_1;
connection node_1a;
SELECT * FROM t1 ORDER BY f1;
f1	f2
1	NULL
2	NULL
3	NULL
SELECT * FROM t3 ORDER BY f1;
f1	f2
3	NULL
SELECT TABLE_NAME, COUNT(*) AS COLUMNS FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'test' GROUP BY TABLE_NAME ORDER BY TABLE_NAME;
TABLE_NAME	COLUMNS
t1	2
t2	2
t3	2
connection node_2a;
SELECT * FROM t1 ORDER BY f1;
f1	f2
1	NULL
2	NULL
3	NULL
SELECT * FROM t3 ORDER BY f1;
f1	f2
3	NULL
SELECT TABLE_NAME, COUNT(*) AS COLUMNS FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'test' GROUP BY TABLE_NAME ORDER BY TABLE_NAME;
TABLE_NAME	COLUMNS
t1	2
t2	2
t3	2
connection node_1;
DROP TABLE t1, t2, t3;
SET GLOBAL wsrep_mode = @save_wsrep_mode;
connection node_2;
SET GLOBAL wsrep_mode = @save_wsrep_mode;
disconnect node_1a;
disconnect node_2a;
