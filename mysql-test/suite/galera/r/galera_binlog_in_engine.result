connection node_2;
connection node_1;
connection node_1;
call mtr.add_suppression("Galera support for --binlog-storage-engine is experimental");
call mtr.add_suppression("WSREP: Transaction data was spilled to the binlog storage engine before it was replicated");
SELECT @@binlog_storage_engine;
@@binlog_storage_engine
innodb
connection node_2;
call mtr.add_suppression("Galera support for --binlog-storage-engine is experimental");
SELECT @@binlog_storage_engine;
@@binlog_storage_engine
innodb
#
# Autocommit DML and DDL
#
connection node_1;
CREATE TABLE t1 (id INT PRIMARY KEY, b VARCHAR(1000)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'a');
UPDATE t1 SET b = 'b' WHERE id = 1;
INSERT INTO t1 VALUES (2, 'c');
DELETE FROM t1 WHERE id = 2;
connection node_2;
SELECT * FROM t1;
id	b
1	b
#
# Multi-statement transaction with a savepoint rollback
#
connection node_1;
START TRANSACTION;
INSERT INTO t1 VALUES (10, 'x');
SAVEPOINT s1;
INSERT INTO t1 VALUES (11, 'rolled back');
ROLLBACK TO SAVEPOINT s1;
INSERT INTO t1 VALUES (12, 'y');
COMMIT;
# Statement rollback inside a transaction
START TRANSACTION;
INSERT INTO t1 VALUES (20, 'z');
INSERT INTO t1 VALUES (21, 'rolled back'), (20, 'dup');
ERROR 23000: Duplicate entry '20' for key 'PRIMARY'
COMMIT;
connection node_2;
SELECT * FROM t1 ORDER BY id;
id	b
1	b
10	x
12	y
20	z
#
# Writes on node_2 replicate to node_1
#
connection node_2;
INSERT INTO t1 VALUES (30, 'from node_2');
connection node_1;
SELECT * FROM t1 WHERE id = 30;
id	b
30	from node_2
#
# A transaction smaller than the binlog cache but with several
# events replicates.
#
connection node_1;
START TRANSACTION;
COMMIT;
connection node_2;
SELECT COUNT(*) FROM t1 WHERE id BETWEEN 100 AND 119;
COUNT(*)
20
#
# A transaction larger than the binlog cache is spilled to the
# engine binlog before it is replicated. This is not yet supported,
# the transaction is rolled back and nothing is replicated.
#
connection node_1;
START TRANSACTION;
COMMIT;
ERROR HY000: Galera replication of a transaction larger than the binlog cache is not yet supported with --binlog-storage-engine
SELECT COUNT(*) FROM t1 WHERE id BETWEEN 200 AND 259;
COUNT(*)
0
# The cluster is still consistent and operational
INSERT INTO t1 VALUES (300, 'after large');
connection node_2;
SELECT COUNT(*) FROM t1 WHERE id BETWEEN 200 AND 259;
COUNT(*)
0
SELECT COUNT(*) FROM t1;
COUNT(*)
26
connection node_1;
SELECT COUNT(*) FROM t1;
COUNT(*)
26
connection node_1;
DROP TABLE t1;
#
# Both nodes have binlogged the same replicated transactions with the
# same GTIDs (wsrep_gtid_domain_id=1) in the engine binlog
#
connection node_2;
connection node_1;
# gtid_binlog_pos domain 1 matches on both nodes
