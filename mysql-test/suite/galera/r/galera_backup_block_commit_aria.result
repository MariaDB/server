connection node_2;
connection node_1;
connection node_1;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=Aria TRANSACTIONAL=1;
INSERT INTO t1 VALUES (1);
CREATE TABLE t2 (c1 INT) ENGINE=InnoDB;
CREATE USER u1, u2;
connect  node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
connect  node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1;
SET SESSION wsrep_sync_wait= 0;
# Local Aria DML waits for the backup lock.
connection node_1;
BACKUP STAGE START;
BACKUP STAGE FLUSH;
BACKUP STAGE BLOCK_DDL;
BACKUP STAGE BLOCK_COMMIT;
connection node_1b;
connection node_1a;
INSERT INTO t1 VALUES (2);
connection node_1b;
connection node_1;
BACKUP STAGE END;
connection node_1a;
SELECT COUNT(*) FROM t1;
COUNT(*)
2
# Local GRANT waits for the backup lock, or the paused provider
# rejects it.
connection node_1;
BACKUP STAGE START;
BACKUP STAGE FLUSH;
BACKUP STAGE BLOCK_DDL;
BACKUP STAGE BLOCK_COMMIT;
connection node_1b;
connection node_1a;
GRANT SELECT (c1) ON test.t2 TO u1;
connection node_1b;
connection node_1;
BACKUP STAGE END;
# GRANT from node 2: the applier on node 1 waits for the backup
# lock, or the provider pause holds it.
connection node_1;
BACKUP STAGE START;
BACKUP STAGE FLUSH;
BACKUP STAGE BLOCK_DDL;
BACKUP STAGE BLOCK_COMMIT;
connection node_1b;
connection node_2;
GRANT SELECT (c1) ON test.t2 TO u2;
connection node_1b;
connection node_1;
BACKUP STAGE END;
connection node_1b;
SELECT User, Column_name FROM mysql.columns_priv WHERE User = 'u2';
User	Column_name
u2	c1
disconnect node_1a;
disconnect node_1b;
connection node_1;
DROP USER u1, u2;
DROP TABLE t1, t2;
