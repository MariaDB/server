#
# MGL-326: a Galera or raft node that applies the events of an asynchronous
# replication master with parallel replication crashes in debug builds with
#   handler.cc: ha_rollback_trans: Assertion
#   `!(thd->rgi_slave && !thd->rgi_slave->worker_error &&
#      thd->rgi_slave->did_mark_start_commit) || ...' failed.
#
# The parallel worker calls mark_start_commit() before it applies the
# group-ending event. When the commit then fails certification against an
# earlier write set of the cluster, wsrep_after_statement() rolls back the
# transaction (wsrep::transaction::after_statement -> bf_rollback) while
# worker_error is still 0.
#
# Node 3 is a native MariaDB server and the async master. Node 2 is a cluster
# node and the replica, with slave_parallel_threads=2.
#

--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc
--source include/log_bin.inc
--source include/force_restart.inc

--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2

--connection node_2a
--source include/galera_cluster.inc

ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;

--connect node_3, 127.0.0.1, root, , test, $NODE_MYPORT_3
--connection node_3
RESET MASTER;

--connection node_2a
--disable_query_log
--eval CHANGE MASTER TO MASTER_HOST='127.0.0.1', MASTER_USER='root', MASTER_SSL_VERIFY_SERVER_CERT=0, MASTER_PORT=$NODE_MYPORT_3;
--enable_query_log
START SLAVE;

--connection node_3
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY, f2 CHAR(1)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'a');

--connection node_2a
--let $wait_condition = SELECT COUNT(*) = 1 FROM test.t1;
--source include/wait_condition.inc

--connection node_1
--let $wait_condition = SELECT COUNT(*) = 1 FROM test.t1;
--source include/wait_condition.inc

#
# Hold the applier of node 2, so that the next write set of node 1 is ordered
# first in the cluster but is not applied in node 2.
#
--connection node_2a
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";

--connection node_1
UPDATE t1 SET f2 = 'b' WHERE f1 = 1;

--connection node_2a
SET SESSION wsrep_sync_wait = 0;
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";

#
# The async master updates the same row. The replica applies it in a parallel
# worker, and the commit fails certification against the write set of node 1.
#
--connection node_3
UPDATE t1 SET f2 = 'c' WHERE f1 = 1;

--connection node_2a
# wait until the commit of the parallel worker has failed certification
--let $wait_condition = SELECT VARIABLE_VALUE >= 1 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_local_cert_failures'
--source include/wait_condition.inc

SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";

#
# The replica retries the transaction and both nodes end with the value of
# the async master.
#
--let $wait_condition = SELECT COUNT(*) = 1 FROM test.t1 WHERE f2 = 'c';
--source include/wait_condition.inc

--connection node_1
SET SESSION wsrep_sync_wait = 15;
SELECT * FROM t1;

--connection node_2a
SET DEBUG_SYNC = "RESET";
STOP SLAVE;
RESET SLAVE;
SET GLOBAL gtid_slave_pos = "";

DROP TABLE t1;

--connection node_3
--source include/kill_binlog_dump_threads.inc
--source include/reset_master_slave.inc

--connection node_1
--disconnect node_2a
--disconnect node_3
