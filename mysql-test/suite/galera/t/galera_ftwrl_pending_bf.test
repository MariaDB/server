#
# An applier must not wait behind a pending FLUSH TABLES WITH READ LOCK.
# FTWRL waits for a local INSERT, and the INSERT waits in the provider
# order for the applier. FTWRL fails with ER_LOCK_WAIT_TIMEOUT if the
# applier waits for it.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
SET SESSION wsrep_sync_wait= 0;

# Hold the applier before it opens t1.
SET GLOBAL debug_dbug= '+d,sync.wsrep_apply_cb';
--connection node_2
INSERT INTO t1 VALUES (1);
--connection node_1
SET DEBUG_SYNC= 'now WAIT_FOR sync.wsrep_apply_cb_reached';
SET GLOBAL debug_dbug= '';

# The local INSERT is ordered after the applier.
--let $replicated= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_replicated'`
--connect (node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1)
SET SESSION wsrep_sync_wait= 0;
--send INSERT INTO t1 VALUES (2)
--connection node_1
--let $wait_condition= SELECT VARIABLE_VALUE > $replicated FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_replicated'
--source include/wait_condition.inc

--connect (node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1)
SET SESSION wsrep_sync_wait= 0;
SET SESSION lock_wait_timeout= 10;
--send FLUSH TABLES WITH READ LOCK
--connection node_1
--let $wait_condition= SELECT COUNT(*) = 1 FROM INFORMATION_SCHEMA.PROCESSLIST WHERE INFO = 'FLUSH TABLES WITH READ LOCK' AND STATE = 'Waiting for backup lock'
--source include/wait_condition.inc

SET DEBUG_SYNC= 'now SIGNAL signal.wsrep_apply_cb';

--connection node_1b
--reap
UNLOCK TABLES;
--connection node_1a
--reap

--connection node_1
SET DEBUG_SYNC= 'RESET';
SELECT COUNT(*) FROM t1;
--connection node_2
--let $wait_condition= SELECT COUNT(*) = 2 FROM t1
--source include/wait_condition.inc
DROP TABLE t1;

--disconnect node_1a
--disconnect node_1b
