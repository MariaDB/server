#
# Galera write set keys across every data type MariaDB supports.
#
# MDEV-41073: a write set key whose collation weight form does not fit the
# 3500 byte key buffer.
#
# Three CHAR(255) utf8mb4_unicode_ci columns in a foreign key. U+FB04 is a
# ligature, one character of it expands to several collation weights, so the
# normalized form of the three columns is longer than the buffer.
#
# wsrep_store_key_val_for_row() cuts a row key that does not fit, but
# wsrep_rec_get_foreign_key() returned DB_ERROR for the same condition. The
# caller turned that into a fatal error and the server went down.
#
# Both paths now cut the key, and both tell the client that the key was cut.
# The condition is raised as a warning, which a statement running under
# strict mode turns into an error, so a statement whose key is cut reports
# ER_TOO_LONG_KEY. IGNORE and a non strict sql_mode leave it a warning and
# the row goes in.
#
# A cut key is not free: two rows whose key values are equal up to the cut
# get the same key and conflict in certification although they are different
# rows. The middle part of the test shows that.
#
# The rest of the test walks every data type built into the server through
# the same key-building code: as a primary key, as a unique key, as a plain
# key on a table with no primary key (the only case where wsrep certifies a
# non-unique key), as a foreign key referencing a primary key, and as a
# foreign key referencing a unique key. It also covers a foreign key with
# a NULL column, and the types that are excluded from some or all of that
# (TEXT/BLOB/JSON: prefix keys only, no foreign key; GEOMETRY: prefix keys
# only and no foreign key, except its fixed length POINT subtype, which
# takes a whole-column key but still no foreign key).
#
# UUID and INET6 come from the mandatory type_uuid and type_inet plugins
# rather than the server proper; galera_ws_datatypes_plugin.test covers
# them the same way.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc

# The key is cut on whichever node builds it, so both error logs get the
# warning and both need the suppression.
--connection node_1
call mtr.add_suppression("WSREP: Write set key for table .* was cut to");
--connection node_2
call mtr.add_suppression("WSREP: Write set key for table .* was cut to");

--connection node_1
CREATE TABLE p (a CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                b CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                c CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                d INT,
                PRIMARY KEY (a,b,c)) ENGINE=InnoDB;

CREATE TABLE ch (id INT AUTO_INCREMENT PRIMARY KEY,
                 a CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 b CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 c CHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 KEY k (a,b,c),
                 FOREIGN KEY (a,b,c) REFERENCES p (a,b,c)) ENGINE=InnoDB;

# 255 ligature characters. Each one expands to several collation weights.
SET @v = REPEAT(_utf8mb4 0xEFAC84, 255) COLLATE utf8mb4_unicode_ci;
# The same value with the last character replaced. Columns a and b already
# fill the buffer, so the difference is past the cut.
SET @v2 = CONCAT(REPEAT(_utf8mb4 0xEFAC84, 254),
                 _utf8mb4 0xEFAC80) COLLATE utf8mb4_unicode_ci;

--echo #
--echo # Under strict mode a cut key fails the statement
--echo #
--error ER_TOO_LONG_KEY
INSERT INTO p (a,b,c,d) VALUES (@v, @v, @v, 1);

--echo #
--echo # INSERT IGNORE turns the error back into a warning and the row goes in
--echo #
INSERT IGNORE INTO p (a,b,c,d) VALUES (@v, @v, @v, 1);
SHOW WARNINGS;

--echo #
--echo # The child row goes down the foreign key path and behaves the same.
--echo # Before the fix this statement took the server down with
--echo # "[FATAL] InnoDB: Unknown error Generic error".
--echo #
--error ER_TOO_LONG_KEY
INSERT INTO ch (a,b,c) VALUES (@v, @v, @v);

INSERT IGNORE INTO ch (a,b,c) VALUES (@v, @v, @v);
SHOW WARNINGS;

--echo #
--echo # Without strict mode the client also only gets the warning
--echo #
SET SESSION sql_mode = '';

SELECT COUNT(*) AS EXPECT_1 FROM p;
SELECT COUNT(*) AS EXPECT_1 FROM ch;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM ch;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM p;
SELECT COUNT(*) AS EXPECT_1 FROM ch;

--echo #
--echo # A second parent row that differs only past the cut
--echo #
--connection node_1
INSERT INTO p (a,b,c,d) VALUES (@v, @v, @v2, 2);
SELECT COUNT(*) AS EXPECT_2 FROM p;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM p;
--source include/wait_condition.inc
# User variables belong to one connection, set them here as well.
SET @v = REPEAT(_utf8mb4 0xEFAC84, 255) COLLATE utf8mb4_unicode_ci;
SET @v2 = CONCAT(REPEAT(_utf8mb4 0xEFAC84, 254),
                 _utf8mb4 0xEFAC80) COLLATE utf8mb4_unicode_ci;

--echo #
--echo # An UPDATE under strict mode fails with the same error
--echo #
--connection node_1
SET SESSION sql_mode = DEFAULT;
--error ER_TOO_LONG_KEY
UPDATE p SET d = 9 WHERE a = @v AND b = @v AND c = @v;

--echo #
--echo # UPDATE IGNORE turns it back into a warning as well
--echo #
UPDATE IGNORE p SET d = 9 WHERE a = @v AND b = @v AND c = @v;
SHOW WARNINGS;

--echo #
--echo # Without strict mode the same statement gets the warning and runs.
--echo # False positive. The two rows are different rows, but their keys are
--echo # equal up to the cut, so the transaction on node_1 loses
--echo # certification against the one on node_2.
--echo #
--connection node_1
SET SESSION sql_mode = '';
--connection node_2
SET SESSION sql_mode = '';

#
# The write set of node_1 has to be replicated while the one from node_2 is
# still inside the certification interval of node_1, otherwise node_1 has
# already seen it and there is nothing left to certify against. Hold the
# write set from node_2 in front of the local monitor on node_1 until the
# commit on node_1 has been sent.
#
--connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1
--connection node_1a
SET SESSION wsrep_sync_wait = 0;
--let $galera_sync_point = local_monitor_slave_enter_sync
--source include/galera_set_sync_point.inc

--connection node_1
BEGIN;
UPDATE p SET d = 10 WHERE a = @v AND b = @v AND c = @v;

--connection node_2
UPDATE p SET d = 20 WHERE a = @v AND b = @v AND c = @v2;

--connection node_1a
--source include/galera_wait_sync_point.inc
--source include/galera_clear_sync_point.inc

--connection node_1
--send COMMIT

--connection node_1a
--let $galera_sync_point = local_monitor_slave_enter_sync
--source include/galera_signal_sync_point.inc

--connection node_1
--error ER_LOCK_DEADLOCK
--reap

--echo # Only the update from node_2 is there
--connection node_1
--let $wait_condition = SELECT COUNT(*) = 1 FROM p WHERE d = 20;
--source include/wait_condition.inc
SELECT d FROM p ORDER BY d;

--echo #
--echo # Short values leave the key inside the buffer. The same pattern on
--echo # two different rows then commits.
--echo #
--connection node_1
CREATE TABLE p2 (a CHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 d INT,
                 PRIMARY KEY (a)) ENGINE=InnoDB;
INSERT INTO p2 (a,d) VALUES ('aaaaaaaa', 1), ('aaaaaaab', 2);

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM p2;
--source include/wait_condition.inc

--connection node_1a
--let $galera_sync_point = local_monitor_slave_enter_sync
--source include/galera_set_sync_point.inc

--connection node_1
BEGIN;
UPDATE p2 SET d = 10 WHERE a = 'aaaaaaaa';

--connection node_2
UPDATE p2 SET d = 20 WHERE a = 'aaaaaaab';

--connection node_1a
--source include/galera_wait_sync_point.inc
--source include/galera_clear_sync_point.inc

--connection node_1
--send COMMIT

--connection node_1a
--let $galera_sync_point = local_monitor_slave_enter_sync
--source include/galera_signal_sync_point.inc

--connection node_1
--reap
--let $wait_condition = SELECT COUNT(*) = 1 FROM p2 WHERE d = 20;
--source include/wait_condition.inc
SELECT d FROM p2 ORDER BY d;

--echo #
--echo # Foreign keys on the other string types. InnoDB needs the whole
--echo # column in a foreign key, so TEXT and BLOB cannot take part: they
--echo # can only be indexed by a prefix. That leaves VARCHAR, VARBINARY and
--echo # BINARY beside the CHAR columns above.
--echo #
--connection node_1
SET SESSION sql_mode = DEFAULT;

CREATE TABLE fp_v (a VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   b VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   c VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   d INT,
                   PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE fc_v (id INT AUTO_INCREMENT PRIMARY KEY,
                   a VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   b VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   c VARCHAR(255) CHARACTER SET utf8mb4
                     COLLATE utf8mb4_unicode_ci,
                   KEY k (a,b,c),
                   FOREIGN KEY (a,b,c) REFERENCES fp_v (a,b,c)) ENGINE=InnoDB;

--echo # VARCHAR parent, row key path
--error ER_TOO_LONG_KEY
INSERT INTO fp_v (a,b,c,d) VALUES (@v, @v, @v, 1);
INSERT IGNORE INTO fp_v (a,b,c,d) VALUES (@v, @v, @v, 1);
SHOW WARNINGS;

--echo # VARCHAR child, foreign key path
--error ER_TOO_LONG_KEY
INSERT INTO fc_v (a,b,c) VALUES (@v, @v, @v);
INSERT IGNORE INTO fc_v (a,b,c) VALUES (@v, @v, @v);
SHOW WARNINGS;

--echo # BINARY and VARBINARY are not collated, so the key stays inside the
--echo # buffer and both statements run
CREATE TABLE fp_b (a BINARY(255),
                   b VARBINARY(1000),
                   c VARBINARY(1000),
                   d INT,
                   PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE fc_b (id INT AUTO_INCREMENT PRIMARY KEY,
                   a BINARY(255),
                   b VARBINARY(1000),
                   c VARBINARY(1000),
                   KEY k (a,b,c),
                   FOREIGN KEY (a,b,c) REFERENCES fp_b (a,b,c)) ENGINE=InnoDB;

SET @b255 = REPEAT('a', 255);
SET @b1000 = REPEAT('a', 1000);
INSERT INTO fp_b (a,b,c,d) VALUES (@b255, @b1000, @b1000, 1);
INSERT INTO fc_b (a,b,c) VALUES (@b255, @b1000, @b1000);

--echo # TEXT and BLOB can only be indexed by a prefix, and InnoDB refuses a
--echo # foreign key on such a column
--error ER_CANT_CREATE_TABLE
CREATE TABLE fc_t (id INT AUTO_INCREMENT PRIMARY KEY,
                   a TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                   KEY k (a(255)),
                   FOREIGN KEY (a) REFERENCES fp_v (a)) ENGINE=InnoDB;

--echo # BLOB behaves the same way
--error ER_CANT_CREATE_TABLE
CREATE TABLE fc_bl (id INT AUTO_INCREMENT PRIMARY KEY,
                   a BLOB,
                   KEY k (a(255)),
                   FOREIGN KEY (a) REFERENCES fp_b (a)) ENGINE=InnoDB;

--echo # JSON is stored as LONGTEXT and behaves the same way
--error ER_CANT_CREATE_TABLE
CREATE TABLE fc_j (id INT AUTO_INCREMENT PRIMARY KEY,
                   a JSON,
                   KEY k (a(255)),
                   FOREIGN KEY (a) REFERENCES fp_v (a)) ENGINE=InnoDB;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM fc_b;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM fp_v;
SELECT COUNT(*) AS EXPECT_1 FROM fc_v;
SELECT COUNT(*) AS EXPECT_1 FROM fp_b;
SELECT COUNT(*) AS EXPECT_1 FROM fc_b;

--echo #
--echo # Foreign keys on FLOAT, DOUBLE, TIMESTAMP, DATE and DATETIME. These
--echo # are fixed width and not collated, so wsrep_store_key_val_for_row()
--echo # and wsrep_rec_get_foreign_key() never cut the key for them; the
--echo # point is to show the same key-building code path used above still
--echo # produces a working, replicated foreign key for these types.
--echo #
--connection node_1
CREATE TABLE fp_num (a FLOAT,
                     b DOUBLE,
                     c TIMESTAMP,
                     dt DATE,
                     e DATETIME,
                     f INT,
                     PRIMARY KEY (a,b,c,dt,e)) ENGINE=InnoDB;
CREATE TABLE fc_num (id INT AUTO_INCREMENT PRIMARY KEY,
                     a FLOAT,
                     b DOUBLE,
                     c TIMESTAMP,
                     dt DATE,
                     e DATETIME,
                     KEY k (a,b,c,dt,e),
                     FOREIGN KEY (a,b,c,dt,e)
                     REFERENCES fp_num (a,b,c,dt,e)) ENGINE=InnoDB;

INSERT INTO fp_num (a,b,c,dt,e,f) VALUES
  (1.5, 2.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00', 1);
INSERT INTO fc_num (a,b,c,dt,e) VALUES
  (1.5, 2.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00');

--echo # No matching parent row for this combination, the insert is rejected
--error ER_NO_REFERENCED_ROW_2
INSERT INTO fc_num (a,b,c,dt,e) VALUES
  (9.5, 9.25, '2026-01-01 10:00:00', '2026-01-01', '2026-01-01 10:00:00');

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM fc_num;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM fp_num;
SELECT COUNT(*) AS EXPECT_1 FROM fc_num;

--echo #
--echo # Foreign key where part of the key is NULL. InnoDB foreign keys use
--echo # MATCH SIMPLE: when any column of a multi-column foreign key is
--echo # NULL, the row is not checked against the parent at all, whether or
--echo # not a matching parent row exists.
--echo #
--connection node_1
CREATE TABLE fp_n (a INT, b INT, c INT, d INT,
                   PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE fc_n (id INT AUTO_INCREMENT PRIMARY KEY,
                   a INT, b INT, c INT,
                   KEY k (a,b,c),
                   FOREIGN KEY (a,b,c) REFERENCES fp_n (a,b,c)) ENGINE=InnoDB;

--echo # No parent row for (1,2,3) at all, but c is NULL so the row is
--echo # accepted anyway
INSERT INTO fc_n (a,b,c) VALUES (1,2,NULL);

--echo # A parent row exists for (10,20,30), but the child is still not
--echo # checked against it because c is NULL
INSERT INTO fp_n (a,b,c,d) VALUES (10,20,30,1);
INSERT INTO fc_n (a,b,c) VALUES (10,20,NULL);

--echo # A row with every foreign key column NULL is accepted the same way
INSERT INTO fc_n (a,b,c) VALUES (NULL,NULL,NULL);

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 3 FROM fc_n;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM fp_n;
SELECT COUNT(*) AS EXPECT_3 FROM fc_n;

--echo #
--echo # The same MATCH SIMPLE rule with only the last column of the
--echo # foreign key nullable, the other columns NOT NULL. Position does
--echo # not matter: any NULL column, first, middle or last, is enough to
--echo # skip the check.
--echo #
--connection node_1
CREATE TABLE mfp (a INT, b INT, c INT, PRIMARY KEY (a,b,c)) ENGINE=InnoDB;
CREATE TABLE mfc (id INT AUTO_INCREMENT PRIMARY KEY,
                  a INT NOT NULL, b INT NOT NULL, c INT,
                  KEY k (a,b,c),
                  FOREIGN KEY (a,b,c) REFERENCES mfp (a,b,c)) ENGINE=InnoDB;

INSERT INTO mfp VALUES (1,2,3);

--echo # Last column (c) is NULL: no matching parent row required
INSERT INTO mfc (a,b,c) VALUES (9,9,NULL);

--echo # Last column (c) is non-NULL and matches: the constraint is
--echo # checked and passes
INSERT INTO mfc (a,b,c) VALUES (1,2,3);

--echo # Last column (c) is non-NULL and does not match: the constraint is
--echo # checked and fails
--error ER_NO_REFERENCED_ROW_2
INSERT INTO mfc (a,b,c) VALUES (1,2,99);

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM mfc;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM mfp;
SELECT COUNT(*) AS EXPECT_2 FROM mfc;

--echo #
--echo # Every remaining fixed width data type built into the server, in a
--echo # primary key, in a unique key, in a plain key on a table with no
--echo # primary key, and in a foreign key that references a primary key
--echo # and one that references a unique key. wsrep_store_key_val_for_row()
--echo # copies these types with a plain memcpy (TINYINT .. VARBINARY below)
--echo # or through the ENUM/SET branch that skips collation; FLOAT, DOUBLE,
--echo # TIMESTAMP, DATE and DATETIME were already covered above. UUID and
--echo # INET6 are in galera_ws_datatypes_plugin.test.
--echo #
--connection node_1
CREATE TABLE g1_pk (ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
                    bi BIGINT, de DECIMAL(10,2), bt BIT(8),
                    bn BINARY(4), vb VARBINARY(8), f INT,
                    PRIMARY KEY (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;
CREATE TABLE g1_pk_child (id INT AUTO_INCREMENT PRIMARY KEY,
                    ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
                    bi BIGINT, de DECIMAL(10,2), bt BIT(8),
                    bn BINARY(4), vb VARBINARY(8),
                    KEY k (ti,si,mi,ii,bi,de,bt,bn,vb),
                    FOREIGN KEY (ti,si,mi,ii,bi,de,bt,bn,vb)
                      REFERENCES g1_pk (ti,si,mi,ii,bi,de,bt,bn,vb))
                    ENGINE=InnoDB;
CREATE TABLE g1_uk (id INT AUTO_INCREMENT PRIMARY KEY,
                    ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
                    bi BIGINT, de DECIMAL(10,2), bt BIT(8),
                    bn BINARY(4), vb VARBINARY(8),
                    UNIQUE KEY u (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;
CREATE TABLE g1_uk_child (id INT AUTO_INCREMENT PRIMARY KEY,
                    ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
                    bi BIGINT, de DECIMAL(10,2), bt BIT(8),
                    bn BINARY(4), vb VARBINARY(8),
                    KEY k (ti,si,mi,ii,bi,de,bt,bn,vb),
                    FOREIGN KEY (ti,si,mi,ii,bi,de,bt,bn,vb)
                      REFERENCES g1_uk (ti,si,mi,ii,bi,de,bt,bn,vb))
                    ENGINE=InnoDB;
CREATE TABLE g1_key (ti TINYINT, si SMALLINT, mi MEDIUMINT, ii INT,
                    bi BIGINT, de DECIMAL(10,2), bt BIT(8),
                    bn BINARY(4), vb VARBINARY(8),
                    KEY k (ti,si,mi,ii,bi,de,bt,bn,vb)) ENGINE=InnoDB;

--echo # TINYINT, SMALLINT, MEDIUMINT, INT, BIGINT, DECIMAL, BIT, BINARY,
--echo # VARBINARY together, in a primary key and a foreign key that
--echo # references it
INSERT INTO g1_pk (ti,si,mi,ii,bi,de,bt,bn,vb,f)
  VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh',1);
INSERT INTO g1_pk_child (ti,si,mi,ii,bi,de,bt,bn,vb)
  VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');

--echo # The same types in a unique key and a foreign key that references it
INSERT INTO g1_uk (ti,si,mi,ii,bi,de,bt,bn,vb)
  VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');
INSERT INTO g1_uk_child (ti,si,mi,ii,bi,de,bt,bn,vb)
  VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');

--echo # The same types in a plain, non-unique key on a table with no
--echo # primary key
INSERT INTO g1_key (ti,si,mi,ii,bi,de,bt,bn,vb)
  VALUES (1,2,3,4,5,6.50,5,'ab','abcdefgh');

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM g1_key;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM g1_pk;
SELECT COUNT(*) AS EXPECT_1 FROM g1_pk_child;
SELECT COUNT(*) AS EXPECT_1 FROM g1_uk;
SELECT COUNT(*) AS EXPECT_1 FROM g1_uk_child;
SELECT COUNT(*) AS EXPECT_1 FROM g1_key;

--echo #
--echo # TIME, YEAR, ENUM and SET, the same way. UUID and INET6 are provided
--echo # by the mandatory type_uuid and type_inet plugins rather than being
--echo # built into the server proper; they are covered by
--echo # galera_ws_datatypes_plugin.test instead.
--echo #
--connection node_1
CREATE TABLE g2_pk (tm TIME, yr YEAR, en ENUM('a','b','c'),
                    st SET('a','b','c'), f INT,
                    PRIMARY KEY (tm,yr,en,st)) ENGINE=InnoDB;
CREATE TABLE g2_pk_child (id INT AUTO_INCREMENT PRIMARY KEY,
                    tm TIME, yr YEAR, en ENUM('a','b','c'),
                    st SET('a','b','c'),
                    KEY k (tm,yr,en,st),
                    FOREIGN KEY (tm,yr,en,st)
                      REFERENCES g2_pk (tm,yr,en,st)) ENGINE=InnoDB;
CREATE TABLE g2_uk (id INT AUTO_INCREMENT PRIMARY KEY,
                    tm TIME, yr YEAR, en ENUM('a','b','c'),
                    st SET('a','b','c'),
                    UNIQUE KEY u (tm,yr,en,st)) ENGINE=InnoDB;
CREATE TABLE g2_uk_child (id INT AUTO_INCREMENT PRIMARY KEY,
                    tm TIME, yr YEAR, en ENUM('a','b','c'),
                    st SET('a','b','c'),
                    KEY k (tm,yr,en,st),
                    FOREIGN KEY (tm,yr,en,st)
                      REFERENCES g2_uk (tm,yr,en,st)) ENGINE=InnoDB;
CREATE TABLE g2_key (tm TIME, yr YEAR, en ENUM('a','b','c'),
                    st SET('a','b','c'),
                    KEY k (tm,yr,en,st)) ENGINE=InnoDB;

INSERT INTO g2_pk (tm,yr,en,st,f)
  VALUES ('10:00:00',2026,'b','a,c',1);
INSERT INTO g2_pk_child (tm,yr,en,st)
  VALUES ('10:00:00',2026,'b','a,c');
INSERT INTO g2_uk (tm,yr,en,st)
  VALUES ('10:00:00',2026,'b','a,c');
INSERT INTO g2_uk_child (tm,yr,en,st)
  VALUES ('10:00:00',2026,'b','a,c');
INSERT INTO g2_key (tm,yr,en,st)
  VALUES ('10:00:00',2026,'b','a,c');

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM g2_key;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM g2_pk;
SELECT COUNT(*) AS EXPECT_1 FROM g2_pk_child;
SELECT COUNT(*) AS EXPECT_1 FROM g2_uk;
SELECT COUNT(*) AS EXPECT_1 FROM g2_uk_child;
SELECT COUNT(*) AS EXPECT_1 FROM g2_key;

--echo #
--echo # SERIAL, an alias for BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE,
--echo # as a primary key
--echo #
--connection node_1
CREATE TABLE g_serial (id SERIAL PRIMARY KEY, f INT) ENGINE=InnoDB;
INSERT INTO g_serial (f) VALUES (1);

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM g_serial;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM g_serial;

--echo #
--echo # Other string types and prefix indexes outside a foreign key. The
--echo # indexes are
--echo # unique because wsrep_append_keys() only builds a key for a unique
--echo # index, one referenced by a foreign key, or any index of a table
--echo # without a primary key. The key is cut when the collation weights of
--echo # the indexed bytes pass the buffer; the binary types are not
--echo # collated, so they never are.
--echo #
--connection node_1
SET SESSION sql_mode = DEFAULT;

SET @c200 = REPEAT(_utf8mb4 0xEFAC84, 200) COLLATE utf8mb4_unicode_ci;
SET @c768 = REPEAT(_utf8mb4 0xEFAC84, 768) COLLATE utf8mb4_unicode_ci;
SET @bin255 = REPEAT('a', 255);
SET @bin3000 = REPEAT('a', 3000);

CREATE TABLE k1 (id INT AUTO_INCREMENT PRIMARY KEY,
                 v VARCHAR(768) CHARACTER SET utf8mb4
                   COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (v)) ENGINE=InnoDB;
CREATE TABLE k2 (id INT AUTO_INCREMENT PRIMARY KEY,
                 t TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (t(768))) ENGINE=InnoDB;
CREATE TABLE k3 (id INT AUTO_INCREMENT PRIMARY KEY,
                 c CHAR(255) CHARACTER SET utf8mb4
                   COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (c(200))) ENGINE=InnoDB;
CREATE TABLE k4 (id INT AUTO_INCREMENT PRIMARY KEY,
                 v VARCHAR(768) CHARACTER SET utf8mb4
                   COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (v(700))) ENGINE=InnoDB;
CREATE TABLE k5 (id INT AUTO_INCREMENT PRIMARY KEY,
                 b BLOB,
                 UNIQUE KEY (b(3000))) ENGINE=InnoDB;
CREATE TABLE k6 (id INT AUTO_INCREMENT PRIMARY KEY,
                 bn BINARY(255),
                 vb VARBINARY(3000),
                 UNIQUE KEY (bn),
                 UNIQUE KEY (vb(3000))) ENGINE=InnoDB;
CREATE TABLE k7 (id INT AUTO_INCREMENT PRIMARY KEY,
                 t TINYTEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (t(50))) ENGINE=InnoDB;
CREATE TABLE k8 (id INT AUTO_INCREMENT PRIMARY KEY,
                 t MEDIUMTEXT CHARACTER SET utf8mb4
                   COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (t(768))) ENGINE=InnoDB;
CREATE TABLE k9 (id INT AUTO_INCREMENT PRIMARY KEY,
                 t LONGTEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
                 UNIQUE KEY (t(768))) ENGINE=InnoDB;
CREATE TABLE k10 (id INT AUTO_INCREMENT PRIMARY KEY,
                 b TINYBLOB,
                 UNIQUE KEY (b(50))) ENGINE=InnoDB;
CREATE TABLE k11 (id INT AUTO_INCREMENT PRIMARY KEY,
                 b MEDIUMBLOB,
                 UNIQUE KEY (b(3000))) ENGINE=InnoDB;
CREATE TABLE k12 (id INT AUTO_INCREMENT PRIMARY KEY,
                 b LONGBLOB,
                 UNIQUE KEY (b(3000))) ENGINE=InnoDB;
CREATE TABLE k13 (id INT AUTO_INCREMENT PRIMARY KEY,
                 j JSON,
                 UNIQUE KEY (j(768))) ENGINE=InnoDB;

--echo # VARCHAR, whole column
--error ER_TOO_LONG_KEY
INSERT INTO k1 (v) VALUES (@c768);

--echo # TEXT, prefix
--error ER_TOO_LONG_KEY
INSERT INTO k2 (t) VALUES (@c768);

--echo # CHAR, prefix short enough to stay inside the buffer
INSERT INTO k3 (c) VALUES (@c200);

--echo # VARCHAR, prefix
--error ER_TOO_LONG_KEY
INSERT INTO k4 (v) VALUES (@c768);

--echo # BLOB, prefix. Bytes are not collated, so nothing is cut
INSERT INTO k5 (b) VALUES (@bin3000);

--echo # BINARY and VARBINARY, whole column and prefix
INSERT INTO k6 (bn, vb) VALUES (@bin255, @bin3000);

SET @tiny = REPEAT('a', 50);

--echo # TINYTEXT, prefix short enough to stay inside the buffer
INSERT INTO k7 (t) VALUES (@tiny);

--echo # MEDIUMTEXT, prefix short enough to stay inside the buffer
INSERT INTO k8 (t) VALUES (@c200);

--echo # LONGTEXT, prefix short enough to stay inside the buffer
INSERT INTO k9 (t) VALUES (@c200);

--echo # TINYBLOB, prefix. Bytes are not collated, so nothing is cut
INSERT INTO k10 (b) VALUES (@tiny);

--echo # MEDIUMBLOB, prefix
INSERT INTO k11 (b) VALUES (@bin3000);

--echo # LONGBLOB, prefix
INSERT INTO k12 (b) VALUES (@bin3000);

--echo # JSON, stored as LONGTEXT with a validity check, prefix
INSERT INTO k13 (j) VALUES ('{"a":1}');

--echo # Without strict mode the cut ones go in with a warning
SET SESSION sql_mode = '';
INSERT INTO k1 (v) VALUES (@c768);
SHOW WARNINGS;
INSERT INTO k2 (t) VALUES (@c768);
SHOW WARNINGS;
INSERT INTO k4 (v) VALUES (@c768);
SHOW WARNINGS;
SET SESSION sql_mode = DEFAULT;

--echo # The rows the server accepted reach node_2
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM k6;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM k1;
SELECT COUNT(*) AS EXPECT_1 FROM k2;
SELECT COUNT(*) AS EXPECT_1 FROM k3;
SELECT COUNT(*) AS EXPECT_1 FROM k4;
SELECT COUNT(*) AS EXPECT_1 FROM k5;
SELECT COUNT(*) AS EXPECT_1 FROM k6;
SELECT COUNT(*) AS EXPECT_1 FROM k7;
SELECT COUNT(*) AS EXPECT_1 FROM k8;
SELECT COUNT(*) AS EXPECT_1 FROM k9;
SELECT COUNT(*) AS EXPECT_1 FROM k10;
SELECT COUNT(*) AS EXPECT_1 FROM k11;
SELECT COUNT(*) AS EXPECT_1 FROM k12;
SELECT COUNT(*) AS EXPECT_1 FROM k13;

--echo #
--echo # GEOMETRY is stored as BLOB and behaves the same way: a key needs an
--echo # explicit prefix length, and a foreign key is rejected regardless of
--echo # length. POINT is fixed length (an SRID plus one X/Y pair), so it can
--echo # be a whole-column primary or unique key without a prefix, but a
--echo # foreign key on it is still rejected.
--echo #
--connection node_1
--error ER_BLOB_KEY_WITHOUT_LENGTH
CREATE TABLE g_pk (g GEOMETRY NOT NULL, PRIMARY KEY (g)) ENGINE=InnoDB;

CREATE TABLE g_uk (id INT AUTO_INCREMENT PRIMARY KEY,
                   g GEOMETRY NOT NULL, UNIQUE KEY (g(25))) ENGINE=InnoDB;
INSERT INTO g_uk (g) VALUES (ST_PointFromText('POINT(1 1)'));

--error ER_CANT_CREATE_TABLE
CREATE TABLE g_fk (id INT AUTO_INCREMENT PRIMARY KEY,
                   g GEOMETRY,
                   KEY k (g(25)),
                   FOREIGN KEY (g) REFERENCES g_uk (g)) ENGINE=InnoDB;

CREATE TABLE g_pk2 (p POINT NOT NULL, PRIMARY KEY (p)) ENGINE=InnoDB;
INSERT INTO g_pk2 (p) VALUES (ST_PointFromText('POINT(1 1)'));

CREATE TABLE g_uk2 (id INT AUTO_INCREMENT PRIMARY KEY,
                   p POINT NOT NULL, UNIQUE KEY (p)) ENGINE=InnoDB;
INSERT INTO g_uk2 (p) VALUES (ST_PointFromText('POINT(1 1)'));

--error ER_CANT_CREATE_TABLE
CREATE TABLE g_fk2 (id INT AUTO_INCREMENT PRIMARY KEY,
                   p POINT,
                   KEY k (p),
                   FOREIGN KEY (p) REFERENCES g_pk2 (p)) ENGINE=InnoDB;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM g_uk2;
--source include/wait_condition.inc
SELECT COUNT(*) AS EXPECT_1 FROM g_uk;
SELECT COUNT(*) AS EXPECT_1 FROM g_pk2;
SELECT COUNT(*) AS EXPECT_1 FROM g_uk2;

--connection node_1
DROP TABLE ch, p;
DROP TABLE p2;
DROP TABLE fc_v, fp_v;
DROP TABLE fc_b, fp_b;
DROP TABLE fc_num, fp_num;
DROP TABLE fc_n, fp_n;
DROP TABLE mfc, mfp;
DROP TABLE g1_pk_child, g1_pk, g1_uk_child, g1_uk, g1_key;
DROP TABLE g2_pk_child, g2_pk, g2_uk_child, g2_uk, g2_key;
DROP TABLE g_serial;
DROP TABLE g_uk, g_pk2, g_uk2;
DROP TABLE k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13;
--disconnect node_1a

--source include/galera_end.inc
--echo # End of test
