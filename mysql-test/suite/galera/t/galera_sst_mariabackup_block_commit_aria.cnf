!include ../galera_2nodes.cnf

[mysqld]
wsrep_sst_method=mariabackup
wsrep_sst_auth="root:"

[sst]
transferfmt=@ENV.MTR_GALERA_TFMT
streamfmt=mbstream
inno-backup-opts="--dbug=+d,mariabackup_events"

[ENV]
# The donor's mariabackup runs this at BACKUP STAGE BLOCK_COMMIT. It waits
# only when the test enables it, not in the SST at cluster start.
after_backup_stage_block_commit=SET DEBUG_SYNC= IF((SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_VARIABLES WHERE VARIABLE_NAME = 'DEBUG_DBUG') LIKE '%sst_block_commit%', 'now SIGNAL sst_block_commit WAIT_FOR sst_continue', 'RESET')
