--source include/big_test.inc
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_aria.inc

#
# MDEV-40727 rsync SST donor stalls in a whole-host sync()
#
# The rsync SST donor flushes, to disk, every filesystem that the
# transfer reads from, before the transfer starts. That flush must
# also reach a filesystem holding a table placed outside the data
# directory by a per-table DATA DIRECTORY or INDEX DIRECTORY option.
# MyISAM and Aria place an OS symlink to the table file one level
# below the database directory; InnoDB instead leaves a small '.isl'
# file next to the tablespace, holding the real path as plain text -
# no OS symlink at all. This test forces a full SST and checks the
# donor's log for both cases.
#
# The per-database-directory transfer also needs to dereference these
# symlinks (--copy-links, not --links): the rsync daemon on the joiner
# cannot recreate an absolute symlink target as-is, so a MyISAM or
# Aria table placed by DATA DIRECTORY or INDEX DIRECTORY would
# otherwise come out unreadable after every rsync SST. This test
# checksums every table in database test on both nodes after the SST
# to check that all of them, not only t_aria and t_innodb, transferred
# with identical content.
#

--let $aria_data_dir = $MYSQLTEST_VARDIR/tmp/MDEV-40727_aria_data
--let $aria_index_dir = $MYSQLTEST_VARDIR/tmp/MDEV-40727_aria_index
--let $innodb_data_dir = $MYSQLTEST_VARDIR/tmp/MDEV-40727_innodb_data

--let $node_1=node_1
--let $node_2=node_2
--source include/auto_increment_offset_save.inc

--echo # Take node_2 down first: a per-table DATA/INDEX DIRECTORY names an
--echo # absolute host path, and mtr runs both nodes on the same host, so
--echo # creating the tables while node_2 is a live cluster member would
--echo # replicate the same CREATE TABLE to node_2 and make it race node_1
--echo # for the same external path. Node_2 must only ever receive these
--echo # tables as SST-transferred files, not as replicated DDL.

--connection node_2
--source include/shutdown_mysqld.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

# Dropping a table whose tablespace lives under a per-table DATA
# DIRECTORY logs this message; it is not a query failure.
CALL mtr.add_suppression("InnoDB: File .* was not found");

--exec rm -rf $aria_data_dir $aria_index_dir $innodb_data_dir
--exec mkdir -p $aria_data_dir $aria_index_dir $innodb_data_dir

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
eval CREATE TABLE t_aria (f1 INT PRIMARY KEY, f2 VARCHAR(100))
     ENGINE=Aria
     DATA DIRECTORY='$aria_data_dir'
     INDEX DIRECTORY='$aria_index_dir';

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
eval CREATE TABLE t_innodb (f1 INT PRIMARY KEY, f2 VARCHAR(100))
     ENGINE=InnoDB
     DATA DIRECTORY='$innodb_data_dir';

INSERT INTO t_aria VALUES (1, 'aria_row_1'), (2, 'aria_row_2');
INSERT INTO t_innodb VALUES (1, 'innodb_row_1'), (2, 'innodb_row_2');

--echo # Clean node_2's data directory so that a restart forces a full SST.
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mtr
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/performance_schema
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/test
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mysql
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data

--connection node_2
--source include/start_mysqld.inc

--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

SET SESSION wsrep_sync_wait = 15;

--echo # Check that every table in database test, not only t_aria and
--echo # t_innodb, has identical content on node_2 after the SST.

--connection node_1
--let $n_tables_node1 = `SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'test'`

--connection node_2
--let $n_tables_node2 = `SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'test'`

if ($n_tables_node1 != $n_tables_node2)
{
  --die Database test has a different number of tables on node_1 and node_2 after SST
}

--let $ctr = 1
while ($ctr <= $n_tables_node1)
{
  --connection node_1
  --let $tbl = query_get_value(SELECT table_name FROM information_schema.tables WHERE table_schema = 'test' ORDER BY table_name, table_name, $ctr)
  --let $checksum_node1 = query_get_value(CHECKSUM TABLE test.$tbl, Checksum, 1)

  --connection node_2
  --let $checksum_node2 = query_get_value(CHECKSUM TABLE test.$tbl, Checksum, 1)

  if ($checksum_node1 != $checksum_node2)
  {
    --die Table test.$tbl differs between node_1 and node_2 after SST
  }
  --inc $ctr
}

--connection node_2

--echo # Confirm the donor's rsync SST script flushed the filesystems
--echo # holding the Aria and InnoDB per-table directories, not only the
--echo # data directory itself.

--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN = Synced filesystem: $aria_data_dir
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--source include/search_pattern_in_file.inc

--let SEARCH_PATTERN = Synced filesystem: $aria_index_dir
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--source include/search_pattern_in_file.inc

--let SEARCH_PATTERN = Synced filesystem: $innodb_data_dir/test
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--source include/search_pattern_in_file.inc

--connection node_1
DROP TABLE t_aria, t_innodb;

--exec rm -rf $aria_data_dir $aria_index_dir $innodb_data_dir

--source include/auto_increment_offset_restore.inc
