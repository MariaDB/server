#
# MDEV-38999: Galera - stale reads
#
# See the comment above wsrep_must_sync_wait() in sql/wsrep_mysqld.cc for
# the mechanism and why a causal wait must stop being attempted once this
# transaction may hold a lock. This test proves the fix, and exercises the
# two transaction-start paths (explicit BEGIN and implicit autocommit=0)
# plus two bitmask values:
#
# 1. wsrep_sync_wait=2 (UPDATE/DELETE only): a standalone autocommit UPDATE
#    correctly blocks on the causal wait and times out while the applier on
#    node_2 is paused (control case). The same UPDATE, issued inside an
#    explicit BEGIN, must now time out the same way - before the fix it ran
#    immediately against a stale view instead - and the following ROLLBACK
#    must succeed cleanly, not inherit the same error.
# 2. The same UPDATE-after-BEGIN scenario again, but with the transaction
#    started implicitly via autocommit=0 instead of BEGIN.
# 3. wsrep_sync_wait=1 (READ only): two SELECTs in a row inside one explicit
#    transaction, with the applier paused in between. Since neither read
#    writes anything, both must independently wait and the second one must
#    time out too - nothing should be considered "already satisfied" just
#    because an earlier read in the same transaction already waited.
#
# A locking read (SELECT ... FOR UPDATE / LOCK IN SHARE MODE) and the
# stale-read gap specific to stored procedures are covered separately, in
# galera_MDEV-38999_locks.test and galera_MDEV-38999_sp.test.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (id INT PRIMARY KEY, f1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 100);

--connection node_2
# wsrep_sync_wait is SESSION-scoped: the galera suite's default .cnf already
# sets it (non-zero) for connections opened before this point, and SET GLOBAL
# would only affect *new* connections, not this one - so set it with SESSION
# directly on the connection that will run the statements below.
SET SESSION wsrep_sync_wait = 2;

--let $wait_condition = SELECT COUNT(*) = 1 FROM t1
--source include/wait_condition.inc

--source include/galera_mdev38999_init.inc

--echo #
--echo # Control case: standalone (autocommit) UPDATE correctly waits.
--echo #
--source include/galera_mdev38999_pause_applier.inc

--connection node_1
INSERT INTO t1 VALUES (2, 200);

--source include/galera_mdev38999_wait_applier_paused.inc

--connection node_2
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;

--source include/galera_mdev38999_resume_applier.inc

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM t1
--source include/wait_condition.inc

--echo #
--echo # Fixed case: the SAME UPDATE, issued inside an explicit BEGIN, must
--echo # still wait - bit 2 (UPDATE/DELETE) hasn't been satisfied yet in this
--echo # transaction (BEGIN only ever checks bit 1).
--echo #
--source include/galera_mdev38999_pause_applier.inc

--connection node_1
INSERT INTO t1 VALUES (3, 300);

--source include/galera_mdev38999_wait_applier_paused.inc

--connection node_2
BEGIN;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;
# The failed UPDATE never touched anything (it failed at the pre-check,
# before taking any lock), so this ROLLBACK must succeed cleanly - it must
# NOT inherit the UPDATE's now-stale error.
ROLLBACK;

--source include/galera_mdev38999_resume_applier.inc

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 3 FROM t1
--source include/wait_condition.inc

--echo #
--echo # Same scenario again, but via an implicit (autocommit=0) transaction
--echo # instead of an explicit BEGIN.
--echo #
--source include/galera_mdev38999_pause_applier.inc

--connection node_1
INSERT INTO t1 VALUES (4, 400);

--source include/galera_mdev38999_wait_applier_paused.inc

--connection node_2
SET SESSION autocommit = 0;
SELECT COUNT(*) FROM t1 WHERE id = 1;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t1 SET f1 = f1 + 1 WHERE id = 1;
ROLLBACK;
SET SESSION autocommit = 1;

--source include/galera_mdev38999_resume_applier.inc

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 4 FROM t1
--source include/wait_condition.inc

--echo #
--echo # wsrep_sync_wait=1 (READ only): two reads in a row inside one explicit
--echo # transaction must each independently wait - the second one is not
--echo # exempted just because the first already waited.
--echo #
SET SESSION wsrep_sync_wait = 1;

--connection node_2
BEGIN;
SELECT COUNT(*) FROM t1;

--source include/galera_mdev38999_pause_applier.inc

--connection node_1
INSERT INTO t1 VALUES (5, 500);

--source include/galera_mdev38999_wait_applier_paused.inc

--connection node_2
--error ER_LOCK_WAIT_TIMEOUT
SELECT COUNT(*) FROM t1;
ROLLBACK;

--source include/galera_mdev38999_resume_applier.inc

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 5 FROM t1
--source include/wait_condition.inc

--source include/galera_mdev38999_cleanup.inc
