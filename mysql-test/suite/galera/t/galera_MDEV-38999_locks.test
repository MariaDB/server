#
# MDEV-38999: a statement in a transaction that holds a row lock waits for
# the applier when its wsrep_sync_wait bit is not yet satisfied. The applier
# needs that row lock and BF-aborts the transaction, but the aborted thread
# is still inside the causal wait. The wait ends only at
# repl.causal_read_timeout, although the applier is released after one
# second. Expected: the INSERT returns soon after the applier is released.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (id INT PRIMARY KEY, f1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 100), (2, 200);

--connection node_2
--let $wsrep_provider_options_orig = `SELECT @@wsrep_provider_options`
SET SESSION wsrep_sync_wait = 6;
--let $wait_condition = SELECT COUNT(*) = 2 FROM t1
--source include/wait_condition.inc
--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2

--connection node_2
SET GLOBAL wsrep_provider_options = "repl.causal_read_timeout=PT20S";
BEGIN;
UPDATE t1 SET f1=f1+1 WHERE id=2;
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";

--connection node_1
UPDATE t1 SET f1=0 WHERE id=2;

--connection node_2a
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";

--connection node_2
--let $t0 = `SELECT UNIX_TIMESTAMP()`
--send INSERT INTO t1 VALUES (6, 600)

--connection node_2a
--sleep 1
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";

--connection node_2
--error 0,ER_LOCK_WAIT_TIMEOUT,ER_LOCK_DEADLOCK
--reap
# A genuine BF-abort/deadlock error is (correctly, unlike a causal-wait
# timeout) sticky until the transaction is explicitly ended, so node_2's
# connection won't take plain queries cleanly yet - measure elapsed time via
# node_2a instead, which was never part of the aborted transaction.
--connection node_2a
--let $dt = `SELECT UNIX_TIMESTAMP() - $t0`
--disable_query_log
--eval SELECT $dt < 10 AS returned_promptly
--enable_query_log

--connection node_2
--error 0,ER_LOCK_WAIT_TIMEOUT,ER_LOCK_DEADLOCK
COMMIT;

--connection node_2
--disable_query_log
--eval SET GLOBAL wsrep_provider_options = "$wsrep_provider_options_orig"
SET SESSION wsrep_sync_wait = 0;
--enable_query_log

--connection node_1
DROP TABLE t1;

--disconnect node_2a

