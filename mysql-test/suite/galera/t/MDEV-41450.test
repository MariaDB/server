#
# MDEV-41450: TOI DDL must not BF-abort the InnoDB purge coordinator
#
# Purge holds MDL_SHARED on every table of a batch, and opens the table
# with open_purge_table() when it has an indexed virtual column. A TOI
# that conflicts with that MDL used to signal KILL_QUERY_HARD to the purge
# THD. The flag was never reset, so every later open_purge_table() failed
# and purge retried close_and_reopen() forever while leaking memory.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (a INT PRIMARY KEY, b INT,
                 c INT AS (b + 1) VIRTUAL, KEY(c)) ENGINE=InnoDB;
INSERT INTO t1 (a, b) VALUES (1, 1), (2, 2), (3, 3);
SET GLOBAL innodb_max_purge_lag_wait= 0;

SET @old_debug_dbug= @@global.debug_dbug;
SET DEBUG_SYNC= 'RESET';
SET GLOBAL debug_dbug= '+d,btr_force_pessimistic_delete';
SET GLOBAL debug_dbug= '+d,enable_row_purge_sec_tree_sync';

# Park purge while it holds MDL on t1
DELETE FROM t1 WHERE a = 1;
SET DEBUG_SYNC= 'now WAIT_FOR purge_sec_tree_begin';
SET GLOBAL debug_dbug= @old_debug_dbug;

# The TOI applier on node_1 conflicts with the MDL held by purge
--connection node_2
ALTER TABLE t1 ADD COLUMN d INT;

--connection node_1
# Causal reads would wait for the applier, which waits for purge
SET SESSION wsrep_sync_wait= 0;
--let $wait_condition = SELECT COUNT(*) = 1 FROM INFORMATION_SCHEMA.PROCESSLIST WHERE STATE = 'Waiting for table metadata lock' AND INFO LIKE 'ALTER TABLE t1%'
--source include/wait_condition.inc

SET DEBUG_SYNC= 'now SIGNAL purge_sec_tree_execute';
SET SESSION wsrep_sync_wait= DEFAULT;

--let $wait_condition = SELECT COUNT(*) = 4 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
--source include/wait_condition.inc

# Purge must still be able to open t1. Each purge run takes the next THD
# from a pool of innodb_purge_threads_MAX (32), so cycle through the pool
# until the THD that was BF-aborted before the fix coordinates purge again.
# That run looped forever in close_and_reopen(). A timed out
# innodb_max_purge_lag_wait does not fail, so check the history length.
--disable_query_log
--let $i = 80
while ($i)
{
  UPDATE t1 SET b = b + 1;
  SET STATEMENT max_statement_time= 10 FOR
    SET GLOBAL innodb_max_purge_lag_wait= 0;
  --let $history = `SELECT COUNT FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME = 'trx_rseg_history_len'`
  if ($history)
  {
    --echo Purge is stuck, history length $history
    --let $i = 1
  }
  --dec $i
}
--enable_query_log

DELETE FROM t1 WHERE a = 2;
SET STATEMENT max_statement_time= 10 FOR
  SET GLOBAL innodb_max_purge_lag_wait= 0;

SELECT a, b, c, d FROM t1;

--connection node_2
SELECT a, b, c, d FROM t1;
DROP TABLE t1;

--connection node_1
SET DEBUG_SYNC= 'RESET';
