#
# MDEV-38999: a later read inside the same stored procedure CALL must not
# skip its own causal wait just because an earlier read in the same CALL
# already performed one.
#
# dispatch_command() wraps only the top-level CALL with the wsrep
# before/after-command cycle; sp_instr_stmt::execute() runs each statement
# of the procedure body via mysql_execute_command() directly, with no such
# cycle in between. wsrep::client_state::sync_wait_gtid_ - a cache meaning
# "already waited for this top-level command" - is therefore only reset once
# the whole CALL finishes, not between the procedure's own statements. A
# later statement inside the same CALL would see that stale cache and skip
# its wait, independently of wsrep_has_changes(thd)/wsrep_trx_locking_read_done -
# the same symptom this MDEV fixes, reached via a different gate.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (id INT PRIMARY KEY, f1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 100);

--connection node_2
SET SESSION wsrep_sync_wait = 1;
--let $wait_condition = SELECT COUNT(*) = 1 FROM t1
--source include/wait_condition.inc

--source include/galera_mdev38999_init.inc

--connection node_2
DELIMITER |;
CREATE PROCEDURE p()
BEGIN
  SELECT COUNT(*) FROM t1;
  SET DEBUG_SYNC = 'now SIGNAL mdev38999_sp_ready WAIT_FOR mdev38999_sp_continue';
  SELECT COUNT(*) FROM t1;
END|
DELIMITER ;|

--connection node_2
--send CALL p()

# node_2's connection is busy inside the CALL above - drive the applier
# pause/release from node_2a instead of the shared include, which assumes
# node_2 is free to issue statements.
--connection node_2a
SET DEBUG_SYNC = "now WAIT_FOR mdev38999_sp_ready";
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";

--connection node_1
INSERT INTO t1 VALUES (2, 200);

--connection node_2a
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
SET DEBUG_SYNC = "now SIGNAL mdev38999_sp_continue";

--connection node_2
# The procedure's second SELECT must perform its own fresh wait and time
# out here - before the fix, the stale sync_wait_gtid_ cache from the first
# SELECT let it through silently instead.
--error ER_LOCK_WAIT_TIMEOUT
--reap

--connection node_2a
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM t1
--source include/wait_condition.inc

DROP PROCEDURE p;

--source include/galera_mdev38999_cleanup.inc
