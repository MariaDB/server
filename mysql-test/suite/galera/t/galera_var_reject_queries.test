#
# Test wsrep_reject_queries
#

--source include/galera_cluster.inc
--source include/have_innodb.inc

CREATE TABLE t1 (f1 INTEGER NOT NULL PRIMARY KEY) engine=innodb;

--connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1

--connection node_1
--error ER_GLOBAL_VARIABLE
SET SESSION wsrep_reject_queries = ALL;

SET GLOBAL wsrep_reject_queries = ALL;

--error ER_UNKNOWN_COM_ERROR,1047
SELECT * FROM t1;

#
# Original behavior was lost connection,
# but since 10.1, we allow controlling connection to remain alive
#
--error 0,2013,2026
SET GLOBAL wsrep_reject_queries = ALL_KILL;

--connection node_1a
#
# wsrep_close_client_connections() only signals the kill asynchronously
# (MDEV-40348): it does not wait for node_1a's thread to notice and
# close the connection before SET GLOBAL above returns. A single query
# here races that signal and can observe the connection still alive,
# getting the same ER_UNKNOWN_COM_ERROR 1047 that plain ALL already
# returns above, instead of a connection error. Poll until the
# connection is actually gone.
#
--disable_query_log
--disable_result_log
--let $wait_counter = 600
--let $killed = 0
while (!$killed)
{
  --error 0,ER_CONNECTION_KILLED,2013,2006,2026,ER_UNKNOWN_COM_ERROR
  SELECT * FROM t1;
  if ($mysql_errno != 0 && $mysql_errno != 1047)
  {
    --let $killed = 1
  }
  if (!$killed)
  {
    --dec $wait_counter
    if (!$wait_counter)
    {
      --die wsrep_reject_queries=ALL_KILL did not kill the node_1a connection in time
    }
    --real_sleep 0.1
  }
}
--enable_result_log
--enable_query_log

--connect node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1
--error ER_UNKNOWN_COM_ERROR,1047
SELECT * FROM t1;

# Confirm that replication continues

--connection node_2
SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size';
INSERT INTO t1 VALUES (1);

--connect node_1c, 127.0.0.1, root, , test, $NODE_MYPORT_1
SET GLOBAL wsrep_reject_queries = NONE;

SELECT COUNT(*) AS EXPECT_1 FROM t1;

DROP TABLE t1;
