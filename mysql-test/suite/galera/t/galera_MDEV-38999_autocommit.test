#
# MDEV-38999: the set of satisfied wsrep_sync_wait bits must not survive
# COMMIT. With autocommit=0, the first UPDATE after COMMIT starts a new
# transaction and must wait for the applier again.
#
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/galera_have_debug_sync.inc

--connection node_1
CREATE TABLE t1 (id INT PRIMARY KEY, f1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 100), (2, 200);

--connection node_2
--let $wsrep_provider_options_orig = `SELECT @@wsrep_provider_options`
SET SESSION wsrep_sync_wait = 6;
--let $wait_condition = SELECT COUNT(*) = 2 FROM t1
--source include/wait_condition.inc
--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2

--connection node_2
SET GLOBAL wsrep_provider_options = "repl.causal_read_timeout=PT1S";
SET autocommit=0;
UPDATE t1 SET f1=f1+1 WHERE id=1;
COMMIT;
SET GLOBAL debug_dbug = "d,sync.wsrep_apply_cb";

--connection node_1
INSERT INTO t1 VALUES (3, 300);

--connection node_2a
SET DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";

--connection node_2
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t1 SET f1=f1+1 WHERE id=1;
--error 0,ER_LOCK_WAIT_TIMEOUT
ROLLBACK;

--connection node_2a
SET GLOBAL debug_dbug = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SET DEBUG_SYNC = "RESET";

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 3 FROM t1
--source include/wait_condition.inc

--connection node_2
--disable_query_log
--eval SET GLOBAL wsrep_provider_options = "$wsrep_provider_options_orig"
SET SESSION wsrep_sync_wait = 0;
--enable_query_log

--connection node_1
DROP TABLE t1;

--disconnect node_2a

