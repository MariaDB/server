# A testcase showing why the "padding" should be mbmaxlen()
# instead of 1 for blob capacity limit.
create table t1 (a varchar(300) charset utf8mb4,
vt tinytext charset utf8mb4 as (concat('x',a)), index(vt(30)));
set sql_mode='';
insert into t1 (a) values (repeat(_utf8mb4 0xE282AC, 85)), (repeat(_utf8mb4 0xE282AC, 85));
Warnings:
Warning	1366	Incorrect string value: '\xE2\x82\xAC' for column `test`.`t1`.`vt` at row 1
Warning	1366	Incorrect string value: '\xE2\x82\xAC' for column `test`.`t1`.`vt` at row 2
set sql_mode=default;
select octet_length(a) a_len,
octet_length(concat('x',a)) expr_len,
octet_length(vt) vt_len from t1;
a_len	expr_len	vt_len
255	256	253
255	256	253
explain
select octet_length(a) from t1
where concat('x',a) = concat('x',repeat(_utf8mb4 0xE282AC, 84));
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	2	Using where
Warnings:
Note	1105	Cannot substitute virtual column expression concat('x',`t1`.`a`) -> vt due to unsafe const comparison
# Would return rows (wrong) if "padding" was 1. Should be empty
select octet_length(a) from t1
where concat('x',a) = concat('x',repeat(_utf8mb4 0xE282AC, 84));
octet_length(a)
DROP TABLE t1;
# A VARCHAR vcol field declares its capacity in characters, so a
# multi-byte constant is measured in characters, not in octets
create table t1 (
a varchar(20) charset utf8mb4,
vc varchar(5) charset utf8mb4 as (concat('x',a)),
index(vc)
);
set sql_mode='';
# The last row has a 6 character expression, truncated to 5 in vc:
insert into t1 (a) values ('äöü'),('äöüß'),('äöüßé');
Warnings:
Warning	1265	Data truncated for column 'vc' at row 3
set sql_mode=@save_sql_mode;
select a, char_length(concat('x',a)) as expr_chars,
vc, char_length(vc) as vc_chars, octet_length(vc) as vc_octets
from t1 order by a;
a	expr_chars	vc	vc_chars	vc_octets
äöü	4	xäöü	4	7
äöüß	5	xäöüß	5	9
äöüßé	6	xäöüß	5	9
# 4 characters (7 octets), strictly inside the 5 character domain:
explain
select a from t1 where concat('x',a)='xäöü';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ref	vc	vc	23	const	1	Using index condition
select a from t1 where concat('x',a)='xäöü';
a
äöü
# 5 characters, on the boundary of the domain: no substitution,
# even though 9 octets fit into the 20 octets of the field.
explain
select a from t1 where concat('x',a)='xäöüß';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	3	Using where
Warnings:
Note	1105	Cannot substitute virtual column expression concat('x',`t1`.`a`) -> vc due to unsafe const comparison
select a from t1 where concat('x',a)='xäöüß';
a
äöüß
drop table t1;
# DECIMAL has no domain check of its own yet, so the constant
# cannot help and there is no substitution. Note that a+0.4 is
# rounded when stored into va, so substituting va=5 would match
# the row with a=4.7, where a+0.4 is 5.1.
create table t1 (a decimal(10,2), va decimal(10,0) as (a+0.4), index(va));
insert into t1 (a) values (4.6),(4.7);
