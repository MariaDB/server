drop table t1;
# The constant is strictly inside the domain of the vcol field,
# but the expression is compared with it in another domain: a
# string expression against an integer constant is compared as a
# number. Substituting would compare the number with the
# truncated value of the expression instead, so the row below,
# where the expression is 12345 and vc is '012', would match.
create table t1 (a varchar(10), vc varchar(3) as (a), index(vc));
set sql_mode='';
insert into t1 (a) values ('012345');
Warnings:
Warning	1265	Data truncated for column 'vc' at row 1
set sql_mode=@save_sql_mode;
select a, vc, a=12 as expr_eq, vc=12 as field_eq from t1;
a	vc	expr_eq	field_eq
012345	012	0	1
# '12' is 2 characters, which is strictly inside varchar(3),
# so only the comparison domain prevents the substitution here.
# Must return the empty set:
explain
select * from t1 where a=12;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Impossible WHERE noticed after reading const tables
Warnings:
Note	1105	Cannot substitute virtual column expression `t1`.`a` -> vc due to unsafe const comparison
select * from t1 where a=12;
a	vc
drop table t1;
# Cannot substitute here because decimal 5.1 would be converted
# to 5 before comparing with va
create table t1 (a decimal(10,2), va int as (a+0.4), index(va));
set sql_mode='';
# va is 5 for both rows
insert into t1 (a) values (4.6),(4.7);
set sql_mode=default;
# must return only the 4.60 row
select * from t1 where a+0.4 = 5.0;
a	va
4.60	5
DROP TABLE t1;
# The same comparison is substituted when the vcol field is a
# supertype to the expression: the vcol field stores every
# value of the vcol expression, so the comparison domain of the
# constant does not matter.
create table t1 (a varchar(3), vc varchar(10) as (a), index(vc));
insert into t1 (a) values ('012'),('345');
explain
select * from t1 where a=12;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	vc	NULL	NULL	NULL	2	Using where
Warnings:
Note	1105	Cannot use key `vc` part[0] for lookup: `test`.`t1`.`vc` of type `varchar` = "12" of type `int`
select * from t1 where a=12;
a	vc
012	012
drop table t1;
