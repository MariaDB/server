# A CHAR vcol field pads the value with spaces on store. Under a
# NO PAD collation this changes comparison results, so a CHAR field
# which is not a supertype to the expression is not substituted
# even for a short constant:
create table t1 (
a varchar(20) collate utf8mb4_nopad_bin,
vc char(5) collate utf8mb4_nopad_bin as (concat('x',a)),
index(vc)
);
# concat('x',a) is 'xab ', which CHAR(5) stores and returns as 'xab'
insert into t1 (a) values ('ab ');
select a, concat('x',a) as expr, vc,
concat('x',a)='xab' as expr_eq, vc='xab' as field_eq from t1;
a	expr	vc	expr_eq	field_eq
ab 	xab 	xab	0	1
# Must return the empty set: under NO PAD 'xab ' <> 'xab'
explain select * from t1 where concat('x',a)='xab';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Impossible WHERE noticed after reading const tables
Warnings:
Note	1105	Cannot substitute virtual column expression concat('x',`t1`.`a`) -> vc due to unsafe const comparison
select * from t1 where concat('x',a)='xab';
a	vc
drop table t1;
# When the vcol field is a supertype to the expression, the
# substitution is allowed for any constant and any comparison:
create table t1 (a varchar(20), vc varchar(30) as (concat('x',a)), index(vc));
insert into t1 (a) values ('abc'),('abcd'),('abcde');
explain
select * from t1 where concat('x',a)='xabcde';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ref	vc	vc	123	const	1	Using index condition
explain
select * from t1 where concat('x',a)<'xabcde';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	vc	vc	123	NULL	2	Using index condition
explain
select * from t1 where concat('x',a)>='xabc';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	vc	vc	123	NULL	3	Using index condition
drop table t1;
