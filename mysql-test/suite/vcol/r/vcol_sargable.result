drop table t1;
# When the vcol field can hold every value of the expression, the
# substitution is allowed for any constant and any comparison:
create table t1 (a int, va bigint as (a+1), index(va));
insert into t1 (a) select seq from seq_1_to_20;
explain
select * from t1 where a+1=11;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ref	va	va	9	const	1	
explain
select * from t1 where a+1=9223372036854775807;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ref	va	va	9	const	1	
explain
select * from t1 where a+1<11;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	va	va	9	NULL	9	Using index condition
explain
select * from t1 where a+1>=11;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	va	NULL	NULL	NULL	20	Using where
drop table t1;
# Strings: the expression is longer than the vcol field, so storing
# it into the field can truncate the value. Substitution is only
# allowed for the constants that are strictly shorter than the
# capacity of the field.
create table t1 (a varchar(20), vc varchar(5) as (concat('x',a)), index(vc));
set sql_mode='';
# The last row has concat('x',a)='xabcde', truncated to 'xabcd' in vc:
insert into t1 (a) values ('abc'),('abcd'),('abcde');
Warnings:
Warning	1265	Data truncated for column 'vc' at row 3
set sql_mode=@save_sql_mode;
