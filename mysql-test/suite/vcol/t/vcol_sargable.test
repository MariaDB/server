--source include/have_sequence.inc
--source include/not_embedded.inc

--echo # Check various condition types
create table t1 (a int, vcol1 int as (a+1), index(vcol1));
insert into t1 (a) select seq from seq_1_to_100;
explain select * from t1 where a+1=2;
--echo # Try renaming the table
explain select * from t1 as TBL where TBL.a+1=2;
explain select * from t1 where a+1<=2;
explain select * from t1 where a+1<2;
explain select * from t1 where a+1>100;
explain select * from t1 where a+1>=100;
explain select * from t1 where a+1 between 10 and 12;
explain select * from t1 where (a+1) IS NULL;
explain select * from t1 force index(vcol1) where (a+1) IS NOT NULL;
explain select * from t1 where (a+1) in (1,2,3,4);

--echo # Check UPDATE/DELETE:
explain delete from t1 where a+1=2;
explain update t1 set a=a+1 where a+1=2;

--echo # Try merged VIEWs:
create view v1 as select * from t1;
explain select * from v1 where a+1=2;
create view v2 as select a as A_COL from t1;
explain select * from v2 where A_COL+1=2;
drop view v1;
drop view v2;

set names utf8mb4;
select @@collation_connection;
--echo # Check VARCHAR
create table t2 (
  a varchar(32),
  vcol1 varchar(32) as (concat('hello-',a)),
  index(vcol1)
);
insert into t2 (a) select seq from seq_1_to_100;
select collation('aaa'), collation(vcol1) from t2 limit 1;
# Also check optimizer trace coverage
set @tmp_trace=@@optimizer_trace;
set optimizer_trace=1;
--echo # This won't work:
explain select * from t2 where concat('bye-', a)='hello-5';
--echo # This will work:
explain select * from t2 where concat('hello-', a)='hello-5';
--disable_view_protocol
select
  json_detailed(json_extract(trace, '$**.virtual_column_substitution'))
from
  information_schema.optimizer_trace;
--enable_view_protocol

--echo # Try also ON expressions
explain
select *
from t1 left join t2 on concat('hello-', t2.a)='hello-5'
where
  t1.a+1=2;
--disable_view_protocol
select
  json_detailed(json_extract(trace, '$**.virtual_column_substitution'))
from
  information_schema.optimizer_trace;
--enable_view_protocol

create table t3 (a int);
insert into t3 values (1),(2);
explain
select *
from
  t3 left join
    (t1 join t2 on concat('hello-', t2.a)='hello-5' and t1.a+1=2)
  on t3.a<3;
--disable_view_protocol
select
  json_detailed(json_extract(trace, '$**.virtual_column_substitution'))
from
  information_schema.optimizer_trace;
--enable_view_protocol

drop table t1,t2,t3;


set optimizer_trace=@tmp_trace;

--echo #
--echo # Implicit type/charset conversions
--echo #
create table t3 (
  a varchar(32) collate utf8mb4_general_ci,
  vcol1 int as (concat('100',a)),
  vcol2 varchar(32) collate utf8mb4_unicode_ci as (concat('hello-',a)),
  index(vcol1),
  index(vcol2)
);
insert into t3 (a) select seq from seq_1_to_100;

--echo # Type conversion
explain select * from t3 where concat('100', a)=10010;

--echo # Character set change
explain select * from t3 where concat('hello-', a)='abcd';
drop table t3;

--echo # Try JSON_EXTRACT
create table t1 (a int, js1 blob);
insert into t1
select seq, concat('{"size":', seq, ', "color":"hue', seq ,'"}') from seq_1_to_100;
select * from t1 limit 3;

alter table t1 add size1 int as (cast(json_extract(js1, '$.size') as int));
alter table t1 add index(size1);
explain select * from t1 where cast(json_extract(js1,'$.size') as int)=5 ;

#
# JSON_UNQUOTE() returns utf8mb4_bin
#
# Without COLLATE clause, the default is utf8mb4_uca1400_ai_ci.
#
alter table t1 add
  color varchar(100) COLLATE utf8mb4_bin
    as (json_unquote(json_extract(js1, '$.color')));
alter table t1 add index(color);

select * from t1 limit 3;

--echo # Index is used:
explain select * from t1 where json_unquote(json_extract(js1, '$.color'))='hue5';
explain select * from t1 where json_unquote(json_extract(js1, '$.color')) IS NULL;
explain select * from t1 force index(color)
where json_unquote(json_extract(js1, '$.color')) IS NOT NULL;

--echo # TODO: wrong results due to space padding
set @save_sql_mode=@@sql_mode;
set sql_mode='';
insert into t1 (a, js1) values
(101, concat('{"size": 101, "color": "hue101', repeat(' ', 94), 'X"}'));
# (101, '{"size": 101, "color": "hue101"}');
explain select * from t1 where json_unquote(json_extract(js1, '$.color'))='hue101';
select * from t1 where json_unquote(json_extract(js1, '$.color'))='hue101';
delete from t1 where a = 101;
set sql_mode=@save_sql_mode;

alter table t1 drop column color;
alter table t1 add
  color2 varchar(100)
    as (json_unquote(json_extract(js1, '$.color')));
alter table t1 add index(color2);
--echo # Index is not used due to collation mismatch:
explain select * from t1 where json_unquote(json_extract(js1, '$.color'))='hue5';

drop table t1;

--echo #
--echo # Tests with JSON_VALUE
--echo #
create table t1 (a int, js1 json);
insert into t1
select seq, concat('{"size":', seq, ', "color":"hue', seq ,'"}') from seq_1_to_100;
select * from t1 limit 3;

alter table t1
  add size1 int as (cast(json_value(js1, '$.size') as int)),
  add index(size1);

explain
select * from t1 where size1=10;

--echo # The "JSON" datatype uses binary collation.
--echo #  JSON_VALUE will produce output in binary collation, too:
select collation(json_value(js1, '$.color')) from t1 limit 1;

--echo # If one is fine with _bin comparisons, they can use index access:
alter table t1
  add color1 varchar(100) collate utf8mb4_bin as (json_value(js1, '$.color')),
  add index(color1);
explain select * from t1 where json_value(js1, '$.color')='hue10';
alter table t1 drop column color1;

--echo # Using different collation in column substitution prevents
--echo # the optimization from working:
alter table t1
  add color2 varchar(100) collate utf8mb4_unicode_ci as (json_value(js1, '$.color')),
  add index(color2);
explain select * from t1 where json_value(js1, '$.color')='hue10';
alter table t1 drop column color2;


--echo # Explicitly specifying the collation helps:
alter table t1
  add color3 varchar(100) collate utf8mb4_unicode_ci as
  (json_value(js1, '$.color') collate utf8mb4_unicode_ci),
  add index(color3);
explain select * from t1
where
  json_value(js1, '$.color') collate utf8mb4_unicode_ci='hue10';

--echo #
--echo # Alternatively, one can store JSON in a column with the same
--echo # collation as default and then casts are not needed:
--echo #
create table t2(
  js1 longtext COLLATE utf8mb4_uca1400_ai_ci DEFAULT NULL CHECK (json_valid(`js1`))
);
insert into t2 select js1 from t1;

alter table t2
  add color3 varchar(100) as (json_value(js1, '$.color')),
  add index(color3);
explain select * from t2
where
  json_value(js1, '$.color')='hue10';

drop table t1,t2;

--echo #
--echo # Test interplay with sargable_casefold optimization:
--echo #
create table t1 (
  a varchar(100) collate utf8mb3_general_ci,
  vcol varchar(100) collate utf8mb3_general_ci as (UPPER(a)),
  index(a),
  index(vcol)
);
insert into t1 (a) select seq from seq_1_to_100;
--echo # Note that possible_keys doesn't include 'vcol'.
--echo #  Sargable_casefold is applied before vcol substitution:
explain select * from t1 where UPPER(a)='abc';
explain select * from t1 ignore index(vcol) where UPPER(a)='abc';
explain select * from t1 ignore index(a) where UPPER(a)='abc';
set optimizer_switch='sargable_casefold=off';
explain select * from t1 ignore index(a) where UPPER(a)='abc';
set optimizer_switch=default;
drop table t1;

--echo #
--echo # Test interplay with Sargable YEAR/DATE optimization:
--echo #
create table t1 (
  a date,
  vcol int as (year(a)),
  index(a),
  index(vcol)
);
insert into t1 (a) select date_add('2024-01-01', interval (seq*365) day) from seq_1_to_100;
--echo # Note that possible_keys doesn't include 'vcol'.
--echo #  Sargable Year is applied before vcol substitution:
explain format=json select * from t1 where year(a)=2025;

--echo # Check that vcol would work if Sargable Year didn't disable it:
alter table t1
  add vcol2 int as (year(a)+1),
  add index(vcol2);

explain format=json select * from t1 where year(a)+1=2025;

drop table t1;

--echo #
--echo # MDEV-35833: Assertion `marked_for_read()' failed for query with vcols
--echo #
CREATE TABLE t1 (
  id int,
  v2 int AS (id),
  v3 int AS (id+0),
  a1 int AS (v2 + v3),
  KEY a1 (a1)
);
insert t1(id) values (1),(2);

explain format=json DELETE FROM t1 WHERE v2+v3 > 'a';

drop table t1;

--echo #
--echo # MDEV-39525 WHERE virtual column index substitution causes wrong results when truncation happens
--echo #

--echo # a+1 is computed in a wider integer type than the TINYINT vcol
--echo # field, so storing the expression into the field can clamp the
--echo # value. Substitution is only allowed for the constants that are
--echo # strictly inside the TINYINT range.
create table t1 (a tinyint, va tinyint as (a+1), index(va));
set @save_sql_mode=@@sql_mode;
set sql_mode='';
--echo # The last row has a+1=128, which is clamped to 127 in va:
insert into t1 (a) values (10),(20),(126),(127);
set sql_mode=@save_sql_mode;
select a, va from t1 order by a;

--echo # An interior constant: the index is used
explain
select * from t1 where a+1=21;
select * from t1 where a+1=21;
explain
select * from t1 where a+1<21;
select * from t1 where a+1<21;
explain
select * from t1 where a+1<=21;
select * from t1 where a+1<=21;
explain
select * from t1 where a+1>21;
select * from t1 where a+1>21;
explain
select * from t1 where a+1>=21;
select * from t1 where a+1>=21;

--echo # A constant on the boundary of the domain: no substitution.
--echo # va=127 would also match the row with a=127, where a+1 is 128.
explain
select * from t1 where a+1=127;
select * from t1 where a+1=127;
explain
select * from t1 where a+1>127;
select * from t1 where a+1>127;
explain
select * from t1 where a+1>=127;
select * from t1 where a+1>=127 order by a;
explain
select * from t1 where a+1<127;
select * from t1 where a+1<127 order by a;
explain
select * from t1 where a+1<=127;
select * from t1 where a+1<=127 order by a;

drop table t1;

--echo # When the vcol field can hold every value of the expression, the
--echo # substitution is allowed for any constant and any comparison:
create table t1 (a int, va bigint as (a+1), index(va));
insert into t1 (a) select seq from seq_1_to_20;
explain
select * from t1 where a+1=11;
explain
select * from t1 where a+1=9223372036854775807;
explain
select * from t1 where a+1<11;
explain
select * from t1 where a+1>=11;
drop table t1;

--echo # Strings: the expression is longer than the vcol field, so storing
--echo # it into the field can truncate the value. Substitution is only
--echo # allowed for the constants that are strictly shorter than the
--echo # capacity of the field.
create table t1 (a varchar(20), vc varchar(5) as (concat('x',a)), index(vc));
set sql_mode='';
--echo # The last row has concat('x',a)='xabcde', truncated to 'xabcd' in vc:
insert into t1 (a) values ('abc'),('abcd'),('abcde');
set sql_mode=@save_sql_mode;
select a, vc from t1 order by a;

--echo # A constant shorter than the capacity of varchar(5): the index is used
explain
select * from t1 where concat('x',a)='xabc';
select * from t1 where concat('x',a)='xabc';

--echo # A constant of exactly varchar(5): no substitution.
--echo # vc='xabcd' would also match the row with a='abcde'.
explain
select * from t1 where concat('x',a)='xabcd';
select * from t1 where concat('x',a)='xabcd';
explain
select * from t1 where concat('x',a)<'xabcd';
select * from t1 where concat('x',a)<'xabcd' order by a;
explain
select * from t1 where concat('x',a)<='xabcd';
select * from t1 where concat('x',a)<='xabcd' order by a;
explain
select * from t1 where concat('x',a)>'xabc';
select * from t1 where concat('x',a)>'xabc' order by a;
explain
select * from t1 where concat('x',a)>='xabc';
select * from t1 where concat('x',a)>='xabc' order by a;
drop table t1;

--echo # A CHAR vcol field pads the value with spaces on store. Under a
--echo # NO PAD collation this changes comparison results, so a CHAR field
--echo # which is not a supertype to the expression is not substituted
--echo # even for a short constant:
create table t1 (
  a varchar(20) collate utf8mb4_nopad_bin,
  vc char(5) collate utf8mb4_nopad_bin as (concat('x',a)),
  index(vc)
);
--echo # concat('x',a) is 'xab ', which CHAR(5) stores and returns as 'xab'
insert into t1 (a) values ('ab ');
select a, concat('x',a) as expr, vc,
       concat('x',a)='xab' as expr_eq, vc='xab' as field_eq from t1;

--echo # Must return the empty set: under NO PAD 'xab ' <> 'xab'
explain select * from t1 where concat('x',a)='xab';
select * from t1 where concat('x',a)='xab';
drop table t1;

--echo # When the vcol field is a supertype to the expression, the
--echo # substitution is allowed for any constant and any comparison:
create table t1 (a varchar(20), vc varchar(30) as (concat('x',a)), index(vc));
insert into t1 (a) values ('abc'),('abcd'),('abcde');
explain
select * from t1 where concat('x',a)='xabcde';
explain
select * from t1 where concat('x',a)<'xabcde';
explain
select * from t1 where concat('x',a)>='xabc';
drop table t1;

--echo # more coverage for the strict domain check

create table t1 (a tinyint, va tinyint as (a+1), index(va));
set @save_sql_mode=@@sql_mode;
set sql_mode='';
--echo # The last row has a+1=128, which is clamped to 127 in va:
insert into t1 (a) values (10),(20),(126),(127);
set sql_mode=@save_sql_mode;

--echo # The constant on the left hand side of the comparison:
explain
select * from t1 where 21=a+1;
select * from t1 where 21=a+1;
explain
select * from t1 where 127<a+1;
select * from t1 where 127<a+1;

--echo # BETWEEN: every bound must be strictly inside the domain
explain
select * from t1 where a+1 between 11 and 21;
select * from t1 where a+1 between 11 and 21 order by a;
--echo # The upper bound is on the boundary: no substitution.
--echo # va between 21 and 127 would also match the row with a=127.
explain
select * from t1 where a+1 between 21 and 127;
select * from t1 where a+1 between 21 and 127 order by a;

--echo # IN: every value in the list must be strictly inside the domain
explain
select * from t1 where a+1 in (11,21);
select * from t1 where a+1 in (11,21) order by a;
--echo # The last value is on the boundary: no substitution.
--echo # va in (21,127) would also match the row with a=127.
explain
select * from t1 where a+1 in (21,127);
select * from t1 where a+1 in (21,127) order by a;

--echo # IS NULL / IS NOT NULL compare no values, so they are substituted
--echo # even though the field is not a supertype to the expression:
insert into t1 (a) values (NULL);
explain
select * from t1 where a+1 is null;
select * from t1 where a+1 is null;
explain
select * from t1 force index(va) where a+1 is not null;

--echo # <=> behaves similarly to = / IS NULL:
explain
select * from t1 where a+1<=>21;
select * from t1 where a+1<=>21;
explain
select * from t1 where a+1<=>127;
select * from t1 where a+1<=>127;
explain
select * from t1 where a+1<=>NULL;
select * from t1 where a+1<=>NULL;

drop table t1;

--echo # An UNSIGNED field: both ends of the domain are checked
create table t1 (a tinyint unsigned, va tinyint unsigned as (a+1), index(va));
set sql_mode='';
--echo # The last row has a+1=256, which is clamped to 255 in va:
insert into t1 (a) values (10),(254),(255);
set sql_mode=@save_sql_mode;
select a, va from t1 order by a;

--echo # An interior constant: the index is used
explain
select * from t1 where a+1=11;
select * from t1 where a+1=11;
--echo # 255 is the upper boundary of the domain: no substitution
explain
select * from t1 where a+1=255;
select * from t1 where a+1=255;
--echo # 0 is the lower boundary of the domain, and -1 is outside it:
explain
select * from t1 where a+1=0;
explain
select * from t1 where a+1>-1;
drop table t1;

--echo # A TEXT vcol field declares its capacity in octets
create table t1 (
  a varchar(300),
  vt tinytext as (concat('x',a)),
  index(vt(30))
);
set sql_mode='';
--echo # The last row has a 256 octet expression, truncated to 255 in vt:
insert into t1 (a) values (repeat('y',250)),(repeat('y',251)),(repeat('y',255));
set sql_mode=@save_sql_mode;
select length(a), length(concat('x',a)) as expr_len, length(vt) as vt_len
from t1 order by length(a);

--echo # A constant of 251 octets, strictly inside the domain:
explain
select length(a) from t1 where concat('x',a)=concat('x',repeat('y',250));
select length(a) from t1 where concat('x',a)=concat('x',repeat('y',250));
--echo # A constant of exactly (256 - 4) octets: no substitution.
explain
select length(a) from t1 where concat('x',a)=concat('x',repeat('y',251));
select length(a) from t1 where concat('x',a)=concat('x',repeat('y',251));
drop table t1;

--echo # A testcase showing why the "padding" should be mbmaxlen()
--echo # instead of 1 for blob capacity limit.
create table t1 (a varchar(300) charset utf8mb4,
                 vt tinytext charset utf8mb4 as (concat('x',a)), index(vt(30)));
set sql_mode='';
insert into t1 (a) values (repeat(_utf8mb4 0xE282AC, 85)), (repeat(_utf8mb4 0xE282AC, 85));
set sql_mode=default;

select octet_length(a) a_len,
       octet_length(concat('x',a)) expr_len,
       octet_length(vt) vt_len from t1;

explain
select octet_length(a) from t1
where concat('x',a) = concat('x',repeat(_utf8mb4 0xE282AC, 84));
--echo # Would return rows (wrong) if "padding" was 1. Should be empty
select octet_length(a) from t1
where concat('x',a) = concat('x',repeat(_utf8mb4 0xE282AC, 84));

DROP TABLE t1;

--echo # A VARCHAR vcol field declares its capacity in characters, so a
--echo # multi-byte constant is measured in characters, not in octets
create table t1 (
  a varchar(20) charset utf8mb4,
  vc varchar(5) charset utf8mb4 as (concat('x',a)),
  index(vc)
);
set sql_mode='';
--echo # The last row has a 6 character expression, truncated to 5 in vc:
insert into t1 (a) values ('äöü'),('äöüß'),('äöüßé');
set sql_mode=@save_sql_mode;
select a, char_length(concat('x',a)) as expr_chars,
       vc, char_length(vc) as vc_chars, octet_length(vc) as vc_octets
from t1 order by a;

--echo # 4 characters (7 octets), strictly inside the 5 character domain:
explain
select a from t1 where concat('x',a)='xäöü';
select a from t1 where concat('x',a)='xäöü';
--echo # 5 characters, on the boundary of the domain: no substitution,
--echo # even though 9 octets fit into the 20 octets of the field.
explain
select a from t1 where concat('x',a)='xäöüß';
select a from t1 where concat('x',a)='xäöüß';
drop table t1;

--echo # DECIMAL has no domain check of its own yet, so the constant
--echo # cannot help and there is no substitution. Note that a+0.4 is
--echo # rounded when stored into va, so substituting va=5 would match
--echo # the row with a=4.7, where a+0.4 is 5.1.
create table t1 (a decimal(10,2), va decimal(10,0) as (a+0.4), index(va));
insert into t1 (a) values (4.6),(4.7);
select a, va from t1 order by a;
explain
select * from t1 where a+0.4=5;
select * from t1 where a+0.4=5;
drop table t1;

--echo # The constant is strictly inside the domain of the vcol field,
--echo # but the expression is compared with it in another domain: a
--echo # string expression against an integer constant is compared as a
--echo # number. Substituting would compare the number with the
--echo # truncated value of the expression instead, so the row below,
--echo # where the expression is 12345 and vc is '012', would match.
create table t1 (a varchar(10), vc varchar(3) as (a), index(vc));
set sql_mode='';
insert into t1 (a) values ('012345');
set sql_mode=@save_sql_mode;
select a, vc, a=12 as expr_eq, vc=12 as field_eq from t1;
--echo # '12' is 2 characters, which is strictly inside varchar(3),
--echo # so only the comparison domain prevents the substitution here.
--echo # Must return the empty set:
explain
select * from t1 where a=12;
select * from t1 where a=12;
drop table t1;

--echo # Cannot substitute here because decimal 5.1 would be converted
--echo # to 5 before comparing with va
create table t1 (a decimal(10,2), va int as (a+0.4), index(va));
set sql_mode='';
--echo # va is 5 for both rows
insert into t1 (a) values (4.6),(4.7);
set sql_mode=default;
--echo # must return only the 4.60 row
select * from t1 where a+0.4 = 5.0;
DROP TABLE t1;

--echo # The same comparison is substituted when the vcol field is a
--echo # supertype to the expression: the vcol field stores every
--echo # value of the vcol expression, so the comparison domain of the
--echo # constant does not matter.
create table t1 (a varchar(3), vc varchar(10) as (a), index(vc));
insert into t1 (a) values ('012'),('345');
explain
select * from t1 where a=12;
select * from t1 where a=12;
drop table t1;
