#
# MDEV-41340: Statements referring to a view must not be pushed down
#
# A view exists only on the local server, but a pushed down statement
# is printed with the view's name, so the remote server could not
# resolve it. Every such statement is executed locally instead.
#
connection master;
set global federated_pushdown=1;
CALL fill_tables();
#
# With LIMIT the view is always materialized. The plan shows only the
# view's body as pushed down (PUSHED DERIVED), not the UPDATE join.
#
CREATE VIEW v1 AS SELECT * FROM t1 LIMIT 2;
# plan must not contain PUSHED UPDATE
EXPLAIN
UPDATE t1 JOIN v1 SET t1.a= 1 WHERE v1.a < 3;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	<derived2>	ALL	NULL	NULL	NULL	NULL	2	Using where
1	PRIMARY	t1	ALL	NULL	NULL	NULL	NULL	4	
2	PUSHED DERIVED	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
UPDATE t1 JOIN v1 SET t1.a= 1 WHERE v1.a < 3;
affected rows: 6
info: Rows matched: 8  Changed: 6  Warnings: 0
SELECT * FROM t1 ORDER BY a;
a	b
1	one
1	two
1	three
1	four
DROP VIEW v1;
connection slave;
TRUNCATE TABLE mysql.general_log;
connection master;
