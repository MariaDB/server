#
# A metadata-invalidation reparse of the routine's own instruction,
# when the first post-reparse execution of that instruction happens
# to be pushed down, must not hit the mem_root assertion
#
CALL fill_tables();
CREATE PROCEDURE p_reparse()
BEGIN
UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1;
END|
SET global federated_pushdown=1;
CALL p_reparse();
# Force a metadata-invalidation reparse of p_reparse()'s instruction
# on its next CALL. FederatedX doesn't support ALTER TABLE, so drop
# and recreate t2 identically -- that still bumps its table version.
DROP TABLE t2;
CREATE TABLE t2 (a int, c varchar(16))
ENGINE="FEDERATED" DEFAULT CHARSET=latin1
CONNECTION='mysql://root@127.0.0.1:SLAVE_PORT/federated/t2';
CALL fill_tables();
# The first post-reparse execution runs with pushdown on
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_reparse();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %';
argument
update (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) set `federated`.`x`.`b` = `federated`.`y`.`c` where `federated`.`y`.`a` = 1
connection master;
SET global federated_pushdown=0;
# Reset the data so this non-pushed-down CALL actually changes a row
CALL fill_tables();
# A later, non-pushed-down execution must work too
CALL p_reparse();
SELECT a, b FROM t1 ORDER BY a;
a	b
1	I
2	two
3	three
4	four
DROP PROCEDURE p_reparse;
DROP PROCEDURE p_upd_del;
DROP PROCEDURE p_outer;
DROP PROCEDURE p_execute;
DROP PROCEDURE fill_tables;
DROP TABLE federated.t1, federated.t2, federated.t3;
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log= @old_general_log;
SET global log_output= @old_log_output;
DROP TABLE federated.t1, federated.t2, federated.t3;
connection default;
connection master;
DROP TABLE IF EXISTS federated.t1;
DROP DATABASE IF EXISTS federated;
connection slave;
DROP TABLE IF EXISTS federated.t1;
DROP DATABASE IF EXISTS federated;
