SET session sql_mode= @old_local_sql_mode;
FLUSH TABLES;
#
# ==================================================================
# Inside a transaction the statement is not auto-committed by itself
# ==================================================================
#
CALL fill_tables();
BEGIN;
UPDATE t1, t2 SET t1.b= 'in trx' WHERE t1.a= t2.a;
affected rows: 3
