#
# ==================================================================
# Statements that are not pushed down
# ==================================================================
#
# EXPLAIN shows the local query plan for them, so it tells a pushed
# down statement from one that is executed locally
#
# IGNORE is not printed by SELECT_LEX::print(), so an IGNORE statement
# is executed locally and keeps ignoring the duplicate key errors
CALL fill_tables();
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
EXPLAIN UPDATE IGNORE t3, t2 SET t3.b= 30 WHERE t3.a= t2.a AND t3.a < 3;
