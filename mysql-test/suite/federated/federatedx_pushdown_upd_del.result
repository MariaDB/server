#
# MDEV-41243, MDEV-41273: same assertion, but for a stored routine's own
# pushed down UPDATE/DELETE, and for one it runs via dynamic SQL
#
# A pushed down UPDATE/DELETE that is one of a routine's own
# instructions, CALLed with pushdown on and then off
CALL fill_tables();
CREATE PROCEDURE p_upd_del()
BEGIN
UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1;
DELETE FROM x USING t1 AS x JOIN t2 AS y ON x.a= y.a WHERE y.a= 2;
END|
SET global federated_pushdown=1;
# The routine's statements are sent to the remote server pushed down
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_upd_del();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %' OR argument LIKE 'delete %';
argument
update (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) set `federated`.`x`.`b` = `federated`.`y`.`c` where `federated`.`y`.`a` = 1
delete  from `x` using (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) where `federated`.`y`.`a` = 2
connection master;
SET global federated_pushdown=0;
# Reset the data so this second, non-pushed-down CALL actually
# changes/deletes a row instead of silently matching none
CALL fill_tables();
# Not pushed down: the remote server sees different statements
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_upd_del();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %' OR argument LIKE 'delete %';
argument
UPDATE `t1` SET `b` = 'I' WHERE `a` = 1 AND `b` = 'one' LIMIT 1
DELETE FROM `t1` WHERE `a` = 2 AND `b` = 'two' LIMIT 1
connection master;
SELECT * FROM t1 ORDER BY a;
a	b
1	I
3	three
4	four
#
# A pushed down statement in a routine that is CALLed from another
# routine: the nested routine must not be frozen either
#
CALL fill_tables();
CREATE PROCEDURE p_outer()
BEGIN
CALL p_upd_del();
END|
SET global federated_pushdown=1;
# Nested routine: statements still pushed down
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_outer();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %' OR argument LIKE 'delete %';
argument
update (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) set `federated`.`x`.`b` = `federated`.`y`.`c` where `federated`.`y`.`a` = 1
delete  from `x` using (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) where `federated`.`y`.`a` = 2
connection master;
SET global federated_pushdown=0;
CALL fill_tables();
CALL p_outer();
SELECT * FROM t1 ORDER BY a;
a	b
1	I
3	three
4	four
#
# EXECUTE of a prepared statement inside a routine exercises the
# interaction between sp_head::execute() and
# Prepared_statement::execute_loop(), each of which decides on its own
# whether to freeze its mem_root. The PREPARE stays
# outside the routine so the SAME prepared statement, not a fresh one,
# is EXECUTEd by both CALLs below
#
CALL fill_tables();
PREPARE stmt FROM "UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1";
CREATE PROCEDURE p_execute()
BEGIN
EXECUTE stmt;
END|
SET global federated_pushdown=1;
# EXECUTE in routine: statement pushed down
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_execute();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %';
argument
update (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) set `federated`.`x`.`b` = `federated`.`y`.`c` where `federated`.`y`.`a` = 1
connection master;
SET global federated_pushdown=0;
CALL fill_tables();
CALL p_execute();
DEALLOCATE PREPARE stmt;
SELECT * FROM t1 ORDER BY a;
a	b
1	I
2	two
3	three
4	four
#
# A static cursor's OPEN has no LEX of its own: it runs the cursor's
# SELECT using the corresponding DECLARE (cpush) instruction's LEX
# instead (see sp_instr_copen::execute())
#
CALL fill_tables();
CREATE PROCEDURE p_cursor()
BEGIN
DECLARE v_a INT;
DECLARE v_b VARCHAR(16);
DECLARE cur CURSOR FOR SELECT a, b FROM t1 WHERE a < 3;
OPEN cur;
FETCH cur INTO v_a, v_b;
CLOSE cur;
END|
SET global federated_pushdown=1;
# Cursor SELECT pushed down
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
CALL p_cursor();
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'select %';
argument
select `federated`.`t1`.`a` AS `a`,`federated`.`t1`.`b` AS `b` from `federated`.`t1` where `federated`.`t1`.`a` < 3
connection master;
SET global federated_pushdown=0;
CALL fill_tables();
CALL p_cursor();
DROP PROCEDURE p_cursor;
#
# Pushdown off first (the statement is executed without pushdown),
# then on, then off again, for a prepared statement and a routine
#
SET global federated_pushdown=0;
CALL fill_tables();
PREPARE pstmt FROM "UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1";
CREATE PROCEDURE p_off_on()
UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1;
EXECUTE pstmt;
CALL p_off_on();
SET global federated_pushdown=1;
CALL fill_tables();
EXECUTE pstmt;
CALL p_off_on();
SET global federated_pushdown=0;
CALL fill_tables();
EXECUTE pstmt;
CALL p_off_on();
SELECT a, b FROM t1 ORDER BY a;
a	b
1	I
2	two
3	three
4	four
DEALLOCATE PREPARE pstmt;
DROP PROCEDURE p_off_on;
#
# A pushed down UPDATE/DELETE inside a stored function and inside a
# trigger, executed with pushdown on, then off, then on again
#
CALL fill_tables();
CREATE TABLE tl_trg (a int);
CREATE FUNCTION f_upd_del() RETURNS int
BEGIN
UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 1;
DELETE FROM x USING t1 AS x JOIN t2 AS y ON x.a= y.a WHERE y.a= 2;
RETURN 1;
END|
CREATE TRIGGER trg_upd_del AFTER INSERT ON tl_trg FOR EACH ROW
BEGIN
UPDATE t1 AS x JOIN t2 AS y ON x.a= y.a SET x.b= y.c WHERE y.a= 3;
DELETE FROM x USING t1 AS x JOIN t2 AS y ON x.a= y.a WHERE y.a= 3;
END|
SET global federated_pushdown=1;
# Function: statements pushed down
connection slave;
TRUNCATE TABLE mysql.general_log;
SET global general_log=1;
connection master;
SELECT f_upd_del();
f_upd_del()
1
connection slave;
SET global general_log=0;
SELECT argument FROM mysql.general_log
WHERE argument LIKE 'update %' OR argument LIKE 'delete %';
argument
update (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) set `federated`.`x`.`b` = `federated`.`y`.`c` where `federated`.`y`.`a` = 1
delete  from `x` using (`federated`.`t1` `x` join `federated`.`t2` `y` on(`federated`.`x`.`a` = `federated`.`y`.`a`)) where `federated`.`y`.`a` = 2
connection master;
