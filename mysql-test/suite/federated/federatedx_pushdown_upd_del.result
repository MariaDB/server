#
# ==================================================================
# EXPLAIN and ANALYZE report the pushdown
# ==================================================================
#
# A statement taken over by the select handler has no local query plan,
# it is reported as PUSHED UPDATE / PUSHED DELETE, the way a
# pushed down SELECT is reported as PUSHED SELECT
#
# EXPLAIN does not execute the statement
CALL fill_tables();
EXPLAIN UPDATE t1, t2 SET t1.b= 'explained' WHERE t1.a= t2.a;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
