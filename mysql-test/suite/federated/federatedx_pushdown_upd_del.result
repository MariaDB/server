#
# A UNION used as a derived table is optimized differently from a
# top-level pushed unit: its member SELECTs are optimized directly,
# but the pushed down derived table skips the step that would
# otherwise optimize the DISTINCT/ORDER BY/LIMIT wrapper of the UNION
#
CALL fill_tables();
CREATE TABLE tl (a int) ENGINE=MyISAM;
INSERT INTO tl VALUES (1),(2),(3),(4);
SET global federated_pushdown=1;
