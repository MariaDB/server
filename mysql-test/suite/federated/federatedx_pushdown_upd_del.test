FLUSH TABLES;
--replace_regex /Data source error: .*/Data source error: .../
--error ER_QUERY_ON_FOREIGN_DATA_SOURCE
select * from federated_nrt.f_gone;
DROP SERVER srv_nrt;
DROP TABLE federated_nrt.f_gone;

--echo # An error packet of the remote server with the code of
--echo # ER_NET_READ_INTERRUPTED is not a net_read_timeout: the connection and
--echo # the transaction on the remote server must stay
connection slave;
CREATE DATABASE f2db;
CREATE TABLE f2db.s1 (a INT) ENGINE=InnoDB;
--echo # The remote server rejects a=2 with an error packet whose code is 1159
delimiter |;
CREATE TRIGGER f2db.tr BEFORE INSERT ON f2db.s1 FOR EACH ROW
BEGIN
  IF NEW.a = 2 THEN
    SIGNAL SQLSTATE 'HY000' SET MYSQL_ERRNO = 1159,
      MESSAGE_TEXT = 'error raised by remote trigger';
  END IF;
END|
delimiter ;|

connection master;
CREATE DATABASE f2db;
--replace_result $SLAVE_MYPORT SLAVE_PORT
eval CREATE TABLE f2db.s1 (a INT)
ENGINE=FEDERATED CONNECTION='mysql://root@127.0.0.1:$SLAVE_MYPORT/f2db/s1';

BEGIN;
INSERT INTO f2db.s1 VALUES (1);
--error ER_GET_ERRMSG
INSERT INTO f2db.s1 VALUES (2);
SHOW WARNINGS;
SELECT @@in_transaction;
INSERT INTO f2db.s1 VALUES (3);
COMMIT;

connection slave;
--echo # Rows on the remote server
SELECT a FROM f2db.s1 ORDER BY a;

connection master;
DROP DATABASE f2db;
connection slave;
DROP DATABASE f2db;

--echo # The connection is lost while SET AUTOCOMMIT=0 is sent for the first
--echo # statement of a transaction
connection slave;
CREATE DATABASE f3db;
CREATE TABLE f3db.t1 (a INT) ENGINE=InnoDB;

connection master;
CREATE DATABASE f3db;
--replace_result $SLAVE_MYPORT SLAVE_PORT
eval CREATE TABLE f3db.t1 (a INT)
ENGINE=FEDERATED CONNECTION='mysql://root@127.0.0.1:$SLAVE_MYPORT/f3db/t1';
CREATE TABLE f3db.t2 (a INT) ENGINE=InnoDB;
--echo # Open the remote connection in autocommit mode
SELECT * FROM f3db.t1;

--echo # Kill the idle FederatedX connection on the remote server
connection slave;
--source suite/federated/include/federatedx_kill_idle_f3db.inc

connection master;
BEGIN;
INSERT INTO f3db.t2 VALUES (1);
--echo # The local transaction is rolled back
--error ER_NET_READ_ERROR,ER_QUERY_ON_FOREIGN_DATA_SOURCE
INSERT INTO f3db.t1 VALUES (1);
SELECT @@in_transaction;
SELECT * FROM f3db.t2;
--echo # Runs in autocommit mode
INSERT INTO f3db.t1 VALUES (2);
ROLLBACK;

connection slave;
SELECT * FROM f3db.t1;

--echo # The same in a session that disconnects after the error, followed by
--echo # a transaction in another session: the lost connection must not leave
--echo # its savepoint state behind for the next transaction
--source suite/federated/include/federatedx_kill_idle_f3db.inc

connection master;
--source include/count_sessions.inc
connect (con1,127.0.0.1,root,,test,$MASTER_MYPORT,);
BEGIN;
--error ER_NET_READ_ERROR,ER_QUERY_ON_FOREIGN_DATA_SOURCE
INSERT INTO f3db.t1 VALUES (3);
disconnect con1;

connection master;
--source include/wait_until_count_sessions.inc
BEGIN;
INSERT INTO f3db.t1 VALUES (4);
ROLLBACK;

connection slave;
SELECT * FROM f3db.t1;

connection master;
DROP DATABASE f3db;
connection slave;
DROP DATABASE f3db;

--echo # Cleanup
connection master;
--disable_query_log
eval set global net_read_timeout= $old_net_read_timeout;
--enable_query_log
connection slave;
DROP DATABASE federated_nrt;
connection master;
DROP DATABASE federated_nrt;

DROP PROCEDURE fill_tables;
