--source include/have_debug.inc
--source include/not_asan.inc
--source include/not_embedded.inc

--echo #
--echo # MDEV-40341 store read-only sysvars in a read-only root and a read-only segment
--echo #
call mtr.add_suppression('mariadbd got signal 11');
call mtr.add_suppression('Attempting backtrace');

select @@global.skip_name_resolve;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
set @@global.skip_name_resolve=0;
--write_line restart $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--error 2013,2026
set @@debug_dbug='d,set_skip_name_resolve';
--enable_reconnect
--source include/wait_until_connected_again.inc

select @@global.bind_address;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
set @@global.bind_address=0;
--write_line restart $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--error 2013,2026
set @@debug_dbug='d,set_bind_address_buf';
--enable_reconnect
--source include/wait_until_connected_again.inc
