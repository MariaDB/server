# partial result cache configuration
SELECT @@optimizer_switch LIKE '%partial_result_cache=off%';
@@optimizer_switch LIKE '%partial_result_cache=off%'
1
SET optimizer_switch='partial_result_cache=on';
SELECT @@optimizer_switch LIKE '%partial_result_cache=on%';
@@optimizer_switch LIKE '%partial_result_cache=on%'
1
SET optimizer_switch='partial_result_cache=off';
SELECT @@optimizer_switch LIKE '%partial_result_cache=off%';
@@optimizer_switch LIKE '%partial_result_cache=off%'
1
SELECT @@rds_partial_result_cache_max_mem_size;
@@rds_partial_result_cache_max_mem_size
16777216
SELECT @@rds_partial_result_cache_cost_threshold;
@@rds_partial_result_cache_cost_threshold
0.500000
SELECT @@rds_partial_result_cache_min_hit_ratio;
@@rds_partial_result_cache_min_hit_ratio
0.200000
SELECT @@rds_partial_result_cache_hit_ratio_frequency;
@@rds_partial_result_cache_hit_ratio_frequency
200
SET @@session.rds_partial_result_cache_max_mem_size=1048576;
SET @@session.rds_partial_result_cache_cost_threshold=0.75;
SET @@session.rds_partial_result_cache_min_hit_ratio=0.25;
SET @@session.rds_partial_result_cache_hit_ratio_frequency=50;
SELECT @@rds_partial_result_cache_max_mem_size;
@@rds_partial_result_cache_max_mem_size
1048576
SELECT @@rds_partial_result_cache_cost_threshold;
@@rds_partial_result_cache_cost_threshold
0.750000
SELECT @@rds_partial_result_cache_min_hit_ratio;
@@rds_partial_result_cache_min_hit_ratio
0.250000
SELECT @@rds_partial_result_cache_hit_ratio_frequency;
@@rds_partial_result_cache_hit_ratio_frequency
50
SET optimizer_switch=default;
