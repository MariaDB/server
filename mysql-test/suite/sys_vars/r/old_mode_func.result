#
# MDEV-40406 hide #mysql50# prefix support behind the old mode
#
#
# MDEV-42180 Assertion `is_null() || is_empty() || !check_name(*this)' failed in Lex_ident_db::Lex_ident_db after USE `#mysql50#db` and old_mode reset
#
# invalid thd->db
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
use `#mysql50#d-b`;
set old_mode=default;
select @@old_mode, database();
@@old_mode	database()
	#mysql50#d-b
create table x (a int);
drop table x;
# thd->db is valid, but caller's database is not
create procedure test.reset_old_mode()
begin
select 1, database(), @@old_mode;
set old_mode='';
select 2, database(), @@old_mode;
end|
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
call test.reset_old_mode();
1	database()	@@old_mode
1	test	MYSQL50_TABLE_NAMES
2	database()	@@old_mode
2	test	
select @@old_mode, database();
@@old_mode	database()
	#mysql50#d-b
create table x (a int);
drop table x;
use test;
# cached procedure body
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t1 (a int);
create procedure p1() select * from `#mysql50#d-b`.t1;
call p1();
a
set old_mode='';
call p1();
a
drop procedure reset_old_mode;
call p1();
ERROR HY000: Failed to load routine test.p1 (internal code -6). For more details, run SHOW WARNINGS
show warnings;
Level	Code	Message
Error	1102	Incorrect database name '#mysql50#d-b'
Error	1457	Failed to load routine test.p1 (internal code -6). For more details, run SHOW WARNINGS
# prepared statement
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
prepare s from 'select * from `#mysql50#d-b`.t1';
execute s;
a
set old_mode='';
execute s;
a
deallocate prepare s;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
drop procedure p1;
drop database `#mysql50#d-b`;
set old_mode=default;
#
# MDEV-42179 Assertion `0' failed in store_string (ddl_log.cc) on DROP DATABASE with a #mysql50# table, default old_mode
#
call mtr.add_suppression('Invalid \\(old\\?\\) table or database name ''t-1''');
create database db1;
create table db1.t1 (a int) engine=myisam;
drop database db1;
#
# MDEV-42191 SET old_mode without MYSQL50_TABLE_NAMES fails when the current database name starts with #
#
create database `#`;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
use `#`;
set old_mode=default;
drop database `#`;
use test;
# only database and table names are checked
create table t1 (`#mysql50#a` int);
select `#mysql50#a` as `#mysql50#b` from t1;
#mysql50#b
create table `#mysql50#t-1` (a int);
ERROR 42000: Incorrect table name '#mysql50#t-1'
select * from test.`#mysql50#t-1`;
ERROR 42000: Incorrect table name '#mysql50#t-1'
use `#mysql50#d-b`;
ERROR 42000: Incorrect database name '#mysql50#d-b'
create database `#mysql50#d-b`;
ERROR 42000: Incorrect database name '#mysql50#d-b'
grant select on `#mysql50#d-b`.* to root@localhost;
ERROR 42000: Incorrect database name '#mysql50#d-b'
create trigger `#mysql50#tr-1` before insert on t1 for each row set @a:=1;
ERROR 42000: Incorrect routine name '#mysql50#tr-1'
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create trigger `#mysql50#tr-1` before insert on t1 for each row set @a:=1;
ERROR 42000: Incorrect routine name '#mysql50#tr-1'
set old_mode=default;
drop table t1;
set @`#mysql50#var`=1;
create procedure `#mysql50#p`() select 1;
call `#mysql50#p`();
1
1
drop procedure `#mysql50#p`;
#
# MDEV-42192 Assertion `is_null() || is_empty() || !check_name(*this)' failed in Lex_ident_db::Lex_ident_db after USE `#mysql50#db` and a failed COM_CHANGE_USER
