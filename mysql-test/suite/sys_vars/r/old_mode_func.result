set old_mode=default;
execute s;
1
1
deallocate prepare s;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
set old_mode=default;
# show open tables from
show open tables from `#mysql50#a`;
ERROR 42000: Incorrect database name '#mysql50#a'
# show open tables
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t1 (a int);
insert into `#mysql50#d-b`.t1 values (1);
set old_mode=default;
show open tables where `Database` like '#mysql50#%';
Database	Table	In_use	Name_locked
#mysql50#d-b	t1	0	0
# cached trigger
create table t2 (a int);
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create trigger tr after insert on t2 for each row insert into `#mysql50#d-b`.t1 values (new.a);
insert into t2 values (10);
set old_mode=default;
insert into t2 values (11);
drop table t2;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
select * from `#mysql50#d-b`.t1;
a
1
10
11
set old_mode=default;
# cached function
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create function f() returns int return (select count(*) from `#mysql50#d-b`.t1);
select f();
f()
3
set old_mode=default;
select f();
f()
3
drop function f;
set old_mode=default;
# sequence
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create sequence `#mysql50#d-b`.s;
create table t2 (a int default nextval(`#mysql50#d-b`.s), b int);
insert into t2 (b) values (1);
set old_mode=default;
insert into t2 (b) values (2);
select * from t2;
a	b
1	1
2	2
drop table t2;
# vector index, old_mode reset inside a transaction (see MHNSW_Trx::do_commit)
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t2 (id int primary key, v vector(2) not null, vector(v)) engine=innodb;
begin;
insert into `#mysql50#d-b`.t2 values (1, vec_fromtext("[1,2]"));
set old_mode=default;
commit;
# BINLOG statement
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t3 (a int);
reset master;
insert into `#mysql50#d-b`.t3 values (1);
flush binary logs;
set old_mode=default;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
select * from `#mysql50#d-b`.t3;
a
1
1
drop database `#mysql50#d-b`;
set old_mode=default;
#
# MDEV-42194 Assertion `is_null() || is_empty() || !check_name(*this)' failed in Lex_ident_db::Lex_ident_db in mysql_opt_change_db when a trigger of a table in a `#mysql50#` database fires after old_mode reset
#
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t1 (a int);
create trigger `#mysql50#d-b`.tr after insert on `#mysql50#d-b`.t1 for each row set @a=1;
prepare s from 'insert into `#mysql50#d-b`.t1 values (1)';
set old_mode=default;
execute s;
deallocate prepare s;
select @a;
@a
1
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
drop database `#mysql50#d-b`;
set old_mode=default;
#
# MDEV-42195 information_schema.routines and parameters fail with ER_SP_WRONG_NAME when a stored function exists in a #mysql50# database
#
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create function `#mysql50#d-b`.f1() returns int return 1;
create function test.f2() returns int return 2;
set old_mode=default;
select routine_schema, routine_name from information_schema.routines where routine_type='FUNCTION' and routine_schema<>'sys';
routine_schema	routine_name
#mysql50#d-b	f1
test	f2
select specific_schema, specific_name, ordinal_position from information_schema.parameters where routine_type='FUNCTION' and specific_schema<>'sys';
specific_schema	specific_name	ordinal_position
#mysql50#d-b	f1	0
test	f2	0
drop function test.f2;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
drop database `#mysql50#d-b`;
set old_mode=default;
#
# MDEV-42196 Event in a #mysql50# database never executes in default old_mode, error log says "failed to authenticate the user"
#
create table t1 (a int);
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create event `#mysql50#d-b`.e1 on schedule every 1 second do insert into test.t1 values (1);
Warnings:
Warning	1105	Event scheduler is switched off, use SET GLOBAL event_scheduler=ON to enable it.
set old_mode=default;
set global event_scheduler=on;
set global event_scheduler=off;
select distinct a from t1;
a
1
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
drop database `#mysql50#d-b`;
set old_mode=default;
drop table t1;
#
# MDEV-42219 Assertion `is_null() || is_empty() || !check_name(*this)' failed in Lex_ident_db::Lex_ident_db in prepare_fk_prelocking_list on DML into parent table with child in `#mysql50#` database
#
call mtr.add_suppression('Invalid \\(old\\?\\) table or database name ''d-b''');
create table t1 (a int primary key) engine=innodb;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create table `#mysql50#d-b`.t2 (a int, foreign key (a) references test.t1 (a)) engine=innodb;
set old_mode=default;
insert into t1 values (1);
update t1 set a=2;
replace into t1 values (2);
delete from t1;
lock tables t1 write;
unlock tables;
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
drop database `#mysql50#d-b`;
set old_mode=default;
drop table t1;
