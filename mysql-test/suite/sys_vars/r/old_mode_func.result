set old_mode=default;
#
# MDEV-42193 Assertion `is_null() || is_empty() || !check_name(*this)' failed in Lex_ident_db::Lex_ident_db on EXECUTE of a prepared CALL of a routine in a `#mysql50#` database after old_mode reset
#
set old_mode=MYSQL50_TABLE_NAMES;
Warnings:
Warning	1287	'MYSQL50_TABLE_NAMES' is deprecated and will be removed in a future release
create procedure `#mysql50#d-b`.p() select 1;
