#
# MDEV-40636 CSV crashes on DELETE
#
create table t1 (id int not null, pad char(10) not null) engine=csv;
insert t1 select seq,'AAAAAAAAAA' from seq_1_to_2048;
delete from t1 where id % 2 = 0;
select count(*), sum(id) from t1;
count(*)	sum(id)
1024	1048576
drop table t1;
# End of 10.6 tests
#
# MDEV-41216 ha_tina (CSV) deletes wrong records
#
# A DELETE or UPDATE in which two aliases of a CSV table change
# rows is refused when it is prepared.
create table t1 (v int not null) engine=csv;
insert into t1 values (1),(2),(3),(4),(5);
delete a1, a3 from t1 as a1 join t1 as a3 where a1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
update t1 as a1 join t1 as a3 set a1.v=20, a3.v=10 where a1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
delete ignore a1, a3 from t1 as a1 join t1 as a3 where a1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
update ignore t1 as a1 join t1 as a3 set a1.v=20, a3.v=10
where a1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
# No row matches
delete a1, a3 from t1 as a1 join t1 as a3 where a1.v=20 and a3.v=10;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
# A view of the table is another alias
create view v1 as select * from t1;
delete v1, a3 from v1 join t1 as a3 where v1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `v1` and `a3`'
update v1 join t1 as a3 set v1.v=20, a3.v=10 where v1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `v1` and `a3`'
drop view v1;
select * from t1 order by v;
v
1
2
3
4
5
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# One alias changes rows while the other only reads them
delete a1 from t1 as a1 join t1 as a3 where a1.v=a3.v+1 and a3.v=1;
update t1 as a1 join t1 as a3 set a1.v=a1.v*10 where a1.v=a3.v+1 and a3.v=3;
select * from t1 order by v;
v
1
3
5
40
# LOCK TABLES
insert into t1 values (2);
lock tables t1 as a1 write, t1 as a3 write;
delete a1, a3 from t1 as a1 join t1 as a3 where a1.v=2 and a3.v=1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
delete a1 from t1 as a1 join t1 as a3 where a1.v=a3.v+1 and a3.v=1;
unlock tables;
select * from t1 order by v;
v
1
3
5
40
# Stored functions
create function f1() returns int
begin
delete a1, a3 from t1 as a1 join t1 as a3 where a1.v=3 and a3.v=1;
return 1;
end//
create function f2() returns int
begin
delete from t1 where v=3;
return 2;
end//
create function f3() returns int
begin
delete from t1 where v=40;
return 3;
end//
create function f4() returns int
begin
return 1;
end//
select f1();
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table through both `a1` and `a3`'
# Two functions that each change rows through one alias
select f2(), f3();
f2()	f3()
2	3
# A function call with one alias changing rows
delete a1 from t1 as a1 join t1 as a3 where a1.v=a3.v+4 and a3.v=f4();
select * from t1 order by v;
v
1
drop function f1;
drop function f2;
drop function f3;
drop function f4;
drop table t1;
# The CHECK OPTION of a view reads an alias of the table that the
# UPDATE changes through another alias
create table t1 (a int not null, b int not null) engine=csv;
insert into t1 values (1,1),(2,2),(3,3),(4,4);
create table t3 (c int not null) engine=myisam;
insert into t3 values (1),(2);
create view v1 as
select x.a, x.b from t1 as y join t1 as x on x.a=y.a where y.b>0
with check option;
update v1, t3 set v1.b=v1.b+100, t3.c=t3.c+1;
ERROR 42000: This version of MariaDB doesn't yet support 'changing a CSV table that the CHECK OPTION of `v1` reads'
select * from t1 order by a;
a	b
1	1
2	2
3	3
4	4
select * from t3 order by c;
c
1
2
drop view v1;
drop table t1, t3;
# End of 11.4 tests
