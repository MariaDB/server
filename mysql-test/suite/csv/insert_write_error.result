#
# A failed write of a row during INSERT leaves no part of the row in
# the data file
#
CREATE TABLE t1 (v INT NOT NULL) ENGINE=CSV;
INSERT INTO t1 VALUES (1);
SET @save_debug_dbug= @@debug_dbug;
SET debug_dbug='+d,tina_write_row_short_write';
INSERT INTO t1 VALUES (2);
ERROR HY000: Error writing file 'FILE' (Errcode: 28)
SET debug_dbug= @save_debug_dbug;
INSERT INTO t1 VALUES (3);
SELECT * FROM t1;
v
1
3
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# The next open reads the length of the data file
FLUSH TABLES t1;
SELECT * FROM t1;
v
1
3
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
