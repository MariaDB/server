--source include/have_debug_sync.inc

--echo #
--echo # CHECK TABLE reads a row count and a data file length that agree
--echo # while another connection inserts a row
--echo #
CREATE TABLE t1 (v INT NOT NULL) ENGINE=CSV;
INSERT INTO t1 VALUES (1),(2),(3);
connect (con1,localhost,root,,);
--echo # The lock allows inserts by other connections
LOCK TABLES t1 READ LOCAL;
SET DEBUG_SYNC='tina_check_counted SIGNAL counted WAIT_FOR inserted TIMEOUT 2';
send CHECK TABLE t1;
connect (con2,localhost,root,,);
SET DEBUG_SYNC='now WAIT_FOR counted';
--echo # Waits until CHECK TABLE has read the length of the data file
INSERT INTO t1 VALUES (4);
SET DEBUG_SYNC='now SIGNAL inserted';
connection con1;
reap;
UNLOCK TABLES;
disconnect con1;
disconnect con2;
connection default;
SET DEBUG_SYNC='RESET';
--sorted_result
SELECT * FROM t1;
CHECK TABLE t1;
DROP TABLE t1;
