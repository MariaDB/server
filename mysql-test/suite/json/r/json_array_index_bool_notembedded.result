#
# MDEV-25848 AND/OR of MEMBER OF, JSON_CONTAINS and JSON_OVERLAPS
# on one ARRAY index: the ranges built for i1, from the optimizer trace
#
create table t1 (
pk int primary key,
a int,
js json,
key(a),
index i1(cast(js as char(30) array))
);
insert into t1 values
(1,  1,  '["a", "b", "c"]'),
(2,  2,  '["b", "d"]'),
(3,  3,  '["e"]'),
(4,  4,  '["a", "e"]'),
(5,  5,  '["c", "d", "e"]'),
(6,  6,  '[]'),
(7,  7,  '["b", "b"]');
insert into t1 select seq, seq, concat('["v', seq, '", "w', seq, '"]')
from seq_100_to_300;
set optimizer_trace='enabled=on';
# AND: the range keeps only the cheaper side ('v150')
select pk from t1 where 'b' member of (js) and 'v150' member of (js);
pk
select json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].index')) as idx,
json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].ranges')) as ranges
from information_schema.optimizer_trace;
idx	ranges
["i1"]	[
    ["(\"v150\") MEMBER OF js"]
]
# JSON_CONTAINS is an AND of its elements
select pk from t1 where json_contains(js, '["v150", "b"]');
pk
select json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].index')) as idx,
json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].ranges')) as ranges
from information_schema.optimizer_trace;
idx	ranges
["i1"]	[
    ["(\"v150\") MEMBER OF js"]
]
# OR: the union of points, 'b' only once
select pk from t1 where 'b' member of (js) or 'c' member of (js) or json_overlaps(js, '["b", "d"]');
pk
1
2
5
7
select json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].index')) as idx,
json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].ranges')) as ranges
from information_schema.optimizer_trace;
idx	ranges
["i1"]	[
    [
        "(\\\"b\\\") MEMBER OF js",
        "(\\\"c\\\") MEMBER OF js",
        "(\"d\") MEMBER OF js"
    ]
]
# Nested: ('a' OR 'd') AND 'e'
select pk from t1 where ('a' member of (js) or 'd' member of (js)) and json_contains(js, '"e"');
pk
4
5
select json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].index')) as idx,
json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].ranges')) as ranges
from information_schema.optimizer_trace;
idx	ranges
["i1"]	[
    [
        "(\"a\") MEMBER OF js",
        "(\"d\") MEMBER OF js"
    ]
]
# index_merge: the AND is pushed into each disjunct
select pk from t1 where (json_overlaps(js, '["e"]') or pk = 200) and json_contains(js, '["c"]');
pk
5
select json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].index')) as idx,
json_detailed(json_extract(trace, '$**.range_scan_alternatives[*].ranges')) as ranges
from information_schema.optimizer_trace;
idx	ranges
[
    "i1",
    "i1",
    "PRIMARY",
    "i1"
]	[
    ["(\"c\") MEMBER OF js"],
    ["(\"c\") MEMBER OF js"],
    ["(200) <= (pk) <= (200)"],
    ["(\"c\") MEMBER OF js"]
]
set optimizer_trace='enabled=off';
drop table t1;
