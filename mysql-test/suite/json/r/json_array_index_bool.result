#
# MDEV-25848 AND/OR of MEMBER OF, JSON_CONTAINS and JSON_OVERLAPS
# on one ARRAY index
#
# Each condition: EXPLAIN, result with the index, result without it.
# The two results must be identical.
#
create table t1 (
pk int primary key,
a int,
js json,
key(a),
index i1(cast(js as char(30) array))
);
insert into t1 values
(1,  1,  '["a", "b", "c"]'),
(2,  2,  '["b", "d"]'),
(3,  3,  '["e"]'),
(4,  4,  '["a", "e"]'),
(5,  5,  '["c", "d", "e"]'),
(6,  6,  '[]'),
(7,  7,  '["b", "b"]');
insert into t1 select seq, seq, concat('["v', seq, '", "w', seq, '"]')
from seq_100_to_300;
# AND of the same function: the range is the cheaper side
explain select pk from t1 where 'b' member of (js) and 'v150' member of (js);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where 'b' member of (js) and 'v150' member of (js);
pk
select pk from t1 ignore index(i1) where 'b' member of (js) and 'v150' member of (js);
pk
explain select pk from t1 where json_overlaps(js, '["a", "b"]') and json_overlaps(js, '["v150", "w150"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_overlaps(js, '["a", "b"]') and json_overlaps(js, '["v150", "w150"]');
pk
select pk from t1 ignore index(i1) where json_overlaps(js, '["a", "b"]') and json_overlaps(js, '["v150", "w150"]');
pk
explain select pk from t1 where json_contains(js, '["a", "b"]') and json_contains(js, '"c"');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_contains(js, '["a", "b"]') and json_contains(js, '"c"');
pk
1
select pk from t1 ignore index(i1) where json_contains(js, '["a", "b"]') and json_contains(js, '"c"');
pk
1
