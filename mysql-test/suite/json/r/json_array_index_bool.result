#
# MAYBE_KEY on i1 ANDed into an index_merge disjunct clones the
# SEL_ARG_ARRAY, which is then ANDed and ORed with other
# SEL_ARG_ARRAYs
#
create table t2 (pk int primary key, j json);
insert into t2 values (1, '["a"]'), (2, '["d"]');
select straight_join t1.pk, t2.pk from t2, t1
where (json_overlaps(t1.js, '["a", "e"]') or t1.pk = 200)
and t1.js > t2.j and t1.a > t2.pk
and (json_contains(t1.js, '"e"') or 'v200' member of (t1.js));
pk	pk
200	1
200	2
3	1
3	2
5	1
select straight_join t1.pk, t2.pk from t2, t1 ignore index(i1)
where (json_overlaps(t1.js, '["a", "e"]') or t1.pk = 200)
and t1.js > t2.j and t1.a > t2.pk
and (json_contains(t1.js, '"e"') or 'v200' member of (t1.js));
pk	pk
200	1
200	2
3	1
3	2
5	1
drop table t1, t2;
