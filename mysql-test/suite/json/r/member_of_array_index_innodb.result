#
# UPDATE that changes the PRIMARY KEY while filtered by MEMBER OF
# (tags): on InnoDB, handler::position() (and so the hlindex's
# "tref" column, see json_index) is derived from the PRIMARY KEY
# (HA_PRIMARY_KEY_REQUIRED_FOR_POSITION), so every hlindex entry for
# the row becomes stale the moment its PK changes -- is_key_used()
# must treat the PK as part of the array key too, both so
# TABLE::hlindexes_on_update() still does the delete+insert (else
# the stored tref would point at a PK value that no longer exists),
# and so sql_update.cc buffers the plan (else the freshly re-inserted
# hlindex entry could sort ahead of the read scan's cursor within the
# same "5 MEMBER OF" group and get visited again, endlessly for
# "SET id = id + 10")
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
tags JSON NOT NULL,
INDEX arr_idx (CAST(tags AS UNSIGNED ARRAY))
) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1, '[5]'),
(2, '[5]'),
(3, '[5]'),
(4, '[5]'),
(5, '[1]');
EXPLAIN UPDATE t1 SET id = id + 100 WHERE 5 MEMBER OF (tags);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	arr_idx	arr_idx	258	NULL	4	Using where; Using buffer
UPDATE t1 SET id = id + 100 WHERE 5 MEMBER OF (tags);
# all four rows must have moved, exactly once each
SELECT id FROM t1;
id
101
102
103
104
5
# and must still be found via MEMBER OF at their new id (fresh tref)
SELECT id FROM t1 WHERE 5 MEMBER OF (tags);
id
101
102
103
104
DROP TABLE t1;
#
# A row whose JSON value can't be indexed (not an array, or an array
# with a non-scalar element -- see member_of_array_index.test) must
# not leave InnoDB with a half-written row: the hlindex insert
# (TABLE::hlindexes_on_insert(), called from handler::ha_write_row()
# right after the base row write) fails only after the base row
# write already succeeded, so on a non-transactional engine the row
# can be left behind, unindexed; InnoDB is transactional, so the
# whole statement must roll back instead
#
CREATE TABLE t2 (
id INT PRIMARY KEY,
tags JSON NOT NULL,
INDEX arr_idx (CAST(tags AS UNSIGNED ARRAY))
) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1, '{"a": 1}');
ERROR 22007: Incorrect json value: '{"a": 1}' for column `test`.`t2`.`tags` at row 1
# nothing committed, and the table is not actually damaged
SELECT * FROM t2;
id	tags
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
# same for a multi-row INSERT with one bad row: all-or-nothing
INSERT INTO t2 VALUES (1, '[1, 2]'), (2, '{"a": 1}'), (3, '[3, 4]');
ERROR 22007: Incorrect json value: '{"a": 1}' for column `test`.`t2`.`tags` at row 2
SELECT * FROM t2;
id	tags
# the table must still be perfectly usable afterwards
INSERT INTO t2 VALUES (1, '[1, 2]');
SELECT id FROM t2 WHERE 1 MEMBER OF (tags);
id
1
DROP TABLE t2;
# End of 13.3 tests
