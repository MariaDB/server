209
# Combined with other predicates and indexes
explain select pk from t1 where json_overlaps(js, '["e"]') or pk = 200;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	index_merge	PRIMARY,i1	i1,PRIMARY	19,4	NULL	#	Using sort_union(i1,PRIMARY); Using where
select pk from t1 where json_overlaps(js, '["e"]') or pk = 200;
pk
200
3
select pk from t1 ignore index(i1) where json_overlaps(js, '["e"]') or pk = 200;
pk
200
3
