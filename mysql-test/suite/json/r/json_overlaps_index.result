#
# MDEV-25848 Range optimizer support for JSON_OVERLAPS
#
create table t3 (
pk int primary key,
js json,
index i1(cast(js as unsigned array))
);
insert into t3 select seq, concat('["value-', seq, '"]') from seq_1_to_200;
explain select * from t3 where json_overlaps(js, '["value-100", "value-101", "value-108"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t3	range	i1	i1	19	NULL	3	Using where
select * from t3 where json_overlaps(js, '["value-100", "value-101", "value-108"]');
pk	js
100	["value-100"]
101	["value-101"]
108	["value-108"]
explain select * from t3 where json_overlaps('["value-100", "value-101", "value-108"]', js);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t3	range	i1	i1	19	NULL	3	Using where
select * from t3 where json_overlaps('["value-100", "value-101", "value-108"]', js);
pk	js
100	["value-100"]
101	["value-101"]
108	["value-108"]
DROP TABLE t3;
#
# Each condition: EXPLAIN, result with the index, result without it.
# The two results must be identical.
#
create table t1 (
pk int primary key,
js json,
index i1(cast(js as char(30) array))
);
insert into t1 values
(1,  '["a", "b", "c"]'),
(2,  '["b", "d"]'),
(3,  '["e"]'),
(4,  '[1, 2, 3]'),
(5,  '[1.0, "1", true]'),
(6,  '[null, false]'),
(7,  '["aaaaaaaaaaaaaaaaaaaa-1", "aaaaaaaaaaaaaaaaaaaa-2"]'),
(8,  '["a\\"b", "\\u00e9"]'),
(9,  '[]'),
(10, '["a", "a", "b"]'),
(11, '["é"]');
insert into t1 select seq, concat('["v', seq, '", "w', seq, '"]')
from seq_100_to_300;
# Basic: OR of points, both argument orders
explain select pk from t1 where json_overlaps(js, '["b", "e"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_overlaps(js, '["b", "e"]');
pk
1
10
2
3
select pk from t1 ignore index(i1) where json_overlaps(js, '["b", "e"]');
pk
1
10
2
3
explain select pk from t1 where json_overlaps('["b", "e"]', js);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_overlaps('["b", "e"]', js);
pk
1
10
2
3
select pk from t1 ignore index(i1) where json_overlaps('["b", "e"]', js);
pk
1
10
2
3
