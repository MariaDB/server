# LIMIT
select count(*) from
(select pk from t1 where json_overlaps(js, '["a", "b"]') limit 2) dt;
count(*)
2
# Prepared statement, re-executed with different values
prepare s from 'select pk from t1 where json_overlaps(js, ?)';
set @a= '["b", "e"]';
execute s using @a;
pk
1
10
2
3
set @a= '["v150"]';
execute s using @a;
pk
150
set @a= NULL;
execute s using @a;
pk
set @a= '[]';
execute s using @a;
pk
deallocate prepare s;
#
# Values from another table
#
create table t2 (pk int primary key, j json, k json);
insert into t2 values (1, '"v150"', '["v150", "w150"]'),
(2, '"b"',    '["b"]');
# Non-constant values: these predicates are not used for ranges,
# but their key fields must fit in update_ref_and_keys()'s buffer
explain select t1.pk, t2.pk from t1, t2
where json_overlaps(t1.js, t2.j) and json_overlaps(t2.k, t1.js)
and json_overlaps(t1.js, t2.k) and json_overlaps(t2.j, t1.js);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t2	ALL	NULL	NULL	NULL	NULL	#	
1	SIMPLE	t1	ALL	i1	NULL	NULL	NULL	#	Using where; Using join buffer (flat, BNL join)
select t1.pk, t2.pk from t1, t2
where json_overlaps(t1.js, t2.j) and json_overlaps(t2.k, t1.js)
and json_overlaps(t1.js, t2.k) and json_overlaps(t2.j, t1.js);
pk	pk
1	2
10	2
150	1
2	2
# t2 is a const table: t1 can use a range on i1
explain select t1.pk from t1, t2 where t2.pk = 1 and json_overlaps(t1.js, t2.k);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t2	const	PRIMARY	PRIMARY	4	const	#	
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select t1.pk from t1, t2 where t2.pk = 1 and json_overlaps(t1.js, t2.k);
pk
150
# MAYBE_KEY on i1 ANDed into an index_merge disjunct clones the
# SEL_ARG_ARRAY, the clone must still be a SEL_ARG_ARRAY
create table t4 (pk int primary key, j json);
insert into t4 values (1, '["a"]'), (2, '["d"]');
create table t5 (
pk int primary key,
a int,
js json,
key(a),
index i1(cast(js as char(30) array))
);
insert into t5 values (1, 1, '["e"]'), (2, 2, '["f"]'), (3, 3, '["e", "g"]');
insert into t5 select seq, seq, concat('["v', seq, '"]') from seq_100_to_300;
select straight_join t5.pk, t4.pk from t4, t5
where (json_overlaps(t5.js, '["e"]') or t5.pk = 200)
and t5.js > t4.j and t5.a > t4.pk;
pk	pk
200	1
200	2
3	1
3	2
drop table t4, t5;
drop table t1, t2;
