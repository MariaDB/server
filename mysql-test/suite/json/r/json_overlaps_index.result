# Many elements (more than MAX_KEY = 64)
select json_arrayagg(concat('v', seq)) into @big from seq_100_to_180;
explain select count(*) from t1 where json_overlaps(js, @big);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	i1	NULL	NULL	NULL	#	Using where
explain select count(*) from t1 force index(i1) where json_overlaps(js, @big);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	83	Using where
select count(*) from t1 where json_overlaps(js, @big);
count(*)
81
select count(*) from t1 ignore index(i1) where json_overlaps(js, @big);
count(*)
81
# NOT must not use the index
explain select pk from t1 where not json_overlaps(js, '["b"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	#	Using where
select count(*) from t1 where not json_overlaps(js, '["b"]');
count(*)
209
select count(*) from t1 ignore index(i1) where not json_overlaps(js, '["b"]');
