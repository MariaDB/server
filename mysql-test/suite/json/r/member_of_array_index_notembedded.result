#
# AND of two independent MEMBER OF predicates against the same array
# index: get_claimed_key_part() (opt_range.cc) gives each one its
# own key part/idx, so the trace shows two independent "arr_idx"
# candidates (one per predicate) instead of the index being dropped
# entirely -- the optimizer then picks the cheaper of the two.
#
CREATE TABLE t (
id INT PRIMARY KEY,
tags JSON NOT NULL,
INDEX arr_idx (CAST(tags AS UNSIGNED ARRAY))
);
INSERT INTO t VALUES (1, '[1, 2, 3]'), (2, '[4, 5, 6]');
SET optimizer_trace='enabled=on';
SELECT id FROM t WHERE 2 MEMBER OF (tags) AND 5 MEMBER OF (tags);
