select pk from t4 ignore index(i1) where json_contains(js1, '"c"') and json_contains(js2, '"w500"');
pk
500
# Only one ARRAY (hlindex) index per table
create table t5 (
js1 json,
js2 json,
index (cast(js1 as char(10) array)),
index (cast(js2 as char(10) array))
);
ERROR 42000: This version of MariaDB doesn't yet support 'multiple VECTOR indexes'
drop table t4;
