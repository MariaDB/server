#
# MDEV-25848 Range optimizer support for JSON_CONTAINS
#
create table t3 (
pk int primary key,
js json,
index i1(cast(js as unsigned array))
);
insert into t3 select seq,
concat('["value-', seq, '", "value-', seq + 1,
'", "value-', seq + 2, '", "value-', seq + 3, '"]') from seq_1_to_200;
explain select * from t3 where json_contains(js, '["value-100", "value-101", "value-102"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t3	range	i1	i1	19	NULL	4	Using where
select * from t3 where json_contains(js, '["value-100", "value-101", "value-102"]');
pk	js
99	["value-99", "value-100", "value-101", "value-102"]
100	["value-100", "value-101", "value-102", "value-103"]
explain select * from t3 where json_contains('["value-100", "value-101", "value-102"]', js);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t3	ALL	NULL	NULL	NULL	NULL	200	Using where
select * from t3 where json_contains('["value-100", "value-101", "value-102"]', js);
pk	js
set optimizer_trace=1;
analyze select * from t3  where js is null;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	r_rows	filtered	r_filtered	Extra
1	SIMPLE	t3	ALL	i1	NULL	NULL	NULL	200	200.00	100.00	0.00	Using where
DROP TABLE t3;
#
# Each condition: EXPLAIN, result with the index, result without it.
# The two results must be identical.
#
create table t1 (
pk int primary key,
js json,
index i1(cast(js as char(30) array))
);
insert into t1 values
(1,  '["a", "b", "c"]'),
(2,  '["b", "d"]'),
(3,  '["e"]'),
(4,  '[1, 2, 3]'),
(5,  '[1.0, "1", true]'),
(6,  '[null, false]'),
(7,  '["aaaaaaaaaaaaaaaaaaaa-1", "aaaaaaaaaaaaaaaaaaaa-2"]'),
(8,  '["a\\"b", "\\u00e9"]'),
(9,  '[]'),
(10, '["a", "a", "b"]'),
(11, '["é"]');
insert into t1 select seq, concat('["v', seq, '", "w', seq, '"]')
from seq_100_to_300;
# Basic: AND of points
explain select pk from t1 where json_contains(js, '["a", "b"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_contains(js, '["a", "b"]');
pk
1
10
select pk from t1 ignore index(i1) where json_contains(js, '["a", "b"]');
pk
1
10
explain select pk from t1 where json_contains(js, '["v150", "w150"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_contains(js, '["v150", "w150"]');
pk
150
select pk from t1 ignore index(i1) where json_contains(js, '["v150", "w150"]');
pk
150
# One element matches nothing
explain select pk from t1 where json_contains(js, '["a", "zzz"]');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select pk from t1 where json_contains(js, '["a", "zzz"]');
pk
select pk from t1 ignore index(i1) where json_contains(js, '["a", "zzz"]');
pk
