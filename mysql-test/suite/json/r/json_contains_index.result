# Prepared statement, re-executed with different values
prepare s from 'select pk from t1 where json_contains(js, ?)';
set @a= '["a", "b"]';
execute s using @a;
pk
1
10
set @a= '"v150"';
execute s using @a;
pk
150
set @a= NULL;
execute s using @a;
pk
deallocate prepare s;
prepare s from 'select count(*) from t1 where json_contains(js, ?)';
set @a= '[]';
execute s using @a;
count(*)
212
deallocate prepare s;
#
# Values from another table
#
create table t2 (pk int primary key, j json, k json);
insert into t2 values (1, '"v150"', '["v150", "w150"]'),
(2, '"b"',    '["b"]');
# Non-constant values: these predicates are not used for ranges,
# but their key fields must fit in update_ref_and_keys()'s buffer
# (Item_func_json_contains::count_sargable_conds())
explain select t1.pk, t2.pk from t1, t2
where json_contains(t1.js, t2.j) and json_contains(t1.js, t2.k)
and json_contains(t1.js, t2.j) and json_contains(t1.js, t2.k);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t2	ALL	NULL	NULL	NULL	NULL	#	
1	SIMPLE	t1	ALL	i1	NULL	NULL	NULL	#	Using where; Using join buffer (flat, BNL join)
select t1.pk, t2.pk from t1, t2
where json_contains(t1.js, t2.j) and json_contains(t1.js, t2.k)
and json_contains(t1.js, t2.j) and json_contains(t1.js, t2.k);
pk	pk
1	2
10	2
150	1
2	2
# t2 is a const table: t1 can use a range on i1
explain select t1.pk from t1, t2 where t2.pk = 1 and json_contains(t1.js, t2.k);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t2	const	PRIMARY	PRIMARY	4	const	#	
1	SIMPLE	t1	range	i1	i1	19	NULL	#	Using where
select t1.pk from t1, t2 where t2.pk = 1 and json_contains(t1.js, t2.k);
pk
150
drop table t1, t2;
# Rare element appearing after more than 64 common elements
create table t1 (
pk int primary key,
js json,
index i1(cast(js as char(30) array))
);
insert into t1 select seq, concat('["c", "u', seq, '"]') from seq_1_to_1000;
set @v= concat('[', repeat('"c", ', 200), '"u500"]');
explain select pk from t1 where json_contains(js, @v);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	1	Using where
select pk from t1 where json_contains(js, @v);
pk
500
select pk from t1 ignore index(i1) where json_contains(js, @v);
pk
500
set @w= concat('["u500", ', repeat('"c", ', 199), '"c"]');
explain select pk from t1 where json_contains(js, @w);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	i1	i1	19	NULL	1	Using where
select pk from t1 where json_contains(js, @w);
pk
500
drop table t1;
#
# ARRAY index together with other indexes on the same table
#
create table t4 (
pk int primary key,
a int,
js1 json,
js2 json,
key ka(a),
index i1(cast(js1 as char(30) array))
);
insert into t4 select seq, seq % 10,
concat('["c", "v', seq, '"]'),
concat('["c", "w', seq, '"]')
from seq_1_to_1000;
# A selective B-tree range wins over a non-selective ARRAY range
explain select pk from t4 where json_contains(js1, '"c"') and pk between 1 and 3;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t4	range	PRIMARY,i1	PRIMARY	4	NULL	#	Using index condition; Using where
select pk from t4 where json_contains(js1, '"c"') and pk between 1 and 3;
pk
1
2
3
select pk from t4 ignore index(i1) where json_contains(js1, '"c"') and pk between 1 and 3;
pk
1
2
3
# A selective ARRAY range wins over a non-selective B-tree range
explain select pk from t4 where json_contains(js1, '"v501"') and a between 1 and 2;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t4	range	ka,i1	i1	19	NULL	#	Using where
select pk from t4 where json_contains(js1, '"v501"') and a between 1 and 2;
pk
501
select pk from t4 ignore index(i1) where json_contains(js1, '"v501"') and a between 1 and 2;
pk
501
# Two JSON columns, only js1 has an ARRAY index
explain select pk from t4 where json_contains(js1, '"v500"') and json_contains(js2, '"w500"');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t4	range	i1	i1	19	NULL	#	Using where
select pk from t4 where json_contains(js1, '"v500"') and json_contains(js2, '"w500"');
pk
500
select pk from t4 ignore index(i1) where json_contains(js1, '"v500"') and json_contains(js2, '"w500"');
pk
500
explain select pk from t4 where json_contains(js1, '"c"') and json_contains(js2, '"w500"');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t4	ALL	i1	NULL	NULL	NULL	#	Using where
select pk from t4 where json_contains(js1, '"c"') and json_contains(js2, '"w500"');
pk
