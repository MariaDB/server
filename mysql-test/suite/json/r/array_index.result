# Can add a b-tree index
CREATE TABLE t (a JSON, b INT, INDEX (CAST(a AS CHAR(32) ARRAY)));
CREATE INDEX ib ON t (b);
DROP TABLE t;
# A second ARRAY index is rejected
CREATE TABLE t (a JSON, b INT, INDEX (CAST(a AS CHAR(32) ARRAY)));
ALTER TABLE t ADD INDEX ic (CAST(a AS CHAR(32) ARRAY));
ERROR 42000: This version of MariaDB doesn't yet support 'multiple VECTOR indexes'
DROP TABLE t;
