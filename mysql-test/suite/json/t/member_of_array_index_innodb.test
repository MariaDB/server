--source include/have_innodb.inc

--echo #
--echo # UPDATE that changes the PRIMARY KEY while filtered by MEMBER OF
--echo # (tags): on InnoDB, handler::position() (and so the hlindex's
--echo # "tref" column, see json_index) is derived from the PRIMARY KEY
--echo # (HA_PRIMARY_KEY_REQUIRED_FOR_POSITION), so every hlindex entry for
--echo # the row becomes stale the moment its PK changes -- is_key_used()
--echo # must treat the PK as part of the array key too, both so
--echo # TABLE::hlindexes_on_update() still does the delete+insert (else
--echo # the stored tref would point at a PK value that no longer exists),
--echo # and so sql_update.cc buffers the plan (else the freshly re-inserted
--echo # hlindex entry could sort ahead of the read scan's cursor within the
--echo # same "5 MEMBER OF" group and get visited again, endlessly for
--echo # "SET id = id + 10")
--echo #
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  tags JSON NOT NULL,
  INDEX arr_idx (CAST(tags AS UNSIGNED ARRAY))
) ENGINE=InnoDB;
INSERT INTO t1 VALUES
  (1, '[5]'),
  (2, '[5]'),
  (3, '[5]'),
  (4, '[5]'),
  (5, '[1]');

EXPLAIN UPDATE t1 SET id = id + 100 WHERE 5 MEMBER OF (tags);
UPDATE t1 SET id = id + 100 WHERE 5 MEMBER OF (tags);

--echo # all four rows must have moved, exactly once each
--sorted_result
SELECT id FROM t1;

--echo # and must still be found via MEMBER OF at their new id (fresh tref)
--sorted_result
SELECT id FROM t1 WHERE 5 MEMBER OF (tags);

DROP TABLE t1;

--echo #
--echo # A row whose JSON value can't be indexed (not an array, or an array
--echo # with a non-scalar element -- see member_of_array_index.test) must
--echo # not leave InnoDB with a half-written row: the hlindex insert
--echo # (TABLE::hlindexes_on_insert(), called from handler::ha_write_row()
--echo # right after the base row write) fails only after the base row
--echo # write already succeeded, so on a non-transactional engine the row
--echo # can be left behind, unindexed; InnoDB is transactional, so the
--echo # whole statement must roll back instead
--echo #
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  tags JSON NOT NULL,
  INDEX arr_idx (CAST(tags AS UNSIGNED ARRAY))
) ENGINE=InnoDB;

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t2 VALUES (1, '{"a": 1}');

--echo # nothing committed, and the table is not actually damaged
SELECT * FROM t2;
CHECK TABLE t2;

--echo # same for a multi-row INSERT with one bad row: all-or-nothing
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t2 VALUES (1, '[1, 2]'), (2, '{"a": 1}'), (3, '[3, 4]');
SELECT * FROM t2;

--echo # the table must still be perfectly usable afterwards
INSERT INTO t2 VALUES (1, '[1, 2]');
SELECT id FROM t2 WHERE 1 MEMBER OF (tags);

DROP TABLE t2;

--echo # End of 13.3 tests
