--source include/have_innodb.inc

SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
  a INT NOT NULL PRIMARY KEY,
  payload VARBINARY(6000) NOT NULL
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
--sleep 1
--disable_query_log
let $i=1;
while ($i <= 7) {
  eval INSERT INTO t VALUES ($i,LPAD(CAST($i AS CHAR),2000,'x'));
  inc $i;
}
--enable_query_log
SELECT COUNT(*),SUM(LENGTH(payload)) FROM t;
BEGIN;
DELETE FROM t WHERE a=4;
INSERT INTO t VALUES (4,LPAD('4',6000,'y'));
COMMIT;
SELECT a,LENGTH(payload) FROM t WHERE a=4;
SELECT COUNT(*),SUM(LENGTH(payload)) FROM t;
CHECK TABLE t;
BEGIN;
DELETE FROM t WHERE a=6;
INSERT INTO t VALUES (6,LPAD('6',6000,'z'));
COMMIT;
SELECT a,LENGTH(payload) FROM t WHERE a=6;
SELECT COUNT(*),SUM(LENGTH(payload)) FROM t;
CHECK TABLE t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
