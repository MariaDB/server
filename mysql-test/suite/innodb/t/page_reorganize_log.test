--source include/have_innodb.inc
--source include/have_debug.inc
--source include/not_embedded.inc
--source include/have_sequence.inc

--echo #
--echo # MDEV-21725 Log page reorganization as ranges by which records moved
--echo #

--source ../include/no_checkpoint_start.inc

--echo # A record with no data bytes: its origin is PAGE_HEAP_TOP.
CREATE TABLE t1(a VARCHAR(10) PRIMARY KEY, b VARCHAR(10), KEY(b))
ENGINE=InnoDB STATS_PERSISTENT=0;
INSERT INTO t1 VALUES('','');

--echo # The keys are in the reverse order of the heap. add_up() evicts runs.
CREATE TABLE t2(a INT PRIMARY KEY, b VARCHAR(255))
ENGINE=InnoDB STATS_PERSISTENT=0;
INSERT INTO t2 VALUES
(12,REPEAT('l',70)),(11,REPEAT('k',10)),(10,REPEAT('j',90)),
(9,REPEAT('i',30)),(8,REPEAT('h',50)),(7,REPEAT('g',1)),
(6,REPEAT('f',40)),(5,REPEAT('e',2)),(4,REPEAT('d',60)),
(3,REPEAT('c',20)),(2,REPEAT('b',80)),(1,REPEAT('a',3));

--echo # The records of KEY(b) are shorter than MIN_MOVE.
CREATE TABLE t3(a TINYINT PRIMARY KEY, b TINYINT NOT NULL, KEY(b))
ENGINE=InnoDB STATS_PERSISTENT=0;
INSERT INTO t3 VALUES(5,5),(6,6),(7,7),(1,1),(2,2),(3,3),(4,4),(9,9),(8,8),
(10,10);

--echo # A gap after the first record: all other records move down by the
--echo # same distance. The old logging wrote them all with one WRITE.
CREATE TABLE t4(a INT PRIMARY KEY, b VARCHAR(255))
ENGINE=InnoDB STATS_PERSISTENT=0;
INSERT INTO t4 SELECT seq, REPEAT('x',200) FROM seq_1_to_250
WHERE seq <= @@innodb_page_size DIV 300;
UPDATE t4 SET b='' WHERE a=1;
--source ../include/wait_all_purged.inc

SET @save_dbug=@@debug_dbug;
SET debug_dbug='+d,do_page_reorganize,page_reorganize_log_max_up_2';
INSERT INTO t1 VALUES('x','x');
INSERT INTO t2 VALUES(13,'m');
INSERT INTO t3 VALUES(11,11);
SELECT variable_value INTO @lsn FROM information_schema.global_status
WHERE variable_name='innodb_lsn_current';
INSERT INTO t4 VALUES(0,'');
SELECT variable_value - @lsn < @@innodb_page_size DIV 4 AS small_redo
FROM information_schema.global_status
WHERE variable_name='innodb_lsn_current';
SET debug_dbug=@save_dbug;
--let CLEANUP_IF_CHECKPOINT=DROP TABLE t1,t2,t3,t4;
--source ../include/no_checkpoint_end.inc
--source include/start_mysqld.inc

CHECK TABLE t1,t2,t3,t4;
SELECT * FROM t1;
SELECT a, LENGTH(b), LEFT(b,1) FROM t2;
SELECT b, a FROM t3 FORCE INDEX(b);
SELECT COUNT(*) = @@innodb_page_size DIV 300 + 1 AS all_rows,
SUM(LENGTH(b)) = (@@innodb_page_size DIV 300 - 1) * 200 AS all_bytes FROM t4;
DROP TABLE t1,t2,t3,t4;

--echo # End of 11.8 tests
