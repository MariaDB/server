--source include/have_innodb.inc

#
# MDEV-11850: Can't create foreign key referencing a virtual column
#

create or replace table a (
  cola int(10) primary key,
  v_cola int(10) as (cola mod 10) virtual,
  p_cola int(10) as (cola mod 10) persistent
) engine=innodb;

create index v_cola on a (v_cola);
create index p_cola on a (p_cola);

create or replace table b(
cola int(10),
v_cola int(10),
p_cola int(10),
c_cola int(10) as (cola + 2) virtual
) engine=innodb;

alter table b add constraint `p_cola_fk`
foreign key (p_cola) references a (p_cola)
on delete restrict
on update restrict;

show warnings;
show create table b;

alter table b add constraint `v_cola_fk`
foreign key (v_cola) references a (v_cola)
on delete restrict
on update restrict;

show warnings;
show create table b;

alter table b add constraint `c_cola_fk`
foreign key (c_cola) references a (cola)
on delete restrict
on update restrict;

show warnings;
show create table b;

#
# Test that fk really works
#

insert into a(cola) values (12);
select * from a;
insert into b(cola, v_cola, p_cola) values (10,2,2);
select * from b;
--error 1452
insert into b(cola, v_cola, p_cola) values (10,1,1);
--error 1451
delete from a;
select * from a;
select * from b;
drop table b, a;

--echo #
--echo # MDEV-41666 Corruption on statement rollback when
--echo #    ON UPDATE SET NULL affects the base column
--echo #
CREATE TABLE t18 (
  c5 INT NOT NULL,
  PRIMARY KEY (c5)
) ENGINE=InnoDB;

CREATE TABLE t21 (
  c1 INT NOT NULL,
  c2 INT DEFAULT NULL,
  c2v INT AS (c2 DIV 1), c1v INT AS (FLOOR(c1)),
  KEY i15 (c2v, c1v),
  CONSTRAINT t21_ibfk_1 FOREIGN KEY (c2) REFERENCES t18 (c5) ON UPDATE SET NULL
) ENGINE=InnoDB;

INSERT INTO t18 (c5) VALUES (1), (2);
INSERT INTO t21 (c1, c2) VALUES (0, 1);

# This first changes 1 to 3 and cascades c2 = 1 to c2 = NULL.
# Updating the second parent row (2 to 3) then hits the duplicate
# primary key. The whole statement must roll back, including the
# functional-index update in t21.
--error ER_DUP_ENTRY
UPDATE t18 SET c5 = 3;
SELECT c5 FROM t18 ORDER BY c5;
SELECT c1, c2 FROM t21;
DROP TABLE t21, t18;

# index key parts when its effects are rolled back.
CREATE TABLE parent (
  id INT PRIMARY KEY
) ENGINE=InnoDB;

CREATE TABLE child (
  a INT DEFAULT NULL,
  parent_id INT DEFAULT NULL,
  av INT AS (IFNULL(a, 0)), pv INT AS (IFNULL(parent_id, 0)),
  KEY idx_functional (av, pv),
  CONSTRAINT fk_parent FOREIGN KEY (parent_id) REFERENCES parent (id)
    ON DELETE SET NULL
) ENGINE=InnoDB;

INSERT INTO parent VALUES (1);
INSERT INTO child(a, parent_id) VALUES (NULL, 1);

START TRANSACTION;
DELETE FROM parent WHERE id = 1;
ROLLBACK;

SELECT id FROM parent;
SELECT a, parent_id FROM child;
DROP TABLE child, parent;
