--source include/have_innodb.inc

SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
  pk INT NOT NULL PRIMARY KEY,
  b VARBINARY(2400) NOT NULL,
  KEY kb(b)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
--sleep 1
--disable_query_log
let $i=1;
while ($i <= 40) {
  eval INSERT INTO t VALUES ($i,LPAD(CAST($i AS CHAR),2400,'0'));
  let $rows=`SELECT COUNT(*) FROM t FORCE INDEX(kb) WHERE b >= ''`;
  if ($rows != $i) {
    --die secondary index row count mismatch
  }
  inc $i;
}
--enable_query_log
SELECT COUNT(*) FROM t FORCE INDEX(kb) WHERE b >= '';
SELECT COUNT(*) FROM t;
CHECK TABLE t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
