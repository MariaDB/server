--source include/have_innodb.inc
--source include/have_innodb_16k.inc

--echo #
--echo # MDEV-41942 CHECK TABLE ... EXTENDED validates field lengths
--echo #

--disable_query_log
call mtr.add_suppression("InnoDB: Summed data size .* returned by func .*");
call mtr.add_suppression("InnoDB: Apparent corruption in space .* page .* of index `PRIMARY` of table `test`\\.`t1`");
call mtr.add_suppression("InnoDB: In page .* of index `PRIMARY` of table `test`\\.`t1`");
call mtr.add_suppression("InnoDB: Field 3 len is .* should be 0; COMPACT RECORD.*");
--enable_query_log

let $datadir= `SELECT @@datadir`;

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(800) NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t1 VALUES (1, REPEAT('x', 200));
FLUSH TABLES t1 FOR EXPORT;
--copy_file $datadir/test/t1.ibd $MYSQL_TMP_DIR/t1.ibd
--copy_file $datadir/test/t1.cfg $MYSQL_TMP_DIR/t1.cfg
UNLOCK TABLES;
DROP TABLE t1;

perl;
use strict;
use Fcntl qw(:DEFAULT :seek);
do "$ENV{MTR_SUITE_DIR}/include/crc32.pl";
do "$ENV{MTR_SUITE_DIR}/include/innodb-util.pl";

my $file= "$ENV{MYSQL_TMP_DIR}/t1.ibd";
sysopen(FILE, $file, O_RDWR) or die "Cannot open $file: $!";
my $page_size= 16384;
my $full_crc32= get_full_crc32(\*FILE);
my $page_no= 3;
sysseek(FILE, $page_no * $page_size, SEEK_SET) or die;
my $page;
sysread(FILE, $page, $page_size) == $page_size or die;

# The one-row clustered record is at offset 127. Its VARCHAR length is
# encoded in the two bytes immediately before the record.
my $near_off= 121;
my $len= ((ord(substr($page, $near_off, 1)) << 8)
          | ord(substr($page, $near_off - 1, 1))) & 0x3fff;
die "unexpected VARCHAR length $len" unless $len == 200;

my $bogus= 16000;
substr($page, $near_off, 1)= chr(0x80 | (($bogus >> 8) & 0x3f));
substr($page, $near_off - 1, 1)= chr($bogus & 0xff);
$page= fix_page_crc($page, $full_crc32);
sysseek(FILE, $page_no * $page_size, SEEK_SET) or die;
syswrite(FILE, $page, $page_size) == $page_size or die;
close(FILE) or die;
EOF

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(800) NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
ALTER TABLE t1 DISCARD TABLESPACE;
--copy_file $MYSQL_TMP_DIR/t1.ibd $datadir/test/t1.ibd
--copy_file $MYSQL_TMP_DIR/t1.cfg $datadir/test/t1.cfg
ALTER TABLE t1 IMPORT TABLESPACE;
CHECK TABLE t1 EXTENDED;
DROP TABLE t1;
--remove_file $MYSQL_TMP_DIR/t1.ibd
--remove_file $MYSQL_TMP_DIR/t1.cfg

CREATE TABLE t1 (a INT PRIMARY KEY, b BLOB NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t1 VALUES (1, REPEAT('x', 20000));
FLUSH TABLES t1 FOR EXPORT;
--copy_file $datadir/test/t1.ibd $MYSQL_TMP_DIR/t1.ibd
--copy_file $datadir/test/t1.cfg $MYSQL_TMP_DIR/t1.cfg
UNLOCK TABLES;
DROP TABLE t1;

perl;
use strict;
use Fcntl qw(:DEFAULT :seek);
do "$ENV{MTR_SUITE_DIR}/include/crc32.pl";
do "$ENV{MTR_SUITE_DIR}/include/innodb-util.pl";

my $file= "$ENV{MYSQL_TMP_DIR}/t1.ibd";
sysopen(FILE, $file, O_RDWR) or die "Cannot open $file: $!";
my $page_size= 16384;
my $full_crc32= get_full_crc32(\*FILE);
my $page_no= 3;
sysseek(FILE, $page_no * $page_size, SEEK_SET) or die;
my $page;
sysread(FILE, $page, $page_size) == $page_size or die;

# The first record has the same fixed fields as above (INT, DB_TRX_ID and
# DB_ROLL_PTR). ROW_FORMAT=DYNAMIC stores this BLOB entirely off-page, so its
# 20-byte reference starts at record offset 127 + 4 + 6 + 7.
my $field_ref= 127 + 4 + 6 + 7;
my $external_len= unpack('N', substr($page, $field_ref + 16, 4));
die "unexpected external BLOB length $external_len"
  unless $external_len == 20000;

# Claim one byte fewer than the bytes stored in the BLOB pages.
substr($page, $field_ref + 16, 4)= pack('N', $external_len - 1);
$page= fix_page_crc($page, $full_crc32);
sysseek(FILE, $page_no * $page_size, SEEK_SET) or die;
syswrite(FILE, $page, $page_size) == $page_size or die;
close(FILE) or die;
EOF

CREATE TABLE t1 (a INT PRIMARY KEY, b BLOB NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
ALTER TABLE t1 DISCARD TABLESPACE;
--copy_file $MYSQL_TMP_DIR/t1.ibd $datadir/test/t1.ibd
--copy_file $MYSQL_TMP_DIR/t1.cfg $datadir/test/t1.cfg
ALTER TABLE t1 IMPORT TABLESPACE;
CHECK TABLE t1 EXTENDED;
DROP TABLE t1;
--remove_file $MYSQL_TMP_DIR/t1.ibd
--remove_file $MYSQL_TMP_DIR/t1.cfg
