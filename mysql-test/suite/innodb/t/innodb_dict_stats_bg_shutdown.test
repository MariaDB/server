--source include/have_innodb.inc
--source include/have_debug.inc
--source include/not_embedded.inc

--echo #
--echo # InnoDB dict_stats background THD lifecycle (MDEV-38891)
--echo #

# Hold dict_stats_func on a pool thread while mysqld shuts down.  Without
# the fix the callback lazily created a THD after plugin teardown.
SET GLOBAL debug_dbug="+d,mdev_38891_sleep_in_bg_thread";

CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB
STATS_PERSISTENT=1 STATS_AUTO_RECALC=1;
INSERT INTO t1 VALUES (1),(2),(3);

--source include/restart_mysqld.inc

DROP TABLE t1;

--echo #
--echo # Disable auto recalc when the background THD cannot be created
--echo #

call mtr.add_suppression("Failed to create background THD for statistics");

--let $restart_parameters= --debug=d,mdev_38891_fail_stats_thd
--source include/restart_mysqld.inc

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= Failed to create background THD for statistics. Automatic statistics recalculation will be disabled;
--source include/search_pattern_in_file.inc
