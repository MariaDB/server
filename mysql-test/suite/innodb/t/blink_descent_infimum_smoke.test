--source include/have_innodb.inc

SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
  a VARBINARY(2000) NOT NULL PRIMARY KEY,
  b INT NOT NULL
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
--sleep 1
--disable_query_log
let $i=1;
while ($i <= 200) {
  eval INSERT INTO t VALUES (LPAD(CAST($i AS CHAR),2000,'0'),$i);
  inc $i;
}
--disable_result_log
let $i=1;
while ($i <= 200) {
  eval SELECT b FROM t WHERE a=LPAD(CAST($i AS CHAR),2000,'0');
  inc $i;
}
--enable_result_log
--enable_query_log
SELECT COUNT(*),SUM(b) FROM t;
SELECT COUNT(*),MIN(b),MAX(b) FROM t
WHERE a >= LPAD(CAST(50 AS CHAR),2000,'0')
  AND a <= LPAD(CAST(150 AS CHAR),2000,'0');
CHECK TABLE t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
