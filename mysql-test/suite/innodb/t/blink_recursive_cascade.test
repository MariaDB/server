--source include/have_innodb.inc

SET GLOBAL innodb_blink_enabled=ON;
SET max_recursive_iterations=4000;
CREATE TABLE t(a BIGINT PRIMARY KEY, payload VARBINARY(2500)) ENGINE=InnoDB;
--sleep 1
INSERT INTO t
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 3000)
SELECT n, REPEAT(CHAR(65 + n % 20),2500) FROM cte;
SELECT COUNT(*), MIN(a), MAX(a) FROM t;
SELECT VARIABLE_NAME, VARIABLE_VALUE > 0 AS POSITIVE
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME IN ('INNODB_BLINK_LEAF_SPLITS',
                        'INNODB_BLINK_PARENT_INSTALLS',
                        'INNODB_BLINK_ROOT_RAISES')
ORDER BY VARIABLE_NAME;
CHECK TABLE t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=DEFAULT;
