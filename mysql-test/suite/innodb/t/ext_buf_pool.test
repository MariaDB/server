#--disable_query_log
#SET GLOBAL DEBUG_DBUG=@old_debug_dbug;
#--error 0,ER_UNKNOWN_SYSTEM_VARIABLE
#SET GLOBAL innodb_limit_optimistic_insert_debug = @old_innodb_limit_optimistic_insert_debug;
#--enable_query_log

