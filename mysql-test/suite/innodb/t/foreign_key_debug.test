--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--enable_connect_log

#
# MDEV-16465 Invalid (old?) table or database name or hang in ha_innobase::delete_table and log semaphore wait upon concurrent DDL with foreign keys
#
create table t1 (f1 int primary key) engine=innodb;
create table t2 (f2 int primary key) engine=innodb;
create table t3 (f3 int primary key, foreign key (f3) references t2(f2)) engine=innodb;
insert into t1 values (1),(2),(3),(4),(5);
insert into t2 values (1),(2),(3),(4),(5);
insert into t3 values (1),(2),(3),(4),(5);
connect con1,localhost,root;
set debug_sync='alter_table_before_rename_result_table signal g1 wait_for g2';
send alter table t2 add constraint foreign key (f2) references t1(f1) on delete cascade on update cascade;
connection default;
let $conn=`select connection_id()`;
set debug_sync='before_execute_sql_command wait_for g1';
send update t1 set f1 = f1 + 100000 limit 2;
connect con2,localhost,root;
let $wait_condition= select 1 from information_schema.processlist where state='Waiting for table metadata lock' and info like 'update t1 %';
source include/wait_condition.inc;
--replace_result $conn UPDATE
eval kill query $conn;
disconnect con2;
connection default;
error ER_QUERY_INTERRUPTED;
reap;
set debug_sync='now signal g2';
connection con1;
reap;
show create table t2;
disconnect con1;
connection default;
select * from t2 where f2 not in (select f1 from t1);
select * from t3 where f3 not in (select f2 from t2);
drop table t3;
drop table t2;
drop table t1;
set debug_sync='reset';

--echo #
--echo # MDEV-16060 - InnoDB: Failing assertion: ut_strcmp(index->name, key->name)
--echo #
CREATE TABLE t1 (`pk` INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t2 LIKE t1;
FLUSH TABLES;

SET debug_sync='alter_table_intermediate_table_created SIGNAL ready WAIT_FOR go';
send ALTER TABLE t1 ADD FOREIGN KEY(pk) REFERENCES t2(pk) ON UPDATE CASCADE;

connect con1, localhost, root;
SET debug_sync='now WAIT_FOR ready';
SET lock_wait_timeout=0;
--error ER_LOCK_WAIT_TIMEOUT
UPDATE t2 SET pk=10 WHERE pk=1;
PREPARE stmt FROM 'UPDATE t2 SET pk=10 WHERE pk=1';
DEALLOCATE PREPARE stmt;
SET debug_sync='now SIGNAL go';

connection default;
reap;

# Cleanup
disconnect con1;

connection default;
SET debug_sync='reset';
SHOW OPEN TABLES FROM test;
DROP TABLE t1, t2;

#
# End of 10.1 tests
#

--echo #
--echo # MDEV-41434 Missing DBUG_RETURN on error exits of
--echo # DML_prelocking_strategy::handle_table() and prepare_fk_prelocking_list()
--echo #
--echo # A failure to read the foreign keys that reference a table fails
--echo # the statement that modifies the table
--echo #
CREATE TABLE p (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE c1 (a INT, FOREIGN KEY (a) REFERENCES p(a)
                 ON DELETE CASCADE ON UPDATE CASCADE) ENGINE=InnoDB;
CREATE TABLE c2 (a INT, FOREIGN KEY (a) REFERENCES p(a)) ENGINE=InnoDB;
CREATE TABLE t_log (a INT, b INT) ENGINE=InnoDB;
CREATE TRIGGER p_bu BEFORE UPDATE ON p FOR EACH ROW
  INSERT INTO t_log VALUES (OLD.a, NEW.b);
INSERT INTO p VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO c1 VALUES (1), (2);
INSERT INTO c2 VALUES (2), (3);
CREATE PROCEDURE p_upd(x INT) UPDATE p SET b = x WHERE a = 2;
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--eval SELECT a + 5, b * 3 INTO OUTFILE '$MYSQLTEST_VARDIR/tmp/fk_list_fail.txt' FROM p WHERE a < 3

SET @save_dbug= @@debug_dbug;
SET debug_dbug= '+d,fk_list_fail';
--error ER_OUT_OF_RESOURCES
DELETE FROM p WHERE a = 1;
--error ER_OUT_OF_RESOURCES
UPDATE p SET b = b + 1;
--error ER_OUT_OF_RESOURCES
INSERT INTO p VALUES (4, 40);
--error ER_OUT_OF_RESOURCES
INSERT INTO p VALUES (2, 21) ON DUPLICATE KEY UPDATE b = 21;
--error ER_OUT_OF_RESOURCES
REPLACE INTO p VALUES (5, 50);
--error ER_OUT_OF_RESOURCES
DELETE p FROM p JOIN c2 ON p.a = c2.a;
--error ER_OUT_OF_RESOURCES
UPDATE p JOIN c2 ON p.a = c2.a SET p.b = 0;
--error ER_OUT_OF_RESOURCES
INSERT INTO p SELECT a + 10, b FROM p;
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--error ER_OUT_OF_RESOURCES
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/tmp/fk_list_fail.txt' INTO TABLE p
--error ER_OUT_OF_RESOURCES
LOCK TABLES p WRITE;
UNLOCK TABLES;
--error ER_OUT_OF_RESOURCES
PREPARE s FROM 'UPDATE p SET b = ? WHERE a = 2';
--echo # The list is read on the statement arena of a stored procedure
--error ER_OUT_OF_RESOURCES
CALL p_upd(21);
SET debug_dbug= @save_dbug;

--echo # Nothing was modified by the failed statements
SELECT * FROM p ORDER BY a;
SELECT * FROM c1 ORDER BY a;
SELECT * FROM c2 ORDER BY a;
SELECT * FROM t_log ORDER BY a;

--echo # Statements that modify the table succeed once the failure is gone
CALL p_upd(22);
PREPARE s FROM 'UPDATE p SET b = ? WHERE a = 3';
EXECUTE s USING 33;
DEALLOCATE PREPARE s;
DELETE FROM p WHERE a = 1;
UPDATE p SET b = b + 1 WHERE a = 3;
INSERT INTO p VALUES (4, 40);
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/tmp/fk_list_fail.txt' INTO TABLE p
--remove_file $MYSQLTEST_VARDIR/tmp/fk_list_fail.txt
SELECT * FROM p ORDER BY a;
SELECT * FROM c1 ORDER BY a;
SELECT * FROM c2 ORDER BY a;
SELECT * FROM t_log ORDER BY a;
DROP PROCEDURE p_upd;
DROP TABLE t_log, c2, c1, p;

--echo #
--echo # MDEV-41538 A stored procedure statement whose foreign key prelocking
--echo # failed once never locks the referencing tables again
--echo #
--echo # A stored procedure statement whose foreign key prelocking failed
--echo # locks the referencing tables on its next execution
--echo #
CREATE TABLE p (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE c1 (a INT, FOREIGN KEY (a) REFERENCES p(a)
                 ON UPDATE CASCADE) ENGINE=InnoDB;
CREATE TABLE c2 (a INT, FOREIGN KEY (a) REFERENCES p(a)) ENGINE=InnoDB;
CREATE TABLE t_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER p_bu BEFORE UPDATE ON p FOR EACH ROW
  INSERT INTO t_log VALUES (OLD.a);
INSERT INTO p VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO c1 VALUES (1), (2);
INSERT INTO c2 VALUES (1), (3);
--echo # Updating a column that no foreign key uses keeps InnoDB from
--echo # locking the referencing tables on its own
CREATE PROCEDURE p_upd(x INT) UPDATE p SET b = b + 1 WHERE a = x;

SET debug_dbug= '+d,fk_list_fail';
--error ER_OUT_OF_RESOURCES
CALL p_upd(2);
SET debug_dbug= @save_dbug;

BEGIN;
CALL p_upd(2);
connect con1, localhost, root;
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE c1 NOWAIT COMMENT 'c1';
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE c2 NOWAIT COMMENT 'c2';
--error ER_LOCK_WAIT_TIMEOUT
ALTER TABLE t_log NOWAIT COMMENT 't_log';
connection default;
COMMIT;
SELECT * FROM p ORDER BY a;
SELECT * FROM c1 ORDER BY a;
SELECT * FROM c2 ORDER BY a;
SELECT * FROM t_log ORDER BY a;

--echo # The locks are released at the end of the transaction
connection con1;
ALTER TABLE c1 NOWAIT COMMENT 'c1';
ALTER TABLE c2 NOWAIT COMMENT 'c2';
disconnect con1;
connection default;
DROP PROCEDURE p_upd;
DROP TABLE t_log, c2, c1, p;

--echo #
--echo # End of 10.11 tests
--echo #
