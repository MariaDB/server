--source include/have_innodb.inc

SET GLOBAL innodb_blink_enabled=OFF;
SELECT @@global.innodb_blink_enabled;

CREATE TABLE t_off(a INT PRIMARY KEY, b INT, KEY(b)) ENGINE=InnoDB;
SELECT i.NAME, i.TYPE
FROM INFORMATION_SCHEMA.INNODB_SYS_INDEXES i
JOIN INFORMATION_SCHEMA.INNODB_SYS_TABLES t USING(TABLE_ID)
WHERE t.NAME='test/t_off'
ORDER BY i.NAME;

SET GLOBAL innodb_blink_enabled=ON;
SELECT @@global.innodb_blink_enabled;

CREATE TABLE t_on(a INT PRIMARY KEY, b INT, KEY(b), UNIQUE KEY u(b))
ENGINE=InnoDB;
CREATE TABLE t_generated(a INT, KEY(a)) ENGINE=InnoDB;
CREATE TABLE t_compressed(a INT PRIMARY KEY) ENGINE=InnoDB
ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8;
CREATE TABLE t_fts(a INT PRIMARY KEY, b TEXT, FULLTEXT KEY f(b)) ENGINE=InnoDB;

SELECT t.NAME AS TABLE_NAME, i.NAME AS INDEX_NAME, i.TYPE
FROM INFORMATION_SCHEMA.INNODB_SYS_INDEXES i
JOIN INFORMATION_SCHEMA.INNODB_SYS_TABLES t USING(TABLE_ID)
WHERE t.NAME IN ('test/t_on', 'test/t_generated', 'test/t_compressed',
                 'test/t_fts')
ORDER BY t.NAME, i.NAME;

SET GLOBAL innodb_blink_enabled=OFF;
CREATE TABLE t_alter(a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t_multi(a INT PRIMARY KEY, b VARBINARY(500)) ENGINE=InnoDB;
INSERT INTO t_multi
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 1000)
SELECT n, REPEAT('x', 500) FROM cte;
SET GLOBAL innodb_blink_enabled=ON;
ALTER TABLE t_alter ADD INDEX i(b), ALGORITHM=INPLACE;
ALTER TABLE t_multi ADD INDEX i(b), ALGORITHM=INPLACE;
SELECT t.NAME AS TABLE_NAME, i.NAME AS INDEX_NAME, i.TYPE
FROM INFORMATION_SCHEMA.INNODB_SYS_INDEXES i
JOIN INFORMATION_SCHEMA.INNODB_SYS_TABLES t USING(TABLE_ID)
WHERE t.NAME IN ('test/t_alter', 'test/t_multi')
ORDER BY t.NAME, i.NAME;

SET GLOBAL innodb_blink_enabled=OFF;
FLUSH TABLES;

SELECT t.NAME AS TABLE_NAME, i.NAME AS INDEX_NAME, i.TYPE
FROM INFORMATION_SCHEMA.INNODB_SYS_INDEXES i
JOIN INFORMATION_SCHEMA.INNODB_SYS_TABLES t USING(TABLE_ID)
WHERE t.NAME IN ('test/t_on', 'test/t_generated', 'test/t_alter', 'test/t_multi')
ORDER BY t.NAME, i.NAME;

DROP TABLE t_off, t_on, t_generated, t_compressed, t_fts, t_alter, t_multi;
SET GLOBAL innodb_blink_enabled=DEFAULT;
