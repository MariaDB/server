--source include/have_innodb.inc
--source include/have_debug.inc

SET @blink_save=@@global.innodb_blink_enabled;
SET @debug_save=@@debug_dbug;
SET @leaf_low=@@global.innodb_blink_leaf_pool_low;
SET @leaf_high=@@global.innodb_blink_leaf_pool_high;
SET @internal_low=@@global.innodb_blink_internal_pool_low;
SET @internal_high=@@global.innodb_blink_internal_pool_high;
SET GLOBAL innodb_blink_leaf_pool_low=16;
SET GLOBAL innodb_blink_leaf_pool_high=64;
SET GLOBAL innodb_blink_internal_pool_low=8;
SET GLOBAL innodb_blink_internal_pool_high=32;
SET GLOBAL innodb_blink_enabled=ON;
SET DEBUG_DBUG='+d,blink_alloc_hold_index_lock';
CREATE TABLE t (
  id INT NOT NULL PRIMARY KEY,
  a VARCHAR(64),
  KEY ka(a)
) ENGINE=InnoDB;
SET DEBUG_DBUG=@debug_save;
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=B-link allocator test lock hold
--let SEARCH_WAIT=FOUND
--let SEARCH_TIMEOUT=10
--disable_result_log
--source include/search_pattern_in_file.inc
--enable_result_log
ALTER TABLE t DROP INDEX ka,ALGORITHM=COPY;
INSERT INTO t VALUES (1,'a'),(2,'b'),(3,'c');
SELECT COUNT(*),SUM(id) FROM t;
CHECK TABLE t;
DROP TABLE t;
CREATE TABLE t (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t VALUES (1),(2),(3);
SELECT COUNT(*),SUM(id) FROM t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
SET GLOBAL innodb_blink_leaf_pool_low=@leaf_low;
SET GLOBAL innodb_blink_leaf_pool_high=@leaf_high;
SET GLOBAL innodb_blink_internal_pool_low=@internal_low;
SET GLOBAL innodb_blink_internal_pool_high=@internal_high;
