#
# MDEV-32286 ANALYZE displays a huge number of InnoDB secondary index pages_accessed
#
# A clustered lookup that a hint answers may step from the expected record
# to the record before it. page_cur_search_near() refuses that step when the
# record before is the page infimum or the metadata pseudo-record. A lookup
# reaches either only for a key that is not in the clustered index while
# row_sel_clust_leaf_hint_covers() still accepts the slot, and these are the
# constraints that leave one shape for that:
#
# - The key must leave the clustered index under a reader that has a
#   secondary index entry for it to look up. Purge removes the entry together
#   with the record, so the record must be removed by the rollback of an
#   insert over a delete-marked record, which removes it when
#   row_undo_mod_must_purge() holds, while purge is not let to remove the
#   delete-marked secondary index entry.
# - The reader must look that entry up and not skip it, so the secondary
#   index page must carry a PAGE_MAX_TRX_ID that its read view does not see.
#   The insert gives the row a new secondary key next to the old one, which
#   puts it on the same page.
# - The key must be the first user record of its leaf, so that the step back
#   lands on the infimum, or the first key of the leftmost leaf, where it
#   lands on the metadata pseudo-record.
#
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_sequence.inc
# The notes below are read from the error log, and an embedded server writes
# its stderr to the log of mariadb-test instead of that file.
--source include/not_embedded.inc
--source include/count_sessions.inc

# The hints are collected and tested only while the adaptive hash index is
# off, so a run with it on would reach none of this. Kept out of the .result,
# so that a build without the adaptive hash index records the same result.
--disable_query_log
let $adaptive_hash_index= `select count(*) from information_schema.global_variables
                           where variable_name = 'innodb_adaptive_hash_index'`;
if ($adaptive_hash_index)
{
  set @save_adaptive_hash_index= @@global.innodb_adaptive_hash_index;
  set global innodb_adaptive_hash_index= 0;
}
--enable_query_log

# k sorts in the inverse order of pk, so a scan of k_idx walks the clustered
# index backward. MERGE_THRESHOLD=1 keeps the removals below from merging a
# leaf into its neighbour, which would move the keys away from the start of
# their leaves.
create table t1 (
  pk int not null primary key,
  k int,
  val text,
  key k_idx(k)
) engine=innodb row_format=dynamic stats_persistent=0 comment='MERGE_THRESHOLD=1';

# An ascending load with this limit puts pk 4951 first on its leaf.
set @save_limit= @@global.innodb_limit_optimistic_insert_debug;
set global innodb_limit_optimistic_insert_debug= 100;
insert into t1 select seq, 2*(20001-seq), 'v' from seq_1_to_10000;
set global innodb_limit_optimistic_insert_debug= @save_limit;
# This adds the metadata pseudo-record before pk 1.
alter table t1 add column extra int, algorithm=instant;

set global innodb_max_purge_lag_wait=0;
# From here on, purge advances its view and removes nothing.
set @save_view_update= @@global.innodb_trx_purge_view_update_only_debug;
set global innodb_trx_purge_view_update_only_debug= 1;

delete from t1 where pk in (1, 4951);

connect (ins,localhost,root);
begin;
# Each insert goes over a delete-marked record. The new key differs from the
# old one, so the secondary index entry of the delete stays in place,
# delete-marked.
insert into t1 (pk, k, val) values (1, 2*(20001-1)+1, 'w'), (4951, 2*(20001-4951)+1, 'w');

connection default;
# The purge view now includes the delete, so row_undo_mod_must_purge() holds
# and the rollback below removes the clustered index records.
set statement max_statement_time=1 for set global innodb_max_purge_lag_wait=0;

delimiter |;
create function hold(x int) returns int
begin
  if x = 4956 then
    set debug_sync= 'now SIGNAL reader_paused';
    set debug_sync= 'now WAIT_FOR reader_go';
  end if;
  return 1;
end|
delimiter ;|

connect (reader,localhost,root);
# Without this the condition would be evaluated inside the engine, before the
# clustered lookup of the row it stops on rather than after it.
set session optimizer_switch='index_condition_pushdown=off';
set session debug_dbug='+d,ib_log_clust_leaf_hint_step_back';
# val is outside k_idx, so every row costs a clustered lookup, and its type
# turns the prefetch cache off.
--send select count(left(val,1)) as n, sum(pk) as s from t1 force index(k_idx) where k > 0 and hold(pk)

connection default;
set debug_sync='now WAIT_FOR reader_paused';

connection ins;
# This changes the modify clock of the leaf of pk 4951, which the reader has
# remembered already. The first lookup on it after that is a binary search,
# the second is one too and arms the step again, and the reader is stopped far
# enough above pk 4951 for both to come before it. The reader remembers the
# leaf of pk 1 only after this, so the change does not reach it.
rollback;

connection default;
set debug_sync='now SIGNAL reader_go';

connection reader;
# pk 1 and pk 4951 are deleted for the reader. Their secondary index entries
# are delete-marked, so the lookups that find no record skip them.
--reap

connection default;
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN = Clustered leaf hint step back reached the [a-z ]+
--let SEARCH_OUTPUT = matches
--source include/search_pattern_in_file.inc

disconnect reader;
disconnect ins;
set global innodb_trx_purge_view_update_only_debug= @save_view_update;
drop function hold;
drop table t1;
set debug_sync='reset';
--disable_query_log
if ($adaptive_hash_index)
{
  set global innodb_adaptive_hash_index= @save_adaptive_hash_index;
}
--enable_query_log
--source include/wait_until_count_sessions.inc
