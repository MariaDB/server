SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t(a INT PRIMARY KEY, payload VARBINARY(700)) ENGINE=InnoDB;
INSERT INTO t
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 1000)
SELECT n, REPEAT('x',700) FROM cte;
DELETE FROM t WHERE a <= 900;
SELECT COUNT(*), MIN(a), MAX(a) FROM t;
COUNT(*)	MIN(a)	MAX(a)
100	901	1000
SELECT a FROM t ORDER BY a LIMIT 3;
a
901
902
903
SELECT a FROM t ORDER BY a DESC LIMIT 3;
a
1000
999
998
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=DEFAULT;
