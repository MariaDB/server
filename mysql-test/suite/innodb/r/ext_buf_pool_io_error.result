ebp_reads
0
SELECT @@GLOBAL.innodb_extended_buffer_pool_size;
@@GLOBAL.innodb_extended_buffer_pool_size
4194304
# It cannot be enabled again
SET GLOBAL innodb_extended_buffer_pool_size = 4194304;
ERROR 42000: Variable 'innodb_extended_buffer_pool_size' can't be set to the value of '4194304'
SHOW WARNINGS;
Level	Code	Message
Warning	1210	The extended buffer pool was disabled because of an error, and it cannot be enabled again
Error	1231	Variable 'innodb_extended_buffer_pool_size' can't be set to the value of '4194304'
SET GLOBAL innodb_extended_buffer_pool_size = 0;
SET GLOBAL innodb_extended_buffer_pool_size = 4194304;
ERROR 42000: Variable 'innodb_extended_buffer_pool_size' can't be set to the value of '4194304'
SELECT @@GLOBAL.innodb_extended_buffer_pool_size;
@@GLOBAL.innodb_extended_buffer_pool_size
0
