#
# MDEV-42037 Assertion failure bpage->oldest_modification()
# when ALTER TABLE … DISCARD TABLESPACE races with the
# page cleaner
#
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1),(2),(3);
SET @save_dbug= @@GLOBAL.debug_dbug;
SET GLOBAL debug_dbug= '+d,ib_flush_discarded_space_wait';
connect  con1,localhost,root;
SET DEBUG_SYNC= 'ib_discard_before_remove_pages SIGNAL discarded WAIT_FOR go';
ALTER TABLE t1 DISCARD TABLESPACE;
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR discarded';
connect  con2,localhost,root;
SET GLOBAL innodb_log_checkpoint_now= ON;
connection default;
SET DEBUG_SYNC= 'now SIGNAL go';
connection con1;
disconnect con1;
connection con2;
disconnect con2;
connection default;
SET GLOBAL debug_dbug= @save_dbug;
SET DEBUG_SYNC= 'RESET';
DROP TABLE t1;
# End of 10.11 tests
