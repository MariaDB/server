SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
id VARBINARY(2500) NOT NULL PRIMARY KEY,
b INT NOT NULL
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
SELECT COUNT(*),SUM(b) FROM t;
COUNT(*)	SUM(b)
200	20100
SELECT b FROM t WHERE id=LPAD(CAST(1 AS CHAR),2500,'0');
b
1
SELECT b FROM t WHERE id=LPAD(CAST(50 AS CHAR),2500,'0');
b
50
SELECT b FROM t WHERE id=LPAD(CAST(125 AS CHAR),2500,'0');
b
125
SELECT b FROM t WHERE id=LPAD(CAST(200 AS CHAR),2500,'0');
b
200
SELECT COUNT(*),MIN(b),MAX(b) FROM t
WHERE id >= LPAD(CAST(40 AS CHAR),2500,'0')
AND id <= LPAD(CAST(160 AS CHAR),2500,'0');
COUNT(*)	MIN(b)	MAX(b)
121	40	160
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
