SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
id INT PRIMARY KEY,
k INT,
pad VARCHAR(8000),
KEY k_1(k)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC CHARSET=latin1;
SELECT COUNT(*),SUM(LENGTH(pad)) FROM t;
COUNT(*)	SUM(LENGTH(pad))
400	48000
UPDATE t SET pad=REPEAT('b',6500) WHERE id % 3=0;
SELECT COUNT(*),SUM(LENGTH(pad)) FROM t;
COUNT(*)	SUM(LENGTH(pad))
400	896540
SELECT COUNT(*) FROM t WHERE pad LIKE 'b%';
COUNT(*)
133
SELECT COUNT(*) FROM t FORCE INDEX(k_1) WHERE k BETWEEN 0 AND 100;
COUNT(*)
400
BEGIN;
UPDATE t SET pad=REPEAT('c',6500) WHERE id % 3=1;
ROLLBACK;
SELECT COUNT(*) FROM t WHERE pad LIKE 'c%';
COUNT(*)
0
SELECT COUNT(*),SUM(LENGTH(pad)) FROM t;
COUNT(*)	SUM(LENGTH(pad))
400	896540
BEGIN;
UPDATE t SET k=k + 1000,pad=REPEAT('d',6500) WHERE id % 5=0;
ROLLBACK;
SELECT COUNT(*) FROM t FORCE INDEX(k_1) WHERE k >= 1000;
COUNT(*)
0
SELECT COUNT(*),SUM(LENGTH(pad)) FROM t;
COUNT(*)	SUM(LENGTH(pad))
400	896540
UPDATE t SET pad=REPEAT('e',60) WHERE id % 3=0;
SELECT COUNT(*),SUM(LENGTH(pad)) FROM t;
COUNT(*)	SUM(LENGTH(pad))
400	40020
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
