SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
a VARBINARY(2000) NOT NULL PRIMARY KEY,
b INT NOT NULL
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
SELECT COUNT(*),SUM(b) FROM t;
COUNT(*)	SUM(b)
200	20100
SELECT COUNT(*),MIN(b),MAX(b) FROM t
WHERE a >= LPAD(CAST(50 AS CHAR),2000,'0')
AND a <= LPAD(CAST(150 AS CHAR),2000,'0');
COUNT(*)	MIN(b)	MAX(b)
101	50	150
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
