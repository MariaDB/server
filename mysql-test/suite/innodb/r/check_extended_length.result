#
# MDEV-41942 CHECK TABLE ... EXTENDED validates field lengths
#
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(800) NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t1 VALUES (1, REPEAT('x', 200));
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(800) NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
ALTER TABLE t1 DISCARD TABLESPACE;
ALTER TABLE t1 IMPORT TABLESPACE;
CHECK TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	check	Warning	InnoDB: The B-tree of index PRIMARY is corrupted.
test.t1	check	error	Corrupt
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY, b BLOB NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t1 VALUES (1, REPEAT('x', 20000));
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t1;
CREATE TABLE t1 (a INT PRIMARY KEY, b BLOB NOT NULL)
ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
ALTER TABLE t1 DISCARD TABLESPACE;
ALTER TABLE t1 IMPORT TABLESPACE;
CHECK TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	check	Warning	InnoDB: The B-tree of index PRIMARY is corrupted.
test.t1	check	error	Corrupt
DROP TABLE t1;
