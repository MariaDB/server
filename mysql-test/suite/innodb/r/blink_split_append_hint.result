SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t(a BIGINT PRIMARY KEY, payload VARBINARY(2500)) ENGINE=InnoDB;
INSERT INTO t
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 200)
SELECT n * 1000000, REPEAT('x',2500) FROM cte;
SET @splits_before=(SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME='INNODB_BLINK_LEAF_SPLITS');
INSERT INTO t
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 32)
SELECT n * 6000000 + 500000, REPEAT('y',2500) FROM cte;
SELECT (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME='INNODB_BLINK_LEAF_SPLITS') > @splits_before
AS measured_splits;
measured_splits
1
SELECT COUNT(*) FROM t;
COUNT(*)
232
CHECK TABLE t;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=DEFAULT;
