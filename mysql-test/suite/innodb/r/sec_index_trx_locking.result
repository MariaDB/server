#
# MDEV-17598: implicit locks, consistent reads and purge on a secondary
# index whose records end with DB_TRX_ID, on an "orders" table.
#
SET GLOBAL innodb_sec_index_trx_id_debug=ON;
CREATE TABLE orders (
id INT PRIMARY KEY,
customer INT NOT NULL,
status VARCHAR(10) NOT NULL,
amount INT NOT NULL,
KEY(customer)
) ENGINE=InnoDB;
CREATE TABLE events (
id INT PRIMARY KEY,
a INT NOT NULL,
b INT NOT NULL,
total INT AS (a+b) VIRTUAL,
KEY(total)
) ENGINE=InnoDB;
SET GLOBAL innodb_sec_index_trx_id_debug=OFF;
# Both secondary indexes have the new format (TYPE bit 4)
SELECT t.NAME, i.NAME, (i.TYPE & 4) AS new_format
FROM information_schema.INNODB_SYS_INDEXES i
JOIN information_schema.INNODB_SYS_TABLES t USING (TABLE_ID)
WHERE t.NAME IN ('test/orders','test/events') AND i.NAME IN ('customer','total')
ORDER BY t.NAME;
NAME	NAME	new_format
test/events	total	4
test/orders	customer	4
INSERT INTO orders SELECT seq, seq%5, 'new', seq FROM seq_1_to_100;
connect  con1,localhost,root,,;
connect  con2,localhost,root,,;
#
# 1. Locks: a transaction moves order 7 from customer 2 to customer 9
#
connection con1;
BEGIN;
UPDATE orders SET customer=9 WHERE id=7;
connection con2;
SET SESSION innodb_lock_wait_timeout=1;
# (9,7) was inserted by con1 and is locked only implicitly
SELECT id FROM orders WHERE customer=9 FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# (2,7) was delete-marked by con1
SELECT id FROM orders WHERE customer=2 FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# Other orders are not locked
SELECT id FROM orders WHERE customer=3 AND id<=8 FOR UPDATE;
id
3
8
SET SESSION innodb_lock_wait_timeout=50;
# The waiter gets the lock when the holder commits
SELECT id FROM orders WHERE customer=9 FOR UPDATE;
connection default;
connection con1;
COMMIT;
connection con2;
id
7
# ... and when the holder rolls back
connection con1;
BEGIN;
UPDATE orders SET customer=8 WHERE id=12;
connection con2;
SELECT id FROM orders WHERE customer=8 FOR UPDATE;
connection default;
connection con1;
ROLLBACK;
connection con2;
id
SELECT COUNT(*) AS customer2_orders FROM orders FORCE INDEX(customer)
WHERE customer=2;
customer2_orders
19
#
# 2. Consistent reads: a report runs while orders change
#
connection con1;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT customer, COUNT(*) FROM orders FORCE INDEX(customer)
GROUP BY customer ORDER BY customer;
customer	COUNT(*)
0	20
1	20
2	19
3	20
4	20
9	1
connection default;
# customer 4 -> 0 (10 orders), customer 1 loses 10 orders, 2 new orders
# for customer 5, and a change of a column that is not in the index
UPDATE orders SET customer=0 WHERE customer=4 AND id<=50;
DELETE FROM orders WHERE customer=1 AND id>50;
INSERT INTO orders VALUES (101,5,'new',101), (102,5,'new',102);
UPDATE orders SET status='paid' WHERE customer=3;
connection con1;
# The report still sees the old orders
SELECT customer, COUNT(*) FROM orders FORCE INDEX(customer)
GROUP BY customer ORDER BY customer;
customer	COUNT(*)
0	20
1	20
2	19
3	20
4	20
9	1
SELECT SUM(amount) FROM orders FORCE INDEX(customer) WHERE customer=4;
SUM(amount)
1030
SELECT COUNT(*) FROM orders FORCE INDEX(customer)
WHERE customer=3 AND status='new';
COUNT(*)
20
COMMIT;
# A new transaction sees the changes
SELECT customer, COUNT(*) FROM orders FORCE INDEX(customer)
GROUP BY customer ORDER BY customer;
customer	COUNT(*)
0	30
1	10
2	19
3	20
4	10
5	2
9	1
SELECT COUNT(*) FROM orders FORCE INDEX(customer)
WHERE customer=3 AND status='paid';
COUNT(*)
20
#
# 3. Purge
#
DELETE FROM orders WHERE customer IN (1,5);
InnoDB		0 transactions not purged
CHECK TABLE orders EXTENDED;
Table	Op	Msg_type	Msg_text
test.orders	check	status	OK
SELECT COUNT(*) FROM orders;
COUNT(*)
80
# An old read view keeps the deleted orders of customer 4 alive
connection con1;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
connection default;
DELETE FROM orders WHERE customer=4;
connection con1;
SELECT COUNT(*) AS customer4_in_old_view FROM orders FORCE INDEX(customer)
WHERE customer=4;
customer4_in_old_view
10
COMMIT;
connection default;
InnoDB		0 transactions not purged
SELECT COUNT(*) AS customer4_now FROM orders FORCE INDEX(customer)
WHERE customer=4;
customer4_now
0
# An order that is deleted and re-created before purge must survive
connection con1;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
connection default;
DELETE FROM orders WHERE id=3;
INSERT INTO orders VALUES (3,3,'new',3);
connection con1;
COMMIT;
connection default;
InnoDB		0 transactions not purged
SELECT id, status FROM orders FORCE INDEX(customer) WHERE customer=3 AND id=3;
id	status
3	new
SELECT customer, COUNT(*) FROM orders FORCE INDEX(customer)
GROUP BY customer ORDER BY customer;
customer	COUNT(*)
0	30
2	19
3	20
9	1
CHECK TABLE orders EXTENDED;
Table	Op	Msg_type	Msg_text
test.orders	check	status	OK
#
# 4. Purge of an index on a virtual column
#
INSERT INTO events (id,a,b) SELECT seq, seq, 0 FROM seq_1_to_50;
UPDATE events SET b=b+100 WHERE id<=20;
DELETE FROM events WHERE id>40;
InnoDB		0 transactions not purged
CHECK TABLE events EXTENDED;
Table	Op	Msg_type	Msg_text
test.events	check	status	OK
# 20 events with total = id+100, 40 events in all
SELECT COUNT(*), SUM(total) FROM events FORCE INDEX(total) WHERE total>=100;
COUNT(*)	SUM(total)
20	2210
SELECT COUNT(*) FROM events FORCE INDEX(total);
COUNT(*)
40
connection con1;
disconnect con1;
connection con2;
disconnect con2;
connection default;
DROP TABLE orders, events;
