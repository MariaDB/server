#
# MDEV-41758 ALTER TABLE ignores a changed fulltext parser of an index
#
INSTALL PLUGIN simple_parser SONAME 'mypluglib';
# Adding a parser. The index is built with it: simple_parser keeps
# 'abc-def' as one word, so 'abc' does not match.
CREATE TABLE t (id INT PRIMARY KEY, c TEXT, FULLTEXT ft(c)) ENGINE=InnoDB;
INSERT INTO t VALUES (1, 'abc-def');
ALTER TABLE t DROP INDEX ft, ADD FULLTEXT ft(c) WITH PARSER simple_parser;
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int(11) NOT NULL,
  `c` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  FULLTEXT KEY `ft` (`c`) WITH PARSER `simple_parser`
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
SELECT id FROM t WHERE MATCH(c) AGAINST('abc');
id
DROP TABLE t;
# Removing it, which cannot be done instantly
CREATE TABLE t (id INT PRIMARY KEY, c TEXT,
FULLTEXT ft(c) WITH PARSER simple_parser) ENGINE=InnoDB;
ALTER TABLE t DROP INDEX ft, ADD FULLTEXT ft(c), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: ADD INDEX. Try ALGORITHM=NOCOPY
ALTER TABLE t DROP INDEX ft, ADD FULLTEXT ft(c);
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int(11) NOT NULL,
  `c` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  FULLTEXT KEY `ft` (`c`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
DROP TABLE t;
# Adding it under another name: the index is rebuilt, not just renamed,
# so 'abc' does not match.
CREATE TABLE t (id INT PRIMARY KEY, c TEXT, FULLTEXT ft(c)) ENGINE=InnoDB;
INSERT INTO t VALUES (1, 'abc-def');
ALTER TABLE t DROP INDEX ft, ADD FULLTEXT ft2(c) WITH PARSER simple_parser;
SELECT id FROM t WHERE MATCH(c) AGAINST('abc');
id
DROP TABLE t;
# The same parser, in any letter case, is no change
CREATE TABLE t (id INT PRIMARY KEY, c TEXT,
FULLTEXT ft(c) WITH PARSER simple_parser) ENGINE=InnoDB;
ALTER TABLE t DROP INDEX ft,
ADD FULLTEXT ft(c) WITH PARSER SIMPLE_PARSER, ALGORITHM=INSTANT;
DROP TABLE t;
UNINSTALL PLUGIN simple_parser;
