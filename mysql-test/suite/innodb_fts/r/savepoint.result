#
# MDEV-41665 InnoDB assertion with result != FTS_INVALID on
# DELETE IGNORE with FK cascades on tables with FULLTEXT indexes
#
CREATE TABLE t1 (id INT PRIMARY KEY, a VARCHAR(20), FULLTEXT(a)) ENGINE=InnoDB;
CREATE TABLE t2 (id INT PRIMARY KEY, a VARCHAR(20), FULLTEXT(a)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,'aaa'),(2,'bbb');
INSERT INTO t2 VALUES (1,'ccc');
BEGIN;
SAVEPOINT s;
DELETE FROM t1 WHERE id=1;
ROLLBACK TO s;
COMMIT;
SELECT * FROM t1 WHERE MATCH(a) AGAINST('aaa');
id	a
1	aaa
BEGIN;
SAVEPOINT s;
UPDATE t1 SET a='ddd' WHERE id=1;
ROLLBACK TO s;
COMMIT;
SELECT * FROM t1 WHERE MATCH(a) AGAINST('aaa');
id	a
1	aaa
SELECT * FROM t1 WHERE MATCH(a) AGAINST('ddd');
id	a
BEGIN;
INSERT INTO t2 VALUES (2,'fff');
SAVEPOINT s;
DELETE FROM t1 WHERE id=1;
UPDATE t2 SET a='ggg' WHERE id=1;
ROLLBACK TO s;
COMMIT;
SELECT * FROM t1 WHERE MATCH(a) AGAINST('aaa');
id	a
1	aaa
SELECT * FROM t2 WHERE MATCH(a) AGAINST('ccc');
id	a
1	ccc
SELECT * FROM t2 WHERE MATCH(a) AGAINST('fff');
id	a
2	fff
SELECT * FROM t2 WHERE MATCH(a) AGAINST('ggg');
id	a
BEGIN;
INSERT INTO t2 VALUES (3,'hhh');
SAVEPOINT s;
DELETE FROM t2 WHERE id=3;
ROLLBACK TO s;
DELETE FROM t2 WHERE id=2;
ROLLBACK TO s;
COMMIT;
SELECT * FROM t2 WHERE MATCH(a) AGAINST('hhh');
id	a
3	hhh
SELECT * FROM t2 WHERE MATCH(a) AGAINST('fff');
id	a
2	fff
BEGIN;
INSERT INTO t2 VALUES (4,'iii');
SAVEPOINT s;
DELETE FROM t2 WHERE id=4;
RELEASE SAVEPOINT s;
COMMIT;
SELECT * FROM t2 WHERE MATCH(a) AGAINST('iii');
id	a
DROP TABLE t1, t2;
