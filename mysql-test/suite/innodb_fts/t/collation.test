--source include/have_innodb.inc
--echo #
--echo # MDEV-41360  OPTIMIZE TABLE crashes with
--echo #     ib_vector_size(optim->words) > 0 on FULLTEXT index
--echo #     with collation-equal words
--echo #
SET NAMES utf8;
SET GLOBAL innodb_optimize_fulltext_only = ON;
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  a TEXT CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci,
  FULLTEXT KEY (a)
) ENGINE=InnoDB;

INSERT INTO t1 VALUES (1, 'resume');
OPTIMIZE TABLE t1;
INSERT INTO t1 VALUES (2, _utf8 0x72c3a973756dc3a9);
OPTIMIZE TABLE t1;
DELETE FROM t1 WHERE id = 2;
OPTIMIZE TABLE t1;
SELECT * FROM t1 WHERE MATCH(a) against ('resume');
INSERT INTO t1 VALUES(3, 'résumé');
DELETE FROM t1;
OPTIMIZE TABLE t1;
SELECT * FROM t1 WHERE MATCH(a) against ('resume');
DROP TABLE t1;
SET GLOBAL innodb_optimize_fulltext_only = OFF;
