--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

# MDEV-37370 fts_phrase_or_proximity_search() is quadratic instead of linear
# This checks results, not speed: the per-word cursors must not skip matches
# with match lists of different lengths, gaps between document IDs, or lists
# that are not sorted by document ID.
CREATE TABLE patterns (
  pattern INT PRIMARY KEY,
  body VARCHAR(100) NOT NULL
) ENGINE=InnoDB;

INSERT INTO patterns VALUES
  (1, 'alpha'),
  (2, 'bravo'),
  (3, 'charlie'),
  (4, 'alpha bravo'),
  (5, 'bravo alpha'),
  (6, 'alpha charlie'),
  (7, 'bravo charlie'),
  (8, 'alpha bravo charlie'),
  (9, 'alpha filler bravo charlie'),
  (10, 'alpha bravo filler charlie'),
  (11, 'alpha filler bravo filler charlie'),
  (12, 'charlie bravo alpha'),
  (13, 'alpha alpha bravo charlie'),
  (14, 'alpha bravo alpha charlie'),
  (15, 'alpha bravo charlie delta'),
  (16, 'filler'),
  (17, 'alpha bravo'),
  (18, 'alpha');

CREATE TABLE t1 (
  FTS_DOC_ID BIGINT UNSIGNED NOT NULL PRIMARY KEY,
  pattern INT NOT NULL,
  body VARCHAR(100) NOT NULL,
  FULLTEXT KEY ft (body)
) ENGINE=InnoDB;

# Explicit, increasing document IDs leave gaps between documents.
INSERT INTO t1
  SELECT seq * 1000 + pattern * 10, pattern, body
  FROM seq_1_to_32, patterns ORDER BY seq, pattern;

# First search the cache, then search a rebuilt index plus new cache entries.
# Each returned pattern has 32 matches in the first pass, 64 in the second.
--let $pass= 2
while ($pass)
{
  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"alpha bravo"' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"charlie bravo alpha"' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"alpha alpha bravo"' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"alpha bravo"@2' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"alpha bravo charlie"@3' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  # Start with the rarest word, whose last match precedes the other tails.
  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"delta alpha"@100' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  # Nonempty, disjoint lists, and a word with an empty list.
  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"delta filler"' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  SELECT pattern, COUNT(*) AS matches FROM t1
    WHERE MATCH(body) AGAINST ('"alpha absent"' IN BOOLEAN MODE)
    GROUP BY pattern ORDER BY pattern;

  if ($pass == 2)
  {
    DROP INDEX ft ON t1;
    CREATE FULLTEXT INDEX ft ON t1 (body);
    INSERT INTO t1
      SELECT (seq + 32) * 1000 + pattern * 10, pattern, body
      FROM seq_1_to_32, patterns ORDER BY seq, pattern;
  }
  --dec $pass
}

DROP TABLE t1, patterns;

# Commit higher document IDs first to create unordered cache nodes.
# The alpha list is 30,10,20; bravo is 10,20,40. Sort the first list
# before retaining cursors so that rejecting 30 cannot skip 10 and 20.
CREATE TABLE t1 (
  FTS_DOC_ID BIGINT UNSIGNED NOT NULL PRIMARY KEY,
  body VARCHAR(100) NOT NULL,
  FULLTEXT KEY ft (body)
) ENGINE=InnoDB;

# Initialize the cache before starting the two transactions.
INSERT INTO t1 VALUES (1, 'filler');
--connect (con1,localhost,root,,test)
START TRANSACTION;
INSERT INTO t1 VALUES (10, 'alpha bravo'), (20, 'alpha bravo');
--connection default
INSERT INTO t1 VALUES (30, 'alpha');
--connection con1
COMMIT;
--connection default
INSERT INTO t1 VALUES (40, 'bravo');

SELECT FTS_DOC_ID FROM t1
  WHERE MATCH(body) AGAINST ('"alpha bravo"' IN BOOLEAN MODE)
  ORDER BY FTS_DOC_ID;
SELECT FTS_DOC_ID FROM t1
  WHERE MATCH(body) AGAINST ('"alpha bravo"@2' IN BOOLEAN MODE)
  ORDER BY FTS_DOC_ID;

# An unordered second list also needs sorting: alpha is 10; bravo is
# 30,10. Restarting at zero stops at 30 and misses the match at 10.
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (1, 'filler');
--connection con1
START TRANSACTION;
INSERT INTO t1 VALUES (10, 'alpha bravo');
--connection default
INSERT INTO t1 VALUES (30, 'bravo');
--connection con1
COMMIT;
--connection default

SELECT FTS_DOC_ID FROM t1
  WHERE MATCH(body) AGAINST ('"alpha bravo"' IN BOOLEAN MODE)
  ORDER BY FTS_DOC_ID;
SELECT FTS_DOC_ID FROM t1
  WHERE MATCH(body) AGAINST ('"alpha bravo"@2' IN BOOLEAN MODE)
  ORDER BY FTS_DOC_ID;

--disconnect con1
DROP TABLE t1;
