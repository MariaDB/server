# Can't run a test of an external client with the embedded server
--source include/not_embedded.inc
--source include/not_windows.inc

#
# MDEV-28824: mariadb-secure-installation must mention test_ databases
# and must remove only the default anonymous/PUBLIC grants.
#
# The script has no MTR coverage.  Run it non-interactively against the
# test server.  MariaDB installations create the default test database
# privileges for PUBLIC, so the test sets those up explicitly: MTR's
# bootstrap does not run mariadb_test_db.sql.
#

# The script needs a basedir in which it can find the client and
# my_print_defaults.
--let $secure_basedir= $MYSQL_TMP_DIR/secure-installation
--exec mkdir -p $secure_basedir/bin
--exec ln -sf $MYSQL_BINDIR/client/mariadb $secure_basedir/bin/mariadb
--exec ln -sf $MYSQL_BINDIR/extra/my_print_defaults $secure_basedir/bin/my_print_defaults

# Answer "n" to every question: the script must not change anything, but
# the prompt must mention the test_ prefix.
--exec printf 'n\nn\nn\nn\nn\nn\nn\n' > $MYSQL_TMP_DIR/secure-answers.txt
--exec $MYSQL_BINDIR/scripts/mariadb-secure-installation --basedir=$secure_basedir --socket=$MYSQL_TMP_DIR/mysqld.1.sock --user=root --password= < $MYSQL_TMP_DIR/secure-answers.txt 2>&1 | sed -e '/^stty: /d' -e 's|^print: .*|print: <basedir>|'

#
# Set up the grants of a default installation (PUBLIC) plus a grant that
# an administrator created for a named user.  The named user's grant must
# survive the cleanup.
#
USE mysql;
CREATE DATABASE test_foo;
GRANT ALL ON test.* TO PUBLIC;
GRANT ALL ON `test_foo`.* TO PUBLIC;
CREATE USER IF NOT EXISTS ''@'localhost';
GRANT ALL ON `test_foo`.* TO ''@'localhost';
CREATE USER 'testenv'@'localhost';
GRANT ALL ON `test_foo`.* TO 'testenv'@'localhost';

SELECT Db, User FROM mysql.db WHERE Db LIKE 'test%' ORDER BY Db, User;

# Answer "y" only to "Remove test database and access to it?".
--exec printf 'n\nn\nn\nn\nn\ny\nn\n' > $MYSQL_TMP_DIR/secure-answers-remove.txt
--exec $MYSQL_BINDIR/scripts/mariadb-secure-installation --basedir=$secure_basedir --socket=$MYSQL_TMP_DIR/mysqld.1.sock --user=root --password= < $MYSQL_TMP_DIR/secure-answers-remove.txt > $MYSQL_TMP_DIR/secure-remove.out 2>&1

# The script drops the test database; restore it for the rest of MTR.
CREATE DATABASE IF NOT EXISTS test;
USE test;

SELECT Db, User FROM mysql.db WHERE Db LIKE 'test%' ORDER BY Db, User;

DROP DATABASE test_foo;
DROP USER IF EXISTS 'testenv'@'localhost';
DROP USER IF EXISTS ''@'localhost';

# GRANT ... TO PUBLIC creates a PUBLIC row in mysql.global_priv.  MTR's
# baseline does not have it, so remove it to keep this test side-effect free.
DELETE FROM mysql.global_priv WHERE User='PUBLIC';
FLUSH PRIVILEGES;
