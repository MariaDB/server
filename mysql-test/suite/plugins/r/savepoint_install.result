#
# MDEV-38859 federated use-after-free with temp tables and savepoints
#
INSTALL SONAME 'ha_federatedx';
CREATE SERVER srv FOREIGN DATA WRAPPER mysql OPTIONS (USER 'root', HOST '127.0.0.1', DATABASE 'test', PORT MASTER_PORT);
CREATE TABLE t1 (c INT) ENGINE=MyISAM;
CREATE TABLE t2 (c INT) CONNECTION='srv/t1' ENGINE=Federated;
BEGIN;
INSERT INTO t2 VALUES (1);
SAVEPOINT sp;
INSERT INTO t2 VALUES (2);
ROLLBACK TO SAVEPOINT sp;
RELEASE SAVEPOINT sp;
COMMIT;
SELECT * FROM t1;
c
1
2
DROP TABLE t1, t2;
DROP SERVER srv;
UNINSTALL SONAME 'ha_federatedx';
Warnings:
Warning	1620	Plugin is busy and will be uninstalled on shutdown
# End of 10.11 tests
