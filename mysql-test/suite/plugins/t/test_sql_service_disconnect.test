--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_disconnect_watcher.inc

if (!$TEST_SQL_SERVICE_SO) {
  skip No TEST_SQL_SERVICE plugin;
}

--echo #
--echo # MDEV-38741 A disconnect aborts a statement run through the SQL service
--echo #

install plugin test_sql_service soname 'test_sql_service';
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

connect (blocker,localhost,root);
BEGIN;
SELECT * FROM t1 FOR UPDATE;
--source include/count_sessions.inc

connect (con1,127.0.0.1,root,,,$MASTER_MYPORT);
let $con1_id= `SELECT CONNECTION_ID()`;
SET innodb_lock_wait_timeout=3600;
send set global test_sql_service_execute_sql_local= 'select * from test.t1 for update';

connection default;
let $wait_condition=
  SELECT COUNT(*) = 1 FROM information_schema.innodb_lock_waits;
--source include/wait_condition.inc

--echo # The client disconnects while the local statement waits for the lock
connection con1;
dirty_close con1;

connection default;
let $wait_condition=
  SELECT COUNT(*) = 0 FROM information_schema.processlist
  WHERE id = $con1_id;
--source include/wait_condition.inc

--echo # The reason is logged, although the statement ended without an error
let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= Aborted connection $con1_id to db[^\n]*Client disconnected;
let SEARCH_WAIT= FOUND;
let SEARCH_OUTPUT= count;
--source include/search_pattern_in_file.inc

connection blocker;
COMMIT;
disconnect blocker;
connection default;
--source include/wait_until_count_sessions.inc
DROP TABLE t1;
uninstall plugin test_sql_service;

--echo # End of 13.2 tests
