#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
#
# MDEV-42156 UPDATE IGNORE ... RETURNING ... INTO fails with ER_TOO_MANY_ROWS when the second row is skipped by IGNORE (duplicate key)
#
#
# A table without transactions: the second changed row is updated back
# before ER_TOO_MANY_ROWS is raised. Both updates are in the binary log,
# so a replica ends with the same data.
#
CREATE TABLE t1 (a INT, b INT) ENGINE=MyISAM;
INSERT INTO t1 VALUES (1,1),(2,2);
UPDATE IGNORE t1 SET b=b+10 RETURNING b INTO @b;
ERROR 42000: Result consisted of more than one row
SELECT * FROM t1 ORDER BY a;
a	b
1	11
2	2
FLUSH LOGS;
# The row images
### UPDATE `test`.`t1`
### WHERE
###   @1=1
###   @2=1
### SET
###   @1=1
###   @2=11
### UPDATE `test`.`t1`
### WHERE
###   @1=2
###   @2=2
### SET
###   @1=2
###   @2=12
### UPDATE `test`.`t1`
### WHERE
###   @1=2
###   @2=12
### SET
###   @1=2
###   @2=2
#
# A table with transactions: the statement is rolled back,
# nothing is written to the binary log
#
DROP TABLE t1;
CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,2);
UPDATE IGNORE t1 SET b=b+10 RETURNING b INTO @b;
ERROR 42000: Result consisted of more than one row
SELECT * FROM t1 ORDER BY a;
a	b
1	1
2	2
include/show_binlog_events.inc
DROP TABLE t1;
# End of 13.1 tests
