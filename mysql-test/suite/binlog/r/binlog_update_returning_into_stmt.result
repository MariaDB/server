#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING INTO
PREPARE stmt FROM 'UPDATE t1 SET a=a+1 RETURNING a INTO @a1';
EXECUTE stmt;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING INTO
DEALLOCATE PREPARE stmt;
#
# MDEV-41260 Misleading message text "uses a LIMIT clause" after Update Returning Into
#
call mtr.add_suppression("Unsafe statement written to the binary log using statement format");
CREATE PROCEDURE p1()
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
CALL p1;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING INTO
SHOW WARNINGS;
Level	Code	Message
Error	1221	Incorrect usage of --binlog-format=statement and RETURNING INTO
Note	4094	At line 2 in test.p1
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. The statement is unsafe because it uses UPDATE .. RETURNING .. INTO. This is unsafe because the set of rows included cannot be predicted
DROP PROCEDURE p1;
DROP TABLE t1;
