#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
include/reset_master.inc
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
PREPARE stmt FROM 'UPDATE t1 SET a=a+1 RETURNING a INTO @a1';
EXECUTE stmt;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
DEALLOCATE PREPARE stmt;
#
# MDEV-41260 Misleading message text "uses a LIMIT clause" after Update Returning Into
#
# No "Unsafe statement written to the binary log" warning is raised,
# because the statement is rejected and not written.
#
CREATE PROCEDURE p1()
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
CALL p1;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
SHOW WARNINGS;
Level	Code	Message
Error	1221	Incorrect usage of --binlog-format=statement and RETURNING..INTO
Note	4094	At line 2 in test.p1
DROP PROCEDURE p1;
#
# A stored function or a trigger is rejected in the same way:
# the calling statement would be logged as a statement.
#
CREATE TABLE t2 (a INT);
CREATE FUNCTION f1() RETURNS INT
BEGIN
DECLARE v INT;
UPDATE t1 SET a=a+1 RETURNING a INTO v;
RETURN v;
END;
$$
SELECT f1();
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
INSERT INTO t2 VALUES (f1());
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
# The unsafeness is known at the function creation time, so a function
# which does not execute UPDATE..RETURNING..INTO is rejected too
CREATE FUNCTION f2(c INT) RETURNS INT
BEGIN
DECLARE v INT DEFAULT 0;
IF c THEN
UPDATE t1 SET a=a+1 RETURNING a INTO v;
END IF;
RETURN v;
END;
$$
SELECT f2(0);
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
CREATE TRIGGER tr1 BEFORE INSERT ON t2 FOR EACH ROW
BEGIN
DECLARE v INT;
UPDATE t1 SET a=a+1 RETURNING a INTO v;
END;
$$
INSERT INTO t2 VALUES (1);
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING..INTO
# Nothing was changed
SELECT * FROM t1;
a	b
10	b10
SELECT * FROM t2;
a
DROP TRIGGER tr1;
DROP FUNCTION f1;
DROP FUNCTION f2;
DROP TABLE t2;
DROP TABLE t1;
