#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING INTO
PREPARE stmt FROM 'UPDATE t1 SET a=a+1 RETURNING a INTO @a1';
EXECUTE stmt;
ERROR HY000: Incorrect usage of --binlog-format=statement and RETURNING INTO
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
