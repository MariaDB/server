/*!50003 SET COMPLETION_TYPE=@OLD_COMPLETION_TYPE*/;
#
# A dynamic statement inside a function with PS fires a trigger
# whose body calls RAND().
#
# The trigger body is not logged: the INSERT which fired it is logged
# and the replica fires the trigger itself. So the rand() call inside
# the trigger belongs to the INSERT, and the INSERT must be preceded
# by a Rand event carrying the seeds. The same INSERT executed at the
# top level and from a plain stored procedure is shown for comparison:
# all three must log the seeds the same way.
#
CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT, r DOUBLE);
CREATE TRIGGER tr1 AFTER INSERT ON t1 FOR EACH ROW
INSERT INTO t2 VALUES (NEW.a, RAND());
CREATE PROCEDURE p_plain()
BEGIN
INSERT INTO t1 VALUES (2);
END;
$$
CREATE FUNCTION f_with_ps() RETURNS INT
BEGIN
EXECUTE IMMEDIATE 'INSERT INTO t1 VALUES (3)';
RETURN 3;
END;
$$
CREATE PROCEDURE p_ps()
BEGIN
DECLARE nrows INT;
SET nrows= f_with_ps();
END;
$$
# Top level statement
include/reset_master.inc
INSERT INTO t1 VALUES (1);
