#
# MDEV-40318 MIXED binlog format does not switch an unsafe-for-SBR dynamic SQL (via PS) to ROW logging, causing replica divergence
#
include/reset_master.inc
CREATE TABLE td (id INT PRIMARY KEY AUTO_INCREMENT,
ts_now DATETIME(6), rnd DOUBLE, uu CHAR(36), usr_var INT);
CREATE FUNCTION f_nd(seed INT) RETURNS INT
BEGIN
SET @uv = seed * 7;
EXECUTE IMMEDIATE 'INSERT INTO td (ts_now, rnd, uu, usr_var) '
                     'VALUES (NOW(6), RAND(?), UUID(), @uv)'
                    USING seed;
RETURN seed;
END $$
CREATE PROCEDURE p_nd(seed INT)
BEGIN
DECLARE r INT DEFAULT f_nd(seed);
END $$
CALL p_nd(1);
CALL p_nd(2);
CALL p_nd(3);
CALL p_nd(4);
CALL p_nd(5);
DROP FUNCTION f_nd;
DROP PROCEDURE p_nd;
DROP TABLE td;
