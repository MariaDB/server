#
# MDEV-40227 Replication breaks when a function performs multiple INSERT statements with binlog_format=MIXED or STATEMENT
#
include/reset_master.inc
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, v INT);
CREATE FUNCTION f() RETURNS INT
BEGIN
EXECUTE IMMEDIATE 'INSERT INTO t1(v) VALUES (100)';
EXECUTE IMMEDIATE 'INSERT INTO t1(v) VALUES (200)';
INSERT INTO t1(v) VALUES (100);
INSERT INTO t1(v) VALUES (200);
RETURN 0;
END;
$$
CREATE PROCEDURE p()
BEGIN
DECLARE n INT DEFAULT f();
END;
$$
CALL p();
DROP PROCEDURE p;
DROP FUNCTION f;
DROP TABLE t1;
