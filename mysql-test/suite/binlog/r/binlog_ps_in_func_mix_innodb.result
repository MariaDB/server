/*!50003 SET COMPLETION_TYPE=@OLD_COMPLETION_TYPE*/;
#
# A dynamic statement inside a function with PS fires a trigger,
# and the trigger body calls another function.
#
# The trigger is not logged per statement: the INSERT which fired it
# is logged instead, and the replica fires the trigger itself. So the
# trigger body must not inherit the per-statement logging mode of the
# enclosing function, and the function called from the trigger body
# must not start a second binlog event union on top of the trigger's.
#
include/reset_master.inc
CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT);
CREATE FUNCTION f_double(a INT) RETURNS INT
BEGIN
RETURN a * 2;
END;
$$
CREATE TRIGGER tr1 AFTER INSERT ON t1 FOR EACH ROW
INSERT INTO t2 VALUES (f_double(NEW.a));
CREATE FUNCTION f_with_ps() RETURNS INT
BEGIN
EXECUTE IMMEDIATE 'INSERT INTO t1 VALUES (10)';
RETURN 10;
END;
$$
CREATE PROCEDURE p1()
BEGIN
DECLARE nrows INT;
SET nrows= f_with_ps();
END;
$$
CALL p1();
SELECT * FROM t1;
a
10
SELECT * FROM t2;
a
20
DROP PROCEDURE p1;
DROP FUNCTION f_with_ps;
DROP TRIGGER tr1;
DROP FUNCTION f_double;
DROP TABLE t1, t2;
/*!50003 SET @OLD_COMPLETION_TYPE=@@COMPLETION_TYPE,COMPLETION_TYPE=0*/;
