# MDEV-40870 ANALYZE/OPTIMIZE/REPAIR on a temporary table is written to
# the binary log when row-based binlogging is used
#
# CREATE TEMPORARY TABLE and DML on temporary tables are not binlogged
# when binlog_format=ROW. An admin statement on a temporary table must
# not be binlogged in that case either: on a replica the statement would
# be resolved to a base table with the same name (if one exists) and the
# replica would run unrequested maintenance on it, or the replication
# would fail if no such table exists.
#
# With statement-based binlogging temporary tables are binlogged, and
# the admin statement is applied by the replica's sql thread which owns
# the replica's copy of the temporary table, so it has to be binlogged
# in that case as well.

source include/have_log_bin.inc;
source include/have_innodb.inc;

--connection default
SET SESSION binlog_format=ROW;
RESET MASTER;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

# Admin statement on a base table is still binlogged.
ANALYZE TABLE t1;
--let $position= query_get_value(SHOW MASTER STATUS, Position, 1)

CREATE TEMPORARY TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (2);
ANALYZE TABLE t1;
OPTIMIZE TABLE t1;
CHECK TABLE t1;
REPAIR TABLE t1;

# None of the admin statements above may advance the binlog position.
--let $after= query_get_value(SHOW MASTER STATUS, Position, 1)
if ($position != $after)
{
  --die ERROR: admin statement on temporary table leaked into the binlog
}

DROP TEMPORARY TABLE t1;
DROP TABLE t1;

# In statement-based replication the temporary table is binlogged, so
# the admin statement on it has to be binlogged as well.
--connect (con1,127.0.0.1,root,,test,$MASTER_MYPORT,)
SET SESSION binlog_format=STATEMENT;
CREATE TEMPORARY TABLE t2 (a INT PRIMARY KEY) ENGINE=InnoDB;
--let $position= query_get_value(SHOW MASTER STATUS, Position, 1)
ANALYZE TABLE t2;
--let $after= query_get_value(SHOW MASTER STATUS, Position, 1)
if ($position == $after)
{
  --die ERROR: admin statement on temporary table was not binlogged in SBR
}
DROP TEMPORARY TABLE t2;
--disconnect con1

# End of test
