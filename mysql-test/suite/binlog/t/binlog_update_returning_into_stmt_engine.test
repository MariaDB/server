--source include/have_log_bin.inc
--source include/have_binlog_format_mixed.inc
--source include/have_debug.inc

--echo #
--echo # MDEV-39563 Implement UPDATE ... RETURNING ... INTO
--echo #
--echo # MDEV-41260 Misleading message text "uses a LIMIT clause" after
--echo # Update Returning Into
--echo #
--echo # UPDATE..RETURNING..INTO is unsafe for the statement based
--echo # replication. With a storage engine limited to statement logging
--echo # the statement can be neither logged as a row event nor as a statement
--echo # in the MIXED mode, so an error is raised with the explanation of
--echo # the unsafeness. The engine is simulated using a debug injection point.
--echo #

CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');

SET @saved_dbug= @@debug_dbug;
SET @@debug_dbug="+d,binlog_stmt_only_engine";
--error ER_BINLOG_UNSAFE_AND_STMT_ENGINE
UPDATE t1 SET a=a+1 RETURNING a INTO @a;

--echo # The same in a stored procedure
CREATE PROCEDURE p1()
  UPDATE t1 SET a=a+1 RETURNING a INTO @a;
--error ER_BINLOG_UNSAFE_AND_STMT_ENGINE
CALL p1;
DROP PROCEDURE p1;

--echo # UPDATE..RETURNING without INTO is safe
UPDATE t1 SET a=a+1 RETURNING a;
SET @@debug_dbug= @saved_dbug;

--echo # Only the last UPDATE changed the table (10 -> 11)
SELECT * FROM t1;
DROP TABLE t1;

--echo # End of 13.1 tests
