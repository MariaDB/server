--let $restart_parameters=
--source include/restart_mysqld.inc

#
# Scenario: fault_injection_updating_index
#   MDEV-36606 row: open / write filename to .index
#   Expected: ER_CANT_OPEN_FILE (via MYSQL_BIN_LOG::open goto err);
