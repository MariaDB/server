--source include/have_debug_sync.inc
--source include/have_partition.inc
--source include/have_innodb.inc

--echo #
--echo # MDEV-40995 concurrent INSERT ... SELECT on a partitioned InnoDB table
--echo # can leave the table-level AUTO_INCREMENT counter behind MAX(pk)
--echo #

CREATE TABLE t1 (
  id INT AUTO_INCREMENT,
  pk2 INT NOT NULL,
  a INT UNIQUE,
  PRIMARY KEY (id, pk2)
) ENGINE=InnoDB PARTITION BY HASH(pk2) PARTITIONS 2;

INSERT INTO t1 (pk2, a) VALUES (1, 10), (1, 100), (1, 110);

--connect (con1,localhost,root,,)
--connect (con2,localhost,root,,)

--connection con1
SET DEBUG_SYNC = 'ha_partition_get_auto_increment_after_reservation SIGNAL start_t2 WAIT_FOR t2_done';
--send INSERT INTO t1 (pk2, a) SELECT pk2, a+10 FROM t1 ORDER BY a;

--connection con2
SET DEBUG_SYNC = 'now WAIT_FOR start_t2';
INSERT INTO t1 (pk2, a) VALUES (1, 200);
SET DEBUG_SYNC = 'now SIGNAL t2_done';

--connection con1
--error ER_DUP_ENTRY
--reap

--connection default
INSERT INTO t1 (pk2, a) VALUES (1, 300);
INSERT INTO t1 (pk2, a) VALUES (1, 400);

DROP TABLE t1;
SET DEBUG_SYNC = 'RESET';
