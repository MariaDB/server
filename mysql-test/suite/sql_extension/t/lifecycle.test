--echo #
--echo # MDEV-41962 UNINSTALL while a recognize() call is in progress
--echo #
--source include/not_embedded.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
INSTALL PLUGIN test_sql_extension_recognizer SONAME 'test_sql_extension';

--echo #
--echo # UNINSTALL while recognize() runs: it waits for the call to return,
--echo # and the statement is not claimed, since the plugin is being removed
--echo #
connect (con1, localhost, root,,);
SET DEBUG_SYNC= 'test_sql_extension_recognize SIGNAL recognizing WAIT_FOR go';
send TEST RECOGNIZE WAIT;
connection default;
SET DEBUG_SYNC= 'now WAIT_FOR recognizing';
connect (con2, localhost, root,,);
SET DEBUG_SYNC= 'sql_extension_finalize SIGNAL finalizing';
send UNINSTALL PLUGIN test_sql_extension_recognizer;
connection default;
# Not a poll of information_schema.plugins: it pins every plugin while
# it runs, and an UNINSTALL that sees the pin leaves the removal to it,
# which then waits for the recognize() call that waits for this
# connection
SET DEBUG_SYNC= 'now WAIT_FOR finalizing';
SET DEBUG_SYNC= 'now SIGNAL go';
connection con1;
--error ER_PARSE_ERROR
reap;
connection con2;
reap;
disconnect con2;
connection con1;
--error ER_PARSE_ERROR
TEST RECOGNIZE x;
disconnect con1;
connection default;
UNINSTALL PLUGIN test_sql_extension;
SELECT COUNT(*) AS loaded FROM information_schema.plugins
  WHERE plugin_name LIKE 'test_sql_extension%';

SET DEBUG_SYNC= 'RESET';
--source include/wait_until_count_sessions.inc

--echo # End of 13.2 tests
