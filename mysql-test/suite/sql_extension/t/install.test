--echo #
--echo # MDEV-41962 SQL extension plugins: INSTALL / UNINSTALL and prefix overlap rules
--echo #
--source include/not_embedded.inc

call mtr.add_suppression("Plugin 'test_sql_extension.*' registration as a SQL EXTENSION failed");
call mtr.add_suppression("Plugin 'test_sql_extension_bad_init' init function returned error");

let $plugins= SELECT plugin_name, plugin_type, plugin_status
  FROM information_schema.plugins WHERE plugin_type = 'SQL EXTENSION'
  ORDER BY plugin_name;

--echo # A plugin that claims a prefix
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
eval $plugins;

--echo # A longer prefix of another plugin is refused, naming both prefixes
let $inits= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_inits', Value, 1);
let $deinits= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_deinits', Value, 1);
--error ER_SQL_EXTENSION_PREFIX_OVERLAP
INSTALL PLUGIN test_sql_extension_overlap SONAME 'test_sql_extension';
--replace_column 2 #
SHOW WARNINGS;
--echo # Its prefixes are added all or none: the free one is not claimed
--error ER_PARSE_ERROR
TEST OVERLAP FREE x;
--echo # Its init() ran, so its deinit() did too
let $inits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_inits', Value, 1);
let $deinits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_deinits', Value, 1);
--disable_query_log
eval SELECT $inits_after - $inits AS inits, $deinits_after - $deinits AS deinits;
--enable_query_log

--echo # An invalid descriptor is refused, saying why
--error ER_SQL_EXTENSION_BAD_DESCRIPTOR
INSTALL PLUGIN test_sql_extension_bad SONAME 'test_sql_extension';
--error ER_SQL_EXTENSION_BAD_DESCRIPTOR
INSTALL PLUGIN test_sql_extension_empty SONAME 'test_sql_extension';
--error ER_SQL_EXTENSION_BAD_DESCRIPTOR
INSTALL PLUGIN test_sql_extension_bad_prefix SONAME 'test_sql_extension';
--error ER_SQL_EXTENSION_BAD_DESCRIPTOR
INSTALL PLUGIN test_sql_extension_mixed SONAME 'test_sql_extension';
--error ER_SQL_EXTENSION_BAD_DESCRIPTOR
INSTALL PLUGIN test_sql_extension_bad_priority SONAME 'test_sql_extension';

--echo # A plugin whose init() fails is refused: nothing claims its prefix,
--echo # and its deinit() does not run
let $inits= query_get_value(SHOW STATUS LIKE 'test_sql_extension_bad_init_inits', Value, 1);
let $deinits= query_get_value(SHOW STATUS LIKE 'test_sql_extension_bad_init_deinits', Value, 1);
--error ER_CANT_INITIALIZE_UDF
INSTALL PLUGIN test_sql_extension_bad_init SONAME 'test_sql_extension';
--error ER_PARSE_ERROR
TEST BADINIT x;
let $inits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_bad_init_inits', Value, 1);
let $deinits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_bad_init_deinits', Value, 1);
--disable_query_log
eval SELECT $inits_after - $inits AS inits, $deinits_after - $deinits AS deinits;
--enable_query_log

--echo # A recognizer installs next to prefix plugins
INSTALL PLUGIN test_sql_extension_recognizer SONAME 'test_sql_extension';
eval $plugins;

--echo # Refused plugins leave no row in mysql.plugin
SELECT name FROM mysql.plugin ORDER BY name;

--echo # Once the claimer is gone, the longer prefix installs ...
UNINSTALL PLUGIN test_sql_extension;
INSTALL PLUGIN test_sql_extension_overlap SONAME 'test_sql_extension';
--echo # ... and now the shorter one is refused
--error ER_SQL_EXTENSION_PREFIX_OVERLAP
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';

--echo # Reinstall after uninstall
UNINSTALL PLUGIN test_sql_extension_overlap;
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
--echo # The uninstall ran its deinit(), which found the state its init()
--echo # kept in the plugin's data
let $inits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_inits', Value, 1);
let $deinits_after= query_get_value(SHOW STATUS LIKE 'test_sql_extension_overlap_deinits', Value, 1);
--disable_query_log
eval SELECT $inits_after - $inits AS inits, $deinits_after - $deinits AS deinits;
--enable_query_log
eval $plugins;

UNINSTALL PLUGIN test_sql_extension;
UNINSTALL PLUGIN test_sql_extension_recognizer;
eval $plugins;

--echo # End of 13.2 tests
