--echo #
--echo # MDEV-41962 Extension statements in the performance schema: the
--echo # statement/sql/sql_extension event
--echo #
--source include/not_embedded.inc
--source include/have_perfschema.inc

INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
--echo # Saved, to be restored at the end
CREATE TEMPORARY TABLE saved_instruments AS
  SELECT name, enabled, timed FROM performance_schema.setup_instruments
  WHERE name LIKE 'statement/%';
CREATE TEMPORARY TABLE saved_consumers AS
  SELECT name, enabled FROM performance_schema.setup_consumers
  WHERE name = 'events_statements_history_long';
UPDATE performance_schema.setup_consumers SET enabled= 'YES'
  WHERE name = 'events_statements_history_long';
UPDATE performance_schema.setup_instruments SET enabled= 'YES', timed= 'YES'
  WHERE name LIKE 'statement/%';
TRUNCATE performance_schema.events_statements_history_long;

--echo # A claimed statement, a failing one, an unclaimed one (text protocol:
--echo # a COM_STMT_PREPARE/EXECUTE pair is recorded as statement/com/Prepare
--echo # and Execute without the text, as for any statement)
--disable_ps_protocol
TEST SQLEXT OK;
--error ER_UNKNOWN_ERROR
TEST SQLEXT ERROR;
--error ER_PARSE_ERROR
TEST SQLEXTRA OK;
--enable_ps_protocol
--echo # Prepared: the outer statement is recorded, as for any prepared one
PREPARE s FROM 'TEST SQLEXT OK';
EXECUTE s;
DEALLOCATE PREPARE s;

SELECT event_name, sql_text, mysql_errno, rows_sent
  FROM performance_schema.events_statements_history_long
  WHERE thread_id = (SELECT thread_id FROM performance_schema.threads
                     WHERE processlist_id = CONNECTION_ID())
    AND (sql_text LIKE '%SQLEXT%' OR sql_text LIKE 'EXECUTE%')
  ORDER BY event_id;

UPDATE performance_schema.setup_instruments i JOIN saved_instruments s
  USING (name) SET i.enabled= s.enabled, i.timed= s.timed;
UPDATE performance_schema.setup_consumers c JOIN saved_consumers s
  USING (name) SET c.enabled= s.enabled;
DROP TEMPORARY TABLE saved_instruments, saved_consumers;
UNINSTALL PLUGIN test_sql_extension;

--echo # End of 13.2 tests
