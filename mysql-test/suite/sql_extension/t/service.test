--echo #
--echo # MDEV-41962 SQL extension service: results, warnings, access checks, and SQL run
--echo # as the client
--echo #
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/count_sessions.inc

INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';

--echo #
--echo # Results
--echo #
SET NAMES utf8mb4;
--enable_metadata
TEST SQLEXT ROWS;
--disable_metadata
--echo # Also as a prepared statement, which has no columns at PREPARE
PREPARE s FROM 'TEST SQLEXT ROWS';
EXECUTE s;
EXECUTE s;
DEALLOCATE PREPARE s;
--enable_info
TEST SQLEXT INFO;
--echo # An OK message of 511 bytes is sent whole; a longer or ill-formed
--echo # one is refused, not cut or sent as '?'
TEST SQLEXT INFO MAX;
--disable_info
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT INFO LONG;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT INFO ILL_FORMED;
SET NAMES DEFAULT;
TEST SQLEXT WARN;
SHOW WARNINGS;
--echo # Several results per statement: see results.test

--echo #
--echo # Column types: the metadata follows the cells (DECIMAL scale,
--echo # fractional seconds, nullability)
--echo #
--echo # Text protocol only: with --ps-protocol the client computes other
--echo # "Max length" values and, as for CALL, does not show the JSON format
--echo # of columns first sent at EXECUTE
--disable_ps_protocol
--enable_metadata
TEST SQLEXT TYPES;
--echo # With no rows, and with only NULLs, the metadata still describes
--echo # each column (strings at least 1 character wide; nullable only if
--echo # a NULL was sent)
TEST SQLEXT EMPTY;
TEST SQLEXT NULLS;
--disable_metadata
--enable_ps_protocol
PREPARE s FROM 'TEST SQLEXT TYPES';
EXECUTE s;
DEALLOCATE PREPARE s;
--echo # Values at the limits of each type are accepted
TEST SQLEXT BAD INTEGER -9223372036854775808;
TEST SQLEXT BAD UNSIGNED 18446744073709551615;
TEST SQLEXT BAD DOUBLE 1.7976931348623157e308;
TEST SQLEXT BAD DECIMAL 123456789012345678901234567.12345678901234567890123456789012345678;
TEST SQLEXT BAD DECIMAL 0.00000000000000000000000000000000000001;
TEST SQLEXT BAD TIME 838:59:59;
TEST SQLEXT BAD TIME -34 22:59:59.999999;
TEST SQLEXT BAD DATETIME 9999-12-31 23:59:59.999999;
TEST SQLEXT BAD JSON [1, "two", {"three": null}];
TEST SQLEXT BAD STRING café;
--echo # Other values are refused before anything is sent
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD STRING ILL_FORMED;
--echo # Malformed result sets are refused as well
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BADSET NOCOLS;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BADSET NONAME;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BADSET BADTYPE;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BADSET NOCELLS;
--echo # A call with a thd other than execute()'s is an invalid argument
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT BADTHD;
--echo # also from a thread of the plugin, with no THD: the error goes to the
--echo # handle and to the error log
call mtr.add_suppression("Invalid argument error: thd is not the connection of the execute\\(\\) in progress in function sql_extension_connect_as_client");
--error ER_UNKNOWN_ERROR
TEST SQLEXT NOTHD;
--echo # Other invalid calls: a NULL handle or query, no thd. With a THD, the
--echo # handle gets the error that was raised.
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT BADCALL MYSQL;
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT BADCALL HANDLE;
SHOW WARNINGS;
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT BADCALL QUERY;
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT BADCALL FORWARD;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD INTEGER 12x;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD INTEGER 9223372036854775808;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD UNSIGNED -1;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DOUBLE abc;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DOUBLE 1e400;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DOUBLE;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DECIMAL 1.2.3;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DECIMAL 1234567890123456789012345678901234567890123456789012345678901234567;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DECIMAL 0.000000000000000000000000000000000000001;
--echo # Two cells that fit on their own, but not in one DECIMAL column:
--echo # 60 digits before the point and 11 after
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD2 DECIMAL 123456789012345678901234567890123456789012345678901234567890 0.12345678901;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DATE 2026-13-01;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DATE 2026-11-06 10:20:30;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DATETIME 2026-11-06;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD DATETIME 2026-11-06 10:20:30.1234567;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD TIME 839:00:00;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD TIME 10:61:00;
--error ER_SQL_EXTENSION_INVALID_RESULT
TEST SQLEXT BAD JSON {"a": ;
--error ER_UNKNOWN_ERROR
TEST SQLEXT BAD NOSUCHTYPE x;

--echo #
--echo # Access checks and SQL run as the client
--echo #
CREATE DATABASE db1;
CREATE TABLE db1.t1 (a INT) ENGINE=InnoDB;
CREATE TABLE db1.t2 (a INT);
INSERT INTO db1.t1 VALUES (1);
CREATE USER u1@localhost;
GRANT SELECT ON db1.t1 TO u1@localhost;

connect (u1, localhost, u1,,);
TEST SQLEXT ACCESS db1 t1;
--echo # An invalid call names the argument
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT ACCESS;
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT ACCESS db1 '';
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT ACCESS NOPRIV db1;
--error ER_STD_INVALID_ARGUMENT
TEST SQLEXT ACCESS BADBIT db1;
--echo # Names are checked as a statement's would be
--error ER_WRONG_DB_NAME
TEST SQLEXT ACCESS SELECT a2345678901234567890123456789012345678901234567890123456789012345;
--error ER_WRONG_TABLE_NAME
TEST SQLEXT ACCESS SELECT db1 b2345678901234567890123456789012345678901234567890123456789012345;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT ACCESS db1 t2;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS db1;
--echo # Every privilege GRANT accepts on a database can be checked
connection default;
GRANT LOCK TABLES, EVENT ON db1.* TO u1@localhost;
GRANT REFERENCES ON db1.t1 TO u1@localhost;
connection u1;
TEST SQLEXT ACCESS LOCK_TABLES db1;
TEST SQLEXT ACCESS EVENT db1;
TEST SQLEXT ACCESS REFERENCES db1 t1;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS CREATE_TEMPORARY_TABLES db1;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS SHOW_CREATE_ROUTINE db1;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT ACCESS DELETE_HISTORY db1 t1;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT ACCESS GRANT_OPTION db1 t1;
--echo # A database name is checked as a name, not as a GRANT pattern
connection default;
CREATE DATABASE my_db;
GRANT SELECT ON `my\_db`.* TO u1@localhost WITH GRANT OPTION;
connection u1;
TEST SQLEXT ACCESS SELECT my_db;
TEST SQLEXT ACCESS GRANT_OPTION my_db;
--echo # Databases with built-in access rules
TEST SQLEXT ACCESS SELECT information_schema;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS INSERT information_schema;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS SELECT performance_schema;
--echo # The current database is checked through the privileges cached for it
USE db1;
TEST SQLEXT ACCESS LOCK_TABLES db1;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS CREATE_TEMPORARY_TABLES db1;
--echo # Global grants count
connection default;
CREATE USER u2@localhost;
GRANT SELECT ON *.* TO u2@localhost;
connect (u2, localhost, u2,,);
TEST SQLEXT ACCESS SELECT db1;
TEST SQLEXT ACCESS SELECT db1 t2;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS INSERT db1;
disconnect u2;
--echo # Grants of the active role and of PUBLIC count
connection default;
CREATE ROLE r1;
GRANT SELECT ON db1.t2 TO r1;
GRANT r1 TO u1@localhost;
GRANT INSERT ON db1.* TO PUBLIC;
connection u1;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT ACCESS SELECT db1 t2;
SET ROLE r1;
TEST SQLEXT ACCESS SELECT db1 t2;
SET ROLE NONE;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT ACCESS SELECT db1 t2;
TEST SQLEXT ACCESS INSERT db1;
TEST SQLEXT ACCESS INSERT db1 t2;
connection default;
REVOKE INSERT ON db1.* FROM PUBLIC;
# The GRANT made a row for PUBLIC that the REVOKE leaves
DELETE FROM mysql.global_priv WHERE user = 'PUBLIC';
FLUSH PRIVILEGES;
DROP ROLE r1;
connection u1;
--echo # The current database's grants are cached until the next USE, as
--echo # for any statement
TEST SQLEXT ACCESS INSERT db1;
USE db1;
--error ER_DBACCESS_DENIED_ERROR
TEST SQLEXT ACCESS INSERT db1;
--echo # The client's grants apply to the SQL a handler runs
TEST SQLEXT SQL SELECT a, CURRENT_USER() AS u FROM db1.t1;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT SQL SELECT * FROM db1.t2;
--error ER_TABLEACCESS_DENIED_ERROR
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (2);
--echo # The plain SQL service skips them
TEST SQLEXT LOCAL SQL INSERT INTO db1.t1 VALUES (2);
--echo # The client's current database
USE db1;
TEST SQLEXT SQL SELECT DATABASE() AS db, COUNT(*) AS n FROM t1;
disconnect u1;
connection default;

--echo # The client's transaction
--enable_info
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (3), (4);
ROLLBACK;
--disable_info
SELECT * FROM db1.t1 ORDER BY a;

--echo # A statement that fails after sending some rows (the second row's
--echo # subquery returns two rows): the error is relayed, and the rows
--echo # already read are freed (checked under ASan)
--error ER_SUBQUERY_NO_1_ROW
TEST SQLEXT SQL SELECT IF(a = 2, (SELECT 1 UNION ALL SELECT 2), a) AS v FROM db1.t1 ORDER BY a;
--error ER_SUBQUERY_NO_1_ROW
TEST SQLEXT LOCAL SQL SELECT IF(a = 2, (SELECT 1 UNION ALL SELECT 2), a) AS v FROM db1.t1 ORDER BY a;
TEST SQLEXT SQL SELECT COUNT(*) AS n FROM db1.t1;

--echo # SQL a handler runs after raising an error leaves that error to the
--echo # statement, also when the SQL fails, and through the plain service
--error ER_UNKNOWN_ERROR
TEST SQLEXT RAISE SELECT 1 AS a;
--error ER_UNKNOWN_ERROR
TEST SQLEXT RAISE SELECT * FROM no_such_table;
--error ER_UNKNOWN_ERROR
TEST SQLEXT LOCAL RAISE SELECT 1 AS a;

--echo # A connection opened for one statement cannot be used by a later
--echo # one, nor by another client
TEST SQLEXT KEEP SELECT 1 AS a;
--error 2000
TEST SQLEXT REUSE SELECT 2 AS b;
connect (con3, localhost, root,,);
--error 2000
TEST SQLEXT REUSE SELECT 2 AS b;
disconnect con3;
connection default;
TEST SQLEXT KEEP CLOSE;
--echo # nor by another thread of the plugin, even during the statement
--error ER_UNKNOWN_ERROR
TEST SQLEXT THREAD SELECT 1 AS a;

--echo #
--echo # SQL that changes the client's session or transaction: it does,
--echo # as when the client sends it
--echo #
CREATE TABLE db1.t3 (a INT) ENGINE=InnoDB;
--echo # COMMIT, ROLLBACK and an implicit commit end the client's transaction
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (1);
TEST SQLEXT SQL COMMIT;
SELECT @@in_transaction;
ROLLBACK;
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (2);
TEST SQLEXT SQL CREATE TABLE db1.t4 (a INT);
SELECT @@in_transaction;
ROLLBACK;
DROP TABLE db1.t4;
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (3);
TEST SQLEXT SQL ROLLBACK;
SELECT @@in_transaction;
SELECT * FROM db1.t3 ORDER BY a;
--echo # START TRANSACTION and autocommit start or set the client's
TEST SQLEXT SQL START TRANSACTION;
SELECT @@in_transaction;
ROLLBACK;
TEST SQLEXT SQL SET autocommit= 0;
SELECT @@autocommit;
SET autocommit= 1;
--echo # USE changes the client's current database
TEST SQLEXT SQL USE db1;
SELECT DATABASE();
USE test;
--echo # LOCK TABLES and UNLOCK TABLES lock and unlock the client's tables
TEST SQLEXT SQL LOCK TABLES db1.t3 READ;
--error ER_TABLE_NOT_LOCKED
SELECT COUNT(*) FROM db1.t1;
UNLOCK TABLES;
LOCK TABLES db1.t3 READ;
TEST SQLEXT SQL UNLOCK TABLES;
SELECT COUNT(*) FROM db1.t1;
DROP TABLE db1.t3;
--echo # EXECUTE of a prepared extension statement is refused like the
--echo # statement itself
PREPARE s FROM 'TEST SQLEXT OK';
--error ER_SQL_EXTENSION_NESTED
TEST SQLEXT FORWARD EXECUTE s;
--error ER_SQL_EXTENSION_NESTED
TEST SQLEXT SQL EXECUTE s;
--error ER_SQL_EXTENSION_NESTED
TEST SQLEXT LOCAL SQL EXECUTE s;
EXECUTE s;
DEALLOCATE PREPARE s;

--echo #
--echo # LOCK TABLES: the client's locked tables
--echo #
LOCK TABLES db1.t1 WRITE;
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (5);
--error ER_TABLE_NOT_LOCKED
TEST SQLEXT SQL SELECT * FROM db1.t2;
--echo # Forwarded SQL runs on the client's THD too, with its locks
TEST SQLEXT FORWARD SELECT COUNT(*) AS n FROM db1.t1;
--error ER_TABLE_NOT_LOCKED
TEST SQLEXT FORWARD SELECT * FROM db1.t2;
UNLOCK TABLES;
LOCK TABLES db1.t1 READ;
TEST SQLEXT SQL SELECT COUNT(*) AS n FROM db1.t1;
--error ER_TABLE_NOT_LOCKED_FOR_WRITE
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (6);
--error ER_TABLE_NOT_LOCKED_FOR_WRITE
TEST SQLEXT FORWARD INSERT INTO db1.t1 VALUES (6);
UNLOCK TABLES;
--echo # ROLLBACK undoes the handler's changes; the locks stay
SET autocommit= 0;
LOCK TABLES db1.t1 WRITE;
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (7);
ROLLBACK;
SELECT COUNT(*) AS n FROM db1.t1 WHERE a = 7;
--echo # Other connections still wait for the client's lock
connect (con2, localhost, root,,);
send SELECT COUNT(*) AS n FROM db1.t1;
connection default;
let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.processlist
  WHERE state = 'Waiting for table metadata lock'
  AND info = 'SELECT COUNT(*) AS n FROM db1.t1';
--source include/wait_condition.inc
UNLOCK TABLES;
SET autocommit= 1;
connection con2;
reap;
disconnect con2;
connection default;

--echo #
--echo # KILL QUERY and max_statement_time stop the SQL a handler runs
--echo #
let $sqlext_verb= SQL;
--source suite/sql_extension/include/kill_and_timeout.inc
let $sqlext_verb= SWALLOW;
--source suite/sql_extension/include/kill_and_timeout.inc
--echo # A handler that goes on after its SQL was killed: the client gets
--echo # the OK or the rows it sends, then the kill error, as from a CALL
let $sqlext_verb= SWALLOW OK;
--source suite/sql_extension/include/kill_and_timeout.inc
let $sqlext_verb= SWALLOW ROWS;
--source suite/sql_extension/include/kill_and_timeout.inc
--echo # The plain SQL service on the client's THD leaves the timer to the
--echo # extension statement too
SET max_statement_time= 0.2;
--error ER_STATEMENT_TIMEOUT
TEST SQLEXT LOCAL SQL SELECT SLEEP(10) AS s;
SET max_statement_time= DEFAULT;
--echo # LIMIT ROWS EXAMINED counts each statement on its own: the second run
--echo # returns every row, as the first did
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2),(3),(4);
TEST SQLEXT SQL2 SELECT a FROM t1 LIMIT ROWS EXAMINED 6;
--echo # A statement that reaches the limit does not stop the next ones: the
--echo # second run returns the same two rows, and a script goes on with
--echo # every row
TEST SQLEXT SQL2 SELECT a FROM t1 LIMIT ROWS EXAMINED 2;
--disable_ps_protocol
DELIMITER |;
TEST SQLEXT SCRIPT 'SELECT a FROM t1 LIMIT ROWS EXAMINED 2; UPDATE t1 SET a= a + 10; SELECT a FROM t1'|
DELIMITER ;|
--enable_ps_protocol
DROP TABLE t1;

--echo #
--echo # SQL whose error rolls back the client's transaction (a deadlock)
--echo # fails the statement with that error, even if the handler drops it
--echo #
CREATE TABLE db1.t5 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO db1.t5 VALUES (1, 0), (2, 0);
CREATE TABLE db1.t6 (a INT) ENGINE=InnoDB;
let $sqlext_dl_in_trx= 1;
let $sqlext_dl_stmt= UPDATE db1.t5 SET v= 1 WHERE id= 2;
let $sqlext_dl_error= ER_LOCK_DEADLOCK;
let $sqlext_dl_verb= SWALLOW;
--source suite/sql_extension/include/deadlock.inc
--echo # After the OK or the row the handler sends, as from a CALL
let $sqlext_dl_verb= SWALLOW OK;
--source suite/sql_extension/include/deadlock.inc
let $sqlext_dl_verb= SWALLOW ROWS;
--source suite/sql_extension/include/deadlock.inc
--echo # Through the plain SQL service on the client's connection too
--echo # (which writes the error of its query to the server log)
call mtr.add_suppression("Deadlock found when trying to get lock; try restarting transaction");
let $sqlext_dl_verb= LOCAL SWALLOW;
--source suite/sql_extension/include/deadlock.inc
--echo # A handler that fails with an error of its own keeps it, as for a
--echo # kill; the transaction is gone all the same
let $sqlext_dl_verb= RAISE;
let $sqlext_dl_error= ER_UNKNOWN_ERROR;
--source suite/sql_extension/include/deadlock.inc
let $sqlext_dl_error= ER_LOCK_DEADLOCK;
--echo # In autocommit too: the statement's work is rolled back
let $sqlext_dl_in_trx= 0;
let $sqlext_dl_stmt= UPDATE db1.t5 SET v= 1 ORDER BY id;
let $sqlext_dl_verb= SWALLOW;
--source suite/sql_extension/include/deadlock.inc
--echo # A stored procedure that handles the deadlock itself succeeds, as
--echo # when the client calls it: the error is the procedure's to handle
DELIMITER |;
CREATE PROCEDURE db1.p_dl()
BEGIN
  DECLARE CONTINUE HANDLER FOR 1213 SET @dl= 'deadlock handled';
  UPDATE db1.t5 SET v= 1 WHERE id= 2;
END|
DELIMITER ;|
SET @dl= NULL;
let $sqlext_dl_in_trx= 1;
let $sqlext_dl_stmt= CALL db1.p_dl();
let $sqlext_dl_error= 0;
let $sqlext_dl_verb= SQL;
--source suite/sql_extension/include/deadlock.inc
SELECT @dl;
--echo # Also when the handler forwards the CALL
SET @dl= NULL;
let $sqlext_dl_verb= FORWARD;
--source suite/sql_extension/include/deadlock.inc
SELECT @dl;
--echo # But not when the error escapes the procedure's handler, which the
--echo # handler of the extension statement then drops: RESIGNAL
DELIMITER |;
CREATE PROCEDURE db1.p_resignal()
BEGIN
  DECLARE EXIT HANDLER FOR 1213 RESIGNAL;
  UPDATE db1.t5 SET v= 1 WHERE id= 2;
END|
--echo # or another error
CREATE PROCEDURE db1.p_other()
BEGIN
  DECLARE EXIT HANDLER FOR 1213
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= 'after the deadlock';
  UPDATE db1.t5 SET v= 1 WHERE id= 2;
END|
--echo # Nor does a later error with the same number make up for a
--echo # deadlock the extension's handler dropped
CREATE PROCEDURE db1.p_same_errno()
BEGIN
  DECLARE CONTINUE HANDLER FOR 1213 SET @dl= 'signal handled';
  SIGNAL SQLSTATE '40001' SET MYSQL_ERRNO= 1213;
END|
DELIMITER ;|
let $sqlext_dl_error= ER_LOCK_DEADLOCK;
let $sqlext_dl_verb= SWALLOW;
let $sqlext_dl_stmt= CALL db1.p_resignal();
--source suite/sql_extension/include/deadlock.inc
let $sqlext_dl_stmt= CALL db1.p_other();
--source suite/sql_extension/include/deadlock.inc
SET @dl= NULL;
DELIMITER |;
let $sqlext_dl_stmt= 'UPDATE db1.t5 SET v= 1 WHERE id= 2; CALL db1.p_same_errno()'|
DELIMITER ;|
--source suite/sql_extension/include/deadlock.inc
SELECT @dl;
--echo # A handler of an outer procedure takes a deadlock from an inner one:
--echo # handled, as when the client calls it
DELIMITER |;
CREATE PROCEDURE db1.p_inner()
  UPDATE db1.t5 SET v= 1 WHERE id= 2|
CREATE PROCEDURE db1.p_outer()
BEGIN
  DECLARE CONTINUE HANDLER FOR 1213 SET @dl= 'outer handled';
  CALL db1.p_inner();
END|
DELIMITER ;|
SET @dl= NULL;
let $sqlext_dl_error= 0;
let $sqlext_dl_verb= SQL;
let $sqlext_dl_stmt= CALL db1.p_outer();
--source suite/sql_extension/include/deadlock.inc
SELECT @dl;
--echo # A later error the handler drops, unrelated to the rollback, does not
--echo # undo the handling
SET @dl= NULL;
let $sqlext_dl_verb= SWALLOW;
DELIMITER |;
let $sqlext_dl_stmt= 'CALL db1.p_dl(); SELECT * FROM db1.no_such_table'|
DELIMITER ;|
--source suite/sql_extension/include/deadlock.inc
SELECT @dl;
let $sqlext_dl_error= ER_LOCK_DEADLOCK;
DROP PROCEDURE db1.p_inner;
DROP PROCEDURE db1.p_outer;
DROP PROCEDURE db1.p_resignal;
DROP PROCEDURE db1.p_other;
DROP PROCEDURE db1.p_same_errno;
DROP PROCEDURE db1.p_dl;
DROP TABLE db1.t5, db1.t6;
--echo # A lock wait timeout rolls back only the statement that timed out
--echo # (without innodb_rollback_on_timeout, see rollback_on_timeout.test):
--echo # a handler may drop it, and the client's transaction goes on
CREATE TABLE db1.t5 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO db1.t5 VALUES (1, 0), (2, 0);
CREATE TABLE db1.t6 (a INT) ENGINE=InnoDB;
let $sqlext_lw_verb= SWALLOW;
let $sqlext_lw_stmt= UPDATE db1.t5 SET v= 1 WHERE id= 2;
let $sqlext_lw_in_trx= 1;
let $sqlext_lw_error= 0;
--source suite/sql_extension/include/lock_wait_timeout.inc
--echo # The error reaches the client when the handler passes it on
let $sqlext_lw_verb= SQL;
let $sqlext_lw_error= ER_LOCK_WAIT_TIMEOUT;
--source suite/sql_extension/include/lock_wait_timeout.inc
DROP TABLE db1.t5, db1.t6;
--echo # A rollback no engine asked for is not such an error: CHECK TABLE
--echo # on a corrupt table rolls back without one, and its rows still
--echo # reach the client
CREATE TABLE db1.t7 (a INT NOT NULL, b INT NOT NULL) ENGINE=CSV;
let $MYSQLD_DATADIR= `SELECT @@datadir`;
--remove_file $MYSQLD_DATADIR/db1/t7.CSV
--write_file $MYSQLD_DATADIR/db1/t7.CSV
"1"
EOF
TEST SQLEXT SQL CHECK TABLE db1.t7;
DROP TABLE db1.t7;

DROP USER u1@localhost;
DROP USER u2@localhost;
DROP DATABASE my_db;
DROP DATABASE db1;
UNINSTALL PLUGIN test_sql_extension;
--source include/wait_until_count_sessions.inc

--echo # End of 13.2 tests
