#
# MDEV-41962 The query cache never serves an SQL extension statement: a carrier whose
# text starts like a SELECT (here "WITH SQLEXT ...") is looked up before
# parsing, and the SQL a handler then forwards to the client must not be
# stored under the carrier's text, or the next client sending the same text
# would get the stored result without the plugin running.
#
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1), (2);
CREATE USER u1@localhost, u2@localhost;
GRANT SELECT ON test.t1 TO u1@localhost, u2@localhost;
RESET QUERY CACHE;
# The cache itself works here (in the text protocol: prepared
# statements are never cached)
connect  u1, localhost, u1,,test;
SELECT a FROM t1;
a
1
2
SELECT a FROM t1;
a
1
2
hits_from_a_repeated_select
1
connection default;
RESET QUERY CACHE;
# A forwarded SELECT is not stored under the carrier's text
connection u1;
WITH SQLEXT FORWARD SELECT a FROM t1;
a
1
2
SHOW STATUS LIKE 'Qcache_queries_in_cache';
Variable_name	Value
Qcache_queries_in_cache	0
# ... so another user sending the same text goes through the plugin
connect  u2, localhost, u2,,test;
WITH SQLEXT FORWARD SELECT a FROM t1;
a
1
2
hits_from_the_extension_statement
0
# Nor a result set the plugin builds itself
SET NAMES utf8mb4;
WITH SQLEXT ROWS;
s	b	i	u
cafÃ©	bÿn	-9223372036854775808	18446744073709551615
	NULL	0	NULL
SHOW STATUS LIKE 'Qcache_queries_in_cache';
Variable_name	Value
Qcache_queries_in_cache	0
# Nor through a prepared statement, after a cacheable SELECT left the
# connection's cache lookup state behind
SELECT a FROM t1 WHERE a = 1;
a
1
PREPARE s FROM 'WITH SQLEXT FORWARD SELECT a FROM t1';
EXECUTE s;
a
1
2
DEALLOCATE PREPARE s;
stored_by_execute
0
disconnect u1;
disconnect u2;
connection default;
DROP USER u1@localhost, u2@localhost;
DROP TABLE t1;
UNINSTALL PLUGIN test_sql_extension;
# End of 13.2 tests
