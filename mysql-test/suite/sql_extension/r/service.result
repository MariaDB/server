# A lock wait timeout rolls back only the statement that timed out
# (without innodb_rollback_on_timeout, see rollback_on_timeout.test):
# a handler may drop it, and the client's transaction goes on
CREATE TABLE db1.t5 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO db1.t5 VALUES (1, 0), (2, 0);
CREATE TABLE db1.t6 (a INT) ENGINE=InnoDB;
connect  con_lw, localhost, root,,;
BEGIN;
UPDATE db1.t5 SET v= 2 WHERE id= 2;
connection default;
SET innodb_lock_wait_timeout= 1;
BEGIN;
INSERT INTO db1.t6 VALUES (100);
TEST SQLEXT SWALLOW UPDATE db1.t5 SET v= 1 WHERE id= 2;
SET innodb_lock_wait_timeout= DEFAULT;
# Whether the client's transaction, with its INSERT, is still there
SELECT @@in_transaction;
@@in_transaction
1
SELECT COUNT(*) AS n FROM db1.t6 WHERE a = 100;
n
1
ROLLBACK;
connection con_lw;
ROLLBACK;
disconnect con_lw;
connection default;
UPDATE db1.t5 SET v= 0;
DELETE FROM db1.t6;
# The error reaches the client when the handler passes it on
connect  con_lw, localhost, root,,;
BEGIN;
UPDATE db1.t5 SET v= 2 WHERE id= 2;
connection default;
SET innodb_lock_wait_timeout= 1;
BEGIN;
INSERT INTO db1.t6 VALUES (100);
TEST SQLEXT SQL UPDATE db1.t5 SET v= 1 WHERE id= 2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SET innodb_lock_wait_timeout= DEFAULT;
# Whether the client's transaction, with its INSERT, is still there
SELECT @@in_transaction;
@@in_transaction
1
SELECT COUNT(*) AS n FROM db1.t6 WHERE a = 100;
n
1
ROLLBACK;
connection con_lw;
ROLLBACK;
disconnect con_lw;
connection default;
UPDATE db1.t5 SET v= 0;
DELETE FROM db1.t6;
DROP TABLE db1.t5, db1.t6;
# A rollback no engine asked for is not such an error: CHECK TABLE
# on a corrupt table rolls back without one, and its rows still
# reach the client
CREATE TABLE db1.t7 (a INT NOT NULL, b INT NOT NULL) ENGINE=CSV;
TEST SQLEXT SQL CHECK TABLE db1.t7;
Table	Op	Msg_type	Msg_text
db1.t7	check	error	Corrupt
DROP TABLE db1.t7;
DROP USER u1@localhost;
DROP USER u2@localhost;
DROP DATABASE my_db;
DROP DATABASE db1;
UNINSTALL PLUGIN test_sql_extension;
