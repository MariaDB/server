# A handler that goes on after its SQL was killed: the client gets
# the OK or the rows it sends, then the kill error, as from a CALL
# The timer of the extension statement applies: the SQL fails, as
# in a stored procedure (a plain SELECT SLEEP() would return 1)
SET max_statement_time= 0.2;
TEST SQLEXT SWALLOW OK SELECT SLEEP(10) AS s;
ERROR 70100: Query was interrupted: execution time limit 0.2 sec exceeded
SET max_statement_time= DEFAULT;
TEST SQLEXT SWALLOW OK SELECT 1 AS a;
# KILL QUERY while the SQL runs
connect  con1, localhost, root,,;
TEST SQLEXT SWALLOW OK SELECT SLEEP(100);
connection default;
connection con1;
ERROR 70100: Query execution was interrupted
# The connection is usable afterwards
TEST SQLEXT SWALLOW OK SELECT 1 AS a;
disconnect con1;
connection default;
# KILL CONNECTION while the SQL runs: the connection ends
connect  con1, localhost, root,,;
TEST SQLEXT SWALLOW OK SELECT SLEEP(100);
connection default;
connection con1;
Got one of the listed errors
disconnect con1;
connection default;
