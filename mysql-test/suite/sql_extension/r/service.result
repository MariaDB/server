-0.002	3.125	0000-00-00	26:03:04.123456	2026-11-06 10:20:30.0	null
NULL	NULL	NULL	NULL	NULL	NULL
# With no rows, and with only NULLs, the metadata still describes
# each column (strings at least 1 character wide; nullable only if
# a NULL was sent)
TEST SQLEXT EMPTY;
