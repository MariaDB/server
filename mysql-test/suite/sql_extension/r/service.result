SET NAMES DEFAULT;
TEST SQLEXT WARN;
Warnings:
Note	1	test_sql_extension: note
Warning	2	test_sql_extension: warning
SHOW WARNINGS;
Level	Code	Message
Note	1	test_sql_extension: note
Warning	2	test_sql_extension: warning
# Several results per statement: see results.test
#
# Column types: the metadata follows the cells (DECIMAL scale,
# fractional seconds, nullability)
#
# Text protocol only: with --ps-protocol the client computes other
# "Max length" values and, as for CALL, does not show the JSON format
# of columns first sent at EXECUTE
TEST SQLEXT TYPES;
Catalog	Database	Table	Table_alias	Column	Column_alias	Type	Length	Max length	Is_null	Flags	Decimals	Charsetnr
def					d	5	22	6	Y	32896	31	63
