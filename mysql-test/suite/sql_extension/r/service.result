# LIMIT ROWS EXAMINED counts each statement on its own: the second run
# returns every row, as the first did
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2),(3),(4);
TEST SQLEXT SQL2 SELECT a FROM t1 LIMIT ROWS EXAMINED 6;
a
1
2
3
4
# A statement that reaches the limit does not stop the next ones: the
# second run returns the same two rows, and a script goes on with
# every row
TEST SQLEXT SQL2 SELECT a FROM t1 LIMIT ROWS EXAMINED 2;
a
1
2
TEST SQLEXT SCRIPT 'SELECT a FROM t1 LIMIT ROWS EXAMINED 2; UPDATE t1 SET a= a + 10; SELECT a FROM t1'|
a
1
2
a
11
12
13
14
