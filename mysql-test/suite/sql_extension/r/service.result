# A handler of an outer procedure takes a deadlock from an inner one:
# handled, as when the client calls it
CREATE PROCEDURE db1.p_inner()
UPDATE db1.t5 SET v= 1 WHERE id= 2|
CREATE PROCEDURE db1.p_outer()
BEGIN
DECLARE CONTINUE HANDLER FOR 1213 SET @dl= 'outer handled';
CALL db1.p_inner();
END|
SET @dl= NULL;
connect  con_dl, localhost, root,,;
# The other transaction does more work, so InnoDB picks the client's
# as the victim
BEGIN;
INSERT INTO db1.t6 VALUES (1), (2), (3), (4), (5), (6), (7), (8);
UPDATE db1.t5 SET v= 2 WHERE id= 2;
connection default;
BEGIN;
INSERT INTO db1.t6 VALUES (100);
UPDATE db1.t5 SET v= 1 WHERE id= 1;
TEST SQLEXT SQL CALL db1.p_outer();
connection con_dl;
UPDATE db1.t5 SET v= 2 WHERE id= 1;
COMMIT;
disconnect con_dl;
connection default;
# The client's transaction is gone, with its INSERT
SELECT @@in_transaction;
@@in_transaction
0
SELECT COUNT(*) AS n FROM db1.t6 WHERE a = 100;
n
0
SELECT * FROM db1.t5 ORDER BY id;
id	v
1	2
2	2
UPDATE db1.t5 SET v= 0;
DELETE FROM db1.t6;
SELECT @dl;
@dl
outer handled
