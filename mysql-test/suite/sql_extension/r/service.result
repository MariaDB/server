#
# Access checks and SQL run as the client
#
CREATE DATABASE db1;
CREATE TABLE db1.t1 (a INT) ENGINE=InnoDB;
CREATE TABLE db1.t2 (a INT);
INSERT INTO db1.t1 VALUES (1);
CREATE USER u1@localhost;
GRANT SELECT ON db1.t1 TO u1@localhost;
connect  u1, localhost, u1,,;
TEST SQLEXT ACCESS db1 t1;
# An invalid call names the argument
TEST SQLEXT ACCESS;
ERROR HY000: Invalid argument error: db is NULL or empty in function sql_extension_check_access.
TEST SQLEXT ACCESS db1 '';
ERROR HY000: Invalid argument error: table is empty in function sql_extension_check_access.
TEST SQLEXT ACCESS NOPRIV db1;
ERROR HY000: Invalid argument error: privileges is 0 in function sql_extension_check_access.
TEST SQLEXT ACCESS BADBIT db1;
ERROR HY000: Invalid argument error: privileges has unknown bits in function sql_extension_check_access.
# Names are checked as a statement's would be
TEST SQLEXT ACCESS SELECT a2345678901234567890123456789012345678901234567890123456789012345;
ERROR 42000: Incorrect database name 'a2345678901234567890123456789012345678901234567890123456789012345'
TEST SQLEXT ACCESS SELECT db1 b2345678901234567890123456789012345678901234567890123456789012345;
ERROR 42000: Incorrect table name 'b2345678901234567890123456789012345678901234567890123456789012345'
TEST SQLEXT ACCESS db1 t2;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `db1`.`t2`
TEST SQLEXT ACCESS db1;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db1'
# Every privilege GRANT accepts on a database can be checked
connection default;
GRANT LOCK TABLES, EVENT ON db1.* TO u1@localhost;
GRANT REFERENCES ON db1.t1 TO u1@localhost;
connection u1;
TEST SQLEXT ACCESS LOCK_TABLES db1;
TEST SQLEXT ACCESS EVENT db1;
TEST SQLEXT ACCESS REFERENCES db1 t1;
TEST SQLEXT ACCESS CREATE_TEMPORARY_TABLES db1;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db1'
TEST SQLEXT ACCESS SHOW_CREATE_ROUTINE db1;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db1'
TEST SQLEXT ACCESS DELETE_HISTORY db1 t1;
ERROR 42000: DELETE HISTORY command denied to user 'u1'@'localhost' for table `db1`.`t1`
TEST SQLEXT ACCESS GRANT_OPTION db1 t1;
ERROR 42000: GRANT command denied to user 'u1'@'localhost' for table `db1`.`t1`
# A database name is checked as a name, not as a GRANT pattern
connection default;
CREATE DATABASE my_db;
GRANT SELECT ON `my\_db`.* TO u1@localhost WITH GRANT OPTION;
connection u1;
TEST SQLEXT ACCESS SELECT my_db;
TEST SQLEXT ACCESS GRANT_OPTION my_db;
# Databases with built-in access rules
TEST SQLEXT ACCESS SELECT information_schema;
TEST SQLEXT ACCESS INSERT information_schema;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'information_schema'
TEST SQLEXT ACCESS SELECT performance_schema;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'performance_schema'
# The current database is checked through the privileges cached for it
USE db1;
TEST SQLEXT ACCESS LOCK_TABLES db1;
TEST SQLEXT ACCESS CREATE_TEMPORARY_TABLES db1;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db1'
# Global grants count
connection default;
CREATE USER u2@localhost;
GRANT SELECT ON *.* TO u2@localhost;
connect  u2, localhost, u2,,;
TEST SQLEXT ACCESS SELECT db1;
TEST SQLEXT ACCESS SELECT db1 t2;
TEST SQLEXT ACCESS INSERT db1;
ERROR 42000: Access denied for user 'u2'@'localhost' to database 'db1'
disconnect u2;
# Grants of the active role and of PUBLIC count
connection default;
CREATE ROLE r1;
GRANT SELECT ON db1.t2 TO r1;
GRANT r1 TO u1@localhost;
GRANT INSERT ON db1.* TO PUBLIC;
connection u1;
TEST SQLEXT ACCESS SELECT db1 t2;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `db1`.`t2`
SET ROLE r1;
TEST SQLEXT ACCESS SELECT db1 t2;
SET ROLE NONE;
TEST SQLEXT ACCESS SELECT db1 t2;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `db1`.`t2`
TEST SQLEXT ACCESS INSERT db1;
TEST SQLEXT ACCESS INSERT db1 t2;
connection default;
REVOKE INSERT ON db1.* FROM PUBLIC;
DELETE FROM mysql.global_priv WHERE user = 'PUBLIC';
FLUSH PRIVILEGES;
DROP ROLE r1;
connection u1;
# The current database's grants are cached until the next USE, as
# for any statement
TEST SQLEXT ACCESS INSERT db1;
USE db1;
TEST SQLEXT ACCESS INSERT db1;
ERROR 42000: Access denied for user 'u1'@'localhost' to database 'db1'
# The client's grants apply to the SQL a handler runs
TEST SQLEXT SQL SELECT a, CURRENT_USER() AS u FROM db1.t1;
a	u
1	u1@localhost
TEST SQLEXT SQL SELECT * FROM db1.t2;
ERROR 42000: SELECT command denied to user 'u1'@'localhost' for table `db1`.`t2`
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (2);
ERROR 42000: INSERT command denied to user 'u1'@'localhost' for table `db1`.`t1`
# The plain SQL service skips them
TEST SQLEXT LOCAL SQL INSERT INTO db1.t1 VALUES (2);
# The client's current database
USE db1;
TEST SQLEXT SQL SELECT DATABASE() AS db, COUNT(*) AS n FROM t1;
db	n
db1	2
disconnect u1;
connection default;
# The client's transaction
BEGIN;
affected rows: 0
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (3), (4);
affected rows: 2
ROLLBACK;
affected rows: 0
SELECT * FROM db1.t1 ORDER BY a;
a
1
2
# A statement that fails after sending some rows (the second row's
# subquery returns two rows): the error is relayed, and the rows
# already read are freed (checked under ASan)
TEST SQLEXT SQL SELECT IF(a = 2, (SELECT 1 UNION ALL SELECT 2), a) AS v FROM db1.t1 ORDER BY a;
ERROR 21000: Subquery returns more than 1 row
TEST SQLEXT LOCAL SQL SELECT IF(a = 2, (SELECT 1 UNION ALL SELECT 2), a) AS v FROM db1.t1 ORDER BY a;
ERROR 21000: Subquery returns more than 1 row
TEST SQLEXT SQL SELECT COUNT(*) AS n FROM db1.t1;
n
2
# SQL a handler runs after raising an error leaves that error to the
# statement, also when the SQL fails, and through the plain service
TEST SQLEXT RAISE SELECT 1 AS a;
ERROR HY000: test_sql_extension: raised before its SQL
TEST SQLEXT RAISE SELECT * FROM no_such_table;
ERROR HY000: test_sql_extension: raised before its SQL
TEST SQLEXT LOCAL RAISE SELECT 1 AS a;
ERROR HY000: test_sql_extension: raised before its SQL
# A connection opened for one statement cannot be used by a later
# one, nor by another client
TEST SQLEXT KEEP SELECT 1 AS a;
a
1
TEST SQLEXT REUSE SELECT 2 AS b;
ERROR HY000: This connection can only be used by the execute() of the SQL extension statement it was opened for
connect  con3, localhost, root,,;
TEST SQLEXT REUSE SELECT 2 AS b;
ERROR HY000: This connection can only be used by the execute() of the SQL extension statement it was opened for
disconnect con3;
connection default;
TEST SQLEXT KEEP CLOSE;
# nor by another thread of the plugin, even during the statement
TEST SQLEXT THREAD SELECT 1 AS a;
ERROR HY000: test_sql_extension: refused: This connection can only be used by the execute() of the SQL extension statement it was opened for
#
# SQL that changes the client's session or transaction: it does,
# as when the client sends it
#
CREATE TABLE db1.t3 (a INT) ENGINE=InnoDB;
# COMMIT, ROLLBACK and an implicit commit end the client's transaction
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (1);
TEST SQLEXT SQL COMMIT;
SELECT @@in_transaction;
@@in_transaction
0
ROLLBACK;
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (2);
TEST SQLEXT SQL CREATE TABLE db1.t4 (a INT);
SELECT @@in_transaction;
@@in_transaction
0
ROLLBACK;
DROP TABLE db1.t4;
BEGIN;
TEST SQLEXT SQL INSERT INTO db1.t3 VALUES (3);
TEST SQLEXT SQL ROLLBACK;
SELECT @@in_transaction;
@@in_transaction
0
SELECT * FROM db1.t3 ORDER BY a;
a
1
2
# START TRANSACTION and autocommit start or set the client's
TEST SQLEXT SQL START TRANSACTION;
SELECT @@in_transaction;
@@in_transaction
1
ROLLBACK;
TEST SQLEXT SQL SET autocommit= 0;
SELECT @@autocommit;
@@autocommit
0
SET autocommit= 1;
# USE changes the client's current database
TEST SQLEXT SQL USE db1;
SELECT DATABASE();
DATABASE()
db1
USE test;
# LOCK TABLES and UNLOCK TABLES lock and unlock the client's tables
TEST SQLEXT SQL LOCK TABLES db1.t3 READ;
SELECT COUNT(*) FROM db1.t1;
ERROR HY000: Table 't1' was not locked with LOCK TABLES
UNLOCK TABLES;
LOCK TABLES db1.t3 READ;
TEST SQLEXT SQL UNLOCK TABLES;
SELECT COUNT(*) FROM db1.t1;
COUNT(*)
2
DROP TABLE db1.t3;
# EXECUTE of a prepared extension statement is refused like the
# statement itself
PREPARE s FROM 'TEST SQLEXT OK';
TEST SQLEXT FORWARD EXECUTE s;
ERROR HY000: Cannot execute a statement of SQL extension plugin 'test_sql_extension' from the handler of plugin 'test_sql_extension'
TEST SQLEXT SQL EXECUTE s;
ERROR HY000: Cannot execute a statement of SQL extension plugin 'test_sql_extension' from the handler of plugin 'test_sql_extension'
TEST SQLEXT LOCAL SQL EXECUTE s;
ERROR HY000: Cannot execute a statement of SQL extension plugin 'test_sql_extension' from the handler of plugin 'test_sql_extension'
EXECUTE s;
DEALLOCATE PREPARE s;
#
# LOCK TABLES: the client's locked tables
#
LOCK TABLES db1.t1 WRITE;
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (5);
TEST SQLEXT SQL SELECT * FROM db1.t2;
ERROR HY000: Table 't2' was not locked with LOCK TABLES
# Forwarded SQL runs on the client's THD too, with its locks
TEST SQLEXT FORWARD SELECT COUNT(*) AS n FROM db1.t1;
n
3
TEST SQLEXT FORWARD SELECT * FROM db1.t2;
ERROR HY000: Table 't2' was not locked with LOCK TABLES
UNLOCK TABLES;
LOCK TABLES db1.t1 READ;
TEST SQLEXT SQL SELECT COUNT(*) AS n FROM db1.t1;
n
3
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (6);
ERROR HY000: Table 't1' was locked with a READ lock and can't be updated
TEST SQLEXT FORWARD INSERT INTO db1.t1 VALUES (6);
ERROR HY000: Table 't1' was locked with a READ lock and can't be updated
UNLOCK TABLES;
# ROLLBACK undoes the handler's changes; the locks stay
SET autocommit= 0;
LOCK TABLES db1.t1 WRITE;
TEST SQLEXT SQL INSERT INTO db1.t1 VALUES (7);
ROLLBACK;
SELECT COUNT(*) AS n FROM db1.t1 WHERE a = 7;
n
0
# Other connections still wait for the client's lock
connect  con2, localhost, root,,;
SELECT COUNT(*) AS n FROM db1.t1;
connection default;
UNLOCK TABLES;
SET autocommit= 1;
connection con2;
n
3
disconnect con2;
connection default;
#
# KILL QUERY and max_statement_time stop the SQL a handler runs
#
# The timer of the extension statement applies: the SQL fails, as
# in a stored procedure (a plain SELECT SLEEP() would return 1)
SET max_statement_time= 0.2;
TEST SQLEXT SQL SELECT SLEEP(10) AS s;
ERROR 70100: Query was interrupted: execution time limit 0.2 sec exceeded
SET max_statement_time= DEFAULT;
TEST SQLEXT SQL SELECT 1 AS a;
a
1
# KILL QUERY while the SQL runs
connect  con1, localhost, root,,;
TEST SQLEXT SQL SELECT SLEEP(100);
connection default;
connection con1;
ERROR 70100: Query execution was interrupted
# The connection is usable afterwards
TEST SQLEXT SQL SELECT 1 AS a;
a
1
disconnect con1;
connection default;
# KILL CONNECTION while the SQL runs: the connection ends
connect  con1, localhost, root,,;
TEST SQLEXT SQL SELECT SLEEP(100);
connection default;
connection con1;
