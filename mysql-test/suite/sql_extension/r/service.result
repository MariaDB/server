#
# SQL whose error rolls back the client's transaction (a deadlock)
# fails the statement with that error, even if the handler drops it
#
CREATE TABLE db1.t5 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO db1.t5 VALUES (1, 0), (2, 0);
CREATE TABLE db1.t6 (a INT) ENGINE=InnoDB;
connect  con_dl, localhost, root,,;
# The other transaction does more work, so InnoDB picks the client's
# as the victim
BEGIN;
INSERT INTO db1.t6 VALUES (1), (2), (3), (4), (5), (6), (7), (8);
UPDATE db1.t5 SET v= 2 WHERE id= 2;
connection default;
BEGIN;
INSERT INTO db1.t6 VALUES (100);
UPDATE db1.t5 SET v= 1 WHERE id= 1;
TEST SQLEXT SWALLOW UPDATE db1.t5 SET v= 1 WHERE id= 2;
connection con_dl;
UPDATE db1.t5 SET v= 2 WHERE id= 1;
COMMIT;
disconnect con_dl;
connection default;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
# The client's transaction is gone, with its INSERT
SELECT @@in_transaction;
@@in_transaction
0
SELECT COUNT(*) AS n FROM db1.t6 WHERE a = 100;
n
0
SELECT * FROM db1.t5 ORDER BY id;
id	v
1	2
2	2
UPDATE db1.t5 SET v= 0;
DELETE FROM db1.t6;
