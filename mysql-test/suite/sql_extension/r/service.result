# But not when the error escapes the procedure's handler, which the
# handler of the extension statement then drops: RESIGNAL
CREATE PROCEDURE db1.p_resignal()
BEGIN
DECLARE EXIT HANDLER FOR 1213 RESIGNAL;
UPDATE db1.t5 SET v= 1 WHERE id= 2;
END|
# or another error
CREATE PROCEDURE db1.p_other()
BEGIN
DECLARE EXIT HANDLER FOR 1213
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= 'after the deadlock';
UPDATE db1.t5 SET v= 1 WHERE id= 2;
END|
# Nor does a later error with the same number make up for a
# deadlock the extension's handler dropped
CREATE PROCEDURE db1.p_same_errno()
BEGIN
DECLARE CONTINUE HANDLER FOR 1213 SET @dl= 'signal handled';
SIGNAL SQLSTATE '40001' SET MYSQL_ERRNO= 1213;
END|
connect  con_dl, localhost, root,,;
# The other transaction does more work, so InnoDB picks the client's
# as the victim
BEGIN;
INSERT INTO db1.t6 VALUES (1), (2), (3), (4), (5), (6), (7), (8);
UPDATE db1.t5 SET v= 2 WHERE id= 2;
connection default;
BEGIN;
INSERT INTO db1.t6 VALUES (100);
UPDATE db1.t5 SET v= 1 WHERE id= 1;
TEST SQLEXT SWALLOW CALL db1.p_resignal();
connection con_dl;
UPDATE db1.t5 SET v= 2 WHERE id= 1;
COMMIT;
disconnect con_dl;
connection default;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
# The client's transaction is gone, with its INSERT
