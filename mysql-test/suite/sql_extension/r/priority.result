#
# MDEV-41962 Recognizers are asked by priority, not by installation order
#
# The lower-priority recognizer first, the higher one second
INSTALL PLUGIN test_sql_extension_recognizer SONAME 'test_sql_extension';
INSTALL PLUGIN test_sql_extension_priority SONAME 'test_sql_extension';
# Both claim this: priority 10 wins over priority 0
TEST RECOGNIZE x;
affected rows: 0
info: test_sql_extension_priority
# The higher one declines, so the lower one gets it
TEST RECOGNIZE LOW x;
affected rows: 0
TEST RECOGNIZE LOW ECHO lower;
ERROR HY000: test_sql_extension: [TEST RECOGNIZE LOW ECHO lower]
# A claim past the end by the higher one fails, naming it: the
# lower one is not asked
TEST RECOGNIZE PAST;
ERROR HY000: SQL extension plugin 'test_sql_extension_priority' sent an invalid result: recognize() claimed 29 bytes of a 19-byte statement
# The same the other way round
UNINSTALL PLUGIN test_sql_extension_recognizer;
UNINSTALL PLUGIN test_sql_extension_priority;
INSTALL PLUGIN test_sql_extension_priority SONAME 'test_sql_extension';
INSTALL PLUGIN test_sql_extension_recognizer SONAME 'test_sql_extension';
TEST RECOGNIZE x;
affected rows: 0
info: test_sql_extension_priority
TEST RECOGNIZE LOW x;
affected rows: 0
# A claimed prefix comes before any recognizer: test_sql_extension
# owns TEST SQLEXT, which test_sql_extension_priority would claim too
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
TEST SQLEXT PRIORITY;
ERROR HY000: test_sql_extension: unknown 'PRIORITY'
UNINSTALL PLUGIN test_sql_extension;
TEST SQLEXT PRIORITY;
affected rows: 0
info: test_sql_extension_priority
# Without the higher one, the lower one takes everything
UNINSTALL PLUGIN test_sql_extension_priority;
TEST RECOGNIZE x;
affected rows: 0
UNINSTALL PLUGIN test_sql_extension_recognizer;
# End of 13.2 tests
