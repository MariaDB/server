#
# MDEV-41962 Several results per statement, and results of SQL run as the client
# sent to the client as they are (sql_extension_forward_sql())
#
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
# Text protocol where the flags or several statements matter: a
# prepared statement never allows several statements
TEST SQLEXT FLAGS;
multi_results	multi_statements
1	1
#
# Results made by the plugin: each but the last is followed by more
#
TEST SQLEXT TWICE;
affected rows: 0
affected rows: 0
TEST SQLEXT MULTI;
first
1
affected rows: 1
affected rows: 2
info: test_sql_extension: second
third
3
affected rows: 1
# An error after a result: the result, then the error
TEST SQLEXT MULTI ERROR;
first
1
ERROR HY000: test_sql_extension: error after rows
# Prepared: the same results, and never several statements
PREPARE s FROM 'TEST SQLEXT MULTI';
EXECUTE s;
first
1
third
3
EXECUTE s;
first
1
third
3
PREPARE s FROM 'TEST SQLEXT FLAGS';
EXECUTE s;
multi_results	multi_statements
1	0
DEALLOCATE PREPARE s;
# A client that does not accept several results: see results_debug.test
#
# Forwarded results: as the server sends them
#
CREATE TABLE t1 (a INT PRIMARY KEY AUTO_INCREMENT, b DECIMAL(5,2),
c DATETIME(3), j JSON) ENGINE=InnoDB;
TEST SQLEXT FORWARD INSERT INTO t1 (b, c, j) VALUES (1.5, '2026-11-06 10:20:30.123', '[1]'), (2.25, NULL, NULL);
affected rows: 2
info: Records: 2  Duplicates: 0  Warnings: 0
# The client's insert id is that of the forwarded INSERT, and of an
# INSERT a handler runs as the client
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
1
CREATE TABLE t2 (a INT PRIMARY KEY AUTO_INCREMENT, b INT) AUTO_INCREMENT=10;
TEST SQLEXT SQL INSERT INTO t2 (b) VALUES (1), (2);
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
10
DROP TABLE t2;
# The same metadata as the SELECT itself
SELECT * FROM t1;
