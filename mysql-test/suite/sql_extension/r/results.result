a	b	c	j
1	1.50	2026-11-06 10:20:30.123	[1]
2	2.25	NULL	NULL
TEST SQLEXT FORWARD SELECT * FROM t1;
Catalog	Database	Table	Table_alias	Column	Column_alias	Type	Length	Max length	Is_null	Flags	Decimals	Charsetnr
def	test	t1	t1	a	a	3	11	1	N	49667	0	63
def	test	t1	t1	b	b	246	7	4	Y	32768	2	63
def	test	t1	t1	c	c	12	23	23	Y	128	3	63
def	test	t1	t1	j	j	252 (format=json)	4294967295	3	Y	144	0	8
a	b	c	j
1	1.50	2026-11-06 10:20:30.123	[1]
2	2.25	NULL	NULL
# The same rows through the binary protocol, under --ps-protocol
TEST SQLEXT FORWARD SELECT * FROM t1;
a	b	c	j
1	1.50	2026-11-06 10:20:30.123	[1]
2	2.25	NULL	NULL
