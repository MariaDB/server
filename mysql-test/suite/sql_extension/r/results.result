# One statement only: no text is an empty query, a trailing ';' is
# fine, a second statement is a syntax error
TEST SQLEXT FORWARD;
ERROR 42000: Query was empty
TEST SQLEXT FORWARD 'SELECT 1 AS a;';
a
1
TEST SQLEXT FORWARD 'SELECT 1 AS a; SELECT 2 AS b';
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'SELECT 2 AS b' at line 1
#
# An extension statement that stands for a CALL: the client gets what
# the CALL itself returns
#
CREATE PROCEDURE p()
BEGIN
SELECT a, b FROM t1 ORDER BY a;
SELECT COUNT(*) AS n FROM t1;
UPDATE t1 SET b= b + 1 WHERE a = 1;
END|
CREATE PROCEDURE p_err()
BEGIN
SELECT 1 AS x;
SELECT * FROM no_such_table;
SELECT 2 AS y;
END|
CALL p();
a	b
1	1.50
2	2.25
affected rows: 2
n
2
affected rows: 1
affected rows: 1
TEST SQLEXT FORWARD CALL p();
a	b
1	2.50
2	2.25
affected rows: 2
n
2
affected rows: 1
affected rows: 1
CALL p_err();
x
1
ERROR 42S02: Table 'test.no_such_table' doesn't exist
TEST SQLEXT FORWARD CALL p_err();
x
1
ERROR 42S02: Table 'test.no_such_table' doesn't exist
# As for CALL, the client must accept several results: see
# results_debug.test
# Prepared
PREPARE s FROM 'TEST SQLEXT FORWARD CALL p()';
EXECUTE s;
a	b
1	3.50
2	2.25
n
2
EXECUTE s;
a	b
1	4.50
2	2.25
n
2
DEALLOCATE PREPARE s;
#
# Extension statements that send results inside a CALL: each result
# is followed by more, and the CALL's own OK comes last
#
CREATE PROCEDURE p_ext()
BEGIN
EXECUTE IMMEDIATE 'TEST SQLEXT MULTI';
EXECUTE IMMEDIATE 'TEST SQLEXT FORWARD SELECT 1 AS a';
SELECT 2 AS b;
END|
CREATE PROCEDURE p_ext_err()
BEGIN
EXECUTE IMMEDIATE 'TEST SQLEXT MULTI ERROR';
SELECT 'not run' AS c;
END|
CALL p_ext();
first
1
affected rows: 1
affected rows: 2
info: test_sql_extension: second
third
3
affected rows: 1
a
1
affected rows: 1
b
2
affected rows: 1
affected rows: 2
CALL p_ext_err();
first
1
ERROR HY000: test_sql_extension: error after rows
# Prepared
PREPARE s FROM 'CALL p_ext()';
EXECUTE s;
first
1
third
3
a
1
b
2
EXECUTE s;
first
1
third
3
a
1
b
2
DEALLOCATE PREPARE s;
# The connection is still in step
SELECT 'next' AS r;
r
next
DROP PROCEDURE p_ext;
DROP PROCEDURE p_ext_err;
#
# A script: the results of its statements, until one fails
#
TEST SQLEXT SCRIPT 'SELECT COUNT(*) AS n FROM t1; UPDATE t1 SET b= 0 WHERE a = 2; SELECT b FROM t1 WHERE a = 2'|
n
2
affected rows: 1
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
b
0.00
affected rows: 1
TEST SQLEXT SCRIPT 'SELECT 1 AS a; SELECT * FROM no_such_table; SELECT 2 AS b'|
a
1
ERROR 42S02: Table 'test.no_such_table' doesn't exist
# Several statements need a packet that allows them: see
# results_debug.test
#
# Forwarded SQL runs as the client
#
CREATE USER u1@localhost;
GRANT SELECT ON test.t1 TO u1@localhost;
GRANT EXECUTE ON PROCEDURE test.p TO u1@localhost;
connect  u1, localhost, u1,,;
TEST SQLEXT FORWARD SELECT a, CURRENT_USER() AS u FROM test.t1 ORDER BY a;
a	u
1	u1@localhost
2	u1@localhost
TEST SQLEXT FORWARD DELETE FROM test.t1;
ERROR 42000: DELETE command denied to user 'u1'@'localhost' for table `test`.`t1`
# The procedure runs with its definer's rights, as with CALL
TEST SQLEXT FORWARD CALL test.p();
a	b
1	5.50
2	0.00
affected rows: 2
n
2
affected rows: 1
affected rows: 1
disconnect u1;
connection default;
DROP USER u1@localhost;
# Its transaction
BEGIN;
affected rows: 0
TEST SQLEXT FORWARD DELETE FROM t1;
affected rows: 2
ROLLBACK;
affected rows: 0
SELECT COUNT(*) AS n FROM t1;
n
2
# The timer of the extension statement applies: the SQL fails, as
# in a stored procedure (a plain SELECT SLEEP() would return 1)
SET max_statement_time= 0.2;
TEST SQLEXT FORWARD SELECT SLEEP(10) AS s;
ERROR 70100: Query was interrupted: execution time limit 0.2 sec exceeded
SET max_statement_time= DEFAULT;
TEST SQLEXT FORWARD SELECT 1 AS a;
a
1
# KILL QUERY while the SQL runs
connect  con1, localhost, root,,;
TEST SQLEXT FORWARD SELECT SLEEP(100);
connection default;
connection con1;
ERROR 70100: Query execution was interrupted
# The connection is usable afterwards
TEST SQLEXT FORWARD SELECT 1 AS a;
a
1
disconnect con1;
connection default;
# KILL CONNECTION while the SQL runs: the connection ends
connect  con1, localhost, root,,;
TEST SQLEXT FORWARD SELECT SLEEP(100);
connection default;
connection con1;
Got one of the listed errors
disconnect con1;
connection default;
DROP PROCEDURE p;
DROP PROCEDURE p_err;
DROP TABLE t1;
UNINSTALL PLUGIN test_sql_extension;
# End of 13.2 tests
