#
# MDEV-41962 Results for clients that accept neither several results nor several
# statements, simulated with debug flags (the rest is in results.test)
#
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
# A client that does not accept several results gets one
SET debug_dbug= '+d,sql_extension_no_client_multi_results';
TEST SQLEXT FLAGS;
multi_results	multi_statements
0	1
TEST SQLEXT ROWS;
s	b	i	u
café	bÿn	-9223372036854775808	18446744073709551615
	NULL	0	NULL
affected rows: 2
TEST SQLEXT TWICE;
ERROR HY000: SQL extension plugin 'test_sql_extension' sent an invalid result: the client does not accept several results
TEST SQLEXT MULTI;
ERROR HY000: SQL extension plugin 'test_sql_extension' sent an invalid result: the client does not accept several results
# and only the error after rows
TEST SQLEXT MULTI ERROR;
ERROR HY000: test_sql_extension: error after rows
SET debug_dbug= '';
# An OK the plugin set itself, not through the service (a plugin
# built with the server headers can call my_ok()), is refused: at
# the end of the statement, and at the first result of the service,
# so that the client gets none of the results
SET debug_dbug= '+d,sql_extension_plugin_sets_ok';
TEST SQLEXT OK;
ERROR HY000: SQL extension plugin 'test_sql_extension' sent an invalid result: a result was set outside the service
TEST SQLEXT MULTI;
ERROR HY000: SQL extension plugin 'test_sql_extension' sent an invalid result: a result was set outside the service
SET debug_dbug= '';
TEST SQLEXT OK;
UNINSTALL PLUGIN test_sql_extension;
# End of 13.2 tests
