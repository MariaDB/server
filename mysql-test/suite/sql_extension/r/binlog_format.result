#
# MDEV-41962 The SQL of a handler is logged in the format the session's
# binlog_format gives it, as the statements of a CALL are: an unsafe
# statement is logged as rows under MIXED
#
INSTALL PLUGIN test_sql_extension SONAME 'test_sql_extension';
CREATE TABLE t1 (a VARCHAR(40)) ENGINE=InnoDB;
SELECT @@session.binlog_format;
@@session.binlog_format
MIXED
# Unsafe (UUID()): rows, from the client, as the client, forwarded
INSERT INTO t1 VALUES (UUID());
TEST SQLEXT SQL INSERT INTO t1 VALUES (UUID());
TEST SQLEXT FORWARD INSERT INTO t1 VALUES (UUID());
# Safe: a statement
TEST SQLEXT SQL INSERT INTO t1 VALUES ('safe');
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Annotate_rows	#	#	INSERT INTO t1 VALUES (UUID())
mysqld-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
mysqld-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Annotate_rows	#	#	INSERT INTO t1 VALUES (UUID())
mysqld-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
mysqld-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Annotate_rows	#	#	INSERT INTO t1 VALUES (UUID())
mysqld-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
mysqld-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Query	#	#	use `test`; INSERT INTO t1 VALUES ('safe')
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
# The session's binlog_format is as it was
SELECT @@session.binlog_format;
@@session.binlog_format
MIXED
# STATEMENT: a statement
SET SESSION binlog_format= STATEMENT;
TEST SQLEXT SQL INSERT INTO t1 VALUES ('stmt');
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Query	#	#	use `test`; INSERT INTO t1 VALUES ('stmt')
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
# ROW: rows
SET SESSION binlog_format= ROW;
TEST SQLEXT SQL INSERT INTO t1 VALUES ('row');
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Annotate_rows	#	#	INSERT INTO t1 VALUES ('row')
mysqld-bin.000001	#	Table_map	#	#	table_id: # (test.t1)
mysqld-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
SET SESSION binlog_format= DEFAULT;
DROP TABLE t1;
UNINSTALL PLUGIN test_sql_extension;
