INSTALL PLUGIN simple_parser SONAME 'mypluglib';
# Fulltext parser with ROW_FORMAT=PAGE
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
RENAME TABLE t1 TO t2;
SELECT a FROM t2 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t2;
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
ALTER TABLE t1 ADD COLUMN b INT, ALGORITHM=COPY;
SELECT a FROM t1 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t1;
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
REPAIR TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	repair	status	OK
SELECT a FROM t1 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t1;
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
REPAIR TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	repair	status	OK
SELECT a FROM t1 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t1;
CREATE TABLE t1 (a TEXT)
ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
ALTER TABLE t1 ADD FULLTEXT(a) WITH PARSER simple_parser, ALGORITHM=COPY;
SELECT a FROM t1 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t1;
# Fulltext parser with ROW_FORMAT=DYNAMIC
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=DYNAMIC TRANSACTIONAL=0;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
RENAME TABLE t1 TO t2;
SELECT a FROM t2 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
DROP TABLE t2;
CREATE TABLE t1 (a TEXT, FULLTEXT(a) WITH PARSER simple_parser) ENGINE=Aria ROW_FORMAT=DYNAMIC TRANSACTIONAL=0;
INSERT INTO t1 VALUES ('abc-def'), ('abcd-efgh'), ('other text');
ALTER TABLE t1 ADD COLUMN b INT, ALGORITHM=COPY;
SELECT a FROM t1 WHERE MATCH(a) AGAINST('abc-def abcd');
a
abc-def
