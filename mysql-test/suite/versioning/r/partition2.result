# STARTS after the oldest history is re-aligned: WARN_VERS_WRONG_STARTS
alter table t1 remove partitioning;
alter table t1 partition by system_time interval 1 hour
starts '2002-01-01 00:00:00' auto;
Warnings:
Warning	4276	`t1`: STARTS timestamp 2002-01-01 00:00:00 is after earliest history timestamp 2000-01-01 00:10:00.220000 and was set to 2000-01-01 00:00:00
alter table t1 force partition by system_time interval 1 hour
starts '2003-01-01 00:00:00' auto;
Warnings:
Warning	4276	`t1`: STARTS timestamp 2003-01-01 00:00:00 is after earliest history timestamp 2000-01-01 00:10:00.220000 and was set to 2000-01-01 00:00:00
