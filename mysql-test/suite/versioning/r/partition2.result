# Month/year history partition boundaries must be stepped in UTC, not in
# the session time zone. Under a DST zone (MET: CET=+1 winter,
# CEST=+2 summer, spring-forward 2024-03-31) the two disagree.
#
# STARTS aligns to local 2024-02-15 00:00 MET = 2024-02-14 23:00 UTC.
# Max history row_end is 2024-04-14 22:30:00 UTC, which falls in the
# one-hour gap between the UTC boundary (Apr 14 23:00) and the
# session-zone boundary (Apr 14 22:00, shifted by the +2 summer offset).
# UTC stepping covers it with two history partitions (PARTITIONS 3);
# stepping in MET would add one more (PARTITIONS 4). The query time
# (22:45 UTC) is inside the same gap.
set time_zone= 'MET';
create or replace table t1 (x int) with system versioning;
set timestamp= unix_timestamp('2024-02-15 12:00:00');
insert t1 values (1);
delete from t1;
set timestamp= unix_timestamp('2024-04-15 00:30:00');
insert t1 values (2);
delete from t1;
set timestamp= unix_timestamp('2024-04-15 00:45:00');
alter table t1 partition by system_time interval 1 month auto;
