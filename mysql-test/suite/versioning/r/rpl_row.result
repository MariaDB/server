include/master-slave.inc
[connection master]
# MDEV-16252: MINIMAL binlog_row_image does not work for versioned tables
set @old_row_image= @@binlog_row_image;
set binlog_row_image= minimal;
create or replace table t1 (pk int, i int, primary key(pk))
with system versioning;
insert into t1 values (1,10),(2,20);
update t1 set i = 0;
connection slave;
connection master;
drop table t1;
set binlog_row_image= @old_row_image;
#
# MDEV-28254 Wrong position for row_start, row_end after adding column
#            to implicit versioned table
#
set @@system_versioning_alter_history= keep;
set @@session.time_zone='+00:00';
create table t1 (x int) with system versioning engine innodb;
alter table t1 add column y int, algorithm=inplace;
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
connection slave;
drop table t1;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `x` int(11) DEFAULT NULL,
  `y` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci WITH SYSTEM VERSIONING
connection master;
set timestamp= 12345;
insert t1 values (1, 1);
select *, unix_timestamp(row_start) as row_start, unix_timestamp(row_end) as row_end from t1;
x	y	row_start	row_end
1	1	12345.000000	TIMESTAMP_MAX.999999
set timestamp= default;
### INSERT INTO `test`.`t1`
### SET
###   @1=1
###   @2=1
###   @3=12345.000000
###   @4=MAX_TIMESTAMP.999999
connection slave;
select * from t1;
x	y
1	1
connection master;
drop table t1;
#
# MDEV-31297 Create table as select on system versioned tables do not work consistently on replication
#
connection master;
create table t engine=innodb with system versioning as select 1 as i;
show create table t;
Table	Create Table
t	CREATE TABLE `t` (
  `i` int(1) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci WITH SYSTEM VERSIONING
select * from t;
i
1
connection slave;
show create table t;
Table	Create Table
t	CREATE TABLE `t` (
  `i` int(1) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci WITH SYSTEM VERSIONING
select * from t;
i
1
connection master;
drop table t;
#
# MDEV-24646 ASAN heap-use-after-free in Field_blob::pack /
#            THD::binlog_update_row upon DML on table with virtual column
#
connection master;
create table t (a text, v blob as (a) virtual)
with system versioning as select 'foo' as a;
update t set a='bar';
connection slave;
select * from t;
v	a
bar	bar
connection master;
drop table t;
#
# MDEV-39711 UPDATE on System-Versioned Tables uses the after-value
#            in Row-format Binlog's before-image
#            for non-trivial Text/Blob Virtual Columns
#
connection master;
create table t (a text, v text as (right(a, 1)) virtual)
with system versioning as select 'before' as a;
update t set a='after';
connection slave;
select * from t;
v	a
r	after
connection master;
drop table t;
connection slave;
#
# MDEV-39306 Index corruption on UPDATE when using versioned InnoDB
#            table (on UPDATE)
#            Unversioned master, versioned slave, minimal row image
#
connection master;
set statement sql_log_bin=0 for
create table t (id int primary key, a text, v text as (right(a, 1)) virtual,
key (v(10))) engine=innodb;
connection slave;
set statement sql_log_bin=0 for
create table t (id int primary key, a text, v text as (right(a, 1)) virtual,
rs timestamp(6) as row start invisible,
re timestamp(6) as row end invisible,
period for system_time (rs, re),
w decimal(20,6) as (id + unix_timestamp(rs)) virtual,
ws decimal(20,6) as (id + unix_timestamp(rs)) stored,
key (v(10)), key (w), key (ws))
engine=innodb with system versioning;
connection master;
set @old_row_image= @@binlog_row_image;
set binlog_row_image= minimal;
insert t (id, a) values (1, 'before'), (2, 'start');
update t set a= 'after';
set binlog_row_image= @old_row_image;
connection slave;
check table t extended;
Table	Op	Msg_type	Msg_text
test.t	check	status	OK
select id, a, v, ws = id + unix_timestamp(rs) as ok
from t for system_time all force index (v) order by v, id;
id	a	v	ok
1	before	e	1
1	after	r	1
2	after	r	1
2	start	t	1
connection master;
drop table t;
connection slave;
#
# MDEV-39306 Index corruption on UPDATE when using versioned InnoDB
#            table (on UPDATE)
#            Unversioned master, versioned slave, failed update
#
connection master;
set statement sql_log_bin=0 for
create table t (id int primary key, a int) engine=innodb;
connection slave;
call mtr.add_suppression("Slave SQL.*Duplicate entry");
set statement sql_log_bin=0 for
create table t (id int primary key, a int, unique (a))
engine=innodb with system versioning;
connection master;
insert t values (1, 1), (2, 2);
update t set a= 2 where id = 1;
include/wait_for_slave_sql_error_and_skip.inc [errno=1062]
connection slave;
select id, a, row_end > now(6) as current
from t for system_time all order by id, current;
id	a	current
1	1	1
2	2	1
connection master;
drop table t;
connection slave;
connection master;
# End of 10.11 tests
#
# MDEV-25347 DML events for auto-partitioned tables are written into binary log twice
#
flush binary logs;
create table t1 (a int) with system versioning
partition by system_time limit 1 auto;
insert into t1 values (1);
update t1 set a= a + 1;
update t1 set a= a + 2;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=ENGINE DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci WITH SYSTEM VERSIONING
 PARTITION BY SYSTEM_TIME LIMIT 1 AUTO
PARTITIONS 3
select * from t1;
a
4
include/show_binlog_events.inc
