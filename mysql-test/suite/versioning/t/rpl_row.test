--source include/have_binlog_format_row.inc
--source include/master-slave.inc
--source include/have_innodb.inc
--source suite/versioning/sys_time.inc

--echo # MDEV-16252: MINIMAL binlog_row_image does not work for versioned tables
set @old_row_image= @@binlog_row_image;
set binlog_row_image= minimal;

create or replace table t1 (pk int, i int, primary key(pk))
with system versioning;
insert into t1 values (1,10),(2,20);
update t1 set i = 0;

--sync_slave_with_master
--connection master
drop table t1;
set binlog_row_image= @old_row_image;

--echo #
--echo # MDEV-28254 Wrong position for row_start, row_end after adding column
--echo #            to implicit versioned table
--echo #
--let TMP= $MYSQLTEST_VARDIR/tmp
--let $MYSQLD_DATADIR= `select @@datadir`
set @@system_versioning_alter_history= keep;
set @@session.time_zone='+00:00';

create table t1 (x int) with system versioning engine innodb;
alter table t1 add column y int, algorithm=inplace;
check table t1;
--exec $MYSQL_DUMP --databases test > $TMP/dump.sql

--sync_slave_with_master
drop table t1;
--exec $MYSQL_SLAVE test < $TMP/dump.sql
show create table t1;

--connection master
set timestamp= 12345;
--let $start_pos= query_get_value("SHOW MASTER STATUS", Position, 1)
insert t1 values (1, 1);
--replace_result $sys_timestamp_max TIMESTAMP_MAX
select *, unix_timestamp(row_start) as row_start, unix_timestamp(row_end) as row_end from t1;
--let $stop_pos= query_get_value("SHOW MASTER STATUS", Position, 1)
set timestamp= default;

# NOTE: pipe grep is not Windows-compatible
--let grep_file= $TMP/out.txt
--let grep_regex= ^###
--let grep_filter=s{$sys_timestamp_max}{MAX_TIMESTAMP};
--exec $MYSQL_BINLOG -v -j $start_pos --stop-position=$stop_pos -o 3 $MYSQLD_DATADIR/master-bin.000001 > $grep_file
--source include/grep.inc
--sync_slave_with_master
select * from t1;

--connection master
drop table t1;
--remove_files_wildcard $TMP *.txt
--remove_files_wildcard $TMP *.sql

--echo #
--echo # MDEV-31297 Create table as select on system versioned tables do not work consistently on replication
--echo #
--connection master
create table t engine=innodb with system versioning as select 1 as i;
show create table t;
select * from t;

--sync_slave_with_master
show create table t;
select * from t;

--connection master
drop table t;

--echo #
--echo # MDEV-24646 ASAN heap-use-after-free in Field_blob::pack /
--echo #            THD::binlog_update_row upon DML on table with virtual column
--echo #
--connection master
create table t (a text, v blob as (a) virtual)
  with system versioning as select 'foo' as a;

update t set a='bar';
--sync_slave_with_master
select * from t;
--connection master
drop table t;

--echo #
--echo # MDEV-39711 UPDATE on System-Versioned Tables uses the after-value
--echo #            in Row-format Binlog's before-image
--echo #            for non-trivial Text/Blob Virtual Columns
--echo #
--connection master
create table t (a text, v text as (right(a, 1)) virtual)
  with system versioning as select 'before' as a;

update t set a='after';
--sync_slave_with_master
select * from t;
--connection master
drop table t;
--sync_slave_with_master

--echo #
--echo # MDEV-39306 Index corruption on UPDATE when using versioned InnoDB
--echo #            table (on UPDATE)
--echo #            Unversioned master, versioned slave, minimal row image
--echo #
--connection master
set statement sql_log_bin=0 for
create table t (id int primary key, a text, v text as (right(a, 1)) virtual,
                key (v(10))) engine=innodb;
--connection slave
set statement sql_log_bin=0 for
create table t (id int primary key, a text, v text as (right(a, 1)) virtual,
                rs timestamp(6) as row start invisible,
                re timestamp(6) as row end invisible,
                period for system_time (rs, re),
                w decimal(20,6) as (id + unix_timestamp(rs)) virtual,
                ws decimal(20,6) as (id + unix_timestamp(rs)) stored,
                key (v(10)), key (w), key (ws))
engine=innodb with system versioning;
--connection master
set @old_row_image= @@binlog_row_image;
set binlog_row_image= minimal;
insert t (id, a) values (1, 'before'), (2, 'start');
update t set a= 'after';
set binlog_row_image= @old_row_image;
--sync_slave_with_master
check table t extended;
select id, a, v, ws = id + unix_timestamp(rs) as ok
from t for system_time all force index (v) order by v, id;
--connection master
drop table t;
--sync_slave_with_master

--echo #
--echo # MDEV-39306 Index corruption on UPDATE when using versioned InnoDB
--echo #            table (on UPDATE)
--echo #            Unversioned master, versioned slave, failed update
--echo #
--connection master
set statement sql_log_bin=0 for
create table t (id int primary key, a int) engine=innodb;
--connection slave
call mtr.add_suppression("Slave SQL.*Duplicate entry");
set statement sql_log_bin=0 for
create table t (id int primary key, a int, unique (a))
engine=innodb with system versioning;
--connection master
insert t values (1, 1), (2, 2);
# Duplicate on the slave only
update t set a= 2 where id = 1;
let $slave_sql_errno= 1062;
--source include/wait_for_slave_sql_error_and_skip.inc
--connection slave
select id, a, row_end > now(6) as current
from t for system_time all order by id, current;
--connection master
drop table t;
--sync_slave_with_master
--connection master

--echo # End of 10.11 tests

--source rpl_common.inc
