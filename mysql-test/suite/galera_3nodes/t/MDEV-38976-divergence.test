#
# MDEV-38976: Galera write loss with process crashes and network partitions
#
# Scenario (reduced from a Jepsen run):
#
# 1. Nodes 1,2,3 form a primary component.
# 2. Node 3 is partitioned away and becomes non-primary. It keeps the old
#    primary component (nodes 1,2,3) in its saved view.
# 3. Nodes 1,2 stay primary and commit more writes.
# 4. Nodes 1,2 are killed at the same time. The partition towards node 3 then
#    heals, and nodes 1,2 are restarted without bootstrapping.
#
# Nodes 1,2 are ahead of node 3, so they abort ("Reversing history"). The test
# checks that the saved state of nodes 1,2 survives the abort.
#
# Node 3 stays primary without the writes from step 3 and accepts new writes.
# (This is a known remaining problem: node 3 should stay non-primary.)
# When its position is past the saved positions of nodes 1,2, they must not
# rejoin with their saved state by IST, because the data would diverge silently:
# nodes 1,2 would miss the first writes of node 3, and node 3 would miss the
# writes from step 3. The saved state of nodes 1,2 is marked as diverged, and
# they refuse to join until the operator intervenes.
#
--source include/big_test.inc
--source include/galera_cluster.inc
--source include/have_innodb.inc

# Galera 26.4.29 marks the saved state (grastate.dat) of a node that aborts
# because it is ahead of the primary component as diverged, and keeps its UUID.
# Earlier versions invalidate it.
--let $galera_version=26.4.29
source ../wsrep/include/check_galera_version.inc;

--source include/force_restart.inc

--let $galera_connection_name = node_3
--let $galera_server_number = 3
--source include/galera_connect.inc

--let $node_1 = node_1
--let $node_2 = node_2
--let $node_3 = node_3
--source ../galera/include/auto_increment_offset_save.inc

# Galera ports, needed for the restart addresses
--connection node_1
--source ../galera/include/galera_base_port.inc
--let $NODE_GALERAPORT_1 = $_NODE_GALERAPORT

--connection node_2
--source ../galera/include/galera_base_port.inc
--let $NODE_GALERAPORT_2 = $_NODE_GALERAPORT

--connection node_3
--source ../galera/include/galera_base_port.inc
--let $NODE_GALERAPORT_3 = $_NODE_GALERAPORT

--connection node_1
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1), (2), (3);

--let $wait_condition = SELECT VARIABLE_VALUE = 3 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

#
# Step 2: partition node 3 away
#
--connection node_3
SET SESSION wsrep_sync_wait = 0;
SET GLOBAL wsrep_provider_options = 'gmcast.isolate=1';
--let $wait_condition = SELECT VARIABLE_VALUE = 'non-Primary' FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_status'
--source include/wait_condition.inc

--connection node_1
SET SESSION wsrep_sync_wait = 0;
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 'Primary' FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_status'
--source include/wait_condition.inc

#
# Step 3: nodes 1,2 advance while node 3 is away. One transaction per row,
# so that nodes 1,2 get ahead of node 3 by more seqnos than the configuration
# changes node 3 goes through before it accepts writes.
#
INSERT INTO t1 VALUES (4);
INSERT INTO t1 VALUES (5);
INSERT INTO t1 VALUES (6);
INSERT INTO t1 VALUES (7);
INSERT INTO t1 VALUES (8);
INSERT INTO t1 VALUES (9);
INSERT INTO t1 VALUES (10);

--connection node_2
SELECT COUNT(*) AS node_2_rows_before_kill FROM t1;

#
# Step 4: kill nodes 1,2 at the same time
#
--connection node_2
--source include/kill_galera.inc

--connection node_1
--source include/kill_galera.inc

# Recover the committed positions of the killed nodes, like the service
# scripts do before restarting a crashed node.
--let $galera_wsrep_recover_server_id = 1
--source ../galera/include/galera_wsrep_recover.inc
--let $node_1_start_position = $galera_wsrep_start_position

--let $galera_wsrep_recover_server_id = 2
--source ../galera/include/galera_wsrep_recover.inc
--let $node_2_start_position = $galera_wsrep_start_position

# Heal the partition: node 3 is reachable again, still non-primary
--connection node_3
SET GLOBAL wsrep_provider_options = 'gmcast.isolate=0';

# Restart nodes 1,2 simultaneously, neither of them bootstraps. Both connect
# to node 3 only, so that they cannot form a component without it.
--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3 --wsrep-start-position=$node_1_start_position" $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3 --wsrep-start-position=$node_2_start_position" $MYSQLTEST_VARDIR/tmp/mysqld.2.expect

#
# Nodes 1,2 are ahead of node 3, so they must abort. Wait for that.
#
# mysql-test-run.pl removes the expect file when it restarts the server.
# Then mark the coming abort as expected, so that it is not reported as an
# unexpected server exit.
--let MDEV38976_TMPDIR = $MYSQLTEST_VARDIR/tmp
--perl
  use strict;
  use Time::HiRes qw(sleep);
  my %pending = (1 => 1, 2 => 1);
  for (my $i = 0; $i < 6000 && %pending; $i++)
  {
    for my $n (keys %pending)
    {
      my $expect = "$ENV{MDEV38976_TMPDIR}/mysqld.$n.expect";
      next if -e $expect;
      open(my $ef, '>', $expect) or die "Cannot write $expect: $!\n";
      print $ef "wait\n";
      close($ef);
      delete $pending{$n};
    }
    sleep(0.01) if %pending;
  }
  die "Nodes " . join(',', keys %pending) . " were not restarted\n" if %pending;
EOF

--let SEARCH_PATTERN = Reversing history
--let SEARCH_WAIT = FOUND
--let SEARCH_TIMEOUT = 120
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--source include/search_pattern_in_file.inc
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.2.err
--source include/search_pattern_in_file.inc

# Wait until the aborting server processes have exited
--perl
  use strict;
  use Time::HiRes qw(sleep);
  for my $n (1, 2)
  {
    my $pidfile = "$ENV{MYSQLTEST_VARDIR}/run/mysqld.$n.pid";
    if (open(my $pf, '<', $pidfile))
    {
      my $pid = <$pf>;
      close($pf);
      chomp($pid);
      if ($pid =~ /^\d+$/)
      {
        my $i;
        for ($i = 0; $i < 1200 && kill(0, $pid); $i++) { sleep(0.1); }
        die "Node $n did not exit after the abort\n" if kill(0, $pid);
      }
    }
  }
EOF

#
# The saved state of nodes 1,2 must have survived the abort: it must not have
# been reset to the undefined UUID.
#
--error 1
--exec grep -q '^uuid: *00000000-0000-0000-0000-000000000000' $MYSQLTEST_VARDIR/mysqld.1/data/grastate.dat
--error 1
--exec grep -q '^uuid: *00000000-0000-0000-0000-000000000000' $MYSQLTEST_VARDIR/mysqld.2/data/grastate.dat
--exec grep -q '^diverged: *1' $MYSQLTEST_VARDIR/mysqld.1/data/grastate.dat
--exec grep -q '^diverged: *1' $MYSQLTEST_VARDIR/mysqld.2/data/grastate.dat
--echo # grastate.dat of nodes 1,2 kept its UUID and is marked diverged after the abort

#
# Node 3 did not abort. It stays primary on its own, without the writes
# from step 3.
#
--connection node_3
--let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc
SELECT VARIABLE_VALUE AS node_3_cluster_status FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_status';
SELECT VARIABLE_VALUE AS node_3_state FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_local_state_comment';

#
# Write on node 3 until its position is past the saved positions of nodes 1,2.
# Write far enough that node 3 purges its certification index above these
# positions. Otherwise the IST preload overlaps the gcache of nodes 1,2,
# which hold different events at the same seqnos, and the joiner crashes.
#
--let $node_1_seqno = `SELECT SUBSTRING_INDEX('$node_1_start_position', ':', -1)`
--let $node_2_seqno = `SELECT SUBSTRING_INDEX('$node_2_start_position', ':', -1)`
--let $target_seqno = `SELECT GREATEST($node_1_seqno, $node_2_seqno) + 300`
INSERT INTO t1 VALUES (100);
--let $f1 = 101
--disable_query_log
while (`SELECT VARIABLE_VALUE <= $target_seqno FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_last_committed'`)
{
  --eval INSERT INTO t1 VALUES ($f1)
  --inc $f1
}
--enable_query_log

#
# Restart nodes 1,2 with their saved state. Node 3 is now past their saved
# positions, so without a marker in the saved state they would rejoin by IST
# and the data would diverge silently. Their saved state is marked as diverged,
# so they must refuse to join.
#
--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3 --wsrep-start-position=$node_1_start_position" $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3 --wsrep-start-position=$node_2_start_position" $MYSQLTEST_VARDIR/tmp/mysqld.2.expect

--let MDEV38976_TMPDIR = $MYSQLTEST_VARDIR/tmp
--perl
  use strict;
  use Time::HiRes qw(sleep);
  my %pending = (1 => 1, 2 => 1);
  for (my $i = 0; $i < 6000 && %pending; $i++)
  {
    for my $n (keys %pending)
    {
      my $expect = "$ENV{MDEV38976_TMPDIR}/mysqld.$n.expect";
      next if -e $expect;
      open(my $ef, '>', $expect) or die "Cannot write $expect: $!\n";
      print $ef "wait\n";
      close($ef);
      delete $pending{$n};
    }
    sleep(0.01) if %pending;
  }
  die "Nodes " . join(',', keys %pending) . " were not restarted\n" if %pending;
EOF

--let SEARCH_PATTERN = Refusing to join the cluster
--let SEARCH_WAIT = FOUND
--let SEARCH_TIMEOUT = 120
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--source include/search_pattern_in_file.inc
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.2.err
--source include/search_pattern_in_file.inc

# Wait until the servers that refused to start have exited
--perl
  use strict;
  use Time::HiRes qw(sleep);
  for my $n (1, 2)
  {
    my $pidfile = "$ENV{MYSQLTEST_VARDIR}/run/mysqld.$n.pid";
    if (open(my $pf, '<', $pidfile))
    {
      my $pid = <$pf>;
      close($pf);
      chomp($pid);
      if ($pid =~ /^\d+$/)
      {
        my $i;
        for ($i = 0; $i < 1200 && kill(0, $pid); $i++) { sleep(0.1); }
        die "Node $n did not exit\n" if kill(0, $pid);
      }
    }
  }
EOF

# Node 3 is not affected, and nodes 1,2 did not join it
--connection node_3
SELECT VARIABLE_VALUE AS node_3_cluster_size FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size';
SELECT COUNT(*) AS node_3_step_3_rows FROM t1 WHERE f1 BETWEEN 4 AND 10;

#
# Recover as an operator would: nodes 1,2 rejoin node 3 with a full state
# transfer after their saved state is removed.
#
--remove_file $MYSQLTEST_VARDIR/mysqld.1/data/grastate.dat
--remove_file $MYSQLTEST_VARDIR/mysqld.2/data/grastate.dat

--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3" $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--connection node_1
--enable_reconnect
--source include/wait_until_connected_again.inc
--source include/galera_wait_ready.inc

--write_line "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_3" $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--connection node_2
--enable_reconnect
--source include/wait_until_connected_again.inc
--source include/galera_wait_ready.inc

--connection node_3
--let $wait_condition = SELECT VARIABLE_VALUE = 3 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--connection node_1
DROP TABLE t1;

--source ../galera/include/auto_increment_offset_restore.inc

--connection node_1
CALL mtr.add_suppression("WSREP: .*Reversing history");
CALL mtr.add_suppression("WSREP: gcs/src/gcs_group\\.cpp:group_post_state_exchange\\(\\)");
CALL mtr.add_suppression("WSREP: Node is ahead of the primary component");
CALL mtr.add_suppression("WSREP: State file is marked as diverged from the group");
CALL mtr.add_suppression("WSREP: State of this node was marked as diverged");
CALL mtr.add_suppression("WSREP: gcs connect failed");
CALL mtr.add_suppression("WSREP: wsrep::connect\\(.*\\) failed");
CALL mtr.add_suppression("WSREP: Failed to connect");
CALL mtr.add_suppression("WSREP: node uuid: .* is inconsistent to restored view");
CALL mtr.add_suppression("WSREP: Wsrep startup was interrupted");
CALL mtr.add_suppression("WSREP: .*Calling destroy\\(\\) before close");
CALL mtr.add_suppression("WSREP: .*GCS core destructor failed");
CALL mtr.add_suppression("WSREP: server: .* unallowed state transition");
CALL mtr.add_suppression("Aborting");
CALL mtr.add_suppression("Assertion .0. failed");
CALL mtr.add_suppression("got signal 6");
CALL mtr.add_suppression("Attempting backtrace");
--connection node_2
CALL mtr.add_suppression("WSREP: .*Reversing history");
CALL mtr.add_suppression("WSREP: gcs/src/gcs_group\\.cpp:group_post_state_exchange\\(\\)");
CALL mtr.add_suppression("WSREP: Node is ahead of the primary component");
CALL mtr.add_suppression("WSREP: State file is marked as diverged from the group");
CALL mtr.add_suppression("WSREP: State of this node was marked as diverged");
CALL mtr.add_suppression("WSREP: gcs connect failed");
CALL mtr.add_suppression("WSREP: wsrep::connect\\(.*\\) failed");
CALL mtr.add_suppression("WSREP: Failed to connect");
CALL mtr.add_suppression("WSREP: node uuid: .* is inconsistent to restored view");
CALL mtr.add_suppression("WSREP: Wsrep startup was interrupted");
CALL mtr.add_suppression("WSREP: .*Calling destroy\\(\\) before close");
CALL mtr.add_suppression("WSREP: .*GCS core destructor failed");
CALL mtr.add_suppression("WSREP: server: .* unallowed state transition");
CALL mtr.add_suppression("Aborting");
CALL mtr.add_suppression("Assertion .0. failed");
CALL mtr.add_suppression("got signal 6");
CALL mtr.add_suppression("Attempting backtrace");
--connection node_3
CALL mtr.add_suppression("WSREP: .*Reversing history");
CALL mtr.add_suppression("WSREP: gcs/src/gcs_group\\.cpp:group_post_state_exchange\\(\\)");
CALL mtr.add_suppression("WSREP: Node is ahead of the primary component");
CALL mtr.add_suppression("WSREP: State file is marked as diverged from the group");
CALL mtr.add_suppression("WSREP: State of this node was marked as diverged");
CALL mtr.add_suppression("WSREP: gcs connect failed");
CALL mtr.add_suppression("WSREP: wsrep::connect\\(.*\\) failed");
CALL mtr.add_suppression("WSREP: Failed to connect");
CALL mtr.add_suppression("WSREP: node uuid: .* is inconsistent to restored view");
CALL mtr.add_suppression("WSREP: Wsrep startup was interrupted");
CALL mtr.add_suppression("WSREP: .*Calling destroy\\(\\) before close");
CALL mtr.add_suppression("WSREP: .*GCS core destructor failed");
CALL mtr.add_suppression("WSREP: server: .* unallowed state transition");
CALL mtr.add_suppression("Aborting");
CALL mtr.add_suppression("Assertion .0. failed");
CALL mtr.add_suppression("got signal 6");
CALL mtr.add_suppression("Attempting backtrace");
