call mtr.add_suppression("Duplicate key id and version at .*keys_rotation.txt");
call mtr.add_suppression("Encryption key id 1 version 1 is loaded but is missing from or different in the key file");
# Lines without a version are version 1
select * from information_schema.file_key_management_keys order by key_id, key_version;
KEY_ID	KEY_VERSION	KEY_LENGTH	IS_LATEST
1	1	256	YES
2	1	256	YES
create table t1 (a int primary key, b varchar(64)) engine=innodb;
insert into t1 select seq, repeat('x', 64) from seq_1_to_10000;
create table t2 (a int primary key) engine=innodb encryption_key_id=2;
insert into t2 select seq from seq_1_to_1000;
select name, current_key_id, current_key_version, min_key_version
from information_schema.innodb_tablespaces_encryption
where name like 'test/%' order by name;
name	current_key_id	current_key_version	min_key_version
test/t1	1	1	1
test/t2	2	1	1
# Add a new version of key 1 and reload without a restart
flush file_key_management_keys;
select * from information_schema.file_key_management_keys order by key_id, key_version;
KEY_ID	KEY_VERSION	KEY_LENGTH	IS_LATEST
1	1	256	NO
1	3	256	YES
2	1	256	YES
# Key 1 tablespaces are re-encrypted, key 2 is untouched
select name, current_key_id, current_key_version, min_key_version
from information_schema.innodb_tablespaces_encryption
where name like 'test/%' order by name;
name	current_key_id	current_key_version	min_key_version
test/t1	1	3	3
test/t2	2	1	1
insert into t1 values (10001, 'after rotation');
select count(*), sum(a) from t1;
count(*)	sum(a)
10001	50015001
select count(*), sum(a) from t2;
count(*)	sum(a)
1000	500500
# A reload may not drop a loaded key version
flush file_key_management_keys;
ERROR HY000: Encryption key id 1 version 1 is loaded but is missing from or different in the key file. The loaded keys stay in use
# A reload may not change a loaded key
flush file_key_management_keys;
ERROR HY000: Encryption key id 1 version 1 is loaded but is missing from or different in the key file. The loaded keys stay in use
# A bad key file is reported, details go to the error log
flush file_key_management_keys;
ERROR HY000: Could not reload encryption keys from 'MYSQLTEST_VARDIR/tmp/keys_rotation.txt', see the error log. The loaded keys stay in use
FOUND 1 /Duplicate key id and version at .*keys_rotation.txt line 5/ in mysqld.1.err
# The loaded keys stay in use
select * from information_schema.file_key_management_keys order by key_id, key_version;
KEY_ID	KEY_VERSION	KEY_LENGTH	IS_LATEST
1	1	256	NO
1	3	256	YES
2	1	256	YES
select count(*), sum(a) from t1;
count(*)	sum(a)
10001	50015001
# The redo log still uses version 1. Changing its size makes InnoDB
# create a new one with the latest key version
# restart: --innodb-log-file-size=24M
# Version 1 is no longer used anywhere and can be retired
# restart: --innodb-log-file-size=24M
select * from information_schema.file_key_management_keys order by key_id, key_version;
KEY_ID	KEY_VERSION	KEY_LENGTH	IS_LATEST
1	3	256	YES
2	1	256	YES
select count(*), sum(a) from t1;
count(*)	sum(a)
10001	50015001
select a, b from t1 where a > 10000 order by a;
a	b
10001	after rotation
check table t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
test.t2	check	status	OK
drop table t1, t2;
# restart
