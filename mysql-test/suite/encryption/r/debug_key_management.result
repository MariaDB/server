call mtr.add_suppression("InnoDB: Encrypted page \\[page id: space=[1-9][0-9]*, page number=[0-9]*\\] in file");
create table t1(a serial) engine=innoDB;
set global innodb_encrypt_tables=ON;
show variables like 'innodb_encrypt%';
Variable_name	Value
innodb_encrypt_log	ON
innodb_encrypt_tables	ON
innodb_encrypt_temporary_tables	OFF
innodb_encryption_rotate_key_age	2
innodb_encryption_rotation_iops	100
innodb_encryption_threads	4
select count(*) from information_schema.innodb_tablespaces_encryption where current_key_version <> 1;
count(*)
0
set global debug_key_management_version=10;
select count(*) from information_schema.innodb_tablespaces_encryption where current_key_version <> 10;
count(*)
0
#
# MDEV-31094 innodb_encryption_rotate_key_age behaviour is misleading
#
# Pages that are innodb_encryption_rotate_key_age versions behind
# are re-encrypted, not only pages that are more versions behind
set global innodb_encryption_rotate_key_age=1;
set global debug_key_management_version=11;
select name, current_key_version, min_key_version from information_schema.innodb_tablespaces_encryption where name = 'test/t1';
name	current_key_version	min_key_version
test/t1	11	11
set global innodb_encryption_rotate_key_age=2;
set global debug_key_management_version=13;
select name, current_key_version, min_key_version from information_schema.innodb_tablespaces_encryption where name = 'test/t1';
name	current_key_version	min_key_version
test/t1	13	13
SET GLOBAL innodb_log_checkpoint_now = 1;
SET GLOBAL innodb_flush_log_at_trx_commit = 1;
INSERT INTO t1 VALUES(NULL);
# restart
set global innodb_encrypt_tables=OFF;
set global debug_key_management_version=1;
select * from t1;
a
1
drop table t1;
