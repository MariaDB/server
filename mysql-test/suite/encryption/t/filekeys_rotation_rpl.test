#
# MDEV-20713 Key rotation with file_key_management and replication.
# Each server has its own key file with different key material:
# encryption at rest is local, replication sends decrypted events.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_debug.inc

--source filekeys_plugin_exists.inc

--let $rpl_topology= 1->2
--source include/rpl_init.inc

--connection server_2
set sql_log_bin= 0;
call mtr.add_suppression("Encryption key id 1 version 1 is loaded but is missing from or different in the key file");
call mtr.add_suppression("Slave SQL: Error 'Encryption key id 1 version 1");
call mtr.add_suppression("Slave: Encryption key id 1 version 1");
set sql_log_bin= 1;

--connection server_1
create table t1 (a int primary key, b varchar(64)) engine=innodb;
insert into t1 select seq, md5(seq) from seq_1_to_10000;
--sync_slave_with_master server_2

# The key files are copied to a writable place by the -master.sh script
--let $keys_1= $MYSQLTEST_VARDIR/tmp/keys_rpl_1.txt
--let $keys_2= $MYSQLTEST_VARDIR/tmp/keys_rpl_2.txt

--echo # 1. FLUSH on the primary is written to the binary log, so the replica
--echo #    re-reads its own, unchanged key file
# Version 3, not 2: with innodb_encryption_rotate_key_age=1 InnoDB only
# re-encrypts pages that are more than one version old (MDEV-31094).
--connection server_1
--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
--append_file $keys_1
1;3;1396373f2269fd88769de6368fb7273b9c6abad8c929a8e72c6ab5e12d59b977
EOF
flush file_key_management_keys;
--source include/show_binlog_events.inc
--let $wait_condition= SELECT COUNT(*) = 0 FROM information_schema.innodb_tablespaces_encryption WHERE current_key_id = 1 AND (min_key_version <> 3 OR rotating_or_flushing <> 0)
--source include/wait_condition.inc
select key_id, key_version, is_latest
from information_schema.file_key_management_keys order by key_id, key_version;
select name, min_key_version from information_schema.innodb_tablespaces_encryption
where name = 'test/t1';
--sync_slave_with_master server_2
select key_id, key_version, is_latest
from information_schema.file_key_management_keys order by key_id, key_version;
select name, min_key_version from information_schema.innodb_tablespaces_encryption
where name = 'test/t1';

--echo # 2. A replicated FLUSH that the replica's key file does not allow
--echo #    stops the replica's SQL thread
--connection server_2
--copy_file $keys_2 $keys_2.good
--remove_file $keys_2
--write_file $keys_2
1;2;eddb33d58447847ffc754eae3dbca0bdd35d067c80b8b2603eef2f806c902e72
2;1;f3ec58127c3c19a5b835ce44838546d445a4a64e52e8f0da6e3d06141e68c07d
EOF
--connection server_1
flush file_key_management_keys;
--connection server_2
let $slave_sql_errno= 4278; # ER_ENCRYPTION_KEY_IN_USE
--source include/wait_for_slave_sql_error.inc
--echo # Fixing the replica's key file lets replication continue
--remove_file $keys_2
--copy_file $keys_2.good $keys_2
--source include/start_slave.inc
--connection server_1
--sync_slave_with_master server_2

--echo # 3. FLUSH LOCAL is not written to the binary log
--remove_file $keys_2
--write_file $keys_2
1;2;eddb33d58447847ffc754eae3dbca0bdd35d067c80b8b2603eef2f806c902e72
2;1;f3ec58127c3c19a5b835ce44838546d445a4a64e52e8f0da6e3d06141e68c07d
EOF
--connection server_1
--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
flush local file_key_management_keys;
--source include/show_binlog_events.inc
insert into t1 values (10001, 'after flush local');
--sync_slave_with_master server_2
select count(*) from t1;
--remove_file $keys_2
--copy_file $keys_2.good $keys_2

--echo # 4. Switch over while the primary is re-encrypting t1
--connection server_1
set @save_dbug= @@global.debug_dbug;
set global debug_dbug= '+d,fil_crypt_rotate_page_wait';
--append_file $keys_1
1;5;859d77137ab52391849b59b42e0e8c69946fe4808ede59b3c3b85a8080891620
EOF
flush local file_key_management_keys;
--let $wait_condition= SELECT key_rotation_page_number >= 16 FROM information_schema.innodb_tablespaces_encryption WHERE name = 'test/t1'
--source include/wait_condition.inc
--sync_slave_with_master server_2
--source include/stop_slave.inc
flush binary logs;
--let $rpl_topology= 2->1
--source include/rpl_change_topology.inc
--source include/rpl_start_slaves.inc

--connection server_2
insert into t1 values (10002, 'on the new primary');
--sync_slave_with_master server_1
select min_key_version < 5 as still_rotating
from information_schema.innodb_tablespaces_encryption where name = 'test/t1';
set global debug_dbug= @save_dbug;
--let $wait_condition= SELECT COUNT(*) = 0 FROM information_schema.innodb_tablespaces_encryption WHERE current_key_id = 1 AND (min_key_version <> 5 OR rotating_or_flushing <> 0)
--source include/wait_condition.inc
--echo # The old primary finished its rotation as a replica
select name, min_key_version from information_schema.innodb_tablespaces_encryption
where name = 'test/t1';
--let $diff_tables= server_1:t1, server_2:t1
--source include/diff_tables.inc

--echo # Back to the original topology
--connection server_1
--source include/stop_slave.inc
flush binary logs;
--let $rpl_topology= 1->2
--source include/rpl_change_topology.inc
--source include/rpl_start_slaves.inc
--connection server_1
drop table t1;
--sync_slave_with_master server_2
--remove_file $keys_2.good
--source include/rpl_end.inc
