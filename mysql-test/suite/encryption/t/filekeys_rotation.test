#
# MDEV-20713 Implement key rotation for file_key_management plugin
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

if (!$FILE_KEY_MANAGEMENT_SO)
{
  --skip Needs file_key_management plugin
}

call mtr.add_suppression("Duplicate key id and version at .*keys_rotation.txt");
call mtr.add_suppression("Encryption key id 1 version 1 is loaded but is missing from or different in the key file");

# The key file is copied to a writable place by filekeys_rotation-master.sh
--let $keys= $MYSQLTEST_VARDIR/tmp/keys_rotation.txt
--echo # Lines without a version are version 1
select * from information_schema.file_key_management_keys order by key_id, key_version;

create table t1 (a int primary key, b varchar(64)) engine=innodb;
insert into t1 select seq, repeat('x', 64) from seq_1_to_10000;
create table t2 (a int primary key) engine=innodb encryption_key_id=2;
insert into t2 select seq from seq_1_to_1000;

--let $wait_condition= SELECT COUNT(*) = 0 FROM information_schema.innodb_tablespaces_encryption WHERE min_key_version <> 1 OR rotating_or_flushing <> 0
--source include/wait_condition.inc
select name, current_key_id, current_key_version, min_key_version
from information_schema.innodb_tablespaces_encryption
where name like 'test/%' order by name;

--echo # Add a new version of key 1 and reload without a restart
# Version 3, not 2: with innodb_encryption_rotate_key_age=1 InnoDB only
# re-encrypts pages that are more than one version old (MDEV-31094).
# Versions do not need to be consecutive.
--append_file $keys
1;3;1396373f2269fd88769de6368fb7273b9c6abad8c929a8e72c6ab5e12d59b977
EOF
flush file_key_management_keys;
select * from information_schema.file_key_management_keys order by key_id, key_version;

--echo # Key 1 tablespaces are re-encrypted, key 2 is untouched
--let $wait_condition= SELECT COUNT(*) = 0 FROM information_schema.innodb_tablespaces_encryption WHERE current_key_id = 1 AND (min_key_version <> 3 OR rotating_or_flushing <> 0)
--source include/wait_condition.inc
select name, current_key_id, current_key_version, min_key_version
from information_schema.innodb_tablespaces_encryption
where name like 'test/%' order by name;
insert into t1 values (10001, 'after rotation');
select count(*), sum(a) from t1;
select count(*), sum(a) from t2;

--echo # A reload may not drop a loaded key version
--copy_file $keys $keys.good
--remove_file $keys
--write_file $keys
1;3;1396373f2269fd88769de6368fb7273b9c6abad8c929a8e72c6ab5e12d59b977
2;1;1f58f0887443895d8bff8221664f971af0fb9a52b51d9ece6af6a4cc9047da1e
EOF
--error ER_ENCRYPTION_KEY_IN_USE
flush file_key_management_keys;

--echo # A reload may not change a loaded key
--remove_file $keys
--write_file $keys
1;1;859d77137ab52391849b59b42e0e8c69946fe4808ede59b3c3b85a8080891620
1;3;1396373f2269fd88769de6368fb7273b9c6abad8c929a8e72c6ab5e12d59b977
2;1;1f58f0887443895d8bff8221664f971af0fb9a52b51d9ece6af6a4cc9047da1e
EOF
--error ER_ENCRYPTION_KEY_IN_USE
flush file_key_management_keys;

--echo # A bad key file is reported, details go to the error log
--remove_file $keys
--copy_file $keys.good $keys
--append_file $keys
1;3;859d77137ab52391849b59b42e0e8c69946fe4808ede59b3c3b85a8080891620
EOF
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--error ER_ENCRYPTION_KEY_RELOAD_FAILED
flush file_key_management_keys;
--let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN= Duplicate key id and version at .*keys_rotation.txt line 5
--source include/search_pattern_in_file.inc
--echo # The loaded keys stay in use
select * from information_schema.file_key_management_keys order by key_id, key_version;
select count(*), sum(a) from t1;

--echo # The redo log still uses version 1. Changing its size makes InnoDB
--echo # create a new one with the latest key version
--remove_file $keys
--copy_file $keys.good $keys
--let $restart_parameters= --innodb-log-file-size=24M
--source include/restart_mysqld.inc

--echo # Version 1 is no longer used anywhere and can be retired
--remove_file $keys
--write_file $keys
1;3;1396373f2269fd88769de6368fb7273b9c6abad8c929a8e72c6ab5e12d59b977
2;1;1f58f0887443895d8bff8221664f971af0fb9a52b51d9ece6af6a4cc9047da1e
EOF
--source include/restart_mysqld.inc
select * from information_schema.file_key_management_keys order by key_id, key_version;
select count(*), sum(a) from t1;
select a, b from t1 where a > 10000 order by a;
check table t1, t2;

drop table t1, t2;
--remove_file $keys.good
--let $restart_parameters=
--source include/restart_mysqld.inc
