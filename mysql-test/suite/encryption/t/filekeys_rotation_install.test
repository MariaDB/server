#
# MDEV-20713 The library also holds the FILE_KEY_MANAGEMENT_KEYS
# INFORMATION_SCHEMA plugin. It must not stay installed on its own when
# the encryption plugin fails to start.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source filekeys_plugin_exists.inc

call mtr.add_suppression("System key id 1 is missing");
call mtr.add_suppression("Plugin '(file_key_management|FILE_KEY_MANAGEMENT_KEYS)' (init function returned error|registration.*failed)");

--echo # A key file without key id 1 makes the encryption plugin fail
--let $keys= $MYSQLTEST_VARDIR/tmp/keys_install.txt
--write_file $keys
2;1f58f0887443895d8bff8221664f971af0fb9a52b51d9ece6af6a4cc9047da1e
EOF
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--error 2
INSTALL SONAME 'file_key_management';

--echo # Nothing from the library stays installed
select name from mysql.plugin where dl like 'file_key_management%';
select plugin_name from information_schema.plugins
where plugin_library like 'file_key_management%';

--echo # With a valid key file both plugins are installed
--remove_file $keys
--write_file $keys
1;ee8e9d00002f9190de552c93c072682bc36ca601e7d5ccb04dee522aa17e4f99
EOF
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
INSTALL SONAME 'file_key_management';
select name from mysql.plugin where dl like 'file_key_management%' order by name;
select plugin_name, plugin_status from information_schema.plugins
where plugin_library like 'file_key_management%' order by plugin_name;
select * from information_schema.file_key_management_keys;

--echo # Reset mysqld
UNINSTALL SONAME 'file_key_management';
--remove_file $keys
--source include/restart_mysqld.inc
