--source include/have_debug.inc
--source include/have_partition.inc
--source include/have_innodb.inc
--source include/not_valgrind.inc
--source include/not_embedded.inc

#
# MDEV-41809
#
# A crash during CREATE OR REPLACE TABLE of a partitioned InnoDB table used to
# leave the new partition tablespaces behind in the data directory, so the
# table could not be recreated (ER_TABLE_EXISTS_ERROR), and on a debug build
# crash recovery hit the InnoDB assertion `err != DB_DUPLICATE_KEY' in
# row_rename_table_for_mysql().
#
# Root cause: create_table_impl() wrote the DDL-log CREATE entry for the new
# table with create_info->db_type *before* mysql_create_frm_image() had
# switched it to partition_hton. Recovery therefore asked the underlying
# engine (InnoDB) to drop a plain table "test/t1" that InnoDB never created,
# so the individual partition tablespaces (t1#P#p0.ibd, t1#P#p1.ibd) and the
# .par file were never removed.
#
# After the fix the DDL-log entry names partition_hton, so recovery drops all
# of the partitions and leaves no orphan files, and the table can be recreated.
#

--disable_query_log
call mtr.add_suppression("InnoDB: .* does not exist in the InnoDB internal");
call mtr.add_suppression("DDL_LOG");
--enable_query_log

let $MYSQLD_DATADIR= `SELECT @@datadir`;
let $old_debug=`select @@debug_dbug`;

CREATE TABLE t0 (a INT) ENGINE=InnoDB;
INSERT INTO t0 VALUES (1),(2),(3);

CREATE TABLE t1 (b INT) ENGINE=InnoDB PARTITION BY HASH (b) PARTITIONS 2;
INSERT INTO t1 VALUES (10),(20);

#
# Crash after all of the new partition tablespaces have been created on disk.
# This is the window the reporter's kill-mid-copy reproduces. Recovery must
# roll the half-finished CREATE OR REPLACE back and remove the new partitions.
#
--echo # Crash during CREATE OR REPLACE of a partitioned InnoDB table
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--disable_reconnect
--eval set @@debug_dbug="+d,ddl_log_create_after_create_table",@debug_crash_counter=1
--error 0,2013,2026
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB PARTITION BY HASH (a) PARTITIONS 2 SELECT a FROM t0;
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_query_log
--eval set @@debug_dbug="$old_debug"
--enable_query_log

--echo # No orphaned partition tablespaces or .par files must survive recovery.
--echo # Before the fix this listed t1#P#p0.ibd, t1#P#p1.ibd and t1.par.
--list_files $MYSQLD_DATADIR/test t1*

--echo # The table can be (re)created partitioned: no leftover tablespace clash.
--echo # Before the fix this failed with ER_TABLE_EXISTS_ERROR (1050).
CREATE OR REPLACE TABLE t1 (c INT) ENGINE=InnoDB PARTITION BY HASH (c) PARTITIONS 2;
INSERT INTO t1 VALUES (1),(2);
SELECT COUNT(*) FROM t1;

DROP TABLE t1, t0;
