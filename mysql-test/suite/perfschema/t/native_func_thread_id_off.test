--source include/not_embedded.inc
--source include/have_perfschema.inc

--echo #
--echo # MDEV-19629 PS_THREAD_ID() and PS_CURRENT_THREAD_ID() with the
--echo #            Performance Schema disabled
--echo #

SELECT @@performance_schema;

--error ER_WRONG_PERFSCHEMA_USAGE
SELECT PS_CURRENT_THREAD_ID();
--error ER_WRONG_PERFSCHEMA_USAGE
SELECT PS_THREAD_ID(CONNECTION_ID());
--error ER_WRONG_PERFSCHEMA_USAGE
SELECT PS_THREAD_ID(NULL);

--echo # sys.ps_thread_id() keeps returning NULL
# Various protocols display ER_NATIVE_FCT_NAME_COLLISION very differently.
--disable_ps_protocol
--disable_cursor_protocol
--disable_view_protocol
SELECT sys.ps_thread_id(NULL), sys.ps_thread_id(CONNECTION_ID());
--enable_view_protocol
--enable_cursor_protocol
--enable_ps_protocol

--echo #
--echo # End of 13.2 tests
--echo #
