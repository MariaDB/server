#
# MDEV-42351: A SPATIAL INDEX page must not be merged while another transaction
# holds a "page" lock on it, even if the merging transaction
# acquired its own "page" lock first
#
CREATE TABLE t1(id INT PRIMARY KEY, p POINT NOT NULL, SPATIAL INDEX(p))
ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, POINT(RAND(seq)*1000, RAND(seq+7919)*1000)
FROM seq_1_to_2000;
SET @w = ST_GeomFromText('POLYGON((300 300,300 700,700 700,700 300,300 300))');
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
COUNT(*)
403
connect  con_w,localhost,root,,;
BEGIN;
INSERT INTO t1 SELECT seq, POINT(RAND(seq)*1000, RAND(seq+7919)*1000)
FROM seq_10001_to_14000;
DELETE FROM t1 WHERE id > 10000;
connect  con_r,localhost,root,,;
SET @w = ST_GeomFromText('POLYGON((300 300,300 700,700 700,700 300,300 300))');
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
disconnect con_w;
connection con_r;
COUNT(*)
403
disconnect con_r;
connection default;
SET DEBUG_SYNC='RESET';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
COUNT(*)
403
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
# End of 11.4 tests
