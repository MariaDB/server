#
# MDEV-42351: A search of a SPATIAL INDEX returned wrong results if a page in its
# search path was split and one of the two pages was then discarded
#
CREATE TABLE t1(id INT PRIMARY KEY, p POINT NOT NULL, SPATIAL INDEX(p))
ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, POINT(RAND(seq)*1000, RAND(seq+7919)*1000)
FROM seq_1_to_2000;
SET @w = ST_GeomFromText('POLYGON((-1 -1,-1 1001,1001 1001,1001 -1,-1 -1))');
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
COUNT(*)
2000
connect  con_r,localhost,root,,;
SET @w = ST_GeomFromText('POLYGON((-1 -1,-1 1001,1001 1001,1001 -1,-1 -1))');
connect  con_w,localhost,root,,;
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(-3000 + seq/1000, -3000 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(5000 + seq/1000, 500 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(500 + seq/1000, 5000 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(500 + seq/1000, -5000 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(-5000 + seq/1000, 500 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
connection con_r;
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
BEGIN;
INSERT INTO t1 SELECT seq, POINT(5000 + seq/1000, 5000 + seq/1000)
FROM seq_10001_to_10400;
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
connection con_r;
COUNT(*)
2000
SET DEBUG_SYNC='RESET';
disconnect con_r;
disconnect con_w;
connection default;
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
COUNT(*)
2000
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
# End of 11.4 tests
