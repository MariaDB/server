--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

--echo #
--echo # MDEV-42351: A SPATIAL INDEX page must not be merged while another transaction
--echo # holds a "page" lock on it, even if the merging transaction
--echo # acquired its own "page" lock first
--echo #

CREATE TABLE t1(id INT PRIMARY KEY, p POINT NOT NULL, SPATIAL INDEX(p))
ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, POINT(RAND(seq)*1000, RAND(seq+7919)*1000)
FROM seq_1_to_2000;
SET @w = ST_GeomFromText('POLYGON((300 300,300 700,700 700,700 300,300 300))');
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);

connect (con_w,localhost,root,,);
BEGIN;
# Split the leaf pages.
INSERT INTO t1 SELECT seq, POINT(RAND(seq)*1000, RAND(seq+7919)*1000)
FROM seq_10001_to_14000;
# Acquire "page" locks on the leaf pages before the reader does.
DELETE FROM t1 WHERE id > 10000;

connect (con_r,localhost,root,,);
SET @w = ST_GeomFromText('POLYGON((300 300,300 700,700 700,700 300,300 300))');
# Pause after the first leaf page was read, while the "page" locks of
# this search protect the other leaf pages in the search path.
SET DEBUG_SYNC='rtr_pcur_move_to_next_return SIGNAL paused WAIT_FOR resume';
send SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);

connection con_w;
SET DEBUG_SYNC='now WAIT_FOR paused';
# This used to merge the leaf pages that the reader has yet to visit,
# so that the reader missed their records.
ROLLBACK;
SET DEBUG_SYNC='now SIGNAL resume';
disconnect con_w;

connection con_r;
reap;
disconnect con_r;

connection default;
SET DEBUG_SYNC='RESET';
SELECT COUNT(*) FROM t1 FORCE INDEX(p) WHERE MBRWithin(p, @w);
CHECK TABLE t1;
DROP TABLE t1;

--source include/wait_until_count_sessions.inc

--echo # End of 11.4 tests
