WHERE db='appdb' AND name LIKE 'p_%'
ORDER BY definer;
name	definer	security_type
p_definer_low_security_invoker	low@localhost	INVOKER
p_definer_root_security_none	root@localhost	DEFINER
p_definer_none_security_none	root@localhost	DEFINER
p_definer_root_security_invoker	root@localhost	INVOKER
p_definer_none_security_invoker	root@localhost	INVOKER
