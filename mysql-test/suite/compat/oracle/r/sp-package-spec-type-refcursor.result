# A self-reference to the current spec with success: 2-step
CREATE PACKAGE pkg1 AS
TYPE rec0_t IS RECORD (a INT, b VARCHAR(32));
TYPE cur0_t IS REF CURSOR RETURN pkg1.rec0_t; -- Self ref
END;
$$
# Using from the same database
CREATE PROCEDURE p1 AS
r0 pkg1.rec0_t;
c0 pkg1.cur0_t;
BEGIN
OPEN c0 FOR SELECT 1,'b';
FETCH c0 INTO r0;
CLOSE c0;
SELECT r0.a, r0.b;
END;
$$
CALL p1;
r0.a	r0.b
1	b
