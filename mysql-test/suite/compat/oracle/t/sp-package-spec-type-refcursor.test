--echo # 3-step cursor type with 2-step type in RETURN
DELIMITER $$;
CREATE PROCEDURE p1 AS
  c0 test.pkg2.cur0_t;
  v0 INT;
  v1 VARCHAR(10);
BEGIN
  OPEN c0 FOR SELECT 1,'b';
  FETCH c0 INTO v0, v1;
  SELECT v0, v1;
  CLOSE c0;
END;
$$
DELIMITER ;$$
CALL p1;
