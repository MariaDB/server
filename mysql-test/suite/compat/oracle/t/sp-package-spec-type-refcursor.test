--echo # 3-step cursor type (different db) with 2-step type in RETURN
CREATE DATABASE test1;
USE test1;
DELIMITER $$;
CREATE PROCEDURE p1 AS
  c0 test.pkg2.cur0_t;
  v0 INT;
  v1 VARCHAR(10);
BEGIN
  OPEN c0 FOR SELECT 1,'b';
  FETCH c0 INTO v0, v1;
  SELECT v0, v1;
  CLOSE c0;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;
DROP DATABASE test1;
USE test;

DROP PACKAGE pkg2;

DROP PACKAGE pkg1;


--echo #
--echo # MDEV-40420 ASAN : SIGSEGV in Sp_handler::db_find_routine | Sp_handler::db_find_and_cache_routine
--echo #

CREATE DATABASE db1;
USE db1;
DELIMITER $$;
CREATE PACKAGE a_pkg AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
END;
$$
CREATE PACKAGE b_pkg AS
  TYPE brec IS RECORD (p INT, q VARCHAR(10));
  TYPE bcur IS REF CURSOR RETURN a_pkg.arec;
END;
$$
--error ER_UNKNOWN_DATA_TYPE
CREATE PACKAGE a_pkg AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
  TYPE acur IS REF CURSOR RETURN b_pkg.brec;
END;
$$
DELIMITER ;$$

--echo # Inject manually a bad CREATE PACKAGE with cyclic dependency

SELECT `body` FROM mysql.proc WHERE db='db1' AND name='a_pkg';
UPDATE mysql.proc SET `body`='AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
  TYPE acur IS REF CURSOR RETURN b_pkg.brec;
END'
WHERE db='db1' AND name='a_pkg';

--echo # Check that it's not allowed to create a PROCEDURE using a
--echo # manually injected PACKAGE with a cycle dependency

DELIMITER $$;
--replace_regex /[0-9]* bytes used of a [0-9]* byte stack, and [0-9]* bytes needed/XXX bytes used of a XXX byte stack, and XXX bytes needed/
--error ER_STACK_OVERRUN_NEED_MORE
CREATE PROCEDURE p_cycle AS
  c a_pkg.acur;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

--echo # The same, after SP cache invalidating
SET sql_mode=DEFAULT;
--source include/invalidate_sp_cache.inc
SET sql_mode=ORACLE;
DELIMITER $$;
--replace_regex /[0-9]* bytes used of a [0-9]* byte stack, and [0-9]* bytes needed/XXX bytes used of a XXX byte stack, and XXX bytes needed/
--error ER_STACK_OVERRUN_NEED_MORE
CREATE PROCEDURE p_cycle AS
  c a_pkg.acur;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$


--echo # Check that a manually injected PACKAGE with a cycle dependency
--echo # can be fixed using CREATE OR REPLACE

DELIMITER $$;
CREATE OR REPLACE PACKAGE a_pkg AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
END;
$$
DELIMITER ;$$

DROP DATABASE db1;
USE test;

--echo # The same layout, with 3-step data type references

CREATE DATABASE db1;
CREATE DATABASE db2;

DELIMITER $$;
CREATE PACKAGE db1.a_pkg AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
END;
$$
CREATE PACKAGE db2.b_pkg AS
  TYPE brec IS RECORD (p INT, q VARCHAR(10));
  TYPE bcur IS REF CURSOR RETURN db1.a_pkg.arec;
END;
$$
--error ER_UNKNOWN_DATA_TYPE
CREATE OR REPLACE PACKAGE db1.a_pkg AS
  TYPE arec IS RECORD (x INT, y VARCHAR(10));
  TYPE acur IS REF CURSOR RETURN db2.b_pkg.brec;
END;
$$
DELIMITER ;$$
DROP DATABASE db2;
DROP DATABASE db1;


--echo #
--echo # MDEV-40468 Package that contains a self reference package refcursor crashes the server
--echo #

# 2-step qualified self-reference

CREATE DATABASE db1;
USE db1;
CREATE TABLE t1 (a INT, b VARCHAR(32));
INSERT INTO t1 VALUES (1,'one'),(2,'two');
DELIMITER $$;
CREATE PACKAGE pkg AS
  TYPE rec IS RECORD (a INT, b VARCHAR(32));
  TYPE cur IS REF CURSOR RETURN pkg.rec; -- 2-step self reference
END;
$$
CREATE PROCEDURE p2 AS
  TYPE localcur IS REF CURSOR RETURN pkg.rec;
  c localcur;
  v pkg.rec;
BEGIN
  OPEN c FOR SELECT a,b FROM t1;
  FETCH c INTO v;
  CLOSE c;
END;
$$
DELIMITER ;$$
CALL p2;
DROP DATABASE db1;
USE test;


# 3-step qualified reference

CREATE DATABASE db1;
USE db1;
CREATE TABLE t1 (a INT, b VARCHAR(32));
INSERT INTO t1 VALUES (1,'one'),(2,'two');
DELIMITER $$;
CREATE PACKAGE pkg AS
  TYPE rec IS RECORD (a INT, b VARCHAR(32));
  TYPE cur IS REF CURSOR RETURN db1.pkg.rec; -- 3-step self-reference
END;
$$
CREATE PROCEDURE p2 AS
  TYPE localcur IS REF CURSOR RETURN pkg.rec;
  c localcur;
  v pkg.rec;
BEGIN
  OPEN c FOR SELECT a,b FROM t1;
  FETCH c INTO v;
  CLOSE c;
END;
$$
DELIMITER ;$$
CALL p2;
DROP DATABASE db1;
USE test;

--echo #
--echo # MDEV-40640 Assertion `li->sphead' failed in bool LEX::sp_package_spec_check_cyclic_dependency(THD *, const Lex_ident_sys_st &, const Lex_ident_sys_st &) const
--echo #

DELIMITER $$;
CREATE PACKAGE p1 AS TYPE r IS RECORD(x INT); END;$$
CREATE PACKAGE p2 AS TYPE r IS RECORD(x INT); TYPE c IS REF CURSOR RETURN p1.r; END;$$
DELIMITER ;$$
SHOW CREATE PACKAGE p2;
DROP PACKAGE p2;
DROP PACKAGE p1;

--echo # Replacing the dependency package and removing the type

DELIMITER $$;
CREATE PACKAGE pkg1 AS
  TYPE rec0_t IS RECORD (a INT, b VARCHAR(10));
END;
$$
CREATE PACKAGE pkg2 AS
  TYPE cur1_t IS REF CURSOR RETURN pkg1.rec0_t;
END
$$
DELIMITER ;$$
SHOW CREATE PACKAGE pkg2;
DELIMITER $$;
CREATE OR REPLACE PACKAGE pkg1 AS
  TYPE rec1_t IS RECORD (a INT, b VARCHAR(10)); -- There is no rec0_t any more
END;
$$
DELIMITER ;$$
--error ER_UNKNOWN_DATA_TYPE
SHOW CREATE PACKAGE pkg2;
DROP PACKAGE pkg2;
DROP PACKAGE pkg1;


--echo # Dropping the dependency package

DELIMITER $$;
CREATE PACKAGE pkg1 AS
  TYPE rec0_t IS RECORD (a INT, b VARCHAR(10));
END;
$$
CREATE PACKAGE pkg2 AS
  TYPE cur1_t IS REF CURSOR RETURN pkg1.rec0_t;
END
$$
DELIMITER ;$$
SHOW CREATE PACKAGE pkg2;
DROP PACKAGE pkg1;
--error ER_UNKNOWN_DATA_TYPE
SHOW CREATE PACKAGE pkg2;
DROP PACKAGE pkg2;
