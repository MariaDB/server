SET sql_mode=ORACLE;

--echo #
--echo # MDEV-39587 Package-wide TYPE for variable declarations
--echo #

--echo #
--echo # MDEV-40686 Event using a package-defined type is silently lost during mariadb-dump / restore
--echo #

DELIMITER $$;
CREATE PACKAGE pkg AS
  TYPE rec IS RECORD (a INT);
END;
$$
--error ER_WRONG_USAGE
CREATE EVENT ev ON SCHEDULE EVERY 1 HOUR DO
DECLARE
  v pkg.rec;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$
DROP PACKAGE pkg;
