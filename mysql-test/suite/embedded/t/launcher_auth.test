--source include/have_embedded_launcher.inc

--echo #
--echo # MDEV-11111: the embedded server does not check credentials (its only
--echo # client is the process that has started it), but the account of the
--echo # user name decides the privileges. An unknown name is root.
--echo #

create user lim@localhost identified by 'secret';
create database emb_auth;
create table emb_auth.t (a int);
grant select on emb_auth.* to lim@localhost;

--echo # The password is wrong, and the connection is accepted
connect (c_lim,localhost,lim,wrong password,);
select current_user();
select * from emb_auth.t;
--error ER_TABLEACCESS_DENIED_ERROR
create table emb_auth.t2 (a int);

--echo # COM_CHANGE_USER
change_user root,whatever;
select current_user();
disconnect c_lim;

--echo # A name without an account is the root account
connect (c_nobody,localhost,no_such_user,x,);
select current_user();
disconnect c_nobody;

connection default;
drop user lim@localhost;
drop database emb_auth;
