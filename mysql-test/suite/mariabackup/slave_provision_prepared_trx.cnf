[mysqld.1]
log-slave-updates
loose-innodb
tc-heuristic-recover=ROLLBACK_PROCEED

[mysqld.2]
log-slave-updates
loose-innodb
skip-slave-start
tc-heuristic-recover=ROLLBACK_PROCEED

[ENV]
SERVER_MYPORT_1=		@mysqld.1.port
SERVER_MYSOCK_1=		@mysqld.1.socket
SERVER_MYPORT_2=		@mysqld.2.port
SERVER_MYSOCK_2=		@mysqld.2.socket
