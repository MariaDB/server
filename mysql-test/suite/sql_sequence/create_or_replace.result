MDEV-41811 Atomic CoR: a failed CREATE OR REPLACE ... SELECT NEXTVAL()
loses the old table
CREATE SEQUENCE s1;
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
CREATE TABLE t2 (a int);
insert into t2 values (1),(2),(3);
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB FOO=1 SELECT NEXTVAL(s1) AS a;
ERROR HY000: Unknown option 'FOO'
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB SELECT NEXTVAL(s2) from s1;
ERROR 42S02: Unknown SEQUENCE: 's2'
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB SELECT NEXTVAL(s2) AS a;
ERROR 42S02: Unknown SEQUENCE: 's2'
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB SELECT NEXTVAL(s1) as a from not_exists;
ERROR 42S02: Table 'test.not_exists' doesn't exist
CREATE OR REPLACE TABLE t1 (a INT) ENGINE=InnoDB SELECT NEXTVAL(t2) as a;
ERROR 42S02: 'test.t2' is not a SEQUENCE
CREATE OR REPLACE TABLE t1 (a INT, b int, c int) ENGINE=InnoDB SELECT a, NEXTVAL(s1), 1/(3-a) from t2;
ERROR 22012: Division by 0
SELECT * FROM t1;
a
1
DROP TABLE t1,t2;
DROP SEQUENCE s1;
