--source include/have_sequence.inc
--source include/have_innodb.inc
--source include/maybe_debug.inc

CREATE TABLE t(a INT PRIMARY KEY, b CHAR(255) DEFAULT '' NOT NULL, INDEX(b))
ENGINE=INNODB;
INSERT INTO t SET a=1;
CREATE TABLE t1(a INT PRIMARY KEY, b TEXT NOT NULL) ENGINE=InnoDB;

CREATE TABLE at1(i INTEGER) ENGINE=Aria TRANSACTIONAL=1;
INSERT INTO at1 VALUES (1);
CREATE TABLE at0 (i INTEGER) ENGINE=Aria TRANSACTIONAL=0;
INSERT INTO at0 VALUES (0);

CREATE DATABASE `$$$$$$$$$$$$`;
CREATE TABLE `$$$$$$$$$$$$`.`$$$$$$$$$$$$`(a SERIAL) ENGINE=InnoDB
SELECT 1;

if ($MARIADB_UPGRADE_EXE)
{
--exec echo "@cat > %MARIADB_DATADIR%\%1.tar" > $MARIADB_DATADIR/mariadb-backup-cat.bat
}

--connect con1,localhost,root
INSERT INTO t1 SELECT seq, REPEAT('a', 4000) FROM seq_1_to_3000;
UPDATE t1 SET b='';
SET GLOBAL innodb_undo_log_truncate=ON, innodb_max_purge_lag_wait=0;
--disconnect con1
--connection default

BEGIN;
DELETE FROM t;

--connect backup,localhost,root
if ($have_debug) {
SET DEBUG_SYNC='innodb_backup_start SIGNAL start WAIT_FOR resume';
}
send_eval BACKUP SERVER WITH 2 CONCURRENT 'cat';
--connection default
if ($have_debug) {
SET DEBUG_SYNC='now WAIT_FOR start';
}
INSERT INTO t(a) SELECT * FROM seq_1_to_30000;
if ($have_debug) {
SET DEBUG_SYNC='now SIGNAL resume';
}
--connection backup
--reap
--disconnect backup
--connection default
ROLLBACK;
SELECT * FROM t;
DELETE FROM t;
DROP TABLE at0, at1;
DROP DATABASE `$$$$$$$$$$$$`;

--let $target_directory=$MYSQLTEST_VARDIR/backup_stream
# Clean up after a previous failed test, in case we are retrying.
--error 0,1
--rmdir $target_directory
--mkdir $target_directory
--exec tar xf $MARIADB_DATADIR/1.tar -C $target_directory
--exec tar xf $MARIADB_DATADIR/2.tar -C $target_directory
--exec cat $MYSQLTEST_VARDIR/my.cnf >> $target_directory/backup.cnf

--let $restart_parameters=--defaults-file=$target_directory/backup.cnf --datadir=$target_directory
--source include/restart_mysqld.inc
SELECT * FROM at0;
SELECT * FROM at1;
SELECT * FROM t;
SELECT COUNT(*) FROM t1;
SELECT * FROM `$$$$$$$$$$$$`.`$$$$$$$$$$$$`;
--error ER_OPEN_AS_READONLY
DELETE FROM t;
--error ER_OPEN_AS_READONLY
DELETE FROM t1;
--error ER_OPEN_AS_READONLY
DELETE FROM `$$$$$$$$$$$$`.`$$$$$$$$$$$$`;

--remove_file $MARIADB_DATADIR/1.tar
--remove_file $MARIADB_DATADIR/2.tar
if ($MARIADB_UPGRADE_EXE)
{
--remove_file $MARIADB_DATADIR/mariadb-backup-cat.bat
}

--let $restart_parameters=
--source include/restart_mysqld.inc
SELECT * FROM t;
SELECT COUNT(*) FROM t1;
DROP TABLE t, t1;
--error ER_NO_SUCH_TABLE
DELETE FROM `$$$$$$$$$$$$`.`$$$$$$$$$$$$`;

--rmdir $target_directory
