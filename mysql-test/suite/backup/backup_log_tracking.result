CREATE TABLE t (a LONGBLOB) ENGINE=InnoDB;
SET @save_archive= @@GLOBAL.innodb_log_archive;
SET GLOBAL innodb_log_archive=ON;
SET GLOBAL innodb_log_checkpoint_now=ON;
SET @save_dbug= @@GLOBAL.debug_dbug;
SET GLOBAL debug_dbug='+d,ib_log_checkpoint_avoid';
connect backup,localhost,root;
SET DEBUG_SYNC='innodb_backup_start SIGNAL started WAIT_FOR go';
BACKUP SERVER TO 'MYSQL_TMP_DIR/backup_log_track' 2 CONCURRENT;
connection default;
SET DEBUG_SYNC='now WAIT_FOR started';
INSERT INTO t VALUES (REPEAT('x', 262144));
SET DEBUG_SYNC='now SIGNAL go';
connection backup;
disconnect backup;
connection default;
SET GLOBAL debug_dbug= @save_dbug;
SET DEBUG_SYNC='RESET';
DROP TABLE t;
SET GLOBAL innodb_log_archive=@save_archive;
