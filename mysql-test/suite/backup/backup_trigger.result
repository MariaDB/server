CREATE TABLE t1(id int unsigned);
CREATE TABLE t2(id int unsigned);
CREATE TRIGGER copy_id AFTER INSERT ON t1
FOR EACH ROW
INSERT INTO t2 (id) VALUES (NEW.id);
