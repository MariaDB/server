--source include/have_aria.inc
--source include/have_sequence.inc

let $logdir=`SELECT @@aria_log_dir_path`;

CREATE TABLE at1 (id INT PRIMARY KEY, txt VARCHAR(64), KEY(txt))
ENGINE=Aria ROW_FORMAT=PAGE TRANSACTIONAL=1;
INSERT INTO at1 SELECT seq, MD5(seq) FROM seq_1_to_1000;

--let $target_directory=$MYSQLTEST_VARDIR/backup_aria_log
--error 0,1
--rmdir $target_directory
evalp BACKUP SERVER TO '$target_directory';

--echo # logdir
--list_files $logdir aria_log*
--echo # backup
--list_files $target_directory aria_log*

DROP TABLE at1;
--rmdir $target_directory
