--source include/have_aria.inc

--echo #
--echo # MDEV-39092 BACKUP SERVER of ENGINE=Aria
--echo #

# BACKUP SERVER runs while another connection commits one row at a time
# to an Aria table that is safe for online backup. The page cache is
# small and the log files are small, so the inserts write data pages and
# the log can continue in a new file during the backup. The backup must hold
# the rows 1..N with no gap, with N not more than the rows that exist
# after BACKUP SERVER returns. This test needs no debug instrumentation,
# so it also runs on release builds. The writer stops when the user lock
# "run" is released: a KILL QUERY between two statements of a procedure
# can be lost, because the statement already sent its OK.
CREATE TABLE t1 (a INT PRIMARY KEY, c VARCHAR(255))
ENGINE=Aria TRANSACTIONAL=1 PAGE_CHECKSUM=1;
DELIMITER //;
CREATE PROCEDURE p()
BEGIN
  DECLARE i INT DEFAULT 1;
  WHILE i <= 1000000 AND IS_USED_LOCK('run') IS NOT NULL DO
    INSERT INTO t1 VALUES (i, REPEAT('x', 200));
    SET i= i + 1;
  END WHILE;
END//
DELIMITER ;//

# Clean up after a previous failed test, in case we are retrying.
--error 0,1
--rmdir $MYSQLTEST_VARDIR/bk

SELECT GET_LOCK('run', 0);
--connect w,localhost,root
--send CALL p()

--connection default
# A debug build under Valgrind needs about 90 seconds for 20000 rows.
--let $wait_timeout= 300
--let $wait_condition= SELECT COUNT(*) > 20000 FROM t1
--source include/wait_condition.inc
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--eval BACKUP SERVER TO '$MYSQLTEST_VARDIR/bk'
--let $after= `SELECT COUNT(*) FROM t1`
SELECT RELEASE_LOCK('run');

--connection w
--reap
--disconnect w
--connection default

--let $restart_parameters= --datadir=$MYSQLTEST_VARDIR/bk
--source include/restart_mysqld.inc
CHECK TABLE t1 EXTENDED;
--replace_result $after AFTER
--eval SELECT COUNT(*) = MAX(a), COUNT(*) > 20000, COUNT(*) <= $after FROM t1

--let $restart_parameters=
--source include/restart_mysqld.inc
DROP PROCEDURE p;
DROP TABLE t1;
--rmdir $MYSQLTEST_VARDIR/bk
