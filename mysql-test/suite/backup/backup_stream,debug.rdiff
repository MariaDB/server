--- backup_stream.result
+++ backup_stream,debug.result
@@ -11,9 +11,12 @@
 BEGIN;
 DELETE FROM t;
 connect backup,localhost,root;
+SET DEBUG_SYNC='innodb_backup_start SIGNAL start WAIT_FOR resume';
 BACKUP SERVER WITH 2 CONCURRENT 'cat';
 connection default;
+SET DEBUG_SYNC='now WAIT_FOR start';
 INSERT INTO t SELECT seq, '' FROM seq_1_to_30000;
+SET DEBUG_SYNC='now SIGNAL resume';
 connection backup;
 disconnect backup;
 connection default;
