--source include/have_sequence.inc
--source include/have_innodb.inc
--source include/maybe_debug.inc
--let $attempts= 1
if ($have_debug) {
inc $attempts;
--source include/have_debug_sync.inc
--disable_query_log
call mtr.add_suppression("mariadbd.*: Unknown error");
call mtr.add_suppression("mariadbd.*: Can't create file .*mysql/");
--enable_query_log
}

--disable_query_log
call mtr.add_suppression("mariadbd.*: IO Write error:");
--enable_query_log

CREATE TABLE at1(i INTEGER) ENGINE=Aria TRANSACTIONAL=1;
INSERT INTO at1 VALUES (2), (3), (5), (7);
CREATE TABLE at0 (i INTEGER) ENGINE=Aria TRANSACTIONAL=0;
INSERT INTO at0 VALUES (1), (1), (2), (3), (5);

# Create a table that must be copied and dropped during the backup
CREATE TABLE dt(a INT PRIMARY KEY, b CHAR(255)) ENGINE=InnoDB
SELECT seq a, '' b FROM seq_1_to_100000;
# Create a table that must be copied and renamed during the backup
CREATE TABLE rt(a INT PRIMARY KEY) ENGINE=InnoDB;
# Because log checkpoint will complete before BACKUP SERVER,
# the above CREATE TABLE must lead to copying the data file,
# instead of recovering it via a FILE_CREATE record.
SET GLOBAL innodb_log_checkpoint_now=ON;

CREATE TABLE t(a INT PRIMARY KEY, b CHAR(255), INDEX(b))ENGINE=INNODB;
BEGIN;
INSERT INTO t SET a=1, b='';

--let $target_directory=/tmp/some_directory$MTR_COMBINATION_ARCHIVED

# comment out the following line
# (and replace all "rmdir" with "exec rm -fr" and remove backup_innodb.opt)
# to test cross-filesystem copy
--let $target_directory=$MYSQLTEST_VARDIR/some_directory

# Clean up after a previous failed test, in case we are retrying.
--error 0,1
--rmdir $target_directory

evalp BACKUP SERVER TO '$target_directory';
ROLLBACK;
# BACKUP SERVER will implicitly commit the current transaction
SELECT * FROM t;

--error ER_PARSE_ERROR
evalp BACKUP SERVER TO '$target_directory' WITH '/bin/false';
--error ER_PARSE_ERROR
evalp BACKUP SERVER TO '$target_directory' WITH 4 CONCURRENT '/bin/false';
--error ER_WRONG_ARGUMENTS
BACKUP SERVER WITH '/bin/false';
--replace_regex /\(.*\)/(...)/
--error ER_IO_WRITE_ERROR
BACKUP SERVER WITH 'no-such-command';

--write_file $target_directory.empty_file
EOF

BEGIN; DELETE FROM t;

while ($attempts) {
dec $attempts;
--rmdir $target_directory
--connect backup,localhost,root
if ($have_debug) {
SET DEBUG_SYNC='innodb_backup_start SIGNAL start WAIT_FOR resume';
}
--connect rename,localhost,root
if (!$have_debug) {
RENAME TABLE rt TO rtt;
}
--connection backup
--replace_result $target_directory target_directory
send_eval BACKUP SERVER TO '$target_directory' 4 CONCURRENT;
--connection default
if ($have_debug) {
SET DEBUG_SYNC='now WAIT_FOR start';
}
if ($attempts) {
--move_file $target_directory.empty_file $target_directory/mysql
}
--connection rename
if ($have_debug) {
RENAME TABLE rt TO rtt;
}
CREATE TABLE rt(a INT PRIMARY KEY) ENGINE=InnoDB;
DROP TABLE dt;
--disconnect rename
--connection default
INSERT INTO t SELECT seq a, '' b FROM seq_1_to_30000;
if ($have_debug) {
SET DEBUG_SYNC='now SIGNAL resume';
}
if (!$attempts) {
--connection backup
--reap
--disconnect backup
--connection default
ROLLBACK;
}
if ($attempts) {
--connection backup
--error ER_CANT_CREATE_FILE,ER_UNKNOWN_ERROR
--reap
--disconnect backup
--connection default
# Clean up for a retry without a fault injection.
DROP TABLE t, rt, rtt;
CREATE TABLE dt(a INT PRIMARY KEY, b CHAR(255)) ENGINE=InnoDB
SELECT seq a, '' b FROM seq_1_to_100000;
# Create a table that must be copied and renamed during the backup
CREATE TABLE rt(a INT PRIMARY KEY) ENGINE=InnoDB;
# Because log checkpoint will complete before BACKUP SERVER,
# the above CREATE TABLE must lead to copying the data file,
# instead of recovering it via a FILE_CREATE record.
SET GLOBAL innodb_log_checkpoint_now=ON;

CREATE TABLE t(a INT PRIMARY KEY, b CHAR(255), INDEX(b)) ENGINE=INNODB
SELECT 1 a, '' b;
BEGIN; DELETE FROM t;
}
}
--error 0,1
--remove_file $target_directory.empty_file
SELECT * FROM rt;
SELECT * FROM rtt;
SELECT * FROM t;
DELETE FROM t;
--error ER_NO_SUCH_TABLE
SELECT * FROM dt;
DROP TABLE at0, at1;

if ($MARIADB_UPGRADE_EXE) {
let target_directory=$target_directory;
perl;
open IN, "<", "$ENV{MYSQLTEST_VARDIR}/my.cnf";
open OUT, ">>", "$ENV{target_directory}/backup.cnf";
print OUT while (<IN>);
close(IN);
close(OUT);
EOF
}
if (!$MARIADB_UPGRADE_EXE) {
  --exec cat $MYSQLTEST_VARDIR/my.cnf >> $target_directory/backup.cnf
}
--let $restart_parameters=--defaults-file=$target_directory/backup.cnf --datadir=$target_directory
--source include/restart_mysqld.inc
--list_files $target_directory/test dt*.ibd

SELECT * FROM rt;
SELECT * FROM rtt;
--error ER_NO_SUCH_TABLE
SELECT * FROM dt;
SELECT * FROM t;
# A nonzero innodb_log_recovery_target makes InnoDB read-only.
--error ER_OPEN_AS_READONLY
DELETE FROM t;
# Non-InnoDB tables are read-write.
SELECT * FROM at0;
SELECT * FROM at1;
--error ER_OPEN_AS_READONLY
DROP TABLE t, at0, at1;
--error ER_NO_SUCH_TABLE
SELECT * FROM at0;
--error ER_NO_SUCH_TABLE
SELECT * FROM at1;

--let $restart_parameters=
--source include/restart_mysqld.inc
SELECT * FROM t;
DROP TABLE t;
SELECT * FROM rt;
DROP TABLE rt;
SELECT * FROM rtt;
DROP TABLE rtt;

--rmdir $target_directory
