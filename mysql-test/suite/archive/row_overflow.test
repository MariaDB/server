#
# MDEV-42425 heap buffer overflow in ha_archive::pack_row
#
# ha_archive::max_row_length() accumulates the row length in a uint32.
# A single row whose BLOB columns sum to more than 4GB wraps the counter,
# fix_rec_buff() then allocates a tiny record buffer and Field_blob::pack()
# writes the full blob far past it -> heap buffer overflow.
#
--source include/have_archive.inc
--source include/big_test.inc
# builds a ~4.6GB row in memory, far too slow under valgrind/sanitizers
--source include/not_valgrind.inc
--source include/not_msan.inc

# a fresh connection picks up max_allowed_packet from the global value
SET @old_max_allowed_packet= @@global.max_allowed_packet;
SET @@global.max_allowed_packet= 1024*1024*1024;
--connect (con1,localhost,root,,)

# 11 columns * 400MB = 4.6GB > UINT32_MAX, so the uint32 length wraps
--let $cols= c0 LONGBLOB
--let $vals= @x
--let $i= 1
while ($i < 11)
{
  --let $cols= $cols, c$i LONGBLOB
  --let $vals= $vals, @x
  --inc $i
}

--eval CREATE TABLE t1 ($cols) ENGINE=ARCHIVE

SET @x= REPEAT('a', 400*1024*1024);

--error ER_GET_ERRNO
--eval INSERT INTO t1 VALUES ($vals)

SELECT COUNT(*) FROM t1;
DROP TABLE t1;

--disconnect con1
--connection default
SET @@global.max_allowed_packet= @old_max_allowed_packet;
