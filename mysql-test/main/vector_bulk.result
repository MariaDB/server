set @old_cache_size= @@global.mhnsw_max_cache_size;
set global mhnsw_max_cache_size= 1073741824;
#
# Test bulk construction and memory-budget fallback
#
# 1. ALTER TABLE completes entirely through bulk construction
create table t1 (id int auto_increment primary key, v vector(1) not null);
insert into t1 (id, v) values (1000000000, vec_fromtext('[-1]'));
alter table t1 add vector index (v) m=6;
show warnings;
Level	Code	Message
# Normal inserts work after bulk construction has released its context
insert into t1 (id, v) values (1000000001, vec_fromtext('[-2]'));
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
from t1 order by d limit 1;
id	d
1000000001	0
# 2. OPTIMIZE TABLE completes entirely through bulk construction
delete from t1 where id in (2, 3);
optimize table t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
from t1 order by d limit 1;
id	d
1000000001	0
drop table t1;
# 3. ALTER TABLE switches from bulk construction to normal inserts
set global mhnsw_max_cache_size= 1048576;
create table t1 (id int auto_increment primary key, v vector(1) not null);
insert into t1 (id, v) values (1000000000, vec_fromtext('[-1]'));
alter table t1 add vector index (v) m=6;
Warnings:
Note	1105	MHNSW: Bulk insert disabled because memory usage (memory_usage) exceeds mhnsw_max_cache_size (1048576). Falling back to normal insert.
show warnings;
Level	Code	Message
Note	1105	MHNSW: Bulk insert disabled because memory usage (memory_usage) exceeds mhnsw_max_cache_size (1048576). Falling back to normal insert.
# The cutoff row occurs once, and the normal-insert suffix is searchable
select id, vec_distance_euclidean(v, vec_fromtext('[1]')) d
from t1 order by d limit 2;
id	d
1	0
2	1
select id, vec_distance_euclidean(v, vec_fromtext('[-1]')) d
from t1 order by d limit 1;
id	d
1000000000	0
# Normal inserts remain usable after the mid-build switch
insert into t1 (id, v) values (1000000001, vec_fromtext('[-2]'));
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
from t1 order by d limit 1;
id	d
1000000001	0
# 4. OPTIMIZE TABLE can make the same mid-build switch
delete from t1 where id in (2, 3);
optimize table t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
select id, vec_distance_euclidean(v, vec_fromtext('[1]')) d
from t1 order by d limit 1;
id	d
1	0
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
from t1 order by d limit 1;
id	d
1000000001	0
drop table t1;
set global mhnsw_max_cache_size= @old_cache_size;
