create table t1 (a int, b int, primary key(a)) engine=innodb;
insert into t1 select seq, 1001-seq from seq_1_to_1000;
#
# For each plan: EXPLAIN (does it filesort?) and did parallel scan fire?
# NO filesort + parallel YES would be a wrong-results risk: the ordering
# would come from the scan, which parallel workers may reorder.
#
# ---- select * from t1 order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	index	NULL	PRIMARY	4	NULL	#	
     parallel: no
# ---- select * from t1 where a > 900 order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a > 900 order by a, b
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where; Using filesort
     parallel: no
# ---- select * from t1 where a between 100 and 199 order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a > 900 order by a limit 5
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a <= 100 order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select a from t1 where a > 900 group by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a > 900 and b > 0 order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a > 900 order by a desc
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a in (1,500,900) order by a
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where
     parallel: no
# ---- select * from t1 where a > 900 order by b
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	PRIMARY	PRIMARY	4	NULL	#	Using where; Using filesort
     parallel: no
drop table t1;
