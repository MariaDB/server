--echo #
--echo # MDEV-39343 Grant_tables_intact status variable
--echo #
--echo # Grant_tables_intact reflects whether mysql.db, mysql.roles_mapping,
--echo # mysql.proxies_priv, mysql.tables_priv, mysql.columns_priv,
--echo # mysql.procs_priv and mysql.global_priv structurally match this
--echo # server's compiled-in column definitions. It is recomputed in
--echo # acl_reload()/grant_reload(), i.e. on every FLUSH PRIVILEGES.
--echo #

source include/not_embedded.inc;

--echo # Both message shapes below are expected - they're exactly what
--echo # Table_check_intact logs when it finds the mismatches this test
--echo # deliberately introduces.
call mtr.add_suppression("is wrong. Expected");
call mtr.add_suppression("Incorrect definition of table");

--echo # Baseline: a freshly bootstrapped server must report intact.
SHOW STATUS LIKE 'Grant_tables_intact';

--echo #
--echo # mysql.db has real historical tolerance (min_columns=9 against a
--echo # current 23 columns), so dropping one privilege column still lets
--echo # the table load - it just no longer matches exactly.
--echo #
ALTER TABLE mysql.db DROP COLUMN Delete_history_priv;
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.db ADD COLUMN Delete_history_priv enum('N','Y') COLLATE utf8mb3_general_ci DEFAULT 'N' NOT NULL AFTER Trigger_priv;
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo #
--echo # mysql.roles_mapping, mysql.proxies_priv, mysql.tables_priv,
--echo # mysql.columns_priv, mysql.procs_priv and mysql.global_priv all
--echo # have min_columns pinned to their current column count (no
--echo # tolerance at all), so dropping a column would instead trip the
--echo # pre-existing ER_CANNOT_LOAD_FROM_TABLE_V2 check in
--echo # Grant_table_base::set_table() before Grant_tables_intact's own
--echo # logic ever runs (see grant_repair.test for that mechanism).
--echo # A type change on Host, instead, leaves the column count and key
--echo # structure untouched, so the table still loads and our check
--echo # actually gets exercised.
--echo #

--echo # mysql.roles_mapping
ALTER TABLE mysql.roles_mapping MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.roles_mapping MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # mysql.proxies_priv
ALTER TABLE mysql.proxies_priv MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.proxies_priv MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # mysql.tables_priv
ALTER TABLE mysql.tables_priv MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.tables_priv MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # mysql.columns_priv
ALTER TABLE mysql.columns_priv MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.columns_priv MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # mysql.procs_priv
ALTER TABLE mysql.procs_priv MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.procs_priv MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # mysql.global_priv
ALTER TABLE mysql.global_priv MODIFY COLUMN Host char(60) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';
ALTER TABLE mysql.global_priv MODIFY COLUMN Host char(255) binary NOT NULL DEFAULT '';
FLUSH PRIVILEGES;
SHOW STATUS LIKE 'Grant_tables_intact';

--echo # End of 10.11 tests
