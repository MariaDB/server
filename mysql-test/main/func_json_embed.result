#
# 3. Bytes that are not a document but do not look wrong afterwards.
#
# An empty value leaves nothing behind at all, so the result parses
# and reports one element fewer than it was given.  The document
# itself gives no sign of this, which is what makes the note the
# only way to tell it apart from an array that really was short.
#
SET SESSION check_constraint_checks = OFF;
INSERT INTO t1 VALUES (20, '', NULL);
INSERT INTO t1 VALUES (21, '   ', NULL);
INSERT INTO t1 VALUES (22, '// nothing here', NULL);
SET SESSION check_constraint_checks = ON;
SELECT id, JSON_ARRAY(j) AS v, JSON_VALID(JSON_ARRAY(j)) AS looks_fine,
JSON_LENGTH(JSON_ARRAY(j)) AS elements
FROM t1 WHERE id >= 20 ORDER BY id;
id	v	looks_fine	elements
20	[]	1	0
21	[   ]	1	0
22	[// nothing here]	0	NULL
