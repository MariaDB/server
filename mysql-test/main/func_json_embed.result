Warning	4038	Syntax error in JSON text in argument 2 to function 'json_object' at position 1
Warning	4038	Syntax error in JSON text in argument 2 to function 'json_object' at position 9
SELECT id, JSON_VALID(JSON_OBJECT('k', j)) AS built_a_document
FROM t1 WHERE id >= 10 ORDER BY id;
