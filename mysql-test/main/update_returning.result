#
# Too many rows + CONTINUE HANDLER
#
SET @a=100, @b=200;
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
CREATE PROCEDURE p1()
BEGIN
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
BEGIN
SET @b=@a;
END;
UPDATE t1 SET a=a+1 ORDER BY a RETURNING a INTO @a;
SELECT 'Still here' AS comment;
END;
$$
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
11
20
30
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
12	12
SELECT * FROM t1;
a
12
20
30
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
13	13
SELECT * FROM t1;
a
13
20
30
SET @a=NULL, @b=NULL;
DROP PROCEDURE p1;
DROP TABLE t1;
#
# Too many rows + EXIT HANDLER
#
SET @a=100, @b=200;
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
CREATE PROCEDURE p1()
BEGIN
DECLARE EXIT HANDLER FOR SQLEXCEPTION
BEGIN
SET @b=@a;
RESIGNAL;
END;
UPDATE t1 SET a=a+1 ORDER BY a RETURNING a INTO @a;
SELECT 'Still here' AS comment;
END;
$$
CALL p1();
ERROR 42000: Result consisted of more than one row
