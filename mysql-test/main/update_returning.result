20	b20
30	b30
CALL p1(0);
ERROR 42000: Result consisted of more than one row
SELECT * FROM t1;
a	b
12	b10
20	b20
30	b30
CALL p1(0);
ERROR 42000: Result consisted of more than one row
SELECT * FROM t1;
