#
# UPDATE..RETURNING..INTO row_var.not_existing_field
#
CREATE TABLE t1 (a INT,b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
CREATE PROCEDURE p1_row_explicit()
BEGIN
DECLARE r0 ROW(a INT, b VARCHAR(10));
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a,r0.b_not_existing;
SELECT r0.a, r0.b;
END;
$$
ERROR HY000: Row variable 'r0' does not have a field 'b_not_existing'
DROP TABLE t1;
CREATE TABLE t1 (a INT,b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
CREATE PROCEDURE p1_row_type_of_table()
BEGIN
DECLARE r0 ROW TYPE OF t1;
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a,r0.b_not_existing;
SELECT r0.a, r0.b;
END;
$$
CALL p1_row_type_of_table;
ERROR HY000: Row variable 'r0' does not have a field 'b_not_existing'
DROP PROCEDURE p1_row_type_of_table;
DROP TABLE t1;
CREATE TABLE t1 (a INT,b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
CREATE PROCEDURE p1_row_type_of_cursor()
BEGIN
DECLARE c1 CURSOR FOR SELECT * FROM t1;
BEGIN
DECLARE r0 ROW TYPE OF c1;
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a,r0.b_not_existing;
SELECT r0.a, r0.b;
END;
END;
$$
CALL p1_row_type_of_cursor;
ERROR HY000: Row variable 'r0' does not have a field 'b_not_existing'
DROP PROCEDURE p1_row_type_of_cursor;
