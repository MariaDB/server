13	b10
20	b20
30	b30
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (10,'b10'),(20,'b20'),(30,'b30');
CALL p1(30);
vrec.a	vrec.b
31	b30
CALL p1(30);
vrec.a	vrec.b
32	b30
CALL p1(30);
vrec.a	vrec.b
33	b30
SELECT * FROM t1;
a	b
10	b10
20	b20
33	b30
DROP PROCEDURE p1;
DROP TABLE t1;
#
# UPDATE..RETURNING..INTO for a `ROW TYPE OF cursor1` variable fields
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10'),(20,'b20'),(30,'b30');
CREATE PROCEDURE p1(pa INT)
BEGIN
DECLARE c1 CURSOR FOR SELECT * FROM t1;
BEGIN
DECLARE vrec ROW TYPE OF c1;
UPDATE t1 SET a=a+1 WHERE a>=pa RETURNING a,b INTO vrec.a, vrec.b;
SELECT vrec.a, vrec.b;
END;
END;
$$
