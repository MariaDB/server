#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
#
# UPDATE..RETURNING..INTO without INTO
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10'),(20,'b20');
CREATE PROCEDURE p1()
BEGIN
UPDATE t1 SET a=a+1 WHERE a>=20 RETURNING a,b;
END;
$$
CALL p1;
a	b
21	b20
CALL p1;
a	b
22	b20
CALL p1;
a	b
23	b20
DROP PROCEDURE p1;
DROP TABLE t1;
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (10);
UPDATE t1 SET a=OLD_VALUE(a);
UPDATE t1 SET a=OLD_VALUE(a) RETURNING a INTO @a;
ERROR HY000: Incorrect usage of OLD_VALUE(..) and RETURNING..INTO
UPDATE t1 SET a=OLD_VALUE(a)+1 RETURNING a INTO @a;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '+1 RETURNING a INTO @a' at line 1
UPDATE t1 SET a=1+OLD_VALUE(a) RETURNING a INTO @a;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '(a) RETURNING a INTO @a' at line 1
UPDATE t1 SET a=a+1 RETURNING OLD_VALUE(a) INTO @a;
ERROR HY000: Incorrect usage of OLD_VALUE(..) and RETURNING..INTO
UPDATE t1 SET a=a+1 RETURNING OLD_VALUE(a)+1 INTO @a;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '+1 INTO @a' at line 1
UPDATE t1 SET a=a+1 RETURNING 1+OLD_VALUE(a) INTO @a;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '(a) INTO @a' at line 1
UPDATE (SELECT OLD_VALUE(a) AS x FROM t1) AS dt SET dt.x=1;
ERROR HY000: The target table dt of the UPDATE is not updatable
DROP TABLE t1;
#
# ANALYZE/EXPLAIN UPDATE .. RETURNING .. INTO ..;
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
ANALYZE UPDATE t1 t1 SET a=11, b='b11' RETURNING a,b INTO @a, @b;
ERROR HY000: 'RETURNING..INTO' is not allowed in this context
SELECT @a,@b;
@a	@b
NULL	NULL
EXPLAIN UPDATE t1 t1 SET a=11, b='b11' RETURNING a,b INTO @a, @b;
ERROR HY000: 'RETURNING..INTO' is not allowed in this context
SELECT @a,@b;
@a	@b
NULL	NULL
DROP TABLE t1;
