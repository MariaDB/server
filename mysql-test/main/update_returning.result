@a
NULL
UPDATE t1 t1 SET a=11 RETURNING a,b INTO @a, @b, @c;
ERROR 21000: The used SELECT statements have a different number of columns
SELECT @a,@b,@c;
@a	@b	@c
NULL	NULL	NULL
PREPARE stmt FROM 'UPDATE t1 t1 SET a=11 RETURNING a,b INTO @a';
EXECUTE stmt;
ERROR 21000: The used SELECT statements have a different number of columns
SELECT @a;
@a
NULL
PREPARE stmt FROM 'UPDATE t1 t1 SET a=11 RETURNING a,b INTO @a, @b, @c';
EXECUTE stmt;
ERROR 21000: The used SELECT statements have a different number of columns
SELECT @a,@b,@c;
@a	@b	@c
NULL	NULL	NULL
DROP TABLE t1;
#
# Multi-table UPDATEs
#
CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT);
UPDATE t1,t2 SET t1.a=t1.a+1 WHERE t1.a=t2.b AND t1.a=10 RETURNING t1.a INTO @a;
ERROR 42000: This version of MariaDB doesn't yet support 'RETURNING for multi-table UPDATE'
UPDATE t1 SET a=a+1 WHERE a=(SELECT MAX(a) FROM t1) RETURNING a INTO @a;
ERROR HY000: 'RETURNING..INTO' is not allowed in this context
DROP TABLE t1,t2;
#
# Stored functions with UPDATE..RETURNING
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10');
CREATE FUNCTION f1() RETURNS INT
BEGIN
UPDATE t1 SET a=a+1 RETURNING a;
RETURN 1;
END;
$$
ERROR 0A000: Not allowed to return a result set from a function
CREATE FUNCTION f1() RETURNS INT
BEGIN
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
RETURN 1;
END;
$$
SELECT f1();
f1()
1
SELECT @a;
@a
11
SELECT * FROM t1;
a	b
11	b10
SET @a=NULL;
DROP FUNCTION f1;
DROP TABLE t1;
#
# Empty table do not raise errors
#
CREATE TABLE t1 (a INT);
SET @a=123;
UPDATE t1 SET a=10 RETURNING a INTO @a;
SELECT @a;
@a
123
SELECT * FROM t1;
a
SET @a=NULL;
DROP TABLE t1;
#
# Degenerated plans do not raise errors
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10);
SET @a=123;
UPDATE t1 SET a=11 WHERE 1=0 RETURNING a INTO @a;
SELECT @a;
@a
123
SELECT * FROM t1;
a
10
UPDATE t1 SET a=11 LIMIT 0 RETURNING a INTO @a;
SELECT @a;
@a
123
SELECT * FROM t1;
a
10
SET @a=NULL;
DROP TABLE t1;
