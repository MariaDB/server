CREATE PROCEDURE p1(pa INT)
BEGIN
DECLARE c1 CURSOR FOR SELECT * FROM t1;
BEGIN
DECLARE vrec ROW TYPE OF c1;
UPDATE t1 SET a=a+1 WHERE a>=pa RETURNING a,b INTO vrec;
SELECT vrec.a, vrec.b;
END;
END;
$$
CALL p1(100);
ERROR 02000: No data - zero rows fetched, selected, or processed
CALL p1(100);
ERROR 02000: No data - zero rows fetched, selected, or processed
CALL p1(100);
ERROR 02000: No data - zero rows fetched, selected, or processed
