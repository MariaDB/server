--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_disconnect_watcher.inc

if ($MTR_COMBINATION_PIPE)
{
  --source include/windows.inc
}
if ($MTR_COMBINATION_SOCKET)
{
  if (`select convert(@@version_compile_os using latin1) IN ("Win32","Win64","Windows")`)
  {
    --skip Windows has no unix socket
  }
}

--echo #
--echo # MDEV-38741 Client disconnect fails to abort a lock wait
--echo # The client process is killed, on each of the connection protocols
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

connect (blocker,localhost,root);
BEGIN;
SELECT * FROM t1 FOR UPDATE;

connection default;
--echo # A client waits for the lock
--perl
  my $proto= $ENV{MTR_COMBINATION_PIPE} ? "pipe" :
             $ENV{MTR_COMBINATION_SOCKET} ? "socket" : "tcp";
  my @cmd= ($ENV{EXE_MYSQL}, "--no-defaults", "--user=root", "--database=test",
            "--protocol=$proto",
            "--init-command=SET innodb_lock_wait_timeout=3600");
  push @cmd, $proto eq "tcp" ? ("--host=127.0.0.1", "--port=$ENV{MASTER_MYPORT}")
                             : ("--socket=$ENV{MASTER_MYSOCK}");
  push @cmd, "-e", "SELECT * FROM t1 FOR UPDATE";

  # The client must not inherit the pipe mysqltest reads the output from
  my $windows= $^O eq "MSWin32";
  open(STDIN, "<", $windows ? "NUL" : "/dev/null") or die $!;
  open(STDOUT, ">", "$ENV{MYSQLTEST_VARDIR}/log/disconnect_client_killed.out")
    or die $!;
  open(STDERR, ">&STDOUT") or die $!;

  my $pid;
  if ($windows)
  {
    $pid= system(1, @cmd);
  }
  else
  {
    $pid= fork();
    die $! unless defined $pid;
    exec(@cmd) or exit 127 unless $pid;
  }
  open(F, ">", "$ENV{MYSQLTEST_VARDIR}/tmp/disconnect_client_killed.pid")
    or die $!;
  print F $pid;
  close F;
EOF

let $wait_condition=
  SELECT COUNT(*) = 1 FROM information_schema.innodb_lock_waits;
--source include/wait_condition.inc
let $waiter_id=
  `SELECT trx_mysql_thread_id FROM information_schema.innodb_trx
   WHERE trx_state = 'LOCK WAIT'`;

--echo # The client process is killed, the server is not reading from the connection
--perl
  open(F, "<", "$ENV{MYSQLTEST_VARDIR}/tmp/disconnect_client_killed.pid")
    or die $!;
  my $pid= <F>;
  close F;
  kill 9, $pid or die "Cannot kill $pid";
EOF

let $wait_condition=
  SELECT COUNT(*) = 0 FROM information_schema.processlist
  WHERE id = $waiter_id;
--source include/wait_condition.inc

--echo # The reason is logged
let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= Aborted connection $waiter_id to db[^\n]*Client disconnected;
let SEARCH_WAIT= FOUND;
let SEARCH_OUTPUT= count;
--source include/search_pattern_in_file.inc

--remove_file $MYSQLTEST_VARDIR/tmp/disconnect_client_killed.pid
--remove_file $MYSQLTEST_VARDIR/log/disconnect_client_killed.out

disconnect blocker;
DROP TABLE t1;

--echo # End of 13.2 tests
