DROP TABLE IF EXISTS t1, t2;
DROP VIEW IF EXISTS v1;
CREATE TABLE t1 (a INT, b INT, KEY idx_b(b));
CREATE TABLE t2 (a INT, c INT);
CREATE VIEW v1 AS SELECT * FROM t1;
