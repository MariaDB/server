--source include/not_embedded.inc

create user foo;
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require SSL;
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require X509;
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require CIPHER 'cipher';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require ISSUER 'issuer';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require SUBJECT 'subject';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require CIPHER 'cipher'
                                                   SUBJECT 'subject';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo identified by 'password' require CIPHER 'cipher' 
                                                   AND SUBJECT 'subject'
                                                   AND ISSUER 'issuer';
select * from mysql.user where user = 'foo';
drop user foo;

create user foo, foo2 identified by 'password' require CIPHER 'cipher' 
                                                   AND SUBJECT 'subject'
                                                   AND ISSUER 'issuer';
select * from mysql.user where user like 'foo';

--echo #--warning ER_USER_CREATE_EXISTS
create user if not exists foo, foo2 identified by 'password2'
    require CIPHER 'cipher2' AND SUBJECT 'subject2' AND ISSUER 'issuer2';
select * from mysql.user where user like 'foo';
drop user foo, foo2;

create user foo with MAX_QUERIES_PER_HOUR 10
                     MAX_UPDATES_PER_HOUR 20
                     MAX_CONNECTIONS_PER_HOUR 30
                     MAX_USER_CONNECTIONS 40;
select * from mysql.user where user like 'foo';
drop user foo;

--echo # End of 10.2 tests

--echo #
--echo # MDEV-24193 UBSAN: sql/sql_acl.cc:9985:29: runtime error: member access within null pointer of type 'struct TABLE' , ASAN: use-after-poison in handle_grant_table
--echo #
RENAME TABLE mysql.procs_priv TO mysql.temp;
--error ER_PLUGIN_IS_NOT_LOADED
CREATE USER a IDENTIFIED WITH 'a';
RENAME TABLE mysql.temp TO mysql.procs_priv;

--echo # End of 10.5 tests

--echo #
--echo # MDEV-42407 usernames with embedded \0
--echo #
call mtr.add_suppression("ignored: NUL byte in a name");
create user foo@localhost;
--error ER_WRONG_VALUE
drop user 'foo\0bar'@localhost;
--error ER_WRONG_VALUE
create user 'foo\0bar'@localhost;
--error ER_WRONG_VALUE
create user foo@'localhost\0bar';
--error ER_WRONG_VALUE
create role 'foo\0bar';
--error ER_WRONG_VALUE
grant 'foo\0bar' to foo@localhost;
--error ER_WRONG_VALUE
set role 'foo\0bar';
select quote(user), quote(host) from mysql.global_priv where user like 'foo%';
create role r1;
insert mysql.global_priv (host, user, priv) values
  ('localhost', 'foo\0bar', '{"access":1}'),
  ('localhost\0bar', 'foo', '{"access":1}');
insert mysql.db (host, db, user, select_priv) values
  ('localhost', 'test', 'foo\0bar', 'Y'),
  ('localhost', 'test\0bar', 'foo', 'Y');
insert mysql.tables_priv (host, db, user, table_name, table_priv) values
  ('localhost', 'test', 'foo\0bar', 't1', 'Select'),
  ('localhost', 'test', 'foo', 't1\0bar', 'Select');
insert mysql.procs_priv (host, db, user, routine_name, routine_type, proc_priv)
  values ('localhost', 'test', 'foo\0bar', 'p1', 'PROCEDURE', 'Execute'),
         ('localhost', 'test', 'foo', 'p1\0bar', 'PROCEDURE', 'Execute');
insert mysql.proxies_priv (host, user, proxied_host, proxied_user, with_grant)
  values ('localhost', 'foo\0bar', 'localhost', 'root', 1),
         ('localhost', 'foo', 'localhost', 'root\0bar', 1);
insert mysql.roles_mapping (host, user, role, admin_option) values
  ('localhost', 'foo\0bar', 'r1', 'N'),
  ('localhost', 'foo', 'r1\0bar', 'N');
flush privileges;
show grants for foo@localhost;
let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= \S+ entry with \S+ ignored: NUL byte in a name;
let SEARCH_OUTPUT= matches;
source include/search_pattern_in_file.inc;
delete from mysql.global_priv where user like 'foo_bar' or host like 'localhost_bar';
delete from mysql.db where user like 'foo_bar' or db like 'test_bar';
delete from mysql.tables_priv where user like 'foo_bar' or table_name like 't1_bar';
delete from mysql.procs_priv where user like 'foo_bar' or routine_name like 'p1_bar';
delete from mysql.proxies_priv where user like 'foo_bar' or proxied_user like 'root_bar';
delete from mysql.roles_mapping where user like 'foo_bar' or role like 'r1_bar';
flush privileges;
drop user foo@localhost;
drop role r1;
--echo # End of 10.11 tests
