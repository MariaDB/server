#
# Parallel Query: the scan-only prototype (debug_dbug='+d,pwt_scan_only'),
# in which the workers only read the driving table and this thread runs the
# rest of the plan.
#
--source include/count_sessions.inc
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

SET DEBUG_SYNC='RESET';
--disable_service_connection

CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq*10 FROM seq_1_to_100;

connect (killee, localhost, root, , );
let $id= `SELECT connection_id()`;
SET SESSION optimizer_parallel_setup_cost= 0;
SET SESSION parallel_worker_threads=4;
SET SESSION debug_dbug='+d,pwt_scan_only';

--echo #
--echo # The engine declines a locking read: the statement runs serially
--echo #
--sorted_result
SELECT a FROM t1 WHERE a > 97 FOR UPDATE;
CREATE TEMPORARY TABLE t2 ENGINE=InnoDB AS SELECT a, b FROM t1 WHERE a > 97;
SELECT a, b FROM t2 ORDER BY a;
DROP TEMPORARY TABLE t2;

--echo #
--echo # A scan the workers do read gives the serial answer
--echo #
FLUSH STATUS;
--disable_ps2_protocol
SELECT COUNT(*), SUM(b) FROM t1 WHERE a > 10;
--enable_ps2_protocol
SHOW SESSION STATUS LIKE 'Parallel_queries_executed';

--echo #
--echo # KILL QUERY while the workers are paused: ER_QUERY_INTERRUPTED
--echo #
SET @save_dbug= @@global.debug_dbug;
SET GLOBAL debug_dbug= '+d,pwt_worker_pause_before_signal';
--send SELECT a FROM t1

--connection default
SET DEBUG_SYNC='now WAIT_FOR pwt_worker_paused';
let $wait_condition=
  SELECT count(*) = 4 FROM information_schema.processlist
  WHERE state LIKE 'debug sync%' AND info LIKE '%Thread ID $id';
--source include/wait_condition.inc
--replace_result $id ID
eval KILL QUERY $id;
SET DEBUG_SYNC='now SIGNAL pwt_worker_continue';
let $wait_condition=
  SELECT count(*) = 1 FROM information_schema.processlist
  WHERE command = 'Sleep' AND id = $id;
--source include/wait_condition.inc

--connection killee
--error ER_QUERY_INTERRUPTED
reap;
SET GLOBAL debug_dbug= @save_dbug;

--echo # the connection survives
SELECT COUNT(*) FROM t1;

--disconnect killee
--connection default
SET DEBUG_SYNC='RESET';
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
