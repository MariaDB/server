#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES latin7 COLLATE latin7_general_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_general_ci,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_general_ci,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_general_ci,COERCIBLE) for operation '='
SET NAMES latin7 COLLATE latin7_estonian_cs;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_estonian_cs,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_estonian_cs,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_estonian_cs,COERCIBLE) for operation '='
SET NAMES latin7 COLLATE latin7_bin;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin7_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
