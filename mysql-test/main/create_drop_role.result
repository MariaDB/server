#
# MDEV-37214: CREATE OR REPLACE ROLE must take the old role's privileges
# away from the roles and users that had it granted
#
CREATE TABLE t_mdev37214 (a INT);
INSERT INTO t_mdev37214 VALUES (1);
CREATE ROLE r1;
CREATE ROLE r2;
GRANT SELECT ON test.t_mdev37214 TO r1;
GRANT r1 TO r2;
CREATE USER u_mdev37214@localhost;
GRANT r2 TO u_mdev37214@localhost;
connect  u_mdev37214, localhost, u_mdev37214,,;
SET ROLE r2;
SELECT * FROM test.t_mdev37214;
a
1
disconnect u_mdev37214;
connection default;
SELECT grantee, privilege_type FROM information_schema.table_privileges
WHERE table_name='t_mdev37214' ORDER BY grantee;
grantee	privilege_type
'r1'@''	SELECT
'r2'@''	SELECT
CREATE OR REPLACE ROLE r1;
SELECT grantee, privilege_type FROM information_schema.table_privileges
WHERE table_name='t_mdev37214' ORDER BY grantee;
grantee	privilege_type
SHOW GRANTS FOR r2;
Grants for r2
GRANT USAGE ON *.* TO `r2`
SHOW GRANTS FOR r1;
Grants for r1
GRANT USAGE ON *.* TO `r1`
connect  u_mdev37214, localhost, u_mdev37214,,;
SET ROLE r2;
SELECT * FROM test.t_mdev37214;
ERROR 42000: SELECT command denied to user 'u_mdev37214'@'localhost' for table `test`.`t_mdev37214`
disconnect u_mdev37214;
connection default;
DROP ROLE r1;
DROP ROLE r2;
DROP USER u_mdev37214@localhost;
DROP TABLE t_mdev37214;
#
# MDEV-37214: a role repeated in CREATE OR REPLACE ROLE must not leave
# duplicate backlinks in the role graph
#
CREATE ROLE r_dup;
CREATE ROLE r_dup_parent;
GRANT r_dup TO r_dup_parent;
CREATE OR REPLACE ROLE r_dup, r_dup;
CREATE OR REPLACE ROLE r_dup, r_dup;
SHOW GRANTS FOR r_dup_parent;
Grants for r_dup_parent
GRANT USAGE ON *.* TO `r_dup_parent`
DROP ROLE r_dup;
DROP ROLE r_dup_parent;
