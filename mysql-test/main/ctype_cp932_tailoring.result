#
# DATE_FORMAT() result repertoire depends on the locale
# which is actually used: the explicit third argument, or
# @@lc_time_names. Locale names (e.g. of days) can be non-ASCII.
# cp932_japanese_ci and latin1_swedish_ci are compatible on ASCII, so
# no error is expected, whatever the repertoire of the result is.
#
SET NAMES cp932;
# en_US names are ASCII
SELECT DATE_FORMAT('2024-01-02','%W') = _latin1'a';
DATE_FORMAT('2024-01-02','%W') = _latin1'a'
0
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin1'a';
DATE_FORMAT('2024-01-02','%W','en_US') = _latin1'a'
0
# An explicit non-ASCII locale is not ignored.
# This query does not fail with an error: the DATE_FORMAT() result is
# non-ASCII, so the collation of the result is used for comparison.
# Note, it would not fail even if the result was ASCII, as
# cp932_japanese_ci and latin1_swedish_ci are compatible on ASCII.
SELECT DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin1'a';
DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin1'a'
0
# A non-constant locale is not known at the fixing time
SET @loc='en_US';
SELECT DATE_FORMAT('2024-01-02','%W',@loc) = _latin1'a';
DATE_FORMAT('2024-01-02','%W',@loc) = _latin1'a'
0
# The session locale is not used when the locale is passed explicitly
SET lc_time_names=ru_RU;
SELECT DATE_FORMAT('2024-01-02','%W') = _latin1'a';
DATE_FORMAT('2024-01-02','%W') = _latin1'a'
0
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin1'a';
DATE_FORMAT('2024-01-02','%W','en_US') = _latin1'a'
0
SET lc_time_names=DEFAULT;
SET NAMES DEFAULT;
#
# DATE_FORMAT() with cp932 and latin5. cp932_japanese_ci and
# latin5_turkish_ci are not compatible on ASCII (latin5_turkish_ci
# reorders ASCII letters), so unlike the latin1 queries above,
# the repertoire of the DATE_FORMAT() result decides the outcome.
#
SET NAMES cp932;
# en_US names are ASCII: no side is a superset, and the tailorings
# are not equal, so the query fails
SELECT DATE_FORMAT('2024-01-02','%W') = _latin5'a';
ERROR HY000: Illegal mix of collations (cp932_japanese_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin5'a';
ERROR HY000: Illegal mix of collations (cp932_japanese_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
# ru_RU names are not ASCII: the right side is ASCII only, so it
# is converted to cp932, and the left side collation wins
SELECT DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin5'a';
DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin5'a'
0
# A non-constant locale is not known at the fixing time
SET @loc='en_US';
SELECT DATE_FORMAT('2024-01-02','%W',@loc) = _latin5'a';
DATE_FORMAT('2024-01-02','%W',@loc) = _latin5'a'
0
# The session locale is not used when the locale is passed explicitly
SET lc_time_names=ru_RU;
SELECT DATE_FORMAT('2024-01-02','%W') = _latin5'a';
DATE_FORMAT('2024-01-02','%W') = _latin5'a'
0
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin5'a';
ERROR HY000: Illegal mix of collations (cp932_japanese_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
SET lc_time_names=DEFAULT;
SET NAMES DEFAULT;
# End of 11.8 tests
