#
# MENT-2394 DEFINER=<role> becomes ''@'' when the routine is executed
#
--source include/not_embedded.inc

create role r1;
grant create view, select, execute on *.* to r1;

delimiter |;
create definer=r1 procedure p1()
begin
  create view v1 as select 1;
end|
delimiter ;|

show create procedure p1;

# Executing the procedure must not raise a "no such user ''@''" note,
# and the view created inside it must inherit r1 as its definer.
call p1();
show warnings;
show create view v1;

drop view v1;
drop procedure p1;
drop role r1;
