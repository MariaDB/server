--source include/have_debug.inc
--source include/have_utf8mb4.inc

--echo #
--echo # MDEV-42316 A binary string parameter is read byte by byte on every execution to compute its repertoire, and since MDEV-41246 this read takes about 1.2 ms per MB of ASCII data
--echo #
--echo # A string parameter that is the whole value assigned to a column,
--echo # to a user variable, to a variable of a stored program, or to a
--echo # procedure parameter by CALL is stored as is, and nothing reads it
--echo # as text. Its value is not read to find its repertoire and its
--echo # length in characters, in any character set. A parameter inside
--echo # an expression, in a WHERE condition or in a SELECT list is still
--echo # read. Each read gives a DBUG note. Every statement also has a
--echo # parameter that is read: CONCAT(?, '') assigned to the column r or
--echo # to a variable, or a parameter in a WHERE condition, in an
--echo # expression or in a SELECT list.
--echo #

SET NAMES latin1;
CREATE TABLE t1 (id INT PRIMARY KEY, b LONGBLOB,
                 c VARCHAR(10) CHARACTER SET latin1,
                 u VARCHAR(10) CHARACTER SET utf8mb4,
                 r VARCHAR(10) CHARACTER SET latin1);
CREATE TABLE t2 (id INT PRIMARY KEY);
INSERT INTO t2 VALUES (1),(2);
CREATE PROCEDURE p1(a LONGBLOB, b VARCHAR(10))
  INSERT INTO t1 (id, b, r) VALUES (7, a, b);

SET @i1= 1, @i2= 2, @i3= 3, @i4= 4, @i8= 8;
SET @b1= CAST('b1' AS BINARY), @b2= x'FF42', @b3= CAST('b3' AS BINARY);
SET @c1= _latin1'c1', @c2= _latin1'c2', @c3= _latin1'c3';
SET @u1= _utf8mb4 x'C3A931';
SET @r1= _latin1'r1', @r2= _latin1'r2', @r3= _latin1'r3',
    @r4= _latin1'r4', @r5= _latin1'r5';

--let $file= $MYSQLTEST_VARDIR/tmp/ps_param_metadata_debug.txt
--write_file $file
5
6
EOF

SET @saved_dbug= @@debug_dbug;
SET SESSION debug_dbug="+d,Item_param_metadata";

--echo # INSERT ... VALUES, two rows
PREPARE s FROM 'INSERT INTO t1 (id, b, c, r) VALUES (?, ?, ?, CONCAT(?, '''')), (?, ?, ?, NULL)';
EXECUTE s USING @i1, @b1, @c1, @r1, @i2, @b2, @c2;
DEALLOCATE PREPARE s;

--echo # A utf8mb4 connection: neither the binary nor the utf8mb4
--echo # parameter is read
SET NAMES utf8mb4;
PREPARE s FROM 'INSERT INTO t1 (id, b, u, r) VALUES (?, ?, ?, CONCAT(?, ''''))';
EXECUTE s USING @i4, @b2, @u1, @r1;
DEALLOCATE PREPARE s;
SET NAMES latin1;

--echo # INSERT ... SET
PREPARE s FROM 'INSERT INTO t1 SET id= ?, b= ?, c= ?, r= CONCAT(?, '''')';
EXECUTE s USING @i3, @b3, @c3, @r2;
DEALLOCATE PREPARE s;

--echo # REPLACE ... VALUES
PREPARE s FROM 'REPLACE INTO t1 (id, b, c, r) VALUES (?, ?, ?, CONCAT(?, ''''))';
EXECUTE s USING @i3, @b2, @c2, @r3;
DEALLOCATE PREPARE s;

--echo # INSERT ... ON DUPLICATE KEY UPDATE
PREPARE s FROM 'INSERT INTO t1 (id, b) VALUES (?, ?) ON DUPLICATE KEY UPDATE b= ?, r= CONCAT(?, '''')';
EXECUTE s USING @i3, @b1, @b3, @r4;
DEALLOCATE PREPARE s;

--echo # INSERT ... SELECT: the SELECT list parameter is read,
--echo # the ON DUPLICATE KEY UPDATE parameter is not
PREPARE s FROM 'INSERT INTO t1 (id, c) SELECT id, ? FROM t2 ON DUPLICATE KEY UPDATE c= ?';
EXECUTE s USING @c3, @c1;
DEALLOCATE PREPARE s;

--echo # UPDATE: the SET parameters are not read, the WHERE parameter is
PREPARE s FROM 'UPDATE t1 SET b= ?, c= ? WHERE c= ?';
EXECUTE s USING @b2, @c2, @c1;
DEALLOCATE PREPARE s;

--echo # Multi-table UPDATE
PREPARE s FROM 'UPDATE t1, t2 SET t1.b= ?, t1.r= CONCAT(?, '''') WHERE t1.id= t2.id';
EXECUTE s USING @b1, @r5;
DEALLOCATE PREPARE s;

--echo # LOAD DATA ... SET
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
eval PREPARE s FROM 'LOAD DATA INFILE ''$file'' INTO TABLE t1 (id) SET b= ?, r= CONCAT(?, '''')';
EXECUTE s USING @b3, @r1;
DEALLOCATE PREPARE s;

--echo # User variables
PREPARE s FROM 'SET @v1= ?, @v2= CONCAT(?, '''')';
EXECUTE s USING @b2, @r2;
DEALLOCATE PREPARE s;
SELECT HEX(@v1), @v2;

--echo # CALL
PREPARE s FROM 'CALL p1(?, CONCAT(?, ''''))';
EXECUTE s USING @b1, @r3;
DEALLOCATE PREPARE s;

--echo # A compound statement: a variable default, a ROW field,
--echo # a variable and the columns of an INSERT
PREPARE s FROM 'BEGIN NOT ATOMIC DECLARE v LONGBLOB DEFAULT ?; DECLARE w ROW (x LONGBLOB); SET w.x= ?; INSERT INTO t1 (id, b, c, r) VALUES (?, v, ?, CONCAT(?, '''')); SET v= ?; UPDATE t1 SET b= CONCAT(v, w.x) WHERE id= 8; END';
EXECUTE s USING @b1, @b2, @i8, @c1, @r4, @b3;
DEALLOCATE PREPARE s;

--echo # The binary protocol
# The PS_ commands are sent as SQL when these protocols are on
--disable_cursor_protocol
--disable_ps_protocol
--PS_prepare INSERT INTO t1 (id, c, r) VALUES (?, ?, CONCAT(?, ''))
--PS_bind 9 c9 r9
--PS_execute
--PS_close
--enable_ps_protocol
--enable_cursor_protocol

--echo # A parameter inside an expression
PREPARE s FROM 'UPDATE t1 SET b= CONCAT(?, ''x'') WHERE id= 3';
EXECUTE s USING @b3;
DEALLOCATE PREPARE s;

--echo # A parameter in a SELECT list
PREPARE s FROM 'SELECT HEX(?) AS h';
EXECUTE s USING @b2;
DEALLOCATE PREPARE s;

SET SESSION debug_dbug= @saved_dbug;

SELECT id, HEX(b), HEX(c), HEX(u), r FROM t1 ORDER BY id;
--remove_file $file
DROP PROCEDURE p1;
DROP TABLE t1, t2;

--echo #
--echo # End of 10.11 tests
--echo #
