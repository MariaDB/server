--source include/have_innodb.inc

--echo #
--echo # MDEV-39563 Implement UPDATE ... RETURNING ... INTO
--echo #

--echo #
--echo # MDEV-42212 UPDATE ... RETURNING ... INTO raises ER_TOO_MANY_ROWS on InnoDB when the second found row needs no update
--echo #

--echo #
--echo # The second row is found, but its new values are the same as the old
--echo # values, so it is not changed. Plain RETURNING returns only the first
--echo # row, and RETURNING .. INTO assigns it (no ER_TOO_MANY_ROWS).
--echo # The updated column is not read by the statement, so InnoDB does not
--echo # return it, and the server reads it for the comparison.
--echo # The test is run for MyISAM and InnoDB
--echo # (see update_returning_into_same_row.combinations).
--echo #

--echo #
--echo # The new value of the second row is the old value
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,1),(2,5);
UPDATE t1 SET b=IF(a=1,100,5) RETURNING a;
SELECT * FROM t1;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1),(2,5);
SET @a='unchanged';
UPDATE t1 SET b=IF(a=1,100,5) RETURNING a INTO @a;
SELECT @a;
SELECT * FROM t1;
DROP TABLE t1;

--echo #
--echo # The same with a filesort, an index range scan, and ORDER BY..LIMIT.
--echo # The engine decides which columns to read when a scan is started,
--echo # so the columns must be added to the read set before that.
--echo #

CREATE TABLE t1 (a INT, b INT, c INT, KEY(c));
INSERT INTO t1 VALUES (1,1,10),(2,5,20);

--echo # Filesort
UPDATE t1 SET b=IF(a=1,100,5) ORDER BY c RETURNING a;
SELECT * FROM t1;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1,10),(2,5,20);
SET @a='unchanged';
UPDATE t1 SET b=IF(a=1,100,5) ORDER BY c RETURNING a INTO @a;
SELECT @a;
SELECT * FROM t1;

--echo # Index range scan
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1,10),(2,5,20);
UPDATE t1 SET b=IF(a=1,100,5) WHERE c>0 RETURNING a;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1,10),(2,5,20);
SET @a='unchanged';
UPDATE t1 SET b=IF(a=1,100,5) WHERE c>0 RETURNING a INTO @a;
SELECT @a;
SELECT * FROM t1;

--echo # ORDER BY..LIMIT
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1,10),(2,5,20);
UPDATE t1 SET b=IF(a=1,100,5) ORDER BY c LIMIT 2 RETURNING a;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1,10),(2,5,20);
SET @a='unchanged';
UPDATE t1 SET b=IF(a=1,100,5) ORDER BY c LIMIT 2 RETURNING a INTO @a;
SELECT @a;
SELECT * FROM t1;
DROP TABLE t1;

--echo # End of 13.1 tests
