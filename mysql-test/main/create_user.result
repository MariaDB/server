#
# MDEV-24193 UBSAN: sql/sql_acl.cc:9985:29: runtime error: member access within null pointer of type 'struct TABLE' , ASAN: use-after-poison in handle_grant_table
#
RENAME TABLE mysql.procs_priv TO mysql.temp;
CREATE USER a IDENTIFIED WITH 'a';
ERROR HY000: Plugin 'a' is not loaded
RENAME TABLE mysql.temp TO mysql.procs_priv;
# End of 10.5 tests
#
# MDEV-42407 usernames with embedded \0
#
call mtr.add_suppression("ignored: invalid name");
create user foo@localhost;
drop user 'foo\0bar'@localhost;
ERROR HY000: Incorrect user name value: 'foo\x00bar'
create user 'foo\0bar'@localhost;
ERROR HY000: Incorrect user name value: 'foo\x00bar'
create user foo@'localhost\0bar';
ERROR HY000: Incorrect host name value: 'localhost\x00bar'
create role 'foo\0bar';
ERROR HY000: Incorrect user name value: 'foo\x00bar'
grant 'foo\0bar' to foo@localhost;
ERROR HY000: Incorrect user name value: 'foo\x00bar'
set role 'foo\0bar';
ERROR HY000: Incorrect user name value: 'foo\x00bar'
drop user 'foo '@localhost;
ERROR HY000: Incorrect user name value: 'foo '
create user 'foo '@localhost;
ERROR HY000: Incorrect user name value: 'foo '
create user foo@'localhost ';
ERROR HY000: Incorrect host name value: 'localhost '
grant select on test.* to 'foo '@localhost;
ERROR HY000: Incorrect user name value: 'foo '
select quote(user), quote(host) from mysql.global_priv where user like 'foo%';
quote(user)	quote(host)
'foo'	'localhost'
select grantee from information_schema.user_privileges where grantee like '%foo%';
grantee
'foo'@'localhost'
create role r1;
insert mysql.global_priv (host, user, priv) values
('localhost', 'foo\0bar', '{"access":1}'),
('localhost\0bar', 'foo', '{"access":1}');
insert mysql.db (host, db, user, select_priv) values
('localhost', 'test', 'foo\0bar', 'Y'),
('localhost', 'test\0bar', 'foo', 'Y');
insert mysql.tables_priv (host, db, user, table_name, table_priv) values
('localhost', 'test', 'foo\0bar', 't1', 'Select'),
('localhost', 'test', 'foo', 't1\0bar', 'Select');
insert mysql.procs_priv (host, db, user, routine_name, routine_type, proc_priv)
values ('localhost', 'test', 'foo\0bar', 'p1', 'PROCEDURE', 'Execute'),
('localhost', 'test', 'foo', 'p1\0bar', 'PROCEDURE', 'Execute');
insert mysql.proxies_priv (host, user, proxied_host, proxied_user, with_grant)
values ('localhost', 'foo\0bar', 'localhost', 'root', 1),
('localhost', 'foo', 'localhost', 'root\0bar', 1);
insert mysql.roles_mapping (host, user, role, admin_option) values
('localhost', 'foo\0bar', 'r1', 'N'),
('localhost', 'foo', 'r1\0bar', 'N');
alter table mysql.global_priv modify User varchar(128) collate utf8mb3_nopad_bin default '';
alter table mysql.db modify User varchar(128) binary default '' not null;
insert mysql.global_priv (host, user, priv) values
('localhost', 'foo ', '{"access":1}');
insert mysql.db (host, db, user, select_priv) values
('localhost', 'test', 'foo ', 'Y');
flush privileges;
