RETURN 0;
END;
$$
CREATE PROCEDURE p1()
BEGIN
DECLARE n INT;
SET n= f2();
END;
$$
CALL p1;
DROP PROCEDURE p1;
DROP FUNCTION f2;
DROP PROCEDURE p3;
DROP TABLE t1;
