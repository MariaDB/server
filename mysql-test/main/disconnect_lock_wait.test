--source include/not_embedded.inc
--source include/maybe_pool_of_threads.inc
--source include/have_innodb.inc
--source include/have_disconnect_watcher.inc

--echo #
--echo # MDEV-38741 Client disconnect fails to abort a lock wait
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

connect (blocker,localhost,root);
BEGIN;
SELECT * FROM t1 FOR UPDATE;
--source include/count_sessions.inc

--echo # Orderly disconnects log nothing, also if the thread is still finishing
let $aborted= `SELECT variable_value FROM information_schema.global_status
               WHERE variable_name = 'ABORTED_CLIENTS'`;
let $i= 20;
while ($i)
{
  --disable_query_log
  --disable_result_log
  connect (con2,localhost,root);
  SELECT 1;
  disconnect con2;
  --enable_result_log
  --enable_query_log
  dec $i;
}
connection default;
--source include/wait_until_count_sessions.inc
let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= Aborted connection;
let SEARCH_OUTPUT= count;
--source include/search_pattern_in_file.inc
--disable_query_log
eval SELECT variable_value - $aborted AS aborted_clients
FROM information_schema.global_status WHERE variable_name = 'ABORTED_CLIENTS';
--enable_query_log

--echo # The default connection, a unix socket where there are any, then TCP
let $round= 1;
while ($round <= 2)
{
  let $host= localhost;
  if ($round == 2)
  {
    let $host= 127.0.0.1;
  }
  let $aborted= `SELECT variable_value FROM information_schema.global_status
                 WHERE variable_name = 'ABORTED_CLIENTS'`;
  --disable_query_log
  connect (con1,$host,root,,,$MASTER_MYPORT);
  --enable_query_log
  let $con1_id= `SELECT CONNECTION_ID()`;
  SET innodb_lock_wait_timeout=3600;
  send SELECT * FROM t1 FOR UPDATE;

  connection default;
  # This connection waits, not a leftover of the previous round
  let $wait_condition=
    SELECT COUNT(*) = 1 FROM information_schema.innodb_lock_waits w
    JOIN information_schema.innodb_trx t ON t.trx_id = w.requesting_trx_id
    WHERE t.trx_mysql_thread_id = $con1_id;
  --source include/wait_condition.inc

  --echo # Disconnect abruptly, the server is not reading from the socket
  connection con1;
  dirty_close con1;

  connection default;
  let $wait_condition=
    SELECT COUNT(*) = 0 FROM information_schema.processlist
    WHERE id = $con1_id;
  --source include/wait_condition.inc

  --echo # The connection is logged once, with the reason
  let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
  let SEARCH_PATTERN= Aborted connection $con1_id to db[^\n]*Client disconnected;
  let SEARCH_WAIT= FOUND;
  let SEARCH_OUTPUT= count;
  --source include/search_pattern_in_file.inc
  let SEARCH_PATTERN= Aborted connection $con1_id to db;
  let SEARCH_WAIT=;
  --source include/search_pattern_in_file.inc
  --disable_query_log
  eval SELECT variable_value - $aborted AS aborted_clients
  FROM information_schema.global_status WHERE variable_name = 'ABORTED_CLIENTS';
  --enable_query_log
  inc $round;
}

--echo # With the watcher OFF, a connection is not aborted, if it was switched OFF
--echo # before the connection was made, and if after
let $save_disconnect_watcher= `SELECT @@global.disconnect_watcher`;
let $off_before_connect= 1;
while ($off_before_connect >= 0)
{
  if ($off_before_connect)
  {
    SET GLOBAL disconnect_watcher= OFF;
  }
  --disable_query_log
  connect (con1,127.0.0.1,root,,,$MASTER_MYPORT);
  --enable_query_log
  let $con1_id= `SELECT CONNECTION_ID()`;
  SET innodb_lock_wait_timeout=3600;
  send SELECT * FROM t1 FOR UPDATE;

  connection default;
  let $wait_condition=
    SELECT COUNT(*) = 1 FROM information_schema.innodb_lock_waits w
    JOIN information_schema.innodb_trx t ON t.trx_id = w.requesting_trx_id
    WHERE t.trx_mysql_thread_id = $con1_id;
  --source include/wait_condition.inc
  if (!$off_before_connect)
  {
    SET GLOBAL disconnect_watcher= OFF;
  }

  connection con1;
  dirty_close con1;

  connection default;
  --echo # Not noticed, the statement keeps waiting until the lock is released
  --disable_query_log
  eval SELECT COUNT(*) AS still_waiting
  FROM information_schema.innodb_lock_waits w
  JOIN information_schema.innodb_trx t ON t.trx_id = w.requesting_trx_id
  WHERE t.trx_mysql_thread_id = $con1_id;
  --enable_query_log
  connection blocker;
  COMMIT;
  connection default;
  let $wait_condition=
    SELECT COUNT(*) = 0 FROM information_schema.processlist
    WHERE id = $con1_id;
  --source include/wait_condition.inc
  let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
  let SEARCH_PATTERN= Aborted connection $con1_id to db[^\n]*Client disconnected;
  let SEARCH_OUTPUT= count;
  --source include/search_pattern_in_file.inc
  --eval SET GLOBAL disconnect_watcher= $save_disconnect_watcher
  if ($off_before_connect)
  {
    connection blocker;
    --disable_result_log
    BEGIN;
    SELECT * FROM t1 FOR UPDATE;
    --enable_result_log
    connection default;
  }
  dec $off_before_connect;
}

disconnect blocker;
DROP TABLE t1;

--echo # End of 13.2 tests
