DROP PROCEDURE p1;
CREATE PROCEDURE p2()
BEGIN
DECLARE o INT DEFAULT 0;
DECLARE i INT DEFAULT 0;
WHILE i < 3 DO
WITH c AS
(SELECT o AS off, NULL IN (SELECT 1 OFFSET o ROWS) AS n,
1 = ALL (SELECT 2 OFFSET o ROWS) AS a)
SELECT * FROM c UNION ALL SELECT * FROM c;
SET o= 1-o, i= i+1;
END WHILE;
END|
CALL p2();
off	n	a
0	NULL	0
0	NULL	0
off	n	a
1	0	1
1	0	1
off	n	a
0	NULL	0
0	NULL	0
CALL p2();
off	n	a
0	NULL	0
0	NULL	0
off	n	a
1	0	1
1	0	1
off	n	a
0	NULL	0
0	NULL	0
DROP PROCEDURE p2;
SET optimizer_switch= @saved_optimizer_switch;
