    "nested_loop": [
      {
        "table": {
          "table_name": "t1",
          "access_type": "const",
          "possible_keys": ["PRIMARY"],
          "key": "PRIMARY",
          "key_length": "4",
          "used_key_parts": ["a"],
          "ref": ["const"],
          "rows": 1,
          "filtered": 100,
          "using_index": true
        }
      },
      {
        "table": {
          "table_name": "<subquery2>",
          "access_type": "ALL",
          "possible_keys": ["distinct_key"],
          "rows": 20,
          "filtered": 100,
          "materialized": {
            "unique": 1,
            "query_block": {
              "select_id": 2,
              "nested_loop": [
                {
                  "table": {
                    "table_name": "t12",
                    "access_type": "ALL",
                    "loops": 1,
                    "rows": 20,
                    "cost": "COST_REPLACED",
                    "filtered": 100,
                    "attached_condition": "t12.b is not null"
                  }
                }
              ]
            }
          }
        }
      },
      {
        "table": {
          "table_name": "t11",
          "access_type": "ref",
          "possible_keys": ["a"],
          "key": "a",
          "key_length": "5",
          "used_key_parts": ["a"],
          "ref": ["test.t12.b"],
          "loops": 20,
          "rows": 200,
          "cost": "COST_REPLACED",
          "filtered": 100,
          "attached_condition": "rand() < 0",
          "using_index": true
        }
      }
    ]
  }
}
select count(*) from t1, t11
where t1.a=1 and t11.a in (select b from t12) and rand() < 0;
count(*)
0
select count(*) from t1, t11
where t1.a=1 and t11.a in (select b from t12) and rand() >= 0;
count(*)
2000
# A prepared statement executed twice, with the bound for rand()
# passed as a parameter.  The first execution returns no row and
# the second returns t1.a=1.
prepare stmt from "select t1.a from t1
where t1.a=1 and t1.a in (select c from t3) and rand() < ?";
execute stmt using 0;
a
execute stmt using 2;
a
1
deallocate prepare stmt;
# The same query in a stored procedure called twice.
create procedure p1(x int)
select t1.a from t1
where t1.a=1 and t1.a in (select c from t3) and rand() < x;
call p1(0);
a
call p1(2);
a
1
drop procedure p1;
set optimizer_switch= @save_optimizer_switch;
set optimizer_where_cost= @save_optimizer_where_cost;
drop table t1,t2,t3,t4,t5,t6,t7,t8,t9,t10,t11,t12;
# End of 11.4 tests
