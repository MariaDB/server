30	b30
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (10,'b10'),(20,'b20'),(30,'b30');
CALL p1(30);
vrec.a	vrec.b
31	b30
CALL p1(30);
vrec.a	vrec.b
32	b30
CALL p1(30);
vrec.a	vrec.b
33	b30
SELECT * FROM t1;
a	b
10	b10
20	b20
33	b30
DROP PROCEDURE p1;
DROP TABLE t1;
#
# MDEV-41262 ER_TOO_MANY_ROWS should be checked after CHECK OPTION in view while Update Returning Into
#
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(10);
CREATE VIEW v1 AS SELECT * FROM t1 WHERE a < 100 WITH CHECK OPTION;
UPDATE v1 SET a=IF(a=1,2,1000) RETURNING a INTO @a;
ERROR 44000: CHECK OPTION failed `test`.`v1`
SELECT @a;
@a
2
SELECT * FROM t1;
a
2
10
DROP VIEW v1;
DROP TABLE t1;
#
# MDEV-41265 SELECT/ UPDATE RETURNING INTO a single row-field fails with ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT, even though the column count matches
#
# One scalar column into one field of an explicit ROW variable
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
CREATE PROCEDURE p1()
BEGIN
DECLARE r0 ROW (a INT, b VARCHAR(10));
UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
SELECT r0.a;
END;
$$
CREATE PROCEDURE p2()
BEGIN
DECLARE r0 ROW (a INT, b VARCHAR(10));
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
END;
$$
CALL p1;
r0.a
2
CALL p2;
ERROR 21000: The used SELECT statements have a different number of columns
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;
# One scalar column into one field of a `ROW TYPE OF table1` variable
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
CREATE PROCEDURE p1()
BEGIN
DECLARE r0 ROW TYPE OF t1;
UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
SELECT r0.a;
END;
$$
CREATE PROCEDURE p2()
BEGIN
DECLARE r0 ROW TYPE OF t1;
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
END;
$$
CALL p1;
r0.a
2
CALL p2;
ERROR 21000: The used SELECT statements have a different number of columns
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;
# One scalar column into one field of a `ROW TYPE OF cursor1` variable
CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
CREATE PROCEDURE p1()
BEGIN
DECLARE c1 CURSOR FOR SELECT * FROM t1;
BEGIN
DECLARE r0 ROW TYPE OF c1;
UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
SELECT r0.a;
END;
END;
$$
CREATE PROCEDURE p2()
BEGIN
DECLARE c1 CURSOR FOR SELECT * FROM t1;
BEGIN
DECLARE r0 ROW TYPE OF c1;
UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
END;
END;
$$
CALL p1;
r0.a
2
CALL p2;
ERROR 21000: The used SELECT statements have a different number of columns
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;
#
# UPDATE..RETURNING..INTO in a trigger
# UPDATE..RETURNING without INTO returns a result set, so it is not
# allowed in triggers (see update_returning.test).
# With INTO it does not return a result set.
#
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, c INT);
INSERT INTO t1 VALUES (1,10),(2,20),(2,21);
CREATE TRIGGER t2_bi BEFORE INSERT ON t2 FOR EACH ROW
BEGIN
DECLARE v INT;
UPDATE t1 SET b=b+1 WHERE a=NEW.a RETURNING b INTO v;
SET NEW.c= v;
END;
$$
# One row
INSERT INTO t2 (a) VALUES (1);
SELECT * FROM t2;
a	c
1	11
SELECT * FROM t1;
a	b
1	11
2	20
2	21
# No rows: a warning, the variable is not changed
INSERT INTO t2 (a) VALUES (99);
SELECT * FROM t2;
a	c
1	11
99	NULL
# Two rows: ER_TOO_MANY_ROWS, the row is not inserted
INSERT INTO t2 (a) VALUES (2);
ERROR 42000: Result consisted of more than one row
SELECT * FROM t2;
a	c
1	11
99	NULL
DROP TRIGGER t2_bi;
# No rows with a NOT FOUND handler
CREATE TRIGGER t2_bi BEFORE INSERT ON t2 FOR EACH ROW
BEGIN
DECLARE v INT DEFAULT -1;
DECLARE CONTINUE HANDLER FOR NOT FOUND SET NEW.c= -2;
UPDATE t1 SET b=b+1 WHERE a=NEW.a RETURNING b INTO v;
END;
$$
INSERT INTO t2 (a) VALUES (99);
SELECT * FROM t2 WHERE a=99;
a	c
99	NULL
99	-2
DROP TRIGGER t2_bi;
DROP TABLE t1, t2;
# End of 13.1 tests
