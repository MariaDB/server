--source include/not_embedded.inc

call mtr.add_suppression("Access denied for user");

SELECT @@global.log_error_file_buffer_size, @@global.log_error_file_rotate_size, @@global.log_error_file_rotations;

SET @old_log_warnings= @@global.log_warnings;
SET GLOBAL log_warnings= 2;

--disable_query_log
--disable_result_log
--let $i= 0
while ($i < 120)
{
  --error ER_ACCESS_DENIED_ERROR
  --connect (con_bad_$i,localhost,no_such_user_$i,wrong_password,test)
  --inc $i
}
--enable_result_log
--enable_query_log
--connection default

SET GLOBAL log_warnings= @old_log_warnings;

# Shutdown flushes the buffered log
--source include/restart_mysqld.inc

--file_exists $MYSQLTEST_VARDIR/log/mysqld.1.err.1
--file_exists $MYSQLTEST_VARDIR/log/mysqld.1.err.2
--error 1
--file_exists $MYSQLTEST_VARDIR/log/mysqld.1.err.3
