CREATE DATABASE dbt3_s001;
use dbt3_s001;
SET SESSION default_storage_engine=InnoDB;
SET @save_trace= @@optimizer_trace;
SET SESSION optimizer_trace=1;
#
# TPC-H Q3, in the workers (expect 1)
#
SET SESSION parallel_worker_threads=4;
FLUSH STATUS;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue,
o_orderdate, o_shippriority
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 10;
l_orderkey	revenue	o_orderdate	o_shippriority
1637	164224.9253	1995-02-08	0
5191	49378.309400000006	1994-12-11	0
742	43728.048	1994-12-23	0
3492	43716.072400000005	1994-11-24	0
2883	36666.9612	1995-01-23	0
998	11785.548600000002	1994-11-26	0
3430	4726.6775	1994-12-12	0
4423	3055.9365	1995-02-17	0
ran_in_the_workers
1
#
# the same read serially: the same ten rows
#
SET SESSION parallel_worker_threads=0;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue,
o_orderdate, o_shippriority
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 10;
l_orderkey	revenue	o_orderdate	o_shippriority
1637	164224.9253	1995-02-08	0
5191	49378.309400000006	1994-12-11	0
742	43728.048	1994-12-23	0
3492	43716.072400000005	1994-11-24	0
2883	36666.9612	1995-01-23	0
998	11785.548600000002	1994-11-26	0
3430	4726.6775	1994-12-12	0
4423	3055.9365	1995-02-17	0
#
# Q3 asks for ten and this dataset has eight groups, so the limit never
# bites above. Cut it below the group count and it does -- and what it
# cuts is the ordered list of finished groups, not whatever rows a
# worker happened to ship.
#
SET SESSION parallel_worker_threads=4;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 3;
l_orderkey	revenue
1637	164224.9253
5191	49378.309400000006
742	43728.048
SET SESSION parallel_worker_threads=0;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 3;
l_orderkey	revenue
1637	164224.9253
5191	49378.309400000006
742	43728.048
#
# and OFFSET, which send_data_with_check() was already skipping: the
# fourth and fifth of the eight
#
SET SESSION parallel_worker_threads=4;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 2 offset 3;
l_orderkey	revenue
3492	43716.072400000005
2883	36666.9612
SET SESSION parallel_worker_threads=0;
select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue
from customer, orders, lineitem
where c_mktsegment = 'BUILDING' and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < date '1995-03-15'
  and l_shipdate > date '1995-03-15'
group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate
limit 2 offset 3;
l_orderkey	revenue
3492	43716.072400000005
2883	36666.9612
#
# a limit without pre-aggregation is still refused, and says so
#
FLUSH STATUS;
select l_orderkey from lineitem where l_shipdate > date '1995-03-15' limit 10;
SHOW SESSION STATUS LIKE 'Parallel_queries_executed';
Variable_name	Value
Parallel_queries_executed	0
SELECT JSON_EXTRACT(trace, '$**.parallel_scan_declined_because') AS why
FROM information_schema.optimizer_trace;
why
NULL
drop database  dbt3_s001;
SET SESSION optimizer_trace= @save_trace;
SET SESSION parallel_worker_threads=default;
