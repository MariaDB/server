#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
#
# The OK packet info: "Rows matched: N  Changed: M  Warnings: W"
# as for a plain UPDATE, not only the number of the assigned rows.
# The test is run for MyISAM and InnoDB
# (see update_returning_into_info.combinations).
#
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
# Three rows match, one is changed
UPDATE t1 SET b=IF(a=1,11,b) RETURNING a INTO @a;
affected rows: 1
info: Rows matched: 3  Changed: 1  Warnings: 0
# Three rows match, none is changed: the "No data" warning is counted
UPDATE t1 SET b=b RETURNING a INTO @a;
affected rows: 0
info: Rows matched: 3  Changed: 0  Warnings: 1
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
# One row matches and is changed
UPDATE t1 SET b=b+1 WHERE a=3 RETURNING a INTO @a;
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
# One row matches and needs no update
UPDATE t1 SET b=b WHERE a=3 RETURNING a INTO @a;
affected rows: 0
info: Rows matched: 1  Changed: 0  Warnings: 1
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
# No row matches
UPDATE t1 SET b=b+1 WHERE a=100 RETURNING a INTO @a;
affected rows: 0
info: Rows matched: 0  Changed: 0  Warnings: 1
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
# Two rows are changed: an error, no OK packet
UPDATE t1 SET b=b+1 RETURNING a INTO @a;
ERROR 42000: Result consisted of more than one row
# Nothing to read: the plain OK without the info, and the warning
UPDATE t1 SET b=b+1 WHERE 1=0 RETURNING a INTO @a;
affected rows: 0
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
UPDATE t1 SET b=b+1 LIMIT 0 RETURNING a INTO @a;
affected rows: 0
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SET @a=NULL;
DROP TABLE t1;
#
# ROW_COUNT() in a stored routine after UPDATE..RETURNING..INTO.
# It is the number of the changed rows (the same as for a plain
# UPDATE), and not the number of the assigned rows.
#
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
CREATE PROCEDURE p1(pa INT, pb INT)
BEGIN
DECLARE va INT DEFAULT -1;
UPDATE t1 SET b=pb WHERE a=pa RETURNING a INTO va;
SELECT va, ROW_COUNT() AS row_count;
END;
$$
# One row is changed
CALL p1(1, 11);
va	row_count
1	1
# One row matches and needs no update
CALL p1(2, 20);
va	row_count
-1	0
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
# No row matches
CALL p1(100, 1);
va	row_count
-1	0
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
# Three rows match, one is changed
CREATE PROCEDURE p2()
BEGIN
DECLARE va INT DEFAULT -1;
UPDATE t1 SET b=IF(a=3,31,b) RETURNING a INTO va;
SELECT va, ROW_COUNT() AS row_count;
END;
$$
CALL p2();
va	row_count
3	1
DROP PROCEDURE p2;
DROP PROCEDURE p1;
DROP TABLE t1;
#
# A prepared UPDATE..RETURNING..INTO executed several times:
# the OK packet with the info is sent once, every time
#
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20);
PREPARE stmt FROM 'UPDATE t1 SET b=b+1 WHERE a=? RETURNING a INTO @a';
SET @p=1;
EXECUTE stmt USING @p;
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
EXECUTE stmt USING @p;
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
SET @p=100;
EXECUTE stmt USING @p;
affected rows: 0
info: Rows matched: 0  Changed: 0  Warnings: 1
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
# End of 13.1 tests
