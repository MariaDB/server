#
# MDEV-39492 Parallel Query: a worker evaluates expressions with this session's
# variables.
#
# A worker runs in a background THD, which starts from the global variable
# values. Any variable an expression reads while it is evaluated therefore has
# to be handed to the worker, or the query quietly means something else there:
# in a WHERE it drops rows the serial plan keeps, in a select list it returns
# different values. Variables read while the expression is built need no
# handover, because the copies are built and fixed on the user's thread.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

CREATE TABLE t1 (a INT, ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
                 d DATE, c CHAR(10)) ENGINE=InnoDB;
SET TIME_ZONE = "+03:00";
SET TIMESTAMP = 1000.123456;
INSERT INTO t1 (a, d, c)
  SELECT seq, DATE'2020-03-05' + INTERVAL seq DAY, 'ab' FROM seq_1_to_200;
SET TIMESTAMP = DEFAULT;

SET SESSION sql_mode='PAD_CHAR_TO_FULL_LENGTH';
SET SESSION lc_time_names='fr_FR';
SET SESSION div_precision_increment=8;
SET SESSION default_week_format=3;

--echo #
--echo # projected: the hour of a TIMESTAMP (time_zone), the length of a CHAR
--echo # (sql_mode), a day name (lc_time_names), a quotient
--echo # (div_precision_increment) and a week number (default_week_format)
--echo #
--let $q= SELECT HOUR(ts) AS h, LENGTH(c) AS len, DAYNAME(d) AS dn, a/7 AS quot, WEEK(d) AS wk FROM t1 WHERE a = 1

--echo # serial
SET SESSION parallel_worker_threads=0;
--eval $q
--echo # with workers: must be identical
SET SESSION parallel_worker_threads=4;
--eval $q

--echo #
--echo # in a WHERE: a condition on a TIMESTAMP must keep the same rows
--echo #
--let $w= SELECT COUNT(*) AS n FROM (SELECT a FROM t1 WHERE HOUR(ts) = 3 AND WEEK(d) = 10) x

SET SESSION optimizer_switch='derived_merge=off';
--echo # serial
SET SESSION parallel_worker_threads=0;
--eval $w
--echo # with workers: must be identical
SET SESSION parallel_worker_threads=4;
--eval $w
SET SESSION optimizer_switch=DEFAULT;

DROP TABLE t1;
SET TIME_ZONE = DEFAULT;
