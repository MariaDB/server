DROP TABLE t2;
#
# What is not accepted. Each of these still runs, serially: the gate
# declines the plan rather than the query.
#
SET @st= @@optimizer_trace;
SET optimizer_trace=1;
# AVG -- a partial average cannot be averaged
chosen
0
# STDDEV -- same, with more state
chosen
0
# BIT_XOR -- self-composing, but has no direct_add
chosen
0
# COUNT(DISTINCT) -- the set has to be complete before it is counted
chosen
0
# HAVING -- refused by the gate outright
chosen
0
# a real ORDER BY -- the rows would have to come back in order
chosen
1
SET optimizer_trace= @st;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
