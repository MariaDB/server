explain SELECT t1.col1, COUNT(t1.col2), SUM(t1.col2), MIN(t1.col2), MAX(t1.col2),
COUNT(t2.col1) FROM t1 join t2 on t1.col1 = t2.col1
GROUP BY t1.col1 ORDER BY t1.col1;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
