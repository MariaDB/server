DROP TABLE t2;
#
# A plan whose container gets no group index cannot pre-aggregate: a
# unique constraint is a hash of the row with nothing to look a group up
# in. Whether create_tmp_table() managed an index can only be asked of
# the finished table, so the answer is a fall-back rather than a gate
# check -- the workers ship their rows and the manager groups them, which
# is the same grouping done a row at a time instead of a group at a time.
#
# Nothing this tree can express reaches it: the gate already refuses the
# two shapes that make create_tmp_table() fall back for a heap container,
# and its engine-limit test is only in the on-disk branch. So it is asked
# for here, or it would never be run.
#
set @save_dbug= @@global.debug_dbug;
set global debug_dbug="+d,pwt_no_group_index";
FLUSH STATUS;
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
FROM t1 GROUP BY col1 ORDER BY NULL;
col1	COUNT(col2)	SUM(col2)	MIN(col2)	MAX(col2)
0	500	1252500	10	5000
1	500	1248000	1	4991
2	500	1248500	2	4992
3	500	1249000	3	4993
4	500	1249500	4	4994
5	500	1250000	5	4995
6	500	1250500	6	4996
7	500	1251000	7	4997
8	500	1251500	8	4998
9	500	1252000	9	4999
set global debug_dbug= @save_dbug;
# same answer, still in the workers, and by shipping rows rather than
# partials -- which is what a tmp-write per source row says (expect 1 1)
still_ran_in_the_workers	shipped_rows
1	1
#
# What is not accepted. Each of these still runs, serially: the gate
# declines the plan rather than the query.
#
SET @st= @@optimizer_trace;
SET optimizer_trace=1;
# AVG -- a partial average cannot be averaged
chosen
0
# STDDEV -- same, with more state
chosen
0
# BIT_XOR -- self-composing, but has no direct_add
chosen
0
# COUNT(DISTINCT) -- the set has to be complete before it is counted
chosen
0
# HAVING -- refused by the gate outright
chosen
0
# a real ORDER BY -- the rows would have to come back in order
chosen
1
SET optimizer_trace= @st;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
