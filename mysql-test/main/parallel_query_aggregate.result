CREATE TABLE t1 (col1 INT, col2 INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq MOD 10, seq FROM seq_1_to_5000;
#
# The same answer as a serial plan, for each of the four.
#
# ---- serial ----
SET SESSION parallel_worker_threads=0;
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
FROM t1 GROUP BY col1 ORDER BY NULL;
col1	COUNT(col2)	SUM(col2)	MIN(col2)	MAX(col2)
0	500	1252500	10	5000
1	500	1248000	1	4991
2	500	1248500	2	4992
3	500	1249000	3	4993
4	500	1249500	4	4994
5	500	1250000	5	4995
6	500	1250500	6	4996
7	500	1251000	7	4997
8	500	1251500	8	4998
9	500	1252000	9	4999
# ---- parallel ----
SET SESSION parallel_worker_threads=4;
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
FROM t1 GROUP BY col1 ORDER BY NULL;
col1	COUNT(col2)	SUM(col2)	MIN(col2)	MAX(col2)
0	500	1252500	10	5000
1	500	1248000	1	4991
2	500	1248500	2	4992
3	500	1249000	3	4993
4	500	1249500	4	4994
5	500	1250000	5	4995
6	500	1250500	6	4996
7	500	1251000	7	4997
8	500	1251500	8	4998
9	500	1252000	9	4999
ran_in_the_workers
1
#
# And it really is per group, not per row: 5000 rows become one row per
# group per worker, so what the manager sees is 40 rows and what the
# workers did to get there is an update per row.
#
FLUSH STATUS;
SELECT col1, COUNT(col2) FROM t1 GROUP BY col1 ORDER BY NULL;
rows_written_is_per_group	rows_folded_in
1	1
#
# NULLs. A worker whose chunk holds no non-NULL value for a group ships a
# NULL partial, which has to be skipped rather than read as a zero or
# taken as the extreme. Here col2 is NULL for a whole group, and NULL for
# scattered rows of the others.
#
CREATE TABLE t2 (col1 INT, col2 INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq MOD 10,
IF(seq MOD 10 = 7 OR seq MOD 3 = 0, NULL, seq)
FROM seq_1_to_5000;
# ---- serial ----
SET SESSION parallel_worker_threads=0;
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
FROM t2 GROUP BY col1 ORDER BY NULL;
col1	COUNT(col2)	SUM(col2)	MIN(col2)	MAX(col2)
0	334	836670	10	5000
1	334	833664	1	4991
2	333	830666	2	4982
3	333	832669	13	4993
4	334	834666	4	4994
5	333	831665	5	4985
6	333	833668	16	4996
7	0	NULL	NULL	NULL
8	333	832664	8	4988
9	333	834667	19	4999
