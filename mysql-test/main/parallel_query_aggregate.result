#
# A 2 table join executed in the worker
#
create index ixt2 on t2 (col1);
# ---- serial ----
SET SESSION parallel_worker_threads=0;
explain SELECT t1.col1, COUNT(t1.col2), SUM(t1.col2), MIN(t1.col2), MAX(t1.col2),
COUNT(t2.col1) FROM t1 join t2 on t1.col1 = t2.col1
GROUP BY t1.col1 ORDER BY t1.col1;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	5000	Using where; Using temporary; Using filesort
1	SIMPLE	t2	ref	ixt2	ixt2	5	test.t1.col1	500	Using index
SELECT t1.col1, COUNT(t1.col2), SUM(t1.col2), MIN(t1.col2), MAX(t1.col2),
COUNT(t2.col1) FROM t1 join t2 on t1.col1 = t2.col1
GROUP BY t1.col1 ORDER BY t1.col1;
