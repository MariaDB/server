# A boundary waits for a lock as a statement does: here for the
# global read lock of another session, which a statement that writes
# waits for.  A COMMIT that times out waiting rolls the transaction
# back, and its error says so with SQLSTATE 40001, after the lock
# wait timeout itself
SET @save_lock_wait_timeout= @@lock_wait_timeout;
SET lock_wait_timeout= 1;
BEGIN;
INSERT INTO tl VALUES (5), (6);
connection con2;
FLUSH TABLES WITH READ LOCK;
connection default;
COMMIT;
ERROR 40001: Lock wait timeout exceeded; transaction rolled back
SHOW WARNINGS;
Level	Code	Message
Error	1205	Lock wait timeout exceeded; try restarting transaction
Error	4276	Lock wait timeout exceeded; transaction rolled back
SET lock_wait_timeout= @save_lock_wait_timeout;
connection con2;
UNLOCK TABLES;
connection default;
SELECT * FROM tl ORDER BY a;
a
