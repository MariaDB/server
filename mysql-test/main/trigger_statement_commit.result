# A deadlock while the boundary waits for a lock is the error of the
# COMMIT, as a deadlock inside a body is: it says by itself that the
# transaction was rolled back.  The other session holds the global
# read lock and waits for tl, which the transaction holds, when the
# boundary asks for the right to write.
BEGIN;
INSERT INTO tl VALUES (19), (20);
connection con2;
FLUSH TABLES WITH READ LOCK;
LOCK TABLES tl READ;
connection default;
COMMIT;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
SHOW WARNINGS;
Level	Code	Message
Error	1213	Deadlock found when trying to get lock; try restarting transaction
connection con2;
UNLOCK TABLES;
disconnect con2;
connection default;
SELECT a FROM tl WHERE a IN (19, 20) ORDER BY a;
a
#
# MDEV-41218 A BEFORE COMMIT body that writes a non-transactional table
#
# Only the table that the trigger is on has to be transactional.  A
# statement that writes it takes the metadata lock of the table that
# the body writes for the transaction, and its table lock for the
# statement only.  The commit boundary takes the table lock again, so
# it waits for a statement of another session that writes the table.
CREATE TABLE tm (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tm_log (a INT) ENGINE=MyISAM;
INSERT INTO tm_log VALUES (1), (2);
CREATE TRIGGER tm_sp AFTER INSERT ON tm BEFORE COMMIT OR SAVEPOINT
INSERT INTO tm_log VALUES (3);
connect  con2,localhost,root,,test;
SET lock_wait_timeout= 1;
connect  con3,localhost,root,,test;
connection default;
BEGIN;
INSERT INTO tm VALUES (1), (2);
connection con2;
# The metadata lock is held, the table lock is not
ALTER TABLE tm_log COMMENT= 'after the INSERT';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
UPDATE tm_log SET a= a + 10;
SELECT a FROM tm_log ORDER BY a;
a
11
12
connection default;
# A SAVEPOINT is not refused: the engine of tm_log takes no part in
# the transaction
SAVEPOINT s1;
COMMIT;
SELECT a FROM tm ORDER BY a;
a
1
2
# A COMMIT that times out waiting for the table lock rolls the
# transaction back
connection con3;
SELECT GET_LOCK('tm_log_writer', 60);
GET_LOCK('tm_log_writer', 60)
1
connection default;
SET @save_lock_wait_timeout= @@lock_wait_timeout;
SET lock_wait_timeout= 1;
BEGIN;
INSERT INTO tm VALUES (3), (4);
connection con2;
UPDATE tm_log SET a= a WHERE GET_LOCK('tm_log_writer', 60) = 1;
connection default;
COMMIT;
ERROR 40001: Lock wait timeout exceeded; transaction rolled back
SHOW WARNINGS;
Level	Code	Message
Error	1205	Lock wait timeout exceeded; try restarting transaction
Error	4276	Lock wait timeout exceeded; transaction rolled back
SET lock_wait_timeout= @save_lock_wait_timeout;
connection con3;
SELECT RELEASE_LOCK('tm_log_writer');
RELEASE_LOCK('tm_log_writer')
1
disconnect con3;
connection con2;
disconnect con2;
connection default;
SELECT a FROM tm ORDER BY a;
a
1
2
DROP TABLE tm, tm_log;
#
# MDEV-41218 A commit boundary under a prepared statement or a procedure
#
# A prepared statement, and a statement of a stored procedure from its
# second execution on, checks the tables and routines it opens against
# the versions it was prepared with.  When such a statement commits
# implicitly, the boundary's statement runs inside it.  It is not the
# prepared statement: it opens its tables and the routines of the
# bodies as a new statement does, and the commit goes through.
CREATE FUNCTION f_tl() RETURNS INT RETURN 1;
CREATE TRIGGER tl_fn AFTER INSERT ON tl BEFORE COMMIT
INSERT INTO tl_log VALUES (f_tl());
PREPARE st_ddl FROM 'CREATE TABLE tl_ddl (a INT)';
BEGIN;
INSERT INTO tl VALUES (7), (8);
EXECUTE st_ddl;
DROP TABLE tl_ddl;
BEGIN;
INSERT INTO tl VALUES (9), (10);
EXECUTE st_ddl;
DROP TABLE tl_ddl;
DEALLOCATE PREPARE st_ddl;
SELECT a FROM tl WHERE a BETWEEN 7 AND 10 ORDER BY a;
a
7
8
9
10
PREPARE st_autocommit FROM 'SET autocommit= 1';
SET autocommit= 0;
INSERT INTO tl VALUES (11), (12);
EXECUTE st_autocommit;
SELECT @@autocommit;
@@autocommit
1
SET autocommit= 0;
INSERT INTO tl VALUES (13), (14);
EXECUTE st_autocommit;
DEALLOCATE PREPARE st_autocommit;
SELECT @@autocommit;
@@autocommit
1
SELECT a FROM tl WHERE a BETWEEN 11 AND 14 ORDER BY a;
a
11
12
13
14
# The statements of a procedure, in its first and its second call
CREATE PROCEDURE p_tl(i INT)
BEGIN
START TRANSACTION;
INSERT INTO tl VALUES (i), (i + 1);
CREATE TABLE tl_ddl (a INT);
DROP TABLE tl_ddl;
END $$
CALL p_tl(15);
CALL p_tl(17);
SELECT a FROM tl WHERE a BETWEEN 15 AND 18 ORDER BY a;
a
15
16
17
18
DROP PROCEDURE p_tl;
DROP TRIGGER tl_fn;
DROP FUNCTION f_tl;
#
# MDEV-41218 The locks of a chain of BEFORE COMMIT bodies
#
# A statement that may capture a row takes the metadata locks of the
# whole chain: of the tables that the bodies of its table's triggers
# use, of the tables that the bodies of those tables' BEFORE COMMIT
# triggers use, and so on.  A SAVEPOINT fires only the triggers
# declared OR SAVEPOINT; the rows that their bodies write wait for the
# COMMIT, and the tables of the bodies that fire then are locked
# already.
CREATE TABLE tk1 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tk2 (a INT) ENGINE=InnoDB;
CREATE TABLE tk3 (a INT) ENGINE=InnoDB;
CREATE TRIGGER tk1_commit AFTER INSERT ON tk1 BEFORE COMMIT OR SAVEPOINT
INSERT INTO tk2 VALUES (1);
CREATE TRIGGER tk2_commit AFTER INSERT ON tk2 BEFORE COMMIT
INSERT INTO tk3 VALUES (1);
connect  con2,localhost,root,,test;
SET lock_wait_timeout= 1;
connection default;
BEGIN;
INSERT INTO tk1 VALUES (1), (2);
connection con2;
ALTER TABLE tk2 ADD COLUMN b INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ALTER TABLE tk3 ADD COLUMN b INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
SAVEPOINT s1;
connection con2;
ALTER TABLE tk3 ADD COLUMN b INT;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
connection con2;
ALTER TABLE tk3 ADD COLUMN b INT;
disconnect con2;
connection default;
SELECT a FROM tk1 ORDER BY a;
a
1
2
DROP TABLE tk1, tk2, tk3;
DROP TABLE t1, t2, t6, t7, t8, tl, tl_log;
