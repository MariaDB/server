#
# MDEV-41218 CREATE TABLE ... SELECT and BEFORE COMMIT triggers
#
# CREATE TABLE ... SELECT commits in the middle of the statement, so its
# SELECT may not write a table that has BEFORE COMMIT triggers, through
# a function or through the trigger of a table that a function writes.
# It may read such a table, and CREATE TEMPORARY TABLE ... SELECT, which
# commits nothing, may write one.
CREATE TABLE t3 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t3_row AFTER INSERT ON t3 FOR EACH ROW
INSERT INTO t1 VALUES (NEW.a + 100, NEW.a, CONCAT('t3_', NEW.a));
CREATE FUNCTION f_t1_ins(i INT) RETURNS INT
BEGIN
INSERT INTO t1 VALUES (i, 13, CONCAT('f', i));
RETURN i;
END|
CREATE FUNCTION f_t3_ins(i INT) RETURNS INT
BEGIN
INSERT INTO t3 VALUES (i);
RETURN i;
END|
SET autocommit= 0;
CREATE TABLE t_ctas ENGINE=InnoDB SELECT f_t1_ins(41) AS b;
ERROR 42000: This version of MariaDB doesn't yet support 'CREATE TABLE ... SELECT that writes a table with BEFORE COMMIT triggers'
# t3 has no BEFORE COMMIT triggers, but its ROW trigger writes t1
CREATE TABLE t_ctas ENGINE=InnoDB SELECT f_t3_ins(41) AS b;
ERROR 42000: This version of MariaDB doesn't yet support 'CREATE TABLE ... SELECT that writes a table with BEFORE COMMIT triggers'
SHOW TABLES LIKE 't_ctas';
Tables_in_test (t_ctas)
SELECT COUNT(*) FROM t1 WHERE id IN (41, 141);
COUNT(*)
0
CREATE TABLE t_ctas ENGINE=InnoDB SELECT COUNT(*) AS n FROM t1;
DROP TABLE t_ctas;
CREATE TEMPORARY TABLE t_ctas ENGINE=InnoDB SELECT f_t1_ins(42) AS b;
COMMIT;
DROP TEMPORARY TABLE t_ctas;
SET autocommit= 1;
SELECT id FROM t1 WHERE id = 42;
id
42
DROP FUNCTION f_t1_ins;
DROP FUNCTION f_t3_ins;
DROP TABLE t3;
#
# MDEV-41218 Trigger DDL waits for a transaction with captured rows
#
# The set of BEFORE COMMIT triggers of a table, and the columns they
# capture, are fixed when the transaction captures its first row of
# the table.  The transaction's metadata lock on the table keeps
# CREATE TRIGGER and DROP TRIGGER of another session waiting until it
# ends.
CREATE TABLE tl (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tl_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER tl_commit AFTER INSERT ON tl BEFORE COMMIT SET @x= 1;
connect  con2,localhost,root,,test;
SET lock_wait_timeout= 1;
connection default;
BEGIN;
INSERT INTO tl VALUES (1), (2);
connection con2;
CREATE TRIGGER tl_other AFTER INSERT ON tl BEFORE COMMIT SET @x= 2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
DROP TRIGGER tl_commit;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
connection con2;
CREATE TRIGGER tl_other AFTER DELETE ON tl BEFORE COMMIT SET @x= 2;
DROP TRIGGER tl_other;
connection default;
DROP TRIGGER tl_commit;
#
# MDEV-41218 A statement locks the tables of the BEFORE COMMIT bodies
#
# A statement that writes a table takes the metadata locks of the
# tables that the bodies of its BEFORE COMMIT triggers use, as it does
# for ROW triggers: whether or not it captures a row, and in the same
# way inside a transaction and in autocommit mode.  The locks stay
# until the transaction ends, so a commit boundary, which opens the
# tables again, holds them already.
CREATE TRIGGER tl_sp AFTER INSERT ON tl BEFORE COMMIT OR SAVEPOINT
INSERT INTO tl_log VALUES (1);
BEGIN;
INSERT INTO tl SELECT 100 FROM DUAL WHERE 1 = 0;
connection con2;
# Locked by a statement that captured no row
ALTER TABLE tl_log COMMENT= 'after an INSERT of no row';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
BEGIN;
INSERT INTO tl VALUES (3), (4);
connection con2;
# Locked by the INSERT
ALTER TABLE tl_log COMMENT= 'after the INSERT';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
SAVEPOINT s1;
connection con2;
# Still locked after the SAVEPOINT that fired tl_sp
ALTER TABLE tl_log COMMENT= 'after the savepoint';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
connection con2;
ALTER TABLE tl_log COMMENT= 'after the commit';
# A prepared statement locks the same tables whether it was prepared
# in autocommit mode or inside a transaction
connection default;
PREPARE st_auto FROM 'INSERT INTO tl VALUES (?), (?)';
BEGIN;
PREPARE st_trans FROM 'INSERT INTO tl VALUES (?), (?)';
COMMIT;
SET @a= 31, @b= 32;
BEGIN;
EXECUTE st_auto USING @a, @b;
connection con2;
ALTER TABLE tl_log COMMENT= 'prepared in autocommit mode';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
SET @a= 33, @b= 34;
BEGIN;
EXECUTE st_trans USING @a, @b;
connection con2;
ALTER TABLE tl_log COMMENT= 'prepared inside a transaction';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
connection default;
COMMIT;
SET @a= 35, @b= 36;
EXECUTE st_trans USING @a, @b;
DEALLOCATE PREPARE st_auto;
DEALLOCATE PREPARE st_trans;
SELECT a FROM tl WHERE a BETWEEN 31 AND 36 ORDER BY a;
a
31
32
33
34
35
