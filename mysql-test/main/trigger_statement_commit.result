#
# MDEV-41218 Capture column lists
#
# OF names the captured columns, EXCEPT the ones left out, and no list
# captures every column that NEW and OLD can reach.  A list that no
# longer resolves after ALTER TABLE fails the statement that needs it.
CREATE TABLE t6 (id INT PRIMARY KEY, a INT, b BLOB, c INT INVISIBLE,
g INT AS (id + 1) VIRTUAL) ENGINE=InnoDB;
# Duplicates are elided, column names compare case-insensitively
CREATE TRIGGER t6_of AFTER INSERT OR UPDATE ON t6 BEFORE COMMIT
OF a, A, id SET @x= 1;
CREATE TRIGGER t6_except AFTER UPDATE ON t6 BEFORE COMMIT OR SAVEPOINT
EXCEPT b FOLLOWS t6_of SET @x= 1;
CREATE TRIGGER t6_stmt_of AFTER INSERT ON t6 FOR EACH STATEMENT OF a
SET @x= 1;
CREATE TRIGGER t6_stmt_except AFTER INSERT OR DELETE ON t6
FOR EACH STATEMENT EXCEPT b, g SET @x= 1;
# OF is not reserved: a body labeled "of" quotes the label
CREATE TRIGGER t6_label AFTER DELETE ON t6 FOR EACH STATEMENT
`of`: BEGIN END;
CREATE TRIGGER bad AFTER DELETE ON t6 FOR EACH STATEMENT of: BEGIN END;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near ': BEGIN END' at line 1
# A ROW trigger has no capture list
CREATE TRIGGER bad AFTER INSERT ON t6 FOR EACH ROW OF a SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'a SET @x= 1' at line 1
# Unknown columns, and nothing left to capture
CREATE TRIGGER bad AFTER INSERT ON t6 BEFORE COMMIT OF a, nosuch SET @x= 1;
ERROR 42S22: Unknown column 'nosuch' in 'OF'
CREATE TRIGGER bad AFTER INSERT ON t6 FOR EACH STATEMENT EXCEPT nosuch
SET @x= 1;
ERROR 42S22: Unknown column 'nosuch' in 'EXCEPT'
CREATE TRIGGER bad AFTER INSERT ON t6 BEFORE COMMIT EXCEPT id, a, b, c, g
SET @x= 1;
