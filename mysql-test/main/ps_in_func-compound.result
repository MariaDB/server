#
# MDEV-39518 Allow prepared statements in stored functions in assignment right hand
#
CREATE TABLE t1 (a INT);
CREATE FUNCTION f1() RETURNS INT
BEGIN
EXECUTE IMMEDIATE 'INSERT INTO t1 VALUES (1)';
RETURN 1;
END;
$$
BEGIN NOT ATOMIC
DECLARE v INT DEFAULT f1();
END;
$$
SELECT * FROM t1;
a
1
DROP FUNCTION f1;
DROP TABLE t1;
CREATE TABLE t1 (a INT);
CREATE FUNCTION f1() RETURNS INT
BEGIN
EXECUTE IMMEDIATE 'BEGIN NOT ATOMIC INSERT INTO t1 VALUES (1); END';
RETURN 1;
END;
$$
CREATE PROCEDURE p1()
BEGIN
DECLARE v INT DEFAULT f1();
END;
$$
CALL p1();
SELECT * FROM t1;
a
1
DROP PROCEDURE p1;
DROP FUNCTION f1;
DROP TABLE t1;
# End of 13.1 tests
