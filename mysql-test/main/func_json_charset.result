setv
007B002200610022003A00200031002C0020002200620022003A00200032007D
SELECT CHARSET(JSON_SET(CONVERT('{"a":1}' USING ucs2), '$.b', 2)) AS cs;
cs
ucs2
SELECT JSON_EXTRACT(CONVERT('{"a":1}' USING ucs2), '$.a') AS v;
v
NULL
SELECT HEX(JSON_ARRAY(CONVERT('x' USING ucs2))) AS arr;
arr
005B002200780022005D
SELECT CHARSET(JSON_ARRAY(CONVERT('x' USING ucs2))) AS cs;
cs
ucs2
# utf16 and utf32
SELECT JSON_VALID(CONVERT('{"a":1}' USING utf16)) AS v16;
v16
1
SELECT JSON_VALID(CONVERT('{"a":1}' USING utf32)) AS v32;
v32
1
SELECT HEX(JSON_COMPACT(CONVERT('{"a": 1}' USING utf16))) AS c16;
c16
