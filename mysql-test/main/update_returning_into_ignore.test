--source include/have_innodb.inc
--source include/have_partition.inc

--echo #
--echo # MDEV-39563 Implement UPDATE ... RETURNING ... INTO
--echo #

--echo #
--echo # MDEV-42156 UPDATE IGNORE ... RETURNING ... INTO fails with ER_TOO_MANY_ROWS when the second row is skipped by IGNORE (duplicate key)
--echo #

--echo #
--echo # UPDATE IGNORE .. RETURNING .. INTO: a row that is rejected by the
--echo # engine (and ignored by IGNORE) is not changed, so it is not counted as
--echo # a changed row. Plain RETURNING and RETURNING .. INTO work the same way.
--echo # The test is run for several storage engines
--echo # (see update_returning_into_ignore.combinations).
--echo # After ER_TOO_MANY_ROWS, transactional engines roll back the statement,
--echo # non-transactional engines update the second row back.
--echo #

--echo #
--echo # Duplicate key: the second row is rejected
--echo #

CREATE TABLE t1 (a INT UNIQUE, b INT);
INSERT INTO t1 VALUES (1,1),(2,2);
UPDATE IGNORE t1 SET a=5 RETURNING b;
SELECT * FROM t1 ORDER BY b;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1),(2,2);
SET @b='unchanged';
UPDATE IGNORE t1 SET a=5 RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY b;
DROP TABLE t1;

--echo #
--echo # Duplicate key: the first row is rejected, the second row is changed
--echo #

CREATE TABLE t1 (a INT UNIQUE, b INT);
INSERT INTO t1 VALUES (1,1),(2,2),(5,5);
SET @b='unchanged';
UPDATE IGNORE t1 SET a=IF(b=1,5,IF(b=2,12,a)) RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY b;
DROP TABLE t1;

--echo #
--echo # Duplicate key: the second row is rejected, the third row is changed
--echo #

CREATE TABLE t1 (a INT UNIQUE, b INT);
INSERT INTO t1 VALUES (1,1),(2,2),(3,3),(5,5);
SET @b='unchanged';
--error ER_TOO_MANY_ROWS
UPDATE IGNORE t1 SET a=IF(b=2,5,a+10) RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY b;
DROP TABLE t1;

--echo #
--echo # Two rows are changed
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
SET @b='unchanged';
--error ER_TOO_MANY_ROWS
UPDATE IGNORE t1 SET b=b+10 RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY a;
DROP TABLE t1;

--echo #
--echo # No partition for the new value: the second row is rejected
--echo #

CREATE TABLE t1 (a INT, b INT)
  PARTITION BY RANGE (a) (PARTITION p0 VALUES LESS THAN (10));
INSERT INTO t1 VALUES (1,1),(2,2);
UPDATE IGNORE t1 SET a=IF(b=1,5,100) RETURNING b;
SELECT * FROM t1 ORDER BY b;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1),(2,2);
SET @b='unchanged';
UPDATE IGNORE t1 SET a=IF(b=1,5,100) RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY b;
DROP TABLE t1;

--echo #
--echo # The new row does not belong to the partitions named in the statement
--echo #

CREATE TABLE t1 (a INT, b INT)
  PARTITION BY RANGE (a) (PARTITION p0 VALUES LESS THAN (10),
                          PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1,1),(2,2);
SET @b='unchanged';
UPDATE IGNORE t1 PARTITION (p0) SET a=IF(b=1,5,15) RETURNING b INTO @b;
SELECT @b;
SELECT * FROM t1 ORDER BY b;
DROP TABLE t1;

--echo #
--echo # System versioned table
--echo #

CREATE TABLE t1 (a INT UNIQUE, b INT) WITH SYSTEM VERSIONING;
INSERT INTO t1 VALUES (1,1),(2,2);
SET @b='unchanged';
UPDATE IGNORE t1 SET a=5 RETURNING b INTO @b;
SELECT @b;
SELECT a, b FROM t1 ORDER BY b;
SELECT a, b FROM t1 FOR SYSTEM_TIME ALL ORDER BY b, row_end;
DELETE FROM t1;
INSERT INTO t1 VALUES (1,1),(2,2);
--error ER_TOO_MANY_ROWS
UPDATE IGNORE t1 SET b=b+10 RETURNING b INTO @b;
SELECT a, b FROM t1 ORDER BY b;
SELECT a, b FROM t1 FOR SYSTEM_TIME ALL ORDER BY b, row_end;
DROP TABLE t1;

--echo # End of 13.1 tests
