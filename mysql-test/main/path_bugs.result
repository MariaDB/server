#
# MDEV-38523 Freeing unallocated data THD::set_db when path-resolved routine in trigger
#
create procedure p1() flush tables;
create database test1;
use test1;
create table t1 (c int);
set path 'test,test1';
create trigger trg before insert on t1 for each row call p1;
create temporary table tmp1 (a int);
drop table tmp1;
select * from t1;
c
drop database test1;
use test;
drop procedure p1;
set path default;
#
# MDEV-39596 Unexpected "No database selected" error for a CALL inside an anonymous block
#
create database test1;
create procedure test1.p1() select 1;
create function test1.f1() returns int return 2;
create package pkg procedure p(); end; $$
create package body pkg procedure p() select 'test.pkg.p'; end; $$
begin not atomic call pkg.p(); end; $$
test.pkg.p
test.pkg.p
CREATE DATABASE deselect_db;
USE deselect_db;
DROP DATABASE deselect_db;
begin not atomic call test1.p1(); end; $$
1
1
begin not atomic select test1.f1(); end; $$
test1.f1()
2
begin not atomic call p1(); end; $$
ERROR 3D000: No database selected
begin not atomic call pkg.p(); end; $$
ERROR 42000: PROCEDURE pkg.p does not exist
use test;
drop package pkg;
drop database test1;
# End of 12.3 tests
