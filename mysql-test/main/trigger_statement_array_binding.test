#
# A prepared statement executed with an array of parameter sets fires
# FOR EACH STATEMENT triggers once for INSERT and REPLACE, which run all
# the sets as one statement, and once per set for UPDATE and DELETE,
# which run as one statement per set.
#
# The client side is test_bulk_statement_trigger in
# tests/mysql_client_test.c: three parameter sets for each of INSERT,
# REPLACE, UPDATE and DELETE.  No trigger body is executed yet; the
# server writes one "Trigger hook:" line per hook to its error log, and
# trigger_hook_trace.inc prints them.
#

--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_debug.inc

--let $trg_hook_reset= 1
--source trigger_hook_trace.inc

--exec $MYSQL_CLIENT_TEST test_bulk_statement_trigger > $MYSQLTEST_VARDIR/log/trigger_statement_array_binding.out.log 2>&1
--source trigger_hook_trace.inc

--remove_file $MYSQLTEST_VARDIR/tmp/trigger_hook_trace.1.pos
