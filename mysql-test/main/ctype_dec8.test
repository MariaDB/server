--echo #
--echo # Start of 10.5 tests
--echo #

--echo #
--echo # MDEV-22625 SIGSEGV in intern_find_sys_var (optimized builds)
--echo #

SET NAMES dec8;
SET @seq=_dec8 0xD0;
--source include/ctype_ident_sys.inc

--echo #
--echo # End of 10.5 tests
--echo #


--echo #
--echo # MDEV-41246 "Illegal mix of collations" on the mysql.user view
--echo #

SET NAMES dec8 COLLATE dec8_swedish_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES dec8 COLLATE dec8_bin;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SET NAMES DEFAULT;

--echo # End of 11.8 tests
