
select json_equals("{}", "{}");

select json_equals("{}", "[]");

select json_equals("{}", NULL);

select json_equals("", "");

select json_equals("", 1);

select json_equals(now(), now());

select json_equals('{"a":[1, 2, 3]}', '{"a":[1, 2, 3, 4]}');

select json_equals('{"a":[1, 2, 3]}', '{"a":[1, 2, 3]}');

select json_equals('{"țanțoș":[1, 2, "ț", {"some uâß€":"uâßr"}]}',
                   '{"țanțoș":[1, 2, "ț", {"some uâß€":"uâßr"}]}') as je;

select json_equals('{"a" : [0.123456789123456789], "b" : [1, 2, 3]}',
                   '{"b" : [1, 2, 3], "a" : [0.123456789123456789]}') as je;

--echo #
--echo # Test max json depth for json_equals.
--echo #
with recursive rec_json (step, obj) as (
  select 1, cast('{"key":"value"}' as varchar(1000))
  union
  select r.step + 1, JSON_INSERT('{}', '$.obj', JSON_QUERY(r.obj, '$'))
  from rec_json r
  where r.step < 10
)
select step, obj, json_equals(obj, obj) from rec_json;

--echo #
--echo # 31 levels of nesting.
--echo #
select json_equals('{"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"key": "value"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}',
'{"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"key": "value"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}') as 31_levels;

--echo #
--echo # 32 Levels of nesting. This should hit max json depth.
--echo #
select json_equals('{"obj":{"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"key": "value"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}',
'{"obj":{"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"obj": {"key": "value"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}') as 32_levels;


--echo #
--echo # test values from different charset
--echo # (UTF-8 two-bytes vs. latin1 single high-byte)
--echo #
create table t1 (a varchar(200) character set latin1);
create table t2 (a varchar(200) character set utf8);
insert into t1 values (UNHEX('22CA22'));
set names utf8;
insert into t2 values (UNHEX('22C38A22'));

select a from t1;
select hex(a) from t1;
select a from t2;
select hex(a) from t2;

select t1.a, t2.a, t1.a = t2.a,
       json_valid(t1.a), json_valid(t2.a), json_equals(t1.a, t2.a)
from t1, t2;

drop table t1;
drop table t2;

--echo #
--echo # MDEV-42239: JSON_EQUALS() with a NULL argument is accepted by
--echo # WHERE / IF / CASE although its value is NULL
--echo #

CREATE TABLE t1 (id INT PRIMARY KEY, j JSON NOT NULL);
INSERT INTO t1 VALUES (1,'{"k0":1}'),(2,'{}'),(3,'{"a":[1,2]}');

SELECT id, JSON_EQUALS(NULL, j) AS v, JSON_EQUALS(NULL, j) IS NULL AS v_is_null
FROM t1;

# NULL condition: neither TRUE nor FALSE
SELECT id FROM t1 WHERE JSON_EQUALS(NULL, j);
SELECT id FROM t1 WHERE NOT JSON_EQUALS(NULL, j);
SELECT id FROM t1 WHERE JSON_EQUALS(NULL, j) IS NULL;
SELECT id FROM t1 WHERE JSON_EQUALS(NULL, j) IS TRUE;
SELECT id FROM t1 WHERE JSON_EQUALS(NULL, j) IS NOT TRUE;

# NULL in the second argument, in both, or from an expression
SELECT id FROM t1 WHERE JSON_EQUALS(j, NULL);
SELECT id FROM t1 WHERE JSON_EQUALS(NULL, NULL);
SELECT id FROM t1 WHERE JSON_EQUALS(NULLIF(j, j), j);

SELECT id, IF(JSON_EQUALS(NULL, j), 'T', 'F') AS if_v,
       CASE WHEN JSON_EQUALS(NULL, j) THEN 'T' ELSE 'F' END AS case_v
FROM t1;

# Constant condition evaluated by the optimizer
SELECT 'row' WHERE JSON_EQUALS(NULL, '{}');
SELECT COUNT(*) FROM t1 HAVING JSON_EQUALS(NULL, '{}');

# Non-NULL arguments are not affected
SELECT id FROM t1 WHERE JSON_EQUALS('{}', j);
SELECT id FROM t1 WHERE NOT JSON_EQUALS('{}', j);

DROP TABLE t1;

# A NULL result still satisfies a CHECK constraint
CREATE TABLE t1 (a JSON, b JSON, CHECK (JSON_EQUALS(a, b)));
INSERT INTO t1 VALUES ('{"x":1}', '{ "x" : 1 }');
INSERT INTO t1 VALUES (NULL, '{}');
--error ER_CONSTRAINT_FAILED
INSERT INTO t1 VALUES ('{}', '[]');
SELECT * FROM t1;
DROP TABLE t1;

--echo #
--echo # End of 10.11 tests
--echo #
