#
# and it really was pre-aggregated
#
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT COUNT(*), SUM(i), MIN(i), MAX(i) FROM t1;
preaggregated_per_scan
1.0000
ran_in_the_workers	workers_per_query
1	8.0000
#
# A column that is entirely NULL. Each worker's partial is NULL and
# merging them has to leave the answer NULL rather than 0, while COUNT of
# the same column is 0.
#
# SELECT SUM(n), MIN(n), MAX(n), COUNT(n) FROM t1 WHERE n IS NULL
SELECT SUM(n), MIN(n), MAX(n), COUNT(n) FROM t1 WHERE n IS NULL;
SUM(n)	MIN(n)	MAX(n)	COUNT(n)
NULL	NULL	NULL	0
SELECT SUM(n), MIN(n), MAX(n), COUNT(n) FROM t1 WHERE n IS NULL;
SUM(n)	MIN(n)	MAX(n)	COUNT(n)
NULL	NULL	NULL	0
ran_in_the_workers
1
#
# No qualifying row at all. Every worker ships an empty partial, so the
# manager has partials but no values in them: COUNT is 0 and the rest are
# NULL, which is the row a serial run sends.
#
# SELECT COUNT(*), COUNT(i), SUM(i), SUM(d), MIN(i), MAX(i) FROM t1 WHERE i > 999999
SELECT COUNT(*), COUNT(i), SUM(i), SUM(d), MIN(i), MAX(i) FROM t1 WHERE i > 999999;
COUNT(*)	COUNT(i)	SUM(i)	SUM(d)	MIN(i)	MAX(i)
0	0	NULL	NULL	NULL	NULL
SELECT COUNT(*), COUNT(i), SUM(i), SUM(d), MIN(i), MAX(i) FROM t1 WHERE i > 999999;
COUNT(*)	COUNT(i)	SUM(i)	SUM(d)	MIN(i)	MAX(i)
0	0	NULL	NULL	NULL	NULL
ran_in_the_workers
1
