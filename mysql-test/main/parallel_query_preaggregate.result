COUNT(*)	SUM(i)	MIN(i)	MAX(i)	COUNT(n)	SUM(d)
40000	19867500	0	996	39600	800020000.000000
SELECT COUNT(*), SUM(i), MIN(i), MAX(i), COUNT(n), SUM(d) FROM t1;
COUNT(*)	SUM(i)	MIN(i)	MAX(i)	COUNT(n)	SUM(d)
40000	19867500	0	996	39600	800020000.000000
