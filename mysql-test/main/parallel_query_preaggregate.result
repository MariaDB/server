499	124750	1	499
SELECT COUNT(*), SUM(i), MIN(i), MAX(i) FROM t1 WHERE d < 500;
COUNT(*)	SUM(i)	MIN(i)	MAX(i)
499	124750	1	499
ran_in_the_workers
