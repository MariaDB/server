#
# constants in the select list are allowed: the terminal evaluates them
#
# SELECT 42, COUNT(*), 'x' FROM t1
SELECT 42, COUNT(*), 'x' FROM t1;
42	COUNT(*)	x
42	40000	x
SELECT 42, COUNT(*), 'x' FROM t1;
42	COUNT(*)	x
42	40000	x
ran_in_the_workers
1
#
# HAVING is applied by the terminal to the merged values, so it decides
# whether the one row is sent
#
# SELECT COUNT(*) FROM t1 HAVING COUNT(*) > 1
SELECT COUNT(*) FROM t1 HAVING COUNT(*) > 1;
COUNT(*)
40000
SELECT COUNT(*) FROM t1 HAVING COUNT(*) > 1;
COUNT(*)
40000
ran_in_the_workers
1
# SELECT COUNT(*) FROM t1 HAVING COUNT(*) < 0
SELECT COUNT(*) FROM t1 HAVING COUNT(*) < 0;
COUNT(*)
SELECT COUNT(*) FROM t1 HAVING COUNT(*) < 0;
COUNT(*)
ran_in_the_workers
1
#
# over a join: each worker aggregates the rows it assembled from both
# tables
#
# SELECT STRAIGHT_JOIN COUNT(*), SUM(d1.v), MIN(d1.v), MAX(d1.v) FROM t1, d1 WHERE d1.id = t1.i % 50 + 1
SELECT STRAIGHT_JOIN COUNT(*), SUM(d1.v), MIN(d1.v), MAX(d1.v) FROM t1, d1 WHERE d1.id = t1.i % 50 + 1;
COUNT(*)	SUM(d1.v)	MIN(d1.v)	MAX(d1.v)
40000	10169000	10	500
SELECT STRAIGHT_JOIN COUNT(*), SUM(d1.v), MIN(d1.v), MAX(d1.v) FROM t1, d1 WHERE d1.id = t1.i % 50 + 1;
COUNT(*)	SUM(d1.v)	MIN(d1.v)	MAX(d1.v)
40000	10169000	10	500
ran_in_the_workers
1
#
# an expression as the aggregate's argument, which the worker evaluates
# against its own tables
#
# SELECT COUNT(i + 1), SUM(i * 2), MIN(i + 1), MAX(-i) FROM t1
SELECT COUNT(i + 1), SUM(i * 2), MIN(i + 1), MAX(-i) FROM t1;
COUNT(i + 1)	SUM(i * 2)	MIN(i + 1)	MAX(-i)
40000	39735000	1	0
SELECT COUNT(i + 1), SUM(i * 2), MIN(i + 1), MAX(-i) FROM t1;
COUNT(i + 1)	SUM(i * 2)	MIN(i + 1)	MAX(-i)
40000	39735000	1	0
ran_in_the_workers
1
#
# SUM over a double, compared rounded. The value moves in its low bits
# between runs of the same query whether or not the workers aggregate,
# because the rows reach the manager in whatever order the chunks finish.
#
SET SESSION parallel_worker_threads= 0;
SELECT ROUND(SUM(r), 3) FROM t1;
ROUND(SUM(r), 3)
100002500.000
SET SESSION parallel_worker_threads= 8;
SELECT ROUND(SUM(r), 3) FROM t1;
ROUND(SUM(r), 3)
100002500.000
#
# The shapes that are refused, each still running in the workers and
# shipping its rows: Parallel_partial_aggregations stays 0 while
# Parallel_queries_executed does not.
#
# 1 AVG: a partial average cannot be averaged
# 2 STD and 3 VARIANCE: the same, needing more state than a value
# 4 BIT_XOR: self-composing but has no direct_add overload
# 5 COUNT(DISTINCT): the set has to be complete before it is counted
# 6 an expression over an aggregate: nothing but partials is shipped
# 7 a bare column beside an aggregate
preaggregated_per_scan
0.0000
every_shape_still_ran_in_the_workers
1
