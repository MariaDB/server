SELECT AVG(i), STD(i), VARIANCE(i), BIT_XOR(i), COUNT(DISTINCT i) FROM t1;
AVG(i)	STD(i)	VARIANCE(i)	BIT_XOR(i)	COUNT(DISTINCT i)
496.6875	288.3775	83161.5938	120	997
SELECT AVG(i), STD(i), VARIANCE(i), BIT_XOR(i), COUNT(DISTINCT i) FROM t1;
AVG(i)	STD(i)	VARIANCE(i)	BIT_XOR(i)	COUNT(DISTINCT i)
496.6875	288.3775	83161.5938	120	997
ran_in_the_workers
