SET @s= @@session.parallel_worker_threads;
CREATE TABLE t1 (pk INT PRIMARY KEY, i INT, n INT, d DECIMAL(30,6), r DOUBLE)
ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq % 997, IF(seq % 100 = 0, NULL, seq % 13),
seq, seq / 8 FROM seq_1_to_40000;
CREATE TABLE d1 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO d1 SELECT seq, seq * 10 FROM seq_1_to_50;
ANALYZE TABLE t1, d1 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
test.d1	analyze	status	Engine-independent statistics collected
test.d1	analyze	status	OK
#
# Every accepted aggregate, against the serial answer. The comparison
# include runs the query serially and then with workers, so a difference
# shows as two unequal result blocks.
#
# SELECT COUNT(*) FROM t1
SELECT COUNT(*) FROM t1;
COUNT(*)
40000
SELECT COUNT(*) FROM t1;
COUNT(*)
40000
ran_in_the_workers
1
# SELECT COUNT(*), COUNT(i), COUNT(n) FROM t1
SELECT COUNT(*), COUNT(i), COUNT(n) FROM t1;
COUNT(*)	COUNT(i)	COUNT(n)
40000	40000	39600
SELECT COUNT(*), COUNT(i), COUNT(n) FROM t1;
COUNT(*)	COUNT(i)	COUNT(n)
40000	40000	39600
ran_in_the_workers
1
