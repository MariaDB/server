--echo #
--echo # MDEV-40565: Honor LIMIT and OFFSET in scalar subqueries without tables
--echo #
SELECT (SELECT 1 LIMIT 0) AS zero_limit,
       (SELECT 1 LIMIT 1 OFFSET 1) AS nonzero_offset,
       (SELECT 1 LIMIT 10 OFFSET 5) AS larger_offset,
       (SELECT 1 OFFSET 1 ROWS) AS offset_only,
       (SELECT 1 LIMIT 1 OFFSET 1) IS NULL AS is_null,
       (SELECT 1 LIMIT 1 OFFSET 1)+100 AS arithmetic_result;
SELECT (SELECT 1 LIMIT 1) AS positive_limit,
       (SELECT 1 LIMIT 10 OFFSET 0) AS zero_offset,
       (SELECT 1 OFFSET 0 ROWS) AS zero_offset_only;

# Safe literals retain scalar pullout and its non-NULL integer metadata.
--disable_ps_protocol
EXPLAIN EXTENDED SELECT (SELECT 1 LIMIT 1 OFFSET 0) AS r;
EXPLAIN EXTENDED SELECT (SELECT 1 LIMIT 0) AS r;
--enable_ps_protocol
PREPARE metadata_stmt FROM
  'CREATE TABLE t1 AS SELECT (SELECT 1 LIMIT 1 OFFSET 0) AS kept,
                             (SELECT 1 LIMIT 0) AS removed';
EXECUTE metadata_stmt;
DEALLOCATE PREPARE metadata_stmt;
--replace_column 6 #
SHOW COLUMNS FROM t1;
DROP TABLE t1;

# Empty scalar results also propagate to writes and root conditions.
CREATE TABLE t1 (id INT, a INT);
INSERT INTO t1 VALUES (1,(SELECT 1 LIMIT 0)),
                     (2,(SELECT 2 LIMIT 1 OFFSET 1)),
                     (3,(SELECT 3 LIMIT 1 OFFSET 0));
SELECT * FROM t1 ORDER BY id;
UPDATE t1 SET a=(SELECT 2 LIMIT 0);
SELECT * FROM t1 ORDER BY id;
SELECT id FROM t1 WHERE (SELECT 1 LIMIT 0) IS NULL ORDER BY id;
SELECT (SELECT 1 OFFSET 1 ROWS) AS r HAVING r IS NULL;
DROP TABLE t1;

# LIMIT and OFFSET parameters must remain mutable across EXECUTEs.
PREPARE stmt FROM 'SELECT (SELECT 7 LIMIT ? OFFSET ?) AS r';
SET @lim= 1, @off= 0;
EXECUTE stmt USING @lim, @off;
SET @lim= 0;
EXECUTE stmt USING @lim, @off;
SET @lim= 1, @off= 1;
EXECUTE stmt USING @lim, @off;
SET @off= 0;
EXECUTE stmt USING @lim, @off;
DEALLOCATE PREPARE stmt;

# Repeated CTE references clone the parameter and its scalar expression.
PREPARE stmt FROM 'WITH c AS
  (SELECT (SELECT 7 LIMIT 1 OFFSET ?) AS r)
  SELECT * FROM c UNION ALL SELECT * FROM c';
EXECUTE stmt USING @off;
SET @off= 1;
EXECUTE stmt USING @off;
SET @off= 18446744073709551615;
EXECUTE stmt USING @off;
SET @off= 0;
EXECUTE stmt USING @off;
DEALLOCATE PREPARE stmt;

# OFFSET-only clauses must survive view SQL printing and reopening.
CREATE VIEW v1 AS SELECT (SELECT 1 OFFSET 1 ROWS) AS r;
SHOW CREATE VIEW v1;
SELECT * FROM v1;
FLUSH TABLES;
SELECT * FROM v1;
DROP VIEW v1;

# Reprepare must retain the scalar limit after a table definition changes.
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2);
PREPARE stmt FROM
  'SELECT a, (SELECT 7 LIMIT 1 OFFSET ?) AS r FROM t1 ORDER BY a';
EXECUTE stmt USING @off;
ALTER TABLE t1 ADD COLUMN b INT;
SET @off= 1;
EXECUTE stmt USING @off;
ALTER TABLE t1 DROP COLUMN b;
SET @off= 0;
EXECUTE stmt USING @off;
DEALLOCATE PREPARE stmt;
DROP TABLE t1;

# Keep the parent's EXISTS-to-IN eligibility and limit handling.
CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT);
INSERT INTO t1 VALUES (1),(2),(3);
INSERT INTO t2 VALUES (1),(1),(2);
SET @saved_optimizer_switch= @@optimizer_switch;
SET optimizer_switch= 'exists_to_in=on';
PREPARE stmt FROM 'SELECT a FROM t1 WHERE EXISTS
  (SELECT 1 FROM t2 WHERE t2.a=t1.a LIMIT 1 OFFSET ?) ORDER BY a';
EXECUTE stmt USING @off;
SET @off= 1;
EXECUTE stmt USING @off;
SELECT a FROM t1 WHERE EXISTS
  (SELECT 1 FROM t2 WHERE t2.a=t1.a LIMIT 1 OFFSET 1) ORDER BY a;
SET @off= 2;
EXECUTE stmt USING @off;
SET @off= 0;
EXECUTE stmt USING @off;
DEALLOCATE PREPARE stmt;

# Stored parameters and local variables change within and across CALLs.
delimiter |;
CREATE PROCEDURE p1(lim BIGINT UNSIGNED, off BIGINT UNSIGNED)
BEGIN
  DECLARE l BIGINT UNSIGNED DEFAULT lim;
  DECLARE o BIGINT UNSIGNED DEFAULT off;
  SELECT (SELECT 7 LIMIT lim OFFSET off) AS parameter_result,
         (SELECT 7 LIMIT l OFFSET o) AS local_result;
  SELECT a FROM t1 WHERE EXISTS
    (SELECT 1 FROM t2 WHERE t2.a=t1.a LIMIT 1 OFFSET off) ORDER BY a;
END|
CREATE PROCEDURE p2()
BEGIN
  DECLARE o INT DEFAULT 0;
  DECLARE i INT DEFAULT 0;
  WHILE i < 3 DO
    WITH c AS (SELECT (SELECT 7 LIMIT 1 OFFSET o) AS r)
    SELECT * FROM c UNION ALL SELECT * FROM c;
    SET o= 1-o, i= i+1;
  END WHILE;
END|
delimiter ;|
CALL p1(1, 0);
CALL p1(1, 1);
CALL p1(0, 0);
CALL p1(1, 2);
CALL p1(1, 0);
CALL p2();
CALL p2();
DROP PROCEDURE p1;
DROP PROCEDURE p2;
SET optimizer_switch= @saved_optimizer_switch;
DROP TABLE t1,t2;
