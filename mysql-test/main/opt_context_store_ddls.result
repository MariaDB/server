# End of 13.1 tests
#
# MDEV-40598: Capture sequences used only in column DEFAULT expressions
#
create sequence s1;
create table t1 (a int primary key default nextval(s1), b int);
# The INSERT itself evaluates the DEFAULT, so s1 is already open as
# part of this very statement; ddls should include both s1 and t1
insert into t1 (b) values (1),(2),(3);
# == Optimizer Context Tables
name
db1.t1
# === Optimizer Context DDLs
@ddls
CREATE TABLE IF NOT EXISTS `s1` (
  `next_not_cached_value` bigint(21) NOT NULL,
  `minimum_value` bigint(21) NOT NULL,
  `maximum_value` bigint(21) NOT NULL,
  `start_value` bigint(21) NOT NULL COMMENT 'start value when sequences is created or value if RESTART is used',
  `increment` bigint(21) NOT NULL COMMENT 'increment value',
  `cache_size` bigint(21) unsigned NOT NULL,
  `cycle_option` tinyint(1) unsigned NOT NULL COMMENT '0 if no cycles are allowed, 1 if the sequence should begin a new cycle when maximum_value is passed',
  `cycle_count` bigint(21) NOT NULL COMMENT 'How many cycles have been done'
) ENGINE=MyISAM SEQUENCE=1;

SELECT SETVAL(db1.s1, 2);

CREATE TABLE IF NOT EXISTS `t1` (
  `a` int(11) NOT NULL DEFAULT nextval(`db1`.`s1`),
  `b` int(11) DEFAULT NULL,
  PRIMARY KEY (`a`)
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;


#
# s1 was opened only by the INSERT above and closed again at the
# end of that statement; this SELECT never evaluates DEFAULT
# NEXTVAL() itself, so it doesn't reopen s1 through normal means
# either. It is still captured, resolved independently by name:
# ddls should include both s1 and t1, with s1 appearing before t1
# so that replay can recreate them
select * from t1 where b < 10;
a	b
1	1
2	2
3	3
