#
# The sequence s1 is used in the query and t1's DEFAULT depends on it.
# Whichever order they are listed in, ddls include s1's definition
# with its current value, and t1
#
create sequence s1 start 100 increment 10 maxvalue 200 cycle;
create table t1 (a int default nextval(s1), b int);
insert into t1 (b) values (1),(2);
flush tables;
select * from s1, t1;
