CREATE TABLE IF NOT EXISTS `t1` (
  `a` int(11) NOT NULL DEFAULT nextval(`db1`.`s1`),
  `b` int(11) DEFAULT NULL,
  PRIMARY KEY (`a`)
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;


#
# Under LOCK TABLES, s1 sits in thd->open_tables merely because it
# is locked, not because this particular SELECT touches it - its
# current value must not be captured just from being locked
#
flush tables;
lock tables t1 read, s1 read;
select * from t1 where b < 10;
a	b
1	1
2	2
3	3
