SET @save_optimizer_trace= @@optimizer_trace;
SET optimizer_trace='enabled=on';
CREATE TABLE t_plain (a INT) engine=innodb;
INSERT INTO t_plain VALUES (1),(2),(3);
CREATE TABLE t_blob (a INT, b BLOB) engine=innodb;
INSERT INTO t_blob VALUES (1,'x'),(2,'y'),(3,'z');
CREATE TABLE t_text (a INT, b TEXT) engine=innodb;
INSERT INTO t_text VALUES (1,'x'),(2,'y'),(3,'z');
CREATE TABLE t_m1 (a INT) ENGINE=MyISAM;
INSERT INTO t_m1 VALUES (1),(2),(3);
CREATE TABLE t_m2 (a INT) ENGINE=MyISAM;
INSERT INTO t_m2 VALUES (4),(5),(6);
CREATE TABLE t_merge (a INT) ENGINE=MERGE UNION=(t_m1,t_m2) INSERT_METHOD=LAST;
CREATE TABLE t_ft (a INT, b VARCHAR(64), FULLTEXT(b)) ENGINE=innodb;
INSERT INTO t_ft VALUES (1,'alpha beta'),(2,'gamma delta'),(3,'epsilon zeta');
set session parallel_worker_threads=2;
# plain table: chosen for parallel scan (expect 1)
SELECT a FROM t_plain;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
1
# BLOB column present: excluded, not chosen (expect 0)
SELECT a FROM t_blob;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
0
# TEXT column present: excluded, not chosen (expect 0)
SELECT a FROM t_text;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
0
# MERGE engine: excluded, not chosen (expect 0)
SELECT a FROM t_merge;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
0
# fulltext-searched (MATCH in select list): excluded, not chosen (expect 0)
SELECT a, MATCH(b) AGAINST('alpha') FROM t_ft;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
0
DROP TABLE t_plain, t_blob, t_text, t_merge, t_m1, t_m2, t_ft;
#
# A table the worker cannot open its own copy of, and a semijoin
# strategy it does not implement, are excluded. Both queries answer as
# they do serially, because they run serially.
#
CREATE TABLE ta (a INT) ENGINE=InnoDB;
INSERT INTO ta VALUES (1),(2),(3),(4);
CREATE TABLE tb (a INT, b INT) ENGINE=InnoDB;
INSERT INTO tb VALUES (1,10),(1,11),(2,20),(3,30),(3,31),(4,40);
# materialized derived table as an inner table: not chosen (expect 0)
#
# The derived table is DISTINCT, which the gate refuses, so it contributes
# nothing to the trace of its own. The check below looks for
# chosen_for_parallel_scan anywhere in the trace, and what is being asked
# about is the outer join, so the inner select has to be a shape that could
# not have been chosen either -- a GROUP BY here would be chosen on its own
# account and the check would report that instead.
#
SET SESSION optimizer_switch='derived_merge=off';
SELECT ta.a, d.k FROM ta, (SELECT DISTINCT a AS k FROM tb) d
WHERE d.k = ta.a;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
1
SELECT ta.a, d.k FROM ta, (SELECT DISTINCT a AS k FROM tb) d
WHERE d.k = ta.a;
a	k
1	1
2	2
3	3
4	4
SET SESSION optimizer_switch=DEFAULT;
# FirstMatch semijoin: not chosen (expect 0)
SET SESSION optimizer_switch='semijoin=on,firstmatch=on,loosescan=off,materialization=off';
SELECT a FROM ta WHERE a IN (SELECT a FROM tb);
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
AS chosen_for_parallel_scan
FROM information_schema.optimizer_trace;
chosen_for_parallel_scan
0
# one row per matching ta row, not one per tb match
SELECT a FROM ta WHERE a IN (SELECT a FROM tb);
a
1
2
3
4
SET SESSION optimizer_switch=DEFAULT;
#
# A choice the plan then takes away. The driving table is picked in
# make_join_readinfo(), before test_if_skip_sort_order() has had its say,
# and that can hand the table an ordered index scan so it supplies the
# GROUP BY order for free -- which is not a scan that can be handed out in
# chunks. So the trace records a candidate first and what became of it
# afterwards, and chosen_for_parallel_scan names only tables that really
# are scanned in parallel.
#
CREATE TABLE t_ord (k1 INT, k2 INT, v INT, PRIMARY KEY(k1,k2)) ENGINE=InnoDB;
INSERT INTO t_ord SELECT seq DIV 4, seq MOD 4, seq FROM seq_1_to_40000;
ANALYZE TABLE t_ord PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t_ord	analyze	status	Engine-independent statistics collected
test.t_ord	analyze	status	OK
set session parallel_worker_threads=8;
# The LIMIT makes the ordered index scan the cheaper plan, so the candidate
# is abandoned (expect 1 0 1, and the reason)
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 LIMIT 5;
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_candidate')   IS NOT NULL AS candidate,
JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan')  IS NOT NULL AS chosen,
JSON_EXTRACT(trace,'$**.parallel_scan_abandoned')   IS NOT NULL AS abandoned,
JSON_UNQUOTE(JSON_EXTRACT(trace,
'$**.parallel_scan_abandoned_because[0]')) AS abandoned_because
FROM information_schema.optimizer_trace;
candidate	chosen	abandoned	abandoned_because
1	0	1	["an index now supplies the GROUP BY order"]
# and it really does not run in the workers (expect 0 / NULL)
FLUSH STATUS;
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 LIMIT 5;
ran_in_the_workers	workers_per_query
0	NULL
# Without the LIMIT the temp-table plan keeps the full scan, so the same
# table survives as a real choice (expect 1 1 0)
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 HAVING SUM(v) > 999999999;
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_candidate')  IS NOT NULL AS candidate,
JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen,
JSON_EXTRACT(trace,'$**.parallel_scan_abandoned')  IS NOT NULL AS abandoned
FROM information_schema.optimizer_trace;
candidate	chosen	abandoned
1	1	0
DROP TABLE t_ord;
DROP TABLE ta, tb;
SET optimizer_trace= @save_optimizer_trace;
set session parallel_worker_threads=default;
