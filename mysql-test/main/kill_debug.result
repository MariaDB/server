#
# MDEV-31567 SIGSEGV in reinit_stmt_before_use | Prepared_statement::execute
#
# The first EXECUTE is killed after the one-time semi-join rewrite, but
# before the nested selects save their WHERE. The statement must be
# re-prepared, not run half-rewritten. The bug was reported with
# max_statement_time, KILL QUERY at a sync point makes it deterministic.
CREATE TABLE t (a INT);
connect  con1,localhost,root,,;
PREPARE s FROM <62 nested IN subqueries>
SET debug_sync='before_join_optimize SIGNAL parked WAIT_FOR go EXECUTE 1';
EXECUTE s;
connection default;
SET debug_sync='now WAIT_FOR parked';
KILL QUERY id;
SET debug_sync='now SIGNAL go';
connection con1;
ERROR 70100: Query execution was interrupted
SET debug_sync='RESET';
EXECUTE s;
a
EXECUTE s;
a
DEALLOCATE PREPARE s;
# The same with rows, the results must be correct
INSERT INTO t VALUES (1),(2),(3);
PREPARE s FROM <62 nested IN subqueries>
SET debug_sync='before_join_optimize SIGNAL parked WAIT_FOR go EXECUTE 1';
EXECUTE s;
connection default;
SET debug_sync='now WAIT_FOR parked';
KILL QUERY id;
SET debug_sync='now SIGNAL go';
connection con1;
ERROR 70100: Query execution was interrupted
SET debug_sync='RESET';
EXECUTE s;
a
1
EXECUTE s;
a
1
DEALLOCATE PREPARE s;
# The same in a stored procedure
CREATE PROCEDURE p() <62 nested IN subqueries>
SET debug_sync='before_join_optimize SIGNAL parked WAIT_FOR go EXECUTE 1';
CALL p();
connection default;
SET debug_sync='now WAIT_FOR parked';
KILL QUERY id;
SET debug_sync='now SIGNAL go';
connection con1;
ERROR 70100: Query execution was interrupted
SET debug_sync='RESET';
CALL p();
a
1
CALL p();
a
1
DROP PROCEDURE p;
connection default;
disconnect con1;
# If the re-prepare fails, it must be tried again on the next EXECUTE
CREATE USER u@localhost;
GRANT SUPER ON *.* TO u@localhost;
GRANT SELECT ON test.t TO u@localhost;
connect  con2,localhost,u,,test;
PREPARE s FROM <62 nested IN subqueries>
SET debug_sync='before_join_optimize SIGNAL parked WAIT_FOR go EXECUTE 1';
EXECUTE s;
connection default;
SET debug_sync='now WAIT_FOR parked';
KILL QUERY id;
SET debug_sync='now SIGNAL go';
REVOKE SELECT ON test.t FROM u@localhost;
connection con2;
ERROR 70100: Query execution was interrupted
SET debug_sync='RESET';
EXECUTE s;
ERROR 42000: SELECT command denied to user 'u'@'localhost' for table `test`.`t`
SHOW STATUS LIKE 'Com_stmt_reprepare';
Variable_name	Value
Com_stmt_reprepare	1
connection default;
GRANT SELECT ON test.t TO u@localhost;
connection con2;
EXECUTE s;
a
1
SHOW STATUS LIKE 'Com_stmt_reprepare';
Variable_name	Value
Com_stmt_reprepare	2
connection default;
disconnect con2;
DROP USER u@localhost;
DROP TABLE t;
SET debug_sync='RESET';
