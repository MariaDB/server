#
# MDEV-41849 Killed query reports ER_NOT_FORM_FILE for a table with
#            virtual column expressions
#
# Kill before the vcol expression is parsed
create table t1 (a int, b int as (a + 1) virtual);
insert into t1 (a) values (1);
flush tables;
connect con1, localhost, root;
set debug_sync= 'TABLE_after_field_clone signal opening wait_for go';
select * from t1;
connection default;
set debug_sync= 'now wait_for opening';
kill query CON1_ID;
connection con1;
ERROR 70100: Query execution was interrupted
show warnings;
Level	Code	Message
Error	1317	Query execution was interrupted
disconnect con1;
connection default;
set debug_sync= 'reset';
drop table t1;
# Kill inside the expression must not leave it cut short.
create table t1 (a int, b int as (a + 1) virtual);
insert into t1 (a) values (1);
flush tables;
set @save_dbug= @@debug_dbug;
set debug_dbug= '+d,lex_kill_before_plus';
select * from t1;
ERROR 70100: Query execution was interrupted
show warnings;
Level	Code	Message
Error	1317	Query execution was interrupted
set debug_dbug= @save_dbug;
select * from t1;
a	b
