# Kill while loading the second trigger
create table t1 (a int);
create trigger tr1 before insert on t1 for each row set new.a= new.a + 1;
create trigger tr2 before insert on t1 for each row set new.a= new.a * 10;
flush tables;
set @save_dbug= @@debug_dbug;
set debug_dbug= '+d,kill_on_second_trigger_load';
insert into t1 values (1);
