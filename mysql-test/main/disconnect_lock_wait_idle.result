#
# MDEV-38741 Client disconnect fails to abort a lock wait
# The client disconnects after its statement is read, but before the
# statement starts. The watcher finds the idle connection gone, and the
# statement is aborted when it starts.
#
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
connect  blocker,localhost,root;
BEGIN;
SELECT * FROM t1 FOR UPDATE;
a
1
connect  con1,localhost,root;
SET innodb_lock_wait_timeout=3600;
SET DEBUG_SYNC='dispatch_command_before_set_command SIGNAL at_start WAIT_FOR go';
SELECT * FROM t1 FOR UPDATE;
connection default;
SET DEBUG_SYNC='now WAIT_FOR at_start';
connection con1;
disconnect con1;
connection default;
# The watcher finds the idle connection gone and notes it
SET DEBUG_SYNC='now SIGNAL go';
# The connection is logged once, with the reason
FOUND 1 matches in mysqld.1.err
# COM_QUIT after the disconnect was noted is not a failure, nothing is logged
# The client process quits at once, mysqltest would wait for the server
SET DEBUG_SYNC='RESET';
connection default;
SET DEBUG_SYNC='now WAIT_FOR at_quit';
SET DEBUG_SYNC='now SIGNAL go2';
NOT FOUND matches in mysqld.1.err
disconnect blocker;
SET DEBUG_SYNC='reset';
DROP TABLE t1;
# End of 13.2 tests
