# MDEV-40012 Parallel Query: workers that are handed no chunk of the scan at all
--source include/have_innodb.inc
--source include/have_debug.inc
--source include/not_embedded.inc

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
SET @save_dbug= @@global.debug_dbug;

--echo # serial answers
SET SESSION parallel_worker_threads=0;
--sorted_result
SELECT a, b FROM t1 WHERE b > 0;
--sorted_result
SELECT a, b FROM t1 WHERE a BETWEEN 2 AND 3;

--let $mode= 0
while ($mode < 4)
{
  if ($mode == 0)
  {
    --echo # the workers end their own scans
    SET GLOBAL debug_dbug= @save_dbug;
  }
  if ($mode == 1)
  {
    --echo # the same, in the scan-only path
    SET GLOBAL debug_dbug= "+d,pwt_scan_only";
  }
  if ($mode == 2)
  {
    --echo # a worker with no chunk leaves its scan for close() to end
    SET GLOBAL debug_dbug= "+d,pwt_leave_scan_for_close";
  }
  if ($mode == 3)
  {
    --echo # the same, in the scan-only path
    SET GLOBAL debug_dbug= "+d,pwt_scan_only,pwt_leave_scan_for_close";
  }
  SET SESSION parallel_worker_threads=4;
  --let $ran= 0
  --let $q= 0
  while ($q < 4)
  {
    if ($q == 2)
    {
      --echo # and again, on the handlers the first runs left behind
    }
    FLUSH STATUS;
    --sorted_result
    if ($q == 0)
    {
      SELECT a, b FROM t1 WHERE b > 0;
    }
    --sorted_result
    if ($q == 1)
    {
      SELECT a, b FROM t1 WHERE a BETWEEN 2 AND 3;
    }
    --sorted_result
    if ($q == 2)
    {
      SELECT a, b FROM t1 WHERE b > 0;
    }
    --sorted_result
    if ($q == 3)
    {
      SELECT a, b FROM t1 WHERE a BETWEEN 2 AND 3;
    }
    --let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
    --let $ran= `SELECT $ran + ($pq > 0)`
    --inc $q
  }
  --echo # all four ran in the workers (expect 4)
  --disable_query_log
  --eval SELECT $ran AS ran_in_the_workers
  --enable_query_log
  --inc $mode
}

SET GLOBAL debug_dbug= @save_dbug;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
