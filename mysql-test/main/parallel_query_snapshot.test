#
# MDEV-39492 Parallel Query: the workers must read the manager's snapshot.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

# 'a' is unindexed (full scan), the even ids leave gaps to insert into
CREATE TABLE t1 (id INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq*2, seq FROM seq_1_to_1000;
CREATE TABLE t2 (b INT) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1);

connect (reader,localhost,root,,test);
SET parallel_worker_threads=4;
SET optimizer_trace='enabled=on';

--echo #
--echo # A row committed by another session after our snapshot was taken must
--echo # not appear in the parallel result set (expect 999, 1000).
--echo #
START TRANSACTION WITH CONSISTENT SNAPSHOT;

connection default;
INSERT INTO t1 VALUES (1, 1001);

connection reader;
--sorted_result
SELECT a FROM t1 WHERE a > 998;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS ran_in_parallel
  FROM information_schema.optimizer_trace;
COMMIT;

--echo #
--echo # Our own uncommitted row must appear: the snapshot the workers adopt
--echo # keeps the sharing transaction as its creator (expect 1002 among them).
--echo #
START TRANSACTION;
SELECT b FROM t2;
INSERT INTO t1 VALUES (3, 1002);
--sorted_result
SELECT a FROM t1 WHERE a > 998;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS ran_in_parallel
  FROM information_schema.optimizer_trace;
ROLLBACK;

--echo #
--echo # Rows another session commits all over the table while we scan it stay
--echo # invisible to every worker (expect empty).
--echo #
START TRANSACTION WITH CONSISTENT SNAPSHOT;

connection default;
INSERT INTO t1 SELECT seq*2+1, 9999 FROM seq_1_to_999;

connection reader;
--sorted_result
SELECT a FROM t1 WHERE a = 9999;
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS ran_in_parallel
  FROM information_schema.optimizer_trace;
COMMIT;

disconnect reader;
connection default;
DROP TABLE t1, t2;
