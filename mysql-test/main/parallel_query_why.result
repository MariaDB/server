SET SESSION optimizer_parallel_setup_cost= 0;
CREATE TABLE t1 (a INT PRIMARY KEY, w VARCHAR(4000), n INT, s CHAR(3),
KEY(s)) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, CONCAT('v',seq%7), seq%13, CONCAT('s',seq%5)
FROM seq_1_to_500;
ANALYZE TABLE t1 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
SET @save_trace= @@optimizer_trace;
SET SESSION optimizer_trace=1;
SET SESSION parallel_worker_threads=4;
# a driving table that cannot be scanned in parallel at all
why
["tb cannot be scanned in parallel: a blob-backed column, a fulltext search, a partitioned table, a temporary table, or an engine that does not do this", "no table this plan reads can be divided"]
# a GROUP BY column too wide to be a key part, in a table that starts on disk
why
["grouped: the aggregation table is keyed by a unique constraint rather than by the group -- create_tmp_table() does that on disk for a GROUP BY key too wide for the engine, and a hash of the row is not something a group can be looked up in", "the plan needs a temporary table and the workers cannot pre-aggregate into it"]
# an aggregate whose partial cannot be merged
why
["shape: an aggregate whose partial cannot be merged -- only COUNT, SUM, MIN, MAX and AVG can be"]
# a DISTINCT aggregate
why
["shape: an aggregate whose partial cannot be merged -- only COUNT, SUM, MIN, MAX and AVG can be"]
# a select list column that GROUP BY does not name
why
["grouped: a select list item reads a column outside an aggregate that GROUP BY does not name, so its value is whichever row the terminal happened to hold"]
# a GROUP BY column the WHERE binds to a constant: dropped from the plan's
# group key as constant, named by the query's GROUP BY, so read by the
# select list it is still a group column, and the plan is run divided
s	n	SUM(a)
s0	3	1750
s1	3	1948
s2	3	2156
s3	3	1844
s4	3	2052
why
NULL
divided
["t1"]
# a GROUP BY column of a table the plan reads by eq_ref through a grouped
# column: remove_const() drops it from the plan's group key, and it is
# still one value per group, so the plan is run divided
n	city	SUM(t1.a)
1	c1	9672
2	c2	9711
3	c0	9750
4	c1	9789
5	c2	9828
6	c0	9867
7	c1	9405
8	c2	9443
9	c0	9481
10	c1	9519
11	c2	9557
12	c0	9595
why
NULL
divided
["t1"]
# an index supplying the ORDER BY
why
["an index supplies the ORDER BY order, rows aren't splittable", "no table this plan reads can be divided"]
# a sort this thread cannot do over its container
why
["the manager cannot sort what the workers produce (see pwt_manager_sort_order)", "no table this plan reads can be divided"]
# LIMIT
why
["the select has a row limit -- a LIMIT clause, or the session's sql_select_limit -- which the drain does not enforce for a plan that does not pre-aggregate"]
# a refusal about one table of the join names that table
why
["the select has a HAVING clause", "<subquery2> is a temporary table, which a worker cannot re-open from its share"]
# an inner table read through a join buffer is not a reason: each worker
# runs a buffer of its own
why
NULL
#
# and nothing is said when the workers were never available: with
# parallel_worker_threads at 0 every query in the server declines
#
why
NULL
SET SESSION optimizer_trace= @save_trace;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
