#
# MDEV-39492 Parallel Query: a worker count for each scan, chosen from its cost.
#
# parallel_worker_threads is the ceiling the user allows and not the number of
# workers to use. Below it the count is chosen per scan: another worker divides
# the scan a little further and adds a whole worker's setup, and those two meet
# at a minimum. So a scan with more work to divide is given more workers, and a
# scan too small to pay for even the fewest is left to the serial reader.
#
# Per scan and not per query, because a query can hold more than one. TPC-H Q15
# does -- it references a view twice and materialises it twice -- and the two
# need not be scans of the same table, let alone of tables that want the same
# number of workers.
#
# The count is read back from the optimizer trace, which reports it beside
# chosen_for_parallel_scan. It is the count execution runs with: the engine may
# clamp it further, once the chunks it really produced are known.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

SET @s= @@session.parallel_worker_threads;
SET @t= @@session.optimizer_trace;
SET @os= @@session.optimizer_switch;
SET SESSION optimizer_switch='derived_merge=off';

CREATE TABLE t_tiny (pk INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t_tiny SELECT seq, seq % 97 FROM seq_1_to_500;

CREATE TABLE t_mid (pk INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t_mid SELECT seq, seq % 97 FROM seq_1_to_25000;

CREATE TABLE t_lge (pk INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t_lge SELECT seq, seq % 97 FROM seq_1_to_200000;

ANALYZE TABLE t_tiny, t_mid, t_lge PERSISTENT FOR ALL;

SET SESSION optimizer_trace='enabled=on';
SET SESSION parallel_worker_threads= 64;

--echo #
--echo # Three scans, one ceiling, three answers. Neither of the two that run is
--echo # at the ceiling: both are the count that costs least for that scan.
--echo #
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_tiny) d;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_workers') AS tiny_500_rows
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_mid) d;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_workers') AS mid_25000_rows
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_lge) d;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_workers') AS lge_200000_rows
  FROM information_schema.optimizer_trace;

--echo #
--echo # and in one query, two scans with a count each, reported in the order the
--echo # selects were optimized
--echo #
--disable_result_log
SELECT (SELECT SUM(a) FROM (SELECT a FROM t_mid) d),
       (SELECT SUM(a) FROM (SELECT a FROM t_lge) d);
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') AS tables,
       JSON_EXTRACT(trace,'$**.parallel_scan_workers') AS workers_per_scan
  FROM information_schema.optimizer_trace;

--echo #
--echo # the ceiling still binds where the scan would want more than it allows
--echo #
SET SESSION parallel_worker_threads= 6;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_lge) d;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_workers') AS lge_capped_at_6
  FROM information_schema.optimizer_trace;

--echo #
--echo # A ceiling below the floor cannot be met, so nothing is chosen. Before
--echo # the count was chosen per scan the trace named such a scan as chosen and
--echo # execution then declined it, the floor being applied there.
--echo #
SET SESSION parallel_worker_threads= 2;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_lge) d;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NULL AS none_chosen
  FROM information_schema.optimizer_trace;

--echo #
--echo # and the count that was costed is the count that runs
--echo #
SET SESSION optimizer_trace='enabled=off';
SET SESSION parallel_worker_threads= 64;
FLUSH STATUS;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_mid) d;
--enable_result_log
--source include/parallel_query_workers_per_query.inc
FLUSH STATUS;
--disable_result_log
SELECT SUM(a) FROM (SELECT a FROM t_lge) d;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # the answers are the ones a serial run gives
--echo #
SET SESSION parallel_worker_threads= @s;
--let $pqa_query= SELECT SUM(a) AS s, COUNT(*) AS c FROM (SELECT a FROM t_mid) d
--source include/parallel_query_aggregate_cmp.inc
--let $pqa_query= SELECT SUM(a) AS s, COUNT(*) AS c FROM (SELECT a FROM t_lge) d
--source include/parallel_query_aggregate_cmp.inc

DROP TABLE t_tiny, t_mid, t_lge;
SET SESSION optimizer_switch= @os;
SET SESSION optimizer_trace= @t;
SET SESSION parallel_worker_threads= @s;
