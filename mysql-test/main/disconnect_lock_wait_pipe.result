#
# MDEV-38741 Client disconnect fails to abort a lock wait, named pipe
#
call mtr.add_suppression("Aborted connection .*Client disconnected");
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
connect  blocker,localhost,root;
BEGIN;
SELECT * FROM t1 FOR UPDATE;
a
1
connection default;
# A client on the named pipe waits for the lock
# The client process dies, the server is not reading from the pipe
# The reason is logged
FOUND 1 matches in mysqld.1.err
disconnect blocker;
DROP TABLE t1;
# End of 10.11 tests
