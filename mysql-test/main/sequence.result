#
# MDEV-41258 Server crashes in Item_func_nextval::val_int()/update_table()
# when a table using DEFAULT NEXTVAL(sequence) is closed and reopened
# between two executions of a prepared statement
#
CREATE SEQUENCE s1 START WITH 1 INCREMENT BY 1 CACHE 10;
CREATE TABLE t1 (
id  BIGINT NOT NULL DEFAULT NEXTVAL(s1),
val VARCHAR(20),
PRIMARY KEY(id)
);
PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 'row1';
EXECUTE stmt USING @v;
FLUSH TABLE t1;
# Second execution, after the table was closed and reopened, must
# still find its sequence dependency (see sequence_debug.test for
# a stricter debug-build check of this same case).
SET @v = 'row2';
EXECUTE stmt USING @v;
SELECT val FROM t1 ORDER BY id;
val
row1
row2
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;
#
# A statement that reaches its sequence dependency via "USING
# DEFAULT", followed after a table reopen by an execution using an
# ordinary value, must not crash from a stale reference to the
# closed table.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
INSERT INTO t1 (val) VALUES (1);
PREPARE stmt FROM 'UPDATE t1 SET id=?';
EXECUTE stmt USING DEFAULT;
FLUSH TABLE t1;
EXECUTE stmt USING 5;
SELECT * FROM t1;
id	val
5	1
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;
#
# Two tables sharing the same sequence, linked by a trigger, must
# each keep their own independent dependency after a reopen.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TABLE t2 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TRIGGER tr AFTER INSERT ON t1 FOR EACH ROW
BEGIN
INSERT INTO t2 (val) VALUES (100);
END $$
PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 1;
EXECUTE stmt USING @v;
FLUSH TABLE t1;
SET @v = 2;
EXECUTE stmt USING @v;
SELECT * FROM t1;
id	val
1	1
3	2
SELECT * FROM t2;
id	val
2	100
4	100
DEALLOCATE PREPARE stmt;
DROP TRIGGER tr;
DROP TABLE t1, t2;
DROP SEQUENCE s1;
#
# A self-join referencing the same sequence-defaulted table twice
# must also keep each reference independent.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
INSERT INTO t1 (val) VALUES (1), (2);
UPDATE t1 a, t1 b SET a.val = DEFAULT WHERE a.id = b.id;
SELECT * FROM t1 ORDER BY id;
id	val
1	NULL
2	NULL
DROP TABLE t1;
DROP SEQUENCE s1;
#
# A dependency table dropped between two executions must not cause
# a use-after-free on the next execution.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TABLE t2 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TRIGGER tr AFTER INSERT ON t1 FOR EACH ROW
BEGIN
IF NEW.val > 100 THEN
INSERT INTO t2 (val) VALUES (NEW.val);
END IF;
END $$
PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 1;
EXECUTE stmt USING @v;
DROP TABLE t2;
SET @v = 2;
EXECUTE stmt USING @v;
SELECT * FROM t1;
id	val
1	1
2	2
DEALLOCATE PREPARE stmt;
DROP TRIGGER tr;
DROP TABLE t1;
DROP SEQUENCE s1;
#
# A DEFAULT reference inside a trigger's own statement must not be
# confused with the top-level statement's sequence dependency.
#
CREATE SEQUENCE s2;
CREATE TABLE t3 (id INT NOT NULL DEFAULT NEXTVAL(s2), val INT);
CREATE TABLE t4 (id INT NOT NULL DEFAULT NEXTVAL(s2), val INT);
INSERT INTO t4 (val) VALUES (1);
CREATE TRIGGER tr2 AFTER INSERT ON t3 FOR EACH ROW
BEGIN
UPDATE t4 SET id = DEFAULT, val = val + 10;
END $$
INSERT INTO t3 (val) VALUES (1);
SELECT * FROM t4;
id	val
3	11
DROP TRIGGER tr2;
DROP TABLE t3, t4;
DROP SEQUENCE s2;
#
# A literal DEFAULT in the prepared statement text itself (not bound
# via USING DEFAULT) must still work after the table is reopened.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (a INT DEFAULT NEXTVAL(s1), x INT);
INSERT INTO t1 (x) VALUES (1), (2);
PREPARE stmt FROM "UPDATE t1 SET a = DEFAULT WHERE x = 2";
EXECUTE stmt;
FLUSH TABLES;
EXECUTE stmt;
SELECT a, x FROM t1 WHERE x = 2;
a	x
1001	2
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;
#
# "USING DEFAULT" must still work after the statement is silently
# reprepared due to a DDL change between EXECUTEs.
#
CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
INSERT INTO t1 (val) VALUES (1);
PREPARE stmt FROM 'UPDATE t1 SET id=?';
# Force a reprepare before the next EXECUTE.
ALTER TABLE t1 COMMENT 'force reprepare';
EXECUTE stmt USING DEFAULT;
SELECT * FROM t1;
id	val
2	1
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;
CREATE SEQUENCE s1;
CREATE TABLE t1 (id BIGINT NOT NULL DEFAULT NEXTVAL(s1) PRIMARY KEY, a INT);
CREATE PROCEDURE p_insert()
BEGIN
DECLARE i INT DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION BEGIN END;
WHILE i < 200 DO
INSERT INTO t1 (a) VALUES (i);
SET i= i + 1;
END WHILE;
END|
CREATE PROCEDURE p_flush()
BEGIN
DECLARE i INT DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION BEGIN END;
WHILE i < 200 DO
FLUSH TABLES t1, s1;
SET i= i + 1;
END WHILE;
END|
connect  c1,localhost,root,,test;
connect  c2,localhost,root,,test;
connection c1;
CALL p_insert();
connection c2;
CALL p_flush();
connection c1;
connection c2;
connection default;
disconnect c1;
disconnect c2;
DROP PROCEDURE p_insert;
DROP PROCEDURE p_flush;
DROP TABLE t1;
DROP SEQUENCE s1;
# End of 10.11 tests
