SET NAMES utf8mb4;
#
# Start of 11.8 tests
#
#
# MDEV-41137 CHARACTER SET ANY_CS and CHARACTER SET OF var in stored routines
#
#
# CHARACTER SET ANY_CS: the parameter takes the character set and the
# collation of the actual argument, without conversion
#
CREATE PROCEDURE p1(a VARCHAR(10) CHARACTER SET ANY_CS)
BEGIN
SELECT CHARSET(a), COLLATION(a), HEX(a);
END;
$$
CALL p1('x');
CHARSET(a)	COLLATION(a)	HEX(a)
utf8mb4	utf8mb4_uca1400_ai_ci	78
CALL p1(_latin1 0xE9);
CHARSET(a)	COLLATION(a)	HEX(a)
latin1	latin1_swedish_ci	E9
CALL p1(_latin1'x' COLLATE latin1_bin);
CHARSET(a)	COLLATION(a)	HEX(a)
latin1	latin1_bin	78
CALL p1(_ucs2 0x0078);
CHARSET(a)	COLLATION(a)	HEX(a)
ucs2	ucs2_uca1400_ai_ci	0078
SET @a= _latin1 0xE9;
CALL p1(@a);
CHARSET(a)	COLLATION(a)	HEX(a)
latin1	latin1_swedish_ci	E9
# A prepared statement placeholder has the connection character set
PREPARE stmt FROM 'CALL p1(?)';
EXECUTE stmt USING @a;
CHARSET(a)	COLLATION(a)	HEX(a)
utf8mb4	utf8mb4_uca1400_ai_ci	C3A9
DEALLOCATE PREPARE stmt;
DROP PROCEDURE p1;
# OUT and INOUT: the user variables keep their own character sets
CREATE PROCEDURE p1(OUT o VARCHAR(10) CHARACTER SET ANY_CS,
INOUT io VARCHAR(10) CHARACTER SET ANY_CS)
BEGIN
SET o= 'x';
SET io= CONCAT(io, 'y');
END;
$$
SET @o= _latin1'a', @io= _ucs2 0x0061;
CALL p1(@o, @io);
SELECT CHARSET(@o), CHARSET(@io);
CHARSET(@o)	CHARSET(@io)
latin1	ucs2
DROP PROCEDURE p1;
# Function, and a DEFAULT value
CREATE FUNCTION f1(a VARCHAR(10) CHARACTER SET ANY_CS DEFAULT _latin1'x')
RETURNS VARCHAR(10) CHARACTER SET utf8mb4 RETURN CHARSET(a);
SELECT f1(), f1(_ucs2 0x0078), f1('x'), f1();
f1()	f1(_ucs2 0x0078)	f1('x')	f1()
latin1	ucs2	utf8mb4	latin1
DROP FUNCTION f1;
# The length is in characters, the size in bytes follows the argument
CREATE PROCEDURE p1(a VARCHAR(3) CHARACTER SET ANY_CS)
SELECT OCTET_LENGTH(a), CHAR_LENGTH(a);
CALL p1(_latin1 0xE9E9E9);
OCTET_LENGTH(a)	CHAR_LENGTH(a)
3	3
CALL p1('ééé');
OCTET_LENGTH(a)	CHAR_LENGTH(a)
6	3
CALL p1(_latin1 0xE9E9E9);
OCTET_LENGTH(a)	CHAR_LENGTH(a)
3	3
DROP PROCEDURE p1;
#
# CHARACTER SET OF var: the character set (and collation) is taken
# from a previous parameter or variable
#
# The source has a fixed character set
CREATE PROCEDURE p1(a VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_bin,
b VARCHAR(10) CHARSET OF a,
OUT c VARCHAR(10) CHARSET OF b)
BEGIN
DECLARE v VARCHAR(10) CHARSET OF c;
SET c= 'x';
BEGIN
DECLARE w VARCHAR(10) CHARSET OF a;
SELECT CHARSET(b), COLLATION(b), CHARSET(v), CHARSET(w);
END;
END;
$$
CALL p1('x', 'y', @c);
CHARSET(b)	COLLATION(b)	CHARSET(v)	CHARSET(w)
latin1	latin1_bin	latin1	latin1
SELECT CHARSET(@c);
CHARSET(@c)
latin1
# The source is ANY_CS: resolved at every call
CREATE PROCEDURE p2(a VARCHAR(3) CHARACTER SET ANY_CS, b VARCHAR(3) CHARSET OF a)
BEGIN
DECLARE v VARCHAR(3) CHARSET OF b;
SET v= 'ééé';
SELECT CHARSET(b), CHARSET(v), OCTET_LENGTH(v);
END;
$$
CALL p2(_latin1'x', 'y');
CHARSET(b)	CHARSET(v)	OCTET_LENGTH(v)
latin1	latin1	3
CALL p2(CONVERT('x' USING utf32), 'y');
CHARSET(b)	CHARSET(v)	OCTET_LENGTH(v)
utf32	utf32	12
CALL p2(_latin1'x', 'y');
CHARSET(b)	CHARSET(v)	OCTET_LENGTH(v)
latin1	latin1	3
# Only a source with a fixed character set is known at CREATE time
SELECT specific_name, parameter_name, character_set_name, collation_name
FROM information_schema.parameters
WHERE specific_schema=DATABASE() AND specific_name IN ('p1', 'p2')
ORDER BY specific_name, ordinal_position;
specific_name	parameter_name	character_set_name	collation_name
p1	a	latin1	latin1_bin
p1	b	latin1	latin1_bin
p1	c	latin1	latin1_bin
p2	a	NULL	NULL
p2	b	NULL	NULL
DROP PROCEDURE p1;
DROP PROCEDURE p2;
#
# RETURNS ... CHARSET OF param: the character set of the return value
# is taken from a parameter
#
# The source has a fixed character set
CREATE FUNCTION f1(a VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_bin)
RETURNS VARCHAR(10) CHARSET OF a RETURN a;
SELECT CHARSET(f1('x')), COLLATION(f1('x'));
CHARSET(f1('x'))	COLLATION(f1('x'))
latin1	latin1_bin
# The source is ANY_CS (here through a second parameter):
# resolved for every call
CREATE FUNCTION f2(a VARCHAR(10) CHARACTER SET ANY_CS, b VARCHAR(10) CHARSET OF a)
RETURNS VARCHAR(10) CHARSET OF b RETURN b;
SELECT CHARSET(f2(_latin1'x', 'y')), CHARSET(f2(_ucs2 0x0078, 'y')),
CHARSET(f2('x', 'y'));
CHARSET(f2(_latin1'x', 'y'))	CHARSET(f2(_ucs2 0x0078, 'y'))	CHARSET(f2('x', 'y'))
latin1	ucs2	utf8mb4
# An omitted argument: the character set of its DEFAULT value
CREATE FUNCTION f3(a VARCHAR(10) CHARACTER SET ANY_CS DEFAULT _latin1'x')
RETURNS VARCHAR(10) CHARSET OF a RETURN a;
SELECT CHARSET(f3()), CHARSET(f3(_ucs2 0x0078));
CHARSET(f3())	CHARSET(f3(_ucs2 0x0078))
latin1	ucs2
# The same call in a routine, a wider and then a narrower character set
CREATE PROCEDURE p3(a VARCHAR(10) CHARACTER SET ANY_CS)
SELECT CHARSET(f2(a, 'y'));
CALL p3(_latin1'x');
CHARSET(f2(a, 'y'))
latin1
CALL p3(_ucs2 0x0078);
CHARSET(f2(a, 'y'))
ucs2
CALL p3(_latin1'x');
CHARSET(f2(a, 'y'))
latin1
# The anchor is stored, and the functions are listed without errors
SELECT name, returns FROM mysql.proc
WHERE db=DATABASE() AND name IN ('f1', 'f2') ORDER BY name;
name	returns
f1	varchar(10) CHARSET latin1 COLLATE latin1_bin
f2	varchar(10) CHARSET OF `b`
SELECT routine_name, character_set_name FROM information_schema.routines
WHERE routine_schema=DATABASE() AND routine_name IN ('f1', 'f2', 'f3')
ORDER BY routine_name;
routine_name	character_set_name
f1	latin1
f2	NULL
f3	NULL
DROP PROCEDURE p3;
DROP FUNCTION f1;
DROP FUNCTION f2;
DROP FUNCTION f3;
#
# ANY_CS is allowed in routine parameters only
#
CREATE FUNCTION f1() RETURNS VARCHAR(10) CHARACTER SET ANY_CS RETURN 'x';
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
CREATE TABLE t1 (a VARCHAR(10) CHARACTER SET ANY_CS);
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
SELECT CAST('x' AS CHAR CHARACTER SET ANY_CS);
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
CREATE PROCEDURE p1(a ENUM('a','b') CHARACTER SET ANY_CS) SELECT 1;
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and this data type
CREATE PROCEDURE p1() BEGIN DECLARE v VARCHAR(10) CHARACTER SET ANY_CS; END;
$$
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
CREATE PROCEDURE p1()
BEGIN
DECLARE c CURSOR(cp VARCHAR(5) CHARACTER SET ANY_CS) FOR SELECT cp;
END;
$$
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
#
# CHARACTER SET OF var: errors
#
CREATE PROCEDURE p1(b VARCHAR(10) CHARSET OF a) SELECT 1;
ERROR 42000: Undeclared variable: a
CREATE PROCEDURE p1(a VARCHAR(10) CHARSET OF a) SELECT 1;
ERROR 42000: Undeclared variable: a
CREATE PROCEDURE p1(a INT, b VARCHAR(10) CHARSET OF a) SELECT 1;
ERROR HY000: Incorrect usage of CHARACTER SET OF and a non-string variable
CREATE PROCEDURE p1(a VARCHAR(10), b VARCHAR(10) CHARSET OF a COLLATE utf8mb4_bin) SELECT 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'COLLATE utf8mb4_bin) SELECT 1' at line 1
#
# MDEV-41151 SF erroneously caches an anchored return data type
#
CREATE TABLE t1 (a INT);
CREATE FUNCTION f1() RETURNS TYPE OF t1.a RETURN 5;
CREATE PROCEDURE p1()
BEGIN
FOR i IN 1..2 DO
CREATE OR REPLACE TABLE t2 AS SELECT f1() AS c1;
SELECT i, column_type FROM information_schema.columns
WHERE table_schema=DATABASE() AND table_name='t2';
ALTER TABLE t1 MODIFY a TEXT;
END FOR;
END;
$$
CALL p1();
i	column_type
1	int(11)
i	column_type
2	text
DROP PROCEDURE p1;
DROP FUNCTION f1;
DROP TABLE t1, t2;
#
# End of 11.8 tests
#
