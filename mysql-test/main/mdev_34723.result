INSERT INTO tt VALUES (1,2);
SELECT * FROM tt;
a	b
1	1
DROP TABLE tt;
CREATE TABLE tt (a INT, b INT);
CREATE TRIGGER tg BEFORE INSERT ON tt FOR EACH ROW SET NEW = ROW(NEW.a, NEW.a);
INSERT INTO tt VALUES (1,2);
SELECT * FROM tt;
a	b
1	1
FLUSH TABLES;
INSERT INTO tt VALUES (3,4);
SELECT * FROM tt;
a	b
1	1
3	3
DROP TABLE tt;
#
# MDEV-40490: SET NEW = (row subquery) in a trigger silently
# assigns NULL to all columns and skips the single-row check
#
