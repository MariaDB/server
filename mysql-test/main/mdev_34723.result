CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW BEGIN DECLARE c CURSOR FOR SELECT 1; BEGIN DECLARE r ROW TYPE OF c DEFAULT NEW; END; END|
INSERT INTO t1 VALUES (1);
FLUSH TABLES;
DROP TABLE t1;
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20);
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW BEGIN DECLARE c CURSOR FOR SELECT a, b FROM t2; BEGIN DECLARE r ROW TYPE OF c DEFAULT OLD; SET @v = CONCAT_WS(',', @v, r.a); END; END|
SET @v = NULL;
UPDATE t1 SET a = a + 100;
DROP TABLE t1;
DROP TABLE t2;
# MDEV-41814: Assertion `argp[arg_no]->fixed()' failed in
# sp_head::execute_function
#
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (2);
CREATE FUNCTION f(r ROW(a INT)) RETURNS INT RETURN 1;
CREATE TRIGGER tr BEFORE INSERT OR UPDATE ON t1 FOR EACH ROW DO f(OLD);
INSERT INTO t1 VALUES (1);
ERROR HY000: There is no OLD row in on INSERT trigger
UPDATE t1 SET a= 3 WHERE a=2;
SELECT * FROM t1;
a
3
DROP FUNCTION f;
DROP TABLE t1;
CREATE TABLE t1 (a INT);
CREATE FUNCTION f1(r ROW(a INT)) RETURNS INT RETURN 1;
CREATE TRIGGER tr1 BEFORE INSERT OR UPDATE ON t1 FOR EACH ROW SET @r = f1(OLD);
INSERT INTO t1 VALUES (1);
ERROR HY000: There is no OLD row in on INSERT trigger
DROP TABLE t1;
DROP FUNCTION f1;
#
# MDEV-41982: Assertion failure in Type_handler_composite::Item_val_bool
# on NEW AND 1 in trigger on single-column table
#
CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW SET @x = NEW AND 1;
UPDATE t SET a = 2;
ERROR 21000: Operand should contain 1 column(s)
DROP TABLE t;
#
# MDEV-41983: SIGSEGV in Item_cache_row::store on
# CASE NEW WHEN in trigger on single-column table
#
CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW BEGIN CASE NEW WHEN 1 THEN SET @x = 1; ELSE SET @x = 0; END CASE; END $$
UPDATE t SET a = 2;
ERROR 21000: Operand should contain 1 column(s)
DROP TABLE t;
#
# Re-parse trigger cursor ROW TYPE DEFAULT NEW/OLD after ALTER TABLE and repeated INSERT
#
CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT);
INSERT INTO t2 VALUES (10);
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT a FROM t2;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT NEW;
SET @x = r.a;
END;
END|
INSERT INTO t1 VALUES (1);
ALTER TABLE t2 ADD COLUMN b INT DEFAULT 0;
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
DROP TRIGGER tr;
DROP TABLE t1, t2;
#
# DEFAULT of a cursor ROW TYPE variable with OLD nested in an expression
# must be cleaned up between executions (multi-row UPDATE)
#
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20);
CREATE FUNCTION f(r ROW(a INT,b INT)) RETURNS ROW(x INT,y INT) RETURN ROW(r.a,r.b);
SET @s= '';
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT 1 x, 2 y;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT f(OLD);
SET @s= CONCAT(@s, r.x, ',', r.y, ';');
END;
END|
UPDATE t1 SET a= a+100;
SELECT @s;
@s
1,10;2,20;
UPDATE t1 SET a= a+100;
SELECT @s;
@s
1,10;2,20;101,10;102,20;
DROP TRIGGER tr;
DROP FUNCTION f;
DROP TABLE t1;
#
# NEW is the trigger row in a query that has a FROM clause, unless a
# column of that name is visible
#
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t2 VALUES (1,10),(2,20);
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
SET @x= (SELECT COUNT(*) FROM t2 WHERE ROW(t2.a, t2.b) = NEW);
INSERT INTO t1 VALUES (2,20);
SELECT @x;
@x
1
INSERT INTO t1 VALUES (3,30);
SELECT @x;
@x
0
DROP TABLE t1, t2;
#
# SIGNAL items must be scalar, NEW/OLD row is not
#
CREATE TABLE t1 (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
SIGNAL SQLSTATE '45000' SET CLASS_ORIGIN= NEW;
INSERT INTO t1 VALUES (1,2);
ERROR 21000: Operand should contain 2 column(s)
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= NEW;
INSERT INTO t1 VALUES (1,2);
ERROR 21000: Operand should contain 2 column(s)
DROP TRIGGER tr;
DROP TABLE t1;
#
# Results are asserted and multi-row tables are used: SET NEW = OLD,
# SET NEW = r (MDEV-40127), per-row state in comparison, function
# argument contexts (MDEV-41766/41767), CASE NEW is an error (MDEV-41983)
#
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW SET NEW = OLD;
UPDATE t1 SET a= a+100;
UPDATE t1 SET a= a+100;
SELECT * FROM t1;
a	b
1	10
2	20
3	30
DROP TRIGGER t1_bu;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE r ROW(x INT,y INT) DEFAULT (9,9);
SET NEW = r;
END;
$
UPDATE t1 SET a= 7;
SELECT * FROM t1;
a	b
9	9
9	9
9	9
DROP TRIGGER t1_bu;
SET @r= '';
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
SET @r= CONCAT(@r, NEW = OLD, OLD = (9,9), ';');
UPDATE t1 SET b= b+1;
SELECT @r;
@r
01;01;01;
DROP TRIGGER t1_bu;
CREATE FUNCTION f(r ROW(a INT, b INT)) RETURNS INT RETURN r.a + r.b;
SET @r= '';
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
SET @r= CONCAT(@r, f(OLD), ',', f(NEW), ';');
UPDATE t1 SET b= b+1;
SELECT @r;
@r
19,20;19,20;19,20;
DROP TRIGGER t1_bu;
DROP FUNCTION f;
DROP TABLE t1;
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2),(3);
SET @x= '';
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
CASE NEW WHEN 1 THEN SET @x= CONCAT(@x, 'one;'); ELSE SET @x= CONCAT(@x, 'other;'); END CASE;
END $$
UPDATE t1 SET a= a+10;
ERROR 21000: Operand should contain 1 column(s)
DROP TABLE t1;
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,2),(3,4);
SET @x= '';
CREATE TRIGGER t1_au AFTER UPDATE ON t1 FOR EACH ROW SET @x= CONCAT(@x, (NEW = OLD), ';');
UPDATE t1 SET a= a+1;
SELECT @x;
@x
0;0;
DROP TABLE t1;
