#
# MDEV-40490: SET NEW = (row subquery) in a trigger silently
# assigns NULL to all columns and skips the single-row check
#
CREATE TABLE src (a INT, b INT);
INSERT INTO src VALUES (10,20);
CREATE TABLE t (a INT, b INT) ;
CREATE TRIGGER t_bi
BEFORE INSERT ON t FOR EACH ROW
SET NEW = (SELECT a,b FROM src);
INSERT INTO t VALUES (1,2);
SELECT a,b FROM t;
a	b
10	20
DROP TABLE t, src;
CREATE TABLE src (id INT, a INT, b INT);
INSERT INTO src VALUES (1, 10, 20), (2, 30, 40);
CREATE TABLE t1 (a INT, b INT);
# Subquery returning exactly one row: the values must be assigned,
# not NULL
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
SET NEW = (SELECT a, b FROM src WHERE id = 1);
INSERT INTO t1 VALUES (1, 2);
SELECT * FROM t1;
a	b
10	20
DROP TRIGGER trg;
TRUNCATE t1;
# Subquery returning several rows: error, and no row is inserted
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
SET NEW = (SELECT a, b FROM src);
INSERT INTO t1 VALUES (1, 2);
ERROR 21000: Subquery returns more than 1 row
SELECT * FROM t1;
a	b
# Same for a multi-row INSERT: the first failing row aborts the statement
INSERT INTO t1 VALUES (3, 4), (5, 6);
ERROR 21000: Subquery returns more than 1 row
SELECT * FROM t1;
a	b
DROP TRIGGER trg;
# Subquery returning no rows: every column becomes NULL (not an error)
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
SET NEW = (SELECT a, b FROM src WHERE id = 99);
INSERT INTO t1 VALUES (1, 2);
SELECT * FROM t1;
a	b
NULL	NULL
DROP TRIGGER trg;
TRUNCATE t1;
# Same checks in BEFORE UPDATE
INSERT INTO t1 VALUES (1, 2);
CREATE TRIGGER trg BEFORE UPDATE ON t1 FOR EACH ROW
SET NEW = (SELECT a, b FROM src);
UPDATE t1 SET a = 100;
ERROR 21000: Subquery returns more than 1 row
SELECT * FROM t1;
a	b
1	2
DROP TRIGGER trg;
CREATE TRIGGER trg BEFORE UPDATE ON t1 FOR EACH ROW
SET NEW = (SELECT a, b FROM src WHERE id = 2);
UPDATE t1 SET a = 100;
SELECT * FROM t1;
a	b
30	40
DROP TRIGGER trg;
DROP TABLE t1, src;
