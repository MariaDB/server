#
# MDEV-40127: Server hangs when setting NEW=OLD on a multi-row table
#
# Test case: 1
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1);
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW SET NEW = OLD;
UPDATE t1 SET a = a + 100;
UPDATE t1 SET a = a + 100;
DROP TRIGGER t1_bu;
DROP TABLE t1;
Test case: 2
CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL);
INSERT INTO t1 VALUES (1,1),(2,2);
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN DECLARE r ROW(x INT,y INT) DEFAULT (9,9); SET NEW = r;
END;
$
UPDATE t1 SET a = 7;
DROP TRIGGER t1_bu;
DROP TABLE t1;
# Test case: 3
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t1 VALUES (1,1),(2,2);
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN SET NEW = OLD; INSERT INTO t2 VALUES (NEW.a, NEW.b);
END;
$
UPDATE t1 SET a = 99;
DROP TRIGGER t1_bu;
DROP TABLE t1;
DROP TABLE t2;
#
# MDEV-40130: SIGSEGV in Field_iterator_table::set_table at
#             sql/table.h:3350
#
