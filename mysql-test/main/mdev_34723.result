# Shutdown and restart work ok
CREATE TABLE t1 (a INT);
CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
SET NEW = OLD;
END;|
SHOW TRIGGERS;
Trigger	Event	Table	Statement	Timing	Created	sql_mode	Definer	character_set_client	collation_connection	Database Collation
t1_bu	UPDATE	t1	BEGIN
SET NEW = OLD;
END	BEFORE	#	STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION	root@localhost	latin1	latin1_swedish_ci	utf8mb4_uca1400_ai_ci
# restart
SHOW TRIGGERS;
Trigger	Event	Table	Statement	Timing	Created	sql_mode	Definer	character_set_client	collation_connection	Database Collation
t1_bu	UPDATE	t1	BEGIN
SET NEW = OLD;
END	BEFORE	#	STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION	root@localhost	latin1	latin1_swedish_ci	utf8mb4_uca1400_ai_ci
DROP TRIGGER t1_bu;
DROP TABLE t1;
# No unnecessary error emitted
CREATE TABLE t1 (a INT, b INT);
CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
DECLARE r ROW TYPE OF t1 DEFAULT (SELECT * FROM t1 WHERE a=1);
SET NEW = r;
END;|
INSERT INTO t1 VALUES (1, 1),(3, 3);
UPDATE t1 SET a = 10 WHERE a = 3;
SELECT * FROM t1;
a	b
1	1
1	1
DROP TRIGGER t1_bu;
DROP TABLE t1;
#
# Stored procedure variable scoping
#
CREATE TABLE t1 (id1 INT, val1  INT);
CREATE TABLE t2 (id2 INT, val2 INT);
INSERT INTO t1 VALUES (1, 10);
INSERT INTO t2 VALUES (1, 10);
SELECT * FROM t1;
id1	val1
1	10
SELECT * FROM t2;
id2	val2
1	10
CREATE TRIGGER trg BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
DECLARE a ROW (a1 INT, a2 INT) DEFAULT (3, 300);
SET NEW= a;
INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
BEGIN
DECLARE OLD INT DEFAULT 2;
DECLARE NEW INT DEFAULT 200;
INSERT INTO t2 VALUES (OLD, NEW);
END;
END|
UPDATE t1 SET id1 = 1 WHERE val1 = 10;
SELECT * FROM t1;
id1	val1
3	300
SELECT * FROM t2;
id2	val2
1	10
3	300
2	200
DROP TRIGGER trg;
DROP TABLE t1;
DROP TABLE t2;
