ERROR 21000: Operand should contain 2 column(s)
DROP TRIGGER tr;
DROP TABLE t1;
#
# ROW TYPE OF a table with VIRTUAL and INVISIBLE columns: OLD has the
# same number of columns as the row variable (generated columns are
# not assigned by SET NEW = r)
#
CREATE TABLE t1 (a INT, b INT, c INT AS (a+b) VIRTUAL, d INT INVISIBLE DEFAULT 5);
INSERT INTO t1 (a,b) VALUES (1,2),(3,4);
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE r ROW TYPE OF t1 DEFAULT OLD;
SET @x= CONCAT(IFNULL(@x,''), r.a, ',', r.b, ';');
SET NEW = r;
END $$
SET @x= '';
UPDATE t1 SET a= a+10;
SELECT @x;
@x
1,2;3,4;
SELECT a, b, c, d FROM t1;
a	b	c	d
1	2	3	5
3	4	7	5
DROP TABLE t1;
#
# Cursor ROW TYPE variable DEFAULT NEW/OLD: the value is read back, for
# OLD, BEFORE and AFTER triggers, multi-row statements, PREPARE/EXECUTE
# and FLUSH TABLES
#
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE log (s VARCHAR(100));
CREATE TRIGGER t1_bi BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT 0 x, 0 y;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT NEW;
INSERT INTO log VALUES (CONCAT('bi ', r.x, ',', r.y));
END;
END|
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT 0 x, 0 y;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT OLD;
INSERT INTO log VALUES (CONCAT('bu ', r.x, ',', r.y));
END;
END|
CREATE TRIGGER t1_ad AFTER DELETE ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT 0 x, 0 y;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT OLD;
INSERT INTO log VALUES (CONCAT('ad ', r.x, ',', r.y));
END;
END|
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
SELECT * FROM log;
s
bi 1,10
bi 2,20
bi 3,30
TRUNCATE log;
UPDATE t1 SET a= a+100;
SELECT * FROM log;
s
bu 1,10
bu 2,20
bu 3,30
TRUNCATE log;
FLUSH TABLES;
UPDATE t1 SET b= b+1;
SELECT * FROM log;
s
bu 101,10
bu 102,20
bu 103,30
TRUNCATE log;
PREPARE stmt FROM 'UPDATE t1 SET a= a+1';
EXECUTE stmt;
SELECT * FROM log;
s
bu 101,11
bu 102,21
bu 103,31
TRUNCATE log;
EXECUTE stmt;
SELECT * FROM log;
s
bu 102,11
bu 103,21
bu 104,31
TRUNCATE log;
DEALLOCATE PREPARE stmt;
DELETE FROM t1;
SELECT * FROM log;
s
ad 103,11
ad 104,21
ad 105,31
DROP TABLE t1, log;
#
# Re-parse of a cursor ROW TYPE declaration (ALTER TABLE of the cursor's
# table) with a multi-row statement, for DEFAULT NEW and for a DEFAULT
# that refers to the columns of NEW
#
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t2 VALUES (10, 20);
CREATE TABLE log (s VARCHAR(100));
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT a, b FROM t2;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT NEW;
INSERT INTO log VALUES (CONCAT('row ', r.a, ',', r.b));
END;
END|
INSERT INTO t1 VALUES (1,2),(3,4);
ALTER TABLE t2 ADD COLUMN c INT DEFAULT 0;
INSERT INTO t1 VALUES (5,6),(7,8);
INSERT INTO t1 VALUES (9,10);
SELECT * FROM log;
s
row 1,2
row 3,4
row 5,6
row 7,8
row 9,10
DROP TRIGGER tr;
TRUNCATE log;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT a, b FROM t2;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT ROW(NEW.a, NEW.b);
INSERT INTO log VALUES (CONCAT('fld ', r.a, ',', r.b));
END;
END|
INSERT INTO t1 VALUES (11,12),(13,14);
ALTER TABLE t2 ADD COLUMN d INT DEFAULT 0;
INSERT INTO t1 VALUES (15,16),(17,18);
INSERT INTO t1 VALUES (19,20);
SELECT * FROM log;
s
fld 11,12
fld 13,14
fld 15,16
fld 17,18
fld 19,20
DROP TRIGGER tr;
DROP TABLE t1, t2, log;
#
# Crash on multi-row trigger with ROW TYPE OF cursor DEFAULT subquery referencing OLD/NEW
#
CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
CREATE TABLE log (s VARCHAR(100));
INSERT INTO t1 VALUES (1,10),(1,11),(2,10);
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT a, b FROM t2;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT (SELECT OLD = (1,10), 0);
INSERT INTO log VALUES (CONCAT('eq ', r.a, ',', r.b));
END;
END|
UPDATE t1 SET b= b+1;
UPDATE t1 SET b= b-1 WHERE a= 2;
SELECT * FROM log;
s
eq 1,0
eq 0,0
eq 0,0
eq 0,0
DROP TRIGGER tr;
TRUNCATE log;
CREATE FUNCTION f(r ROW(a INT, b INT)) RETURNS INT RETURN r.a + r.b|
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
DECLARE c CURSOR FOR SELECT a, b FROM t2;
BEGIN
DECLARE r ROW TYPE OF c DEFAULT (SELECT f(OLD), 0);
INSERT INTO log VALUES (CONCAT('f ', r.a, ',', r.b));
END;
END|
UPDATE t1 SET b= b+1;
UPDATE t1 SET b= b+1 WHERE a= 2;
SELECT * FROM log;
s
f 12,0
f 13,0
f 12,0
f 13,0
DROP TRIGGER tr;
DROP FUNCTION f;
DROP TABLE t1, t2, log;
