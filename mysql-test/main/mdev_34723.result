INSERT INTO src VALUES (10,20);
CREATE TABLE t (a INT, b INT) ;
CREATE TRIGGER t_bi
BEFORE INSERT ON t FOR EACH ROW
SET NEW = (SELECT a,b FROM src);
INSERT INTO t VALUES (1,2);
SELECT a,b FROM t;
a	b
10	20
DROP TABLE t, src;
