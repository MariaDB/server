#
# MDEV-41448 Update Returning Into expected to produce warning/error
# for zero-row plan
#
CREATE OR REPLACE TABLE t1 (a INT);
UPDATE t1 SET a=a+1 WHERE 1=0 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
INSERT INTO t1 VALUES (1),(2);
UPDATE t1 SET a=a+1 WHERE a=123 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
UPDATE t1 SET a=a+1 WHERE 1=0 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
UPDATE t1 SET a=a+1 LIMIT 0 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
DROP TABLE t1;
#
# MDEV-41443 Update Returning into produces error when values don't change
#
# Plain UPDATE..RETURNING returns an empty set when no row changes
CREATE OR REPLACE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2);
UPDATE t1 SET a=a RETURNING a;
a
DROP TABLE t1;
# UPDATE..RETURNING..INTO used to fail with ER_SP_FETCH_NO_DATA.
# Now it raises a warning, like any other zero-row case.
SET @a=NULL;
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2);
UPDATE t1 SET a=a RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SELECT @a;
@a
NULL
DROP TABLE t1;
# The same with an AFTER UPDATE trigger. The trigger is still fired
# for the unchanged row, and the statement gives the same warning
# as without the trigger.
SET @a=NULL;
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1);
UPDATE t1 SET a=a RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SELECT @a;
@a
NULL
CREATE TABLE log (i INT);
CREATE TRIGGER trg AFTER UPDATE ON t1 FOR EACH ROW INSERT INTO log VALUES (1);
UPDATE t1 SET a=a RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SELECT @a;
@a
NULL
SELECT * FROM log;
i
1
DROP TABLE t1, log;
# End of 13.1 tests
