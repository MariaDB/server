#
# MDEV-38741 Client disconnect fails to abort a lock wait
# The client process is killed, on each of the connection protocols
#
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
connect  blocker,localhost,root;
BEGIN;
SELECT * FROM t1 FOR UPDATE;
a
1
connection default;
# A client waits for the lock
# The client process is killed, the server is not reading from the connection
# The reason is logged
FOUND 1 matches in mysqld.1.err
disconnect blocker;
DROP TABLE t1;
# End of 13.2 tests
