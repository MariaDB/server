--echo ### select * from t1 where c = 120 ORDER BY d % 5 LIMIT 2
let $out=`analyze format=json select * from t1 where c = 120 ORDER BY d % 5 LIMIT 2`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

drop table t1;

--echo ## Unordered scan (partition table is the second in the join
--echo ## order after optimization) extracted and minimised from the
--echo ## test main.partition

CREATE TABLE t1 (
  id int(8),
  PRIMARY KEY (id)
);

INSERT INTO t1 VALUES (11), (22), (33);

eval
CREATE TABLE t2 (
  taken int,
  id int,
  PRIMARY KEY (id,taken $direction),
  KEY taken (taken)
)
PARTITION BY RANGE (taken)
(
  PARTITION p1 VALUES LESS THAN (50),
  PARTITION p2 VALUES LESS THAN (60),
  PARTITION p3 VALUES LESS THAN MAXVALUE
);

INSERT INTO t2 VALUES
  (51,11), /* p2 */
  (63,11), /* p3 */
  (51,22), /* p2 */
  (53,22), /* p2 */
  (55,22), /* p2 */
  (57,22), /* p2 */
  (61,22), /* p3 */
  (63,22), /* p3 */
  (51,33), /* p2 */
  (55,33) /* p2 */
  ;

set @ff=53;
set @tt=64;

flush status;
SELECT t1.id
FROM t1
WHERE t1.id IN (
    SELECT distinct id
    FROM t2
    WHERE taken BETWEEN @ff AND @tt)
ORDER BY t1.id;
show status like 'handler_read_%';

--echo ### same statement as above
let $out=`analyze format=json
SELECT t1.id
FROM t1
WHERE t1.id IN (
    SELECT distinct id
    FROM t2
    WHERE taken BETWEEN @ff AND @tt)
ORDER BY t1.id`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

--echo ## ordered scan (partition table is the first in the join
--echo ## order after optimization and ORDER BY differs from
--echo ## PARTITION BY RANGE)
flush status;
SELECT t1.id
FROM t1
WHERE t1.id IN (
    SELECT distinct id
    FROM t2
    WHERE taken BETWEEN 53 AND 64)
ORDER BY t1.id;
show status like 'handler_read_%';

--echo ### same statement as above
let $out=`analyze format=json
SELECT t1.id
FROM t1
WHERE t1.id IN (
    SELECT distinct id
    FROM t2
    WHERE taken BETWEEN 53 AND 64)
ORDER BY t1.id`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

--echo ## ordered scan again (only one table and no ORDER BY)
flush status;
select distinct id from t2 where taken between @ff and @tt;
show status like 'handler_read_%';

--echo ### same statement as above
let $out=`analyze format=json
select distinct id from t2 where taken between @ff and @tt`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

drop table t1, t2;

--echo # partition index scan method is reset
CREATE TABLE t1 (
  c int,
  d INT,
  filler varchar(100),
  INDEX idx1(c , d )
) PARTITION BY RANGE COLUMNS(c, d) (
  PARTITION `p1` VALUES LESS THAN (1, 1),
  PARTITION `p2` VALUES LESS THAN (2, 2),
  PARTITION `p3` VALUES LESS THAN (3, 3),
  PARTITION `p4` VALUES LESS THAN (4, 4),
  PARTITION `p5` VALUES LESS THAN (MAXVALUE, MAXVALUE)
);

insert into t1
select t2.seq, t3.seq, 'filler' from  seq_1_to_5 t2, seq_1_to_5 t3;
flush status;

let $out=`analyze format=json select c,d from t1 order by d limit 16`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');
let $out=`analyze format=json select c,d from t1 order by c,d limit 16`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');
let $out=`analyze format=json select c,d from t1 order by d limit 16`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

drop table t1;

--echo #
--echo # MDEV-40479: Reverse prefix scan across partitions
--echo #

eval
CREATE TABLE t1 (a int, b int, c int, PRIMARY KEY (a, c), KEY (b, c $direction))
 PARTITION BY RANGE (c)
(PARTITION p1 VALUES LESS THAN (10),
 PARTITION p2 VALUES LESS THAN (20));

INSERT INTO t1 VALUES (1, 1, 15), (2, 1, 11), (3, 1, 6);

eval
explain
SELECT c FROM t1 WHERE b = 1 ORDER BY c $opposite_direction;
eval
SELECT c FROM t1 WHERE b = 1 ORDER BY c $opposite_direction;

DROP TABLE t1;

--echo #
--echo # MDEV-41322 Regression: descending primary-key range scan on a partitioned InnoDB table fails with ERROR 1032
--echo #

eval
CREATE TABLE t1 (
    id INT NOT NULL, PRIMARY KEY (id $direction)
) ENGINE=InnoDB
PARTITION BY RANGE(id) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN (200),
    PARTITION p2 VALUES LESS THAN (300)
);

INSERT INTO t1 VALUES (101), (102), (103);

--replace_column 9 #
eval
explain
SELECT * FROM t1 WHERE id >= 0 AND id <= 300 ORDER BY id $opposite_direction LIMIT 512;
eval
SELECT * FROM t1 WHERE id >= 0 AND id <= 300 ORDER BY id $opposite_direction LIMIT 512;

DROP TABLE t1;

--echo # New assertions coverage
eval
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, KEY(b)) ENGINE=InnoDB
PARTITION BY RANGE(a) (PARTITION p0 VALUES LESS THAN (100),
                       PARTITION p1 VALUES LESS THAN (200));
INSERT INTO t1 VALUES (1,1),(150,2);

EXPLAIN
SELECT * FROM t1 FORCE INDEX(b) WHERE b=1;
SELECT * FROM t1 FORCE INDEX(b) WHERE b=1;
DROP TABLE t1;

--echo #
--echo # MDEV-41366 Wrong result with Case 2 of non-merging partition index scan
--echo #

--echo # prefix-only PREFIX_LAST_OR_PREV qualifies Case 2
--echo # key comparison failure converted to EOF => scan the next partition
CREATE TABLE t1 (a INT, b INT, c INT, PRIMARY KEY(a,c), KEY(b,c)) ENGINE=InnoDB
PARTITION BY RANGE(c) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1,1,5),(2,0,12);
let $q=
SELECT c FROM t1 FORCE INDEX(b) WHERE b=1 AND c<=15 ORDER BY c DESC;
eval $q;
let $out=`analyze format=json $q`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

DROP TABLE t1;

--echo # same but with desc key
CREATE TABLE t1 (a INT, b INT, c INT, PRIMARY KEY(a,c), KEY(b desc,c desc)) ENGINE=InnoDB
PARTITION BY RANGE(c) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1,1,5),(2,0,12);
let $q=
SELECT c FROM t1 FORCE INDEX(b) WHERE b=0 AND c>=2 ORDER BY c;
eval $q;
let $out=`analyze format=json $q`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');

DROP TABLE t1;

--echo # prefix-only KEY_OR_NEXT / PREFIX_LAST_OR_PREV (opt_sum)
--echo # key comparison failure converted to EOF => scan the next partition
CREATE TABLE t1 (a INT, b INT, c INT NOT NULL, PRIMARY KEY(a,c), KEY k(b,c))
  ENGINE=InnoDB
PARTITION BY RANGE(c) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20),
                       PARTITION p2 VALUES LESS THAN (30));
--echo # no b=1 in p0 or p2
INSERT INTO t1 VALUES (1,2,5),(2,1,15),(3,0,22);

EXPLAIN
SELECT MIN(c) FROM t1 WHERE b=1;
SELECT MIN(c) FROM t1 WHERE b=1;

EXPLAIN
SELECT MAX(c) FROM t1 WHERE b=1;
SELECT MAX(c) FROM t1 WHERE b=1;
DROP TABLE t1;

--echo # index_first with prefix does not qualify Case 2
--echo # neither does index_read_map with prefix-only AFTER_KEY
CREATE TABLE t1 (a INT, b INT, KEY(a,b)) ENGINE=InnoDB
PARTITION BY RANGE COLUMNS(b) (PARTITION p1 VALUES LESS THAN (100),
                               PARTITION p2 VALUES LESS THAN (200),
                               PARTITION p3 VALUES LESS THAN MAXVALUE);
INSERT INTO t1 SELECT seq % 3 + 1, seq FROM seq_1_to_300;
ANALYZE TABLE t1 PERSISTENT FOR ALL;
let $q=
SELECT a, MIN(b) FROM t1 GROUP BY a;
eval EXPLAIN $q;
eval $q;
let $out=`analyze format=json $q`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');
DROP TABLE t1;

--echo # index_first with prefix does not qualify Case 2
--echo # neither does index_read_map with prefix-only AFTER_KEY
CREATE TABLE t1 (a INT, c INT, KEY(a,c)) ENGINE=InnoDB
PARTITION BY RANGE COLUMNS(c) (PARTITION p1 VALUES LESS THAN (100),
                               PARTITION p2 VALUES LESS THAN (200),
                               PARTITION p3 VALUES LESS THAN MAXVALUE);
INSERT INTO t1 SELECT 1, seq FROM seq_1_to_99;
INSERT INTO t1 SELECT 2, seq FROM seq_100_to_199;
INSERT INTO t1 SELECT 3, seq FROM seq_1_to_99;
ANALYZE TABLE t1 PERSISTENT FOR ALL;
let $q=
SELECT a, MIN(c) FROM t1 GROUP BY a;
eval EXPLAIN $q;
eval $q;
let $out=`analyze format=json $q`;
evalp set @js='$out';
select json_extract(@js,'$**.partitions_index_scan_method');
DROP TABLE t1;

--echo # AFTER_KEY / BEFORE_KEY prefix + partition column qualifies
--echo # Case 2.
--echo # key comparison failures converted to EOF => scan the next partition
CREATE TABLE t1 (a INT, b INT, c INT NOT NULL, PRIMARY KEY(a,c), KEY k(b,c))
  ENGINE=InnoDB
PARTITION BY RANGE(c) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20),
                       PARTITION p2 VALUES LESS THAN (30));
INSERT INTO t1 VALUES
  (1,1,5),(2,2,7),(3,2,10),(4,1,15),(5,2,18),(6,0,22),(7,1,25);

EXPLAIN
SELECT MIN(c) FROM t1 WHERE b=1 AND c>5;
FLUSH STATUS;
SELECT MIN(c) FROM t1 WHERE b=1 AND c>5;
--echo # 2 (unordered: p0, p1)
SHOW STATUS LIKE 'Handler_read_key';

EXPLAIN
SELECT MAX(c) FROM t1 WHERE b=1 AND c<25;
FLUSH STATUS;
SELECT MAX(c) FROM t1 WHERE b=1 AND c<25;
--echo # 2 (unordered: p2, p1)
SHOW STATUS LIKE 'Handler_read_key';
DROP TABLE t1;

--echo # KEY_OR_PREV needs a reverse partition scan.
--echo # Ordered scan (HASH)
CREATE TABLE t1 (a INT, KEY k(a)) ENGINE=InnoDB
PARTITION BY HASH(a) PARTITIONS 3;
INSERT INTO t1 SELECT seq FROM seq_1_to_9;
HANDLER t1 OPEN;
HANDLER t1 READ k <= (5);
HANDLER t1 READ k PREV;
HANDLER t1 READ k PREV;
HANDLER t1 READ k <= (0);
HANDLER t1 CLOSE;
DROP TABLE t1;

--echo # KEY_OR_PREV Unordered scan (Case 2).
CREATE TABLE t1 (a INT, b INT, c INT, PRIMARY KEY(a,c), KEY k(b,c))
ENGINE=InnoDB
PARTITION BY RANGE(c) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1,1,5),(2,2,7),(3,1,15);
HANDLER t1 OPEN;
HANDLER t1 READ k <= (1,17);
--echo # TODO: READ k PREV from here crosses into p0 with a stale key,
--echo # to be fixed in MDEV-41364
HANDLER t1 CLOSE;
DROP TABLE t1;

--enable_cursor_protocol
--enable_ps2_protocol
