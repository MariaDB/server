#
# MDEV-41218 A commit boundary that starts opening its tables over
#
# The boundary's statement opens the tables whose triggers fire, adds
# the tables of their bodies, and opens those.  When one of them makes
# the server close everything and open the tables again, the tables
# of the bodies are already in the table list.  Here a body writes a
# system-versioned table that needs a new history partition, which is
# created when the table is opened, and reads a view.
SET timestamp= UNIX_TIMESTAMP('2000-01-01 00:00:00');
CREATE TABLE tb (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tb_src (n INT) ENGINE=InnoDB;
CREATE VIEW tb_v AS SELECT n FROM tb_src;
CREATE TABLE tb_hist (n INT) ENGINE=InnoDB WITH SYSTEM VERSIONING
PARTITION BY SYSTEM_TIME INTERVAL 1 HOUR AUTO PARTITIONS 3;
INSERT INTO tb_src VALUES (1), (2);
INSERT INTO tb_hist VALUES (1), (2);
CREATE TRIGGER tb_commit AFTER INSERT ON tb BEFORE COMMIT OR SAVEPOINT
UPDATE tb_hist SET n= n + (SELECT COUNT(*) FROM tb_v);
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'tb_hist'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
p0
p1
pn
# At COMMIT
SET timestamp= UNIX_TIMESTAMP('2000-01-01 02:00:00');
BEGIN;
INSERT INTO tb VALUES (1), (2);
COMMIT;
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'tb_hist'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
p0
p1
p2
pn
SELECT id FROM tb ORDER BY id;
id
1
2
# At SAVEPOINT: the transaction goes on, and commits
SET timestamp= UNIX_TIMESTAMP('2000-01-01 03:00:00');
BEGIN;
INSERT INTO tb VALUES (3), (4);
SAVEPOINT s1;
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'tb_hist'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
p0
p1
p2
p3
pn
INSERT INTO tb VALUES (5), (6);
ROLLBACK TO SAVEPOINT s1;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
COMMIT;
SELECT id FROM tb ORDER BY id;
id
1
2
3
4
# At the implicit commit of a DDL statement
SET timestamp= UNIX_TIMESTAMP('2000-01-01 04:00:00');
BEGIN;
INSERT INTO tb VALUES (7), (8);
CREATE TABLE tb_ddl (a INT);
SELECT PARTITION_NAME FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'tb_hist'
  ORDER BY PARTITION_ORDINAL_POSITION;
PARTITION_NAME
p0
p1
p2
p3
p4
pn
SELECT id FROM tb ORDER BY id;
id
1
2
3
4
7
8
SET timestamp= DEFAULT;
DROP TABLE tb_ddl;
DROP VIEW tb_v;
DROP TABLE tb, tb_src, tb_hist;
