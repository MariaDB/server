--source include/have_innodb.inc
--source include/have_log_bin.inc

--echo #
--echo # Test CREATE OR REPLACE with tmp tables
--echo #

CREATE TEMPORARY TABLE t (i INT);
CREATE or replace TABLE t AS SELECT * FROM t;
DROP TEMPORARY TABLE t;
DROP TABLE t;

--echo #
--echo # MDEV-40994 Atomic CoR: Transaction not registered for MariaDB 2PC,
--echo #            but transaction is active
--echo #

CREATE TEMPORARY TABLE tmp (a INT) ENGINE=MyISAM;
CREATE SEQUENCE s ENGINE=InnoDB;
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
--error ER_CHECK_NOT_IMPLEMENTED
CREATE OR REPLACE TABLE s (a INT) ENGINE=CSV;
# Tmp table usage forces rowbased format
CREATE OR REPLACE TABLE s ENGINE=MyISAM AS SELECT * FROM tmp;
DROP TABLE s, tmp;

--echo # Test with FLUSH (same problem as above)

CREATE TEMPORARY TABLE tmp (a INT) ENGINE=MyISAM;
CREATE SEQUENCE s ENGINE=InnoDB;
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
FLUSH TABLES;
# Tmp table usage forces rowbased format
CREATE OR REPLACE TABLE s ENGINE=MyISAM AS SELECT * FROM tmp;
DROP TABLE s, tmp;