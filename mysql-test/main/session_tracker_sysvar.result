#
# MDEV-15477: SESSION_SYSVARS_TRACKER does not track last_gtid
#
SET gtid_seq_no=1000;
SET @@session.session_track_system_variables='last_gtid';
create table t1 (a int) engine=innodb;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- last_gtid: 0-1-1000

select @@last_gtid;
@@last_gtid
0-1-1000
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- last_gtid: 0-1-1000

insert into t1 values (1);
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- last_gtid: 0-1-1001

select @@last_gtid;
@@last_gtid
0-1-1001
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- last_gtid: 0-1-1001

drop table t1;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- last_gtid: 0-1-1002

reset master;
#
# MDEV-35086 Trying to lock mutex when the mutex was already locked (session_tracker.cc), server hangs
#
set session_track_system_variables='*';
alter table t1 nowait force;
ERROR 42S02: Table 'test.t1' doesn't exist
use mysql;
set session_track_system_variables=default;
# End of 10.5 tests
#
# MDEV-41424 Session tracker must be enabled by SET session_track_system_variables
# when the session started with an empty list
#
SET @save_global_track= @@global.session_track_system_variables;
SET GLOBAL session_track_system_variables= '';
connect  con1,localhost,root,,;
SELECT @@session.session_track_system_variables;
@@session.session_track_system_variables

SET SESSION session_track_system_variables= 'character_set_client';
# Expect character_set_client to be reported
SET NAMES latin1;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- character_set_client: latin1

SET SESSION session_track_system_variables= '*';
# Expect all three character_set_* variables to be reported
SET NAMES utf8mb3;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- character_set_client: utf8mb3
-- character_set_connection: utf8mb3
-- character_set_results: utf8mb3

SET SESSION session_track_system_variables= '';
# Expect nothing to be reported after the list was emptied again
SET NAMES latin1;
SET SESSION session_track_system_variables= 'character_set_client';
# Expect character_set_client to be reported again
SET NAMES utf8mb3;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- character_set_client: utf8mb3

disconnect con1;
# Control: the session started with a non-empty list
connection default;
SET GLOBAL session_track_system_variables= 'autocommit';
connect  con2,localhost,root,,;
SELECT @@session.session_track_system_variables;
@@session.session_track_system_variables
autocommit
SET SESSION session_track_system_variables= 'character_set_client';
SET NAMES latin1;
-- Tracker : SESSION_TRACK_SYSTEM_VARIABLES
-- character_set_client: latin1

disconnect con2;
connection default;
SET GLOBAL session_track_system_variables= @save_global_track;
# End of 10.11 tests
