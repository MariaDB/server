--source include/have_innodb.inc

--echo #
--echo # MDEV-40794: Dynamic Column Aggregate Name Pool Overflow
--echo # The named dynamic-column format stores the aggregate name-pool size
--echo # and every name offset in two bytes (max 65535 = MAX_TOTAL_NAME_LENGTH).
--echo # calc_var_sizes() accumulated total name length in size_t without
--echo # checking against MAX_TOTAL_NAME_LENGTH, causing 2-byte truncation/wrap
--echo # and a malformed blob (or Debug assertion abort).
--echo #

--echo # Control: 6 names x 10922 bytes = 65532 <= MAX_TOTAL_NAME_LENGTH (65535)
SET @control = COLUMN_CREATE(
  CONCAT('a', REPEAT('x', 10921)), 1,
  CONCAT('b', REPEAT('x', 10921)), 2,
  CONCAT('c', REPEAT('x', 10921)), 3,
  CONCAT('d', REPEAT('x', 10921)), 4,
  CONCAT('e', REPEAT('x', 10921)), 5,
  CONCAT('f', REPEAT('x', 10921)), 6
);
SELECT 'control', LENGTH(@control), COLUMN_CHECK(@control);

--echo # Trigger create: 7 names x 10923 bytes = 76461 > MAX_TOTAL_NAME_LENGTH (65535)
--echo # 7th name start offset = 6 x 10923 = 65538 >= 65536, hits DBUG_ASSERT at :444
--echo # Before fix: Debug abort (DBUG_ASSERT) / Release: malformed blob
--echo # After fix: ER_DYN_COL_IMPLEMENTATION_LIMIT (1920)
--error ER_DYN_COL_IMPLEMENTATION_LIMIT
SET @trigger = COLUMN_CREATE(
  CONCAT('a', REPEAT('x', 10922)), 1,
  CONCAT('b', REPEAT('x', 10922)), 2,
  CONCAT('c', REPEAT('x', 10922)), 3,
  CONCAT('d', REPEAT('x', 10922)), 4,
  CONCAT('e', REPEAT('x', 10922)), 5,
  CONCAT('f', REPEAT('x', 10922)), 6,
  CONCAT('g', REPEAT('x', 10922)), 7
);
SELECT @trigger;

--echo # Trigger update: start with valid blob, add names to exceed limit
--echo # 7 names x 10923 = 76461 > 65535; 7th offset = 65538 >= 65536
SET @d = COLUMN_CREATE(CONCAT('a', REPEAT('x', 10922)), 1);
SELECT 'before_add', LENGTH(@d), COLUMN_CHECK(@d);
--error ER_DYN_COL_IMPLEMENTATION_LIMIT
SET @d = COLUMN_ADD(@d,
  CONCAT('b', REPEAT('x', 10922)), 2,
  CONCAT('c', REPEAT('x', 10922)), 3,
  CONCAT('d', REPEAT('x', 10922)), 4,
  CONCAT('e', REPEAT('x', 10922)), 5,
  CONCAT('f', REPEAT('x', 10922)), 6,
  CONCAT('g', REPEAT('x', 10922)), 7
);
SELECT 'after_add', LENGTH(@d), COLUMN_CHECK(@d);

--echo # Verify control blob is still usable after failed operations
SELECT COLUMN_CHECK(@control) AS control_still_valid;
