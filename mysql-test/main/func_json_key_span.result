SET @@collation_connection= @old_coll;
#
# 5. Removing a key reads the path the same way
#
SELECT JSON_REMOVE('{"a":1,"b":2}', '$.a') AS removed;
removed
{"b": 2}
SELECT JSON_REMOVE(JSON_INSERT('{"b":2}', '$.a', 1), '$.a') AS removed_is_valid;
removed_is_valid
{"b": 2}
