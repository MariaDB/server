#
# MDEV-41218 The read locks of a commit boundary
#
# With statement-based logging nothing is logged for a BEFORE COMMIT
# body and the replica runs the body again, so on the primary the body
# has to read under the locks of a statement that writes.  The
# boundary's statement locks a table that a body only reads with
# TL_READ_NO_INSERT when binlog_format is STATEMENT or MIXED, and with
# TL_READ when it is ROW.
CREATE TABLE tr (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tr_src (a INT) ENGINE=InnoDB;
CREATE TABLE tr_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER tr_commit AFTER INSERT ON tr BEFORE COMMIT
INSERT INTO tr_log SELECT a FROM tr_src;
# binlog_format=STATEMENT
SET binlog_format= STATEMENT;
BEGIN;
INSERT INTO tr VALUES (1), (2);
COMMIT;
# prelocking for test.tr: INSERT BEFORE COMMIT triggers are prelocked by this statement
# column marking for test.tr: captured columns marked for read: a, + __op_order, __op, __state
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.tr, columns: a, + __op_order, __op, __state; fixed from triggers tr_commit; has OR SAVEPOINT triggers: no
# capture INSERT row of test.tr (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.tr (NEW=record[0]) into the transaction accumulator at position 1
# statement committed inside the transaction: statement mark moves from 0 to 2
# COMMIT of a multi-statement transaction (statement: COMMIT): boundary reached, accumulator holds 2 rows, in_sub_stmt=0, open tables in THD: none
# COMMIT of a multi-statement transaction (statement: COMMIT): the boundary's statement opens and locks the tables whose triggers fire and the tables their bodies use
# COMMIT of a multi-statement transaction (statement: COMMIT): prelocking for test.tr: the bodies of the triggers that have rows to fire over (tr_commit) are prelocked by the boundary's statement
# COMMIT of a multi-statement transaction (statement: COMMIT): test.tr_src, which the bodies only read, is locked with TL_READ_NO_INSERT
# COMMIT of a multi-statement transaction (statement: COMMIT): test.tr enters the firing chain at depth 1; it is open and locked by the boundary's statement, transactional MDL_SHARED_WRITE held: yes; bodies would run on the tables the boundary prelocked
# COMMIT of a multi-statement transaction (statement: COMMIT): FIRE test.tr_commit (AFTER INSERT BEFORE COMMIT, order 1) over positions [0, 2): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# transaction end: accumulator of 2 rows freed with the transaction mem_root
# binlog_format=MIXED
SET binlog_format= MIXED;
BEGIN;
INSERT INTO tr VALUES (3), (4);
COMMIT;
# prelocking for test.tr: INSERT BEFORE COMMIT triggers are prelocked by this statement
# column marking for test.tr: captured columns marked for read: a, + __op_order, __op, __state
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.tr, columns: a, + __op_order, __op, __state; fixed from triggers tr_commit; has OR SAVEPOINT triggers: no
# capture INSERT row of test.tr (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.tr (NEW=record[0]) into the transaction accumulator at position 1
# statement committed inside the transaction: statement mark moves from 0 to 2
