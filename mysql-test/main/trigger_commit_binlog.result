#
# MDEV-41218 BEFORE COMMIT triggers on a primary with the binary log on
#
# With the binary log on, the log is a participant of the transaction
# and the commit is a two-phase commit with it.  The triggers fire
# before anything of the transaction is written to the log: a
# transaction that commits is logged whole, and one whose body fails
# leaves nothing in the log.
RESET MASTER;
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t1_commit AFTER INSERT OR UPDATE ON t1
BEFORE COMMIT OR SAVEPOINT SET @x= 1;
CREATE TRIGGER t1_stmt AFTER INSERT ON t1 FOR EACH STATEMENT SET @x= 1;
# CREATE TRIGGER test.t1_commit: AFTER INSERT,UPDATE ON t1 BEFORE COMMIT OR SAVEPOINT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t1_stmt: AFTER INSERT ON t1 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# An autocommit statement
INSERT INTO t1 VALUES (1), (2);
# prelocking for test.t1: INSERT BEFORE COMMIT triggers are prelocked by this statement
# column marking for test.t1: captured columns marked for read: a, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: a, + __op_order, __op, __state
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 1 INSERT rows
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.t1, columns: a, + __op_order, __op, __state; fixed from triggers t1_commit; has OR SAVEPOINT triggers: yes
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 2 INSERT rows
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 1
# end of statement: FIRE test.t1_stmt (AFTER INSERT FOR EACH STATEMENT) over 2 INSERT, 0 UPDATE, 0 DELETE rows; true: INSERTING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1), (2)): boundary reached, accumulator holds 2 rows, in_sub_stmt=0, open tables in THD: yes
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1), (2)): test.t1 enters the firing chain at depth 1; it is still open in thd->open_tables, transactional MDL_SHARED_WRITE held: yes; bodies would run on the tables the statement prelocked
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1), (2)): FIRE test.t1_commit (AFTER INSERT,UPDATE BEFORE COMMIT OR SAVEPOINT, order 1) over positions [0, 2): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# transaction end: accumulator of 2 rows freed with the transaction mem_root
# A transaction with a savepoint
BEGIN;
INSERT INTO t1 VALUES (3), (4);
SAVEPOINT s1;
UPDATE t1 SET a= a + 10 WHERE a < 3;
COMMIT;
# prelocking for test.t1: INSERT BEFORE COMMIT triggers are prelocked by this statement
# column marking for test.t1: captured columns marked for read: a, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: a, + __op_order, __op, __state
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 1 INSERT rows
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.t1, columns: a, + __op_order, __op, __state; fixed from triggers t1_commit; has OR SAVEPOINT triggers: yes
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 2 INSERT rows
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 1
