#
# MDEV-41218 A row event replayed by a BINLOG statement in idempotent
# mode, on a table with triggers
#
# With slave_exec_mode=IDEMPOTENT the applier leaves a DML command on
# the statement, and with slave_run_triggers_for_rbr=YES it prelocks
# the tables of the triggers in a table list that it frees at the end
# of the event.  The triggers fire inside the BINLOG statement, at the
# end of the row event, and nothing of the statement reads that table
# list afterwards.
CREATE TABLE tb (a INT PRIMARY KEY, b INT) ENGINE=MyISAM;
FLUSH BINARY LOGS;
INSERT INTO tb VALUES (1, 1), (2, 2);
FLUSH BINARY LOGS;
# The triggers are created after the event is logged, so that the
# event does not say that the primary ran triggers for it
CREATE TRIGGER tb_row AFTER INSERT ON tb FOR EACH ROW SET @x= 1;
CREATE TRIGGER tb_stmt AFTER INSERT ON tb FOR EACH STATEMENT SET @x= 1;
SET @save_mode= @@global.slave_exec_mode;
SET @save_trg= @@global.slave_run_triggers_for_rbr;
SET GLOBAL slave_exec_mode= IDEMPOTENT;
SET GLOBAL slave_run_triggers_for_rbr= YES;
# CREATE TRIGGER test.tb_stmt: AFTER INSERT ON tb FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# column marking for test.tb: captured columns marked for read: a, b, + __op_order, __op, __state
# statement set: entry for test.tb created, columns: a, b, + __op_order, __op, __state
# capture INSERT row of test.tb through tb (NEW=record[0]) into the statement set, now 1 INSERT rows
# column marking for test.tb: captured columns marked for read: a, b, + __op_order, __op, __state
# capture INSERT row of test.tb through tb (NEW=record[0]) into the statement set, now 2 INSERT rows
# end of statement: FIRE test.tb_stmt (AFTER INSERT FOR EACH STATEMENT) over 2 INSERT, 0 UPDATE, 0 DELETE rows; true: INSERTING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
SET GLOBAL slave_exec_mode= @save_mode;
SET GLOBAL slave_run_triggers_for_rbr= @save_trg;
SELECT * FROM tb ORDER BY a;
a	b
1	1
2	2
DROP TABLE tb;
#
# MDEV-41218 A BINLOG statement whose row event does not end its
# statement
#
# The rows are applied and captured, and the statement that they
# belong to never ends: its FOR EACH STATEMENT triggers do not fire.
# The captured rows are dropped before the BINLOG statement closes
# the table.
CREATE TABLE tu (a INT PRIMARY KEY, b INT) ENGINE=MyISAM;
SET @save_checksum= @@global.binlog_checksum;
SET GLOBAL binlog_checksum= NONE;
FLUSH BINARY LOGS;
INSERT INTO tu VALUES (1, 1), (2, 2);
FLUSH BINARY LOGS;
SET GLOBAL binlog_checksum= @save_checksum;
# The row event is rewritten without its end-of-statement flag
# STMT_END_F cleared in a row event
TRUNCATE TABLE tu;
CREATE TRIGGER tu_stmt AFTER INSERT ON tu FOR EACH STATEMENT SET @x= 1;
SET @save_trg= @@global.slave_run_triggers_for_rbr;
SET GLOBAL slave_run_triggers_for_rbr= YES;
# CREATE TRIGGER test.tu_stmt: AFTER INSERT ON tu FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# column marking for test.tu: captured columns marked for read: a, b, + __op_order, __op, __state
# statement set: entry for test.tu created, columns: a, b, + __op_order, __op, __state
# capture INSERT row of test.tu through tu (NEW=record[0]) into the statement set, now 1 INSERT rows
# column marking for test.tu: captured columns marked for read: a, b, + __op_order, __op, __state
# capture INSERT row of test.tu through tu (NEW=record[0]) into the statement set, now 2 INSERT rows
# end of statement: statement failed, 2 INSERT, 0 UPDATE, 0 DELETE rows dropped from the statement set of test.tu
SET GLOBAL slave_run_triggers_for_rbr= @save_trg;
SELECT * FROM tu ORDER BY a;
a	b
1	1
2	2
DROP TABLE tu;
#
# MDEV-41218 A DDL statement that commits a transaction whose BEFORE
# COMMIT body writes only a table that is not replicated
#
# The statement of the commit boundary writes no replicated table, so
# nothing of it is to be logged.  That is decided for the boundary's
# statement alone: the DDL statement that reached the boundary is
# logged.
CREATE TABLE tf (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tf_ddl1 (a INT) ENGINE=InnoDB;
CREATE TABLE tf_ddl2 (a INT) ENGINE=InnoDB;
CREATE TRIGGER tf_commit AFTER INSERT ON tf BEFORE COMMIT
UPDATE performance_schema.setup_consumers SET ENABLED= 'YES'
    WHERE NAME = 'no_such_consumer';
# CREATE TRIGGER test.tf_commit: AFTER INSERT ON tf BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
BEGIN;
INSERT INTO tf VALUES (1), (2);
DROP TABLE tf_ddl1;
BEGIN;
INSERT INTO tf VALUES (3), (4);
RENAME TABLE tf_ddl2 TO tf_ddl3;
# prelocking for test.tf: INSERT BEFORE COMMIT triggers are prelocked by this statement
# column marking for test.tf: captured columns marked for read: a, + __op_order, __op, __state
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.tf, columns: a, + __op_order, __op, __state; fixed from triggers tf_commit; has OR SAVEPOINT triggers: no
# capture INSERT row of test.tf (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.tf (NEW=record[0]) into the transaction accumulator at position 1
# statement committed inside the transaction: statement mark moves from 0 to 2
