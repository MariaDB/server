#
# LIMIT of an ordered group list, which the manager applies to the groups
#
# SELECT a, COUNT(*) FROM t1 GROUP BY a ORDER BY a LIMIT 3
SELECT a, COUNT(*) FROM t1 GROUP BY a ORDER BY a LIMIT 3;
a	COUNT(*)
0	285
1	286
2	286
SELECT a, COUNT(*) FROM t1 GROUP BY a ORDER BY a LIMIT 3;
a	COUNT(*)
0	285
1	286
2	286
ran_in_the_workers
1
#
# an index on the grouping column does not by itself change any of this.
# Whether the plan takes the grouping order from an index is a cost
# decision, and for a secondary index over few groups a full scan plus the
# keyed temp table still wins, so this runs in the workers.
#
CREATE TABLE t2 (pk INT PRIMARY KEY, a INT, b INT, KEY(a)) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq % 7, seq * 3 FROM seq_1_to_2000;
# SELECT a, COUNT(*), SUM(b) FROM t2 GROUP BY a ORDER BY a
SELECT a, COUNT(*), SUM(b) FROM t2 GROUP BY a ORDER BY a;
a	COUNT(*)	SUM(b)
0	285	855855
1	286	856713
2	286	857571
3	286	858429
4	286	859287
5	286	860145
6	285	855000
SELECT a, COUNT(*), SUM(b) FROM t2 GROUP BY a ORDER BY a;
a	COUNT(*)	SUM(b)
0	285	855855
1	286	856713
2	286	857571
3	286	858429
4	286	859287
5	286	860145
6	285	855000
ran_in_the_workers
1
#
# the shapes that are declined, and what declines each one.
#
# These two are the plans that want their rows already grouped: EXPLAIN
# says "Using filesort" and not "Using temporary", so the grouping order
# comes from sorting the driving table and the terminal is the one that
# compares each row with the previous one. The optimizer did choose the
# parallel scan for them -- EXPLAIN still reports type PARALLEL -- and
# run_worker_side_join() declines at execution, once the terminal is known.
#
# SELECT a, COUNT(*), COUNT(DISTINCT c) FROM t1 GROUP BY a ORDER BY a
SELECT a, COUNT(*), COUNT(DISTINCT c) FROM t1 GROUP BY a ORDER BY a;
a	COUNT(*)	COUNT(DISTINCT c)
0	285	283
1	286	283
2	286	283
3	286	283
4	286	283
5	286	283
6	285	282
SELECT a, COUNT(*), COUNT(DISTINCT c) FROM t1 GROUP BY a ORDER BY a;
a	COUNT(*)	COUNT(DISTINCT c)
0	285	283
1	286	283
2	286	283
3	286	283
4	286	283
5	286	283
6	285	282
ran_in_the_workers
0
