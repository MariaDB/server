SELECT a, COUNT(*) FROM t1 GROUP BY a WITH ROLLUP;
a	COUNT(*)
0	285
1	286
2	286
3	286
4	286
5	286
6	285
NULL	2000
SELECT a, COUNT(*) FROM t1 GROUP BY a WITH ROLLUP;
a	COUNT(*)
0	285
1	286
2	286
3	286
4	286
5	286
6	285
NULL	2000
ran_in_the_workers
0
#
# GROUP BY the primary key is refused earlier and for a different reason:
# the plan reads the clustered index in order (EXPLAIN type "index"), and a
# driving table that is not a full scan is not one the gate accepts.
#
# SELECT pk, COUNT(*) FROM t2 GROUP BY pk ORDER BY pk LIMIT 3
SELECT pk, COUNT(*) FROM t2 GROUP BY pk ORDER BY pk LIMIT 3;
pk	COUNT(*)
1	1
2	1
3	1
SELECT pk, COUNT(*) FROM t2 GROUP BY pk ORDER BY pk LIMIT 3;
pk	COUNT(*)
1	1
2	1
3	1
ran_in_the_workers
0
#
# A DISTINCT of the grouped rows, ordered, runs in the workers: both the
# dedup and the sort are applied above the join, on the manager. It used to
# be declined here, for the ORDER BY, until the sort was allowed where it
# sits above the join -- see main.parallel_query_order_by.
#
# SELECT DISTINCT COUNT(*) FROM t1 GROUP BY a ORDER BY 1
SELECT DISTINCT COUNT(*) FROM t1 GROUP BY a ORDER BY 1;
COUNT(*)
285
286
SELECT DISTINCT COUNT(*) FROM t1 GROUP BY a ORDER BY 1;
COUNT(*)
285
286
ran_in_the_workers
1
#
# A GROUP BY over constants, which the optimizer empties into one implicit
# group. What reaches execution is an ordinary aggregate over the whole
# scan, and the workers run it as one.
#
# SELECT COUNT(*), SUM(b) FROM t1 GROUP BY 'x'
SELECT COUNT(*), SUM(b) FROM t1 GROUP BY 'x';
COUNT(*)	SUM(b)
2000	6003000
SELECT COUNT(*), SUM(b) FROM t1 GROUP BY 'x';
COUNT(*)	SUM(b)
2000	6003000
ran_in_the_workers
1
# SELECT AVG(b) FROM t1 GROUP BY 1+1, 'x'
SELECT AVG(b) FROM t1 GROUP BY 1+1, 'x';
AVG(b)
3001.5000
SELECT AVG(b) FROM t1 GROUP BY 1+1, 'x';
AVG(b)
3001.5000
ran_in_the_workers
1
DROP TABLE t1, t2, d1;
SET SESSION optimizer_switch= @os;
SET SESSION parallel_worker_threads= @s;
