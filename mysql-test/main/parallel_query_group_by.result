SET @s= @@session.parallel_worker_threads;
SET @os= @@session.optimizer_switch;
SET SESSION optimizer_switch='derived_merge=off';
CREATE TABLE t1 (pk INT PRIMARY KEY, a INT, b INT, c INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq % 7, seq * 3, IF(seq % 100 = 0, NULL, seq)
FROM seq_1_to_2000;
CREATE TABLE d1 (id INT PRIMARY KEY, nm VARCHAR(8)) ENGINE=InnoDB;
INSERT INTO d1 SELECT seq, CONCAT('n',seq) FROM seq_1_to_10;
#
# the groups, compared as a multiset because a GROUP BY with no ORDER BY
# has no promised order in either direction
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,n,s))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,n,s))) AS crc_xor FROM (SELECT a, COUNT(*) AS n, SUM(b) AS s FROM t1 GROUP BY a) d;
n	crc_sum	crc_xor
7	14051885752	3538891528
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,n,s))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,n,s))) AS crc_xor FROM (SELECT a, COUNT(*) AS n, SUM(b) AS s FROM t1 GROUP BY a) d;
n	crc_sum	crc_xor
7	14051885752	3538891528
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# with ORDER BY, which is applied to the aggregation temp table on the
# manager, after every row has arrived -- so the output is fully ordered
# and can be compared as it stands
#
# SELECT a, COUNT(*), SUM(b), MIN(b), MAX(b), AVG(b) FROM t1 GROUP BY a ORDER BY a
SELECT a, COUNT(*), SUM(b), MIN(b), MAX(b), AVG(b) FROM t1 GROUP BY a ORDER BY a;
a	COUNT(*)	SUM(b)	MIN(b)	MAX(b)	AVG(b)
0	285	855855	21	5985	3003.0000
1	286	856713	3	5988	2995.5000
2	286	857571	6	5991	2998.5000
3	286	858429	9	5994	3001.5000
4	286	859287	12	5997	3004.5000
5	286	860145	15	6000	3007.5000
6	285	855000	18	5982	3000.0000
SELECT a, COUNT(*), SUM(b), MIN(b), MAX(b), AVG(b) FROM t1 GROUP BY a ORDER BY a;
a	COUNT(*)	SUM(b)	MIN(b)	MAX(b)	AVG(b)
0	285	855855	21	5985	3003.0000
1	286	856713	3	5988	2995.5000
2	286	857571	6	5991	2998.5000
3	286	858429	9	5994	3001.5000
4	286	859287	12	5997	3004.5000
5	286	860145	15	6000	3007.5000
6	285	855000	18	5982	3000.0000
ran_in_the_workers
1
#
# the aggregate kinds that keep their own state, per group. c has NULLs, so
# COUNT(c) says the column travels and travels NULL as NULL.
#
# SELECT a, COUNT(*), COUNT(c), SUM(c), MIN(c), MAX(c), STD(b) FROM t1 GROUP BY a ORDER BY a
SELECT a, COUNT(*), COUNT(c), SUM(c), MIN(c), MAX(c), STD(b) FROM t1 GROUP BY a ORDER BY a;
