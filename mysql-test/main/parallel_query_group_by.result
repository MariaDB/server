4	286	283	283729	4	1999	1733.7723
5	286	283	282815	5	1993	1733.7723
6	285	282	282000	6	1994	1727.7100
SELECT a, COUNT(*), COUNT(c), SUM(c), MIN(c), MAX(c), STD(b) FROM t1 GROUP BY a ORDER BY a;
a	COUNT(*)	COUNT(c)	SUM(c)	MIN(c)	MAX(c)	STD(b)
0	285	283	283185	7	1995	1727.7100
1	286	283	282271	1	1996	1733.7723
2	286	283	283457	2	1997	1733.7723
3	286	283	282543	3	1998	1733.7723
4	286	283	283729	4	1999	1733.7723
