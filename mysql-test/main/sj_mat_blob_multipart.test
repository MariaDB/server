#
# A subquery materialized into an in-memory temporary table is looked up
# through the unique key of that table.  When one of the key parts holds a
# blob, the key buffer carries a length and a pointer rather than the value
# itself, and the lookup has to place every following key part at the offset
# the storage engine reads it from.
#
# The queries below differ only in where the blob key part sits and how many
# key parts follow it.  Materialization is forced so that the plan does not
# decide the coverage.
#
set @save_optimizer_switch=@@optimizer_switch;
set optimizer_switch='materialization=on,in_to_exists=off,semijoin=off';

CREATE TABLE t1 (c1 VARCHAR(600), c2 INT NOT NULL, c3 INT) CHARSET=latin1;
CREATE TABLE t2 (d1 VARCHAR(600), d2 INT NOT NULL, d3 INT) CHARSET=latin1;
INSERT INTO t1 VALUES (REPEAT('x',600), 1, 10), (REPEAT('y',600), 2, 20);
INSERT INTO t2 VALUES (REPEAT('x',600), 1, 10), (REPEAT('z',600), 3, 30);

--echo #
--echo # One key part, the blob part is last. Nothing follows it in the key
--echo # buffer, so the offset it advances to is never used.
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE LEFT(c1,100) IN (SELECT SUBSTRING(d1,1,100) FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE LEFT(c1,100) IN (SELECT SUBSTRING(d1,1,100) FROM t2);

--echo #
--echo # Two key parts and no blob part at all: the value is short enough to
--echo # stay a VARCHAR in the temporary table.
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE (LEFT(c1,8), c2) IN (SELECT SUBSTRING(d1,1,8), d2 FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE (LEFT(c1,8), c2) IN (SELECT SUBSTRING(d1,1,8), d2 FROM t2);

--echo #
--echo # Two key parts, the blob part first and a NOT NULL part after it
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE (LEFT(c1,100), c2) IN (SELECT SUBSTRING(d1,1,100), d2 FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE (LEFT(c1,100), c2) IN (SELECT SUBSTRING(d1,1,100), d2 FROM t2);

--echo #
--echo # The same with a nullable part after the blob part
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE (LEFT(c1,100), c3) IN (SELECT SUBSTRING(d1,1,100), d3 FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE (LEFT(c1,100), c3) IN (SELECT SUBSTRING(d1,1,100), d3 FROM t2);

--echo #
--echo # The blob part between two other key parts
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE (c2, LEFT(c1,100), c3) IN (SELECT d2, SUBSTRING(d1,1,100), d3 FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE (c2, LEFT(c1,100), c3) IN (SELECT d2, SUBSTRING(d1,1,100), d3 FROM t2);

--echo #
--echo # Two blob key parts, one after the other
--echo #
EXPLAIN SELECT c2 FROM t1
  WHERE (LEFT(c1,100), LEFT(c1,200)) IN
        (SELECT SUBSTRING(d1,1,100), SUBSTRING(d1,1,200) FROM t2);
--sorted_result
SELECT c2 FROM t1
  WHERE (LEFT(c1,100), LEFT(c1,200)) IN
        (SELECT SUBSTRING(d1,1,100), SUBSTRING(d1,1,200) FROM t2);

DROP TABLE t1, t2;
set optimizer_switch=@save_optimizer_switch;
