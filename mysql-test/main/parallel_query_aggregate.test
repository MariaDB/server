#
# MDEV-39492 Parallel Query: the workers aggregate their own chunk per group.
#
# For a GROUP BY whose aggregates are all one of SUM, COUNT, MIN and MAX, each
# worker folds its chunk into a grouping table of its own and ships one row per
# group rather than one per source row. The manager primes the query's own
# aggregates with each partial (Item_sum::direct_add) and hands the row to the
# plan's own terminal, end_update(), whose update_field() takes the direct
# value in place of the row.
#
# Those four are what direct_add() exists on, and they are also the four whose
# reset_field()/update_field() honour a direct value. Everything else is
# declined -- see the second half.
#
--source include/have_innodb.inc
--source include/not_embedded.inc
--source include/have_sequence.inc

--disable_service_connection

CREATE TABLE t1 (col1 INT, col2 INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq MOD 10, seq FROM seq_1_to_5000;

--echo #
--echo # The same answer as a serial plan, for each of the four.
--echo #
--echo # ---- serial ----
SET SESSION parallel_worker_threads=0;
--sorted_result
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
  FROM t1 GROUP BY col1 ORDER BY NULL;

--echo # ---- parallel ----
SET SESSION parallel_worker_threads=4;
--sorted_result
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
  FROM t1 GROUP BY col1 ORDER BY NULL;
--disable_ps_protocol
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--enable_ps_protocol
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers
--enable_query_log

--echo #
--echo # And it really is per group, not per row: 5000 rows become one row per
--echo # group per worker, so what the manager sees is 40 rows and what the
--echo # workers did to get there is an update per row.
--echo #
--disable_ps_protocol
FLUSH STATUS;
--disable_result_log
SELECT col1, COUNT(col2) FROM t1 GROUP BY col1 ORDER BY NULL;
--enable_result_log
--let $tw= query_get_value(SHOW SESSION STATUS LIKE 'Handler_tmp_write', Value, 1)
--let $tu= query_get_value(SHOW SESSION STATUS LIKE 'Handler_tmp_update', Value, 1)
--enable_ps_protocol
--disable_query_log
--eval SELECT $tw < 200 AS rows_written_is_per_group, $tu > 4000 AS rows_folded_in
--enable_query_log

--echo #
--echo # NULLs. A worker whose chunk holds no non-NULL value for a group ships a
--echo # NULL partial, which has to be skipped rather than read as a zero or
--echo # taken as the extreme. Here col2 is NULL for a whole group, and NULL for
--echo # scattered rows of the others.
--echo #
CREATE TABLE t2 (col1 INT, col2 INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq MOD 10,
                      IF(seq MOD 10 = 7 OR seq MOD 3 = 0, NULL, seq)
  FROM seq_1_to_5000;

--echo # ---- serial ----
SET SESSION parallel_worker_threads=0;
--sorted_result
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
  FROM t2 GROUP BY col1 ORDER BY NULL;
--echo # ---- parallel ----
SET SESSION parallel_worker_threads=4;
--sorted_result
SELECT col1, COUNT(col2), SUM(col2), MIN(col2), MAX(col2)
  FROM t2 GROUP BY col1 ORDER BY NULL;

--echo #
--echo # A group key of more than one column, and one that is nullable.
--echo #
--echo # ---- serial ----
SET SESSION parallel_worker_threads=0;
--sorted_result
SELECT col1, col2 MOD 3, COUNT(*), SUM(col2)
  FROM t2 GROUP BY col1, col2 MOD 3 ORDER BY NULL;
--echo # ---- parallel ----
SET SESSION parallel_worker_threads=4;
--sorted_result
SELECT col1, col2 MOD 3, COUNT(*), SUM(col2)
  FROM t2 GROUP BY col1, col2 MOD 3 ORDER BY NULL;

--echo #
--echo # A 2 table join executed in the worker
--echo #
create index ixt2 on t2 (col1);
let $q=
SELECT t1.col1, COUNT(t1.col2), SUM(t1.col2), MIN(t1.col2), MAX(t1.col2),
COUNT(t2.col1) FROM t1 join t2 on t1.col1 = t2.col1
GROUP BY t1.col1 ORDER BY t1.col1;
--echo # ---- serial ----
SET SESSION parallel_worker_threads=0;
--eval explain $q
--eval $q
--echo # ---- parallel ----
SET SESSION parallel_worker_threads=4;
--eval explain $q
--eval $q


DROP TABLE t2;

--echo #
--echo # What is not accepted. Each of these still runs, serially: the gate
--echo # declines the plan rather than the query.
--echo #
SET @st= @@optimizer_trace;
SET optimizer_trace=1;
--disable_query_log
--disable_result_log
SELECT col1, AVG(col2) FROM t1 GROUP BY col1 ORDER BY NULL;
--enable_result_log
--echo # AVG -- a partial average cannot be averaged
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT col1, STDDEV(col2) FROM t1 GROUP BY col1 ORDER BY NULL;
--enable_result_log
--echo # STDDEV -- same, with more state
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT col1, BIT_XOR(col2) FROM t1 GROUP BY col1 ORDER BY NULL;
--enable_result_log
--echo # BIT_XOR -- self-composing, but has no direct_add
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT col1, COUNT(DISTINCT col2) FROM t1 GROUP BY col1 ORDER BY NULL;
--enable_result_log
--echo # COUNT(DISTINCT) -- the set has to be complete before it is counted
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT col1, COUNT(col2) FROM t1 GROUP BY col1 HAVING COUNT(col2) > 1
  ORDER BY NULL;
--enable_result_log
--echo # HAVING -- refused by the gate outright
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--disable_result_log
SELECT col1, COUNT(col2) FROM t1 GROUP BY col1 ORDER BY col1;
--enable_result_log
--echo # a real ORDER BY -- the rows would have to come back in order
SELECT JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
  FROM information_schema.optimizer_trace;
--enable_query_log
SET optimizer_trace= @st;

SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
