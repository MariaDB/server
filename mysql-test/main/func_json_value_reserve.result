#
# What the widest escape actually costs.  A character that cannot
# be written as it stands is escaped as a backslash, a 'u' and
# the hex of its UTF-16 form, which is four figures for most
# characters and eight for the ones outside the first plane: ten
# characters at the very worst, never more.
#
# The difference between allowing ten and allowing twelve is a
# width apiece, and a width decides whether a result is small
# enough to be kept in a VARCHAR at all.
#
CREATE TABLE t7 (s VARCHAR(45));
INSERT INTO t7 VALUES (REPEAT('a',45)), (REPEAT('b',45));
SELECT JSON_QUOTE(s) AS quoted FROM t7;
Catalog	Database	Table	Table_alias	Column	Column_alias	Type	Length	Max length	Is_null	Flags	Decimals	Charsetnr
def					quoted	253	452	47	Y	128	39	8
quoted
"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
CREATE TABLE d9 AS SELECT JSON_ARRAY(s) AS r FROM t7;
SHOW CREATE TABLE d9;
Table	Create Table
d9	CREATE TABLE `d9` (
  `r` varchar(458) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
DROP TABLE d9;
DROP TABLE t7;
