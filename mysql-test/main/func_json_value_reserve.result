#
# The same numbers again, read off the column a result is put in.
# The document, then a path and a value for each pair.
#
CREATE TABLE d1 AS SELECT JSON_SET(v, '$.p', 'z') AS r FROM t1;
SHOW CREATE TABLE d1;
