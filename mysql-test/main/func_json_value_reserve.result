SET @save_optimizer_switch= @@optimizer_switch;
CREATE TABLE t1 (v VARCHAR(200));
INSERT INTO t1 VALUES ('{"x":1}'), ('{"x":2}');
CREATE TABLE t2 (v VARCHAR(10), s VARCHAR(20));
INSERT INTO t2 VALUES ('{"x":1}', REPEAT(CHAR(1),20)),
('{"x":2}', REPEAT(CHAR(2),20));
CREATE TABLE t3 (v VARCHAR(200));
INSERT INTO t3 VALUES (CONCAT('{"x":"', REPEAT('a',190), '"}')),
(CONCAT('{"x":"', REPEAT('b',190), '"}'));
#
# What is asked for, taken off the result itself rather than off
# a column it was put in.  Nothing about where the result goes can
# reach this number, so it says what the arithmetic came to and
# nothing else.  The Length column is the one to read.
#
SELECT JSON_SET(v, '$.p', 'z') AS one_pair FROM t1;
