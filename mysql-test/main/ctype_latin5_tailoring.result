#
# DATE_FORMAT() result repertoire depends on the locale
# which is actually used: the explicit third argument, or
# @@lc_time_names. Locale names (e.g. of days) can be non-ASCII.
# latin1 and latin5_turkish_ci are not compatible on ASCII, unless
# the DATE_FORMAT() result is allowed to be non-ASCII, so its collation
# can be preferred.
#
SET NAMES latin1;
# en_US names are ASCII
SELECT DATE_FORMAT('2024-01-02','%W') = _latin5'a';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin5'a';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
# An explicit non-ASCII locale is not ignored
SELECT DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin5'a';
DATE_FORMAT('2024-01-02','%W','ru_RU') = _latin5'a'
0
# A non-constant locale is not known at the fixing time
SET @loc='en_US';
SELECT DATE_FORMAT('2024-01-02','%W',@loc) = _latin5'a';
DATE_FORMAT('2024-01-02','%W',@loc) = _latin5'a'
0
# The session locale is not used when the locale is passed explicitly
SET lc_time_names=ru_RU;
SELECT DATE_FORMAT('2024-01-02','%W') = _latin5'a';
DATE_FORMAT('2024-01-02','%W') = _latin5'a'
0
SELECT DATE_FORMAT('2024-01-02','%W','en_US') = _latin5'a';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
SET lc_time_names=DEFAULT;
SET NAMES DEFAULT;
# End of 11.8 tests
