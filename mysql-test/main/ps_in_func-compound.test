--echo #
--echo # MDEV-39518 Allow prepared statements in stored functions in assignment right hand
--echo #


CREATE TABLE t1 (a INT);
DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT
BEGIN
  EXECUTE IMMEDIATE 'INSERT INTO t1 VALUES (1)';
  RETURN 1;
END;
$$
BEGIN NOT ATOMIC
  DECLARE v INT DEFAULT f1();
END;
$$
DELIMITER ;$$
SELECT * FROM t1;
DROP FUNCTION f1;
DROP TABLE t1;


CREATE TABLE t1 (a INT);
DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT
BEGIN
  EXECUTE IMMEDIATE 'BEGIN NOT ATOMIC INSERT INTO t1 VALUES (1); END';
  RETURN 1;
END;
$$
CREATE PROCEDURE p1()
BEGIN
  DECLARE v INT DEFAULT f1();
END;
$$
DELIMITER ;$$
CALL p1();
SELECT * FROM t1;
DROP PROCEDURE p1;
DROP FUNCTION f1;
DROP TABLE t1;


--echo # End of 13.1 tests
