#
# MDEV-39492 Parallel Query: a worker result set that outgrows its heap
# container is rebuilt on disk and carries on there.
#
# The container a worker ships its rows through is a temporary table, and when
# it fills, pwt_tmp_table_sink::emit_row() hands it to the server's own
# create_internal_tmp_table_from_heap(). What makes that usable from a worker
# is that the container is opened cross-thread, so Aria does not tie its own
# allocations to the thread that opened it, and that the handle is rebound to
# whichever thread is using it (handler::rebind_to_thread) -- the worker while
# it writes, the manager when it reads the rows back.
#
# Created_tmp_disk_tables is what shows the rebuild really happened: one per
# worker that filled. Row counts are read from status rather than computed,
# because an aggregate over the query under test would run it serially and
# measure nothing, and the statements they are read for run with the
# prepared-statement protocol disabled: it executes a statement twice and the
# counters would then read double.
#
--source include/have_innodb.inc
--source include/not_embedded.inc
--source include/have_sequence.inc

--disable_service_connection

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(200)) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, CONCAT(REPEAT('x',180), seq) FROM seq_1_to_400;
SET SESSION parallel_worker_threads=4;
SET SESSION tmp_memory_table_size=16384;
SET SESSION max_heap_table_size=16384;

# The output is narrow but the query reads b, so it is b that fills the
# containers: what travels is the columns read, not the ones sent. LENGTH(b)
# is evaluated by the manager, from the bytes that came back through a rebuilt
# container, so the rows below check the content and not only the count.
--echo # every row back from containers that had to be rebuilt
--disable_ps_protocol
FLUSH STATUS;
--sorted_result
SELECT a, LENGTH(b) FROM t1;
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $dt= query_get_value(SHOW SESSION STATUS LIKE 'Created_tmp_disk_tables', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--enable_ps_protocol
--echo # ran in the workers, all 400 rows, containers rebuilt (expect 1 1 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 400 AS every_row_arrived, $dt > 0 AS rebuilt_on_disk
--enable_query_log

# And at a size that used to fail the statement outright: 20000 rows of 200
# bytes against a 64K heap container.
SET SESSION tmp_memory_table_size=65536;
SET SESSION max_heap_table_size=65536;
INSERT INTO t1 SELECT seq, CONCAT(REPEAT('x',180), seq)
  FROM seq_401_to_20000;
--disable_ps_protocol
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t1;
--enable_result_log
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $dt= query_get_value(SHOW SESSION STATUS LIKE 'Created_tmp_disk_tables', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--enable_ps_protocol
--echo # ran in the workers, all 20000 rows, containers rebuilt (expect 1 1 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 20000 AS every_row_arrived, $dt > 0 AS rebuilt_on_disk
--enable_query_log

# A pre-aggregating worker aggregates into the very container the manager
# reads, so its rows are written by the server's own end_update() and not by
# the transport. When that table fills, end_update() is what rebuilds it on
# disk, and the rebuild has to be the cross-thread kind the transport does --
# the manager reads the table afterwards, and frees it, on another thread.
# Enough distinct groups to overflow a 64K heap table. The group column is
# not the primary key: grouping on that is answered from the index in order,
# with no table to fill.
CREATE TABLE t2 (a INT PRIMARY KEY, g INT, b VARCHAR(200)) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq, CONCAT(REPEAT('x',180), seq) FROM seq_1_to_20000;
SET SESSION tmp_memory_table_size=65536;
SET SESSION max_heap_table_size=65536;
FLUSH STATUS;
--disable_ps_protocol
--disable_result_log
SELECT g, COUNT(*), SUM(LENGTH(b)) FROM t2 GROUP BY g;
--enable_result_log
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $dt= query_get_value(SHOW SESSION STATUS LIKE 'Created_tmp_disk_tables', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--enable_ps_protocol
--echo # ran in the workers, a row per group, rebuilt on disk (expect 1 1 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 20000 AS every_group_arrived, $dt > 0 AS rebuilt_on_disk
--enable_query_log

# and the answer is the serial one, group for group
SET SESSION parallel_worker_threads=0;
--let $ser= `SELECT SUM(CRC32(CONCAT_WS('/',g,c,s))) FROM (SELECT g, COUNT(*) c, SUM(LENGTH(b)) s FROM t2 GROUP BY g) d`
SET SESSION parallel_worker_threads=4;
--let $par= `SELECT SUM(CRC32(CONCAT_WS('/',g,c,s))) FROM (SELECT g, COUNT(*) c, SUM(LENGTH(b)) s FROM t2 GROUP BY g) d`
--echo # the parallel answer matches the serial one (expect 1)
--disable_query_log
--eval SELECT $ser = $par AS same_answer
--enable_query_log

SET SESSION tmp_memory_table_size=default;
SET SESSION max_heap_table_size=default;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1, t2;
