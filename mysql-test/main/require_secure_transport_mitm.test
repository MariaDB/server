--source include/not_windows.inc
--source include/not_embedded.inc
--source include/have_ssl_communication.inc
if (!$AUTH_ED25519_SO) {
  --skip No auth_ed25519 plugin
}
if (!$DIALOG_EXAMPLES_SO) {
  --skip No dialog_examples plugin
}

--echo #
--echo # MDEV-40530 Bind the client authentication response to the server certificate
--echo #

--echo #
--echo # require_secure_transport with a man in the middle that relays
--echo # the authentication and then uses the connection
--echo #
call mtr.add_suppression("Invalid ssl_info_client from 'native'@'localhost'");
install soname 'auth_ed25519';
install plugin three_attempts soname 'dialog_examples';

create user native@'%' identified via mysql_native_password using password('foo');
create user ed@'%' identified via ed25519 using password('bar');
create user nohash@'%' identified via three_attempts using 'onetwothree';
create user multi@'%' identified via mysql_native_password using password('pw1')
                                  or ed25519 using password('pw2');
create user x509@'%' require x509;
create user x509pw@'%' identified by 'pw' require x509;
create user issuer@'%' require issuer '/CN=cacert/C=FI/ST=Helsinki/L=Helsinki/O=MariaDB';
create user reqssl@'%' require ssl;
connect ssl_con,127.0.0.1,root,,,$MASTER_MYPORT,,SSL;
let $cipher= query_get_value(show status like 'ssl_cipher', Value, 1);
disconnect ssl_con;
connection default;
--replace_result $cipher CIPHER
eval create user reqcipher@'%' require cipher '$cipher';
grant create on test.* to native@'%';

--let $mitm=perl lib/ssl-mitm.pl --listen-on $MITM_PORT --connect-to $MASTER_MYPORT --ssl-ca std_data/cacert.pem --ssl-key std_data/server-new-key.pem --ssl-cert std_data/server-new-cert.pem --hijack "create table test.hijacked (a int)"

--echo # MitM uses the connection, the client detects MitM too late
--exec $mitm
--echo # mysql -unative -pfoo --ssl-verify-server-cert -e "select 1"
--replace_regex /TLS\/SSL error.*certificate[^\n]*/TLS\/SSL error: Failed to verify the server certificate/
--error 1
--exec $MYSQL --port $MITM_PORT -unative -pfoo --ssl-verify-server-cert -e "select 1" 2>&1
show tables like 'hijacked';
drop table hijacked;

set global require_secure_transport=on;

--echo # the client proves that it has seen the server certificate
--echo # mysql -unative -pfoo --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp -unative -pfoo --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql -ued -pbar --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp -ued -pbar --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql -umulti -ppw1 --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp -umulti -ppw1 --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql -umulti -ppw2 --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp -umulti -ppw2 --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --compress -unative -pfoo --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --compress --protocol tcp -unative -pfoo --ssl-verify-server-cert -e "select 1" 2>&1

--echo # the client has verified the server certificate itself
--echo # mysql -unative -pfoo --ssl-verify-server-cert --ssl-ca=cacert.pem -e "select 1"
--exec $MYSQL --protocol tcp -unative -pfoo --ssl-verify-server-cert --ssl-ca=$MYSQL_TEST_DIR/std_data/cacert.pem -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -unative -pfoo --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp --host 127.0.0.1 -unative -pfoo --ssl-verify-server-cert -e "select 1" 2>&1
--let $cert=--ssl-ca=$MYSQL_TEST_DIR/std_data/cacert.pem --ssl-cert=$MYSQL_TEST_DIR/std_data/client-cert.pem --ssl-key=$MYSQL_TEST_DIR/std_data/client-key.pem
--echo # mysql -ux509pw -ppw --ssl-verify-server-cert --ssl-cert=client-cert.pem -e "select 1"
--exec $MYSQL --protocol tcp -ux509pw -ppw --ssl-verify-server-cert $cert -e "select 1" 2>&1

--echo # no password hash, but a client certificate
--echo # mysql -ux509 --ssl-verify-server-cert --ssl-cert=client-cert.pem -e "select 1"
--exec $MYSQL --protocol tcp -ux509 --ssl-verify-server-cert $cert -e "select 1" 2>&1
--echo # mysql -ux509 --disable-ssl-verify-server-cert --ssl-cert=client-cert.pem -e "select 1"
--exec $MYSQL --protocol tcp -ux509 --disable-ssl-verify-server-cert $cert -e "select 1" 2>&1
--echo # mysql -uissuer --ssl-verify-server-cert --ssl-cert=client-cert.pem -e "select 1"
--exec $MYSQL --protocol tcp -uissuer --ssl-verify-server-cert $cert -e "select 1" 2>&1

--echo # no password hash to prove anything with
--echo # mysql --host 127.0.0.1 -uroot --ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --protocol tcp --host 127.0.0.1 -uroot --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -unohash -ponetwothree --ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --protocol tcp --host 127.0.0.1 -unohash -ponetwothree --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -ureqssl --ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --protocol tcp --host 127.0.0.1 -ureqssl --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -ureqcipher --ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --protocol tcp --host 127.0.0.1 -ureqcipher --ssl-verify-server-cert -e "select 1" 2>&1

set global require_secure_transport=client;
--echo # trust the client without a password hash that has verified the certificate
--echo # mysql --host 127.0.0.1 -uroot --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp --host 127.0.0.1 -uroot --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -unohash -ponetwothree --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp --host 127.0.0.1 -unohash -ponetwothree --ssl-verify-server-cert -e "select 1" 2>&1
--echo # mysql --host 127.0.0.1 -ureqssl --ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp --host 127.0.0.1 -ureqssl --ssl-verify-server-cert -e "select 1" 2>&1
--echo # but not if it has not
--echo # mysql -unohash -ponetwothree --disable-ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --protocol tcp -unohash -ponetwothree --disable-ssl-verify-server-cert -e "select 1" > /dev/null 2>&1
--echo # a client with a password hash still has to prove it
--exec $mitm
--echo # mysql -unative -pfoo --disable-ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --port $MITM_PORT -unative -pfoo --disable-ssl-verify-server-cert -e "select 1" > /dev/null 2>&1
show tables like 'hijacked';
set global require_secure_transport=on;

--echo # the client does not verify the server certificate
--echo # mysql -unative -pfoo --disable-ssl-verify-server-cert -e "select 1"
--exec $MYSQL --protocol tcp -unative -pfoo --disable-ssl-verify-server-cert -e "select 1" 2>&1

--echo # not TCP
--echo # mysql --protocol socket -uroot -e "select 1"
--exec $MYSQL --protocol socket -uroot -e "select 1" 2>&1

--echo # MitM cannot use the connection
--exec $mitm
--echo # mysql -unative -pfoo --ssl-verify-server-cert -e "select 1"
--replace_regex /TLS\/SSL error.*certificate[^\n]*/TLS\/SSL error: Failed to verify the server certificate/
--error 1
--exec $MYSQL --port $MITM_PORT -unative -pfoo --ssl-verify-server-cert -e "select 1" 2>&1
show tables like 'hijacked';

--echo # MitM cannot use the connection, even if the client does not care
--exec $mitm
--echo # mysql -unative -pfoo --disable-ssl-verify-server-cert -e "select 1"
--echo # the client error depends on when MitM closes the connection
--error 1
--exec $MYSQL --port $MITM_PORT -unative -pfoo --disable-ssl-verify-server-cert -e "select 1" > /dev/null 2>&1
show tables like 'hijacked';

--let $proxy=perl lib/ssl-mitm.pl --listen-on $MITM_PORT --connect-to $MASTER_MYPORT --ssl-ca std_data/cacert.pem --ssl-key std_data/server-new-key.pem --ssl-cert std_data/server-new-cert.pem
--let $client=$MYSQL --host 127.0.0.1 --port $MITM_PORT -unative -pfoo --ssl-verify-server-cert --ssl-ca=$MYSQL_TEST_DIR/std_data/cacert.pem

--echo # a proxy that the client trusts
--exec $proxy --ssl-info-client pass
--echo # mysql --host 127.0.0.1 -unative -pfoo --ssl-verify-server-cert --ssl-ca=cacert.pem -e "select 1"
--exec $client -e "select 1" 2>&1

--echo # the proxy modifies ssl_info_client
--echo # the server closes the connection, the client error depends on timing
--let $modes=command version truncate extend corrupt
while ($modes)
{
  --let $mode=`select substring_index('$modes', ' ', 1)`
  --let $modes=`select substring('$modes', length('$mode') + 2)`
  --exec $proxy --ssl-info-client $mode
  --echo # $mode: mysql --host 127.0.0.1 -unative -pfoo --ssl-verify-server-cert --ssl-ca=cacert.pem -e "select 1"
  --error 1
  --exec $client -e "select 1" > /dev/null 2>&1
}

--echo # the proxy drops ssl_info_client, the server replies to the query
--exec $proxy --ssl-info-client drop
--echo # drop: mysql --host 127.0.0.1 -unative -pfoo --ssl-verify-server-cert --ssl-ca=cacert.pem -e "select 1"
--error 1
--exec $client -e "select 1" 2>&1

--echo # MitM, the client does not verify the server certificate
--exec $proxy --ssl-info-client pass
--echo # mysql -unative -pfoo --disable-ssl-verify-server-cert -e "select 1"
--error 1
--exec $MYSQL --port $MITM_PORT -unative -pfoo --disable-ssl-verify-server-cert -e "select 1" > /dev/null 2>&1

--echo # invalid ssl_info_client is logged
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=Invalid ssl_info_client from 'native'@'localhost': malformed
--source include/search_pattern_in_file.inc
--let SEARCH_PATTERN=Invalid ssl_info_client from 'native'@'localhost': hash mismatch
--source include/search_pattern_in_file.inc

set global require_secure_transport=off;

drop user native@'%';
drop user ed@'%';
drop user nohash@'%';
drop user multi@'%';
drop user x509@'%';
drop user x509pw@'%';
drop user issuer@'%';
drop user reqssl@'%';
drop user reqcipher@'%';
uninstall plugin ed25519;
uninstall plugin three_attempts;

--echo # End of 11.4 tests
