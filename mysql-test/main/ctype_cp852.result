#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES cp852 COLLATE cp852_general_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
Insert_priv
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
Insert_priv
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (cp852_general_ci,COERCIBLE) for operation '='
SET NAMES cp852 COLLATE cp852_bin;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (cp852_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
