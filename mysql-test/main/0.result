#
# ANY_CS character set clause on stored routine parameters
#
# ANY_CS is a MariaDB extension (not sql_mode dependent): a parameter's
# CHARACTER SET is resolved per CALL from the actual argument's charset,
# instead of being fixed at CREATE time.
#
# mysqltest defaults to a latin1 client connection; this file writes
# literal multi-byte utf8mb4 characters (section 4d), so switch first.
SET NAMES utf8mb4;
SET @save_sql_mode= @@sql_mode;
#
# Section 1: grammar acceptance / rejection
#
# 1a. Accepted on a routine parameter, default dialect
SET sql_mode= '';
CREATE PROCEDURE p_any_cs_default(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x;
END;
$$
DROP PROCEDURE p_any_cs_default;
# 1b. Accepted on a routine parameter, sql_mode=ORACLE
SET sql_mode= 'ORACLE';
CREATE PROCEDURE p_any_cs_oracle(x IN VARCHAR2(20) CHARACTER SET ANY_CS)
IS
BEGIN
SELECT x;
END;
$$
DROP PROCEDURE p_any_cs_oracle;
SET sql_mode= @save_sql_mode;
# 1c. Bare ANY_CS (no CHARACTER SET keyword) must be rejected
CREATE PROCEDURE p_bare_should_fail(IN x VARCHAR(20) ANY_CS)
BEGIN
SELECT x;
END;
$$
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'ANY_CS)
BEGIN
SELECT x;
END' at line 1
# 1d. ANY_CS must not leak into SET NAMES
SET NAMES ANY_CS;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'ANY_CS' at line 1
# 1e. ANY_CS must not leak into CONVERT(...USING...)
SELECT CONVERT('x' USING ANY_CS);
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'ANY_CS)' at line 1
#
# Section 2: restricted to routine parameters only
#
# 2a. Table column must fail
CREATE TABLE t_any_cs_should_fail (a VARCHAR(20) CHARACTER SET ANY_CS);
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
# 2b. Function RETURNS type must fail
CREATE FUNCTION f_any_cs_should_fail() RETURNS VARCHAR(20) CHARACTER SET ANY_CS
BEGIN
RETURN 'x';
END;
$$
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
# 2c. DECLARE local variable must fail
CREATE PROCEDURE p_any_cs_local_should_fail()
BEGIN
DECLARE v VARCHAR(20) CHARACTER SET ANY_CS DEFAULT NULL;
SELECT v;
END;
$$
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and non-parameter definitions
#
# Section 3: type coverage (CHAR / VARCHAR / TEXT all share
# Type_handler_longstr, so all three must work)
#
# 3a. VARCHAR parameter
CREATE PROCEDURE p_varchar_any_cs(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHARSET(x), CHAR_LENGTH(x);
END;
$$
CALL p_varchar_any_cs('hello');
x	CHARSET(x)	CHAR_LENGTH(x)
hello	utf8mb4	5
DROP PROCEDURE p_varchar_any_cs;
# 3b. CHAR parameter
CREATE PROCEDURE p_char_any_cs(IN x CHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHARSET(x), CHAR_LENGTH(x);
END;
$$
CALL p_char_any_cs('hello');
x	CHARSET(x)	CHAR_LENGTH(x)
hello	utf8mb4	5
DROP PROCEDURE p_char_any_cs;
# 3c. TEXT parameter
CREATE PROCEDURE p_text_any_cs(IN x TEXT CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHARSET(x), CHAR_LENGTH(x);
END;
$$
CALL p_text_any_cs('hello text world');
x	CHARSET(x)	CHAR_LENGTH(x)
hello text world	utf8mb4	16
DROP PROCEDURE p_text_any_cs;
#
# Section 4: CALL-time correctness (the real feature)
#
# 4a. Basic ASCII round-trip
CREATE PROCEDURE p_any_cs_test(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x;
END;
$$
CALL p_any_cs_test('hello');
x
hello
# 4b. Declared length cap (20) is still enforced -- under strict sql_mode
# an over-long argument is a hard error, same as an ordinary VARCHAR(20)
CALL p_any_cs_test('this string is definitely longer than twenty chars');
ERROR 22001: Data too long for column 'x' at row 0
# 4b-ii. Under non-strict sql_mode, the same over-long argument silently
# truncates to the declared 20-character cap instead of erroring.
# A routine runs under its OWN stored sql_mode (captured at CREATE
# time), not the caller's current one -- so re-create under non-strict.
SET @save_sql_mode_4b= @@sql_mode;
SET sql_mode= '';
CREATE PROCEDURE p_any_cs_nonstrict(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHAR_LENGTH(x);
END;
$$
CALL p_any_cs_nonstrict('this string is definitely longer than twenty chars');
x	CHAR_LENGTH(x)
this string is defin	20
Warnings:
Warning	1265	Data truncated for column 'x' at row 0
DROP PROCEDURE p_any_cs_nonstrict;
SET sql_mode= @save_sql_mode_4b;
# 4c. Repeated CALLs with different argument charsets/content must not
# "stick" to a previous call's resolution (regression test for the
# shared-Column_definition mutation bug)
CALL p_any_cs_test('hi');
x
hi
CALL p_any_cs_test('a medium string');
x
a medium string
CALL p_any_cs_test('short');
x
short
DROP PROCEDURE p_any_cs_test;
# 4d. Real multi-byte content, exact-length and over-length
CREATE PROCEDURE p_any_cs_multibyte(IN x VARCHAR(10) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHAR_LENGTH(x), CHARSET(x);
END;
$$
# exactly 10 characters (multi-byte)
CALL p_any_cs_multibyte('héllo wörl');
x	CHAR_LENGTH(x)	CHARSET(x)
héllo wörl	10	utf8mb4
# more than 10 characters (multi-byte) -- the cap is enforced in
# CHARACTERS, not bytes; under strict sql_mode this is a hard error
CALL p_any_cs_multibyte('héllo wörld, this is too long');
ERROR 22001: Data too long for column 'x' at row 0
DROP PROCEDURE p_any_cs_multibyte;
# 4e. sql_mode=ORACLE, implicit length (no size given) combined with ANY_CS
SET sql_mode= 'ORACLE';
CREATE PROCEDURE p_any_cs_implicit_length(x IN VARCHAR2 CHARACTER SET ANY_CS)
IS
BEGIN
SELECT x, CHAR_LENGTH(x), CHARSET(x);
END;
$$
CALL p_any_cs_implicit_length('a string much longer than the usual twenty character default cap');
x	CHAR_LENGTH(x)	CHARSET(x)
a string much longer than the usual twenty character default cap	64	utf8mb4
DROP PROCEDURE p_any_cs_implicit_length;
SET sql_mode= @save_sql_mode;
#
# Section 5: multiple parameters mixing fixed charsets and ANY_CS,
# IN and OUT
#
CREATE PROCEDURE p_multi_charset_test(
IN  p_latin1_in   VARCHAR(20) CHARACTER SET latin1,
OUT p_latin1_out  VARCHAR(20) CHARACTER SET latin1,
IN  p_utf8_in     VARCHAR(20) CHARACTER SET utf8mb4,
OUT p_utf8_out    VARCHAR(20) CHARACTER SET utf8mb4,
IN  p_any_cs_in   VARCHAR(20) CHARACTER SET ANY_CS,
OUT p_any_cs_out  VARCHAR(20) CHARACTER SET ANY_CS
)
BEGIN
SET p_latin1_out = p_latin1_in;
SET p_utf8_out   = p_utf8_in;
SET p_any_cs_out = p_any_cs_in;
END;
$$
SELECT PARAMETER_NAME, PARAMETER_MODE, DATA_TYPE,
CHARACTER_SET_NAME, COLLATION_NAME
FROM information_schema.parameters
WHERE SPECIFIC_SCHEMA = DATABASE() AND SPECIFIC_NAME = 'p_multi_charset_test'
ORDER BY ORDINAL_POSITION;
PARAMETER_NAME	PARAMETER_MODE	DATA_TYPE	CHARACTER_SET_NAME	COLLATION_NAME
p_latin1_in	IN	varchar	latin1	latin1_swedish_ci
p_latin1_out	OUT	varchar	latin1	latin1_swedish_ci
p_utf8_in	IN	varchar	utf8mb4	utf8mb4_uca1400_ai_ci
p_utf8_out	OUT	varchar	utf8mb4	utf8mb4_uca1400_ai_ci
p_any_cs_in	IN	varchar		
p_any_cs_out	OUT	varchar		
CALL p_multi_charset_test('one', @lo, 'two', @uo, 'three', @ao);
SELECT @lo, @uo, @ao;
@lo	@uo	@ao
one	two	three
DROP PROCEDURE p_multi_charset_test;
#
# Section 6: OUT parameter declared as ANY_CS. The charset is resolved
# from the caller's OUT-argument variable, not from anything written
# inside the routine body. This was verified against real Oracle
# (PL/SQL) behavior: a fixed OUT ANY_CS procedure body, called with
# host variables of two different charsets, returns the value encoded
# in whichever charset the actual argument had -- e.g.
#   VARCHAR2 actual  -> result CharacterSet=AL32UTF8
#   NVARCHAR2 actual -> result CharacterSet=AL16UTF16
# confirming MariaDB's implementation matches Oracle's design, not
# merely an implementation artifact.
#
# 6a. Basic OUT ANY_CS usage: passthrough from an IN argument, into a
# fresh (never previously set) caller variable
CREATE PROCEDURE p_out_any_cs(IN x VARCHAR(20) CHARACTER SET utf8mb4, OUT y VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SET y = x;
END;
$$
CALL p_out_any_cs('hello', @out1);
SELECT @out1, COLLATION(@out1);
@out1	COLLATION(@out1)
hello	binary
DROP PROCEDURE p_out_any_cs;
# 6b. The Oracle-equivalent experiment: a FIXED procedure body (the
# same literal assignment every time) called with OUT-argument
# variables pre-seeded in two different charsets. The resulting
# charset must track the caller's variable, not the body.
CREATE PROCEDURE p_out_any_cs_fixed(OUT y VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SET y = 'hello';
END;
$$
SET @out_latin1= _latin1'seed';
SET @out_utf8mb4= _utf8mb4'seed';
CALL p_out_any_cs_fixed(@out_latin1);
CALL p_out_any_cs_fixed(@out_utf8mb4);
SELECT @out_latin1, COLLATION(@out_latin1), @out_utf8mb4, COLLATION(@out_utf8mb4);
@out_latin1	COLLATION(@out_latin1)	@out_utf8mb4	COLLATION(@out_utf8mb4)
hello	latin1_swedish_ci	hello	utf8mb4_uca1400_ai_ci
DROP PROCEDURE p_out_any_cs_fixed;
# 6c. Edge case: OUT ANY_CS argument variable that was never
# previously set (no prior charset to inherit) -- documents what
# charset a fresh user variable resolves to
CREATE PROCEDURE p_out_any_cs_unset(OUT y VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SET y = 'hello';
END;
$$
CALL p_out_any_cs_unset(@out_unset);
SELECT @out_unset, COLLATION(@out_unset);
@out_unset	COLLATION(@out_unset)
hello	binary
DROP PROCEDURE p_out_any_cs_unset;
#
# Section 7: remaining verification -- body-level expression use,
# a real table INSERT, cache-reload from mysql.proc via a fresh
# connection, ALTER PROCEDURE, and CREATE OR REPLACE PROCEDURE
#
# 7a. Comparing two ANY_CS locals to each other, including across
# two genuinely different explicit charset introducers
CREATE PROCEDURE p_cmp_any_cs(IN x VARCHAR(20) CHARACTER SET ANY_CS, IN y VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
IF x = y THEN
SELECT 'equal';
ELSE
SELECT 'not equal';
END IF;
END;
$$
CALL p_cmp_any_cs('hello', 'hello');
equal
equal
CALL p_cmp_any_cs(_latin1'hello', _utf8mb4'hello');
equal
equal
DROP PROCEDURE p_cmp_any_cs;
# 7b. An ANY_CS local's value flowing into a real table column
CREATE TABLE t_any_cs_insert_target (c VARCHAR(20) CHARACTER SET utf8mb4);
CREATE PROCEDURE p_insert_any_cs(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
INSERT INTO t_any_cs_insert_target (c) VALUES (x);
END;
$$
CALL p_insert_any_cs('hello');
SELECT * FROM t_any_cs_insert_target;
c
hello
DROP PROCEDURE p_insert_any_cs;
DROP TABLE t_any_cs_insert_target;
# 7c. Cache-reload path: a fresh connection has an empty sp_cache,
# forcing db_load_routine() to re-parse the routine's stored
# param_list/body text from mysql.proc from scratch
CREATE PROCEDURE p_reload_any_cs(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHARSET(x), CHAR_LENGTH(x);
END;
$$
CALL p_reload_any_cs('first call');
x	CHARSET(x)	CHAR_LENGTH(x)
first call	utf8mb4	10
connect  any_cs_con2, localhost, root,,test;
connection any_cs_con2;
CALL p_reload_any_cs('second call');
x	CHARSET(x)	CHAR_LENGTH(x)
second call	latin1	11
disconnect any_cs_con2;
connection default;
# 7d. ALTER PROCEDURE (characteristic-only change) must not disturb
# subsequent CALLs
ALTER PROCEDURE p_reload_any_cs COMMENT 'updated comment';
CALL p_reload_any_cs('after alter');
x	CHARSET(x)	CHAR_LENGTH(x)
after alter	utf8mb4	11
# 7e. CREATE OR REPLACE PROCEDURE forces a full re-parse; the new
# declared length must take effect correctly
CREATE OR REPLACE PROCEDURE p_reload_any_cs(IN x VARCHAR(30) CHARACTER SET ANY_CS)
BEGIN
SELECT x, CHARSET(x), CHAR_LENGTH(x);
END;
$$
CALL p_reload_any_cs('after replace');
x	CHARSET(x)	CHAR_LENGTH(x)
after replace	utf8mb4	13
DROP PROCEDURE p_reload_any_cs;
#
# Section 8: DEFAULT expressions on ANY_CS parameters -- when no
# argument is passed for a defaulted parameter at all, its charset
# must be resolved from the DEFAULT expression itself, since there is
# no caller argument to derive it from
#
# 8a. Called with no argument at all, and with an explicit one, on
# the same routine
CREATE FUNCTION f_any_cs_default(a VARCHAR(20) CHARACTER SET ANY_CS DEFAULT 'fallback')
RETURNS VARCHAR(50)
BEGIN
RETURN CONCAT(CHARSET(a), ':', a);
END;
$$
SELECT f_any_cs_default();
f_any_cs_default()
utf8mb4:fallback
SELECT f_any_cs_default('explicit');
f_any_cs_default('explicit')
utf8mb4:explicit
DROP FUNCTION f_any_cs_default;
# 8b. The exact scenario that originally crashed: a non-string
# DEFAULT expression (RAND()), function called with no argument
CREATE FUNCTION f_any_cs_default_rand(a VARCHAR(20) CHARACTER SET ANY_CS DEFAULT RAND())
RETURNS INT
BEGIN
RETURN 1;
END;
$$
SELECT f_any_cs_default_rand();
f_any_cs_default_rand()
1
SELECT f_any_cs_default_rand('explicit');
f_any_cs_default_rand('explicit')
1
DROP FUNCTION f_any_cs_default_rand;
# 8c. Regression test for the bug found while building this: a
# routine with a defaulted ANY_CS parameter that ALSO declares a
# local variable in its body. Row_definition_list mixes parameters
# and locals together, so resolving a defaulted parameter's charset
# must not mistake a local variable for one (this crashed on MTR's
# own check_warnings procedure, which has exactly this shape)
CREATE PROCEDURE p_any_cs_default_with_local(IN a VARCHAR(20) CHARACTER SET ANY_CS DEFAULT 'fallback')
BEGIN
DECLARE local_var INT DEFAULT 0;
SET local_var = 1;
SELECT a, CHARSET(a), local_var;
END;
$$
CALL p_any_cs_default_with_local();
a	CHARSET(a)	local_var
fallback	utf8mb4	1
CALL p_any_cs_default_with_local('explicit');
a	CHARSET(a)	local_var
explicit	utf8mb4	1
DROP PROCEDURE p_any_cs_default_with_local;
# 8d. Multiple parameters, mixed -- some with DEFAULT, some without,
# called supplying progressively more of the trailing defaulted ones
CREATE PROCEDURE p_any_cs_mixed_defaults(
IN a VARCHAR(20) CHARACTER SET utf8mb4,
IN b VARCHAR(20) CHARACTER SET ANY_CS DEFAULT 'b_default',
IN c VARCHAR(20) CHARACTER SET ANY_CS DEFAULT 'c_default'
)
BEGIN
SELECT a, b, CHARSET(b), c, CHARSET(c);
END;
$$
CALL p_any_cs_mixed_defaults('a_value');
a	b	CHARSET(b)	c	CHARSET(c)
a_value	b_default	utf8mb4	c_default	utf8mb4
CALL p_any_cs_mixed_defaults('a_value', 'b_value');
a	b	CHARSET(b)	c	CHARSET(c)
a_value	b_value	utf8mb4	c_default	utf8mb4
CALL p_any_cs_mixed_defaults('a_value', 'b_value', 'c_value');
a	b	CHARSET(b)	c	CHARSET(c)
a_value	b_value	utf8mb4	c_value	utf8mb4
DROP PROCEDURE p_any_cs_mixed_defaults;
# 8e. All three tricky interactions stacked at once: sql_mode=ORACLE
# implicit length (no size given) + DEFAULT + ANY_CS, called with no
# argument at all. The default has no real declared cap to respect
# (same as the plain implicit-length case), so it must come through
# un-truncated even though it is far longer than the usual 20-char cap
SET sql_mode= 'ORACLE';
CREATE PROCEDURE p_implicit_default_any_cs(x IN VARCHAR2 CHARACTER SET ANY_CS DEFAULT 'a string longer than the usual twenty character cap')
IS
BEGIN
SELECT x, CHAR_LENGTH(x), CHARSET(x);
END;
$$
CALL p_implicit_default_any_cs();
x	CHAR_LENGTH(x)	CHARSET(x)
a string longer than the usual twenty character cap	51	utf8mb4
CALL p_implicit_default_any_cs('explicit');
x	CHAR_LENGTH(x)	CHARSET(x)
explicit	8	utf8mb4
DROP PROCEDURE p_implicit_default_any_cs;
SET sql_mode= @save_sql_mode;
#
# Section 9: ANY_CS charset resolution across different kinds of
# actual arguments (not just literals). The charset must be read
# from the argument only after it has gone through fix_fields(),
# otherwise argument classes whose type/collation is only known at
# evaluation time (a session user variable, a trigger column, a
# table subquery) silently resolve to binary instead of their real
# charset. Item_param (prepared statement placeholders) is excluded
# here: it has no charset of its own until a value is bound to it,
# and is expected to be rejected outright, not resolved.
#
# 9a. Session user variable, IN and INOUT (OUT is covered in
# Section 6)
CREATE PROCEDURE p_9a_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9a_inout(INOUT x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
SET @v_latin1= _latin1'test';
SET @v_utf8mb4= _utf8mb4'test';
CALL p_9a_in(@v_latin1);
x	COLLATION(x)
test	latin1_swedish_ci
CALL p_9a_in(@v_utf8mb4);
x	COLLATION(x)
test	utf8mb4_uca1400_ai_ci
CALL p_9a_inout(@v_latin1);
x	COLLATION(x)
test	latin1_swedish_ci
SELECT @v_latin1, COLLATION(@v_latin1);
@v_latin1	COLLATION(@v_latin1)
test	latin1_swedish_ci
DROP PROCEDURE p_9a_in;
DROP PROCEDURE p_9a_inout;
# 9b. SP-local variable with a declared charset, IN / OUT / INOUT,
# passed from a wrapper procedure into an inner one
CREATE PROCEDURE p_9b_inner_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9b_inner_out(OUT x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SET x = 'hello';
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9b_inner_inout(INOUT x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9b_wrapper()
BEGIN
DECLARE v_latin1 VARCHAR(20) CHARACTER SET latin1 DEFAULT 'test';
DECLARE v_utf8mb4 VARCHAR(20) CHARACTER SET utf8mb4 DEFAULT 'test';
DECLARE v_out VARCHAR(20) CHARACTER SET latin1;
CALL p_9b_inner_in(v_latin1);
CALL p_9b_inner_in(v_utf8mb4);
CALL p_9b_inner_out(v_out);
SELECT v_out, COLLATION(v_out);
CALL p_9b_inner_inout(v_latin1);
SELECT v_latin1, COLLATION(v_latin1);
END;
$$
CALL p_9b_wrapper();
x	COLLATION(x)
test	latin1_swedish_ci
x	COLLATION(x)
test	utf8mb4_uca1400_ai_ci
x	COLLATION(x)
hello	latin1_swedish_ci
v_out	COLLATION(v_out)
hello	latin1_swedish_ci
x	COLLATION(x)
test	latin1_swedish_ci
v_latin1	COLLATION(v_latin1)
test	latin1_swedish_ci
DROP PROCEDURE p_9b_inner_in;
DROP PROCEDURE p_9b_inner_out;
DROP PROCEDURE p_9b_inner_inout;
DROP PROCEDURE p_9b_wrapper;
# 9c. TYPE OF anchored SP-local variable (data type/charset resolved
# at rcontext-creation time rather than at DECLARE time) -- rejected
# for ANY_CS regardless of mode, matching Oracle's own restriction on
# %TYPE-declared variables combined with ANY_CS
CREATE TABLE t_9c (col1 VARCHAR(20) CHARACTER SET latin1);
CREATE PROCEDURE p_9c_inner_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9c_wrapper()
BEGIN
DECLARE v1 TYPE OF t_9c.col1 DEFAULT 'test';
CALL p_9c_inner_in(v1);
END;
$$
CALL p_9c_wrapper();
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and this kind of argument
DROP PROCEDURE p_9c_inner_in;
DROP PROCEDURE p_9c_wrapper;
DROP TABLE t_9c;
# 9d. Trigger NEW.col / OLD.col passed into an ANY_CS parameter
CREATE TABLE t_9d (id INT, col_latin1 VARCHAR(20) CHARACTER SET latin1, col_utf8mb4 VARCHAR(20) CHARACTER SET utf8mb4);
CREATE TABLE t_9d_log (id INT AUTO_INCREMENT PRIMARY KEY, msg VARCHAR(100), coll VARCHAR(64));
CREATE PROCEDURE p_9d_log(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
INSERT INTO t_9d_log(msg, coll) VALUES (x, COLLATION(x));
END;
$$
CREATE TRIGGER trg_9d_ins BEFORE INSERT ON t_9d FOR EACH ROW
BEGIN
CALL p_9d_log(NEW.col_latin1);
CALL p_9d_log(NEW.col_utf8mb4);
END;
$$
INSERT INTO t_9d VALUES (1, 'test', 'test');
SELECT msg, coll FROM t_9d_log ORDER BY id;
msg	coll
test	latin1_swedish_ci
test	utf8mb4_uca1400_ai_ci
DROP TRIGGER trg_9d_ins;
DROP PROCEDURE p_9d_log;
DROP TABLE t_9d;
DROP TABLE t_9d_log;
# 9e. Table column read via a scalar subquery, no intermediate
# variable at all (IN only -- not assignable, so OUT/INOUT do not
# apply)
CREATE TABLE t_9e (id INT PRIMARY KEY, col_latin1 VARCHAR(20) CHARACTER SET latin1, col_utf8mb4 VARCHAR(20) CHARACTER SET utf8mb4);
INSERT INTO t_9e VALUES (1, 'test', 'test');
CREATE PROCEDURE p_9e_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CALL p_9e_in((SELECT col_latin1 FROM t_9e WHERE id = 1));
x	COLLATION(x)
test	latin1_swedish_ci
CALL p_9e_in((SELECT col_utf8mb4 FROM t_9e WHERE id = 1));
x	COLLATION(x)
test	utf8mb4_uca1400_ai_ci
DROP PROCEDURE p_9e_in;
DROP TABLE t_9e;
# 9f. Prepared-statement placeholder (Item_param) -- rejected for
# ANY_CS regardless of mode: it has no charset of its own until a
# value is bound to it at EXECUTE time
CREATE PROCEDURE p_9f_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9f_out(OUT x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SET x = 'hello';
END;
$$
PREPARE stmt_9f_in FROM 'CALL p_9f_in(?)';
SET @p_latin1= _latin1'test';
EXECUTE stmt_9f_in USING @p_latin1;
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and this kind of argument
DEALLOCATE PREPARE stmt_9f_in;
PREPARE stmt_9f_out FROM 'CALL p_9f_out(?)';
EXECUTE stmt_9f_out USING @p_out;
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and this kind of argument
DEALLOCATE PREPARE stmt_9f_out;
DROP PROCEDURE p_9f_in;
DROP PROCEDURE p_9f_out;
# 9g. Row-field access by name on a ROW TYPE OF variable
# (Item_splocal_row_field_by_name) -- rejected for ANY_CS, since the
# field is not resolved until fix_fields() time, same reasoning as
# the TYPE OF delayed-type case in 9c
CREATE TABLE t_9g (col1 VARCHAR(20) CHARACTER SET latin1, col2 INT);
CREATE PROCEDURE p_9g_inner_in(IN x VARCHAR(20) CHARACTER SET ANY_CS)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9g_wrapper()
BEGIN
DECLARE r ROW TYPE OF t_9g DEFAULT ROW ('test', 0);
CALL p_9g_inner_in(r.col1);
END;
$$
CALL p_9g_wrapper();
ERROR HY000: Incorrect usage of CHARACTER SET ANY_CS and this kind of argument
DROP PROCEDURE p_9g_inner_in;
DROP PROCEDURE p_9g_wrapper;
DROP TABLE t_9g;
# 9h. DEFAULT expression that is not a self-typed literal (a session
# variable), for a parameter whose actual argument is omitted at
# CALL time. Exercises the same fix_fields()-before-charset-read
# requirement as 9a, but for the DEFAULT-value path rather than the
# actual-argument path (procedure, List<Item>* overload)
SET @default_src_latin1= _latin1'from_default';
SET @default_src_utf8mb4= _utf8mb4'from_default';
CREATE PROCEDURE p_9h_default_var(IN x VARCHAR(30) CHARACTER SET ANY_CS DEFAULT @default_src_latin1)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CREATE PROCEDURE p_9h_default_var2(IN x VARCHAR(30) CHARACTER SET ANY_CS DEFAULT @default_src_utf8mb4)
BEGIN
SELECT x, COLLATION(x);
END;
$$
CALL p_9h_default_var();
x	COLLATION(x)
from_default	latin1_swedish_ci
CALL p_9h_default_var2();
x	COLLATION(x)
from_default	utf8mb4_uca1400_ai_ci
DROP PROCEDURE p_9h_default_var;
DROP PROCEDURE p_9h_default_var2;
# 9i. Same as 9h, but for a FUNCTION (Item **args, uint arg_count
# overload), to cover the second overload of
# adjust_formal_params_to_actual_params as well
CREATE FUNCTION f_9i_default_var(x VARCHAR(30) CHARACTER SET ANY_CS DEFAULT @default_src_latin1) RETURNS VARCHAR(64) CHARACTER SET utf8mb4
BEGIN
RETURN CONCAT(x, ':', COLLATION(x));
END;
$$
SELECT f_9i_default_var();
f_9i_default_var()
from_default:latin1_swedish_ci
DROP FUNCTION f_9i_default_var;
