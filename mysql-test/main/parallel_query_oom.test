#
# Test OOM handling in the parallel worker error/warning queue.
#

-- source include/count_sessions.inc
-- source include/have_innodb.inc
-- source include/not_embedded.inc
-- source include/have_sequence.inc
-- source include/have_debug.inc

--disable_service_connection

--echo #
--echo # MDEV-39492 Parallel Query: OOM in worker error_to_queue surfaces a
--echo # single ER_OUTOFMEMORY warning so worker diagnostics aren't silently
--echo # lost.
--echo #

set @save_dbug=@@global.debug_dbug;
set global debug_dbug="+d,pwt_error_to_queue_oom";
set session parallel_worker_threads=4;

--echo # The prototype worker emits either a warning or my_error() depending on the
--echo # parity of its thread id. Either path runs through error_to_queue; the
--echo # DBUG injection forces both into the OOM branch, so neither the original
--echo # warning nor the original error reaches the user. We expect just the
--echo # manager-surfaced ER_OUTOFMEMORY warnings.
--echo #
--echo # Four workers rather than one: fewer than PARALLEL_QUERY_MIN_WORKERS are
--echo # declined and run serially, and then no worker reaches the injection at
--echo # all. Asking for one used to work and quietly stopped testing anything.
create table t1 (a int) engine=innodb;
# The table needs more leaf pages than one: the engine divides a table by
# its B-tree and declines a table it cannot divide, so a two-row table runs
# serially and no worker reaches the injected failure. The WHERE keeps the
# output small; the whole table is still scanned.
insert into t1 select seq from seq_1_to_2000;
select * from t1 where a > 1999;
show warnings;
drop table t1;

set global debug_dbug=@save_dbug;

--echo #
--echo # A worker team that fails to start part-way through is torn down, and
--echo # the statement fails rather than falling back. This is the only path to
--echo # abort_worker(), which awakes each already-running worker under
--echo # LOCK_worker while that worker may be exiting and destroying its own
--echo # THD -- so it is also the only coverage for that hand-off.
--echo #
create table t1 (a int) engine=innodb;
insert into t1 select seq from seq_1_to_2000;

set global debug_dbug="+d,pwt_init_fail_last_worker";

--echo # workers already running are blocked handing off a full batch
set session parallel_worker_threads=4;
--error ER_INTERNAL_ERROR
select * from t1;

--echo # and again where they have little to do and may be exiting already
--error ER_INTERNAL_ERROR
select * from t1 where a > 1999;

--echo # more workers, more of them to abort
set session parallel_worker_threads=8;
--error ER_INTERNAL_ERROR
select * from t1 where a > 1999;

--echo #
--echo # Failing the FIRST worker instead leaves every later one untouched, so
--echo # the teardown walks workers whose setup never started. Each one knows
--echo # what it holds, so those are left alone rather than joined or freed.
--echo #
set global debug_dbug="+d,pwt_init_fail_first_worker";

set session parallel_worker_threads=4;
--error ER_INTERNAL_ERROR
select * from t1;

--error ER_INTERNAL_ERROR
select * from t1 where a > 1999;

set session parallel_worker_threads=8;
--error ER_INTERNAL_ERROR
select * from t1 where a > 1999;

set global debug_dbug=@save_dbug;

--echo # the server is unharmed and the query runs in the workers as before
select * from t1 where a > 1999;
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers
--enable_query_log

drop table t1;
set session parallel_worker_threads=default;

--source include/wait_until_count_sessions.inc
