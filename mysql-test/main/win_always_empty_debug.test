--source include/have_debug.inc

--echo #
--echo # MDEV-10838: Skip filesort for window functions with always-empty frames
--echo #

CREATE TABLE t (a INT);
INSERT INTO t VALUES (1), (2), (3), (4), (5);

SET @saved_dbug = @@SESSION.debug_dbug;

--echo # When all window frames are always-empty, exec_always_empty() is taken
--echo # and the filesort slow path must not be reached.
SET debug_dbug='+d,win_always_empty_slow_path';
SELECT SUM(a) OVER (ORDER BY a ROWS BETWEEN 2 PRECEDING AND 3 PRECEDING) AS w FROM t;
SET debug_dbug=@saved_dbug;

DROP TABLE t;
