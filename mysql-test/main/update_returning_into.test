--echo #
--echo # MDEV-41262 ER_TOO_MANY_ROWS should be checked after CHECK OPTION in view while Update Returning Into
--echo #

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(10);
CREATE VIEW v1 AS SELECT * FROM t1 WHERE a < 100 WITH CHECK OPTION;
--error ER_VIEW_CHECK_FAILED
UPDATE v1 SET a=IF(a=1,2,1000) RETURNING a INTO @a;
SELECT @a;
SELECT * FROM t1;
DROP VIEW v1;
DROP TABLE t1;

--echo #
--echo # MDEV-41265 SELECT/ UPDATE RETURNING INTO a single row-field fails with ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT, even though the column count matches
--echo #

--echo # One scalar column into one field of an explicit ROW variable

CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE r0 ROW (a INT, b VARCHAR(10));
  UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
  SELECT r0.a;
END;
$$
CREATE PROCEDURE p2()
BEGIN
  DECLARE r0 ROW (a INT, b VARCHAR(10));
  UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
END;
$$
DELIMITER ;$$
CALL p1;
--error ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT
CALL p2;
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;

--echo # One scalar column into one field of a `ROW TYPE OF table1` variable

CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE r0 ROW TYPE OF t1;
  UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
  SELECT r0.a;
END;
$$
CREATE PROCEDURE p2()
BEGIN
  DECLARE r0 ROW TYPE OF t1;
  UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
END;
$$
DELIMITER ;$$
CALL p1;
--error ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT
CALL p2;
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;

--echo # One scalar column into one field of a `ROW TYPE OF cursor1` variable

CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (1,'b1');
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE c1 CURSOR FOR SELECT * FROM t1;
  BEGIN
    DECLARE r0 ROW TYPE OF c1;
    UPDATE t1 SET a=a+1 RETURNING a INTO r0.a;
    SELECT r0.a;
  END;
END;
$$
CREATE PROCEDURE p2()
BEGIN
  DECLARE c1 CURSOR FOR SELECT * FROM t1;
  BEGIN
    DECLARE r0 ROW TYPE OF c1;
    UPDATE t1 SET a=a+1 RETURNING a,b INTO r0.a;
  END;
END;
$$
DELIMITER ;$$
CALL p1;
--error ER_WRONG_NUMBER_OF_COLUMNS_IN_SELECT
CALL p2;
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;

--echo #
--echo # UPDATE..RETURNING..INTO in a trigger
--echo # UPDATE..RETURNING without INTO returns a result set, so it is not
--echo # allowed in triggers (see update_returning.test).
--echo # With INTO it does not return a result set.
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, c INT);
INSERT INTO t1 VALUES (1,10),(2,20),(2,21);
DELIMITER $$;
CREATE TRIGGER t2_bi BEFORE INSERT ON t2 FOR EACH ROW
BEGIN
  DECLARE v INT;
  UPDATE t1 SET b=b+1 WHERE a=NEW.a RETURNING b INTO v;
  SET NEW.c= v;
END;
$$
DELIMITER ;$$

--echo # One row
INSERT INTO t2 (a) VALUES (1);
SELECT * FROM t2;
SELECT * FROM t1;

--echo # No rows: a warning, the variable is not changed
INSERT INTO t2 (a) VALUES (99);
SELECT * FROM t2;

--echo # Two rows: ER_TOO_MANY_ROWS, the row is not inserted
--error ER_TOO_MANY_ROWS
INSERT INTO t2 (a) VALUES (2);
SELECT * FROM t2;
DROP TRIGGER t2_bi;

--echo # No rows with a NOT FOUND handler
DELIMITER $$;
CREATE TRIGGER t2_bi BEFORE INSERT ON t2 FOR EACH ROW
BEGIN
  DECLARE v INT DEFAULT -1;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET NEW.c= -2;
  UPDATE t1 SET b=b+1 WHERE a=NEW.a RETURNING b INTO v;
END;
$$
DELIMITER ;$$
INSERT INTO t2 (a) VALUES (99);
SELECT * FROM t2 WHERE a=99;
DROP TRIGGER t2_bi;

DROP TABLE t1, t2;

--echo # End of 13.1 tests
