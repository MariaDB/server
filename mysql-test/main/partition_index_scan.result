SELECT MIN(c) FROM t1 WHERE b=1 AND c>5;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Select tables optimized away
FLUSH STATUS;
SELECT MIN(c) FROM t1 WHERE b=1 AND c>5;
MIN(c)
15
