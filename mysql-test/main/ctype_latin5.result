#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES latin5 COLLATE latin5_turkish_ci;
# ASCII digits
d
1
# ASCII minus, dot and digits
e
-1.5
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '='
SELECT c FROM v_tailoring WHERE c<>'Y_';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '<>'
SELECT c FROM v_tailoring WHERE c<>'Y+';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_turkish_ci,COERCIBLE) for operation '<>'
SET NAMES latin5 COLLATE latin5_bin;
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (latin5_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
#
# MDEV-41246 LOWER() and UPPER() can convert ASCII letters to
# non-ASCII ones in Turkish collations (I -> dotless i, i -> dotted I),
# so their results are not ASCII-only and are converted to latin5
# when mixed with a latin1 string, rather than the other way round.
#
SET NAMES latin5 COLLATE latin5_turkish_ci;
SELECT HEX(LOWER('I')), LOWER('I') = _latin1'i';
HEX(LOWER('I'))	LOWER('I') = _latin1'i'
FD	0
SELECT HEX(UPPER('i')), UPPER('i') = _latin1'I';
HEX(UPPER('i'))	UPPER('i') = _latin1'I'
DD	0
SELECT _latin1'i' = LOWER('I');
_latin1'i' = LOWER('I')
0
SET NAMES DEFAULT;
# End of 11.8 tests
