--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_embedded.inc

--echo # MDEV-39146
--echo # Crash: processlist_callback() dereferences a stale Security_context,
--echo # racing a SQL SECURITY DEFINER switch -- for events, one that is
--echo # stack-allocated in Event_job_data::execute().
--echo # DEBUG_SYNC forces the race: an event pauses mid DEFINER switch; a
--echo # concurrent processlist scan captures its security_ctx pointer, then
--echo # pauses before dereferencing it; the event is let finish (freeing its
--echo # stack frame); only then is the scanner let dereference the pointer --
--echo # a stack-use-after-return. Verified with ASan's
--echo # detect_stack_use_after_return during development; pass/fail doesn't
--echo # depend on that option.

--source include/count_sessions.inc

CREATE DATABASE mdev39146;

CREATE USER mdev39146_definer@localhost;
GRANT EVENT ON mdev39146.* TO mdev39146_definer@localhost;
GRANT SUPER ON *.* TO mdev39146_definer@localhost;

SET DEBUG_SYNC= 'RESET';

--echo # Per-session DEBUG_SYNC: must arm from inside the event body (its own
--echo # thd), not from another connection.
--delimiter |
CREATE DEFINER=mdev39146_definer@localhost EVENT mdev39146.ev
ON SCHEDULE AT CURRENT_TIMESTAMP
DO
BEGIN
  SET DEBUG_SYNC= 'event_worker_thread_after_execute_returned SIGNAL event_execute_returned';
  SET DEBUG_SYNC= 'now SIGNAL definer_ctx_active WAIT_FOR event_may_finish';
END|
--delimiter ;

SET GLOBAL event_scheduler= ON;

--echo # Connect 'waiter' now: iterate() holds server_threads' rwlock for the
--echo # whole scan; connecting after would deadlock (needs that lock's
--echo # write side).
connect (waiter, localhost, root,,);
connection default;

SET DEBUG_SYNC= 'now WAIT_FOR definer_ctx_active';

--echo # Pause right after processlist_callback() captures the
--echo # DEFINER-switched security_ctx, before USER/HOST are read.
SET @saved_dbug= @@SESSION.debug_dbug;
SET SESSION debug_dbug= '+d,processlist_callback_pause_after_sctx_capture';
SET DEBUG_SYNC= 'processlist_callback_captured_sctx SIGNAL scanner_captured WAIT_FOR let_scanner_continue';

--echo # Filter by name, not row count -- asserts the corrupted value itself
--echo # comes back correct.
--send SELECT user, host FROM information_schema.processlist WHERE user = 'mdev39146_definer'

connection waiter;
SET DEBUG_SYNC= 'now WAIT_FOR scanner_captured';

--echo # Wait (short timeout) for execute() to actually return -- only then
--echo # is its stack frame (and DEFINER Security_context) gone for good.
--echo # Timeout expected: restore_security_context() needs LOCK_thd_data,
--echo # held by the paused scanner until released below.
SET DEBUG_SYNC= 'now SIGNAL event_may_finish WAIT_FOR event_execute_returned TIMEOUT 5';

--echo # Release the scanner to dereference the pointer -- still valid: the
--echo # event is still blocked on LOCK_thd_data here.
SET DEBUG_SYNC= 'now SIGNAL let_scanner_continue';

--disconnect waiter
--connection default
--reap

--source include/wait_until_count_sessions.inc

SET SESSION debug_dbug= @saved_dbug;
SET DEBUG_SYNC= 'RESET';

--echo # One-shot event (ON COMPLETION NOT PRESERVE, the default); already
--echo # dropped itself after running.
SET GLOBAL event_scheduler= OFF;

--echo # Basic coverage for list_callback() (legacy SHOW PROCESSLIST), same
--echo # restructuring -- not the race above, just confirms correct output
--echo # for a DEFINER-switched thread.
let $wait_condition= select count(*) = 0 from information_schema.processlist
  where db = 'mdev39146';
--source include/wait_condition.inc
CREATE DEFINER=mdev39146_definer@localhost EVENT mdev39146.ev2
ON SCHEDULE AT CURRENT_TIMESTAMP
DO
  SET DEBUG_SYNC= 'now SIGNAL ev2_active WAIT_FOR ev2_may_finish';
SET GLOBAL event_scheduler= ON;
SET DEBUG_SYNC= 'now WAIT_FOR ev2_active';
--disable_ps_protocol
--replace_column 1 <ID> 6 <TIME> 7 <STATE> 8 <INFO> 9 <PROGRESS>
--replace_regex /:[0-9]+//
SHOW PROCESSLIST;
--enable_ps_protocol
SET DEBUG_SYNC= 'now SIGNAL ev2_may_finish';

--echo # Wait for ev2 to finish before teardown -- event_scheduler=OFF isn't
--echo # documented to wait for in-flight workers.
let $wait_condition= select count(*) = 0 from information_schema.processlist
  where db = 'mdev39146';
--source include/wait_condition.inc

SET GLOBAL event_scheduler= OFF;
SET DEBUG_SYNC= 'RESET';

--echo # COM_CHANGE_USER's failed-auth free()+restore runs under
--echo # LOCK_thd_data; a concurrent PROCESSLIST read that loses the trylock
--echo # must fall back to priv_user/priv_host, not crash on the freed
--echo # pointer.
CREATE USER mdev39146_victim@localhost;
GRANT SUPER ON *.* TO mdev39146_victim@localhost;
connect (victim, localhost, mdev39146_victim,,);
connect (reader, localhost, root,,);

connection victim;
let $victim_id= `SELECT CONNECTION_ID()`;

connection reader;
SET @victim_user= 'mdev39146_victim';
SET SESSION debug_dbug= '+d,processlist_callback_pause_before_trylock_named_user';
SET DEBUG_SYNC= 'processlist_callback_before_trylock_named_user WAIT_FOR victim_locked';
--echo # Async: parks inside the scan, at victim's row, until victim holds
--echo # its own LOCK_thd_data below.
--replace_result $victim_id VICTIM_ID
--send_eval SELECT user, host FROM information_schema.processlist WHERE id = $victim_id

connection victim;
--echo # Force acl_authenticate() to fail so free()+restore runs.
--echo # LOCK_thd_data is held for the whole pause; wait auto-releases on
--echo # timeout, so no external signal needed.
SET DEBUG_SYNC= 'com_change_user_after_free_before_restore SIGNAL victim_locked WAIT_FOR com_change_user_test_never_signaled TIMEOUT 10';
--error ER_ACCESS_DENIED_ERROR
change_user bogus,bogus;

connection reader;
--echo # Reaps the contended read: fallback to priv_user/priv_host.
--echo # acl_authenticate() copies the attempted username ("bogus") into
--echo # priv_user before validating -- that's what the fallback shows, not
--echo # the pre-attempt identity. Point: a safe snapshot, not the freed
--echo # pointer.
--reap

disconnect victim;
disconnect reader;
connection default;
DROP USER mdev39146_victim@localhost;
SET DEBUG_SYNC= 'RESET';

--echo # On contention, thd_visible_in_processlist() answers "not visible"
--echo # outright (fail-closed) instead of matching against
--echo # main_security_ctx -- so an event worker is briefly hidden from its
--echo # own definer, while an uncontended scan of the SAME row (still the
--echo # real DEFINER identity) sees it fine.
CREATE USER mdev39146_definer4@localhost;
GRANT EVENT ON mdev39146.* TO mdev39146_definer4@localhost;
GRANT SUPER ON *.* TO mdev39146_definer4@localhost;
connect (definer4, localhost, mdev39146_definer4,,);
connection default;

--delimiter |
CREATE DEFINER=mdev39146_definer4@localhost EVENT mdev39146.ev4
ON SCHEDULE AT CURRENT_TIMESTAMP
DO
BEGIN
  SET DEBUG_SYNC= 'now SIGNAL ev4_definer_active WAIT_FOR ev4_uncontended_done';
  SET SESSION debug_dbug= '+d,event_worker_thread_hold_lock_before_restore';
  SET DEBUG_SYNC= 'event_worker_thread_holding_lock_before_restore SIGNAL ev4_holding_lock WAIT_FOR let_ev4_go TIMEOUT 10';
END|
--delimiter ;
SET GLOBAL event_scheduler= ON;

connection definer4;
SET DEBUG_SYNC= 'now WAIT_FOR ev4_definer_active';
--echo # Uncontended: real DEFINER identity, so visible. (excludes own id --
--echo # that row is always self-visible.)
SELECT user, host FROM information_schema.processlist
  WHERE user = 'mdev39146_definer4' AND id <> connection_id();
SET DEBUG_SYNC= 'now SIGNAL ev4_uncontended_done WAIT_FOR ev4_holding_lock';
--echo # Contended: worker now holds its own LOCK_thd_data, so the scan
--echo # can't verify identity and answers not visible (fail-closed).
SELECT user, host FROM information_schema.processlist
  WHERE user = 'mdev39146_definer4' AND id <> connection_id();
SET DEBUG_SYNC= 'now SIGNAL let_ev4_go';

connection default;
let $wait_condition= select count(*) = 0 from information_schema.processlist
  where db = 'mdev39146';
--source include/wait_condition.inc
SET GLOBAL event_scheduler= OFF;
SET DEBUG_SYNC= 'RESET';

disconnect definer4;
connection default;
DROP USER mdev39146_definer4@localhost;

DROP DATABASE mdev39146;
DROP USER mdev39146_definer@localhost;

--echo # End of 10.11 tests
