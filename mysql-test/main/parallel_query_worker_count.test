#
# MDEV-39492 Parallel Query: start no more workers than the engine has chunks.
#
# InnoDB divides the table by the shape of its B-tree, not by
# parallel_worker_threads, so a small table yields far fewer chunks than the
# number of workers asked for. A worker past the last chunk reads nothing and
# exits, having cost a THD, its own table instances, cloned items and a row
# buffer. Parallel_workers_started reports how many were really started; it is
# read per parallel query, because both counters are cumulative and
# --ps-protocol executes each statement more than once.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

SET @s= @@session.parallel_worker_threads;

CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq*2 FROM seq_1_to_200;

CREATE TABLE t2 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq*2 FROM seq_1_to_20000;

CREATE TABLE t3 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t3 SELECT seq, seq*2 FROM seq_1_to_1000;

--echo #
--echo # t1 holds one leaf page. The engine cannot divide it, so a worker would
--echo # read all of it, and the serial path does that for less: parallel is
--echo # declined altogether.
--echo #
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t1 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # Two workers is below the floor. Splitting a scan two ways saves less than
--echo # the exchange between the workers and the manager costs -- measured at 0.59
--echo # of the serial speed, and one worker at 0.36 -- so fewer than three is
--echo # declined and the query runs serially, however many leaf pages the table
--echo # has to divide.
--echo #
SET SESSION parallel_worker_threads= 2;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # Three is the floor, and t2 spans leaf pages enough to meet it in full
--echo #
SET SESSION parallel_worker_threads= 3;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # t3 spans a few leaf pages: the request is met up to the chunk count, and
--echo # asking for four times as many does not start one more worker
--echo #
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t3 WHERE b > 0;
--enable_result_log
--let $q4= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--let $w4= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_workers_started', Value, 1)

SET SESSION parallel_worker_threads= 16;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t3 WHERE b > 0;
--enable_result_log
--let $q16= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--let $w16= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_workers_started', Value, 1)

--disable_query_log
--eval SELECT $w4/$q4 = $w16/$q16 AS same_either_way, $w16/$q16 < 16 AS below_the_request
--enable_query_log

--echo #
--echo # t4's B-tree has a level between its root and its leaves, and the root
--echo # holds only two records. Those two ranges are split into enough pieces
--echo # to keep every worker asked for busy, so the request is met in full
--echo # even though the tree divides the table two ways to begin with.
--echo #
CREATE TABLE t4 (pk CHAR(200) PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t4 SELECT LPAD(seq,200,'x'), seq FROM seq_1_to_6000;

SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a FROM t4 WHERE a > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo # and the split is bounded by the worker count. t4 holds about a hundred
--echo # leaf pages, which is what a split that descended all the way would make
--echo # a chunk of each of. The figure is printed rather than only bounded
--echo # because it is what says a re-split covers every sub-tree it descends to.
--let $chunks= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_scan_chunks', Value, 1)
--let $queries= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $chunks/$queries AS chunks_per_query, $chunks/$queries <= 3*8 AS within_three_per_worker
--enable_query_log

--echo # every row is read exactly once however the ranges were divided. Reduced
--echo # outside a non-merged derived table, so that the scan being checked is one
--echo # the workers actually ran: written as a bare aggregate the gate would
--echo # refuse the query outright and this would compare the serial answer with
--echo # itself, and t4 is the only table here whose tree is deep enough to be
--echo # re-split at all.
SET SESSION optimizer_switch='derived_merge=off';
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), BIT_XOR(CRC32(pk)) FROM (SELECT pk, a FROM t4) d;
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT COUNT(*), SUM(a), BIT_XOR(CRC32(pk)) FROM (SELECT pk, a FROM t4) d;
--source include/parallel_query_workers_per_query.inc
SET SESSION optimizer_switch= default;

--echo #
--echo # The optimizer bounds its divisor by how finely the table can be
--echo # divided, which is its leaf page count: a chunk cannot be smaller than a
--echo # leaf page. The bound is read from the index statistics, so they have to
--echo # have been gathered, and InnoDB reports t3 as a single leaf page, which
--echo # is the count for a table it will not divide at all. So t3 is costed as
--echo # the serial scan it is nearly certain to be, whatever is asked for.
--echo #
ANALYZE TABLE t3 PERSISTENT FOR ALL;

SET SESSION parallel_worker_threads= 0;
--let $out=`ANALYZE FORMAT=json SELECT a, b FROM t3 WHERE b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_worker_threads= 16;
--let $out=`ANALYZE FORMAT=json SELECT a, b FROM t3 WHERE b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c16= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

--echo # expect 1: no discount for a table reported as one leaf page
SELECT @c0 = @c16 AS costed_as_serial;

--echo #
--echo # t4 has leaf pages to spare and a level under its root to divide them
--echo # by, so its ceiling is those pages, not the two ranges the root starts
--echo # with. Below the ceiling the divisor is the worker count, so the cost
--echo # keeps falling past the two-range mark -- until the per-worker setup
--echo # outweighs what another worker saves, which for a table this size happens
--echo # while there are still leaf pages to spare: t4 is well inside the buffer
--echo # pool, so its I/O term does not divide at all and only the CPU and
--echo # row-copy terms are left to pay for another worker. See
--echo # main.parallel_query_io_cost. What is checked is therefore that the cost
--echo # falls past two workers, which is the claim about the ceiling, and not
--echo # where the fall stops, which is a property of the cost constants.
--echo #
ANALYZE TABLE t4 PERSISTENT FOR ALL;

SET SESSION parallel_worker_threads= 0;
--let $out=`ANALYZE FORMAT=json SELECT a FROM t4 WHERE a > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @d0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_worker_threads= 6;
--let $out=`ANALYZE FORMAT=json SELECT a FROM t4 WHERE a > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @d6= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_worker_threads= 2;
--let $out=`ANALYZE FORMAT=json SELECT a FROM t4 WHERE a > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @d2= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

--echo # expect 1 1: the scan is discounted, and six workers are still costed
--echo # below two, which the root's two ranges alone could never pay for
SELECT @d0 > @d6 AS parallel_costs_less, @d6 < @d2 AS improves_past_the_root_fanout;

--echo #
--echo # the answer does not depend on how many workers were started
--echo #
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;
SET SESSION parallel_worker_threads= 16;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;

--echo #
--echo # A worker runs the whole join over its chunk, not only the scan, so the
--echo # cost of every table joined after the driving one is divided between the
--echo # workers as well. Costing only the driving table would overstate what the
--echo # plan costs and understate how much parallelism is worth, by exactly the
--echo # part of the join that follows the split table.
--echo #
--echo # t5 is the driving table and needs leaf pages enough for the workers asked
--echo # for; t6 is reached by eq_ref, once per row of t5.
--echo #
CREATE TABLE t5 (pk INT PRIMARY KEY, a INT, b INT) ENGINE=InnoDB;
INSERT INTO t5 SELECT seq, seq % 100, seq FROM seq_1_to_20000;
CREATE TABLE t6 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t6 SELECT seq, seq FROM seq_1_to_20000;
ANALYZE TABLE t5, t6 PERSISTENT FOR ALL;

--let $jq= SELECT STRAIGHT_JOIN t5.a, t6.v FROM t5, t6 WHERE t6.id = t5.pk AND t5.b > 0

SET SESSION parallel_worker_threads= 0;
--let $out=`ANALYZE FORMAT=json $jq`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @drive0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[1]') AS DOUBLE);
SET @inner0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[2]') AS DOUBLE);

SET SESSION parallel_worker_threads= 8;
--let $out=`ANALYZE FORMAT=json $jq`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @drive8= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[1]') AS DOUBLE);
SET @inner8= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[2]') AS DOUBLE);

--echo # expect 1 1 8: both tables are discounted, and the joined table by exactly
--echo # the worker count -- it is divided, where the driving table also carries the
--echo # per-row transport factor and the per-worker setup charge, so its own ratio
--echo # is not the worker count and is not checked here
SELECT @drive8 < @drive0 AS driving_discounted,
       @inner8 < @inner0 AS joined_table_discounted,
       ROUND(@inner0 / @inner8) AS joined_divided_by;

--echo #
--echo # What the manager spends draining the rows is charged per row and is not
--echo # divided by anything, so raising parallel_query_drain_row_cost raises the
--echo # plan's cost by the row count times the increase. 20000 rows and a rise of
--echo # 10 (a thousandth of that internally) is 200.
--echo #
SET @dr= @@parallel_query_drain_row_cost;
SET SESSION parallel_worker_threads= 8;

SET SESSION parallel_query_drain_row_cost= 0;
--let $out=`ANALYZE FORMAT=json SELECT t5.a FROM t5 WHERE t5.b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_query_drain_row_cost= 10;
--let $out=`ANALYZE FORMAT=json SELECT t5.a FROM t5 WHERE t5.b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c1= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

--echo # expect 1 200: the drain is charged, and by rows times the rise
SELECT @c1 > @c0 AS drain_is_charged, ROUND(@c1 - @c0) AS by_rows_times_rise;

--echo #
--echo # And it is charged on the rows the join produces, not the rows the driving
--echo # table scans. Here the inner table's predicate leaves about a hundred rows
--echo # of the twenty thousand scanned, so the same rise costs about 1 rather than
--echo # the 200 above -- which is what says the row count is the join's output.
--echo #
SET SESSION parallel_query_drain_row_cost= 0;
--let $out=`ANALYZE FORMAT=json SELECT STRAIGHT_JOIN t5.a, t6.v FROM t5, t6 WHERE t6.id = t5.pk AND t5.b > 0 AND t6.v < 100`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @j0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_query_drain_row_cost= 10;
--let $out=`ANALYZE FORMAT=json SELECT STRAIGHT_JOIN t5.a, t6.v FROM t5, t6 WHERE t6.id = t5.pk AND t5.b > 0 AND t6.v < 100`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @j1= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

--echo # expect 1 1: charged, and far below what the driving row count would cost
SELECT @j1 > @j0 AS drain_is_charged,
       @j1 - @j0 < 20 AS on_output_rows_not_scanned_rows;

SET SESSION parallel_query_drain_row_cost= @dr;

DROP TABLE t1, t2, t3, t4, t5, t6;
SET SESSION parallel_worker_threads= @s;
