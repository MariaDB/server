#
# MDEV-39492 Parallel Query: start no more workers than the engine has chunks.
#
# InnoDB divides the table by the shape of its B-tree, not by
# parallel_worker_threads, so a small table yields far fewer chunks than the
# number of workers asked for. A worker past the last chunk reads nothing and
# exits, having cost a THD, its own table instances, cloned items and a row
# buffer. Parallel_workers_started reports how many were really started; it is
# read per parallel query, because both counters are cumulative and
# --ps-protocol executes each statement more than once.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

SET @s= @@session.parallel_worker_threads;

CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq*2 FROM seq_1_to_200;

CREATE TABLE t2 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq*2 FROM seq_1_to_20000;

CREATE TABLE t3 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t3 SELECT seq, seq*2 FROM seq_1_to_1000;

--echo #
--echo # t1 holds one leaf page. The engine cannot divide it, so a worker would
--echo # read all of it, and the serial path does that for less: parallel is
--echo # declined altogether.
--echo #
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t1 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # t2 spans many leaf pages, so the request is met in full
--echo #
SET SESSION parallel_worker_threads= 2;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # t3 spans a few leaf pages: the request is met up to the chunk count, and
--echo # asking for four times as many does not start one more worker
--echo #
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t3 WHERE b > 0;
--enable_result_log
--let $q4= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--let $w4= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_workers_started', Value, 1)

SET SESSION parallel_worker_threads= 16;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t3 WHERE b > 0;
--enable_result_log
--let $q16= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--let $w16= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_workers_started', Value, 1)

--disable_query_log
--eval SELECT $w4/$q4 = $w16/$q16 AS same_either_way, $w16/$q16 < 16 AS below_the_request
--enable_query_log

--echo #
--echo # The optimizer divides the scan cost by its own estimate of the chunk
--echo # count, so asking for four times as many workers does not make the scan
--echo # look four times cheaper. The estimate is read from the index
--echo # statistics, so they have to have been gathered; without them it
--echo # answers 1 and the scan is costed as the serial scan it will be.
--echo #
ANALYZE TABLE t3 PERSISTENT FOR ALL;

SET SESSION parallel_worker_threads= 0;
--let $out=`ANALYZE FORMAT=json SELECT a, b FROM t3 WHERE b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_worker_threads= 4;
--let $out=`ANALYZE FORMAT=json SELECT a, b FROM t3 WHERE b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c4= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

SET SESSION parallel_worker_threads= 16;
--let $out=`ANALYZE FORMAT=json SELECT a, b FROM t3 WHERE b > 0`
--disable_query_log
--eval SET @j= '$out'
--enable_query_log
SET @c16= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);

--echo # expect 1 1: parallel is costed cheaper than serial, and asking for 4 or
--echo # 16 workers on a table the engine splits fewer ways costs the same
SELECT @c0 > @c4 AS parallel_costs_less, @c4 = @c16 AS same_for_4_and_16;

--echo #
--echo # the answer does not depend on how many workers were started
--echo #
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;
SET SESSION parallel_worker_threads= 16;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;

DROP TABLE t1, t2, t3;
SET SESSION parallel_worker_threads= @s;
