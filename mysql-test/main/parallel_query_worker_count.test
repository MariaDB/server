#
# MDEV-39492 Parallel Query: start no more workers than the engine has chunks.
#
# InnoDB divides the table by the shape of its B-tree, not by
# parallel_worker_threads, so a small table yields far fewer chunks than the
# number of workers asked for. A worker past the last chunk reads nothing and
# exits, having cost a THD, its own table instances, cloned items and a row
# buffer. Parallel_workers_started reports how many were really started; it is
# read per parallel query, because both counters are cumulative and
# --ps-protocol executes each statement more than once.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

SET @s= @@session.parallel_worker_threads;

CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq*2 FROM seq_1_to_200;

CREATE TABLE t2 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq*2 FROM seq_1_to_20000;

--echo #
--echo # t1 holds one leaf page, so it is one chunk whatever is asked for
--echo #
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t1 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo # and asking for twice as many does not start one more
SET SESSION parallel_worker_threads= 16;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t1 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # t2 spans many leaf pages, so the request is met in full
--echo #
SET SESSION parallel_worker_threads= 2;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
--disable_result_log
SELECT a, b FROM t2 WHERE b > 0;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo #
--echo # the answer does not depend on how many workers were started
--echo #
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
SET SESSION parallel_worker_threads= 16;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;

DROP TABLE t1, t2;
SET SESSION parallel_worker_threads= @s;
