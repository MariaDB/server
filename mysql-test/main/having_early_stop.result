Variable_name	Value
Handler_read_rnd_next	1001
#
# Section 10: constants evaluated at optimize time, and errors
#
# EXPLAIN must not evaluate a scalar-subquery constant at optimize time
EXPLAIN SELECT COUNT(*) FROM t1 WHERE a > 0 HAVING COUNT(*) = (SELECT a FROM t2) + 0;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	t1	ALL	NULL	NULL	NULL	NULL	1000	Using where
2	SUBQUERY	t2	ALL	NULL	NULL	NULL	NULL	1000	
SELECT COUNT(*) FROM t1 WHERE a > 0 HAVING COUNT(*) = (SELECT a FROM t2) + 0;
ERROR 21000: Subquery returns more than 1 row
# An error raised on a row after the stop point is not seen, as with LIMIT
CREATE FUNCTION f_err(x INT) RETURNS INT
BEGIN
IF x > 500 THEN
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= 'row too far';
END IF;
RETURN 1;
END
$$
SELECT COUNT(*) AS cnt FROM t1 WHERE f_err(a) HAVING COUNT(*) < 10;
cnt
SELECT COUNT(*) AS cnt FROM t1 WHERE f_err(a) HAVING COUNT(*) < 2000;
ERROR 45000: row too far
DROP FUNCTION f_err;
DROP TABLE t1, t2, t4;
# End of 13.3 tests
