#
# TLS session resumption, client side
#
#
# a second connection of the same configuration resumes
#
connect ssl1,localhost,root,,,,,SSL;
connection ssl1;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect ssl1;
connect ssl2,localhost,root,,,,,SSL;
connection ssl2;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect ssl2;
#
# a resumed connection has a session again, so it keeps working. With
# TLS 1.3 the server issues a new ticket, before that the session we
# resumed with is put back
#
connect ssl3,localhost,root,,,,,SSL;
connection ssl3;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect ssl3;
#
# a resumed handshake verifies no certificate at all, so a session
# must not be offered to a differently configured connection. Both
# the cipher and the transport are part of the cache key.
#
connect ssl4,localhost,root,,,,,SSL SSL-CIPHER=ECDHE-RSA-AES128-GCM-SHA256;
connection ssl4;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect ssl4;
connect tcp1,127.0.0.1,root,,,$MASTER_MYPORT,,SSL TCP;
connection tcp1;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect tcp1;
#
# and each of those configurations resumes on its own
#
connect tcp2,127.0.0.1,root,,,$MASTER_MYPORT,,SSL TCP;
connection tcp2;
SHOW SESSION STATUS LIKE 'Ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect tcp2;
connection default;
# End of 13.2 tests
