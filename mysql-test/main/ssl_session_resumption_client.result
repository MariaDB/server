#
# MDEV-40445 TLS session resumption
#
connect ssl1,localhost,root,,,,,SSL;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect ssl1;
connect ssl2,localhost,root,,,,,SSL;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect ssl2;
connect ssl3,localhost,root,,,,,SSL;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect ssl3;
connect ssl4,localhost,root,,,,,SSL SSL-CIPHER=ECDHE-RSA-AES128-GCM-SHA256;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect ssl4;
connect tcp1,127.0.0.1,root,,,$MASTER_MYPORT,,SSL TCP;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect tcp1;
connect ssl5,localhost,root,,,,,SSL SSL-CIPHER=ECDHE-RSA-AES128-GCM-SHA256;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect ssl5;
connection default;
create user u1@localhost;
connect user1,localhost,u1,,,,,SSL;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	0
disconnect user1;
connect user2,localhost,u1,,,,,SSL;
show session status like 'ssl_sessions_reused';
Variable_name	Value
Ssl_sessions_reused	1
disconnect user2;
connection default;
drop user u1@localhost;
# End of 13.2 tests
