#
# What a multi-valued index actually holds.
#
# The keys of a row are made by the mvi fulltext parser, out of the array
# inside the base column, and they have to be exactly what MVI_ENCODE()
# makes of the same array -- key for key, because both go through the same
# Mvi_array_iterator. That is the point of the iterator, so it is what
# this checks.
#
--source include/have_innodb.inc

set @old_innodb_ft_aux_table=@@global.innodb_ft_aux_table;

# utf8mb4_bin so that a key is the hex of the element's own bytes and the
# result below is readable. TEXT rather than JSON so that a document that
# is not JSON at all can be one of the rows.
create table t1 (c int, j text charset utf8mb4 collate utf8mb4_bin,
                 key ft ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
show create table t1;
--replace_column 7 #
show index from t1;
insert into t1 values
 (1,'{"tags": ["aaa","bbb"]}'),
 (2,'{"tags": ["bbb"], "other": ["zzz"]}'),
 (3,'{"tags": ["ccc", 7, null, true, {"a": 1}, ["ddd","eee"]]}'),
 (4,'{"tags": []}'),
 (5,'{"other": ["fff"]}'),
 (6,'{"tags": "not an array"}'),
 (7,'not json at all');

--echo #
--echo # The keys of each document, as MVI_ENCODE() makes them: two elements
--echo # for row 1, the elements of a nested array among row 3's, and
--echo # nothing at all for a row with no array of encodable elements
--echo # there. Elements that are not strings have no key in a CHAR index.
--echo #
select c, mvi_encode(j->'$.tags', char(6)) from t1 order by c;

--echo #
--echo # ... and the same keys, on the same rows, in the index. Nothing
--echo # from elsewhere in the document is in it: not "zzz" from row 2's
--echo # other array, not the keys of row 3's object, and nothing from the
--echo # rows with no array at that path.
--echo #
set global innodb_ft_aux_table='test/t1';
select word, doc_id from information_schema.innodb_ft_index_cache
 order by word, doc_id;

--echo #
--echo # The JSON predicates find the rows they should, and the same rows
--echo # they find without the index
--echo #
select c from t1 where json_contains(j->'$.tags','"aaa"') order by c;
select c from t1 ignore index(ft)
 where json_contains(j->'$.tags','"aaa"') order by c;
select c from t1 where json_contains(j->'$.tags','["aaa","bbb"]') order by c;
select c from t1 ignore index(ft)
 where json_contains(j->'$.tags','["aaa","bbb"]') order by c;
select c from t1 where json_overlaps(j->'$.tags','["eee","zzz"]') order by c;
select c from t1 ignore index(ft)
 where json_overlaps(j->'$.tags','["eee","zzz"]') order by c;

--echo #
--echo # The key part is the base column now, so MATCH() against the index
--echo # parses. The keys are encoded, so a boolean-mode search for one is
--echo # the same search the optimizer builds.
--echo #
--echo # "aaa" is row 1 only
select c from t1 where match(j) against ('616161' in boolean mode) order by c;
--echo # "bbb" is rows 1 and 2
select c from t1 where match(j) against ('626262' in boolean mode) order by c;
--echo # "eee" is in a nested array in row 3
select c from t1 where match(j) against ('656565' in boolean mode) order by c;
--echo # both of row 1's keys
select c from t1 where match(j) against ('+616161 +626262' in boolean mode)
 order by c;
--echo # a key of row 1 and a key of row 2, which no one row has
select c from t1 where match(j) against ('+616161 +7a7a7a' in boolean mode)
 order by c;

--echo #
--echo # A natural-language search is not a query anything builds for such
--echo # an index, and the parser cannot tell one from a document: it reads
--echo # the search string as a document, finds no array in it, and so
--echo # matches nothing.
--echo #
select c from t1 where match(j) against ('616161') order by c;
--echo # ... and the words of the document are not in the index either
select c from t1 where match(j) against ('tags' in boolean mode) order by c;

--echo #
--echo # The keys are in the table, not in a session: they survive a reopen
--echo # and are read back from disk the same way.
--echo #
flush tables;
select c from t1 where json_contains(j->'$.tags','"bbb"') order by c;

--echo #
--echo # An update rewrites the keys of that row and nothing else
--echo #
update t1 set j='{"tags": ["ggg"]}' where c=1;
select c, mvi_encode(j->'$.tags', char(6)) from t1 order by c;
select c from t1 where json_contains(j->'$.tags','"aaa"') order by c;
select c from t1 where json_contains(j->'$.tags','"ggg"') order by c;
select c from t1 where json_contains(j->'$.tags','"bbb"') order by c;

delete from t1 where c=2;
select c from t1 where json_contains(j->'$.tags','"bbb"') order by c;

set global innodb_ft_aux_table=@old_innodb_ft_aux_table;
drop table t1;

--echo #
--echo # The same through an index built by ALTER TABLE rather than by DML
--echo #
create table t2 (c int, j text charset utf8mb4 collate utf8mb4_bin)
engine=innodb;
insert into t2 values (1,'{"tags": ["aaa","bbb"]}'),(2,'{"tags": ["bbb"]}');
alter table t2 add key ft ((CAST(j->'$.tags' AS CHAR(6) ARRAY)));
flush tables;
select c, mvi_encode(j->'$.tags', char(6)) from t2 order by c;
select c from t2 where json_contains(j->'$.tags','"aaa"') order by c;
select c from t2 where json_contains(j->'$.tags','"bbb"') order by c;
drop table t2;

--echo #
--echo # MyISAM and Aria tokenize the same way. The index is unusable there
--echo # -- no fulltext_estimate(), so the optimizer never picks it -- but
--echo # a MATCH in the WHERE clause still reads it.
--echo #
--echo # TODO: they do not. The searches below find nothing, and the one
--echo # for a word of the document says which half is wrong: a hit there
--echo # means the index was built by the built-in parser, so the
--echo # declaration did not reach ha_myisam::open()'s copy of
--echo # MI_KEYDEF::ftparser_arg or ftparser_call_initializer(); no hit
--echo # means the index holds nothing at all. The JSON predicate still
--echo # answers correctly off a table scan either way.
create table t1 (c int, j text charset utf8mb4 collate utf8mb4_bin,
                 key ft ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=myisam;
insert into t1 values (1,'{"tags": ["aaa","bbb"]}'),(2,'{"tags": ["bbb"]}');
select c from t1 where match(j) against ('616161' in boolean mode) order by c;
select c from t1 where match(j) against ('626262' in boolean mode) order by c;
--echo # a word of the document, which must not be in a multi-valued index
select c from t1 where match(j) against ('tags' in boolean mode) order by c;
--echo # a phrase of two keys is matched against the document's keys in
--echo # their order, so it is the parser that reads the document again
select c from t1 where match(j) against ('"616161 626262"' in boolean mode)
 order by c;
select c from t1 where match(j) against ('"626262 616161"' in boolean mode)
 order by c;
select c from t1 where json_contains(j->'$.tags','"aaa"') order by c;
drop table t1;

create table t1 (c int, j text charset utf8mb4 collate utf8mb4_bin,
                 key ft ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=aria;
insert into t1 values (1,'{"tags": ["aaa","bbb"]}'),(2,'{"tags": ["bbb"]}');
select c from t1 where match(j) against ('616161' in boolean mode) order by c;
select c from t1 where match(j) against ('626262' in boolean mode) order by c;
--echo # a word of the document, see above
select c from t1 where match(j) against ('tags' in boolean mode) order by c;
select c from t1 where json_contains(j->'$.tags','"aaa"') order by c;
--echo # TODO: and this DROP warns 1112, an unsupported extension, which
--echo # nothing about this table definition should provoke
drop table t1;
