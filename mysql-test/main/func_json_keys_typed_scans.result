#
# The reading a JSON_KEYS array saves where it is spliced, and the
# reading it does not save where the set it is written in cannot
# be attested.  Nothing but the count shows either of them.
#
# sjis decodes every ASCII byte to itself and is flagged as not
# ASCII-compatible all the same, so the array it answers is a
# perfectly good document with no mark on it, and the splice reads
# it again.  utf8mb4 stands beside it, over the same document,
# where the mark is given and the splice reads nothing - which is
# what makes the count a fact about the set rather than about the
# document or the splice.
#
# What the answers themselves look like is in
# func_json_keys_typed.
#
SET NAMES utf8mb4;
CREATE TABLE ts (j TEXT) CHARACTER SET sjis;
CREATE TABLE tu (j TEXT) CHARACTER SET utf8mb4;
INSERT INTO ts VALUES ('{"a":1,"b":2}');
INSERT INTO tu VALUES ('{"a":1,"b":2}');
FLUSH STATUS;
SELECT JSON_ARRAY(JSON_KEYS(j)) FROM ts;
SHOW STATUS LIKE 'Json_scans';
Variable_name	Value
Json_scans	2
FLUSH STATUS;
SELECT JSON_ARRAY(JSON_KEYS(j)) FROM tu;
SHOW STATUS LIKE 'Json_scans';
Variable_name	Value
Json_scans	1
DROP TABLE ts, tu;
