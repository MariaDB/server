#
# MDEV-39868: Wrong result (empty set) for a query with a window
#             function over a column of a merged derived table
#
CREATE TABLE t1(c1 VARCHAR(100) NOT NULL, KEY t1_k1 (c1));
CREATE TABLE t2(c1 BOOLEAN, c2 INT NOT NULL, KEY t2_k1 (c1, c2));
CREATE TABLE t3(c1 VARCHAR(100) NOT NULL, c2 INT NOT NULL);
INSERT INTO t1 VALUES ('foo'), ('bar');
INSERT INTO t2 VALUES (FALSE, 10);
INSERT INTO t3 VALUES ('foo', 10), ('bar', 20);
# t2 is accessed with "Range checked for each record", and the value
# of subq.c2 used by the range optimizer must come from t3, not from
# the temporary table created for the window function.
EXPLAIN
SELECT AVG(subq.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	index	t1_k1	t1_k1	102	NULL	2	Using index; Using temporary
1	SIMPLE	t3	ALL	NULL	NULL	NULL	NULL	2	Using where; Using join buffer (flat, BNL join)
1	SIMPLE	t2	ALL	t2_k1	NULL	NULL	NULL	1	Range checked for each record (index map: 0x1)
SELECT AVG(subq.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1);
col1	col2
15.0000	0
15.0000	0
# the same with the derived table materialized
SET optimizer_switch='derived_merge=off';
SELECT AVG(subq.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1);
col1	col2
15.0000	0
15.0000	0
SET optimizer_switch='derived_merge=default';
# the same without a derived table
SELECT AVG(subq.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN t3 AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1);
col1	col2
15.0000	0
15.0000	0
# the same without the range check on t2
SELECT AVG(subq.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 IGNORE INDEX (t2_k1) ON (subq.c2 > t2.c1);
col1	col2
15.0000	0
15.0000	0
# the same via a view
CREATE VIEW v3 AS SELECT * FROM t3;
SELECT AVG(v3.c2) OVER () as col1, t2.c1 as col2
FROM t1
JOIN v3
ON (t1.c1 = v3.c1)
STRAIGHT_JOIN t2 ON (v3.c2 > t2.c1);
col1	col2
15.0000	0
15.0000	0
DROP VIEW v3;
# an aggregate function with GROUP BY uses a temporary table too
EXPLAIN
SELECT AVG(subq.c2) as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1)
GROUP BY t2.c1;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	index	t1_k1	t1_k1	102	NULL	2	Using index; Using temporary; Using filesort
1	SIMPLE	t3	ALL	NULL	NULL	NULL	NULL	2	Using where; Using join buffer (flat, BNL join)
1	SIMPLE	t2	index	t2_k1	t2_k1	6	NULL	1	Using where; Using index; Using join buffer (incremental, BNL join)
SELECT AVG(subq.c2) as col1, t2.c1 as col2
FROM t1
JOIN (
SELECT * FROM t3
) AS subq
ON (t1.c1 = subq.c1)
STRAIGHT_JOIN t2 ON (subq.c2 > t2.c1)
GROUP BY t2.c1;
col1	col2
15.0000	0
DROP TABLE t1, t2, t3;
