CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq % 13 FROM seq_1_to_500;
ANALYZE TABLE t1 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
SET @save_os= @@optimizer_switch;
SET SESSION optimizer_switch='derived_merge=off';
SET SESSION parallel_worker_threads=4;
#
# an explicit LIMIT: refused, and the cap honoured (expect 0 3)
#
FLUSH STATUS;
SELECT a, b FROM t1 WHERE b > 3 LIMIT 3;
ran_in_the_workers	rows_sent
0	3
#
# the session cap, which is a limit nothing in the statement spells out
# (expect 0 3)
#
SET SESSION sql_select_limit=3;
FLUSH STATUS;
SELECT a, b FROM t1 WHERE b > 3;
ran_in_the_workers	rows_sent
0	3
# and the rows are the ones the serial plan sends
SELECT a, b FROM t1 WHERE b > 3;
a	b
4	4
5	5
6	6
#
# the cap is the outer select's; a derived table's select keeps its
# parallel scan (expect 1 3)
#
FLUSH STATUS;
SELECT a, b FROM (SELECT a, b FROM t1 WHERE b > 3) d;
ran_in_the_workers	rows_sent
1	3
SET SESSION sql_select_limit=default;
#
# with the cap gone the same query runs in the workers again
# (expect 1 345)
#
FLUSH STATUS;
SELECT a, b FROM t1 WHERE b > 3;
ran_in_the_workers	rows_sent
1	345
SET SESSION optimizer_switch= @save_os;
SET SESSION parallel_worker_threads=default;
DROP TABLE t1;
