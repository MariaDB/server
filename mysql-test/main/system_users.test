--source include/not_embedded.inc

--echo # --system-users: only system accounts can manage system accounts
--echo # (denied statements fail with ER_ACCESS_DENIED_ERROR)

create user sysadmin@localhost;
create user sysadmin2@localhost;
grant all on *.* to sysadmin@localhost with grant option;
create user dba@localhost;
grant all on *.* to dba@localhost with grant option;
create user other@localhost;
create role r1;
grant r1 to sysadmin@localhost with admin option;
create table test.t1 (a int);
grant proxy on other@localhost to dba@localhost with grant option;
grant proxy on sysadmin@localhost to dba@localhost with grant option;

--echo # a non-system account, even with ALL ... WITH GRANT OPTION, is denied
connect (dba,localhost,dba,,);

--error ER_ACCESS_DENIED_ERROR
create user sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
create user if not exists sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
create or replace user sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
alter user sysadmin@localhost identified by 'x';
--error ER_ACCESS_DENIED_ERROR
alter user sysadmin@localhost account lock;
--error ER_ACCESS_DENIED_ERROR
drop user sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
drop user if exists sysadmin@LOCALHOST;
--error ER_ACCESS_DENIED_ERROR
drop user other@localhost, sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
rename user sysadmin@localhost to renamed@localhost;
--error ER_ACCESS_DENIED_ERROR
rename user other@localhost to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant select on *.* to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant select on test.* to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant select on test.t1 to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant select (a) on test.t1 to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant select on *.* to sysadmin@localhost identified by 'x';
--error ER_ACCESS_DENIED_ERROR
grant r1 to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant proxy on other@localhost to sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
grant proxy on sysadmin@localhost to other@localhost;
--error ER_ACCESS_DENIED_ERROR
revoke select on *.* from sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
revoke all privileges, grant option from sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
revoke r1 from sysadmin@localhost;
--error ER_ACCESS_DENIED_ERROR
set password for sysadmin@localhost = password('x');
--error ER_ACCESS_DENIED_ERROR
set default role r1 for sysadmin@localhost;

--echo # a non-system account cannot create objects defined by a system account
--error ER_ACCESS_DENIED_ERROR
create definer=sysadmin@localhost procedure test.p2() select 1;
--error ER_ACCESS_DENIED_ERROR
create definer=sysadmin@localhost function test.f2() returns int return 1;
--error ER_ACCESS_DENIED_ERROR
create definer=sysadmin@localhost view test.v2 as select 1;
--error ER_ACCESS_DENIED_ERROR
create definer=sysadmin@localhost trigger test.tr2 before insert on test.t1
  for each row set @a=1;
--error ER_ACCESS_DENIED_ERROR
create definer=sysadmin@localhost event test.e2 on schedule every 1 day do select 1;
create definer=other@localhost view test.v3 as select 1;
drop view test.v3;

--echo # nor become a system account
--error ER_ACCESS_DENIED_ERROR
set session authorization sysadmin@localhost;

--echo # non-system accounts are unaffected
create user other2@localhost;
alter user other2@localhost identified by 'x';
grant select on test.* to other2@localhost;
rename user other2@localhost to other3@localhost;
drop user other3@localhost;
create role r2;
drop role r2;
disconnect dba;
connection default;

--echo # a system account can manage any account, including other system ones
connect (sysadmin,localhost,sysadmin,,);
alter user sysadmin@localhost identified by '';
alter user sysadmin2@localhost account lock;
alter user sysadmin2@localhost account unlock;
grant select on test.* to sysadmin2@localhost;
revoke select on test.* from sysadmin2@localhost;
grant r1 to sysadmin2@localhost;
revoke r1 from sysadmin2@localhost;
alter user dba@localhost identified by '';
create definer=sysadmin2@localhost procedure test.p2() select 1;
drop procedure test.p2;
set session authorization sysadmin2@localhost;
select current_user();
disconnect sysadmin;
connection default;

--echo # a SECURITY DEFINER routine of a system account acts as that account
create definer=sysadmin@localhost procedure test.p1()
  sql security definer alter user other@localhost identified by 'y';
grant execute on procedure test.p1 to dba@localhost;
connect (dba,localhost,dba,,);
call test.p1();
--error ER_ACCESS_DENIED_ERROR
alter user sysadmin@localhost identified by 'x';
disconnect dba;
connection default;

--echo # cleanup
drop procedure test.p1;
drop table test.t1;
drop role r1;
drop user sysadmin@localhost, sysadmin2@localhost, dba@localhost, other@localhost;
