SET NAMES utf8mb3 COLLATE utf8mb3_general_ci;
CREATE VIEW v1 AS SELECT 'a' c1, 'c' c2;
SET NAMES utf8mb3 COLLATE utf8mb3_unicode_ci;
SELECT 'b' BETWEEN c1 AND c2 FROM v1;
'b' BETWEEN c1 AND c2
1
SELECT 'c' IN (c1, c2) FROM v1;
'c' IN (c1, c2)
1
DROP VIEW v1;
SET NAMES utf8mb3 COLLATE utf8mb3_general_ci;
CREATE VIEW v1 AS SELECT 'a' c1, '_' c2;
SET NAMES utf8mb3 COLLATE utf8mb3_unicode_ci;
SELECT 'b' BETWEEN c1 AND c2 FROM v1;
ERROR HY000: Illegal mix of collations (utf8mb3_unicode_ci,COERCIBLE), (utf8mb3_general_ci,COERCIBLE), (utf8mb3_general_ci,COERCIBLE) for operation 'between'
SELECT 'c' IN (c1, c2) FROM v1;
ERROR HY000: Illegal mix of collations (utf8mb3_unicode_ci,COERCIBLE), (utf8mb3_general_ci,COERCIBLE), (utf8mb3_general_ci,COERCIBLE) for operation 'in'
DROP VIEW v1;
# LOWER() in a Turkish collation can return a non-ASCII character
# (the dotless i), so its result is not ASCII-only
SET NAMES utf8mb3 COLLATE utf8mb3_turkish_ci;
CREATE VIEW v1 AS SELECT 'I' AS c;
SET NAMES utf8mb3 COLLATE utf8mb3_unicode_ci;
SELECT * FROM v1 WHERE LOWER(c)='i';
ERROR HY000: Illegal mix of collations (utf8mb3_turkish_ci,COERCIBLE) and (utf8mb3_unicode_ci,COERCIBLE) for operation '='
DROP VIEW v1;
SET NAMES DEFAULT;
# End of 11.8 tests
