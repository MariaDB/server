CREATE DATABASE replay_db1;
CREATE TABLE replay_db1.t1 (a INT, b INT, KEY(a));
INSERT INTO replay_db1.t1 VALUES (1,1), (2,2), (3,3);
CREATE VIEW replay_db1.v1 AS SELECT * FROM replay_db1.t1;
CREATE TABLE t2 (c INT);
INSERT INTO t2 VALUES (1),(2);
ANALYZE TABLE replay_db1.t1, t2;
