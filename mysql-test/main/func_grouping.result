#
# Bug #33149402: SELECT'S GROUPING() NOT TAKEN IN ACCOUNT IN HAVING WHEN JOIN USED
#
CREATE TABLE t1 (a INTEGER, b INTEGER);
INSERT INTO t1 VALUES (2020, 2);
CREATE TABLE t2 (b INTEGER);
INSERT INTO t2 VALUES (2);
SELECT a, GROUPING(a) AS ga
FROM t1 JOIN t2 USING (b)
GROUP BY a WITH ROLLUP
HAVING ga = 0;
a	ga
2020	0
DROP TABLE t1, t2;
#
# Bug#36039905: Assertion `table_num_to_node_num[table_num] != -1' failed
#
CREATE TABLE t(x INT);
SELECT 1 FROM t AS t1, t AS t2,
(SELECT DISTINCT GROUPING(t3.x) FROM t AS t3, t AS t4
GROUP BY t3.x WITH ROLLUP) AS dt;
1
DROP TABLE t;
#
# Bug#36514339 ROLLUP misses a summary NULL
#
CREATE TABLE t(a INT);
SELECT GROUPING(a), a, COUNT(*) FROM t GROUP BY a WITH ROLLUP;
GROUPING(a)	a	COUNT(*)
1	NULL	0
DROP TABLE t;
#
# Bug#38168051: Support for GROUPING() function with primitive GBY
#
CREATE TABLE t1 (f1 INTEGER, f2 INTEGER);
INSERT INTO t1 VALUES (1,1), (1,2), (2,1);
SELECT GROUPING(f1) FROM t1 GROUP BY f1;
GROUPING(f1)
0
0
