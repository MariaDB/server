#
# MDEV-39492 Parallel Query: the result-row transport.
#
# A worker's finished rows reach the manager through one of two transports
# (sql_parallel_transport.h): the temporary-table one, where a worker
# materialises its result set into its own container and the manager reads
# those back, or the batch one, where rows travel as record images through a
# buffer the worker blocks on. The temporary-table transport is what a query
# gets; the batch one is reachable under a debug flag while the two are
# compared, so that the code kept for that comparison stays exercised.
#
# Everything here has to be a plain SELECT that really runs in the workers:
# the gate declines aggregates and a derived table is materialised serially, so
# a COUNT(*) over the query under test would measure nothing at all. Row counts
# are read from Rows_sent for the same reason, and the statements they are read
# for run with the prepared-statement protocol disabled: it executes a statement
# twice and the counter would then read double.
#
--source include/have_innodb.inc
--source include/not_embedded.inc
--source include/have_sequence.inc
--source include/have_debug.inc

--disable_service_connection

set @save_dbug=@@global.debug_dbug;

CREATE TABLE t1 (a INT PRIMARY KEY, b INT, c VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq MOD 7, CONCAT('row', seq MOD 5)
  FROM seq_1_to_5000;
CREATE TABLE t2 (k INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq*2 FROM seq_1_to_5000;
SET SESSION parallel_worker_threads=4;

--echo #
--echo # A worker writing its rows into a container is a temporary-table write,
--echo # which the session can see once the workers are reaped. So the transport
--echo # in use is visible: rows through tmp tables, none through batches.
--echo #
--echo # tmp-table transport (expect 1 1)
FLUSH STATUS;
--sorted_result
SELECT a, b, c FROM t1 WHERE a > 4995;
--let $tw= query_get_value(SHOW SESSION STATUS LIKE 'Handler_tmp_write', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $tw > 0 AS rows_went_through_tmp_tables
--enable_query_log

--echo # batch transport, same rows (expect 1 1)
set global debug_dbug="+d,pwt_batch_transport";
FLUSH STATUS;
--sorted_result
SELECT a, b, c FROM t1 WHERE a > 4995;
--let $tw= query_get_value(SHOW SESSION STATUS LIKE 'Handler_tmp_write', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $tw = 0 AS no_tmp_table_rows
--enable_query_log
set global debug_dbug=@save_dbug;

--echo #
--echo # A container is a temporary table, and a temporary table given a unique
--echo # key would silently collapse repeated rows. t3 has no unique column and
--echo # the query reads only its two low-cardinality ones, so all 2000 rows a
--echo # worker stores are duplicates of each other bar six. Every one of them
--echo # has to come back.
--echo #
CREATE TABLE t3 (b INT, c VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO t3 SELECT seq MOD 3, CONCAT('v', seq MOD 2) FROM seq_1_to_2000;

--echo # tmp-table transport (expect 1 1)
FLUSH STATUS;
--disable_ps_protocol
--disable_result_log
SELECT b, c FROM t3;
--enable_result_log
--enable_ps_protocol
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 2000 AS every_duplicate_arrived
--enable_query_log

--echo # batch transport (expect 1 1)
set global debug_dbug="+d,pwt_batch_transport";
FLUSH STATUS;
--disable_ps_protocol
--disable_result_log
SELECT b, c FROM t3;
--enable_result_log
--enable_ps_protocol
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 2000 AS every_duplicate_arrived
--enable_query_log
set global debug_dbug=@save_dbug;

--echo #
--echo # And over a join, the two transports agree row for row: the two blocks
--echo # below are the same query and must record identically.
--echo #
--echo # tmp-table transport
--sorted_result
SELECT t1.a, t1.c, t2.v FROM t1, t2
  WHERE t1.a = t2.k AND t1.b = 3 AND t1.a > 4900;
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers
--enable_query_log

--echo # batch transport
set global debug_dbug="+d,pwt_batch_transport";
FLUSH STATUS;
--sorted_result
SELECT t1.a, t1.c, t2.v FROM t1, t2
  WHERE t1.a = t2.k AND t1.b = 3 AND t1.a > 4900;
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers
--enable_query_log
set global debug_dbug=@save_dbug;

--echo #
--echo # Known limitation, pinned here so it is not discovered by surprise: a
--echo # worker's container is a heap table, nothing converts it to disk when it
--echo # fills, and so a result set bigger than the session's temporary-table
--echo # limit fails the statement. The serial plan for this query uses no
--echo # temporary table at all, and neither does the batch transport, so this
--echo # is the transport's own boundary and not the query's.
--echo #
CREATE TABLE t4 (a INT PRIMARY KEY, b VARCHAR(200)) ENGINE=InnoDB;
INSERT INTO t4 SELECT seq, REPEAT('x',200) FROM seq_1_to_20000;
SET SESSION tmp_memory_table_size=65536;
SET SESSION max_heap_table_size=65536;

--echo # tmp-table transport: 20000 rows of 200 bytes will not fit
--error ER_INTERNAL_ERROR
SELECT a, b FROM t4;

--echo # batch transport keeps nothing, so it answers (expect 20000)
set global debug_dbug="+d,pwt_batch_transport";
FLUSH STATUS;
--disable_ps_protocol
--disable_result_log
SELECT a, b FROM t4;
--enable_result_log
--enable_ps_protocol
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--disable_query_log
--eval SELECT $rs AS rows_sent
--enable_query_log
set global debug_dbug=@save_dbug;

--echo # and the server is unharmed: the same query fits once the limit does
SET SESSION tmp_memory_table_size=default;
SET SESSION max_heap_table_size=default;
FLUSH STATUS;
--disable_ps_protocol
--disable_result_log
SELECT a, b FROM t1;
--enable_result_log
--enable_ps_protocol
--let $rs= query_get_value(SHOW SESSION STATUS LIKE 'Rows_sent', Value, 1)
--let $pq= query_get_value(SHOW SESSION STATUS LIKE 'Parallel_queries_executed', Value, 1)
--disable_query_log
--eval SELECT $pq > 0 AS ran_in_the_workers, $rs = 5000 AS all_rows
--enable_query_log

DROP TABLE t1, t2, t3, t4;
SET SESSION parallel_worker_threads=default;
