SET @save_sel= @@optimizer_use_condition_selectivity;
SET @save_ust= @@use_stat_tables;
SET @save_jcl= @@join_cache_level;
SET optimizer_use_condition_selectivity= 4;
SET use_stat_tables= PREFERABLY;
SET join_cache_level= 2;
CREATE TABLE dim (d_id INT PRIMARY KEY, d_name VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO dim SELECT seq, CONCAT('name', seq) FROM seq_1_to_20;
CREATE TABLE fact (f_id INT PRIMARY KEY, d_id INT NOT NULL, val INT) ENGINE=InnoDB;
INSERT INTO fact SELECT seq, seq % 20 + 1, seq FROM seq_1_to_2000;
CREATE TABLE detail (f_id INT PRIMARY KEY, extra INT) ENGINE=InnoDB;
INSERT INTO detail SELECT seq, seq * 2 FROM seq_1_to_2000;
ANALYZE TABLE dim, fact, detail PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.dim	analyze	status	Engine-independent statistics collected
test.dim	analyze	status	OK
test.fact	analyze	status	Engine-independent statistics collected
test.fact	analyze	status	OK
test.detail	analyze	status	Engine-independent statistics collected
test.detail	analyze	status	OK
EXPLAIN EXTENDED
SELECT STRAIGHT_JOIN COUNT(*) FROM dim, fact, detail
WHERE fact.d_id = dim.d_id AND detail.f_id = fact.f_id AND dim.d_name = 'name7';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	dim	ALL	PRIMARY	NULL	NULL	NULL	20	5.00	Using where
1	SIMPLE	fact	ALL	PRIMARY	NULL	NULL	NULL	2000	5.00	Using where; Using join buffer (flat, BNL join)
1	SIMPLE	detail	eq_ref	PRIMARY	PRIMARY	4	test.fact.f_id	1	100.00	
Warnings:
Note	1003	select straight_join count(0) AS `COUNT(*)` from `test`.`dim` join `test`.`fact` join `test`.`detail` where `test`.`fact`.`d_id` = `test`.`dim`.`d_id` and `test`.`detail`.`f_id` = `test`.`fact`.`f_id` and `test`.`dim`.`d_name` = 'name7'
ANALYZE FORMAT=JSON
