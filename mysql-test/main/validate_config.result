FOUND 1 /Starts the MariaDB database server/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --version: version, no "Configuration is valid"
FOUND 1 /Ver [0-9]/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --version --verbose: version, no "Configuration is valid"
FOUND 1 /Ver [0-9]/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --version with an unknown option: version, no error
FOUND 1 /Ver [0-9]/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --version with an unknown variable in a config file: version, no error
FOUND 1 /Ver [0-9]/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --help --verbose lists --validate-config
FOUND 1 /Validate the server configuration/ in validate_config.log
NOT FOUND /Configuration is valid|\[ERROR\]/ in validate_config.log
# --max-connections=0 with --help, --help --verbose, --version:
