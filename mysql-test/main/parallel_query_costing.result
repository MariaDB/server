# The same with the order fixed: STRAIGHT_JOIN costs the order both
# ways too.
#
EXPLAIN SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.name = 'match';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	ALL_parallel	PRIMARY	NULL	NULL	NULL	20000	Using where
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	
FLUSH STATUS;
SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.name = 'match';
COUNT(*)	SUM(f.val)
20000	9990000
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
WHERE VARIABLE_NAME = 'Parallel_queries_executed';
ran_in_the_workers
1
#
# A table scanned under the divided driver takes a join buffer as it
# does serially: each worker runs one of its own, so the plan is costed
# with the buffer and runs with it, in the workers.
#
SET SESSION join_cache_level= @save_jcl;
CREATE TABLE tag (id INT, name VARCHAR(10)) ENGINE=InnoDB;
INSERT INTO tag SELECT seq, CONCAT('t', seq) FROM seq_1_to_20;
SET SESSION parallel_worker_threads= 0;
EXPLAIN SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t	ALL	NULL	NULL	NULL	NULL	20	
1	SIMPLE	d	ALL	PRIMARY	NULL	NULL	NULL	20000	Using where; Using join buffer (flat, BNL join)
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	Using where
SET SESSION parallel_worker_threads= 4;
EXPLAIN SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	ALL_parallel	PRIMARY	NULL	NULL	NULL	20000	Using where
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	
1	SIMPLE	t	ALL	NULL	NULL	NULL	NULL	20	Using where; Using join buffer (flat, BNL join)
FLUSH STATUS;
SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
COUNT(*)	MAX(t.name)
400	t9
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
WHERE VARIABLE_NAME = 'Parallel_queries_executed';
ran_in_the_workers
1
#
# What the workers ship is charged per row (optimizer_parallel_row_cost).
# A query that does not aggregate ships every joined row, and the
# manager receives them all by itself: charged enough per row, the
# plan that was divided is read serially. A query that aggregates
# ships its partial groups, not its rows, and the same charge leaves
# it divided.
#
SET @save_row= @@session.optimizer_parallel_row_cost;
SET SESSION parallel_worker_threads= 4;
SET SESSION optimizer_trace=1;
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000;
SELECT JSON_EXTRACT(trace, '$**.parallel_rows_shipped') AS rows_shipped
FROM information_schema.optimizer_trace;
rows_shipped
[20000]
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	range_parallel	PRIMARY	PRIMARY	4	NULL	2000	Using where
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	
SET SESSION optimizer_parallel_row_cost= 100;
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000;
SELECT JSON_EXTRACT(trace, '$**.parallel_scan_declined_because') AS why
FROM information_schema.optimizer_trace;
why
["the optimizer costed the plan cheaper with its driving table read serially (see parallel_scan_cost)"]
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	range	PRIMARY	PRIMARY	4	NULL	2000	Using where
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	
# grouped: the partials shipped are counted by the groups, not the rows
EXPLAIN SELECT d.name, COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000 GROUP BY d.name;
SELECT JSON_EXTRACT(trace, '$**.parallel_rows_shipped') AS rows_shipped
FROM information_schema.optimizer_trace;
rows_shipped
[6, 8]
EXPLAIN SELECT d.name, COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
WHERE f.dim_id = d.id AND d.id <= 2000 GROUP BY d.name;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	range_parallel	PRIMARY	PRIMARY	4	NULL	2000	Using where; Using temporary; Using filesort
1	SIMPLE	f	ref	dim_id	dim_id	5	test.d.id	10	
SET SESSION optimizer_trace=@save_trace;
SET SESSION optimizer_parallel_row_cost= @save_row;
#
# A grouped derived table the outer query joins by a key on its group
# column is a candidate for splitting (split_materialized), which
# reoptimizes it with the outer equality pushed in and restores the
# plan it had when that loses. The plan restored is the divided one the
# search chose, and it runs in the workers.
#
SET SESSION parallel_worker_threads= 4;
EXPLAIN SELECT COUNT(*), SUM(dn.s) FROM dim2 d,
(SELECT dim_id, SUM(val) s FROM fact2 GROUP BY dim_id) dn
WHERE dn.dim_id = d.id AND d.id > 10000;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	d	range	PRIMARY	PRIMARY	4	NULL	20000	Using where
1	PRIMARY	<derived2>	ref	key0	key0	5	test.d.id	1	
2	DERIVED	fact2	ALL_parallel	dim_id	NULL	NULL	NULL	200000	Using where; Using temporary; Using filesort
FLUSH STATUS;
SELECT COUNT(*), SUM(dn.s) FROM dim2 d,
(SELECT dim_id, SUM(val) s FROM fact2 GROUP BY dim_id) dn
WHERE dn.dim_id = d.id AND d.id > 10000;
COUNT(*)	SUM(dn.s)
10000	49950000
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
WHERE VARIABLE_NAME = 'Parallel_queries_executed';
ran_in_the_workers
1
SET SESSION join_cache_level= @save_jcl;
SET SESSION parallel_worker_threads= @save_pwt;
DROP TABLE dim, fact, dim2, fact2, tag;
