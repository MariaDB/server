--source include/not_embedded.inc

CREATE USER IF NOT EXISTS u1@localhost IDENTIFIED BY 'pw1';
SELECT plugin,authentication_string FROM mysql.user WHERE user='u1';

CREATE USER IF NOT EXISTS u1@localhost IDENTIFIED BY 'pw2';
SELECT plugin,authentication_string FROM mysql.user WHERE user='u1';

CREATE OR REPLACE USER u1@localhost IDENTIFIED BY 'pw3';
SELECT plugin,authentication_string FROM mysql.user WHERE user='u1';

--error ER_WRONG_USAGE
CREATE OR REPLACE USER IF NOT EXISTS u1@localhost IDENTIFIED BY 'pw4';
SELECT plugin,authentication_string FROM mysql.user WHERE user='u1';

DROP USER IF EXISTS u1@localhost;
DROP USER IF EXISTS u1@localhost;

--error ER_CANNOT_USER
DROP USER u1@localhost;

CREATE OR REPLACE USER u1@localhost;

--error ER_CANNOT_USER
CREATE USER u1@localhost;

DROP USER u1@localhost;

CREATE USER u1;

--error ER_CANNOT_USER
CREATE USER u1, u2;

--error ER_CANNOT_USER
CREATE USER u2;

--error ER_PASSWD_LENGTH
CREATE OR REPLACE USER u1 IDENTIFIED BY PASSWORD 'password', u2;

CREATE OR REPLACE USER u1 IDENTIFIED BY PASSWORD 'abcdefghijklmnop', u2;

DROP USER u1;
DROP USER IF EXISTS u1, u2;

--error ER_CANNOT_USER
DROP USER u2;

--echo #
--echo # MDEV-37214 CREATE OR REPLACE USER must not drop the existing account
--echo # on failure
--echo #

# A failing OR REPLACE (plugin not loaded) must keep the existing user.
CREATE USER u3@localhost;
--error ER_PLUGIN_IS_NOT_LOADED
CREATE OR REPLACE USER u3@localhost IDENTIFIED VIA no_such_plugin;
--disable_view_protocol
SELECT user FROM mysql.user WHERE user='u3';
--enable_view_protocol
DROP USER u3@localhost;

# A successful OR REPLACE must wipe the old privileges from the other grant
# tables (mysql.db, mysql.tables_priv, etc.).
CREATE USER u3@localhost IDENTIFIED BY 'pw1';
GRANT SELECT ON test.* TO u3@localhost;
CREATE TABLE test.t1 (id INT);
GRANT SELECT ON test.t1 TO u3@localhost;
SELECT user,db FROM mysql.db WHERE user='u3';
SELECT db,table_name FROM mysql.tables_priv WHERE user='u3';
CREATE OR REPLACE USER u3@localhost IDENTIFIED BY 'pw2';
SELECT plugin,authentication_string FROM mysql.user WHERE user='u3';
SELECT user,db FROM mysql.db WHERE user='u3';
SELECT db,table_name FROM mysql.tables_priv WHERE user='u3';
DROP TABLE test.t1;
DROP USER u3@localhost;

# OR REPLACE without an IDENTIFIED clause must produce a fresh account, not a
# password-expired one (an unset password_last_changed reads back as 0, which
# means "manually expired").
CREATE USER u3@localhost IDENTIFIED BY 'pw1';
SELECT password_expired FROM mysql.user WHERE user='u3';
CREATE OR REPLACE USER u3@localhost;
SELECT password_expired FROM mysql.user WHERE user='u3';
DROP USER u3@localhost;

# A failing OR REPLACE must not touch the privileges either.
CREATE USER u3@localhost IDENTIFIED BY 'pw1';
GRANT SELECT ON test.* TO u3@localhost;
CREATE TABLE test.t1 (id INT);
GRANT SELECT ON test.t1 TO u3@localhost;
--error ER_PLUGIN_IS_NOT_LOADED
CREATE OR REPLACE USER u3@localhost IDENTIFIED VIA no_such_plugin;
--disable_view_protocol
SELECT user FROM mysql.user WHERE user='u3';
--enable_view_protocol
SELECT user,db FROM mysql.db WHERE user='u3';
SELECT db,table_name FROM mysql.tables_priv WHERE user='u3';
DROP TABLE test.t1;
DROP USER u3@localhost;

# The replaced account must not keep its old global privileges.
CREATE USER u3@localhost IDENTIFIED BY 'pw1';
GRANT RELOAD ON *.* TO u3@localhost;
SHOW GRANTS FOR u3@localhost;
CREATE OR REPLACE USER u3@localhost IDENTIFIED BY 'pw2';
SHOW GRANTS FOR u3@localhost;
DROP USER u3@localhost;

# Orphan privileges (rows in the grant tables with no matching mysql.user
# row) must be cleaned up, so the new account does not inherit them.
INSERT INTO mysql.db (Host,Db,User,Select_priv) VALUES ('localhost','test','orph','Y');
SELECT user,db FROM mysql.db WHERE user='orph';
CREATE OR REPLACE USER orph@localhost IDENTIFIED BY 'pw1';
SELECT user,db FROM mysql.db WHERE user='orph';
DROP USER orph@localhost;

# Replacing an account that was granted a role must drop the role grant and
# leave the in-memory role/user cross references consistent.
CREATE ROLE r1;
CREATE USER ur@localhost IDENTIFIED BY 'pw1';
GRANT r1 TO ur@localhost;
SELECT user,role FROM mysql.roles_mapping WHERE user='ur';
SHOW GRANTS FOR ur@localhost;
CREATE OR REPLACE USER ur@localhost IDENTIFIED BY 'pw2';
SELECT user,role FROM mysql.roles_mapping WHERE user='ur';
# the in-memory structures, not only the table
SHOW GRANTS FOR ur@localhost;
connect (con_ur,localhost,ur,pw2);
--error ER_INVALID_ROLE
SET ROLE r1;
disconnect con_ur;
connection default;
DROP ROLE r1;
DROP USER ur@localhost;

# OR REPLACE is DROP IF EXISTS + CREATE: whatever the statement doesn't
# mention (password, resource limits, lock status) goes back to its default.
CREATE USER u1@localhost IDENTIFIED BY 'secret' WITH MAX_USER_CONNECTIONS 5 MAX_QUERIES_PER_HOUR 100;
ALTER USER u1@localhost ACCOUNT LOCK;
SHOW CREATE USER u1@localhost;
CREATE OR REPLACE USER u1@localhost;
SHOW CREATE USER u1@localhost;
SELECT plugin,authentication_string FROM mysql.user WHERE user='u1';
DROP USER u1@localhost;

# An error for one account of a multi-account statement must not make the
# accounts after it fail. The first error is what the client gets, once.
--error ER_PLUGIN_IS_NOT_LOADED
CREATE USER bad@localhost IDENTIFIED VIA no_such_plugin, good@localhost IDENTIFIED BY 'pw1';
SHOW WARNINGS;
--disable_view_protocol
SELECT user FROM mysql.user WHERE user IN ('bad','good');
--enable_view_protocol
DROP USER good@localhost;

CREATE USER u5@localhost IDENTIFIED BY 'pw1';
--error ER_PLUGIN_IS_NOT_LOADED
CREATE OR REPLACE USER bad@localhost IDENTIFIED VIA no_such_plugin, u5@localhost IDENTIFIED BY 'pw2';
SHOW WARNINGS;
SELECT authentication_string FROM mysql.user WHERE user='u5';
DROP USER u5@localhost;

--echo # End of 10.11 tests
