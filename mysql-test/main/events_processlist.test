--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_embedded.inc

--echo #
--echo # MDEV-34482 visibility of event worker threads to non-privileded user
--echo #

# Verify that a user without PROCESS privilege can see their own events
# run by event scheduler.

CREATE USER u@localhost;
GRANT EVENT ON *.* TO u@localhost;

# Ensure event scheduler running
SET GLOBAL event_scheduler = ON;
--source include/running_event_scheduler.inc

# Connect as the unprivileged user and create an event that runs a long sleep
connect c1,localhost,u,,;

CREATE EVENT e
  ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 0.1 SECOND
  DO SELECT SLEEP(10000);

# Wait until the event worker appears in PROCESSLIST for the current user
let $wait_condition= SELECT COUNT(*) = 1 FROM INFORMATION_SCHEMA.PROCESSLIST
                     WHERE INFO LIKE '%SLEEP(10000)%' AND ID <> CONNECTION_ID()
                       AND STATE='User sleep';
--source include/wait_condition.inc

# Check that show processlist works
--replace_column 1 #
--replace_regex /:[0-9]+// /Execute/Query/
show processlist;

# Stop event execution
let $id= `SELECT ID FROM INFORMATION_SCHEMA.PROCESSLIST WHERE INFO LIKE '%SLEEP(10000)%' AND ID <> CONNECTION_ID()`;
--replace_result $id id
eval KILL QUERY $id;

# Cleanup
--disconnect c1
--connection default

SET GLOBAL event_scheduler = OFF;
--error 0,ER_EVENT_DOES_NOT_EXIST
DROP EVENT e;
--source include/check_events_off.inc
let $count_sessions= 1;
--source include/wait_until_count_sessions.inc
DROP USER u@localhost;

--echo #
--echo # MDEV-39146 processlist_callback() dereferences a stale
--echo # Security_context, racing a DEFINER switch that used to be
--echo # stack-allocated in Event_job_data::execute().
--echo #

CREATE USER definer@localhost;
GRANT EVENT ON *.* TO definer@localhost;
GRANT SUPER ON *.* TO definer@localhost;

SET DEBUG_SYNC= 'RESET';

--echo # Per-session DEBUG_SYNC: must arm from inside the event body (its own
--echo # thd), not from another connection.
--delimiter |
CREATE DEFINER=definer@localhost EVENT ev
ON SCHEDULE AT CURRENT_TIMESTAMP
DO
BEGIN
  SET DEBUG_SYNC= 'event_worker_thread_after_execute_returned SIGNAL event_execute_returned';
  SET DEBUG_SYNC= 'now SIGNAL definer_ctx_active WAIT_FOR event_may_finish';
END|
--delimiter ;

SET GLOBAL event_scheduler= ON;

--echo # Connect 'waiter' now: iterate() holds server_threads' rwlock for the
--echo # whole scan; connecting after would deadlock (needs that lock's
--echo # write side).
connect (waiter, localhost, root,,);
connection default;

SET DEBUG_SYNC= 'now WAIT_FOR definer_ctx_active';

--echo # Pause right after processlist_callback() captures the
--echo # DEFINER-switched security_ctx, before USER/HOST are read.
SET @saved_dbug= @@SESSION.debug_dbug;
SET SESSION debug_dbug= '+d,processlist_callback_pause_after_sctx_capture';
SET DEBUG_SYNC= 'processlist_callback_captured_sctx SIGNAL scanner_captured WAIT_FOR let_scanner_continue';

--echo # Filter by name, not row count -- asserts the corrupted value itself
--echo # comes back correct.
--send SELECT user, host FROM information_schema.processlist WHERE user = 'definer'

connection waiter;
SET DEBUG_SYNC= 'now WAIT_FOR scanner_captured';

--echo # Let the event finish, then wait for execute() to actually return --
--echo # where its old stack-local Security_context (pre-fix) would have
--echo # been gone for good. Generous timeout: nothing blocks the event
--echo # from finishing quickly, this fix adds no locking.
SET DEBUG_SYNC= 'now SIGNAL event_may_finish WAIT_FOR event_execute_returned TIMEOUT 60';

--echo # Release the scanner to dereference the pointer it captured.
SET DEBUG_SYNC= 'now SIGNAL let_scanner_continue';

--disconnect waiter
--connection default
--reap

SET SESSION debug_dbug= @saved_dbug;
SET DEBUG_SYNC= 'RESET';

SET GLOBAL event_scheduler= OFF;
--error 0,ER_EVENT_DOES_NOT_EXIST
DROP EVENT ev;
--source include/check_events_off.inc
let $count_sessions= 1;
--source include/wait_until_count_sessions.inc
DROP USER definer@localhost;

--echo # End of 10.11 tests
