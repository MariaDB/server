# One fit and one unfit MVI
# restart: --innodb-ft-min-token-size=4 --innodb-ft-max-token-size=84
create table t1 (c int, j1 json, j2 json,
key idx_n ((CAST(j1->'$.n' AS INT ARRAY))),
key idx_t ((CAST(j2->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
insert into t1 values (1,'{"n": [1, 42]}','{"tags": ["aaa"]}');
# Raise the minimum to 8. The INT keys still fit, the CHAR ones,
# which can be 4 characters long, no longer do.
# restart: --innodb-ft-min-token-size=8
select @@innodb_ft_min_token_size=8;
@@innodb_ft_min_token_size=8
1
# The optimizer uses the index that fits and leaves the other alone
explain select c from t1 where json_contains(j1->'$.n', '42');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	idx_n	idx_n	0	NULL	#	Using where
explain select c from t1 where json_contains(j2->'$.tags', '"aaa"');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	#	Using where
# Updating the column the fitting index is over writes only its
# keys, and those keys the engine will hold
update t1 set j1= '{"n": [1, 43]}' where c=1;
# TODO: a write to the other index's column, and an INSERT, have to
# be refused. See above and TABLE::update_virtual_fields().
# A column no index is over is free
update t1 set c= 2 where c=1;
select c, j1, j2 from t1;
c	j1	j2
2	{"n": [1, 43]}	{"tags": ["aaa"]}
drop table t1;
