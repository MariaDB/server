# An INT array has keys of exactly 16 characters, which do fit
create table t1 (c int, j json,
key idx ((CAST(j->'$.n' AS INT ARRAY))))engine=innodb;
insert into t1 values (1,'{"n": [1, 42]}'),(2,'{"n": [42, 43]}'),
(3,'{"n": [7]}');
explain select * from t1 where json_contains(j->'$.n', '42');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	range	idx	idx	0	NULL	#	Using where
select * from t1 where json_contains(j->'$.n', '42') order by c;
c	j
1	{"n": [1, 42]}
2	{"n": [42, 43]}
# the same rows without the index:
select * from t1 ignore index(idx)
where json_contains(j->'$.n', '42') order by c;
c	j
1	{"n": [1, 42]}
2	{"n": [42, 43]}
# Adding one whose keys do not fit is refused, and so is an ALTER
# that would rebuild it.
alter table t1 add key idx2 ((CAST(j->'$.tags' AS CHAR(6) ARRAY)));
ERROR HY000: A multi-valued index over this expression has keys of 4 to 82 characters, outside what InnoDB indexes (8 to 20). Adjust the fulltext token size settings
# An ALTER that rebuilds the table keeps the index that fits
alter table t1 add column x int;
alter table t1 drop column x;
# The same index under limits it no longer fits is one the
# optimizer has to leave alone, or it
# could be searching for keys the engine may have dropped. The
# rows must not change.
# restart: --innodb-ft-max-token-size=10
select @@innodb_ft_max_token_size=10;
@@innodb_ft_max_token_size=10
1
explain select * from t1 where json_contains(j->'$.n', '42');
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	#	Using where
select c from t1 where json_contains(j->'$.n', '42') order by c;
c
1
2
# TODO: leaving the index alone is not enough. A row written now
# would have no key in it, and the keys are dropped as they are
# written rather than while they are searched for, so the row would
# be missing from the index for good: a corrupted index. The write
# used to be refused where the internal column that held the keys
# was computed, and there is no such column any more -- see the TODO
# in TABLE::update_virtual_fields(). Nothing refuses it in the
# meantime, so the writes that have to be refused are not tested
# here.
# An update that leaves the indexed expression alone leaves the
# index alone as well, so it is allowed
update t1 set c= 4 where c=3;
update t1 set c= 3 where c=4;
# Reading and deleting stay allowed
select c from t1 where json_contains(j->'$.n', '7') order by c;
c
3
delete from t1 where c=3;
select c from t1 order by c;
c
1
2
# Back under limits the index fits. The optimizer uses it again,
# and it has an entry for every row -- every row was written while
# the limits it fits were in force.
# restart: --innodb-ft-max-token-size=20
select @@innodb_ft_max_token_size=20;
@@innodb_ft_max_token_size=20
1
