#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES armscii8 COLLATE armscii8_general_ci;
# ASCII digits
d
1
# ASCII minus, dot and digits
e
-1.5
SELECT c FROM v_tailoring WHERE c='Y';
c
Y
SELECT c FROM v_tailoring WHERE c<>'Y_';
c
Y
SELECT c FROM v_tailoring WHERE c<>'Y+';
c
Y
SET NAMES armscii8 COLLATE armscii8_bin;
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (armscii8_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
