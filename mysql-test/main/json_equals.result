CREATE PROCEDURE p1()
BEGIN
IF JSON_EQUALS(NULL, '{}') THEN SELECT 'T' AS sp_if;
ELSE SELECT 'F' AS sp_if;
END IF;
END|
CALL p1();
sp_if
F
DROP PROCEDURE p1;
