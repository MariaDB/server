# MDEV-40067: mysqldump --sys-triggers creates unloadable dump
#
CREATE TRIGGER trg1 AFTER STARTUP SET @x=1;
DROP TRIGGER trg1;
SHOW CREATE TRIGGER trg1;
Trigger	sql_mode	SQL Original Statement	character_set_client	collation_connection	Database Collation	Created
trg1	STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION	CREATE DEFINER=`root`@`localhost` TRIGGER `trg1` AFTER STARTUP SET @x=1	latin1	latin1_swedish_ci	utf8mb4_uca1400_ai_ci	#
DROP TRIGGER trg1;
#
# MDEV-40072: Server crashes in my_hash_first/name_hash_search after load_system_triggers
#
CREATE USER a1@localhost;
CREATE TABLE t1 (a VARCHAR(30));
GRANT SUPER ON *.* TO a1@localhost;
GRANT INSERT ON test.* TO a1@localhost;
connect  c1, localhost, a1,, test;
CREATE TRIGGER tr1 AFTER STARTUP INSERT INTO t1 VALUES ('Fired on startup trigger');
CREATE TRIGGER tr2 BEFORE SHUTDOWN INSERT INTO t1 VALUES ('Fired on shutdown trigger');
connection default;
disconnect c1;
# restart
SELECT * FROM t1;
a
Fired on shutdown trigger
Fired on startup trigger
DROP TRIGGER tr1;
DROP TRIGGER tr2;
DROP TABLE t1;
DROP USER a1@localhost;
#
# MDEV-40951: System triggers give no visibility into slow/failed execution and misreport server readiness
#
CREATE TRIGGER tr1 AFTER STARTUP INSERT INTO t1 VALUES ('Shutdown');
# restart
# Clean up
DROP TRIGGER tr1;
#
# Check that DROP TRIGGER and SHOW CREATE TRIGGER statement
# don't touch event with the same name
#
CREATE EVENT trg1 ON SCHEDULE EVERY 1 YEAR STARTS CURRENT_TIMESTAMP + INTERVAL 1 MONTH DO SELECT 1;
Warnings:
Warning	1105	Event scheduler is switched off, use SET GLOBAL event_scheduler=ON to enable it.
SHOW CREATE TRIGGER trg1;
ERROR HY000: Trigger does not exist
DROP TRIGGER trg1;
ERROR HY000: Trigger does not exist
DROP EVENT trg1;
#
# Check that the statements SHOW CREATE EVENT, DROP EVENT, ALTER EVENT
# SHOW EVENTS don't touch triggers with the name
#
CREATE TRIGGER trg1 BEFORE SHUTDOWN SET @a=1;
SHOW CREATE EVENT trg1;
ERROR HY000: Unknown event 'trg1'
ALTER EVENT trg1 COMMENT 'The trigger';
ERROR HY000: Unknown event 'trg1'
DROP EVENT trg1;
ERROR HY000: Unknown event 'trg1'
# No events in the output
SHOW EVENTS;
Db	Name	Definer	Time zone	Type	Execute at	Interval value	Interval field	Starts	Ends	Status	Originator	character_set_client	collation_connection	Database Collation
# Clean up
DROP TRIGGER trg1;
