#
# MDEV-41258: Assertion in get_table_def_key() upon EXECUTE of INSERT
#             into a table with DEFAULT NEXTVAL() after FLUSH TABLES
#
CREATE SEQUENCE s1;
CREATE SEQUENCE s2 START WITH 100;
CREATE TABLE t1 (a INT DEFAULT NEXTVAL(s1),
b INT DEFAULT (NEXTVAL(s1) + NEXTVAL(s2)),
c INT DEFAULT NEXTVAL(s2),
x INT);
PREPARE stmt FROM "INSERT INTO t1 (x) VALUES (?) RETURNING a, b, c, x";
EXECUTE stmt USING 1;
a	b	c	x
1	102	101	1
FLUSH TABLES;
EXECUTE stmt USING 2;
a	b	c	x
1001	2102	1101	2
FLUSH TABLES;
EXECUTE stmt USING 3;
a	b	c	x
2001	4102	2101	3
# Another connection holds the TABLE used by the previous execution
connect con1,localhost,root,,;
HANDLER t1 OPEN;
connection default;
EXECUTE stmt USING 4;
a	b	c	x
2003	4106	2103	4
connection con1;
HANDLER t1 CLOSE;
disconnect con1;
connection default;
EXECUTE stmt USING 5;
a	b	c	x
2005	4110	2105	5
DEALLOCATE PREPARE stmt;
SELECT * FROM t1 ORDER BY x;
a	b	c	x
1	102	101	1
1001	2102	1101	2
2001	4102	2101	3
2003	4106	2103	4
2005	4110	2105	5
CREATE TABLE t2 (a INT DEFAULT NEXTVAL(s1), x INT);
INSERT INTO t2 (x) VALUES (1);
UPDATE t1 SET a = 0;
PREPARE stmt FROM "UPDATE t1, t2 SET t1.a = DEFAULT, t2.a = DEFAULT WHERE t1.x = 1";
EXECUTE stmt;
FLUSH TABLES;
EXECUTE stmt;
SELECT a, x FROM t1 WHERE x = 1;
a	x
3001	1
SELECT * FROM t2;
a	x
3002	1
DEALLOCATE PREPARE stmt;
PREPARE stmt FROM "UPDATE t1 SET a = DEFAULT WHERE x = 2";
EXECUTE stmt;
FLUSH TABLES;
EXECUTE stmt;
SELECT a, x FROM t1 WHERE x = 2;
a	x
4001	2
DEALLOCATE PREPARE stmt;
DELETE FROM t2;
PREPARE stmt FROM "INSERT INTO t2 SELECT DEFAULT(a), x FROM t1 WHERE x = 3";
EXECUTE stmt;
FLUSH TABLES;
EXECUTE stmt;
SELECT * FROM t2;
a	x
4002	3
5001	3
DEALLOCATE PREPARE stmt;
PREPARE stmt FROM "UPDATE t1 SET a = ? WHERE x = 4";
EXECUTE stmt USING DEFAULT;
FLUSH TABLES;
EXECUTE stmt USING 0;
FLUSH TABLES;
EXECUTE stmt USING DEFAULT;
SELECT a, x FROM t1 WHERE x = 4;
a	x
6001	4
DEALLOCATE PREPARE stmt;
DROP TABLE t1, t2;
DROP SEQUENCE s1, s2;
# End of 11.4 tests
