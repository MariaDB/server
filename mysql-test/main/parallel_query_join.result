CREATE TABLE fact (id INT, dim1 INT, dim2 INT, val INT) ENGINE=InnoDB;
INSERT INTO fact
SELECT seq, seq % 50 + 1, seq % 20 + 1, seq * 3 FROM seq_1_to_5000;
CREATE TABLE d1 (id INT PRIMARY KEY, name VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO d1 SELECT seq, CONCAT('n', seq) FROM seq_1_to_50;
CREATE TABLE d2 (k INT, label VARCHAR(20), KEY(k)) ENGINE=InnoDB;
INSERT INTO d2 SELECT seq % 20 + 1, CONCAT('L', seq) FROM seq_1_to_60;
CREATE TABLE d3 (x INT, descr VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO d3 SELECT seq, CONCAT('D', seq) FROM seq_1_to_20;
SET @s= @@session.parallel_worker_threads;
SET @save_os= @@session.optimizer_switch;
SET SESSION optimizer_switch='derived_merge=off';
#
# eq_ref: fact STRAIGHT_JOIN d1 on PK
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,name))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,name))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d1.name FROM fact f, d1 WHERE d1.id=f.dim1 AND f.val>100) d;
n	crc_sum	crc_xor
4967	10669458711950	378878442
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,name))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,name))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d1.name FROM fact f, d1 WHERE d1.id=f.dim1 AND f.val>100) d;
n	crc_sum	crc_xor
4967	10669458711950	378878442
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# ref with fan-out: fact STRAIGHT_JOIN d2 on a non-unique key
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,label))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,label))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d2.label FROM fact f, d2 WHERE d2.k=f.dim2 AND f.id<=2000) d;
n	crc_sum	crc_xor
6000	12894493646349	175871363
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,label))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,label))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d2.label FROM fact f, d2 WHERE d2.k=f.dim2 AND f.id<=2000) d;
n	crc_sum	crc_xor
6000	12894493646349	175871363
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# 3-table chain: fact STRAIGHT_JOIN d1 STRAIGHT_JOIN d2
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,name,label))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,name,label))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d1.name, d2.label FROM fact f, d1, d2 WHERE d1.id=f.dim1 AND d2.k=f.dim2 AND f.id<=1000) d;
n	crc_sum	crc_xor
3000	6480938084639	1121476651
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,name,label))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,name,label))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d1.name, d2.label FROM fact f, d1, d2 WHERE d1.id=f.dim1 AND d2.k=f.dim2 AND f.id<=1000) d;
n	crc_sum	crc_xor
3000	6480938084639	1121476651
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# non-indexed inner table (d3, full scan): fact STRAIGHT_JOIN d3
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,descr))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,descr))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d3.descr FROM fact f, d3 WHERE d3.x=f.dim2 AND f.id<=500) d;
n	crc_sum	crc_xor
500	1068012338039	1358147935
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',id,descr))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',id,descr))) AS crc_xor FROM (SELECT STRAIGHT_JOIN f.id, d3.descr FROM fact f, d3 WHERE d3.x=f.dim2 AND f.id<=500) d;
n	crc_sum	crc_xor
500	1068012338039	1358147935
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
SET SESSION optimizer_switch= @save_os;
#
# small deterministic spot-check, run worker-side (sorted for stability)
#
SET SESSION parallel_worker_threads=4;
SELECT STRAIGHT_JOIN f.id, f.dim1, d1.name, d2.label
FROM fact f, d1, d2
WHERE d1.id=f.dim1 AND d2.k=f.dim2 AND f.id IN (1, 2, 21);
id	dim1	name	label
1	2	n2	L1
1	2	n2	L21
1	2	n2	L41
2	3	n3	L2
2	3	n3	L22
2	3	n3	L42
21	22	n22	L1
21	22	n22	L21
21	22	n22	L41
#
# confirm the optimizer chooses worker-side for a multi-table join
#
SET @ot= @@optimizer_trace;
SET optimizer_trace='enabled=on';
SELECT STRAIGHT_JOIN f.id, d1.name FROM fact f, d1 WHERE d1.id=f.dim1;
# expect 1
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL AS chosen
FROM information_schema.optimizer_trace;
chosen
1
CREATE TEMPORARY TABLE ctas ENGINE=InnoDB AS
SELECT STRAIGHT_JOIN f.id, d1.name FROM fact f, d1 WHERE d1.id=f.dim1;
# CTAS chosen by the optimizer (expect 1); it runs serially, see parallel_query_fallback
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL AS ctas_chosen
FROM information_schema.optimizer_trace;
ctas_chosen
1
DROP TEMPORARY TABLE ctas;
SET optimizer_trace= @ot;
#
# an inner table whose condition was partly pushed into the index
#
CREATE TABLE p1 (pk INT PRIMARY KEY, a INT, b INT, INDEX idx1(b)) ENGINE=InnoDB
STATS_AUTO_RECALC=0;
INSERT INTO p1 VALUES (1,6,0),(2,1,0),(3,5,2),(4,8,0);
CREATE TABLE p2 (c INT) ENGINE=InnoDB STATS_AUTO_RECALC=0;
INSERT INTO p2 VALUES (1),(2);
CREATE TABLE p3 (d INT) ENGINE=InnoDB STATS_AUTO_RECALC=0;
INSERT INTO p3 VALUES (3),(-1),(4);
SET @os2= @@optimizer_switch;
SET optimizer_switch='extended_keys=on';
# serial
SET SESSION parallel_worker_threads= 0;
SELECT pk, a, b FROM p1,p2,p3 WHERE b >= d AND pk < c AND b = '0';
pk	a	b
1	6	0
# with workers: the same one row, not one per unfiltered pair
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT pk, a, b FROM p1,p2,p3 WHERE b >= d AND pk < c AND b = '0';
pk	a	b
1	6	0
# and it still ran in the workers rather than falling back (expect 1)
ran_in_the_workers
1
# p1 still carries a pushed index condition, so the case is really covered
EXPLAIN SELECT pk, a, b FROM p1,p2,p3 WHERE b >= d AND pk < c AND b = '0';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	p2	PARALLEL	NULL	NULL	NULL	NULL	#	
1	SIMPLE	p1	ref	PRIMARY,idx1	idx1	5	const	#	Using index condition
1	SIMPLE	p3	ALL	NULL	NULL	NULL	NULL	#	Using where; Using join buffer (flat, BNL join)
SET optimizer_switch= @os2;
DROP TABLE p1, p2, p3;
SET SESSION parallel_worker_threads= @s;
DROP TABLE fact, d1, d2, d3;
