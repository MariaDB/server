#
# 7. A chain padded until its length says nothing about it - each
#    level here is fourteen characters, so half the length is
#    seven times the limit and only a count can tell one of these
#    from the other
#
SET @k31= CONCAT(REPEAT(CONCAT('{"', REPEAT('k', 10), '":'), 31),
'1', REPEAT('}', 31));
SET @k30= CONCAT(REPEAT(CONCAT('{"', REPEAT('k', 10), '":'), 30),
'1', REPEAT('}', 30));
SELECT JSON_ARRAY(JSON_EXTRACT(@k31, '$')) AS padded_deep;
SELECT JSON_DEPTH(JSON_ARRAY(JSON_EXTRACT(@k31, '$'))) AS padded_deep_depth;
padded_deep_depth
