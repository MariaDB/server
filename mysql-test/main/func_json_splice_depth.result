#
# 5. A value written out by hand is a string rather than a
#    document, so it goes in quoted and takes one level whatever
#    is written in it
#
SELECT JSON_REPLACE(JSON_EXTRACT(@d30, '$'), @p30, '{"b":{"c":1}}') AS quoted;
quoted
{"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": {"a": "{\"b\":{\"c\":1}}"}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
#
# 6. A function that BUILDS a document puts the value one level
#    inside the array or object it is making
#
SET @d31= CONCAT(REPEAT('[', 31), '1', REPEAT(']', 31));
SET @d30a= CONCAT(REPEAT('[', 30), '1', REPEAT(']', 30));
SELECT JSON_ARRAY(JSON_EXTRACT(@d31, '$')) AS built_deep;
built_deep
