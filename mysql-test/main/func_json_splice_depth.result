#
#     The functions that wrap while INSERTING name the place they
#     are inserting at, so reaching this far down takes a path one
#     step longer than a path is allowed to be, and the path is
#     what refuses them.  Appending names the value instead and
#     needs no step for the array it adds, which is why it is the
#     one that gets here.
#
SELECT JSON_INSERT(JSON_EXTRACT(@w31, '$'), CONCAT(@wp31, '[1]'), 2)
AS insert_wrap_deep;
insert_wrap_deep
