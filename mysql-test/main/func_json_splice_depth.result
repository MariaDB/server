#
# 9. A document that was EDITED is as deep as it was or as deep as
#    what went into it, whichever is more, and says so without
#    being read again
#
SET @k29= CONCAT(REPEAT(CONCAT('{"', REPEAT('k', 10), '":'), 29),
'1', REPEAT('}', 29));
SET @k28= CONCAT(REPEAT(CONCAT('{"', REPEAT('k', 10), '":'), 28),
'1', REPEAT('}', 28));
SET @kp29= CONCAT('$', REPEAT(CONCAT('.', REPEAT('k', 10)), 29));
SET @kp28= CONCAT('$', REPEAT(CONCAT('.', REPEAT('k', 10)), 28));
SELECT JSON_ARRAY(JSON_REPLACE(JSON_EXTRACT(@k28, '$'), @kp28,
JSON_EXTRACT('{"b":{"c":1}}', '$')))
AS edited_limit;
SELECT JSON_DEPTH(JSON_ARRAY(JSON_REPLACE(JSON_EXTRACT(@k28, '$'), @kp28,
JSON_EXTRACT('{"b":{"c":1}}', '$'))))
AS edited_limit_depth;
edited_limit_depth
