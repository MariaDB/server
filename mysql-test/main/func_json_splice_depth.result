#
# 4. The same through a document answering is_valid false, which is
#    read back in full and so is where the limit has always been
#    noticed
#
SELECT JSON_REPLACE(@d30, @p30, JSON_EXTRACT('{"b":{"c":1}}', '$')) AS raw_deep;
raw_deep
