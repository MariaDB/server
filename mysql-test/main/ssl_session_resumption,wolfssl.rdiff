--- a/mysql-test/main/ssl_session_resumption.result
+++ b/mysql-test/main/ssl_session_resumption.result
@@ -12,7 +12,7 @@ RESUMED
 select (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_session_cache_hits') - @hits as 'hits increase',
 (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_used_session_cache_entries') - @stored as 'stored on the server';
 hits increase	stored on the server
-1	0
+0	0
 #
 # TLS 1.2, session id. Unlike a ticket, this session is also stored in
 # the server side cache, so it is the only case that fills it up
@@ -25,7 +25,7 @@ RESUMED
 select (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_session_cache_hits') - @hits as 'hits increase',
 (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_used_session_cache_entries') - @stored as 'stored on the server';
 hits increase	stored on the server
-1	1
+0	0
 #
 # TLS 1.3, session ticket. No session id resumption exists in TLS 1.3,
 # so like a TLS 1.2 ticket it leaves nothing on the server
@@ -38,7 +38,7 @@ RESUMED
 select (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_session_cache_hits') - @hits as 'hits increase',
 (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_used_session_cache_entries') - @stored as 'stored on the server';
 hits increase	stored on the server
-1	0
+0	0
 #
 # A session cannot be resumed across FLUSH SSL: it replaces the
 # acceptor context, and with it the session cache and the ticket keys
@@ -51,7 +51,7 @@ RESUMED
 select (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_session_cache_hits') - @hits as 'hits increase',
 (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME= 'Ssl_used_session_cache_entries') - @stored as 'stored on the server';
 hits increase	stored on the server
-1	0
+0	0
 FLUSH SSL;
 openssl s_client -ign_eof -tls1_3 -sess_in tls_session.pem
 FULL
