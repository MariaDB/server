CREATE TABLE dim (id INT PRIMARY KEY, name VARCHAR(10)) ENGINE=InnoDB;
INSERT INTO dim VALUES (1,'one'),(2,'two'),(3,'three'),(4,'four'),(5,'five');
CREATE TABLE fact (id INT PRIMARY KEY, dim_id INT, val INT, KEY(dim_id))
ENGINE=InnoDB;
INSERT INTO fact SELECT seq, seq % 5 + 1, seq % 1000 FROM seq_1_to_20000;
CREATE TABLE other (id INT PRIMARY KEY, flag INT) ENGINE=InnoDB;
INSERT INTO other SELECT seq, seq % 2 FROM seq_1_to_20000;
ANALYZE TABLE dim, fact, other PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.dim	analyze	status	Engine-independent statistics collected
test.dim	analyze	status	OK
test.fact	analyze	status	Engine-independent statistics collected
test.fact	analyze	status	OK
test.other	analyze	status	Engine-independent statistics collected
test.other	analyze	status	OK
SET @save_pwt= @@session.parallel_worker_threads;
SET @save_cost= @@session.optimizer_parallel_setup_cost;
SET @save_jcl= @@session.join_cache_level;
SET @save_trace= @@optimizer_trace;
SET SESSION join_cache_level= 0;
SET SESSION optimizer_parallel_setup_cost= 100;
#
# The serial answers.
#
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1);
COUNT(*)	SUM(f.val)
100	2000
SELECT d.name, COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1)
GROUP BY d.name;
name	COUNT(*)	SUM(f.val)
five	100	2400
four	100	2800
one	100	2000
three	100	2200
two	100	2600
