#
# Whole-table aggregation: the fact table is divided, the dimension is
# looked up per row, the NOT EXISTS is left to the manager, and the
# trace names it.
#
SET SESSION parallel_worker_threads= 4;
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	f	ALL_parallel	dim_id	NULL	NULL	NULL	20000	Using where
1	PRIMARY	d	eq_ref	PRIMARY	PRIMARY	4	test.f.dim_id	1	Using where
2	DEPENDENT SUBQUERY	o	unique_subquery	PRIMARY	PRIMARY	4	func	1	Using where
SET SESSION optimizer_trace=1;
SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1);
SELECT JSON_EXTRACT(trace, '$**.parallel_scan_manager_evaluates') AS manager_evaluates,
JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') AS divided
FROM information_schema.optimizer_trace;
manager_evaluates	divided
["!<expr_cache><f.`id`>(<in_optimizer>(f.`id`,<exists>(<primary_index_lookup>(<cache>(f.`id`) in other on PRIMARY where o.flag = 1 and <cache>(f.`id`) = o.`id`))))"]	["f"]
SET SESSION optimizer_trace=@save_trace;
FLUSH STATUS;
SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1);
COUNT(*)	SUM(f.val)
100	2000
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
WHERE VARIABLE_NAME = 'Parallel_queries_executed';
ran_in_the_workers
1
#
# GROUP BY: the workers ship joined rows rather than partials, the
# manager filters each and groups what is left.
#
FLUSH STATUS;
SELECT d.name, COUNT(*), SUM(f.val) FROM dim d, fact f
WHERE f.dim_id = d.id AND f.val < 50
AND NOT EXISTS (SELECT 1 FROM other o WHERE o.id = f.id AND o.flag = 1)
GROUP BY d.name;
name	COUNT(*)	SUM(f.val)
