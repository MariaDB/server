# run mysql_client_test with performance schema

# No need to run this with embedded server
--source include/not_embedded.inc
--source include/check_ipv6.inc
--source include/no_valgrind_without_big.inc

# need to have the dynamic loading turned on for the client plugin tests
--source include/have_plugin_auth.inc

SET @old_slow_query_log= @@global.slow_query_log;

call mtr.add_suppression(" Error reading file './client_test_db/test_frm_bug.frm'");
call mtr.add_suppression(" IP address .* could not be resolved");
call mtr.add_suppression("Failed to parse proxy header");
call mtr.add_suppression("Proxy header is not accepted from ");
call mtr.add_suppression("Host '192.0.2.50' is blocked because of many connection errors");
call mtr.add_suppression("Host '2001:db8::6:6' is blocked because of many connection errors");
call mtr.add_suppression("Host '192.0.2.22[234]' is not allowed to connect to this MariaDB server");
call mtr.add_suppression("Host '1.2.3.4' is not allowed to connect to this MariaDB server");
--write_line "$MYSQL_CLIENT_TEST" $MYSQLTEST_VARDIR/log/mysql_client_test_comp.out.log
--exec $MYSQL_CLIENT_TEST --getopt-ll-test=25600M >> $MYSQLTEST_VARDIR/log/mysql_client_test_comp.out.log 2>&1

# End of test
echo ok;

# Restore state changed by mysql_test_run
SET @@global.slow_query_log= @old_slow_query_log;
