#
# TPC-H Q1, which is what all of this was for: a filtered scan of one
# large table into four SUMs, three AVGs and a COUNT over two group
# columns. Every worker's whole chunk leaves it as six rows.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL, l_partkey INT, l_suppkey INT, l_linenumber INT,
l_quantity DECIMAL(15,2), l_extendedprice DECIMAL(15,2),
l_discount DECIMAL(15,2), l_tax DECIMAL(15,2),
l_returnflag CHAR(1), l_linestatus CHAR(1), l_shipdate DATE,
PRIMARY KEY (l_orderkey, l_linenumber)) ENGINE=InnoDB;
INSERT INTO lineitem
SELECT seq/7+1, seq, seq, seq%7+1, seq%50+1, (seq%2000)*100+1, (seq%8)/100,
(seq%9)/100, ELT(seq%3+1,'A','N','R'), ELT(seq%2+1,'F','O'),
DATE_ADD('1994-01-01', INTERVAL seq%2000 DAY)
FROM seq_1_to_50000;
ANALYZE TABLE lineitem PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.lineitem	analyze	status	Engine-independent statistics collected
test.lineitem	analyze	status	OK
