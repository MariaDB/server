SET @s= @@session.parallel_worker_threads;
SET @t= @@session.tmp_table_size;
SET SESSION optimizer_switch='derived_merge=off';
CREATE TABLE t1 (pk INT PRIMARY KEY, i INT, n INT, d DECIMAL(30,6), r DOUBLE,
c VARCHAR(20)) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq % 997, IF(seq % 100 = 0, NULL, seq % 13), seq,
seq, IF(seq % 250 = 0, NULL, CONCAT('g', seq % 7))
FROM seq_1_to_40000;
CREATE TABLE d1 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO d1 SELECT seq, seq * 10 FROM seq_1_to_50;
ANALYZE TABLE t1, d1 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
test.d1	analyze	status	Engine-independent statistics collected
test.d1	analyze	status	OK
#
# Few groups, every accepted aggregate, and a group whose value is NULL:
# a NULL group is a group, and the key carries a null flag of its own to
# say so.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT c AS g, COUNT(*) a, SUM(i) b, MIN(i) e, MAX(i) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	13086575833	2496208047
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT c AS g, COUNT(*) a, SUM(i) b, MIN(i) e, MAX(i) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	13086575833	2496208047
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
preaggregated_per_scan
1.0000
#
# Two group columns, one of them nullable, and a select list item that is
# an expression over both -- determined by the group, so allowed.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT CONCAT(c,'/',n) AS g, COUNT(*) a, SUM(i) b, MIN(i) e, MAX(i) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY c, n) d;
