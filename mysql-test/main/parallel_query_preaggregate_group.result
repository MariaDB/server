FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a))) AS crc_xor FROM (SELECT c AS g, AVG(i) a FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	22079657190	711055890
