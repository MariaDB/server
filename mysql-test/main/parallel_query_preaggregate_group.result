SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT i AS g, COUNT(*) a, SUM(pk) b, MIN(c) e, MAX(c) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY i) d;
n	crc_sum	crc_xor
997	2126158579643	4159099203
