#
# AVG, whose partial is the (sum, count) pair its field already holds. A
# decimal result and a real one are packed differently and are both here.
# r holds whole numbers so that its average is the same however the
# partials are ordered, which a float sum is not in general.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e))) AS crc_xor FROM (SELECT c AS g, AVG(i) a, AVG(d) b, COUNT(*) e FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	13926905026	4104430970
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e))) AS crc_xor FROM (SELECT c AS g, AVG(i) a, AVG(d) b, COUNT(*) e FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	13926905026	4104430970
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
