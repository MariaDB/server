preaggregated_per_scan
1.0000
#
# A worker's grouping table holds only so many groups. When it fills it
# ships what it has and starts again empty, so a group can arrive from one
# worker more than once -- which merging a partial per group already
# allows for. Squeezed here to a few rows so that it happens constantly.
#
SET SESSION tmp_table_size= 16384;
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT i AS g, COUNT(*) a, SUM(pk) b, MIN(c) e, MAX(c) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY i) d;
n	crc_sum	crc_xor
997	2126158579643	4159099203
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT i AS g, COUNT(*) a, SUM(pk) b, MIN(c) e, MAX(c) f, SUM(d) h, COUNT(n) j FROM t1 GROUP BY i) d;
n	crc_sum	crc_xor
997	2126158579643	4159099203
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
preaggregated_per_scan
1.0000
#
# The manager's own grouping table fills too, and the server answers that
# by moving it to disk and switching to end_unique_update(), which folds a
# partial in a second way. MAX() here is over a column whose value in the
# row the worker shipped is the group's smallest, so a merge that took the
# row in place of the partial would show.
#
CREATE TABLE t2 (pk INT PRIMARY KEY, i INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq % 300 FROM seq_1_to_40000;
ANALYZE TABLE t2 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	Engine-independent statistics collected
test.t2	analyze	status	OK
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, mx, mn))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, mx, mn))) AS crc_xor FROM (SELECT RPAD(i,200,'x') g, MAX(pk) mx, MIN(pk) mn FROM t2 GROUP BY i) d;
n	crc_sum	crc_xor
300	635101422216	1543146004
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, mx, mn))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, mx, mn))) AS crc_xor FROM (SELECT RPAD(i,200,'x') g, MAX(pk) mx, MIN(pk) mn FROM t2 GROUP BY i) d;
n	crc_sum	crc_xor
300	635101422216	1543146004
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
preaggregated_per_scan
1.0000
DROP TABLE t2;
SET SESSION tmp_table_size= @t;
#
# Over a join: each worker groups the rows it assembled from both tables.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT STRAIGHT_JOIN t1.c AS g, COUNT(*) a, SUM(d1.v) b, MIN(d1.v) e, MAX(d1.v) f, SUM(t1.d) h, COUNT(t1.n) j FROM t1, d1 WHERE d1.id = t1.i % 50 + 1 GROUP BY t1.c) d;
n	crc_sum	crc_xor
8	20214234415	2086035825
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT STRAIGHT_JOIN t1.c AS g, COUNT(*) a, SUM(d1.v) b, MIN(d1.v) e, MAX(d1.v) f, SUM(t1.d) h, COUNT(t1.n) j FROM t1, d1 WHERE d1.id = t1.i % 50 + 1 GROUP BY t1.c) d;
n	crc_sum	crc_xor
8	20214234415	2086035825
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
preaggregated_per_scan
1.0000
#
# No qualifying row at all: no worker ships anything and the answer is no
# groups, which is what a serial run sends.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT c AS g, COUNT(*) a, SUM(i) b, MIN(i) e, MAX(i) f, SUM(d) h, COUNT(n) j FROM t1 WHERE i > 999999 GROUP BY c) d;
n	crc_sum	crc_xor
0	NULL	0
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a, b, e, f, h, j))) AS crc_xor FROM (SELECT c AS g, COUNT(*) a, SUM(i) b, MIN(i) e, MAX(i) f, SUM(d) h, COUNT(n) j FROM t1 WHERE i > 999999 GROUP BY c) d;
n	crc_sum	crc_xor
0	NULL	0
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# HAVING and ORDER BY are applied by the plan above the grouping, to the
# merged groups, so they are compared as they stand.
#
# SELECT c, COUNT(*), SUM(i), MIN(i), MAX(i) FROM t1 GROUP BY c HAVING COUNT(*) > 5000 ORDER BY c
SELECT c, COUNT(*), SUM(i), MIN(i), MAX(i) FROM t1 GROUP BY c HAVING COUNT(*) > 5000 ORDER BY c;
c	COUNT(*)	SUM(i)	MIN(i)	MAX(i)
g0	5692	2828606	0	996
g1	5692	2828038	0	996
g2	5692	2828467	0	996
g3	5691	2828148	0	996
g4	5691	2828576	0	996
g5	5691	2828377	0	996
g6	5691	2827808	0	996
SELECT c, COUNT(*), SUM(i), MIN(i), MAX(i) FROM t1 GROUP BY c HAVING COUNT(*) > 5000 ORDER BY c;
c	COUNT(*)	SUM(i)	MIN(i)	MAX(i)
g0	5692	2828606	0	996
g1	5692	2828038	0	996
g2	5692	2828467	0	996
g3	5691	2828148	0	996
g4	5691	2828576	0	996
g5	5691	2828377	0	996
g6	5691	2827808	0	996
ran_in_the_workers
1
# SELECT c, COUNT(*) FROM t1 GROUP BY c ORDER BY COUNT(*) DESC, c LIMIT 3
SELECT c, COUNT(*) FROM t1 GROUP BY c ORDER BY COUNT(*) DESC, c LIMIT 3;
c	COUNT(*)
g0	5692
g1	5692
g2	5692
SELECT c, COUNT(*) FROM t1 GROUP BY c ORDER BY COUNT(*) DESC, c LIMIT 3;
c	COUNT(*)
g0	5692
g1	5692
g2	5692
