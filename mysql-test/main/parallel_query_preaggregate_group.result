SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',g, a))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',g, a))) AS crc_xor FROM (SELECT c AS g, BIT_XOR(i) a FROM t1 GROUP BY c) d;
n	crc_sum	crc_xor
8	20965279960	4081950370
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
DROP TABLE t1, d1;
SET SESSION parallel_worker_threads= @s;
