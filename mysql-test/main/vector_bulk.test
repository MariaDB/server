source include/have_sequence.inc;

let $bulk_rows= 10000;

set @old_cache_size= @@global.mhnsw_max_cache_size;
set global mhnsw_max_cache_size= 1073741824;

--echo #
--echo # Test bulk construction and memory-budget fallback
--echo #

--echo # 1. ALTER TABLE completes entirely through bulk construction
create table t1 (id int auto_increment primary key, v vector(1) not null);
--disable_query_log
eval insert into t1 (v)
     select vec_fromtext(concat('[', seq, ']'))
       from seq_1_to_$bulk_rows;
--enable_query_log
insert into t1 (id, v) values (1000000000, vec_fromtext('[-1]'));
alter table t1 add vector index (v) m=6;
show warnings;

--echo # Normal inserts work after bulk construction has released its context
insert into t1 (id, v) values (1000000001, vec_fromtext('[-2]'));
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
  from t1 order by d limit 1;

--echo # 2. OPTIMIZE TABLE completes entirely through bulk construction
delete from t1 where id in (2, 3);
optimize table t1;
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
  from t1 order by d limit 1;
drop table t1;

--echo # 3. ALTER TABLE switches from bulk construction to normal inserts
set global mhnsw_max_cache_size= 1048576;
create table t1 (id int auto_increment primary key, v vector(1) not null);
--disable_query_log
eval insert into t1 (v)
     select vec_fromtext(concat('[', seq, ']'))
       from seq_1_to_$bulk_rows;
--enable_query_log
insert into t1 (id, v) values (1000000000, vec_fromtext('[-1]'));

--replace_regex /usage \(\d+\)/usage (memory_usage)/
alter table t1 add vector index (v) m=6;
--replace_regex /usage \(\d+\)/usage (memory_usage)/
show warnings;

--echo # The cutoff row occurs once, and the normal-insert suffix is searchable
select id, vec_distance_euclidean(v, vec_fromtext('[1]')) d
  from t1 order by d limit 2;
select id, vec_distance_euclidean(v, vec_fromtext('[-1]')) d
  from t1 order by d limit 1;

--echo # Normal inserts remain usable after the mid-build switch
insert into t1 (id, v) values (1000000001, vec_fromtext('[-2]'));
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
  from t1 order by d limit 1;

--echo # 4. OPTIMIZE TABLE can make the same mid-build switch
delete from t1 where id in (2, 3);
let $is_innodb= `select @@default_storage_engine = 'InnoDB'`;
--disable_warnings
optimize table t1;
--enable_warnings

# InnoDB provides an approximate row count, which can disable bulk construction.
let $warning_code= query_get_value(SHOW WARNINGS, Code, 1);
if (!$is_innodb)
{
  if ($warning_code != 1105)
  {
    die OPTIMIZE TABLE did not switch to normal inserts at the cache limit;
  }
}

select id, vec_distance_euclidean(v, vec_fromtext('[1]')) d
  from t1 order by d limit 1;
select id, vec_distance_euclidean(v, vec_fromtext('[-2]')) d
  from t1 order by d limit 1;

drop table t1;
set global mhnsw_max_cache_size= @old_cache_size;
