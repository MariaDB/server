# MDEV-32083 / CVE-2023-52969: INSERT..SELECT crashes if target table
# appears in a derived table within the SELECT clause (JIRA duplicate of
# MDEV-32086; fixed by the same part-1 commit, 9b313d2de). Oleg Smirnov's
# simplified repro from the JIRA: unpatched 10.4.34 crashes with signal 11
# and an empty backtrace (matching the CVE wording "can sometimes crash
# with an empty backtrace log"); passes on the patched build.
CREATE TABLE t1(i int);
EXPLAIN INSERT INTO t1 SELECT (SELECT min(dt.a) FROM (SELECT 1 as a FROM t1) dt ORDER BY i, dt.a) FROM t1 tb;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	tb	system	NULL	NULL	NULL	NULL	0	Const row not found
2	SUBQUERY	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Select tables optimized away
DROP TABLE t1;
