SELECT 4 AS cap, JSON_OBJECTAGG(a, a) AS v,
LENGTH(JSON_OBJECTAGG(a, a)) AS len,
LENGTH(JSON_OBJECTAGG(a, a)) <= 4 AS within FROM t7;
