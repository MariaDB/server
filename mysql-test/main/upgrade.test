--echo #

--error ER_WRONG_TABLE_NAME
drop table if exists `#mysql50#t`;

--error ER_WRONG_TABLE_NAME
drop table if exists `#mysql50#a@002fb`;

--error ER_WRONG_TABLE_NAME
drop table if exists `#mysql50#COM1@@@`;

--error ER_WRONG_TABLE_NAME
create table `#mysql50#t-1`(a int);

create table `t-1`(a int);
drop table if exists `#mysql50#t-1`;
drop table `t-1`;

create table t1 (a int);
--error ER_WRONG_TABLE_NAME
rename table t1 to `#mysql50#t-1`;
--move_file $MYSQLD_DATADIR/test/t1.frm $MYSQLD_DATADIR/test/t-1.frm
--move_file $MYSQLD_DATADIR/test/t1.MYI $MYSQLD_DATADIR/test/t-1.MYI
--move_file $MYSQLD_DATADIR/test/t1.MYD $MYSQLD_DATADIR/test/t-1.MYD
rename table `#mysql50#t-1` to t1;
--error ER_WRONG_TABLE_NAME
alter table t1 rename to `#mysql50#t-1`;
drop table t1;

#
# databases
#
--error ER_WRONG_DB_NAME
drop database if exists `#mysql50#db`;

drop database if exists `#mysql50#db-1`;

--error ER_WRONG_DB_NAME
create database `#mysql50#mysqltest-1`;

create table t1 (a int) partition by list (a) (
  partition p0 values in (3),
  partition p1 values in (5)
);
--error ER_WRONG_TABLE_NAME 
alter table t1 convert partition p0 to table `#mysql50#t-1`;
drop table t1;

#
# partition/subpartition names
#

--error ER_WRONG_PARTITION_NAME
create table t1 (a int) partition by list (a) (
  partition p0 values in (3),
  partition `p-1` values in (5),
  partition `#mysql50#p-2` values in (7)
);

--error ER_WRONG_PARTITION_NAME
create table t1 (a integer) partition by list(a) subpartition by key(a) (
  partition p1 values in (0) (subpartition sp1, subpartition `#mysql50#sp-2`),
  partition p2 values in (1) (subpartition sp3, subpartition `sp-4`)
);

# two ways to fix bad partition name:
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p-2.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p-2.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p0.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p0.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p@002d1.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p@002d1.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50.frm $MYSQLD_DATADIR/test/t1.frm
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50.par $MYSQLD_DATADIR/test/t1.par
select * from t1;
show create table t1;
alter table t1 reorganize partition `#mysql50#p-2` into (partition t2 values in (7));
show create table t1;
drop table t1;

--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p-2.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p-2.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p0.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p0.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYD $MYSQLD_DATADIR/test/t1#P#p@002d1.MYD
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50#P#p0.MYI $MYSQLD_DATADIR/test/t1#P#p@002d1.MYI
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50.frm $MYSQLD_DATADIR/test/t1.frm
--copy_file $MYSQLTEST_VARDIR/std_data/parts/mysql50.par $MYSQLD_DATADIR/test/t1.par
select * from t1;
show create table t1;
alter table t1 convert partition `#mysql50#p-2` to table t2;
alter table t1 convert table t2 to partition p2 values in (7);
show create table t1;
drop table t1;

#
# failure to rename and ddl rollback
#
create table t1(id int, c1 varchar(64));
create table t2(id int, c1 varchar(64)) partition by range(id) (
  partition p0 values less than (10),
  partition pmax values less than maxvalue
);
insert into t1 values (7, 'foobar');
insert into t2 values (1, 'pewpewpew');
flush tables;
select * from t1;
--error 1103
rename table t1 to `#mysql50#t2#p#p0`;
select * from t1;
drop table t1, t2;

