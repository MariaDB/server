STR_TO_DATE('March2026','%M%Y') AS a3, STR_TO_DATE('2026Jan01','%Y%b%d') AS a4,
STR_TO_DATE('Jan01 2026','%b%d %Y') AS a5,
STR_TO_DATE('Sunday01March2026','%W%d%M%Y') AS a6;
