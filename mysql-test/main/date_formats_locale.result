# Locale argument must not take part in collation aggregation
CREATE TABLE t1 (a VARCHAR(30) CHARACTER SET latin1, l VARCHAR(10) CHARACTER SET latin2);
INSERT INTO t1 VALUES ('1 March 2026','en_US');
SELECT STR_TO_DATE(a,'%d %M %Y',l), DATE_FORMAT('2026-03-01','%d %M %Y',l) FROM t1;
STR_TO_DATE(a,'%d %M %Y',l)	DATE_FORMAT('2026-03-01','%d %M %Y',l)
2026-03-01	01 March 2026
DROP TABLE t1;
# Tables from 10.6 with 2-argument STR_TO_DATE in CHECK and generated columns
SHOW CREATE TABLE t_chk;
Table	Create Table
t_chk	CREATE TABLE `t_chk` (
  `a` varchar(30) DEFAULT NULL,
  CONSTRAINT `CONSTRAINT_1` CHECK (str_to_date(`a`,'%Y-%m-%d') is not null)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
SHOW CREATE TABLE t_sto;
Table	Create Table
t_sto	CREATE TABLE `t_sto` (
  `a` varchar(30) DEFAULT NULL,
  `d` date GENERATED ALWAYS AS (str_to_date(`a`,'%Y-%m-%d')) STORED
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
SHOW CREATE TABLE t_idx;
Table	Create Table
t_idx	CREATE TABLE `t_idx` (
  `a` varchar(30) DEFAULT NULL,
  `d` date GENERATED ALWAYS AS (str_to_date(`a`,'%Y-%m-%d')) VIRTUAL,
  KEY `d` (`d`)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
SELECT * FROM t_chk;
a
2026-01-01
SELECT * FROM t_sto;
a	d
2026-01-01	2026-01-01
SELECT * FROM t_idx;
a	d
2026-01-01	2026-01-01
INSERT INTO t_chk VALUES ('2026-02-02');
INSERT INTO t_sto(a) VALUES ('2026-02-02');
INSERT INTO t_idx(a) VALUES ('2026-02-02');
CHECK TABLE t_chk, t_sto, t_idx FOR UPGRADE;
Table	Op	Msg_type	Msg_text
test.t_chk	check	status	OK
test.t_sto	check	status	OK
test.t_idx	check	status	OK
ALTER TABLE t_sto ADD COLUMN x INT;
DROP TABLE t_chk, t_sto, t_idx;
# Names in old tables are English whatever the locale
SET lc_time_names='de_DE';
SHOW CREATE TABLE t_nam;
Table	Create Table
t_nam	CREATE TABLE `t_nam` (
  `a` varchar(30) DEFAULT NULL,
  `b` date GENERATED ALWAYS AS (str_to_date(`a`,'%d %M %Y','en_US')) STORED,
  `c` date GENERATED ALWAYS AS (str_to_date(`a`,'%e %b %Y','en_US')) VIRTUAL,
  KEY `c` (`c`),
  CONSTRAINT `CONSTRAINT_1` CHECK (str_to_date(`a`,'%d %M %Y','en_US') is not null)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
