SET lc_time_names=DEFAULT;
# Only formats with month or day names depend on lc_time_names
CREATE TABLE t1 (a VARCHAR(30) CHARACTER SET ucs2,
b DATE AS (STR_TO_DATE(a,_latin1'%Y-%m-%d')) STORED,
c DATE AS (STR_TO_DATE(a,'%Y-%m-%d')) VIRTUAL, KEY(c),
CHECK (STR_TO_DATE(a,'%Y-%m-%d %%M') IS NOT NULL));
INSERT INTO t1(a) VALUES ('2026-02-02');
FLUSH TABLES;
SELECT * FROM t1;
a	b	c
2026-02-02	2026-02-02	2026-02-02
DROP TABLE t1;
CREATE TABLE t1 (a VARCHAR(30), b DATE AS (STR_TO_DATE(a,'%d.%m.%Y')) STORED,
c DATE AS (STR_TO_DATE(a,'%d.%m.%Y')) VIRTUAL, KEY(c)) ENGINE=InnoDB;
INSERT INTO t1(a) VALUES ('01.03.2026'),('02.03.2026');
UPDATE t1 SET a='03.03.2026' WHERE c='2026-03-02';
DELETE FROM t1 WHERE c='2026-03-01';
SELECT * FROM t1 WHERE c='2026-03-03';
a	b	c
03.03.2026	2026-03-03	2026-03-03
CHECK TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
