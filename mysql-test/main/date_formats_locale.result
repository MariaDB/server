# Weekday names that are prefixes of, or collate equal to, other names
SELECT DATE_FORMAT(d,'%x %v %a','sk_SK') AS s,
STR_TO_DATE(DATE_FORMAT(d,'%x %v %a','sk_SK'),'%x %v %a','sk_SK') = d AS ok
FROM (SELECT '2026-03-02' + INTERVAL seq DAY AS d FROM seq_0_to_6) dt;
s	ok
2026 10 po	1
2026 10 ut	1
2026 10 st	1
2026 10 št	1
2026 10 pi	1
2026 10 so	1
2026 10 ne	1
SELECT DATE_FORMAT(d,'%x %v %a','az_AZ') AS s,
STR_TO_DATE(DATE_FORMAT(d,'%x %v %a','az_AZ'),'%x %v %a','az_AZ') = d AS ok_a,
DATE_FORMAT(d,'%W, %e %M %Y','az_AZ') AS s2,
STR_TO_DATE(DATE_FORMAT(d,'%X %V %W','az_AZ'),'%X %V %W','az_AZ') = d AS ok_W,
STR_TO_DATE(DATE_FORMAT(d,'%W, %e %M %Y','az_AZ'),'%W, %e %M %Y','az_AZ') = d AS ok_W2
FROM (SELECT '2026-03-02' + INTERVAL seq DAY AS d FROM seq_0_to_6) dt;
