2026 10 B.E.	1	bazar ertəsi, 2 mart 2026	1	1
2026 10 Ç.A.	1	çərşənbə axşamı, 3 mart 2026	1	1
2026 10 Ç.	1	çərşənbə, 4 mart 2026	1	1
2026 10 C.A.	1	cümə axşamı, 5 mart 2026	1	1
2026 10 C.	1	cümə, 6 mart 2026	1	1
2026 10 Ş.	1	şənbə, 7 mart 2026	1	1
2026 10 B.	1	bazar, 8 mart 2026	1	1
# DATE_FORMAT/STR_TO_DATE round trip for all locales
CREATE TABLE fmts (id INT, fmt VARCHAR(32)) CHARACTER SET utf8mb4;
INSERT INTO fmts VALUES (1,'%e %M %Y'),(2,'%e %b %Y'),(3,'%W, %e %M %Y'),
(4,'%a %e %b %Y'),(5,'%Y%M%d'),(6,'%d%b%Y'),(7,'%X %V %W'),(8,'%x %v %a');
CREATE TABLE dates (d DATE);
INSERT INTO dates SELECT '2026-01-15' + INTERVAL seq MONTH FROM seq_0_to_11;
INSERT INTO dates SELECT '2026-03-02' + INTERVAL seq DAY FROM seq_0_to_6;
CREATE TABLE res (loc VARCHAR(16), fmt VARCHAR(32), d DATE, s VARCHAR(255),
b2 DATE, b3 DATE) CHARACTER SET utf8mb4;
SET sql_mode='';
SET lc_time_names=DEFAULT;
SET sql_mode=DEFAULT;
SELECT COUNT(DISTINCT loc) FROM res;
COUNT(DISTINCT loc)
138
SELECT loc, fmt, d, s, b2, b3 FROM res WHERE NOT (b2 <=> d AND b3 <=> d)
AND NOT (loc='vi_VN' AND fmt='%d%b%Y') ORDER BY loc, fmt, d;
loc	fmt	d	s	b2	b3
DROP TABLE fmts, dates, res;
