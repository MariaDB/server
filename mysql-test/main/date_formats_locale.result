# Combining marks after a letter are skipped: vi_VN names are partly decomposed
SELECT MONTH(STR_TO_DATE('Tháng bảy','%M','vi_VN')) AS m7,
MONTH(STR_TO_DATE('Tháng ba','%M','vi_VN')) AS m3,
TO_DATE('15 Tháng mười một 2026','DD MONTH YYYY',
'NLS_DATE_LANGUAGE=VIETNAMESE') AS t11,
STR_TO_DATE(CONCAT('1 Ma', _utf8mb4 0xCC88, 'rz 2026'),'%d %M %Y','de_DE') AS de_nfd;
m7	m3	t11	de_nfd
7	3	2026-11-15 00:00:00	2026-03-01
