# Names are compared accent-insensitively, as in TO_DATE
SELECT STR_TO_DATE('1 Märch 2026','%d %M %Y') AS e1, STR_TO_DATE('1 Mäy 2026','%d %M %Y') AS e2,
STR_TO_DATE('1 Marz 2026','%d %M %Y','de_DE') AS e4;
