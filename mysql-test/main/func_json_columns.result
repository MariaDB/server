# 5a. The same column reached through a scalar subquery, where the
#     value is fetched once and held rather than read per row.
CREATE TABLE ts (id INT, j JSON);
INSERT INTO ts VALUES (1, '{"a": 1}');
SET SESSION check_constraint_checks = OFF;
INSERT INTO ts VALUES (2, '{"a":1,');
