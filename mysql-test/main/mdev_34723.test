--source include/not_embedded.inc

--echo #
--echo # NEW and OLD does not work outside trigger and gives error
--echo # regardless of mode
--echo #

--error ER_UNKNOWN_SYSTEM_VARIABLE
SET NEW=OLD;

--echo #
--echo # Checking for INSERT
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C") RETURNING *;

delimiter |;

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_insert_new_eq_old
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_insert_new_eq_old
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_insert_new_eq_var
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET NEW=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_insert_set_new_eq_var
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

INSERT INTO t1 VALUES (4, "D");

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_insert_set_new_eq_var;

delimiter |;

CREATE TRIGGER t1_before_insert_unequal_row
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (6, "F");
DROP TRIGGER t1_before_insert_unequal_row;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_insert_unequal_row
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|
delimiter ;|

DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # Checking for UPDATE
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C");
SELECT * FROM t1;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_new_eq_old
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_old_eq_new
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  SET OLD = NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_new_eq_var
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_set_old_eq_var
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET OLD=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_update_new_eq_old
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_update_old_eq_new
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET OLD=NEW;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

SELECT * FROM t1;
SELECT * FROM t2;

UPDATE t1 SET val1="D" WHERE id1= 1;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_update_new_eq_old;
TRUNCATE TABLE t2;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_update_old_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET OLD=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_update_new_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

UPDATE t1 SET val1="D" WHERE id1= 1;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_update_new_eq_var;

delimiter |;

CREATE TRIGGER t1_before_update_new_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

--error ER_OPERAND_COLUMNS
UPDATE t1 SET val1="D" WHERE id1= 5;

DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # Checking for DELETE
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C");
SELECT * FROM t1;
SELECT * FROM t2;

delimiter |;

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_delete_new_eq_old
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_delete_old_eq_new
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  SET OLD = NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT (3, "C");
  SET OLD=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET a=OLD;
  INSERT INTO t2 VALUES(OLD.id1, OLD.val1);
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_delete_new_eq_old
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_delete_old_eq_new
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  SET OLD=NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_delete_old_eq_var
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT (3, "C");
  SET OLD=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

DELETE FROM t1 WHERE id1=1;

SELECT * FROM t1;
SELECT * FROM t2;

TRUNCATE TABLE t2;

DROP TRIGGER t1_before_delete_old_eq_var;

delimiter |;

CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET a=OLD;
  INSERT INTO t2 VALUES(OLD.id1, OLD.val1);
END|

delimiter ;|

SELECT * FROM t2;

DELETE FROM t1 WHERE id1=2;

DROP TRIGGER t1_before_delete_old_eq_var;

delimiter |;

CREATE TRIGGER t1_before_delete_unequal_row
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT, y VARCHAR(10)) DEFAULT(5, "E");
  SET a.x = OLD;
END|

delimiter ;|

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
DELETE FROM t1 WHERE id1=3;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TABLE t1;
DROP TABLE t2;

CREATE TABLE t1 (a INT);

delimiter $;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END$
delimiter ;$

let $restart_file= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect;
--exec echo "wait" > $restart_file
--shutdown_server
--source include/wait_until_disconnected.inc
-- exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
-- enable_reconnect
-- source include/wait_until_connected_again.inc

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # Shutdown and restart work ok
CREATE TABLE t1 (a INT);

DELIMITER |;
CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END;|

DELIMITER ;|

--replace_column 6 #
SHOW TRIGGERS;

--source include/restart_mysqld.inc

--replace_column 6 #
SHOW TRIGGERS;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # No unnecessary error emitted

CREATE TABLE t1 (a INT);

DELIMITER |;

CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE r ROW TYPE OF t1 DEFAULT (SELECT * FROM t1 WHERE a=1);
  SET NEW = r;
END;|

DELIMITER ;|

INSERT INTO t1 VALUES (1),(3);
--error ER_OPERAND_COLUMNS
UPDATE t1 SET a = 10 WHERE a = 3;

SELECT * FROM t1;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo #
--echo # Stored procedure variable scoping
--echo #

CREATE TABLE t1 (id1 INT, val1  INT);
CREATE TABLE t2 (id2 INT, val2 INT);

INSERT INTO t1 VALUES (1, 10);
INSERT INTO t2 VALUES (1, 10);

SELECT * FROM t1;
SELECT * FROM t2;

DELIMITER |;

CREATE TRIGGER trg BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (a1 INT, a2 INT) DEFAULT (3, 300);
  SET NEW= a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
  BEGIN
    DECLARE OLD INT DEFAULT 2;
    DECLARE NEW INT DEFAULT 200;
    INSERT INTO t2 VALUES (OLD, NEW);
  END;
END|

DELIMITER ;|

UPDATE t1 SET id1 = 1 WHERE val1 = 10;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER trg;
DROP TABLE t1;
DROP TABLE t2;

--echo # Crash because m_thd was not set

CREATE TABLE t1 (a INT);
CREATE TABLE t2 (tag VARCHAR(10), val INT);

INSERT INTO t1 VALUES (1);

DELIMITER |;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  INSERT INTO t2 VALUES ('OLD', OLD), ('NEW', NEW);
END|
DELIMITER ;|

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
UPDATE t1 SET a = 100;

DROP TABLE t1, t2;

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);

INSERT INTO t1 VALUES (1, 1);

DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW BEGIN 
DECLARE a ROW (x INT,y INT) DEFAULT (-10, -10); 
SET NEW=OLD + a;

END$

DELIMITER ;$

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
UPDATE t1 SET a = 10;

DROP TRIGGER t1_bu;
DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # MDEV-40124: Assertion `m_sp == m_thd->spcont->m_sp' failed virtual
--echo # Item *Item_splocal::this_item(), UBSAN : member call on null
--echo # pointer of type 'Sp_rcontext_handler' in sql/item.cc
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,2);
delimiter |;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  IF NEW = OLD THEN
    SET @x = 1;
  END IF;
END|
delimiter ;|

UPDATE t1 SET a = 9;

DROP TABLE t1;
--echo #
--echo # MDEV-40127: Server hangs when setting NEW=OLD on a multi-row table
--echo #

--echo # Test case: 1
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1);

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW SET NEW = OLD;

UPDATE t1 SET a = a + 100;
UPDATE t1 SET a = a + 100;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo Test case: 2

CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL);
INSERT INTO t1 VALUES (1,1),(2,2);

DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  BEGIN DECLARE r ROW(x INT,y INT) DEFAULT (9,9); SET NEW = r;
END;
$

DELIMITER ;$

UPDATE t1 SET a = 7;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # Test case: 3

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);

INSERT INTO t1 VALUES (1,1),(2,2);
DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  BEGIN SET NEW = OLD; INSERT INTO t2 VALUES (NEW.a, NEW.b);
END;
$

DELIMITER ;$
UPDATE t1 SET a = 99;

DROP TRIGGER t1_bu;
DROP TABLE t1;
DROP TABLE t2;
--echo #
--echo # MDEV-40130: SIGSEGV in Field_iterator_table::set_table at
--echo #             sql/table.h:3350
--echo #

CREATE TABLE tt (a INT, b INT);
CREATE TRIGGER tg BEFORE INSERT ON tt FOR EACH ROW SET NEW = ROW(NEW.a, NEW.a);
INSERT INTO tt VALUES (1,2);

SELECT * FROM tt;

DROP TABLE tt;

CREATE TABLE tt (a INT, b INT);
CREATE TRIGGER tg BEFORE INSERT ON tt FOR EACH ROW SET NEW = ROW(NEW.a, NEW.a);
INSERT INTO tt VALUES (1,2);
SELECT * FROM tt;

FLUSH TABLES;

INSERT INTO tt VALUES (3,4);
SELECT * FROM tt;

DROP TABLE tt;

--echo #
--echo # MDEV-40490: SET NEW = (row subquery) in a trigger silently
--echo # assigns NULL to all columns and skips the single-row check
--echo #

CREATE TABLE src (a INT, b INT);
INSERT INTO src VALUES (10,20);

CREATE TABLE t (a INT, b INT) ;
CREATE TRIGGER t_bi
  BEFORE INSERT ON t FOR EACH ROW
    SET NEW = (SELECT a,b FROM src);

INSERT INTO t VALUES (1,2);
SELECT a,b FROM t;

DROP TABLE t, src;

CREATE TABLE src (id INT, a INT, b INT);
INSERT INTO src VALUES (1, 10, 20), (2, 30, 40);
CREATE TABLE t1 (a INT, b INT);

--echo # Subquery returning exactly one row: the values must be assigned,
--echo # not NULL
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
  SET NEW = (SELECT a, b FROM src WHERE id = 1);
INSERT INTO t1 VALUES (1, 2);
SELECT * FROM t1;
DROP TRIGGER trg;
TRUNCATE t1;

--echo # Subquery returning several rows: error, and no row is inserted
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
  SET NEW = (SELECT a, b FROM src);
--error ER_SUBQUERY_NO_1_ROW
INSERT INTO t1 VALUES (1, 2);
SELECT * FROM t1;

--echo # Same for a multi-row INSERT: the first failing row aborts the statement
--error ER_SUBQUERY_NO_1_ROW
INSERT INTO t1 VALUES (3, 4), (5, 6);
SELECT * FROM t1;
DROP TRIGGER trg;

--echo # Subquery returning no rows: every column becomes NULL (not an error)
CREATE TRIGGER trg BEFORE INSERT ON t1 FOR EACH ROW
  SET NEW = (SELECT a, b FROM src WHERE id = 99);
INSERT INTO t1 VALUES (1, 2);
SELECT * FROM t1;
DROP TRIGGER trg;
TRUNCATE t1;

--echo # Same checks in BEFORE UPDATE
INSERT INTO t1 VALUES (1, 2);
CREATE TRIGGER trg BEFORE UPDATE ON t1 FOR EACH ROW
  SET NEW = (SELECT a, b FROM src);
--error ER_SUBQUERY_NO_1_ROW
UPDATE t1 SET a = 100;
SELECT * FROM t1;
DROP TRIGGER trg;
CREATE TRIGGER trg BEFORE UPDATE ON t1 FOR EACH ROW
  SET NEW = (SELECT a, b FROM src WHERE id = 2);
UPDATE t1 SET a = 100;
SELECT * FROM t1;
DROP TRIGGER trg;

DROP TABLE t1, src;

--echo #
--echo # MDEV-41760: SIGSEGV in Field_iterator_table::set_table on
--echo # re-prepare of trigger SET NEW = (subquery) after DDL on referenced table
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t2 FOR EACH ROW SET NEW= (SELECT a,b FROM t1);
INSERT INTO t2 VALUES (1,1);
ALTER TABLE t1 FORCE;
INSERT INTO t2 VALUES (2,2); 
SELECT * FROM t2;
SELECT * FROM t1;
DROP TABLE t1,t2;

--echo #
--echo # MDEV-41761: SIGSEGV in sp_head::bind_input_param when trigger
--echo # passes NEW/OLD row as OUT parameter to CALL
--echo #

CREATE TABLE t (a INT);
CREATE PROCEDURE p(OUT r INT) BEGIN END;
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW CALL p(NEW);
--error ER_SP_NOT_VAR_ARG
INSERT INTO t VALUES (1);
DROP TABLE t;
DROP procedure p;

--echo #
--echo # MDEV-41765: Assertion m_sp == m_thd->spcont->m_sp failed in
--echo # Item_splocal::this_item / SIGSEGV in Item_splocal::get_rcontext on
--echo # SIGNAL ... SET MESSAGE_TEXT = NEW in trigger
--echo #

CREATE TABLE t (a INT);
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t VALUES (1);

DROP TABLE t;

CREATE TABLE t (a INT);

INSERT INTO t VALUES (1);

CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW SET @x = (SELECT NEW);
--error ER_OPERAND_COLUMNS
UPDATE t SET a = 2;

DROP TABLE t;

CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
DELIMITER |;

CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW
  BEGIN
    DECLARE r ROW TYPE OF t DEFAULT(1);
    SET @x = (SELECT r);
  END|

DELIMITER ;|

--error ER_OPERAND_COLUMNS
UPDATE t SET a = 2;

DROP TABLE t;

CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW SIGNAL SQLSTATE '45000' SET MYSQL_ERRNO = NEW;
--error ER_OPERAND_COLUMNS
UPDATE t SET a = 2;
DROP TABLE t;

CREATE TABLE t2 (a INT, b INT);
INSERT INTO t2 VALUES (1,2);
CREATE TRIGGER tr2 BEFORE UPDATE ON t2 FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = NEW;
--error ER_OPERAND_COLUMNS
UPDATE t2 SET a = 7;

DROP TABLE t2;

--echo #
--echo # MDEV-41831: SET NEW = (SELECT ...) in a BEFORE INSERT trigger
--echo # fails with ER_OPERAND_COLUMNS (1241) on a single-column table

CREATE TABLE t (a INT);
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW SET NEW = (SELECT 5);                                                                                                                                          
INSERT INTO t VALUES (1);
SELECT * FROM t;
DROP TABLE t;

--echo #
--echo # MDEV-41826: Crash in Table_triggers_list::mark_fields_used on
--echo # INSERT after trigger re-parse fails with unknown column
--echo #

CREATE TABLE t1 (a INT); 
CREATE TABLE t2 (a INT); 
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW DO (SELECT a = NEW FROM t2);

--ERROR ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
INSERT INTO t1 VALUES (1);

ALTER TABLE t2 CHANGE a b INT;

--ERROR ER_BAD_FIELD_ERROR
INSERT INTO t1 VALUES (1);

--ERROR ER_BAD_FIELD_ERROR
INSERT INTO t1 VALUES (1);

DROP TABLE t1;
DROP TABLE t2;


--echo #
--echo # MDEV-41766: Assertion marked_for_read() failed in Field_long::val_int
--echo # on row comparison of NEW/OLD in AFTER trigger
--echo #
CREATE TABLE t1 (a INT, b INT);

INSERT INTO t1 VALUES (1,2);
CREATE TRIGGER t1_au AFTER UPDATE ON t1 FOR EACH ROW SET @x = (NEW = OLD);

UPDATE t1 SET a = 9;

SELECT * FROM t1;

DROP TABLE t1;

CREATE TABLE t (id INT PRIMARY KEY, a INT, b VARCHAR(10), c INT AS (a * 10) VIRTUAL, d VARCHAR(20) AS (CONCAT(b, '!')) VIRTUAL);
INSERT INTO t (id, a, b) VALUES (1, 1, 'b1');
CREATE TRIGGER t_bd BEFORE DELETE ON t FOR EACH ROW SET @v = (OLD = (1, 1, 'b1', 10, 'b1!'));
DELETE FROM t WHERE id = 1;
SELECT @v;

DROP TABLE t;

--echo #
--echo # MDEV-41767: Wrong result for row comparison of trigger NEW/OLD:
--echo # NEW = OLD returns 1 after a column change, OLD = (1,2,3) returns 0
--echo #
CREATE TABLE t1 (a INT, b INT, c INT);
INSERT INTO t1 VALUES (1,2,3);
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW  SET @r = CONCAT_WS(',', NEW = OLD, OLD = (1,2,3));
UPDATE t1 SET b = 20;
SELECT @r;

DROP TABLE t1;

--echo #
--echo # MDEV-41825: SIGSEGV in THD::sp_fix_func_item when a
--echo # ROW variable's DEFAULT is an EXISTS subquery
--echo #
DELIMITER |;
--error ER_OPERAND_COLUMNS
BEGIN NOT ATOMIC DECLARE r ROW(a INT) DEFAULT EXISTS(SELECT 1); SELECT r.a; END|
DELIMITER ;|

--echo #
--echo # MDEV-41812: Columns named old/new of other tables are resolved as the
--echo # OLD/NEW row inside trigger bodies, giving ER_TRG_NO_SUCH_ROW_IN_TRG
--echo # and ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
--echo #

CREATE TABLE t (old INT);
CREATE TABLE t1 (a INT);

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SELECT old FROM t INTO @x;

INSERT INTO t1 VALUES (1);
SELECT * FROM t1;

INSERT INTO t VALUES (1), (2);
SELECT * FROM t1;

DROP TABLE t;
DROP TABLE t1;

CREATE TABLE t (new INT);
CREATE TABLE t1 (a INT);

CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW UPDATE t SET new = new + 1;

INSERT INTO t1 VALUES (1);
SELECT * FROM t1;
SELECT * FROM t;

INSERT INTO t VALUES (1), (2);

INSERT INTO t1 VALUES (2);
SELECT * FROM t1;
SELECT * FROM t;

DROP TABLE t1;
DROP TABLE t;

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1);
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW SELECT NEW = OLD INTO @v;
UPDATE t1 SET a = 3;
DROP TABLE t1;


--echo #
--echo # MDEV-41827: SIGSEGV in Item_trigger_row::cleanup on condition
--echo # pushdown of row = NEW into derived table in trigger
--echo #
CREATE TABLE t (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW DO (SELECT 1 FROM (SELECT DISTINCT a, b FROM t) d WHERE (a, b) = NEW);
INSERT INTO t VALUES (1,2);

DROP TABLE t;

CREATE TABLE src (a INT, b INT);
INSERT INTO src VALUES (1,2),(5,6);
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,2);
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW SET @r = (SELECT COUNT(*) FROM (SELECT a, b FROM src GROUP BY a, b) d WHERE (d.a, d.b) = NEW);
UPDATE t1 SET a = 5, b = 6;

DROP TABLE src;
DROP TABLE t1;

--echo #
--echo # MDEV-41815: SIGSEGV in Item_trigger_row::cleanup on FLUSH TABLES after
--echo # a trigger runs DECLARE ROW TYPE OF cursor DEFAULT NEW
--echo #

CREATE TABLE t1 (a INT);
DELIMITER |;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW BEGIN DECLARE c CURSOR FOR SELECT 1; BEGIN DECLARE r ROW TYPE OF c DEFAULT NEW; END; END|
DELIMITER ;|
INSERT INTO t1 VALUES (1);
FLUSH TABLES;

DROP TABLE t1;

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);

INSERT INTO t1 VALUES (1,10),(2,20);

DELIMITER |;
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW BEGIN DECLARE c CURSOR FOR SELECT a, b FROM t2; BEGIN DECLARE r ROW TYPE OF c DEFAULT OLD; SET @v = CONCAT_WS(',', @v, r.a); END; END|
DELIMITER ;|

SET @v = NULL;

UPDATE t1 SET a = a + 100; 

DROP TABLE t1;
DROP TABLE t2;

--echo # MDEV-41814: Assertion `argp[arg_no]->fixed()' failed in
--echo # sp_head::execute_function
--echo #

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (2);
CREATE FUNCTION f(r ROW(a INT)) RETURNS INT RETURN 1;
CREATE TRIGGER tr BEFORE INSERT OR UPDATE ON t1 FOR EACH ROW DO f(OLD);

--error ER_TRG_NO_SUCH_ROW_IN_TRG
INSERT INTO t1 VALUES (1);
UPDATE t1 SET a= 3 WHERE a=2;
SELECT * FROM t1;

DROP FUNCTION f;
DROP TABLE t1;

CREATE TABLE t1 (a INT);
CREATE FUNCTION f1(r ROW(a INT)) RETURNS INT RETURN 1;
CREATE TRIGGER tr1 BEFORE INSERT OR UPDATE ON t1 FOR EACH ROW SET @r = f1(OLD);
--error ER_TRG_NO_SUCH_ROW_IN_TRG
INSERT INTO t1 VALUES (1);

DROP TABLE t1;
DROP FUNCTION f1;

--echo #
--echo # MDEV-41982: Assertion failure in Type_handler_composite::Item_val_bool
--echo # on NEW AND 1 in trigger on single-column table
--echo #

CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW SET @x = NEW AND 1;
--error ER_OPERAND_COLUMNS
UPDATE t SET a = 2;
DROP TABLE t;

--echo #
--echo # MDEV-41983: SIGSEGV in Item_cache_row::store on
--echo # CASE NEW WHEN in trigger on single-column table
--echo #
CREATE TABLE t (a INT);
INSERT INTO t VALUES (1);
DELIMITER $$;
CREATE TRIGGER tr BEFORE UPDATE ON t FOR EACH ROW BEGIN CASE NEW WHEN 1 THEN SET @x = 1; ELSE SET @x = 0; END CASE; END $$
DELIMITER ;$$
--error ER_OPERAND_COLUMNS
UPDATE t SET a = 2;
DROP TABLE t;

--echo #
--echo # Re-parse trigger cursor ROW TYPE DEFAULT NEW/OLD after ALTER TABLE and repeated INSERT
--echo #

CREATE TABLE t1 (a INT);
CREATE TABLE t2 (a INT);
INSERT INTO t2 VALUES (10);

DELIMITER |;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT a FROM t2;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT NEW;
    SET @x = r.a;
  END;
END|
DELIMITER ;|

INSERT INTO t1 VALUES (1);
ALTER TABLE t2 ADD COLUMN b INT DEFAULT 0;
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);

DROP TRIGGER tr;
DROP TABLE t1, t2;

--echo #
--echo # DEFAULT of a cursor ROW TYPE variable with OLD nested in an expression
--echo # must be cleaned up between executions (multi-row UPDATE)
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20);

CREATE FUNCTION f(r ROW(a INT,b INT)) RETURNS ROW(x INT,y INT) RETURN ROW(r.a,r.b);

SET @s= '';
DELIMITER |;
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT 1 x, 2 y;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT f(OLD);
    SET @s= CONCAT(@s, r.x, ',', r.y, ';');
  END;
END|
DELIMITER ;|

UPDATE t1 SET a= a+100;
SELECT @s;
UPDATE t1 SET a= a+100;
SELECT @s;

DROP TRIGGER tr;
DROP FUNCTION f;
DROP TABLE t1;

--echo #
--echo # NEW is the trigger row in a query that has a FROM clause, unless a
--echo # column of that name is visible
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t2 VALUES (1,10),(2,20);

CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
  SET @x= (SELECT COUNT(*) FROM t2 WHERE ROW(t2.a, t2.b) = NEW);

INSERT INTO t1 VALUES (2,20);
SELECT @x;
INSERT INTO t1 VALUES (3,30);
SELECT @x;

DROP TABLE t1, t2;

--echo #
--echo # SIGNAL items must be scalar, NEW/OLD row is not
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
  SIGNAL SQLSTATE '45000' SET CLASS_ORIGIN= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;

CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
DROP TABLE t1;

--echo #
--echo # Results are asserted and multi-row tables are used: SET NEW = OLD,
--echo # SET NEW = r (MDEV-40127), per-row state in comparison, function
--echo # argument contexts (MDEV-41766/41767), CASE NEW is an error (MDEV-41983)
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW SET NEW = OLD;
UPDATE t1 SET a= a+100;
UPDATE t1 SET a= a+100;
SELECT * FROM t1;
DROP TRIGGER t1_bu;

DELIMITER $;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE r ROW(x INT,y INT) DEFAULT (9,9);
  SET NEW = r;
END;
$
DELIMITER ;$
UPDATE t1 SET a= 7;
SELECT * FROM t1;
DROP TRIGGER t1_bu;

SET @r= '';
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  SET @r= CONCAT(@r, NEW = OLD, OLD = (9,9), ';');
UPDATE t1 SET b= b+1;
SELECT @r;
DROP TRIGGER t1_bu;

CREATE FUNCTION f(r ROW(a INT, b INT)) RETURNS INT RETURN r.a + r.b;
SET @r= '';
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  SET @r= CONCAT(@r, f(OLD), ',', f(NEW), ';');
UPDATE t1 SET b= b+1;
SELECT @r;
DROP TRIGGER t1_bu;
DROP FUNCTION f;
DROP TABLE t1;

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2),(3);
SET @x= '';
DELIMITER $$;
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  CASE NEW WHEN 1 THEN SET @x= CONCAT(@x, 'one;'); ELSE SET @x= CONCAT(@x, 'other;'); END CASE;
END $$
DELIMITER ;$$
--error ER_OPERAND_COLUMNS
UPDATE t1 SET a= a+10;
DROP TABLE t1;

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,2),(3,4);
SET @x= '';
CREATE TRIGGER t1_au AFTER UPDATE ON t1 FOR EACH ROW SET @x= CONCAT(@x, (NEW = OLD), ';');
UPDATE t1 SET a= a+1;
SELECT @x;
DROP TABLE t1;

--echo #
--echo # SIGNAL / RESIGNAL with a NEW row in every condition item
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CLASS_ORIGIN= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET SUBCLASS_ORIGIN= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CONSTRAINT_CATALOG= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CONSTRAINT_SCHEMA= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CONSTRAINT_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CATALOG_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET SCHEMA_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET TABLE_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET COLUMN_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET CURSOR_NAME= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW SIGNAL SQLSTATE '45000' SET MYSQL_ERRNO= NEW;
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;

DELIMITER $$;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION RESIGNAL SET CLASS_ORIGIN= NEW;
  SIGNAL SQLSTATE '45000';
END $$
DELIMITER ;$$
--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (1,2);
DROP TRIGGER tr;
DROP TABLE t1;

--echo #
--echo # ROW TYPE OF a table with VIRTUAL and INVISIBLE columns: OLD has the
--echo # same number of columns as the row variable (generated columns are
--echo # not assigned by SET NEW = r)
--echo #

CREATE TABLE t1 (a INT, b INT, c INT AS (a+b) VIRTUAL, d INT INVISIBLE DEFAULT 5);
INSERT INTO t1 (a,b) VALUES (1,2),(3,4);
DELIMITER $$;
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE r ROW TYPE OF t1 DEFAULT OLD;
  SET @x= CONCAT(IFNULL(@x,''), r.a, ',', r.b, ';');
  SET NEW = r;
END $$
DELIMITER ;$$
SET @x= '';
UPDATE t1 SET a= a+10;
SELECT @x;
SELECT a, b, c, d FROM t1;
DROP TABLE t1;

--echo #
--echo # Cursor ROW TYPE variable DEFAULT NEW/OLD: the value is read back, for
--echo # OLD, BEFORE and AFTER triggers, multi-row statements, PREPARE/EXECUTE
--echo # and FLUSH TABLES
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE log (s VARCHAR(100));

DELIMITER |;
CREATE TRIGGER t1_bi BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT 0 x, 0 y;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT NEW;
    INSERT INTO log VALUES (CONCAT('bi ', r.x, ',', r.y));
  END;
END|
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT 0 x, 0 y;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT OLD;
    INSERT INTO log VALUES (CONCAT('bu ', r.x, ',', r.y));
  END;
END|
CREATE TRIGGER t1_ad AFTER DELETE ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT 0 x, 0 y;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT OLD;
    INSERT INTO log VALUES (CONCAT('ad ', r.x, ',', r.y));
  END;
END|
DELIMITER ;|

INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
SELECT * FROM log;
TRUNCATE log;

UPDATE t1 SET a= a+100;
SELECT * FROM log;
TRUNCATE log;

FLUSH TABLES;
UPDATE t1 SET b= b+1;
SELECT * FROM log;
TRUNCATE log;

PREPARE stmt FROM 'UPDATE t1 SET a= a+1';
EXECUTE stmt;
SELECT * FROM log;
TRUNCATE log;
EXECUTE stmt;
SELECT * FROM log;
TRUNCATE log;
DEALLOCATE PREPARE stmt;

DELETE FROM t1;
SELECT * FROM log;

DROP TABLE t1, log;

--echo #
--echo # Re-parse of a cursor ROW TYPE declaration (ALTER TABLE of the cursor's
--echo # table) with a multi-row statement, for DEFAULT NEW and for a DEFAULT
--echo # that refers to the columns of NEW
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
INSERT INTO t2 VALUES (10, 20);
CREATE TABLE log (s VARCHAR(100));

DELIMITER |;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT a, b FROM t2;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT NEW;
    INSERT INTO log VALUES (CONCAT('row ', r.a, ',', r.b));
  END;
END|
DELIMITER ;|

INSERT INTO t1 VALUES (1,2),(3,4);
ALTER TABLE t2 ADD COLUMN c INT DEFAULT 0;
INSERT INTO t1 VALUES (5,6),(7,8);
INSERT INTO t1 VALUES (9,10);
SELECT * FROM log;
DROP TRIGGER tr;
TRUNCATE log;

DELIMITER |;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT a, b FROM t2;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT ROW(NEW.a, NEW.b);
    INSERT INTO log VALUES (CONCAT('fld ', r.a, ',', r.b));
  END;
END|
DELIMITER ;|

INSERT INTO t1 VALUES (11,12),(13,14);
ALTER TABLE t2 ADD COLUMN d INT DEFAULT 0;
INSERT INTO t1 VALUES (15,16),(17,18);
INSERT INTO t1 VALUES (19,20);
SELECT * FROM log;

DROP TRIGGER tr;
DROP TABLE t1, t2, log;

--echo #
--echo # Crash on multi-row trigger with ROW TYPE OF cursor DEFAULT subquery referencing OLD/NEW
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
CREATE TABLE log (s VARCHAR(100));
INSERT INTO t1 VALUES (1,10),(1,11),(2,10);

DELIMITER |;
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT a, b FROM t2;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT (SELECT OLD = (1,10), 0);
    INSERT INTO log VALUES (CONCAT('eq ', r.a, ',', r.b));
  END;
END|
DELIMITER ;|

UPDATE t1 SET b= b+1;
UPDATE t1 SET b= b-1 WHERE a= 2;
SELECT * FROM log;
DROP TRIGGER tr;
TRUNCATE log;

DELIMITER |;
CREATE FUNCTION f(r ROW(a INT, b INT)) RETURNS INT RETURN r.a + r.b|
CREATE TRIGGER tr BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  DECLARE c CURSOR FOR SELECT a, b FROM t2;
  BEGIN
    DECLARE r ROW TYPE OF c DEFAULT (SELECT f(OLD), 0);
    INSERT INTO log VALUES (CONCAT('f ', r.a, ',', r.b));
  END;
END|
DELIMITER ;|

UPDATE t1 SET b= b+1;
UPDATE t1 SET b= b+1 WHERE a= 2;
SELECT * FROM log;
DROP TRIGGER tr;
DROP FUNCTION f;
DROP TABLE t1, t2, log;
