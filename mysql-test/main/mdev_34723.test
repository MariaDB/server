--echo #
--echo # NEW and OLD does not work outside trigger and gives error
--echo # regardless of mode
--echo #

--error ER_UNKNOWN_SYSTEM_VARIABLE
SET NEW=OLD;

--echo #
--echo # Checking for INSERT
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C") RETURNING *;

delimiter |;

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_insert_new_eq_old
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_insert_new_eq_old
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_insert_new_eq_var
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET NEW=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_insert_set_new_eq_var
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

INSERT INTO t1 VALUES (4, "D");

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_insert_set_new_eq_var;

delimiter |;

CREATE TRIGGER t1_before_insert_unequal_row
BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

--error ER_OPERAND_COLUMNS
INSERT INTO t1 VALUES (6, "F");
DROP TRIGGER t1_before_insert_unequal_row;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_insert_unequal_row
AFTER INSERT ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|
delimiter ;|

DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # Checking for UPDATE
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C");
SELECT * FROM t1;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_new_eq_old
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW=OLD;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_old_eq_new
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  SET OLD = NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_new_eq_var
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_update_set_old_eq_var
AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET OLD=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_update_new_eq_old
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_update_old_eq_new
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET OLD=NEW;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

SELECT * FROM t1;
SELECT * FROM t2;

UPDATE t1 SET val1="D" WHERE id1= 1;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_update_new_eq_old;
TRUNCATE TABLE t2;

delimiter |;

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_update_old_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET OLD=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_update_new_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

UPDATE t1 SET val1="D" WHERE id1= 1;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER t1_before_update_new_eq_var;

delimiter |;

CREATE TRIGGER t1_before_update_new_eq_var
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT(5, "E");
  SET NEW=a.x;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
END|

delimiter ;|

--error ER_OPERAND_COLUMNS
UPDATE t1 SET val1="D" WHERE id1= 5;

DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # Checking for DELETE
--echo #

CREATE TABLE t1 (id1 INT, val1 VARCHAR(10));
CREATE TABLE t2 (id2 INT, val2 VARCHAR(10));

INSERT INTO t1 VALUES (1, "A"), (2, "B"), (3, "C");
SELECT * FROM t1;
SELECT * FROM t2;

delimiter |;

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_delete_new_eq_old
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_before_delete_old_eq_new
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  SET OLD = NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT (3, "C");
  SET OLD=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET a=OLD;
  INSERT INTO t2 VALUES(OLD.id1, OLD.val1);
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_delete_new_eq_old
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END|

--error ER_TRG_NO_SUCH_ROW_IN_TRG
CREATE TRIGGER t1_after_delete_old_eq_new
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  SET OLD=NEW;
END|

--error ER_TRG_CANT_CHANGE_ROW
CREATE TRIGGER t1_after_delete_old_eq_var
AFTER DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10)) DEFAULT (3, "C");
  SET OLD=a;
  INSERT INTO t2 VALUES(NEW.id1, NEW.val1);
END|

delimiter ;|

DELETE FROM t1 WHERE id1=1;

SELECT * FROM t1;
SELECT * FROM t2;

TRUNCATE TABLE t2;

DROP TRIGGER t1_before_delete_old_eq_var;

delimiter |;

CREATE TRIGGER t1_before_delete_old_eq_var
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT,y VARCHAR(10));
  SET a=OLD;
  INSERT INTO t2 VALUES(OLD.id1, OLD.val1);
END|

delimiter ;|

SELECT * FROM t2;

DELETE FROM t1 WHERE id1=2;

DROP TRIGGER t1_before_delete_old_eq_var;

delimiter |;

CREATE TRIGGER t1_before_delete_unequal_row
BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (x INT, y VARCHAR(10)) DEFAULT(5, "E");
  SET a.x = OLD;
END|

delimiter ;|

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
DELETE FROM t1 WHERE id1=3;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TABLE t1;
DROP TABLE t2;

--source include/have_innodb.inc

CREATE TABLE t1 (a INT);

delimiter $;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END$
delimiter ;$

let $restart_file= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect;
--exec echo "wait" > $restart_file
--shutdown_server
--source include/wait_until_disconnected.inc
-- exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
-- enable_reconnect
-- source include/wait_until_connected_again.inc

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # Shutdown and restart work ok
CREATE TABLE t1 (a INT);

DELIMITER |;
CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET NEW = OLD;
END;|

DELIMITER ;|

--replace_column 6 #
SHOW TRIGGERS;

--source include/restart_mysqld.inc

--replace_column 6 #
SHOW TRIGGERS;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # No unnecessary error emitted

CREATE TABLE t1 (a INT);

DELIMITER |;

CREATE TRIGGER t1_bu
BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE r ROW TYPE OF t1 DEFAULT (SELECT * FROM t1 WHERE a=1);
  SET NEW = r;
END;|

DELIMITER ;|

INSERT INTO t1 VALUES (1),(3);
UPDATE t1 SET a = 10 WHERE a = 3;

SELECT * FROM t1;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo #
--echo # Stored procedure variable scoping
--echo #

CREATE TABLE t1 (id1 INT, val1  INT);
CREATE TABLE t2 (id2 INT, val2 INT);

INSERT INTO t1 VALUES (1, 10);
INSERT INTO t2 VALUES (1, 10);

SELECT * FROM t1;
SELECT * FROM t2;

DELIMITER |;

CREATE TRIGGER trg BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  DECLARE a ROW (a1 INT, a2 INT) DEFAULT (3, 300);
  SET NEW= a;
  INSERT INTO t2 VALUES (NEW.id1, NEW.val1);
  BEGIN
    DECLARE OLD INT DEFAULT 2;
    DECLARE NEW INT DEFAULT 200;
    INSERT INTO t2 VALUES (OLD, NEW);
  END;
END|

DELIMITER ;|

UPDATE t1 SET id1 = 1 WHERE val1 = 10;

SELECT * FROM t1;
SELECT * FROM t2;

DROP TRIGGER trg;
DROP TABLE t1;
DROP TABLE t2;

--echo # Crash because m_thd was not set

CREATE TABLE t1 (a INT);
CREATE TABLE t2 (tag VARCHAR(10), val INT);

INSERT INTO t1 VALUES (1);

DELIMITER |;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  INSERT INTO t2 VALUES ('OLD', OLD), ('NEW', NEW);
END|
DELIMITER ;|

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
UPDATE t1 SET a = 100;

DROP TABLE t1, t2;

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);

INSERT INTO t1 VALUES (1, 1);

DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW BEGIN 
DECLARE a ROW (x INT,y INT) DEFAULT (-10, -10); 
SET NEW=OLD + a;

END$

DELIMITER ;$

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
UPDATE t1 SET a = 10;

DROP TRIGGER t1_bu;
DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # MDEV-40124: Assertion `m_sp == m_thd->spcont->m_sp' failed virtual
--echo # Item *Item_splocal::this_item(), UBSAN : member call on null
--echo # pointer of type 'Sp_rcontext_handler' in sql/item.cc
--echo #

CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,2);
delimiter |;
CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
BEGIN
  IF NEW = OLD THEN
    SET @x = 1;
  END IF;
END|
delimiter ;|

UPDATE t1 SET a = 9;

DROP TABLE t1;
--echo #
--echo # MDEV-40127: Server hangs when setting NEW=OLD on a multi-row table
--echo #

--echo # Test case: 1
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1);

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW SET NEW = OLD;

UPDATE t1 SET a = a + 100;
UPDATE t1 SET a = a + 100;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo Test case: 2

CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL);
INSERT INTO t1 VALUES (1,1),(2,2);

DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  BEGIN DECLARE r ROW(x INT,y INT) DEFAULT (9,9); SET NEW = r;
END;
$

DELIMITER ;$

UPDATE t1 SET a = 7;

DROP TRIGGER t1_bu;
DROP TABLE t1;

--echo # Test case: 3

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);

INSERT INTO t1 VALUES (1,1),(2,2);
DELIMITER $;

CREATE TRIGGER t1_bu BEFORE UPDATE ON t1 FOR EACH ROW
  BEGIN SET NEW = OLD; INSERT INTO t2 VALUES (NEW.a, NEW.b);
END;
$

DELIMITER ;$
UPDATE t1 SET a = 99;

DROP TRIGGER t1_bu;
DROP TABLE t1;
DROP TABLE t2;
--echo #
--echo # MDEV-40130: SIGSEGV in Field_iterator_table::set_table at
--echo #             sql/table.h:3350
--echo #

CREATE TABLE tt (a INT, b INT);
CREATE TRIGGER tg BEFORE INSERT ON tt FOR EACH ROW SET NEW = ROW(NEW.a, NEW.a);
INSERT INTO tt VALUES (1,2);

SELECT * FROM tt;

DROP TABLE tt;

CREATE TABLE tt (a INT, b INT);
CREATE TRIGGER tg BEFORE INSERT ON tt FOR EACH ROW SET NEW = ROW(NEW.a, NEW.a);
INSERT INTO tt VALUES (1,2);
SELECT * FROM tt;

FLUSH TABLES;

INSERT INTO tt VALUES (3,4);
SELECT * FROM tt;

DROP TABLE tt;

--echo #
--echo # MDEV-40490: SET NEW = (row subquery) in a trigger silently
--echo # assigns NULL to all columns and skips the single-row check
--echo #

CREATE TABLE src (a INT, b INT);
INSERT INTO src VALUES (10,20);

CREATE TABLE t (a INT, b INT) ;
CREATE TRIGGER t_bi
  BEFORE INSERT ON t FOR EACH ROW
    SET NEW = (SELECT a,b FROM src);

INSERT INTO t VALUES (1,2);
SELECT a,b FROM t;

DROP TABLE t, src;

--echo #
--echo # MDEV-41760: SIGSEGV in Field_iterator_table::set_table on
--echo # re-prepare of trigger SET NEW = (subquery) after DDL on referenced table
--echo #

CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t2 FOR EACH ROW SET NEW= (SELECT a,b FROM t1);
INSERT INTO t2 VALUES (1,1);
ALTER TABLE t1 FORCE;
INSERT INTO t2 VALUES (2,2); 
SELECT * FROM t2;
SELECT * FROM t1;
DROP TABLE t1,t2;

--echo #
--echo # MDEV-41761: SIGSEGV in sp_head::bind_input_param when trigger
--echo # passes NEW/OLD row as OUT parameter to CALL
--echo #

CREATE TABLE t (a INT);
CREATE PROCEDURE p(OUT r INT) BEGIN END;
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW CALL p(NEW);
INSERT INTO t VALUES (1);
DROP TABLE t;
DROP procedure p;

--echo #
--echo # MDEV-41765: Assertion m_sp == m_thd->spcont->m_sp failed in
--echo # Item_splocal::this_item / SIGSEGV in Item_splocal::get_rcontext on
--echo # SIGNAL ... SET MESSAGE_TEXT = NEW in trigger
--echo #
CREATE TABLE t (a INT);
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = NEW;
--error ER_SIGNAL_EXCEPTION
INSERT INTO t VALUES (1);

DROP TABLE t;

--echo #
--echo # MDEV-41831: SET NEW = (SELECT ...) in a BEFORE INSERT trigger
--echo # fails with ER_OPERAND_COLUMNS (1241) on a single-column table

CREATE TABLE t (a INT);                                                                                                                                                                                          
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW SET NEW = (SELECT 5);                                                                                                                                          
INSERT INTO t VALUES (1);
DROP TABLE t;

--echo #
--echo # MDEV-41827: SIGSEGV in Item_trigger_row::cleanup on condition pushdown
--echo # of row = NEW into derived table in trigger
--echo #
CREATE TABLE t (a INT, b INT);
CREATE TRIGGER tr BEFORE INSERT ON t FOR EACH ROW DO (SELECT 1 FROM (SELECT DISTINCT a, b FROM t) d WHERE (a, b) = NEW);
INSERT INTO t VALUES (1,2);
DROP TABLE t;

--echo #
--echo # MDEV-41826: Crash in Table_triggers_list::mark_fields_used on
--echo # INSERT after trigger re-parse fails with unknown column
--echo #

CREATE TABLE t1 (a INT); 
CREATE TABLE t2 (a INT); 
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW DO (SELECT a = NEW FROM t2);

--ERROR ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
INSERT INTO t1 VALUES (1);

ALTER TABLE t2 CHANGE a b INT;

--ERROR ER_BAD_FIELD_ERROR
INSERT INTO t1 VALUES (1);

--ERROR ER_BAD_FIELD_ERROR
INSERT INTO t1 VALUES (1);

DROP TABLE t1;
DROP TABLE t2;

--echo #
--echo # MDEV-41815: SIGSEGV in Item_trigger_row::cleanup on FLUSH TABLES after
--echo # a trigger runs DECLARE ROW TYPE OF cursor DEFAULT NEW
--echo #

CREATE TABLE t1 (a INT);
DELIMITER |;
CREATE TRIGGER tr BEFORE INSERT ON t1 FOR EACH ROW BEGIN DECLARE c CURSOR FOR SELECT 1; BEGIN DECLARE r ROW TYPE OF c DEFAULT NEW; END; END|
DELIMITER ;|
INSERT INTO t1 VALUES (1);
FLUSH TABLES;

DROP TABLE t1;

--echo #
--echo # MDEV-41814: Assertion `argp[arg_no]->fixed()' failed in
--echo # sp_head::execute_function
--echo #

CREATE TABLE t1 (a INT);
CREATE FUNCTION f(r ROW(a INT)) RETURNS INT RETURN 1;
CREATE TRIGGER tr BEFORE INSERT OR UPDATE ON t1 FOR EACH ROW DO f(OLD);

INSERT INTO t1 VALUES (1);
SELECT * FROM t1;

DROP FUNCTION f;
DROP TABLE t1;

--echo #
--echo # MDEV-41766: Assertion marked_for_read() failed in Field_long::val_int
--echo # on row comparison of NEW/OLD in AFTER trigger
--echo #
