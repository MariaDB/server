#
# MDEV-39492 Parallel Query: the optimizer costs the parallel scan.
#
# The join-order search prices the driving table's scan both ways -- serially,
# and divided among parallel_worker_threads workers plus the cost of setting
# them up -- extends both readings, and the plan is only run in the workers
# when the divided one won as a complete plan (parallel_scan_cost,
# add_parallel_driver_candidates, position_cost_in_plan). Three things
# follow. The first two are pinned on the same pair of tables: a five-row
# dimension of which one row matches, and a 20000-row fact table with a
# non-indexed filter. The third on a 20000-row dimension and a 200000-row
# fact table.
#
# A scan too small to repay the setup is not divided. Everything here is too
# small for the default setup cost, so with it the plan is the serial one and
# runs serially, and the trace says why.
#
# A large scan can win the driving position. With a setup cost the data can
# repay, the fact table first, scanned in parallel with the dimension looked up
# per surviving row, is costed as one worker's share and beats the serial
# dimension-first plan, which it would lose to serially. That is the plan the
# workers divide. Forced to start at the dimension, the plan still runs
# serially: dividing five rows, one of which survives the WHERE, puts the
# whole fact-table join on one worker, and the scan cannot repay even that
# setup. Only with no setup cost at all is it divided, which is what the
# workers did with every such plan before the scan was costed.
#
# The divided reading is judged as a plan, not on the driving table alone. A
# 20000-row dimension of which the first 2000 rows match, each with 10 fact
# rows under it, has a scan too small to repay the default setup on its own,
# and is still the plan to divide: the 20000 fact rows read spread over the
# workers save far more than the setup costs. It drives the join divided,
# whether the search orders the join or STRAIGHT_JOIN fixes the order. The
# matching rows lie together in the primary key, over four of the table's
# pages, which is the most workers the optimizer lets them reach
# (parallel_scan_cost) and as many as there are here.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/not_embedded.inc

CREATE TABLE dim (id INT PRIMARY KEY, name VARCHAR(10)) ENGINE=InnoDB;
INSERT INTO dim VALUES (1,'one'),(2,'two'),(3,'three'),(4,'four'),(5,'five');

CREATE TABLE fact (id INT PRIMARY KEY, dim_id INT, val INT, KEY(dim_id))
  ENGINE=InnoDB;
INSERT INTO fact SELECT seq, seq % 5 + 1, seq % 1000 FROM seq_1_to_20000;
ANALYZE TABLE dim, fact PERSISTENT FOR ALL;

SET @save_pwt= @@session.parallel_worker_threads;
SET @save_cost= @@session.optimizer_parallel_setup_cost;
SET @save_jcl= @@session.join_cache_level;
SET @save_trace= @@optimizer_trace;
# keep the plans plain ref joins, so that the costs compared are the scans'
SET SESSION join_cache_level= 0;

--echo #
--echo # Serial plan: the five-row dimension drives the join.
--echo #
SET SESSION parallel_worker_threads= 0;
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;

--echo #
--echo # Default setup cost: nothing here is large enough to repay it, so the
--echo # plan is the serial one, runs serially, and the trace says why.
--echo #
SET SESSION parallel_worker_threads= 4;
SET SESSION optimizer_trace=1;
--disable_result_log
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
--source include/parallel_query_why.inc
--enable_result_log
SET SESSION optimizer_trace=@save_trace;
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
FLUSH STATUS;
SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # A setup cost the data can repay: the fact table takes the driving
--echo # position and is the table the workers divide; the dimension is
--echo # looked up per surviving row.
--echo #
SET SESSION optimizer_parallel_setup_cost= 100;
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
FLUSH STATUS;
SELECT COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # Forced to start at the dimension, the plan is not worth dividing:
--echo # five rows cannot repay the setup, so it runs serially.
--echo #
SET SESSION optimizer_trace=1;
--disable_result_log
EXPLAIN SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
--source include/parallel_query_why.inc
--enable_result_log
SET SESSION optimizer_trace=@save_trace;
EXPLAIN SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
FLUSH STATUS;
SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # With no setup cost to repay, the same forced plan divides the
--echo # dimension again, as it did before the scan was costed.
--echo #
SET SESSION optimizer_parallel_setup_cost= 0;
EXPLAIN SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
FLUSH STATUS;
SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim d, fact f
  WHERE f.dim_id = d.id AND d.name = 'one' AND f.val < 50;
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # A driving table whose scan alone cannot repay the default setup, but
--echo # whose join can: the dimension drives the join divided, since the
--echo # fact lookups under it are spread over the workers.
--echo #
SET SESSION optimizer_parallel_setup_cost= @save_cost;
CREATE TABLE dim2 (id INT PRIMARY KEY, name VARCHAR(10)) ENGINE=InnoDB;
INSERT INTO dim2 SELECT seq, IF(seq <= 2000, 'match', 'other')
  FROM seq_1_to_20000;
CREATE TABLE fact2 (id INT PRIMARY KEY, dim_id INT, val INT, KEY(dim_id))
  ENGINE=InnoDB;
INSERT INTO fact2 SELECT seq, seq % 20000 + 1, seq % 1000 FROM seq_1_to_200000;
ANALYZE TABLE dim2, fact2 PERSISTENT FOR ALL;
EXPLAIN SELECT COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.name = 'match';
FLUSH STATUS;
SELECT COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.name = 'match';
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # The same with the order fixed: STRAIGHT_JOIN costs the order both
--echo # ways too.
--echo #
EXPLAIN SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.name = 'match';
FLUSH STATUS;
SELECT STRAIGHT_JOIN COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.name = 'match';
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # A table scanned under the divided driver takes a join buffer as it
--echo # does serially: each worker runs one of its own, so the plan is costed
--echo # with the buffer and runs with it, in the workers.
--echo #
SET SESSION join_cache_level= @save_jcl;
CREATE TABLE tag (id INT, name VARCHAR(10)) ENGINE=InnoDB;
INSERT INTO tag SELECT seq, CONCAT('t', seq) FROM seq_1_to_20;
SET SESSION parallel_worker_threads= 0;
EXPLAIN SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
  WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
SET SESSION parallel_worker_threads= 4;
EXPLAIN SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
  WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
FLUSH STATUS;
SELECT COUNT(*), MAX(t.name) FROM dim2 d, fact2 f, tag t
  WHERE f.dim_id = d.id AND d.name = 'match' AND t.id = f.val;
SELECT VARIABLE_VALUE > 0 AS ran_in_the_workers FROM information_schema.session_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed';

--echo #
--echo # What the workers ship is charged per row (optimizer_parallel_row_cost).
--echo # A query that does not aggregate ships every joined row, and the
--echo # manager receives them all by itself: charged enough per row, the
--echo # plan that was divided is read serially. A query that aggregates
--echo # ships its partial groups, not its rows, and the same charge leaves
--echo # it divided.
--echo #
SET @save_row= @@session.optimizer_parallel_row_cost;
SET SESSION parallel_worker_threads= 4;
SET SESSION optimizer_trace=1;
--disable_result_log
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.parallel_rows_shipped') AS rows_shipped
  FROM information_schema.optimizer_trace;
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000;
SET SESSION optimizer_parallel_row_cost= 100;
--disable_result_log
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000;
--source include/parallel_query_why.inc
--enable_result_log
EXPLAIN SELECT f.id, f.val FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000;
--echo # grouped: the partials shipped are counted by the groups, not the rows
--disable_result_log
EXPLAIN SELECT d.name, COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000 GROUP BY d.name;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.parallel_rows_shipped') AS rows_shipped
  FROM information_schema.optimizer_trace;
EXPLAIN SELECT d.name, COUNT(*), SUM(f.val) FROM dim2 d, fact2 f
  WHERE f.dim_id = d.id AND d.id <= 2000 GROUP BY d.name;
SET SESSION optimizer_trace=@save_trace;
SET SESSION optimizer_parallel_row_cost= @save_row;

SET SESSION join_cache_level= @save_jcl;
SET SESSION parallel_worker_threads= @save_pwt;
DROP TABLE dim, fact, dim2, fact2, tag;
