(CAST(j->'$.b' AS CHAR(6) ARRAY)));
ERROR 42000: Too many key parts specified; max 1 parts allowed
drop table t1;
# A plain KEY is the only thing an index over an ARRAY can be. The
# index is a fulltext index over the encoded elements underneath, which
# would not enforce UNIQUE or PRIMARY KEY, and which MATCH() would find
# nothing in.
create table t1 (j json,
unique key idx ((CAST(j->'$.a' AS CHAR(6) ARRAY))))engine=innodb;
