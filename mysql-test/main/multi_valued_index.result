# An index over an ARRAY has exactly one key part. A key with several
# would have no defining expression to show and no way to be read back.
create table t1 (j json, key idx ((CAST(j->'$.a' AS CHAR(6) ARRAY)),
(CAST(j->'$.b' AS CHAR(6) ARRAY))))engine=innodb;
