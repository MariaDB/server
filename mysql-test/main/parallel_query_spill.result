CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(200)) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, CONCAT(REPEAT('x',180), seq) FROM seq_1_to_400;
SET SESSION parallel_worker_threads=4;
SET SESSION tmp_memory_table_size=16384;
SET SESSION max_heap_table_size=16384;
# every row back from containers that had to be rebuilt
FLUSH STATUS;
