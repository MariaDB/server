#
# A multi-valued index is a fulltext index over the encoded elements, so
# every key has to be a token the engine will hold. One that is too short
# or too long is dropped silently, on the DML path and on the index build
# path alike, and a key that is not in the index is a row the query side
# would not find.
#
# The server runs with narrowed token size limits, see the .opt file.
#
--source include/have_innodb.inc
--source include/have_maria.inc
--source include/not_embedded.inc

select @@innodb_ft_min_token_size=8, @@innodb_ft_max_token_size=20,
       @@ft_min_word_len=8, @@ft_max_word_len=20;

--echo # A CHAR array has keys of 4 to 82 characters. Neither bound is
--echo # within what these settings index, whichever engine holds it.
--error ER_MVI_KEY_TOKEN_SIZE
create table t1 (j json,
                 key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
--error ER_MVI_KEY_TOKEN_SIZE
create table t1 (j json,
                 key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=myisam;
--error ER_MVI_KEY_TOKEN_SIZE
create table t1 (j json,
                 key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=aria;

--echo # An INT array has keys of exactly 16 characters, which do fit
create table t1 (c int, j json,
                 key idx ((CAST(j->'$.n' AS INT ARRAY))))engine=innodb;
insert into t1 values (1,'{"n": [1, 42]}'),(2,'{"n": [42, 43]}'),
                      (3,'{"n": [7]}');
--replace_column 9 #
explain select * from t1 where json_contains(j->'$.n', '42');
select * from t1 where json_contains(j->'$.n', '42') order by c;
--echo # the same rows without the index:
select * from t1 ignore index(idx)
 where json_contains(j->'$.n', '42') order by c;
# TODO: fix MVI column name generation so that we no longer have to
# drop the index here and add it back later
alter table t1 drop index idx;

--echo # Adding one whose keys do not fit is refused, and so is an ALTER
--echo # that would rebuild it.
--error ER_MVI_KEY_TOKEN_SIZE
alter table t1 add key idx2 ((CAST(j->'$.tags' AS CHAR(6) ARRAY)));
alter table t1 add column x int;
alter table t1 drop column x;

alter table t1 add key idx ((CAST(j->'$.n' AS INT ARRAY)));

--echo # The same index under limits it no longer fits is one the
--echo # optimizer has to leave alone, or it
--echo # could be searching for keys the engine may have dropped. The
--echo # rows must not change.
let $restart_parameters= --innodb-ft-max-token-size=10;
--source include/restart_mysqld.inc

select @@innodb_ft_max_token_size=10;
--replace_column 9 #
explain select * from t1 where json_contains(j->'$.n', '42');
select c from t1 where json_contains(j->'$.n', '42') order by c;

--echo # Leaving the index alone is not enough: a row written now would
--echo # have no key in it, and the keys are dropped as they are written,
--echo # not while they are searched for. The row would be missing from
--echo # the index for good thus corrupting the index. Refuse the write.
--error ER_MVI_KEY_TOKEN_SIZE
insert into t1 values (4, '{"n": [55]}');
--error ER_MVI_KEY_TOKEN_SIZE
update t1 set j= '{"n": [55]}' where c=3;
--echo # An update that leaves the indexed expression alone leaves the
--echo # index alone as well, so it is allowed
update t1 set c= 4 where c=3;
update t1 set c= 3 where c=4;

--echo # Reading and deleting stay allowed
select c from t1 where json_contains(j->'$.n', '7') order by c;
delete from t1 where c=3;
select c from t1 order by c;

--echo # Back under limits the index fits. The optimizer uses it again,
--echo # and it has an entry for every row
let $restart_parameters= --innodb-ft-max-token-size=20;
--source include/restart_mysqld.inc
select @@innodb_ft_max_token_size=20;

--replace_column 9 #
explain select c from t1 where json_contains(j->'$.n', '42');
select c from t1 where json_contains(j->'$.n', '42') order by c;
--echo # the same rows without the index:
select c from t1 ignore index(idx)
 where json_contains(j->'$.n', '42') order by c;

--echo # and writing is allowed again
insert into t1 values (4, '{"n": [55]}');
select c from t1 where json_contains(j->'$.n', '55') order by c;
select c from t1 ignore index(idx)
 where json_contains(j->'$.n', '55') order by c;

drop table t1;

--echo # One fit and one unfit MVI
let $restart_parameters= --innodb-ft-min-token-size=4 --innodb-ft-max-token-size=84;
--source include/restart_mysqld.inc

# Two multi-valued indexes, over different columns. Both fit the default
# limits (3..84): the INT array has keys of exactly 16 characters, the
# CHAR one of 4 to 84.
create table t1 (c int, j1 json, j2 json,
                 key idx_n ((CAST(j1->'$.n' AS INT ARRAY))),
                 key idx_t ((CAST(j2->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
insert into t1 values (1,'{"n": [1, 42]}','{"tags": ["aaa"]}');

--echo # Raise the minimum to 8. The INT keys still fit, the CHAR ones,
--echo # which can be 4 characters long, no longer do.
let $restart_parameters= --innodb-ft-min-token-size=8;
--source include/restart_mysqld.inc
select @@innodb_ft_min_token_size=8;

--echo # The optimizer uses the index that fits and leaves the other alone
--replace_column 9 #
explain select c from t1 where json_contains(j1->'$.n', '42');
--replace_column 9 #
explain select c from t1 where json_contains(j2->'$.tags', '"aaa"');

--echo # Updating the column the fitting index is over recomputes only
--echo # its key, and that key the engine will hold
update t1 set j1= '{"n": [1, 43]}' where c=1;

--echo # The other index would have to store a key it drops
--error ER_MVI_KEY_TOKEN_SIZE
update t1 set j2= '{"tags": ["bbb"]}' where c=1;

--echo # An INSERT computes both, so it is refused
--error ER_MVI_KEY_TOKEN_SIZE
insert into t1 values (2,'{"n": [7]}','{"tags": ["ccc"]}');

--echo # A column no index is over is free
update t1 set c= 2 where c=1;

select c, j1, j2 from t1;
drop table t1;
