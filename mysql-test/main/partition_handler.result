#
# MDEV-XXXXX HANDLER READ NEXT/PREV after a key read on a partitioned table
#
# RANGE partitioning
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY RANGE(a) (PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN (30));
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (7);
a
HANDLER t1 READ a NEXT;
a
8
HANDLER t1 READ a NEXT;
a
15
HANDLER t1 READ a NEXT;
a
25
HANDLER t1 READ a NEXT;
a
HANDLER t1 READ a = (15);
a
15
HANDLER t1 READ a NEXT;
a
25
HANDLER t1 READ a NEXT;
a
HANDLER t1 READ a = (29);
a
HANDLER t1 READ a PREV;
a
25
HANDLER t1 READ a PREV;
a
15
HANDLER t1 READ a PREV;
a
8
HANDLER t1 READ a = (12);
a
HANDLER t1 READ a PREV;
a
8
HANDLER t1 READ a PREV;
a
5
HANDLER t1 READ a PREV;
a
HANDLER t1 READ a = (8);
a
8
HANDLER t1 READ a PREV;
a
5
HANDLER t1 READ a = (15);
a
15
HANDLER t1 READ a PREV;
a
8
HANDLER t1 CLOSE;
DROP TABLE t1;
# HASH partitioning
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY HASH(a) PARTITIONS 3;
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (7);
a
HANDLER t1 READ a NEXT;
a
8
HANDLER t1 READ a NEXT;
a
15
HANDLER t1 READ a NEXT;
a
25
HANDLER t1 READ a NEXT;
a
HANDLER t1 READ a = (15);
a
15
HANDLER t1 READ a NEXT;
a
25
HANDLER t1 READ a NEXT;
a
HANDLER t1 READ a = (29);
a
HANDLER t1 READ a PREV;
a
25
HANDLER t1 READ a PREV;
a
15
HANDLER t1 READ a PREV;
a
8
HANDLER t1 READ a = (12);
a
HANDLER t1 READ a PREV;
a
8
HANDLER t1 READ a PREV;
a
5
HANDLER t1 READ a PREV;
a
HANDLER t1 READ a = (8);
a
8
HANDLER t1 READ a PREV;
a
5
HANDLER t1 READ a = (15);
a
15
HANDLER t1 READ a PREV;
a
8
HANDLER t1 CLOSE;
DROP TABLE t1;
# Single partition
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY HASH(a);
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (8);
a
8
HANDLER t1 READ a PREV;
a
5
HANDLER t1 READ a PREV;
a
HANDLER t1 READ a = (7);
a
HANDLER t1 READ a NEXT;
a
8
HANDLER t1 READ a NEXT;
a
15
HANDLER t1 CLOSE;
DROP TABLE t1;
# End of 11.4 tests
