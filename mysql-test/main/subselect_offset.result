#
# MDEV-41746 IN subquery accepted with OFFSET clause
#
create table t1 (a int);
insert into t1 values (1),(2);
create table t2 (a int);
insert into t2 values (1),(2),(3);
select t1.a in (select t2.a from t2 offset 10 rows) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a not in (select t2.a from t2 offset 10 rows) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a = any (select t2.a from t2 offset 10 rows) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a > all (select t2.a from t2 offset 10 rows) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a in ((select t2.a from t2 offset 10 rows)) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a in (select t2.a from t2 union select t2.a from t2 offset 10 rows)
from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a in (select t2.a from t2 union (select t2.a from t2 offset 10 rows))
from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select row(t1.a, 1) in (select t2.a, 1 from t2 offset 10 rows) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select * from t1 where t1.a in (select t2.a from t2 offset 10 rows);
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
prepare stmt from "select t1.a in (select t2.a from t2 offset ? rows) from t1";
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
select t1.a in (select t2.a from t2 limit 1 offset 10) from t1;
ERROR 42000: This version of MariaDB doesn't yet support 'LIMIT & IN/ALL/ANY/SOME subquery'
select * from t1 where t1.a in (values (1),(2) offset 1 rows);
ERROR 42000: This version of MariaDB doesn't yet support 'OFFSET & IN/ALL/ANY/SOME subquery'
# OFFSET in EXISTS and scalar subqueries is allowed
select exists (select t2.a from t2 offset 10 rows) from t1;
exists (select t2.a from t2 offset 10 rows)
0
0
select (select t2.a from t2 order by t2.a offset 2 rows) from t1;
(select t2.a from t2 order by t2.a offset 2 rows)
3
3
select a from t1 where exists (select * from t2 where t2.a=t1.a offset 1 rows);
a
select a from t1 where exists (select * from t2 where t2.a=t1.a limit 1);
a
1
2
# OFFSET without FETCH is kept in view definitions and EXPLAIN EXTENDED
create view v1 as select (select t2.a from t2 order by t2.a offset 2 rows) as c;
create view v2 as select a from t2 order by a offset 2 rows;
create view v3 as select a from t2 union select a from t2 order by a
offset 2 rows;
create view v4 as values (1),(2) offset 1 rows;
show create view v1;
View	Create View	character_set_client	collation_connection
v1	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v1` AS select (select `t2`.`a` from `t2` order by `t2`.`a` offset 2 rows) AS `c`	latin1	latin1_swedish_ci
show create view v2;
View	Create View	character_set_client	collation_connection
v2	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v2` AS select `t2`.`a` AS `a` from `t2` order by `t2`.`a` offset 2 rows	latin1	latin1_swedish_ci
show create view v3;
View	Create View	character_set_client	collation_connection
v3	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v3` AS select `t2`.`a` AS `a` from `t2` union select `t2`.`a` AS `a` from `t2` order by `a` offset 2 rows	latin1	latin1_swedish_ci
show create view v4;
View	Create View	character_set_client	collation_connection
v4	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v4` AS values (1),(2) offset 1 rows	latin1	latin1_swedish_ci
select * from v1;
c
3
select * from v2;
a
3
select * from v3;
a
3
select * from v4;
1
2
explain extended select a from t2 order by a offset 2 rows;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	ALL	NULL	NULL	NULL	NULL	3	100.00	Using filesort
Warnings:
Note	1003	select `test`.`t2`.`a` AS `a` from `test`.`t2` order by `test`.`t2`.`a` offset 2 rows
drop view v1, v2, v3, v4;
# Derived table with OFFSET without FETCH is not merged
select * from (select a from t2 order by a offset 2 rows) dt;
a
3
explain select * from (select a from t2 order by a offset 2 rows) dt;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	<derived2>	ALL	NULL	NULL	NULL	NULL	3	
2	DERIVED	t2	ALL	NULL	NULL	NULL	NULL	3	Using filesort
drop table t1, t2;
# End of 11.4 tests
