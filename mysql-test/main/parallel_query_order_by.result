#
# the plans that are declined, and what they have in common: EXPLAIN shows
# "Using filesort" against the table the workers would scan, with no
# "Using temporary" to put the sort above the join.
#
# a single table can only be ordered by sorting itself
#
# SELECT a FROM t1 WHERE b > 39990 ORDER BY a
SELECT a FROM t1 WHERE b > 39990 ORDER BY a;
