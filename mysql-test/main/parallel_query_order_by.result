SET @s= @@session.parallel_worker_threads;
CREATE TABLE t1 (pk INT PRIMARY KEY, a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq % 997, seq FROM seq_1_to_40000;
CREATE TABLE d1 (id INT PRIMARY KEY, nm VARCHAR(8)) ENGINE=InnoDB;
INSERT INTO d1 SELECT seq, CONCAT('n',seq) FROM seq_1_to_10;
ANALYZE TABLE t1, d1 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Engine-independent statistics collected
test.t1	analyze	status	OK
test.d1	analyze	status	Engine-independent statistics collected
test.d1	analyze	status	OK
#
# Ordered by a column of the inner table, so the sort cannot be done before
# the join and is applied to a temp table on the manager. Runs in the
# workers, and the whole answer is determined, so it is compared as it
# stands. Every ORDER BY here is a total order -- ties would be free to come
# back either way round and would say nothing.
#
# SELECT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a % 10 + 1 AND t1.b > 39990 ORDER BY d1.nm, t1.a
SELECT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a % 10 + 1 AND t1.b > 39990 ORDER BY d1.nm, t1.a;
a	nm
120	n1
119	n10
111	n2
112	n3
113	n4
114	n5
115	n6
116	n7
117	n8
118	n9
SELECT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a % 10 + 1 AND t1.b > 39990 ORDER BY d1.nm, t1.a;
a	nm
120	n1
119	n10
111	n2
112	n3
113	n4
