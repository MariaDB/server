#
# with a LIMIT, which the manager applies to the sorted rows, so the prefix
# is the one a serial run produces rather than whichever rows arrived first
#
# SELECT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a % 10 + 1 AND t1.b > 39990 ORDER BY d1.nm, t1.a LIMIT 3
SELECT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a % 10 + 1 AND t1.b > 39990 ORDER BY d1.nm, t1.a LIMIT 3;
