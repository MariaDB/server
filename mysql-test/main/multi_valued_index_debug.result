# A multi-valued index whose declaration was not written is a key we
# would open as a plain fulltext key over the base column -- a valid
# definition meaning something else. Refuse the table instead.
set @@debug_dbug='+d,mvi_skip_spec_image';
create table t1 (c int, j json,
key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
ERROR HY000: Incorrect information in file: './test/t1.frm'
set @@debug_dbug='';
# a table with no multi-valued index writes no image and is unaffected
set @@debug_dbug='+d,mvi_skip_spec_image';
create table t2 (c int, j json, key plain (c))engine=innodb;
set @@debug_dbug='';
insert into t2 values (1,'{"tags": ["aaa"]}');
select c from t2;
c
1
drop table t2;
# ... and the same table definition is fine once the image is written
create table t1 (c int, j json,
key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
insert into t1 values (1,'{"tags": ["aaa"]}');
flush tables;
select c from t1 where json_contains(j->'$.tags','"aaa"');
c
1
drop table t1;
