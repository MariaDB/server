#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
#
# UPDATE IGNORE..RETURNING..INTO is not supported yet.
# A row rejected by the engine is ignored, so it is not known before
# the update if the row is a second changed row.
# MDEV-42156 UPDATE IGNORE ... RETURNING ... INTO fails with
# ER_TOO_MANY_ROWS when the second row is skipped by IGNORE (duplicate key)
#
CREATE TABLE t1 (a INT UNIQUE, b INT) ENGINE=MyISAM;
INSERT INTO t1 VALUES (1,1),(2,2);
SET @b='unchanged';
UPDATE IGNORE t1 SET a=5 RETURNING b INTO @b;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
SELECT @b;
@b
unchanged
SELECT * FROM t1;
a	b
1	1
2	2
DROP TABLE t1;
# Also when no row would be changed
CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
SET @b='unchanged';
UPDATE IGNORE t1 SET b=b+1 RETURNING b INTO @b;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
UPDATE IGNORE t1 SET b=b+1 WHERE 1=0 RETURNING b INTO @b;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
SELECT @b;
@b
unchanged
DROP TABLE t1;
# A partitioned table
CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB PARTITION BY HASH(a) PARTITIONS 2;
INSERT INTO t1 VALUES (1,1);
UPDATE IGNORE t1 SET b=b+1 RETURNING b INTO @b;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
SELECT @b;
@b
unchanged
DROP TABLE t1;
# A system-versioned table
CREATE TABLE t1 (a INT, b INT) WITH SYSTEM VERSIONING;
INSERT INTO t1 VALUES (1,1);
UPDATE IGNORE t1 SET b=b+1 RETURNING b INTO @b;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
SELECT @b;
@b
unchanged
SELECT a, b FROM t1;
a	b
1	1
DROP TABLE t1;
# IGNORE in a stored procedure
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,1);
CREATE PROCEDURE p1()
BEGIN
DECLARE v INT;
UPDATE IGNORE t1 SET b=b+1 RETURNING b INTO v;
END;
$$
CALL p1;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE IGNORE..RETURNING..INTO'
DROP PROCEDURE p1;
DROP TABLE t1;
# UPDATE IGNORE .. RETURNING without INTO is supported
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,1);
UPDATE IGNORE t1 SET b=b+1 RETURNING b;
b
2
DROP TABLE t1;
# UPDATE .. RETURNING .. INTO without IGNORE is supported
CREATE TABLE t1 (a INT, b INT);
INSERT INTO t1 VALUES (1,1);
UPDATE t1 SET b=b+1 RETURNING b INTO @b;
SELECT @b;
@b
2
DROP TABLE t1;
# End of 13.1 tests
