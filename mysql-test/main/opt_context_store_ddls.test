--source include/not_embedded.inc
--source include/have_sequence.inc
--source include/have_partition.inc
--source include/no_view_protocol.inc

--disable_replay testfile Don't replay a replay test

set optimizer_record_context=ON;
show variables like 'optimizer_record_context';

set optimizer_record_context=OFF;
show variables like 'optimizer_record_context';

create database db1;
use db1;
create table t1 (a int, b int);
insert into t1 values (1,2),(2,3);

create table t2 (a int);
insert into t2 values (1),(2);

create view view1 as (select t1.a as a, t1.b as b, t2.a as c from (t1 join t2) where t1.a = t2.a);

--echo #
--echo # disable optimizer_record_context
--echo # there should be no context
--echo #
set optimizer_record_context=OFF;

select * from t1 where t1.a = 3;
--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # enable optimizer_record_context
--echo # The context will be recorded.
--echo #

set optimizer_record_context=ON;

select * from t1 where t1.a = 3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # disable again optimizer_record_context
--echo # context result should be empty
--echo #
set optimizer_record_context=OFF;

select * from t1 where t1.a = 3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # enable optimizer_record_context
--echo # context result should have 1 ddl statement for table t1
--echo #
set optimizer_record_context=ON;

select * from t1 where t1.a = 3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # test for view
--echo # context result should have 3 ddl statements
--echo #
set optimizer_record_context=ON;

select * from view1 where view1.a = 3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # test for temp table
--echo # context result should have 1 ddl statement for table t1
--echo #
create temporary table temp1(col1 int);
insert into temp1 select * from t2;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # there should be no duplicate ddls
--echo # there should be only 1 ddl for table t2
--echo #
select * from t2 union select * from t2 union select * from t2;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # there should be no duplicate ddls
--echo # there should be only 3 ddls for tables t1, t2, and view1
--echo #
select * from view1 where view1.a = 3 union select * from view1 where view1.a = 3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # Test for INSERT. The context will show both tables.
--echo #
insert into t1 values ((select max(t2.a) from t2), (select min(t2.a) from t2));

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # test for delete
--echo # context result should have 1 ddl statement for table t1
--echo #
delete from t1 where t1.a=3;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # test for update
--echo # context result should have 1 ddl statement for table t1
--echo #
update t1 set t1.b = t1.a;

--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # test for insert as select
--echo # context result should have 2 ddl statements for tables t1, t2
--echo #
insert into t1 (select t2.a as a, t2.a as b from t2);

--source include/opt_context_list_tables_ddls.inc

create database db2;
use db2;
create table t1(a int);
insert into t1 values (1),(2),(3);

--echo #
--echo # use database db1
--echo # test to select 2 tables with same name from 2 databases
--echo # context result should have 2 ddl statements for tables db1.t1, db2.t1
--echo #
use db1;
select db1_t1.b
FROM t1 AS db1_t1, db2.t1 AS db2_t1
WHERE db1_t1.a = db2_t1.a AND db1_t1.a >= 3;


--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # use database db2
--echo # test to select 2 tables with same name but from 2 databases
--echo # context result should have 2 ddl statements for tables db1.t1, db2.t1
--echo #
use db2;

select db1_t1.b
FROM db1.t1 AS db1_t1, db2.t1 AS db2_t1
WHERE db1_t1.a = db2_t1.a AND db1_t1.a >= 3;


--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # use database db2
--echo # test to select from 2 tables from 2 different databases,
--echo # of which one is a mysql table, and other is a db1 table
--echo # context result should have only 1 ddl
--echo #
select t1.b
FROM db1.t1 AS t1, mysql.db AS t2
WHERE t1.a >= 3;

--source include/opt_context_list_tables_ddls.inc

use db1;
drop table db2.t1;
drop database db2;
drop table temp1;
drop view view1;
drop table t2;

--echo #
--echo # const table test with explain
--echo #
insert into t1 select seq, seq from seq_1_to_10;
create table t2 (a int primary key, b int);
insert into t2 select seq, seq from seq_1_to_10;

explain select * from t1, t2 where t2.a=1 and t1.b=t2.b;

--source include/opt_context_list_tables_ddls.inc

drop table t1;
drop table t2;

--echo #
--echo # query failure test
--echo # context should not contain the failed query result
--echo # no table definitions for t10, and t11 should be present
--echo #
--disable_ps_protocol

create table t10 (a int, b int);
insert into t10 select seq, seq from seq_1_to_10;
create table t11 (a int primary key, b varchar(10));
insert into t11 values (1, 'one'),(2, 'two');

--error ER_BAD_FIELD_ERROR
select t10.b, t11.a from t10, t11 where t10.a = t11.c + 10;

--source include/opt_context_list_tables_ddls.inc

drop table t10;
drop table t11;

--enable_ps_protocol

--echo #
--echo # partitioned table test
--echo # context result should have 1 ddl
--echo #
create table t1 (
    pk int primary key,
    a int,
    key (a)
)
engine=myisam
partition by range(pk) (
    partition p0 values less than (10),
    partition p1 values less than MAXVALUE
);
insert into t1 select seq, MOD(seq, 100) from seq_1_to_5000;
flush tables;

explain
select * from t1 partition (p1) where a=10;

--source include/opt_context_list_tables_ddls.inc

drop table t1;

--echo #
--echo # test with insert delayed
--echo # test shouldn't fail
--echo # Also, context result shouldn't have any ddls
--echo #

CREATE TABLE t1 (
  a int(11) DEFAULT 1,
  b int(11) DEFAULT (a + 1),
  c int(11) DEFAULT (a + b)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
insert into t1 values ();
insert into t1 (a) values (2);
insert into t1 (a,b) values (10,20);
insert into t1 (a,b,c) values (100,200,400);

truncate table t1;
insert delayed into t1 values ();

--source include/opt_context_list_tables_ddls.inc

drop table t1;

--echo #
--echo # test primary, and foreign key tables
--echo # context result should have the ddls in correct order
--echo #

CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(10)
);

CREATE TABLE t2 (
    id INT,
    address VARCHAR(10),
    CONSTRAINT `fk_id` FOREIGN KEY (id) REFERENCES t1 (id)
);

insert into t1 values (1, 'abc'), (2, 'xyz');
insert into t2 values (1, 'address1'), (2, 'address2');

select t1.name, t2.address
from t1,t2 where t1.id = t2.id;

--source include/opt_context_list_tables_ddls.inc

drop table t1;
drop table t2;

--echo #
--echo # MDEV-37207: test multi delete of 2 tables
--echo # context result should have the ddls for both the tables
--echo #

create table t1(id1 int not null auto_increment primary key);
create table t2(id2 int not null);

insert into t1 values (1),(2);
insert into t2 values (1),(1),(2),(2);

delete t1.*, t2.* from t1, t2 where t1.id1 = t2.id2;

--source include/opt_context_list_tables_ddls.inc

--echo # rerun the same delete query
--echo # Now, context result should have the ddls for all 2 tables,
--echo # even though no data is deleted
delete t1.*, t2.* from t1, t2 where t1.id1 = t2.id2;

--source include/opt_context_list_tables_ddls.inc
 
drop table t1, t2;

--echo #
--echo # MDEV-40388: sequence.simple fails on replay
--echo #
create sequence s1;
--echo # context result should have the ddl
explain select * from s1;
--source include/opt_context_list_tables_ddls.inc
drop table s1;

--echo # ddls should be captured here
explain select * from seq_1_to_10;
--source include/opt_context_list_tables_ddls.inc
explain select * from seq_1_to_15_step_2 where seq = 5;
--source include/opt_context_list_tables_ddls.inc

--echo # End of 13.1 tests

--echo #
--echo # MDEV-40598: Capture sequences used only in column DEFAULT expressions
--echo #
create sequence s1;
create table t1 (a int primary key default nextval(s1), b int);

--echo # The INSERT itself evaluates the DEFAULT, so s1 is already open as
--echo # part of this very statement; ddls should include both s1 and t1
insert into t1 (b) values (1),(2),(3);
--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # s1 was opened only by the INSERT above and closed again at the
--echo # end of that statement; this SELECT never evaluates DEFAULT
--echo # NEXTVAL() itself, so it doesn't reopen s1 through normal means
--echo # either. It is still captured, resolved independently by name:
--echo # ddls should include both s1 and t1, with s1 appearing before t1
--echo # so that replay can recreate them
select * from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # Under LOCK TABLES, s1 sits in thd->open_tables merely because it
--echo # is locked, not because this particular SELECT touches it - its
--echo # current value must not be captured just from being locked
--echo #
flush tables;
lock tables t1 read, s1 read;
select * from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc
unlock tables;

--echo #
--echo # A user with SELECT on t1 but no privilege on s1:
--echo # ddls include both s1 and t1
--echo #
create user u1@localhost;
grant select on db1.t1 to u1@localhost;
flush tables;
connect (con_u1,localhost,u1,,db1);
set optimizer_record_context=ON;
select * from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc
disconnect con_u1;
connection default;
drop user u1@localhost;

--echo #
--echo # A table with two columns whose DEFAULT expressions depend on two
--echo # different sequences: both must be captured, before the table
--echo #
create sequence s2;
create table t2 (a int default nextval(s1), c int default nextval(s2));
#flush tables;
select * from t2;
--source include/opt_context_list_tables_ddls.inc
drop table t2;
drop sequence s2;

--echo #
--echo # The sequence s3 that t3's DEFAULT depends on was dropped:
--echo # ddls include both s3 and t3
--echo #
create sequence s3;
create table t3 (a int default nextval(s3), d int);
insert into t3 (d) values (1);
drop sequence s3;
flush tables;
select * from t3;
--source include/opt_context_list_tables_ddls.inc
drop table t3;

--echo #
--echo # A query that also calls a stored function:
--echo # ddls include both s1 and t1
--echo #
create function f1() returns int return 1;
flush tables;
select f1() from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc
drop function f1;

--echo #
--echo # The sequence s1 that t1's DEFAULT depends on was dropped and a
--echo # view s1 created in its place:
--echo # ddls include both s1 and t1
--echo #
drop sequence s1;
create view s1 as select 1 as x;
flush tables;
select * from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc

--echo #
--echo # Same, as a prepared statement executed twice:
--echo # ddls include both s1 and t1
--echo #
flush tables;
prepare stmt from 'select * from t1 where b < 10';
execute stmt;
execute stmt;
--source include/opt_context_list_tables_ddls.inc
deallocate prepare stmt;
drop view s1;

drop table t1;

--echo #
--echo # The sequence db2.s1 that db1.t1's DEFAULT depends on is in a
--echo # different database: ddls include db2.s1 and t1
--echo #
create database db2;
create sequence db2.s1 start 100 increment 10;
create table t1 (a int default nextval(db2.s1), b int);
insert into t1 (b) values (1);
flush tables;
select * from t1 where b < 10;
--source include/opt_context_list_tables_ddls.inc
drop table t1;
drop database db2;

--echo #
--echo # The sequence s1 is used in the query and t1's DEFAULT depends on it.
--echo # Whichever order they are listed in, ddls include s1's definition
--echo # with its current value, and t1
--echo #
create sequence s1 start 100 increment 10 maxvalue 200 cycle;
create table t1 (a int default nextval(s1), b int);
insert into t1 (b) values (1),(2);
flush tables;
select * from s1, t1;
--source include/opt_context_list_tables_ddls.inc
flush tables;
select * from t1, s1;
--source include/opt_context_list_tables_ddls.inc
drop table t1;
drop sequence s1;

--echo # End of 13.2 tests

drop database db1;
