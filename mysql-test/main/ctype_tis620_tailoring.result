_tis620'foo' = _latin1'foo'
1
SET NAMES DEFAULT;
#
# MDEV-41246: The repertoire of IF() must include the repertoires of
# both branches, not only of the winner branch (HEX(), ALNUM).
# The value '1.5' has a punctuation character, so the collations
# latin1_swedish_ci and tis620_thai_ci must not be mixed on it.
#
SET NAMES latin1;
SELECT HEX(255) = _tis620'A';
HEX(255) = _tis620'A'
0
SELECT '1.5' = _tis620'A';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (tis620_thai_ci,COERCIBLE) for operation '='
SELECT IF(1, 1.5, HEX(255)) = _tis620'A';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (tis620_thai_ci,COERCIBLE) for operation '='
SET NAMES DEFAULT;
