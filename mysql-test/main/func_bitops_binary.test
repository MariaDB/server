--echo #
--echo # MDEV-10526: Binary string support for bitwise operators & aggregate functions
--echo #

--echo # =========================================================================
--echo # SECTION 1 — Scalar operators on VARBINARY
--echo # =========================================================================
--echo # Rationale: Tests basic functional correctness of scalar bitwise operators
--echo # (&, |, ^, ~, <<, >>) when applied to VARBINARY(4) operands.
--echo # =========================================================================

CREATE TABLE t1 (a VARBINARY(4), b VARBINARY(4));
INSERT INTO t1 VALUES (x'FFFF0000', x'FF00FF00');

SELECT HEX(a & b), HEX(a | b), HEX(a ^ b), HEX(~a), HEX(a << 1), HEX(a >> 1) FROM t1;

DROP TABLE t1;

--echo # =========================================================================
--echo # SECTION 2 — INET6_ATON real-world use case
--echo # =========================================================================
--echo # Rationale: Verifies the primary target use case (subnet masking and IP math)
--echo # still operates correctly with INET6_ATON (which returns VARBINARY(16)).
--echo # =========================================================================

SELECT HEX(INET6_ATON('ffff:ffff::') & INET6_ATON('2001:db8::1'));
SELECT HEX(INET6_ATON('ffff:ffff::') | INET6_ATON('2001:db8::1'));
SELECT HEX(INET6_ATON('ffff:ffff::') ^ INET6_ATON('2001:db8::1'));

--echo # =========================================================================
--echo # SECTION 3 — NULL handling
--echo # =========================================================================
--echo # Rationale: Ensures that if any of the operands are NULL, the result of the
--echo # bitwise operation is also NULL.
--echo # =========================================================================

CREATE TABLE t_null (a VARBINARY(4), b VARBINARY(4));
INSERT INTO t_null VALUES (x'FFFF0000', NULL);
SELECT HEX(a & b), HEX(a | b), HEX(a ^ b), HEX(~b), HEX(a << b), HEX(a >> b) FROM t_null;
DROP TABLE t_null;

--echo # =========================================================================
--echo # SECTION 4 — Mismatched length error (in strict mode via INSERT)
--echo # =========================================================================
--echo # Rationale: Verifies that operating on binary string operands with mismatched
--echo # lengths throws ER_INVALID_BITWISE_OPERANDS_SIZE (error 4265) when escalating
--echo # to an error under strict mode on INSERT.
--echo # =========================================================================

CREATE TABLE t_mismatch (a VARBINARY(4), b VARBINARY(2));
INSERT INTO t_mismatch VALUES (x'FFFF0000', x'FFFF');

SET sql_mode='STRICT_TRANS_TABLES';
CREATE TABLE t_insert_mismatch (res VARBINARY(4));

--error ER_INVALID_BITWISE_OPERANDS_SIZE
INSERT INTO t_insert_mismatch SELECT a & b FROM t_mismatch;

--error ER_INVALID_BITWISE_OPERANDS_SIZE
INSERT INTO t_insert_mismatch SELECT a | b FROM t_mismatch;

--error ER_INVALID_BITWISE_OPERANDS_SIZE
INSERT INTO t_insert_mismatch SELECT a ^ b FROM t_mismatch;

DROP TABLE t_insert_mismatch;
SET sql_mode=DEFAULT;
DROP TABLE t_mismatch;

--echo # =========================================================================
--echo # SECTION 5 — Literal behavior (FINAL decided behavior)
--echo # =========================================================================
--echo # Rationale: Records the decided behavior of constant/hex-constant literals and
--echo # string/binary cast expressions, per Alexander and Sergei's review.
--echo # =========================================================================

SELECT x'FF' & 12;

SELECT 0xFF & 12;

SELECT HEX(_binary'a' & _binary'b');

SELECT 'a' & 'b';

--echo # Verification of binary vs integer mode execution on BLOB operands
CREATE OR REPLACE TABLE t1 (a BLOB);
INSERT INTO t1 VALUES ('a');
SELECT
  a & 51,
  a & 0x33,
  a & x'33',
  a & _latin1 '3',
  a & _binary '3',
  0x33 & 0x33
FROM t1;
DROP TABLE t1;

--echo # Verification that COALESCE correctly retains hex-hybrid type handler
SELECT HEX(COALESCE(0x30) & 1);

--echo # =========================================================================
--echo # SECTION 6 — Existing INET6/UUID error preservation
--echo # =========================================================================
--echo # Rationale: Confirms that existing parameter data type restrictions for
--echo # INET6 and UUID types are preserved and throw ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION (4079).
--echo # =========================================================================

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST('::' AS INET6) & CAST('::' AS INET6);

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST(UUID() AS UUID) & CAST(UUID() AS UUID);

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST('1.2.3.4' AS INET4) & CAST('1.2.3.4' AS INET4);

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST('1.2.3.4' AS INET4) & 1;

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT ST_GeomFromText('POINT(1 1)') & ST_GeomFromText('POINT(1 1)');

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT ST_GeomFromText('POINT(1 1)') & 1;

--echo # =========================================================================
--echo # SECTION 7 — Aggregate functions
--echo # =========================================================================
--echo # Rationale: Verifies BIT_AND, BIT_OR, and BIT_XOR aggregate function
--echo # calculations on VARBINARY columns under normal grouping conditions.
--echo # =========================================================================

CREATE TABLE t_agg (a VARBINARY(4));
INSERT INTO t_agg VALUES (x'FF000000'), (x'0F0F0F0F'), (x'00FF0000');

SELECT HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)) FROM t_agg;

DROP TABLE t_agg;

--echo # GROUP BY test with multiple groups
CREATE TABLE t_grp (grp INT, a VARBINARY(4));
INSERT INTO t_grp VALUES (1, x'FF000000'), (1, x'0F0F0F0F'), (2, x'00FF0000'), (2, x'0F0F0F0F');

--echo # 1, FF0F0F0F, 0F000000, F00F0F0F
--echo # 2, 0FFF0F0F, 000F0000, 0FF00F0F
SELECT grp, HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)) FROM t_grp GROUP BY grp;

DROP TABLE t_grp;

--echo # GROUP BY test with all-NULL group (update_field test)
CREATE TABLE t_nullgrp (grp INT, a VARBINARY(4), b BIGINT UNSIGNED);
INSERT INTO t_nullgrp VALUES
  (1, x'FF000000', 0xFF00000000000000),
  (1, x'0F0F0F0F', 0x0F0F0F0F00000000),
  (2, NULL, NULL),
  (2, NULL, NULL);
SELECT grp,
  HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)),
  BIT_OR(b), BIT_AND(b), BIT_XOR(b)
FROM t_nullgrp GROUP BY grp;
DROP TABLE t_nullgrp;

--echo # =========================================================================
--echo # SECTION 8 — Aggregate edge cases
--echo # =========================================================================
--echo # Rationale: Tests aggregate functions with NULL rows, empty tables,
--echo # and verify that operand sizes > 512 bytes are correctly blocked by the
--echo # size guard with ER_INVALID_BITWISE_AGGREGATE_OPERANDS_SIZE (4266).
--echo # =========================================================================

CREATE TABLE t_edge (a VARBINARY(4));
INSERT INTO t_edge VALUES (x'FF000000'), (NULL), (x'00FF0000');

SELECT HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)) FROM t_edge;

--echo # Empty result set (no rows)
SELECT HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)) FROM t_edge WHERE 1=0;

DROP TABLE t_edge;

--echo # Size guard validation (operand size > 512 bytes)
--error ER_INVALID_BITWISE_AGGREGATE_OPERANDS_SIZE
SELECT BIT_OR(CAST('a' AS BINARY(513)));

--echo # =========================================================================
--echo # SECTION 9 — Backward compatibility — integer mode unchanged
--echo # =========================================================================
--echo # Rationale: Verifies that operations on integer literals behave exactly
--echo # as they did in pre-patch versions of MariaDB.
--echo # =========================================================================

SELECT 5 & 3, 5 | 3, 5 ^ 3, ~0, 1 << 2, 8 >> 1;

--echo # =========================================================================
--echo # SECTION 10 — CREATE TABLE AS SELECT type preservation
--echo # =========================================================================
--echo # Rationale: Verifies that CTAS (Create Table As Select) correctly preserves
--echo # the resulting datatype as a VARBINARY/binary type.
--echo # =========================================================================

CREATE TABLE t_src (a VARBINARY(4), b VARBINARY(4));
CREATE TABLE t_dest AS SELECT a & b AS res FROM t_src;

SHOW CREATE TABLE t_dest;

DROP TABLE t_dest;
DROP TABLE t_src;

--echo # =========================================================================
--echo # SECTION 11 — return_type_handler length-boundary tests
--echo # =========================================================================
--echo # Rationale: Verifies that CTAS picks the correct storage type at each
--echo # boundary in return_type_handler(): <=255 -> CHAR/BINARY (type_handler_string),
--echo # 256..MAX_FIELD_VARCHARLENGTH -> VARCHAR (type_handler_varchar),
--echo # >MAX_FIELD_VARCHARLENGTH (65532) -> BLOB family (blob_type_handler).
--echo # Covers all binary operators so every Handler_str subclass is exercised.
--echo # =========================================================================

--echo # -- Small (<=255 bytes): expect BINARY(10) / char-family type
CREATE TABLE t_small (a VARBINARY(10), b VARBINARY(10));
CREATE TABLE t_small_and  AS SELECT a & b AS res FROM t_small;
CREATE TABLE t_small_or   AS SELECT a | b AS res FROM t_small;
CREATE TABLE t_small_xor  AS SELECT a ^ b AS res FROM t_small;
CREATE TABLE t_small_neg  AS SELECT ~a    AS res FROM t_small;
CREATE TABLE t_small_shl  AS SELECT a << 1 AS res FROM t_small;
CREATE TABLE t_small_shr  AS SELECT a >> 1 AS res FROM t_small;
SHOW CREATE TABLE t_small_and;
SHOW CREATE TABLE t_small_or;
SHOW CREATE TABLE t_small_xor;
SHOW CREATE TABLE t_small_neg;
SHOW CREATE TABLE t_small_shl;
SHOW CREATE TABLE t_small_shr;
DROP TABLE t_small_and, t_small_or, t_small_xor,
           t_small_neg, t_small_shl, t_small_shr, t_small;

--echo # -- Medium (256 .. 65532 bytes): expect VARCHAR(300) / varchar-family type
CREATE TABLE t_med (a VARBINARY(300), b VARBINARY(300));
CREATE TABLE t_med_and  AS SELECT a & b AS res FROM t_med;
CREATE TABLE t_med_or   AS SELECT a | b AS res FROM t_med;
CREATE TABLE t_med_xor  AS SELECT a ^ b AS res FROM t_med;
CREATE TABLE t_med_neg  AS SELECT ~a    AS res FROM t_med;
CREATE TABLE t_med_shl  AS SELECT a << 1 AS res FROM t_med;
CREATE TABLE t_med_shr  AS SELECT a >> 1 AS res FROM t_med;
SHOW CREATE TABLE t_med_and;
SHOW CREATE TABLE t_med_or;
SHOW CREATE TABLE t_med_xor;
SHOW CREATE TABLE t_med_neg;
SHOW CREATE TABLE t_med_shl;
SHOW CREATE TABLE t_med_shr;
DROP TABLE t_med_and, t_med_or, t_med_xor,
           t_med_neg, t_med_shl, t_med_shr, t_med;

--echo # -- Large (>65532 bytes): expect BLOB family type
--echo # VARBINARY max is 65532 = MAX_FIELD_VARCHARLENGTH; use BLOB columns (max_length=65535)
--echo # to exercise the blob_type_handler branch in return_type_handler().
CREATE TABLE t_large (a BLOB, b BLOB);
CREATE TABLE t_large_and  AS SELECT a & b AS res FROM t_large;
CREATE TABLE t_large_or   AS SELECT a | b AS res FROM t_large;
CREATE TABLE t_large_xor  AS SELECT a ^ b AS res FROM t_large;
CREATE TABLE t_large_neg  AS SELECT ~a    AS res FROM t_large;
SHOW CREATE TABLE t_large_and;
SHOW CREATE TABLE t_large_or;
SHOW CREATE TABLE t_large_xor;
SHOW CREATE TABLE t_large_neg;
DROP TABLE t_large_and, t_large_or, t_large_xor, t_large_neg, t_large;

--echo # -- Medium BLOB (>65535 bytes, <=16777215 bytes): expect MEDIUMBLOB
CREATE TABLE t_mblob (a MEDIUMBLOB, b MEDIUMBLOB);
CREATE TABLE t_mblob_dest AS SELECT a & b AS res FROM t_mblob LIMIT 0;
SHOW CREATE TABLE t_mblob_dest;
DROP TABLE t_mblob_dest, t_mblob;

--echo # -- Long BLOB (>16777215 bytes): expect LONGBLOB
CREATE TABLE t_lblob (a LONGBLOB, b LONGBLOB);
CREATE TABLE t_lblob_dest AS SELECT a & b AS res FROM t_lblob LIMIT 0;
SHOW CREATE TABLE t_lblob_dest;
DROP TABLE t_lblob_dest, t_lblob;

--echo # =========================================================================
--echo # SECTION 12 — Large literal tests with REPEAT()
--echo # =========================================================================
--echo # Rationale: Verifies that byte-loop and max_length logic in the binary
--echo # handlers scale correctly to large binary strings well beyond 4-16 bytes.
--echo # Uses _binary cast to force binary mode on user variables.
--echo # =========================================================================

--echo # -- 100-byte operands: check result length and spot-check first 4 bytes
SET @a100 = REPEAT('a', 100);
SET @b100 = REPEAT('b', 100);
SELECT LENGTH(CAST(@a100 AS BINARY(100)) & CAST(@b100 AS BINARY(100)));
SELECT HEX(LEFT(CAST(@a100 AS BINARY(100)) & CAST(@b100 AS BINARY(100)), 4));
SELECT LENGTH(CAST(@a100 AS BINARY(100)) | CAST(@b100 AS BINARY(100)));
SELECT LENGTH(CAST(@a100 AS BINARY(100)) ^ CAST(@b100 AS BINARY(100)));

--echo # -- 512-byte operands (at aggregate size guard boundary)
SET @a512 = REPEAT('x', 512);
SET @b512 = REPEAT('y', 512);
SELECT LENGTH(CAST(@a512 AS BINARY(512)) & CAST(@b512 AS BINARY(512)));
SELECT LENGTH(CAST(@a512 AS BINARY(512)) | CAST(@b512 AS BINARY(512)));
SELECT LENGTH(CAST(@a512 AS BINARY(512)) ^ CAST(@b512 AS BINARY(512)));

--echo # =========================================================================
--echo # SECTION 13 — COERCIBILITY() validation
--echo # =========================================================================
--echo # The result collation is aggregated from the arguments, like for
--echo # other string functions: a column gives IMPLICIT (2), literals give
--echo # COERCIBLE.
--echo # =========================================================================

CREATE TABLE t_coerc (a VARBINARY(4), b VARBINARY(4));
INSERT INTO t_coerc VALUES (x'FFFF0000', x'FF00FF00');

--echo # Columns: IMPLICIT
SELECT COERCIBILITY(a & b)  FROM t_coerc;
SELECT COERCIBILITY(a | b)  FROM t_coerc;
SELECT COERCIBILITY(a ^ b)  FROM t_coerc;
SELECT COERCIBILITY(~a)     FROM t_coerc;
SELECT COERCIBILITY(a << 1) FROM t_coerc;
SELECT COERCIBILITY(a >> 1) FROM t_coerc;
SELECT COERCIBILITY(BIT_OR(a)) FROM t_coerc;
--echo # Literals: the same as for the argument
SELECT COERCIBILITY(_binary'ab'), COERCIBILITY(_binary'ab' & _binary'cd'),
       COERCIBILITY(~_binary'ab');

DROP TABLE t_coerc;

--echo # =========================================================================
--echo # SECTION 14 — Mismatched length warning (outside strict mode via SELECT)
--echo # =========================================================================
--echo # Rationale: Verifies that SELECT with mismatched lengths outside strict mode
--echo # returns NULL with warning 4265 (ER_INVALID_BITWISE_OPERANDS_SIZE) for all
--echo # three binary operators (&, |, ^).
--echo # =========================================================================

CREATE TABLE t_mismatch (a VARBINARY(4), b VARBINARY(2));
INSERT INTO t_mismatch VALUES (x'FFFF0000', x'FFFF');

SET sql_mode='';

SELECT a & b FROM t_mismatch;
SHOW WARNINGS;

SELECT a | b FROM t_mismatch;
SHOW WARNINGS;

SELECT a ^ b FROM t_mismatch;
SHOW WARNINGS;

SET sql_mode=DEFAULT;
DROP TABLE t_mismatch;

--echo # =========================================================================
--echo # SECTION 15 — Window function support for binary mode aggregates
--echo # =========================================================================
--echo # Rationale: Verify BIT_AND/OR/XOR work
--echo # correctly as window functions on binary columns, including proper
--echo # row removal when the window frame slides (not just full partition).
--echo # =========================================================================

CREATE TABLE t_win_part (grp INT, a VARBINARY(4));
INSERT INTO t_win_part VALUES
  (1, x'FF000000'), (1, x'0F0F0F0F'),
  (2, x'00FF0000'), (2, x'000000FF');
SELECT grp, HEX(a) as hex_a,
  HEX(BIT_OR(a) OVER (PARTITION BY grp)) AS or_w,
  HEX(BIT_AND(a) OVER (PARTITION BY grp)) AS and_w,
  HEX(BIT_XOR(a) OVER (PARTITION BY grp)) AS xor_w
FROM t_win_part ORDER BY grp, hex_a;
DROP TABLE t_win_part;

--echo # Sliding window frame - proves remove_binary_as_window correctly
--echo # evicts rows as the frame moves (not just accumulates everything)
CREATE TABLE t_win_slide (id INT, a VARBINARY(2));
INSERT INTO t_win_slide VALUES
  (1, x'FF00'), (2, x'0F0F'), (3, x'00FF');
SELECT id, HEX(a) as hex_a,
  HEX(BIT_OR(a) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) AS sliding_or
FROM t_win_slide ORDER BY id;
DROP TABLE t_win_slide;

--echo # =========================================================================
--echo # SECTION 16 — WITH ROLLUP support for binary mode aggregates
--echo # =========================================================================
--echo # Rationale: Verify copy_or_same() for BIT_AND/BIT_OR/BIT_XOR
--echo # fix for ANY_VALUE, verified that BIT_OR/BIT_AND/BIT_XOR already have
--echo # correct copy_or_same() implementations (each properly clones via the
--echo # Item_sum_bit copy constructor, which deep-copies m_str_value and
--echo # m_binary_bit_counters). WITH ROLLUP requires copy_or_same() to clone
--echo # a separate accumulator for the grand-total row - without it, rollup
--echo # rows would corrupt or share state with per-group accumulators.
--echo # =========================================================================

CREATE TABLE t_rollup (grp INT, a VARBINARY(4));
INSERT INTO t_rollup VALUES
  (1, x'FF000000'), (1, x'0F0F0F0F'),
  (2, x'00FF0000'), (2, x'000000FF');
SELECT grp, HEX(BIT_OR(a)) as or_v, HEX(BIT_AND(a)) as and_v, HEX(BIT_XOR(a)) as xor_v
FROM t_rollup GROUP BY grp WITH ROLLUP;
DROP TABLE t_rollup;

--echo # =========================================================================
--echo # SECTION 17 — Truncation warning for non-numeric values in integer mode
--echo # =========================================================================
--echo # Rationale: Verify ER_TRUNCATED_WRONG_VALUE (1292) is raised when
--echo # a non-numeric string is used in integer-mode bitwise operations,
--echo # consistent with MariaDB's behavior for '123a'+3 -> 123 with warning.
--echo # =========================================================================

SELECT 'abc' & 255;
SHOW WARNINGS;
SELECT '123abc' | 255;
SHOW WARNINGS;

--echo # =========================================================================
--echo # SECTION 18 — Aggregates over values shorter than the declared length
--echo # =========================================================================

CREATE TABLE t1 (g INT, a VARBINARY(16));
INSERT INTO t1 VALUES (1, NULL), (1, x'FF00'), (1, x'0F0F'),
                      (2, x'F0F0F0F0'), (2, x'0000FFFF'), (3, NULL);
SELECT HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a)) FROM t1 WHERE g = 1;
--echo # GROUP BY using a temporary table (reset_field()/update_field())
SELECT g, HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a))
FROM t1 GROUP BY g;
--echo # Window functions
SELECT g, HEX(a),
  HEX(BIT_OR(a) OVER (PARTITION BY g)) AS or_w,
  HEX(BIT_AND(a) OVER (PARTITION BY g ORDER BY a
                       ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) AS and_w
FROM t1 ORDER BY g, a;
--echo # Values of different lengths in one group
--error ER_INVALID_BITWISE_OPERANDS_SIZE
SELECT BIT_OR(a) FROM t1;
--error ER_INVALID_BITWISE_OPERANDS_SIZE
SELECT g, BIT_OR(a) FROM t1 GROUP BY g WITH ROLLUP;
--echo # Prepared statement re-execution
PREPARE s FROM 'SELECT g, HEX(BIT_OR(a)), HEX(BIT_AND(a)) FROM t1 GROUP BY g';
EXECUTE s;
EXECUTE s;
DEALLOCATE PREPARE s;
DROP TABLE t1;

--echo # IPv4 and IPv6 addresses: INET6_ATON() returns VARBINARY(16)
CREATE TABLE t1 (ip VARCHAR(64));
INSERT INTO t1 VALUES ('10.0.1.1'), ('10.0.2.1'), ('10.0.4.1');
SELECT INET6_NTOA(BIT_OR(INET6_ATON(ip))) AS or_ip,
       INET6_NTOA(BIT_AND(INET6_ATON(ip))) AS and_ip FROM t1;
DROP TABLE t1;

--echo # =========================================================================
--echo # SECTION 19 — Numeric value and data type of binary aggregates
--echo # =========================================================================

CREATE TABLE t1 (a VARBINARY(2));
INSERT INTO t1 VALUES ('12'), ('01');
--echo # 0x31|0x30 = 0x31 ('1'), 0x32|0x31 = 0x33 ('3')
SELECT BIT_OR(a), BIT_OR(a) + 0, CAST(BIT_OR(a) AS SIGNED),
       CAST(BIT_OR(a) AS DECIMAL(10,2)), BIT_OR(a) = '13' FROM t1;
SELECT (_binary'12' | _binary'01') + 0;
CREATE TABLE t2 AS SELECT BIT_OR(a) AS o, BIT_AND(a) AS n, BIT_XOR(a) AS x
FROM t1;
SHOW CREATE TABLE t2;
SELECT HEX(o), HEX(n), HEX(x) FROM t2;
DROP TABLE t2, t1;

--echo # =========================================================================
--echo # SECTION 20 — FILTER clause (MDEV-24943)
--echo # =========================================================================

CREATE TABLE t1 (g INT, f INT, a VARBINARY(16), n BIGINT UNSIGNED);
INSERT INTO t1 VALUES
  (1, 0, x'AAAA', 0xF0), (1, 1, x'FF00', 0x0F), (1, 1, x'0F0F', 0x33),
  (2, 1, x'F0F0F0F0', 0xFF), (2, 0, x'0000FFFF', 0x01),
  (3, 0, x'FFFF', 0x11), (4, 1, NULL, NULL), (4, 0, x'1234', 0x22);

--echo # Rows rejected by the filter are not aggregated
SELECT HEX(BIT_OR(a) FILTER (WHERE f = 1 AND g = 1)) AS o,
       HEX(BIT_AND(a) FILTER (WHERE f = 1 AND g = 1)) AS n,
       HEX(BIT_XOR(a) FILTER (WHERE f = 1 AND g = 1)) AS x,
       BIT_OR(n) FILTER (WHERE f = 1) AS io,
       BIT_AND(n) FILTER (WHERE f = 1) AS ia,
       BIT_XOR(n) FILTER (WHERE f = 1) AS ix
FROM t1;

--echo # A value of another length is skipped by the filter: no error
SELECT HEX(BIT_OR(a) FILTER (WHERE LENGTH(a) = 2)) AS o FROM t1;
--error ER_INVALID_BITWISE_OPERANDS_SIZE
SELECT HEX(BIT_OR(a) FILTER (WHERE f = 1)) AS o FROM t1;

--echo # No row passes the filter: the neutral value is returned
SELECT HEX(BIT_OR(a) FILTER (WHERE f = 2)) AS o,
       HEX(BIT_AND(a) FILTER (WHERE f = 2)) AS n,
       BIT_AND(n) FILTER (WHERE f = 2) AS ia
FROM t1;

--echo # GROUP BY using a temporary table (reset_field()/update_field()):
--echo # group 1 starts with a filtered row, group 3 has no row passing
--echo # the filter, group 4 has only a NULL passing it
SELECT g,
  HEX(BIT_OR(a) FILTER (WHERE f = 1)) AS o,
  HEX(BIT_AND(a) FILTER (WHERE f = 1)) AS n,
  HEX(BIT_XOR(a) FILTER (WHERE f = 1)) AS x,
  BIT_OR(n) FILTER (WHERE f = 1) AS io,
  BIT_AND(n) FILTER (WHERE f = 1) AS ia
FROM t1 GROUP BY g;

--echo # The same with an index: GROUP BY without a temporary table
ALTER TABLE t1 ADD INDEX (g);
SELECT g,
  HEX(BIT_OR(a) FILTER (WHERE f = 1)) AS o,
  HEX(BIT_AND(a) FILTER (WHERE f = 1)) AS n,
  HEX(BIT_XOR(a) FILTER (WHERE f = 1)) AS x,
  BIT_OR(n) FILTER (WHERE f = 1) AS io,
  BIT_AND(n) FILTER (WHERE f = 1) AS ia
FROM t1 FORCE INDEX (g) GROUP BY g;

--echo # Prepared statement re-execution
PREPARE s FROM
  'SELECT g, HEX(BIT_OR(a) FILTER (WHERE f = ?)) FROM t1 GROUP BY g';
SET @f= 1;
EXECUTE s USING @f;
SET @f= 0;
EXECUTE s USING @f;
DEALLOCATE PREPARE s;
DROP TABLE t1;

--echo # =========================================================================
--echo # SECTION 21 — Scalar operators: NULL operands, empty strings, shift counts
--echo # =========================================================================

CREATE TABLE t1 (a VARBINARY(4), b VARBINARY(4), n INT);
INSERT INTO t1 VALUES (NULL, x'FF00FF00', 1), (x'FF00FF00', NULL, NULL),
                      (NULL, NULL, NULL);
--echo # NULL in the first, in the second and in both operands
SELECT HEX(a), HEX(b), HEX(a & b), HEX(a | b), HEX(a ^ b), HEX(~a),
       HEX(a << 1), HEX(a >> 1), HEX(b << n), HEX(b >> n)
FROM t1;
DROP TABLE t1;

--echo # Empty strings
SELECT HEX(_binary'' & _binary''), HEX(_binary'' | _binary''),
       HEX(_binary'' ^ _binary''), HEX(~_binary''),
       HEX(_binary'' << 1), HEX(_binary'' >> 1),
       LENGTH(~_binary''), LENGTH(_binary'' << 1), LENGTH(_binary'' >> 100);

--echo # Shift counts: inside a byte, across bytes, whole bytes, out of range
CREATE TABLE t1 (n BIGINT);
INSERT INTO t1 VALUES (0), (1), (4), (7), (8), (9), (12), (16), (23), (24),
                      (31), (32), (33), (64), (-1),
                      (9223372036854775807), (-9223372036854775807 - 1);
SELECT n, HEX(x'81C3E7FF' << n) AS shl, HEX(x'81C3E7FF' >> n) AS shr
FROM t1;
--echo # Unsigned shift count above LONGLONG_MAX
SELECT HEX(x'81C3E7FF' << 18446744073709551615) AS shl,
       HEX(x'81C3E7FF' >> 18446744073709551615) AS shr;
--echo # A single byte
SELECT n, HEX(x'81' << n) AS shl, HEX(x'81' >> n) AS shr
FROM t1 WHERE n BETWEEN 0 AND 9;
DROP TABLE t1;

--echo # =========================================================================
--echo # SECTION 22 — Aggregates: conversion of the result, errors, windows
--echo # =========================================================================

CREATE TABLE t1 (g INT, a VARBINARY(8), n BIGINT UNSIGNED);
INSERT INTO t1 VALUES (1, '3', 20240131), (1, '2', 20240131),
                      (2, '20240131', 3), (3, '1', 1);
--echo # Binary mode: the result '3' as an integer, as a boolean
SELECT LEFT('abcdef', BIT_OR(a)) AS i, IF(BIT_OR(a), 'yes', 'no') AS b
FROM t1 WHERE g = 1;
--echo # Binary mode: the result '20240131' as a date
SELECT CAST(BIT_OR(a) AS DATE) AS d, LAST_DAY(BIT_AND(a)) AS l
FROM t1 WHERE g = 2;
--echo # Integer mode: the result as a string, a double, a decimal, a date
SELECT CONCAT(BIT_OR(n)) AS s, BIT_OR(n) + 0e0 AS r, BIT_OR(n) + 0.0 AS d,
       CAST(BIT_AND(n) AS DATE) AS dt, LAST_DAY(BIT_XOR(n)) AS l
FROM t1 WHERE g = 1;

--echo # Data types that can be converted neither to a binary string
--echo # nor to an integer
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT BIT_OR(POINT(1,1));
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT BIT_AND(CAST('::' AS INET6));

--echo # Values of different lengths in one group of a temporary table
--echo # (update_field())
--error ER_INVALID_BITWISE_OPERANDS_SIZE
SELECT g < 3 AS grp, HEX(BIT_OR(a)) FROM t1 GROUP BY grp;
--echo # ... and of a window
--error ER_INVALID_BITWISE_OPERANDS_SIZE
SELECT HEX(BIT_OR(a) OVER (ORDER BY g)) FROM t1;

--echo # A value equal to the neutral value of the declared length is
--echo # aggregated as any other value
SELECT HEX(BIT_OR(a)), HEX(BIT_AND(a)), HEX(BIT_XOR(a))
FROM (SELECT x'0000' AS a UNION ALL SELECT x'FFFF' UNION ALL SELECT x'0000'
      UNION ALL SELECT x'FFFF') dt;

--echo # Sliding frames: values are removed from all three aggregates,
--echo # NULL and rows rejected by FILTER are neither added nor removed
DELETE FROM t1;
INSERT INTO t1 VALUES (1, x'FF00', 1), (2, x'0FF0', 1), (3, NULL, 1),
                      (4, x'00FF', 0), (5, x'F00F', 1), (6, x'FFFF', 1),
                      (7, x'0001', 1);
SELECT g, HEX(a),
  HEX(BIT_OR(a) OVER w) AS o, HEX(BIT_AND(a) OVER w) AS n,
  HEX(BIT_XOR(a) OVER w) AS x,
  HEX(BIT_OR(a) FILTER (WHERE n = 1) OVER w) AS fo,
  HEX(BIT_AND(a) FILTER (WHERE n = 1) OVER w) AS fn,
  HEX(BIT_XOR(a) FILTER (WHERE n = 1) OVER w) AS fx
FROM t1
WINDOW w AS (ORDER BY g ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
ORDER BY g;
--echo # The frame becomes empty: the neutral value
SELECT g, HEX(BIT_OR(a) OVER w) AS o, HEX(BIT_AND(a) OVER w) AS n,
       HEX(BIT_XOR(a) OVER w) AS x
FROM t1 WHERE g IN (1, 3)
WINDOW w AS (ORDER BY g ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
ORDER BY g;
--echo # Window functions over the result of GROUP BY ... WITH ROLLUP
--sorted_result
SELECT g, HEX(BIT_OR(a)) AS o, HEX(BIT_OR(BIT_OR(a)) OVER ()) AS ow,
       BIT_XOR(n) AS x, BIT_OR(BIT_XOR(n)) OVER () AS xw
FROM t1 WHERE g < 3 GROUP BY g WITH ROLLUP;
DROP TABLE t1;

--echo #
--echo # End of 13.2 tests
--echo #
