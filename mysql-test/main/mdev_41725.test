--echo #
--echo # MDEV-41725 cset_narrowing wrong result for non-general_ci utf8mb4 constant
--echo #

SET @save_optimizer_switch= @@optimizer_switch;
SET @save_character_set_client= @@character_set_client;
SET @save_character_set_results= @@character_set_results;
SET @save_collation_connection= @@collation_connection;

SET optimizer_switch='cset_narrowing=on';
SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;

CREATE TABLE t1 (a VARCHAR(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci,
                 b VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
                 KEY(a));
INSERT INTO t1 VALUES (_utf8mb3 0xEFBFBD, _utf8mb4 0xF09F9880), ('a', 'a');

--echo # The bug: connection collation is utf8mb4_unicode_ci
EXPLAIN SELECT HEX(a), HEX(b) FROM t1 WHERE a = b AND b = '😀';
SELECT HEX(a), HEX(b) FROM t1 WHERE a = b AND b = '😀';
SELECT HEX(a), HEX(b) FROM t1 IGNORE INDEX(a) WHERE a = b AND b = '😀';

DROP TABLE t1;

--echo # Same query with utf8mb4_bin connection collation
SET NAMES utf8mb4 COLLATE utf8mb4_bin;
CREATE TABLE t1 (a VARCHAR(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci,
                 b VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
                 KEY(a));
INSERT INTO t1 VALUES (_utf8mb3 0xEFBFBD, _utf8mb4 0xF09F9880), ('a', 'a');
SELECT HEX(a), HEX(b) FROM t1 WHERE a = b AND b = '😀';
SELECT HEX(a), HEX(b) FROM t1 IGNORE INDEX(a) WHERE a = b AND b = '😀';
DROP TABLE t1;

--echo # Controls: indexed and IGNORE INDEX results must be identical
SET NAMES utf8mb4;
CREATE TABLE t1 (a VARCHAR(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci, KEY(a));
INSERT INTO t1 VALUES (_utf8mb3 0xEFBFBD), ('a');
SELECT HEX(a) FROM t1 WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_unicode_ci;
SELECT HEX(a) FROM t1 IGNORE INDEX(a) WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_unicode_ci;
SELECT HEX(a) FROM t1 WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_unicode_520_ci;
SELECT HEX(a) FROM t1 IGNORE INDEX(a) WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_unicode_520_ci;
SELECT HEX(a) FROM t1 WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_bin;
SELECT HEX(a) FROM t1 IGNORE INDEX(a) WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_bin;
SELECT HEX(a) FROM t1 WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_general_ci;
SELECT HEX(a) FROM t1 IGNORE INDEX(a) WHERE a = _utf8mb4 0xF09F9880 COLLATE utf8mb4_general_ci;
DROP TABLE t1;

SET optimizer_switch= @save_optimizer_switch;
SET character_set_client= @save_character_set_client;
SET character_set_results= @save_character_set_results;
SET collation_connection= @save_collation_connection;

--echo #
--echo # End of test
--echo #
