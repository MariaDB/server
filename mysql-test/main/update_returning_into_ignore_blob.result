#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
#
# MDEV-42156 UPDATE IGNORE ... RETURNING ... INTO fails with ER_TOO_MANY_ROWS when the second row is skipped by IGNORE (duplicate key)
#
#
# UPDATE IGNORE .. RETURNING .. INTO for a table with BLOB columns.
# If the second changed row is updated back, its BLOB values are
# restored. The test is run for MyISAM, Aria and InnoDB
# (see update_returning_into_ignore_blob.combinations).
#
#
# Duplicate key: the second row is rejected
#
CREATE TABLE t1 (a INT UNIQUE, b INT, c LONGTEXT, d TEXT);
INSERT INTO t1 VALUES (1,1,REPEAT('x',70000),'dd1'),
(2,2,REPEAT('y',70000),'dd2');
SET @b='unchanged';
UPDATE IGNORE t1 SET a=5, c=CONCAT(c,'z'), d=CONCAT(d,'q')
RETURNING b INTO @b;
SELECT @b;
@b
1
SELECT a, b, LENGTH(c), RIGHT(c,2), d FROM t1 ORDER BY b;
a	b	LENGTH(c)	RIGHT(c,2)	d
5	1	70001	xz	dd1q
2	2	70000	yy	dd2
DROP TABLE t1;
#
# Two rows are changed: the BLOB values of the second row are restored
#
CREATE TABLE t1 (a INT, b INT, c LONGTEXT, d TEXT);
INSERT INTO t1 VALUES (1,1,REPEAT('x',70000),'dd1'),
(2,2,REPEAT('y',70000),'dd2');
CREATE TEMPORARY TABLE t2 AS SELECT a, MD5(c) AS mc, MD5(d) AS md FROM t1;
SET @b='unchanged';
UPDATE IGNORE t1 SET c=CONCAT(c,'z'), d=CONCAT(d,'q'), b=b+1
RETURNING b INTO @b;
ERROR 42000: Result consisted of more than one row
SELECT @b;
@b
2
SELECT t1.a, t1.b, LENGTH(t1.c), MD5(t1.c)=t2.mc AS c_same,
t1.d, MD5(t1.d)=t2.md AS d_same
FROM t1 JOIN t2 USING (a) ORDER BY a;
a	b	LENGTH(t1.c)	c_same	d	d_same
1	2	70001	0	dd1q	0
2	2	70000	1	dd2	1
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TEMPORARY TABLE t2;
DROP TABLE t1;
# End of 13.1 tests
