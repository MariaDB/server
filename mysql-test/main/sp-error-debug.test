#
# Stored routine error paths that need DBUG_EXECUTE_IF fault injection
# to reach (DEBUG binaries only).
#

--source include/have_debug.inc

--echo #
--echo # MDEV-41205 CREATE OR REPLACE FUNCTION/PROCEDURE/PACKAGE must
--echo # report an error, not crash or silently succeed, when it fails
--echo # to delete the routine it is replacing.
--echo #

SET @save_dbug=@@session.debug_dbug;

--echo # FUNCTION: the delete of the old row fails.
CREATE FUNCTION f1() RETURNS INT RETURN 1;
SET @@session.debug_dbug="+d,sp_drop_routine_internal_fail";
--error ER_GET_ERRNO
CREATE OR REPLACE FUNCTION f1() RETURNS INT RETURN 2;
SET @@session.debug_dbug=@save_dbug;
--echo # The engine error is the statement error; the routine-specific
--echo # ER_SP_DROP_FAILED safety net (never reached as the *statement*
--echo # error, since the engine error already claimed the
--echo # Diagnostics_area first) is still visible via SHOW WARNINGS.
SHOW WARNINGS;
SELECT f1();
DROP FUNCTION f1;

--echo # FUNCTION: the old row is deleted fine, but writing the new one
--echo # fails.
CREATE FUNCTION f2() RETURNS INT RETURN 1;
SET @@session.debug_dbug="+d,sp_create_routine_write_row_fail";
--error ER_GET_ERRNO
CREATE OR REPLACE FUNCTION f2() RETURNS INT RETURN 2;
SET @@session.debug_dbug=@save_dbug;
--echo # The old row is already gone (this is the pre-existing, documented
--echo # two-step drop-then-write behaviour of CREATE OR REPLACE, not
--echo # something this MDEV changes), so the function no longer exists.
--error ER_SP_DOES_NOT_EXIST
SELECT f2();

--echo # PROCEDURE
CREATE PROCEDURE p1() SELECT 1;
SET @@session.debug_dbug="+d,sp_drop_routine_internal_fail";
--error ER_GET_ERRNO
CREATE OR REPLACE PROCEDURE p1() SELECT 2;
SET @@session.debug_dbug=@save_dbug;
CALL p1();
DROP PROCEDURE p1;

SET @save_sql_mode=@@sql_mode;
SET sql_mode='';

DELIMITER $$;
CREATE PACKAGE pkg1
  FUNCTION f() RETURNS INT;
END;
$$
DELIMITER ;$$

DELIMITER $$;
CREATE PACKAGE BODY pkg1
  FUNCTION f() RETURNS INT
  BEGIN
    RETURN 1;
  END;
END;
$$
DELIMITER ;$$

--echo # PACKAGE BODY alone
SET @@session.debug_dbug="+d,sp_drop_routine_internal_fail";
DELIMITER $$;
--error ER_GET_ERRNO
CREATE OR REPLACE PACKAGE BODY pkg1
  FUNCTION f() RETURNS INT
  BEGIN
    RETURN 1;
  END;
END;
$$
DELIMITER ;$$
SET @@session.debug_dbug=@save_dbug;
SELECT pkg1.f();

--echo # PACKAGE: the generic fault point fires on the first internal
--echo # delete, i.e. the PACKAGE BODY row
--echo # (Sp_handler_package_spec::sp_find_and_drop_routine() drops the
--echo # body before the spec), so this only exercises the "nothing
--echo # dropped yet" case.
SET @@session.debug_dbug="+d,sp_drop_routine_internal_fail";
DELIMITER $$;
--error ER_GET_ERRNO
CREATE OR REPLACE PACKAGE pkg1
  FUNCTION f() RETURNS INT;
END;
$$
DELIMITER ;$$
SET @@session.debug_dbug=@save_dbug;
SELECT pkg1.f();

--echo # PACKAGE: fail only the second internal delete (the spec row),
--echo # after the body row has already been dropped -- the more
--echo # dangerous ordering, since it leaves the package in a
--echo # partially-dropped state. The error must still be reported
--echo # (not this MDEV's crash/silent-OK bug); the resulting
--echo # inconsistent mysql.proc state is a separate, pre-existing
--echo # atomicity gap in the two-row PACKAGE drop and is not fixed
--echo # here (see MDEV-41205 comments).
SET @@session.debug_dbug="+d,sp_drop_routine_internal_fail_package_spec_only";
DELIMITER $$;
--error ER_GET_ERRNO
CREATE OR REPLACE PACKAGE pkg1
  FUNCTION f() RETURNS INT;
END;
$$
DELIMITER ;$$
SET @@session.debug_dbug=@save_dbug;

--echo # The above confirms: the PACKAGE BODY row is durably gone (it was
--echo # deleted and flushed before the spec delete was even attempted),
--echo # while the PACKAGE spec row survives -- a partially-dropped
--echo # package. Cleaning it up still works.
SELECT name, type FROM mysql.proc WHERE db=DATABASE() AND name='pkg1' ORDER BY type;
DROP PACKAGE pkg1;
SET sql_mode=@save_sql_mode;

--echo # End of 11.4 tests
