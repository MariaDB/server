# transaction end: accumulator of 1 rows freed with the transaction mem_root
DROP TEMPORARY TABLE t5;
#
# A BEFORE COMMIT body may not set, roll back to or release a
# savepoint.  A FOR EACH STATEMENT body may, as a ROW body may.
#
CREATE TRIGGER t5_commit_sp AFTER DELETE ON t5 BEFORE COMMIT
BEGIN
SAVEPOINT s;
ROLLBACK TO SAVEPOINT s;
END|
CREATE TRIGGER t5_stmt_sp AFTER DELETE ON t5 FOR EACH STATEMENT
RELEASE SAVEPOINT s;
# CREATE TRIGGER t5_commit_sp: the BEFORE COMMIT body has SAVEPOINT, ROLLBACK TO SAVEPOINT or RELEASE SAVEPOINT: would fail with ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
# CREATE TRIGGER test.t5_commit_sp: AFTER DELETE ON t5 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t5_stmt_sp: AFTER DELETE ON t5 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
DROP TRIGGER t5_commit_sp;
DROP TRIGGER t5_stmt_sp;
#
# A savepoint inside a ROW trigger body, in the middle of a statement:
# it does not fire OR SAVEPOINT triggers, it only marks the boundary.
# A trigger body has a savepoint level of its own, so ROLLBACK TO it
# happens in the same invocation of the body: the statements of the
# body that ran in between have fired their STATEMENT triggers
# already, and the accumulator drops their rows.  The statement
# around the body captured nothing in between.
#
CREATE TABLE t10 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t10_child (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t10_stmt AFTER INSERT ON t10 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t10_commit AFTER INSERT ON t10 BEFORE COMMIT OR SAVEPOINT
SET @x= 1;
CREATE TRIGGER t10_child_stmt AFTER INSERT ON t10_child FOR EACH STATEMENT
SET @x= 1;
CREATE TRIGGER t10_child_commit AFTER INSERT ON t10_child BEFORE COMMIT
SET @x= 1;
CREATE TRIGGER t10_row AFTER INSERT ON t10 FOR EACH ROW
BEGIN
IF NEW.a = 2 THEN
SAVEPOINT in_row;
INSERT INTO t10_child VALUES (NEW.a);
ROLLBACK TO SAVEPOINT in_row;
END IF;
END|
# CREATE TRIGGER test.t10_stmt: AFTER INSERT ON t10 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t10_commit: AFTER INSERT ON t10 BEFORE COMMIT OR SAVEPOINT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t10_child_stmt: AFTER INSERT ON t10_child FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t10_child_commit: AFTER INSERT ON t10_child BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
BEGIN;
INSERT INTO t10 VALUES (1), (2), (3);
