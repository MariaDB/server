#
# BEFORE COMMIT triggers fire at a boundary when a statement activated
# one of their events on the table since their previous firing, even
# if no row changed.  Reading the table activates nothing, and ROLLBACK
# TO SAVEPOINT rolls an activation back.
#
BEGIN;
DELETE FROM t1 WHERE id < 0;
COMMIT;
# prelocking for test.t1: DELETE BEFORE COMMIT triggers are NOT prelocked by this statement
