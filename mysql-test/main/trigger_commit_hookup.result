# ALTER TABLE test.t1: has BEFORE COMMIT triggers, new engine Aria is not transactional: refused
# ALTER TABLE test.t1: has BEFORE COMMIT triggers, new engine InnoDB is transactional: allowed
SELECT ENGINE FROM information_schema.TABLES
WHERE TABLE_SCHEMA='test' AND TABLE_NAME='t1';
