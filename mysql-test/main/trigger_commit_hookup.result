INSERT INTO t17 SELECT a + 10, b FROM t17;
INSERT INTO t17 VALUES (1, 1) ON DUPLICATE KEY UPDATE b= 10;
REPLACE INTO t17 VALUES (2, 20);
SELECT 30, 30 INTO OUTFILE 'T17_FILE';
LOAD DATA INFILE 'T17_FILE' INTO TABLE t17;
UPDATE t17 SET b= b + 1;
DELETE FROM t17 WHERE a = 1;
