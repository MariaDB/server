# UPDATE and DELETE ... FOR PORTION OF also activate INSERT, for the
# parts of the rows outside the portion, whether or not a row is
# split.  They are still UPDATE and DELETE statements.
CREATE TABLE t18 (id INT, s DATE, e DATE, v INT, PERIOD FOR p(s, e))
ENGINE=InnoDB;
INSERT INTO t18 VALUES (1, '2000-01-01', '2001-01-01', 1),
(2, '2000-01-01', '2001-01-01', 2);
CREATE TRIGGER t18_ins AFTER INSERT ON t18 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t18_upd_del AFTER UPDATE OR DELETE ON t18 FOR EACH STATEMENT
SET @x= 1;
