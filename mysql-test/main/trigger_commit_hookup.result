# I_S.TRIGGERS row for test.t1_stmt: ACTION_ORIENTATION=STATEMENT
# I_S.TRIGGERS row for test.t1_commit: ACTION_ORIENTATION=BEFORE COMMIT
# I_S.TRIGGERS row for test.t1_commit_first: ACTION_ORIENTATION=BEFORE COMMIT
# I_S.TRIGGERS row for test.t1_commit_savepoint: ACTION_ORIENTATION=BEFORE COMMIT OR SAVEPOINT
#
# Autocommit: the FOR EACH STATEMENT trigger fires at the end of the
# statement, the BEFORE COMMIT triggers in the statement commit, with
# the table still open.  Every firing names the account the body would
# run as: the trigger's DEFINER.
#
INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b');
# prelocking for test.t1: INSERT BEFORE COMMIT triggers are prelocked by this statement, which is the transaction
# column marking for test.t1: captured columns marked for read: id, slot, v, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: id, slot, v, + __op_order, __op, __state
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 1 INSERT rows
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.t1, columns: id, slot, v, + __op_order, __op, __state; fixed from triggers t1_commit, t1_commit_first, t1_commit_savepoint; has OR SAVEPOINT triggers: yes
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 0
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 2 INSERT rows
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 1
# end of statement: FIRE test.t1_stmt (AFTER INSERT,UPDATE FOR EACH STATEMENT) over 2 INSERT, 0 UPDATE, 0 DELETE rows; true: INSERTING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b')): boundary reached, accumulator holds 2 rows, in_sub_stmt=0, open tables in THD: yes
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b')): test.t1 enters the firing chain at depth 1; it is still open in thd->open_tables, transactional MDL_SHARED_WRITE held: yes; bodies would run on the tables the statement prelocked
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b')): FIRE test.t1_commit (AFTER INSERT,UPDATE,DELETE BEFORE COMMIT, order 1) over positions [0, 2): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b')): FIRE test.t1_commit_first (AFTER INSERT BEFORE COMMIT, order 2) over positions [0, 2): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# COMMIT of an autocommit statement (statement: INSERT INTO t1 VALUES (1, 1, 'a'), (2, 2, 'b')): FIRE test.t1_commit_savepoint (AFTER INSERT BEFORE COMMIT OR SAVEPOINT, order 3) over positions [0, 2): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# transaction end: accumulator of 2 rows freed with the transaction mem_root
#
# Multi-statement transaction with savepoints.  t1_commit_savepoint
# fires at every SAVEPOINT, the others only at COMMIT, where the table
# is no longer open and is re-opened under the MDL the DML still holds.
#
BEGIN;
INSERT INTO t1 VALUES (3, 1, 'c');
SAVEPOINT x;
INSERT INTO t1 VALUES (4, 2, 'd');
UPDATE t1 SET slot= slot + 10 WHERE id IN (3, 4);
SAVEPOINT y;
DELETE FROM t1 WHERE id = 4;
COMMIT;
# prelocking for test.t1: INSERT BEFORE COMMIT triggers are NOT prelocked by this statement
# column marking for test.t1: captured columns marked for read: id, slot, v, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: id, slot, v, + __op_order, __op, __state
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 1 INSERT rows
# accumulator attached to thd->transaction (transaction mem_root)
# accumulator: new (transaction, table) entry for test.t1, columns: id, slot, v, + __op_order, __op, __state; fixed from triggers t1_commit, t1_commit_first, t1_commit_savepoint; has OR SAVEPOINT triggers: yes
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 0
# end of statement: FIRE test.t1_stmt (AFTER INSERT,UPDATE FOR EACH STATEMENT) over 1 INSERT, 0 UPDATE, 0 DELETE rows; true: INSERTING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# statement committed inside the transaction: statement mark moves from 0 to 1
# SAVEPOINT: boundary reached, accumulator holds 1 rows, in_sub_stmt=0, open tables in THD: none
# SAVEPOINT: test.t1 enters the firing chain at depth 1; it is closed, transactional MDL_SHARED_WRITE held: yes; re-opening it to reach its triggers
# SAVEPOINT: FIRE test.t1_commit_savepoint (AFTER INSERT BEFORE COMMIT OR SAVEPOINT, order 3) over positions [0, 1): 1 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# SAVEPOINT x: marker at position 1
# prelocking for test.t1: INSERT BEFORE COMMIT triggers are NOT prelocked by this statement
# column marking for test.t1: captured columns marked for read: id, slot, v, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: id, slot, v, + __op_order, __op, __state
# capture INSERT row of test.t1 through t1 (NEW=record[0]) into the statement set, now 1 INSERT rows
# capture INSERT row of test.t1 (NEW=record[0]) into the transaction accumulator at position 1
# end of statement: FIRE test.t1_stmt (AFTER INSERT,UPDATE FOR EACH STATEMENT) over 1 INSERT, 0 UPDATE, 0 DELETE rows; true: INSERTING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# statement committed inside the transaction: statement mark moves from 1 to 2
# prelocking for test.t1: UPDATE BEFORE COMMIT triggers are NOT prelocked by this statement
# prelocking for test.t1: UPDATE BEFORE COMMIT triggers are NOT prelocked by this statement
# column marking for test.t1: captured columns marked for read: id, slot, v, + __op_order, __op, __state
# statement set: entry for test.t1 created, columns: id, slot, v, + __op_order, __op, __state
# capture UPDATE row of test.t1 through t1 (OLD=record[1] NEW=record[0]) into the statement set, now 1 UPDATE rows
# capture UPDATE row of test.t1 (OLD=record[1] NEW=record[0]) into the transaction accumulator at position 2
# capture UPDATE row of test.t1 through t1 (OLD=record[1] NEW=record[0]) into the statement set, now 2 UPDATE rows
# capture UPDATE row of test.t1 (OLD=record[1] NEW=record[0]) into the transaction accumulator at position 3
# end of statement: FIRE test.t1_stmt (AFTER INSERT,UPDATE FOR EACH STATEMENT) over 0 INSERT, 2 UPDATE, 0 DELETE rows; true: UPDATING; subject TABLE open and locked: yes; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# statement committed inside the transaction: statement mark moves from 2 to 4
# SAVEPOINT: boundary reached, accumulator holds 4 rows, in_sub_stmt=0, open tables in THD: none
# SAVEPOINT: test.t1 enters the firing chain at depth 1; it is closed, transactional MDL_SHARED_WRITE held: yes; re-opening it to reach its triggers
# SAVEPOINT: FIRE test.t1_commit_savepoint (AFTER INSERT BEFORE COMMIT OR SAVEPOINT, order 3) over positions [1, 4): 1 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# SAVEPOINT y: marker at position 4
# prelocking for test.t1: DELETE BEFORE COMMIT triggers are NOT prelocked by this statement
# column marking for test.t1: captured columns marked for read: id, slot, v, + __op_order, __op, __state
# capture DELETE row of test.t1 (OLD=record[0]) into the transaction accumulator at position 4
# statement committed inside the transaction: statement mark moves from 4 to 5
# COMMIT of a multi-statement transaction (statement: COMMIT): boundary reached, accumulator holds 5 rows, in_sub_stmt=0, open tables in THD: none
# COMMIT of a multi-statement transaction (statement: COMMIT): test.t1 enters the firing chain at depth 1; it is closed, transactional MDL_SHARED_WRITE held: yes; re-opening it to reach its triggers
# COMMIT of a multi-statement transaction (statement: COMMIT): FIRE test.t1_commit (AFTER INSERT,UPDATE,DELETE BEFORE COMMIT, order 1) over positions [0, 5): 2 INSERT, 2 UPDATE, 1 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# COMMIT of a multi-statement transaction (statement: COMMIT): FIRE test.t1_commit_first (AFTER INSERT BEFORE COMMIT, order 2) over positions [0, 5): 2 INSERT, 0 UPDATE, 0 DELETE rows; body would run here: execute_trigger() as root@localhost, SUB_STMT_TRIGGER
# transaction end: accumulator of 5 rows freed with the transaction mem_root
#
# ROLLBACK TO SAVEPOINT truncates the accumulator and clamps the
# watermark of a trigger that already fired over the discarded rows.
#
BEGIN;
INSERT INTO t1 VALUES (5, 1, 'e');
SAVEPOINT s1;
INSERT INTO t1 VALUES (6, 1, 'f');
SAVEPOINT s2;
INSERT INTO t1 VALUES (7, 1, 'g');
ROLLBACK TO SAVEPOINT s1;
RELEASE SAVEPOINT s1;
INSERT INTO t1 VALUES (8, 1, 'h');
COMMIT;
