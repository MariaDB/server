#
# In a FOR EACH STATEMENT body INSERTING, UPDATING and DELETING name
# the statement that fired the trigger, as in Oracle.  INSERT ... SELECT,
# INSERT ... ON DUPLICATE KEY UPDATE, REPLACE and LOAD DATA are INSERT
# statements.
#
CREATE TABLE t17 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TRIGGER t17_stmt AFTER INSERT OR UPDATE OR DELETE ON t17
FOR EACH STATEMENT
SET @k= CASE WHEN INSERTING THEN 'I' WHEN UPDATING THEN 'U' ELSE 'D' END;
# CREATE TRIGGER test.t17_stmt: AFTER INSERT,UPDATE,DELETE ON t17 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
