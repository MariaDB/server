#
# FOR EACH STATEMENT triggers fire in the order of ROW triggers: a
# statement with one event follows that event's list, as the ROW
# triggers of the same events do (they record their order in
# @row_order).  A statement with more than one event (REPLACE,
# INSERT ... ON DUPLICATE KEY UPDATE) walks the lists of its events
# in INSERT, UPDATE, DELETE order, and a trigger fires once, in the
# first list it is on.
#
CREATE TABLE t14 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TRIGGER t14_u AFTER UPDATE ON t14 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t14_iu AFTER INSERT OR UPDATE ON t14 FOR EACH STATEMENT
SET @x= 1;
CREATE TRIGGER t14_d AFTER DELETE ON t14 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t14_id AFTER INSERT OR DELETE ON t14 FOR EACH STATEMENT
SET @x= 1;
CREATE TRIGGER t14_row_u AFTER UPDATE ON t14 FOR EACH ROW
SET @row_order= CONCAT(@row_order, 'u ');
CREATE TRIGGER t14_row_iu AFTER INSERT OR UPDATE ON t14 FOR EACH ROW
SET @row_order= CONCAT(@row_order, 'iu ');
CREATE TRIGGER t14_row_d AFTER DELETE ON t14 FOR EACH ROW
SET @row_order= CONCAT(@row_order, 'd ');
CREATE TRIGGER t14_row_id AFTER INSERT OR DELETE ON t14 FOR EACH ROW
SET @row_order= CONCAT(@row_order, 'id ');
# CREATE TRIGGER test.t14_u: AFTER UPDATE ON t14 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t14_iu: AFTER INSERT,UPDATE ON t14 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t14_d: AFTER DELETE ON t14 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t14_id: AFTER INSERT,DELETE ON t14 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
