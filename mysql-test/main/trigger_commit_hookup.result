# A FOR EACH STATEMENT trigger fired by a statement of a ROW trigger
# body names that statement, and the ROW body reads its own event
# again after it, also as a value.  The FOR EACH STATEMENT triggers of
# the outer statement, fired after all its ROW bodies, name the outer
# statement.
CREATE TABLE t20 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t21 (id INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t20_log (id INT AUTO_INCREMENT PRIMARY KEY, k VARCHAR(10),
i INT, u INT, d INT) ENGINE=InnoDB;
CREATE TRIGGER t20_row AFTER INSERT OR UPDATE OR DELETE ON t20 FOR EACH ROW
BEGIN
INSERT INTO t20_log (k, i, u, d)
VALUES ('before', INSERTING, UPDATING, DELETING);
INSERT INTO t21 VALUES (NULL);
INSERT INTO t20_log (k, i, u, d)
VALUES ('after', INSERTING, UPDATING, DELETING);
END|
CREATE TRIGGER t20_stmt AFTER INSERT OR UPDATE OR DELETE ON t20
FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t21_stmt AFTER INSERT ON t21 FOR EACH STATEMENT SET @x= 1;
# CREATE TRIGGER test.t20_stmt: AFTER INSERT,UPDATE,DELETE ON t20 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t21_stmt: AFTER INSERT ON t21 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
