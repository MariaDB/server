ACTION_ORDER
FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA='test'
  ORDER BY EVENT_OBJECT_TABLE, ACTION_ORIENTATION, ACTION_ORDER, TRIGGER_NAME;
