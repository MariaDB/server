# REPLACE activates INSERT and DELETE, with a conflict or without
CREATE TABLE t12 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t12_ins AFTER INSERT ON t12 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER t12_del AFTER DELETE ON t12 FOR EACH STATEMENT SET @x= 1;
REPLACE INTO t12 VALUES (1);
