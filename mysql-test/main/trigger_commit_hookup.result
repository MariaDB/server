#
# BEFORE COMMIT triggers all fire at the commit, so they form one list
# whatever their events: creation order, or as FOLLOWS/PRECEDES places
# them, and the anchor may have other events.  STATEMENT triggers keep
# the per-event order of ROW triggers.
#
CREATE TABLE t8 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t8_del AFTER DELETE ON t8 BEFORE COMMIT SET @x= 1;
CREATE TRIGGER t8_ins AFTER INSERT ON t8 BEFORE COMMIT SET @x= 1;
CREATE TRIGGER t8_upd AFTER UPDATE ON t8 BEFORE COMMIT PRECEDES t8_del
SET @x= 1;
CREATE TRIGGER t8_all AFTER INSERT OR UPDATE OR DELETE ON t8 BEFORE COMMIT
FOLLOWS t8_upd SET @x= 1;
# For STATEMENT triggers the anchor must have every event of the new one
CREATE TRIGGER t8_stmt_del AFTER DELETE ON t8 FOR EACH STATEMENT SET @x= 1;
CREATE TRIGGER bad AFTER INSERT ON t8 FOR EACH STATEMENT FOLLOWS t8_stmt_del
SET @x= 1;
ERROR HY000: Referenced trigger 't8_stmt_del' for the given action time and event type does not exist
# CREATE TRIGGER test.t8_del: AFTER DELETE ON t8 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t8_ins: AFTER INSERT ON t8 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t8_upd: AFTER UPDATE ON t8 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t8_all: AFTER INSERT,UPDATE,DELETE ON t8 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t8_stmt_del: AFTER DELETE ON t8 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# ACTION_ORDER of a BEFORE COMMIT trigger is its place in that one list
SELECT TRIGGER_NAME, EVENT_MANIPULATION, ACTION_ORIENTATION, ACTION_ORDER
FROM information_schema.TRIGGERS
WHERE TRIGGER_SCHEMA='test' AND EVENT_OBJECT_TABLE='t8'
  ORDER BY ACTION_ORIENTATION, ACTION_ORDER;
TRIGGER_NAME	EVENT_MANIPULATION	ACTION_ORIENTATION	ACTION_ORDER
t8_upd	UPDATE	BEFORE COMMIT	1
t8_all	INSERT,UPDATE,DELETE	BEFORE COMMIT	2
t8_del	DELETE	BEFORE COMMIT	3
t8_ins	INSERT	BEFORE COMMIT	4
t8_stmt_del	DELETE	STATEMENT	1
# The order is kept in the .TRG file and survives a reload
FLUSH TABLES;
SELECT TRIGGER_NAME, ACTION_ORDER FROM information_schema.TRIGGERS
WHERE TRIGGER_SCHEMA='test' AND EVENT_OBJECT_TABLE='t8'
  AND ACTION_ORIENTATION='BEFORE COMMIT' ORDER BY ACTION_ORDER;
TRIGGER_NAME	ACTION_ORDER
t8_upd	1
t8_all	2
t8_del	3
t8_ins	4
# At the commit they fire in that order
BEGIN;
INSERT INTO t8 VALUES (1), (2);
UPDATE t8 SET a= 3 WHERE a= 1;
DELETE FROM t8 WHERE a= 2;
COMMIT;
