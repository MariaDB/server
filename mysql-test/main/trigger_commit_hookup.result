#
# CREATE TABLE ... SELECT commits in the middle of the statement, and
# when it fails, InnoDB commits the transaction as it drops the new
# table.  So it may not write a table with BEFORE COMMIT triggers,
# whether through a function or through the trigger of a table that a
# function writes.  It may read such a table.  CREATE TEMPORARY TABLE
# ... SELECT does not commit, so it may write one.
#
CREATE FUNCTION f_t1_ins(i INT) RETURNS INT
BEGIN
INSERT INTO t1 VALUES (i, 13, CONCAT('f', i));
RETURN i;
END|
CREATE FUNCTION f_t3_ins(i INT) RETURNS INT
BEGIN
INSERT INTO t3 VALUES (i);
RETURN i;
END|
SET autocommit= 0;
CREATE TABLE t_ctas ENGINE=InnoDB SELECT f_t1_ins(41) AS b;
ERROR 42000: This version of MariaDB doesn't yet support 'CREATE TABLE ... SELECT that writes a table with BEFORE COMMIT triggers'
# t3 has no BEFORE COMMIT triggers, but its ROW trigger writes t1
CREATE TABLE t_ctas ENGINE=InnoDB SELECT f_t3_ins(41) AS b;
ERROR 42000: This version of MariaDB doesn't yet support 'CREATE TABLE ... SELECT that writes a table with BEFORE COMMIT triggers'
SHOW TABLES LIKE 't_ctas';
Tables_in_test (t_ctas)
SELECT COUNT(*) FROM t1 WHERE id = 41;
COUNT(*)
0
CREATE TABLE t_ctas ENGINE=InnoDB SELECT COUNT(*) AS n FROM t1;
DROP TABLE t_ctas;
CREATE TEMPORARY TABLE t_ctas ENGINE=InnoDB SELECT f_t1_ins(42) AS b;
COMMIT;
