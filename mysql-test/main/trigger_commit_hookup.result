#
# A rollback to a point before a table was first touched removes the
# table's accumulator entry, not only its rows: the next DML on the
# table creates the entry again from the triggers the table has then.
#
CREATE TABLE t5 (a INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TRIGGER t5_commit AFTER INSERT ON t5 BEFORE COMMIT SET @t5= 1;
# CREATE TRIGGER test.t5_commit: AFTER INSERT ON t5 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# ROLLBACK TO a savepoint taken before t5 was touched
BEGIN;
INSERT INTO t1 VALUES (20, 11, 's');
SAVEPOINT before_t5;
INSERT INTO t5 VALUES (1), (2);
ROLLBACK TO SAVEPOINT before_t5;
INSERT INTO t5 VALUES (3);
COMMIT;
