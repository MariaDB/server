# A statement that writes one table through two views fires its
# FOR EACH STATEMENT triggers once, over the rows written through both
CREATE TRIGGER t19_upd AFTER UPDATE ON t19 FOR EACH STATEMENT SET @x= 1;
CREATE VIEW v19_low AS SELECT a, b FROM t19 WHERE a < 10;
CREATE VIEW v19_high AS SELECT a, b FROM t19 WHERE a >= 10;
# CREATE TRIGGER test.t19_upd: AFTER UPDATE ON t19 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
UPDATE v19_low JOIN v19_high ON v19_high.a = v19_low.a + 10
SET v19_low.b= 100, v19_high.b= 200;
