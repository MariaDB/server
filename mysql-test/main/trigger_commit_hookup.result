#
# LOCK TABLES with autocommit=0: the table stays open and locked
# across COMMIT.  LOCK TABLES locks the tables of BEFORE COMMIT
# bodies as well as those of ROW and STATEMENT bodies, since nothing
# can be locked at a COMMIT under it; a DML statement does not lock
# them.  (BEGIN would end LOCK TABLES.)
#
CREATE TABLE t9 (a INT) ENGINE=InnoDB;
CREATE TABLE t9_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER t9_commit AFTER INSERT ON t9 BEFORE COMMIT
INSERT INTO t9_log SELECT COUNT(*) FROM t9;
INSERT INTO t9 VALUES (1);
