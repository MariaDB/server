#
# A statement fires the FOR EACH STATEMENT triggers of every event it
# activates on a table it writes, whether or not it changes a row, as
# the SQL standard has it.  A row reaches the triggers when the
# statement matches it, as for an AFTER ROW trigger: a matched row
# that does not change is captured with OLD and NEW equal.
#
UPDATE t1 SET slot= slot WHERE id < 0;
