#
# Capture column lists: OF names the captured columns, EXCEPT the ones
# left out, no list captures every column NEW and OLD can reach
# (invisible and virtual ones included).  The control columns come
# in addition.
#
CREATE TABLE t6 (id INT PRIMARY KEY, a INT, b BLOB, c INT INVISIBLE,
g INT AS (id + 1) VIRTUAL) ENGINE=InnoDB;
# Duplicates are elided, column names compare case-insensitively
CREATE TRIGGER t6_of AFTER INSERT OR UPDATE ON t6 BEFORE COMMIT
OF a, A, id SET @x= 1;
CREATE TRIGGER t6_except AFTER UPDATE ON t6 BEFORE COMMIT OR SAVEPOINT
EXCEPT b FOLLOWS t6_of SET @x= 1;
CREATE TRIGGER t6_stmt_of AFTER INSERT ON t6 FOR EACH STATEMENT OF a
SET @x= 1;
CREATE TRIGGER t6_stmt_except AFTER INSERT OR DELETE ON t6
FOR EACH STATEMENT EXCEPT b, g SET @x= 1;
# OF is not reserved: a body labeled "of" quotes the label
CREATE TRIGGER t6_label AFTER DELETE ON t6 FOR EACH STATEMENT
`of`: BEGIN END;
