CREATE TABLE t1 (id INT PRIMARY KEY, slot INT, v VARCHAR(10) UNIQUE)
ENGINE=InnoDB;
CREATE TABLE t2 (a INT) ENGINE=MyISAM;
#
# Syntax and the trigger object
#
CREATE TRIGGER t1_stmt AFTER INSERT OR UPDATE ON t1 FOR EACH STATEMENT
SET @s= 1;
CREATE TRIGGER t1_commit AFTER INSERT OR UPDATE OR DELETE ON t1
BEFORE COMMIT SET @c= 1;
CREATE TRIGGER t1_commit_savepoint AFTER INSERT ON t1
BEFORE COMMIT OR SAVEPOINT SET @p= 1;
CREATE TRIGGER t1_row AFTER INSERT ON t1 FOR EACH ROW SET @r= 1;
CREATE TRIGGER t2_stmt AFTER INSERT ON t2 FOR EACH STATEMENT SET @s2= 1;
# CREATE TRIGGER test.t1_stmt: AFTER INSERT,UPDATE ON t1 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
# CREATE TRIGGER test.t1_commit: AFTER INSERT,UPDATE,DELETE ON t1 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t1_commit_savepoint: AFTER INSERT ON t1 BEFORE COMMIT OR SAVEPOINT, body compiled, added to the BEFORE COMMIT list of the table
# CREATE TRIGGER test.t2_stmt: AFTER INSERT ON t2 FOR EACH STATEMENT, body compiled, added to the STATEMENT list of the table
CREATE TRIGGER bad BEFORE INSERT ON t1 BEFORE COMMIT SET @x= 1;
ERROR 42000: This version of MariaDB doesn't yet support 'BEFORE <event> ... BEFORE COMMIT'
CREATE TRIGGER bad BEFORE INSERT ON t1 FOR EACH STATEMENT SET @x= 1;
ERROR 42000: This version of MariaDB doesn't yet support 'BEFORE <event> ... FOR EACH STATEMENT'
CREATE TRIGGER bad AFTER UPDATE OF v ON t1 FOR EACH STATEMENT SET @x= 1;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE OF ... FOR EACH STATEMENT'
CREATE TRIGGER bad AFTER UPDATE OF v ON t1 BEFORE COMMIT SET @x= 1;
ERROR 42000: This version of MariaDB doesn't yet support 'UPDATE OF ... BEFORE COMMIT'
CREATE TRIGGER bad AFTER INSERT ON t1 FOR EACH STATEMENT OR SAVEPOINT
SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'OR SAVEPOINT
SET @x= 1' at line 1
CREATE TRIGGER bad AFTER INSERT ON t1 FOR EACH SAVEPOINT SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'SAVEPOINT SET @x= 1' at line 1
CREATE TRIGGER bad AFTER INSERT ON t1 FOR EACH COMMIT SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'COMMIT SET @x= 1' at line 1
CREATE TRIGGER bad AFTER INSERT ON t1 BEFORE SAVEPOINT SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'SAVEPOINT SET @x= 1' at line 1
CREATE TRIGGER bad AFTER INSERT ON t1 BEFORE STATEMENT SET @x= 1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'STATEMENT SET @x= 1' at line 1
CREATE TRIGGER bad AFTER INSERT ON t1 BEFORE COMMIT SET @x= NEW.id;
ERROR HY000: There is no NEW row in BEFORE COMMIT trigger
CREATE TRIGGER bad AFTER DELETE ON t1 FOR EACH STATEMENT SET @x= OLD.id;
ERROR HY000: There is no OLD row in FOR EACH STATEMENT trigger
# INSERTING, UPDATING and DELETING name the statement that fired the
# trigger; one BEFORE COMMIT firing covers statements of every kind
CREATE TRIGGER bad AFTER INSERT OR UPDATE OR DELETE ON t1 BEFORE COMMIT
SET @x= INSERTING;
ERROR HY000: 'INSERTING' is not allowed in this context
CREATE TRIGGER bad AFTER INSERT OR UPDATE OR DELETE ON t1 BEFORE COMMIT
SET @x= UPDATING;
ERROR HY000: 'UPDATING' is not allowed in this context
CREATE TRIGGER bad AFTER INSERT OR UPDATE OR DELETE ON t1
BEFORE COMMIT OR SAVEPOINT SET @x= DELETING;
ERROR HY000: 'DELETING' is not allowed in this context
# A BEFORE COMMIT trigger needs a transactional table, a FOR EACH
# STATEMENT one does not
CREATE TRIGGER bad AFTER INSERT ON t2 BEFORE COMMIT SET @x= 1;
ERROR 42000: This version of MariaDB doesn't yet support 'BEFORE COMMIT trigger on a non-transactional table'
# FOLLOWS/PRECEDES orders triggers of the same granularity only
CREATE TRIGGER bad AFTER INSERT ON t1 BEFORE COMMIT FOLLOWS t1_row
SET @x= 1;
ERROR HY000: Referenced trigger 't1_row' for the given action time and event type does not exist
CREATE TRIGGER bad AFTER INSERT ON t1 FOR EACH STATEMENT FOLLOWS t1_row
SET @x= 1;
ERROR HY000: Referenced trigger 't1_row' for the given action time and event type does not exist
CREATE TRIGGER t1_commit_first AFTER INSERT ON t1 BEFORE COMMIT
PRECEDES t1_commit_savepoint SET @f= 1;
# CREATE TRIGGER test.t1_commit_first: AFTER INSERT ON t1 BEFORE COMMIT, body compiled, added to the BEFORE COMMIT list of the table
SHOW CREATE TRIGGER t1_commit_savepoint;
