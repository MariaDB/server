# I_S.TRIGGERS row for test.t8_upd: ACTION_ORIENTATION=BEFORE COMMIT
# I_S.TRIGGERS row for test.t8_all: ACTION_ORIENTATION=BEFORE COMMIT
# I_S.TRIGGERS row for test.t8_del: ACTION_ORIENTATION=BEFORE COMMIT
