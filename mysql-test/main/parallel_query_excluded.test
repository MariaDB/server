#
# MDEV-39492 Parallel Query: tables that cannot be shipped row-by-row through a
# worker batch table are excluded from parallel worker scan.
#
# The gate in make_join_readinfo() records the table it picks as
# "parallel_scan_candidate", and JOIN::optimize_stage2() then reports what became
# of it once the plan has stopped changing: "chosen_for_parallel_scan" if it is
# still a scan that can be handed out in chunks, "parallel_scan_abandoned" with a
# reason if the plan took it away. An ordinary table is chosen; a table is
# rejected by the gate when it has a BLOB/TEXT (blob-backed) column, uses the
# MERGE engine, or is fulltext-searched (a MATCH ... AGAINST refers to it). We
# assert presence/absence of those trace keys (1/0) rather than the temporary
# row-multiplication behaviour.
#
-- source include/have_innodb.inc
--source include/not_embedded.inc
--source include/have_sequence.inc

SET @save_optimizer_trace= @@optimizer_trace;
SET optimizer_trace='enabled=on';

# Every table here holds enough rows to be worth scanning in parallel. The
# worker count is chosen per scan from what the scan costs, so a three-row table
# is declined for being three rows and would report 0 whether the gate excluded
# it or not, which would say nothing about the gate.
CREATE TABLE t_plain (a INT) engine=innodb;
INSERT INTO t_plain SELECT seq FROM seq_1_to_20000;
CREATE TABLE t_blob (a INT, b BLOB) engine=innodb;
INSERT INTO t_blob SELECT seq, 'x' FROM seq_1_to_20000;
CREATE TABLE t_text (a INT, b TEXT) engine=innodb;
INSERT INTO t_text SELECT seq, 'x' FROM seq_1_to_20000;

# MERGE table over two MyISAM children
CREATE TABLE t_m1 (a INT) ENGINE=MyISAM;
INSERT INTO t_m1 SELECT seq FROM seq_1_to_10000;
CREATE TABLE t_m2 (a INT) ENGINE=MyISAM;
INSERT INTO t_m2 SELECT seq+10000 FROM seq_1_to_10000;
CREATE TABLE t_merge (a INT) ENGINE=MERGE UNION=(t_m1,t_m2) INSERT_METHOD=LAST;

# fulltext: MATCH in the select list keeps a full table scan and marks the
# table fulltext-searched
CREATE TABLE t_ft (a INT, b VARCHAR(64), FULLTEXT(b)) ENGINE=innodb;
INSERT INTO t_ft SELECT seq, IF(seq % 2, 'alpha beta', 'gamma delta')
  FROM seq_1_to_20000;

set session parallel_worker_threads=8;

--echo # plain table: chosen for parallel scan (expect 1)
--disable_result_log
SELECT a FROM t_plain;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS chosen_for_parallel_scan
  FROM information_schema.optimizer_trace;

--echo # BLOB column present: excluded, not chosen (expect 0)
--disable_result_log
SELECT a FROM t_blob;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS chosen_for_parallel_scan
  FROM information_schema.optimizer_trace;

--echo # TEXT column present: excluded, not chosen (expect 0)
--disable_result_log
SELECT a FROM t_text;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS chosen_for_parallel_scan
  FROM information_schema.optimizer_trace;

--echo # MERGE engine: excluded, not chosen (expect 0)
--disable_result_log
SELECT a FROM t_merge;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS chosen_for_parallel_scan
  FROM information_schema.optimizer_trace;

--echo # fulltext-searched (MATCH in select list): excluded, not chosen (expect 0)
--disable_result_log
SELECT a, MATCH(b) AGAINST('alpha') FROM t_ft;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') IS NOT NULL
       AS chosen_for_parallel_scan
  FROM information_schema.optimizer_trace;

DROP TABLE t_plain, t_blob, t_text, t_merge, t_m1, t_m2, t_ft;

--echo #
--echo # A table the worker cannot open its own copy of, and a semijoin
--echo # strategy it does not implement, are excluded. Both queries answer as
--echo # they do serially, because they run serially.
--echo #
CREATE TABLE ta (a INT) ENGINE=InnoDB;
INSERT INTO ta SELECT seq FROM seq_1_to_20000;
CREATE TABLE tb (a INT, b INT) ENGINE=InnoDB;
INSERT INTO tb SELECT seq % 5000, seq FROM seq_1_to_20000;

--echo # a materialized derived table used as an inner table is not one of the
--echo # tables chosen. What is chosen is tb, the base table inside the derived
--echo # table's own select, which is a scan of its own and nothing to do with the
--echo # outer join. The chosen tables are named rather than counted, because
--echo # asking only whether anything was chosen cannot tell those two apart --
--echo # recorded as a 1 here for years while the comment claimed it was a 0.
--echo #
SET SESSION optimizer_switch='derived_merge=off';
--disable_result_log
SELECT ta.a, d.k FROM ta, (SELECT DISTINCT a AS k FROM tb) d
  WHERE d.k = ta.a AND ta.a <= 4;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') AS chosen_tables
  FROM information_schema.optimizer_trace;
--sorted_result
SELECT ta.a, d.k FROM ta, (SELECT DISTINCT a AS k FROM tb) d
  WHERE d.k = ta.a AND ta.a <= 4;
SET SESSION optimizer_switch=DEFAULT;

--echo # FirstMatch semijoin: not chosen (expect 0)
SET SESSION optimizer_switch='semijoin=on,firstmatch=on,loosescan=off,materialization=off';
--disable_result_log
SELECT a FROM ta WHERE a IN (SELECT a FROM tb) AND a <= 4;
--enable_result_log
SELECT JSON_EXTRACT(trace, '$**.chosen_for_parallel_scan') AS chosen_tables
  FROM information_schema.optimizer_trace;
--echo # one row per matching ta row, not one per tb match
--sorted_result
SELECT a FROM ta WHERE a IN (SELECT a FROM tb) AND a <= 4;
SET SESSION optimizer_switch=DEFAULT;

--echo #
--echo # A choice the plan then takes away. The driving table is picked in
--echo # make_join_readinfo(), before test_if_skip_sort_order() has had its say,
--echo # and that can hand the table an ordered index scan so it supplies the
--echo # GROUP BY order for free -- which is not a scan that can be handed out in
--echo # chunks. So the trace records a candidate first and what became of it
--echo # afterwards, and chosen_for_parallel_scan names only tables that really
--echo # are scanned in parallel.
--echo #
--source include/have_sequence.inc
CREATE TABLE t_ord (k1 INT, k2 INT, v INT, PRIMARY KEY(k1,k2)) ENGINE=InnoDB;
INSERT INTO t_ord SELECT seq DIV 4, seq MOD 4, seq FROM seq_1_to_40000;
ANALYZE TABLE t_ord PERSISTENT FOR ALL;
set session parallel_worker_threads=8;

--echo # The LIMIT makes the ordered index scan the cheaper plan, so the candidate
--echo # is abandoned (expect 1 0 1, and the reason)
--disable_result_log
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 LIMIT 5;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_candidate')   IS NOT NULL AS candidate,
       JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan')  IS NOT NULL AS chosen,
       JSON_EXTRACT(trace,'$**.parallel_scan_abandoned')   IS NOT NULL AS abandoned,
       JSON_UNQUOTE(JSON_EXTRACT(trace,
         '$**.parallel_scan_abandoned_because[0]')) AS abandoned_because
  FROM information_schema.optimizer_trace;

--echo # and it really does not run in the workers (expect 0 / NULL)
FLUSH STATUS;
--disable_result_log
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 LIMIT 5;
--enable_result_log
--source include/parallel_query_workers_per_query.inc

--echo # Without the LIMIT the temp-table plan keeps the full scan, so the same
--echo # table survives as a real choice (expect 1 1 0)
--disable_result_log
SELECT k1, SUM(v) FROM t_ord GROUP BY k1 HAVING SUM(v) > 999999999;
--enable_result_log
SELECT JSON_EXTRACT(trace,'$**.parallel_scan_candidate')  IS NOT NULL AS candidate,
       JSON_EXTRACT(trace,'$**.chosen_for_parallel_scan') IS NOT NULL AS chosen,
       JSON_EXTRACT(trace,'$**.parallel_scan_abandoned')  IS NOT NULL AS abandoned
  FROM information_schema.optimizer_trace;

DROP TABLE t_ord;

DROP TABLE ta, tb;
SET optimizer_trace= @save_optimizer_trace;
set session parallel_worker_threads=default;
