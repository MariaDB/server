#
# CREATE VIEW with too long path
#
CREATE DATABASE `d..................................................aaaa`;
CREATE VIEW `d..................................................aaaa`.`t................................................aaaaaaaaaa` AS SELECT 1 AS id;
ERROR HY000: Long database name and identifier for object resulted in path length exceeding 511 characters. Path: './d@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002eaaaa/t@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e@002e
DROP DATABASE `d..................................................aaaa`;
#
# Open a table with too long path
#
CREATE DATABASE `d..................................................aaaa`;
CREATE TABLE `d..................................................aaaa`.`ttttt.................................................` (a INT) ENGINE=MEMORY;
FLUSH TABLES;
SELECT * FROM `d..................................................aaaa`.`ttttt.................................................`;
a
SELECT * FROM `d..................................................aaaa`.`t................................................aaaaaaaaaa`;
ERROR 42S02: Table 'd..................................................aaaa.t................................................aaaaaaaaaa' doesn't exist
DROP DATABASE `d..................................................aaaa`;
