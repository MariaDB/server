CREATE TABLE t1 (a INT, b VARCHAR(10));
INSERT INTO t1 VALUES (10,'b10'),(20,'b20'),(30,'b30');

DELIMITER $$;
eval CREATE PROCEDURE p1(pa INT)
BEGIN
  DECLARE c1 CURSOR FOR SELECT * FROM t1;
  BEGIN
    DECLARE vrec $TYPE;
    UPDATE t1 SET a=a+1 WHERE a>=pa RETURNING a,b INTO $INTO;
    SELECT vrec.a, vrec.b;
  END;
END;
$$
DELIMITER ;$$

--error ER_SP_FETCH_NO_DATA
CALL p1(100);
--error ER_SP_FETCH_NO_DATA
