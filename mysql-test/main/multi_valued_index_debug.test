#
# A multi-valued index is a fulltext key over the base column whose
# declaration is in the FRM's EXTRA2_MVI_SPEC section. The key names the
# mvi fulltext parser, which nothing else may, so a key that names it with
# no declaration behind it is an index whose declaration went missing.
# Neither half can go missing in an FRM this server wrote, so the only way
# to reach the check is to make the server write a bad one on purpose.
#
--source include/have_innodb.inc
--source include/have_debug.inc

--echo # A multi-valued index whose declaration was not written is a key we
--echo # would open as a plain fulltext key over the base column -- a valid
--echo # definition meaning something else. Refuse the table instead.

set @@debug_dbug='+d,mvi_skip_spec_image';
--replace_regex /'.*t1.frm'/'DIR\/t1.frm'/
--error ER_NOT_FORM_FILE
create table t1 (c int, j json,
                 key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
set @@debug_dbug='';

--echo # a table with no multi-valued index writes no image and is unaffected
set @@debug_dbug='+d,mvi_skip_spec_image';
create table t2 (c int, j json, key plain (c))engine=innodb;
set @@debug_dbug='';
insert into t2 values (1,'{"tags": ["aaa"]}');
select c from t2;
drop table t2;

--echo # ... and the same table definition is fine once the image is written
create table t1 (c int, j json,
                 key idx ((CAST(j->'$.tags' AS CHAR(6) ARRAY))))engine=innodb;
insert into t1 values (1,'{"tags": ["aaa"]}');
flush tables;
select c from t1 where json_contains(j->'$.tags','"aaa"');
drop table t1;
