t1	CREATE TABLE `t1` (
  `a` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL CHECK (json_valid(`a`))
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
DROP TABLE t1;
# LONGTEXT, utf8mb4_bin: exactly what JSON creates -- promoted
