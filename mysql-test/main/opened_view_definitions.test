# MDEV-32590: count successfully loaded view definitions.
--source include/not_embedded.inc
--source include/no_view_protocol.inc
--disable_ps_protocol
SET @saved_use_stat_tables= @@use_stat_tables;
SET SESSION use_stat_tables=never;
CREATE TABLE t32590 (n INT) ENGINE=MyISAM;
INSERT INTO t32590 VALUES (1);
CREATE VIEW v32590_literal AS SELECT 1 AS n;
CREATE VIEW v32590_backed AS SELECT n FROM t32590;
FLUSH TABLES;
--echo # v32590_literal cold
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_literal;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
--echo # v32590_literal cached
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_literal;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
FLUSH TABLES;
--echo # v32590_literal reopened
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_literal;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
FLUSH TABLES;
--echo # t32590 cold
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM t32590;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
--echo # t32590 cached
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM t32590;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
FLUSH TABLES;
--echo # t32590 reopened
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM t32590;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
FLUSH TABLES;
--echo # v32590_backed cold
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_backed;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
--echo # v32590_backed cached
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_backed;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
FLUSH TABLES;
--echo # v32590_backed reopened
SELECT VARIABLE_VALUE INTO @before FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
SELECT n INTO @n FROM v32590_backed;
SELECT VARIABLE_VALUE - @before AS opened_definitions
FROM information_schema.SESSION_STATUS
WHERE VARIABLE_NAME='OPENED_TABLE_DEFINITIONS';
DROP VIEW v32590_literal, v32590_backed;
DROP TABLE t32590;
SET SESSION use_stat_tables=@saved_use_stat_tables;
--enable_ps_protocol
