--echo #
--echo # MDEV-41246 "Illegal mix of collations" on the mysql.user view
--echo #

--echo # Two different explicit COLLATE clauses are still not accepted,
--echo # whether the character sets are different or the same
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT _latin1'a' COLLATE latin1_swedish_ci = _big5'a' COLLATE big5_chinese_ci;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT _latin1'a' COLLATE latin1_german1_ci = _latin1'a' COLLATE latin1_swedish_ci;


SET NAMES big5 COLLATE big5_chinese_ci;
--source include/ctype_tailoring_03_mysql_user_Insert_priv_last_error.inc

--echo # Same as above, but using BETWEEN (3-operand aggregation)
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A' AND 'Z' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A' AND 'Z_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A_' AND 'Z' LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A' AND 'Z+' LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A+' AND 'Z' LIMIT 0;

--echo # Same as above, but using IN() (N-operand aggregation)
SELECT Insert_priv FROM mysql.user WHERE Insert_priv IN ('Y','N') LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv IN ('Y_','N') LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv IN ('Y','N+') LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv IN ('Y+','N') LIMIT 0;

--echo # Same as above, but using STRCMP()
SELECT STRCMP(Insert_priv,'Y') FROM mysql.user LIMIT 0;
SELECT STRCMP(Insert_priv,'Y_') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT STRCMP(Insert_priv,'Y+') FROM mysql.user LIMIT 0;

--echo # Same as above, but using LOCATE()/POSITION()/INSTR()
SELECT LOCATE('Y',Insert_priv) FROM mysql.user LIMIT 0;
SELECT LOCATE('Y_',Insert_priv) FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT LOCATE('Y+',Insert_priv) FROM mysql.user LIMIT 0;
SELECT POSITION('Y' IN Insert_priv) FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT POSITION('Y+' IN Insert_priv) FROM mysql.user LIMIT 0;
SELECT INSTR(Insert_priv,'Y') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT INSTR(Insert_priv,'Y+') FROM mysql.user LIMIT 0;

--echo # Same as above, but using FIELD()
SELECT FIELD(Insert_priv,'Y','N') FROM mysql.user LIMIT 0;
SELECT FIELD(Insert_priv,'Y_','N') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT FIELD(Insert_priv,'Y','N+') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT FIELD(Insert_priv,'Y+','N') FROM mysql.user LIMIT 0;

--echo # Same as above, but using FIND_IN_SET()
--echo # (a single-value haystack, so the ',' separator does not
--echo # itself force a wider repertoire)
SELECT FIND_IN_SET(Insert_priv,'Y') FROM mysql.user LIMIT 0;
SELECT FIND_IN_SET(Insert_priv,'Y_') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT FIND_IN_SET(Insert_priv,'Y+') FROM mysql.user LIMIT 0;

--echo # Same as above, but using LIKE
SELECT Insert_priv FROM mysql.user WHERE Insert_priv LIKE 'Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv LIKE 'Y_' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv LIKE 'Y+' LIMIT 0;

--echo # Same as above, but using RLIKE
SELECT Insert_priv FROM mysql.user WHERE Insert_priv RLIKE 'Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv RLIKE 'Y_' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv RLIKE 'Y+' LIMIT 0;

--echo # Same as above, but using REGEXP_INSTR()
SELECT REGEXP_INSTR(Insert_priv,'Y') FROM mysql.user LIMIT 0;
SELECT REGEXP_INSTR(Insert_priv,'Y_') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT REGEXP_INSTR(Insert_priv,'Y+') FROM mysql.user LIMIT 0;

--echo # Same as above, but using MATCH ... AGAINST().
--echo # Unlike the other comparison functions above, MATCH ... AGAINST()
--echo # does not aggregate the AGAINST phrase's collation for the illegal-mix
--echo # check: Item_func_match::fix_fields() calls
--echo # agg_arg_charsets_for_comparison() on args+1 (the indexed column(s)
--echo # only), skipping args[0], which is the AGAINST phrase (key_item()).
--echo # The phrase is instead silently converted to the column's collation
--echo # (search_value), so none of the queries below raise an error, even
--echo # with a _bin column.
CREATE TABLE t1 (a VARCHAR(200) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
                 FULLTEXT(a));
INSERT INTO t1 VALUES ('Y'),('N');
SET NAMES big5 COLLATE big5_chinese_ci;
SELECT MATCH(a) AGAINST('Y') FROM t1;
SELECT MATCH(a) AGAINST('Y_') FROM t1;
SELECT MATCH(a) AGAINST('Y+') FROM t1;
DROP TABLE t1;
CREATE TABLE t1 (a VARCHAR(200) CHARACTER SET latin1 COLLATE latin1_bin,
                 FULLTEXT(a));
INSERT INTO t1 VALUES ('Y'),('N');
SELECT MATCH(a) AGAINST('Y') FROM t1;
DROP TABLE t1;

--echo # Same as above, but using the simple CASE operator
SELECT CASE Insert_priv WHEN 'Y' THEN 1 WHEN 'N' THEN 0 END FROM mysql.user LIMIT 0;
SELECT CASE Insert_priv WHEN 'Y_' THEN 1 WHEN 'N' THEN 0 END FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT CASE Insert_priv WHEN 'Y' THEN 1 WHEN 'N+' THEN 0 END FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT CASE Insert_priv WHEN 'Y+' THEN 1 WHEN 'N' THEN 0 END FROM mysql.user LIMIT 0;

SET NAMES big5 COLLATE big5_bin;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv LIKE 'Y' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv RLIKE 'Y' LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT REGEXP_INSTR(Insert_priv,'Y') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv BETWEEN 'A' AND 'Z' LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT Insert_priv FROM mysql.user WHERE Insert_priv IN ('Y','N') LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT STRCMP(Insert_priv,'Y') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT LOCATE('Y',Insert_priv) FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT FIELD(Insert_priv,'Y','N') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_2COLLATIONS
SELECT FIND_IN_SET(Insert_priv,'Y') FROM mysql.user LIMIT 0;
--error ER_CANT_AGGREGATE_3COLLATIONS
SELECT CASE Insert_priv WHEN 'Y' THEN 1 WHEN 'N' THEN 0 END FROM mysql.user LIMIT 0;
