--source include/ctype_tailoring_view_drop.inc

--echo # The originally reported scenario: a view is created under latin1
--echo # and queried under big5. The comparison must return the right rows.
SET NAMES latin1 COLLATE latin1_swedish_ci;
CREATE VIEW v1 AS SELECT 'Y' AS c1 UNION SELECT 'N';
SET NAMES big5 COLLATE big5_chinese_ci;
SELECT * FROM v1 WHERE c1='y';
SELECT * FROM v1 WHERE c1='Y';
SELECT * FROM v1 WHERE 'n'=c1;
SELECT * FROM v1 WHERE c1='N';
SELECT * FROM v1 WHERE c1='x';
SELECT * FROM v1 WHERE c1 IN ('y','n') ORDER BY c1;
SELECT * FROM v1 WHERE c1 BETWEEN 'm' AND 'z' ORDER BY c1;

--echo # The same view with prepared statement parameters.
--echo # A parameter with a non-ALNUM value makes the collations incompatible.
PREPARE stmt FROM 'SELECT c1 FROM v1 WHERE c1=? ORDER BY c1';
SET @y='y', @n='N', @y_plus='Y+';
EXECUTE stmt USING @y;
EXECUTE stmt USING @n;
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE stmt USING @y_plus;
EXECUTE stmt USING 'y';
EXECUTE stmt USING 'x';
DEALLOCATE PREPARE stmt;
PREPARE stmt FROM 'SELECT c1 FROM v1 WHERE c1 IN (?,?) ORDER BY c1';
EXECUTE stmt USING 'y', 'n';
--error ER_CANT_AGGREGATE_3COLLATIONS
EXECUTE stmt USING 'y', 'Y+';
DEALLOCATE PREPARE stmt;
EXECUTE IMMEDIATE 'SELECT c1 FROM v1 WHERE c1=?' USING 'y';
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE IMMEDIATE 'SELECT c1 FROM v1 WHERE c1=?' USING 'Y+';
DROP VIEW v1;

--echo # Prepared statement parameters compared to a literal of another charset.
--echo # A parameter with a non-ALNUM value makes the collations incompatible.
PREPARE stmt FROM 'SELECT _latin1''Y'' = ? AS r';
EXECUTE stmt USING @y;
EXECUTE stmt USING @n;
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE stmt USING @y_plus;
DEALLOCATE PREPARE stmt;
PREPARE stmt FROM 'SELECT _latin1''Y+'' = ? AS r';
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE stmt USING 'y';
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE stmt USING 'Y+';
DEALLOCATE PREPARE stmt;
EXECUTE IMMEDIATE 'SELECT _latin1''Y'' = ? AS r' USING 'y';
--error ER_CANT_AGGREGATE_2COLLATIONS
EXECUTE IMMEDIATE 'SELECT _latin1''Y'' = ? AS r' USING 'Y+';
SET NAMES DEFAULT;

--echo # End of 11.8 tests
