#
# Replay mismatch warnings print numbers as text
#
set optimizer_replay_context='';
create table t1 (a int, b int, key(a));
insert into t1 select seq%10, seq from seq_1_to_100;
explain select t1.b from t1, t1 t2 where t1.a = t2.a;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	a	NULL	NULL	NULL	100	Using where
1	SIMPLE	t2	ref	a	a	5	test.t1.a	10	Using index
set @opt_context=
(select REGEXP_SUBSTR(
context,
'(?<=set @opt_context=\')([\n\r].*)*(?=\'\;#opt_context_ends)')
from information_schema.optimizer_context);
set @opt_context_mismatch= json_remove(@opt_context,
'$.tables[0].cost_for_index_read_calls');
