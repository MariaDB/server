#
# over a join, so the distinct rows are ones a worker assembled from two
# tables. Compared as a multiset: see the declined section for why this one
# cannot carry an ORDER BY.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,nm))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,nm))) AS crc_xor FROM (SELECT DISTINCT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a + 1) d;
n	crc_sum	crc_xor
7	13156519870	2718853212
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,nm))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,nm))) AS crc_xor FROM (SELECT DISTINCT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a + 1) d;
n	crc_sum	crc_xor
7	13156519870	2718853212
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# nothing qualifies, so there are no distinct rows
#
# SELECT DISTINCT a FROM t1 WHERE b > 999999 ORDER BY a
SELECT DISTINCT a FROM t1 WHERE b > 999999 ORDER BY a;
a
SELECT DISTINCT a FROM t1 WHERE b > 999999 ORDER BY a;
a
ran_in_the_workers
1
#
# DISTINCT with no ORDER BY. The rows are determined, their order is not,
# so this compares them as a multiset.
#
# serial fingerprint
SET SESSION parallel_worker_threads= 0;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,b))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,b))) AS crc_xor FROM (SELECT DISTINCT a, b FROM t1) d;
n	crc_sum	crc_xor
91	211750305143	1898137835
# parallel fingerprint, must be identical to the serial one above
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, SUM(CRC32(CONCAT_WS('/',a,b))) AS crc_sum, BIT_XOR(CRC32(CONCAT_WS('/',a,b))) AS crc_xor FROM (SELECT DISTINCT a, b FROM t1) d;
n	crc_sum	crc_xor
91	211750305143	1898137835
# the workers ran the query above, and did not run the serial one (expect 1)
ran_in_the_workers
1
#
# DISTINCT with a LIMIT, which is the shape the rewrite to GROUP BY leaves
# alone, so it reaches the gate as a real DISTINCT. Which rows a LIMIT of an
# unordered result keeps is whichever finish first, exactly as for LIMIT
# without DISTINCT, so what is checked is that the right number come back
# and that they really are distinct.
#
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*) AS n, COUNT(DISTINCT b) AS distinct_n
FROM (SELECT DISTINCT b FROM t1 LIMIT 5) d;
n	distinct_n
5	5
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT COUNT(*) AS n, COUNT(DISTINCT b) AS distinct_n
FROM (SELECT DISTINCT b FROM t1 LIMIT 5) d;
n	distinct_n
5	5
ran_in_the_workers	workers_per_query
1	4.0000
#
# and every value it returned is one the table holds
#
SELECT COUNT(*) AS all_present FROM (SELECT DISTINCT b FROM t1 LIMIT 5) d
WHERE d.b IN (SELECT b FROM t1);
all_present
5
