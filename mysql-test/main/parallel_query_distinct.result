#
# DISTINCT over a join, ordered. The sort goes above the join, onto the temp
# table the DISTINCT already needs, so it comes back ordered from the
# workers. Both of these were declined until the sort was allowed where it
# sits above the join.
#
# SELECT DISTINCT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a + 1 ORDER BY t1.a, d1.nm
SELECT DISTINCT STRAIGHT_JOIN t1.a, d1.nm FROM t1, d1 WHERE d1.id = t1.a + 1 ORDER BY t1.a, d1.nm;
