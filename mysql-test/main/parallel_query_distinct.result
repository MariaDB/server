#
# the shapes that are declined, and what declines each one.
#
# A single table can only be ordered by sorting itself, and a scan handed out
# in chunks cannot arrive sorted. EXPLAIN says ALL rather than PARALLEL
# because the choice is withdrawn once the sort is attached to the table.
#
# SELECT a FROM t1 ORDER BY a LIMIT 5
SELECT a FROM t1 ORDER BY a LIMIT 5;
a
0
0
0
0
0
SELECT a FROM t1 ORDER BY a LIMIT 5;
a
0
0
0
0
0
ran_in_the_workers
0
EXPLAIN SELECT a FROM t1 ORDER BY a LIMIT 5;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t1	ALL	NULL	NULL	NULL	NULL	2000	Using filesort
#
# a DISTINCT over a join that does not select from every table: the
# optimizer marks the unread ones so the join stops at the first match, and
# that is decided after the gate, so it is declined at execution.
#
# SELECT DISTINCT t1.a FROM t1, d1 WHERE d1.id = t1.a + 1 ORDER BY t1.a LIMIT 3
SELECT DISTINCT t1.a FROM t1, d1 WHERE d1.id = t1.a + 1 ORDER BY t1.a LIMIT 3;
a
0
1
2
SELECT DISTINCT t1.a FROM t1, d1 WHERE d1.id = t1.a + 1 ORDER BY t1.a LIMIT 3;
a
0
1
2
ran_in_the_workers
0
DROP TABLE t1, d1;
SET SESSION optimizer_switch= @os;
SET SESSION parallel_worker_threads= @s;
