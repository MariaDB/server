#
# AFTER ... BEFORE COMMIT [OR SAVEPOINT] triggers: the binary log format
# of the statement that reaches a commit boundary, and the format and
# the warnings of the statements that capture rows.  No trigger body is
# executed yet, but a statement and the boundary open and lock the tables
# the bodies use, and decide the logging format for them.
#

--source include/have_innodb.inc
--source include/have_binlog_format_mixed.inc

call mtr.add_suppression("Unsafe statement written to the binary log using statement format");

--echo #
--echo # MDEV-41218 A commit boundary keeps the logging format of its statement
--echo #
--echo # The boundary runs the bodies in a statement of its own.  With
--echo # binlog_format=MIXED that statement is row-based, as every statement
--echo # that may capture a row for the trigger is.  The statement that
--echo # reached the boundary keeps its own format: a CREATE TABLE ... SELECT
--echo # that commits the transaction is logged as a statement, as it is
--echo # when the table has no trigger.

# The binary log events are shown with the name of their file
RESET MASTER;
CREATE TABLE tf (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tf_log (u VARCHAR(40)) ENGINE=InnoDB;
CREATE TABLE tf_src (a INT) ENGINE=InnoDB;
INSERT INTO tf_src VALUES (1), (2);

--echo # Without a trigger
BEGIN;
INSERT INTO tf VALUES (1), (2);
--let $binlog_file= query_get_value(SHOW MASTER STATUS, File, 1)
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
CREATE TABLE tf_ctas1 AS SELECT a FROM tf_src;
--source include/show_binlog_events.inc

--echo # With a BEFORE COMMIT trigger whose body is unsafe
CREATE TRIGGER tf_commit AFTER INSERT ON tf BEFORE COMMIT
  INSERT INTO tf_log VALUES (UUID());
BEGIN;
INSERT INTO tf VALUES (3), (4);
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
CREATE TABLE tf_ctas2 AS SELECT a FROM tf_src;
--source include/show_binlog_events.inc

--echo # The same when a statement of a stored procedure commits the
--echo # transaction, in the first and in the second call of the procedure.
--echo # The INSERT is not in the procedure: after a statement that is
--echo # logged in row format, the statements of the same call are too.
--delimiter $$
CREATE PROCEDURE p_tf()
BEGIN
  CREATE TABLE tf_ctas3 AS SELECT a FROM tf_src;
  DROP TABLE tf_ctas3;
END $$
--delimiter ;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
BEGIN;
INSERT INTO tf VALUES (5), (6);
CALL p_tf();
BEGIN;
INSERT INTO tf VALUES (7), (8);
CALL p_tf();
--source include/show_binlog_events.inc

SELECT id FROM tf ORDER BY id;
DROP PROCEDURE p_tf;
DROP TABLE tf, tf_log, tf_src, tf_ctas1, tf_ctas2;

--echo #
--echo # MDEV-41218 An unsafe BEFORE COMMIT body with binlog_format=STATEMENT
--echo #
--echo # Every statement that may capture a row for the trigger is logged as
--echo # a statement and has the warning that it is unsafe, whether or not
--echo # it captures a row, as a statement with a ROW trigger that has such
--echo # a body.  The boundary's statement logs nothing, so the statement
--echo # that reached the boundary has only its own warnings: a COMMIT, a
--echo # DDL statement that commits the transaction and the CALL of a
--echo # procedure that commits it have none.

CREATE TABLE tu (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tu_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tu_log (u VARCHAR(40)) ENGINE=InnoDB;
CREATE TABLE tu_src (a INT) ENGINE=InnoDB;
INSERT INTO tu_src VALUES (1), (2);
CREATE TRIGGER tu_row_ins AFTER INSERT ON tu_row FOR EACH ROW
  INSERT INTO tu_log VALUES (UUID());
CREATE TRIGGER tu_commit AFTER INSERT ON tu BEFORE COMMIT
  INSERT INTO tu_log VALUES (UUID());
CREATE PROCEDURE p_tu() COMMIT;
SET binlog_format= STATEMENT;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)

--echo # A ROW trigger
INSERT INTO tu_row VALUES (1), (2);
--echo # A BEFORE COMMIT trigger: a statement that captures rows, one that
--echo # captures none, and the COMMIT
BEGIN;
INSERT INTO tu VALUES (1), (2);
INSERT INTO tu SELECT 100 FROM DUAL WHERE 1 = 0;
COMMIT;
--echo # In autocommit mode
INSERT INTO tu VALUES (3), (4);
--echo # A DDL statement commits the transaction
BEGIN;
INSERT INTO tu VALUES (5), (6);
CREATE TABLE tu_ddl (a INT);
BEGIN;
INSERT INTO tu VALUES (7), (8);
CREATE TABLE tu_ctas AS SELECT a FROM tu_src;
--echo # A procedure commits the transaction
BEGIN;
INSERT INTO tu VALUES (9), (10);
CALL p_tu();
--source include/show_binlog_events.inc
SET binlog_format= MIXED;
SELECT id FROM tu ORDER BY id;
DROP PROCEDURE p_tu;
DROP TABLE tu, tu_row, tu_log, tu_src, tu_ddl, tu_ctas;

--echo #
--echo # MDEV-41218 A BEFORE COMMIT body that writes a non-transactional table
--echo #
--echo # A statement that may capture a row for the trigger counts as writing
--echo # the table that the body writes, as a statement with a ROW trigger
--echo # does.  With binlog_format=STATEMENT it has the warning that it is
--echo # unsafe inside a transaction and none in autocommit mode, as the
--echo # statement with the ROW trigger.  With binlog_format=MIXED it is
--echo # logged in row format in both, as every statement that may capture
--echo # a row for a BEFORE COMMIT trigger is; the statement with the ROW
--echo # trigger is only inside a transaction.  The ROW trigger is here for
--echo # comparison: its body writes nothing for these rows, as the BEFORE
--echo # COMMIT body, which is not executed yet.

CREATE TABLE tm (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tm_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tm_log (a INT) ENGINE=MyISAM;
CREATE TRIGGER tm_commit AFTER INSERT ON tm BEFORE COMMIT
  INSERT INTO tm_log VALUES (1);
--delimiter $$
CREATE TRIGGER tm_row_ins AFTER INSERT ON tm_row FOR EACH ROW
BEGIN
  IF NEW.id > 100 THEN
    INSERT INTO tm_log VALUES (2);
  END IF;
END $$
--delimiter ;

--echo # binlog_format=MIXED
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
INSERT INTO tm_row VALUES (1), (2);
INSERT INTO tm VALUES (1), (2);
BEGIN;
INSERT INTO tm_row VALUES (3), (4);
COMMIT;
BEGIN;
INSERT INTO tm VALUES (3), (4);
COMMIT;
--source include/show_binlog_events.inc

--echo # binlog_format=STATEMENT
SET binlog_format= STATEMENT;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
INSERT INTO tm_row VALUES (5), (6);
INSERT INTO tm VALUES (5), (6);
BEGIN;
INSERT INTO tm_row VALUES (7), (8);
COMMIT;
BEGIN;
INSERT INTO tm VALUES (7), (8);
COMMIT;
--source include/show_binlog_events.inc
SET binlog_format= MIXED;
SELECT id FROM tm ORDER BY id;
DROP TABLE tm, tm_row, tm_log;

--echo #
--echo # MDEV-41218 The format of a statement that may capture a row for a
--echo # BEFORE COMMIT trigger
--echo #
--echo # With statement-based logging the replica captures the rows of the
--echo # statements it executes and fires its own triggers; it captures
--echo # nothing from row events.  So that one transaction does not have rows
--echo # of both kinds for one trigger, with binlog_format=MIXED every
--echo # statement that may capture a row for a BEFORE COMMIT trigger is
--echo # logged in row format: a statement on the table and a statement that
--echo # calls a stored function that writes it.  A statement of another
--echo # event than the trigger's is not, and neither is a statement with a
--echo # ROW trigger of the same body.  With binlog_format=STATEMENT all of
--echo # them are logged as statements.

CREATE TABLE tx (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tx_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tx_log (a INT) ENGINE=InnoDB;
CREATE TABLE tx_src (a INT) ENGINE=InnoDB;
INSERT INTO tx_src VALUES (1), (2);
CREATE TRIGGER tx_commit AFTER INSERT ON tx BEFORE COMMIT
  INSERT INTO tx_log VALUES (1);
CREATE TRIGGER tx_row_ins AFTER INSERT ON tx_row FOR EACH ROW
  INSERT INTO tx_log VALUES (2);
--delimiter $$
CREATE FUNCTION f_tx(i INT) RETURNS INT
BEGIN
  INSERT INTO tx VALUES (i), (i + 1);
  RETURN i;
END $$
--delimiter ;

--echo # binlog_format=MIXED
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
INSERT INTO tx_row VALUES (1), (2);
INSERT INTO tx VALUES (1), (2);
BEGIN;
INSERT INTO tx VALUES (3), (4);
UPDATE tx SET id= id + 100 WHERE id = 4;
INSERT INTO tx SELECT a + 10 FROM tx_src;
COMMIT;
SELECT f_tx(21);
--source include/show_binlog_events.inc

--echo # binlog_format=STATEMENT
SET binlog_format= STATEMENT;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
INSERT INTO tx VALUES (31), (32);
BEGIN;
INSERT INTO tx VALUES (33), (34);
COMMIT;
--source include/show_binlog_events.inc
SET binlog_format= MIXED;
SELECT id FROM tx ORDER BY id;
DROP FUNCTION f_tx;
DROP TABLE tx, tx_row, tx_log, tx_src;

--echo #
--echo # MDEV-41218 A statement whose foreign key cascade changes a table that
--echo # has BEFORE COMMIT triggers
--echo #
--echo # Rows changed by a foreign key cascade are not captured.  A statement
--echo # that reaches a table with BEFORE COMMIT triggers only through a
--echo # cascade captures no row for them, so binlog_format=MIXED logs it as
--echo # a statement.  A statement that deletes from that table itself is
--echo # logged in row format.

CREATE TABLE tf_p (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tf_c (id INT PRIMARY KEY, p INT,
                   FOREIGN KEY (p) REFERENCES tf_p (id) ON DELETE CASCADE)
  ENGINE=InnoDB;
INSERT INTO tf_p VALUES (1), (2), (3);
INSERT INTO tf_c VALUES (1, 1), (2, 2), (3, 3), (4, 3);
CREATE TRIGGER tf_c_commit AFTER DELETE ON tf_c BEFORE COMMIT SET @x= 1;
--let $binlog_start= query_get_value(SHOW MASTER STATUS, Position, 1)
DELETE FROM tf_p WHERE id IN (1, 2);
DELETE FROM tf_c WHERE id IN (3, 4);
--source include/show_binlog_events.inc
SELECT id FROM tf_p ORDER BY id;
SELECT id FROM tf_c ORDER BY id;
DROP TABLE tf_c, tf_p;

--echo #
--echo # MDEV-41218 A commit boundary uses the binlog_format of the session
--echo #
--echo # While it runs a statement that writes no rows, such as COMMIT,
--echo # SAVEPOINT, XA END or a DDL statement, the server sets the session's
--echo # binlog_format to STATEMENT.  The boundary's statement, which runs
--echo # the bodies, decides its format from the value the session has
--echo # outside that statement.  At READ COMMITTED, where InnoDB can only be
--echo # logged in row format, the boundaries below would otherwise fail.

CREATE TABLE tc (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tc_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER tc_commit AFTER INSERT ON tc BEFORE COMMIT OR SAVEPOINT
  INSERT INTO tc_log VALUES (1);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
--echo # COMMIT and SAVEPOINT
BEGIN;
INSERT INTO tc VALUES (1), (2);
SAVEPOINT s1;
INSERT INTO tc VALUES (3), (4);
COMMIT;
--echo # A statement that starts a transaction, and a DDL statement
BEGIN;
INSERT INTO tc VALUES (5), (6);
BEGIN;
INSERT INTO tc VALUES (7), (8);
CREATE VIEW tc_view AS SELECT id FROM tc;
--echo # XA END
XA START 'tc1';
INSERT INTO tc VALUES (9), (10);
XA END 'tc1';
XA COMMIT 'tc1' ONE PHASE;
--echo # Under LOCK TABLES
LOCK TABLES tc WRITE, tc_log WRITE;
BEGIN;
INSERT INTO tc VALUES (11), (12);
COMMIT;
UNLOCK TABLES;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SELECT @@binlog_format;
SELECT id FROM tc ORDER BY id;
DROP VIEW tc_view;
DROP TABLE tc, tc_log;
