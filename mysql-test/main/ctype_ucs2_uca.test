-- source include/have_ucs2.inc

--echo #
--echo # Start of 10.2 tests
--echo #

--echo #
--echo # MDEV-10877 xxx_unicode_nopad_ci collations
--echo #
SET NAMES utf8, character_set_connection=ucs2;
let $coll='ucs2_unicode_nopad_ci';
let $coll_pad='ucs2_unicode_ci';
--source include/ctype_pad_all_engines.inc

let $coll='ucs2_unicode_520_nopad_ci';
let $coll_pad='ucs2_unicode_520_ci';
--source include/ctype_pad_all_engines.inc

SET NAMES utf8, collation_connection=ucs2_unicode_520_nopad_ci;
--source include/ctype_like_range_mdev14350.inc
SET NAMES utf8;

--echo #
--echo # End of 10.2 tests
--echo #


--echo #
--echo # Start of 10.9 tests
--echo #

--echo #
--echo # MDEV-27009 Add UCA-14.0.0 collations
--echo # Collation IDs in the protocol
--echo #

SET @charset='ucs2';
--source include/ctype_uca1400_ids_using_convert.inc


--echo #
--echo # End of 10.9 tests
--echo #


--echo #
--echo # MDEV-41246 "Illegal mix of collations" on the mysql.user view
--echo #

SET NAMES utf8mb3;
SET collation_connection=ucs2_unicode_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES utf8mb3;
SET collation_connection=ucs2_czech_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES utf8mb3;
SET collation_connection=ucs2_uca1400_ai_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES utf8mb3;
SET collation_connection=ucs2_uca1400_ai_cs;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES utf8mb3;
SET collation_connection=ucs2_uca1400_as_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES utf8mb3;
SET collation_connection=ucs2_uca1400_as_cs;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;

SET NAMES DEFAULT;

--echo # End of 11.8 tests
