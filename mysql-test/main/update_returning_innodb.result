#
# MDEV-39563 Implement UPDATE ... RETURNING ... INTO
#
SET default_storage_engine=InnoDB;
#
# Degenerated plans do not raise errors
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10);
SET @a=123;
UPDATE t1 SET a=11 WHERE 1=0 RETURNING a INTO @a;
SELECT @a;
@a
123
SELECT * FROM t1;
a
10
UPDATE t1 SET a=11 LIMIT 0 RETURNING a INTO @a;
SELECT @a;
@a
123
SELECT * FROM t1;
a
10
SET @a=NULL;
DROP TABLE t1;
#
# A row that matches WHERE but does not get changed
#
CREATE TABLE t1 (a INT, b VARCHAR(10));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL,
  `b` varchar(10) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10,'b10');
SET @a=123;
UPDATE t1 SET a=10 WHERE a<20 RETURNING a INTO @a;
ERROR 02000: No data - zero rows fetched, selected, or processed
SELECT @a;
@a
123
SELECT * FROM t1;
a	b
10	b10
SET @a=NULL;
DROP TABLE t1;
#
# No rows updated for various sql_mode values
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10);
SET @a=123;
SET sql_mode='';
UPDATE t1 SET a=10 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SELECT @a;
@a
123
SET sql_mode=DEFAULT;
UPDATE t1 SET a=10 RETURNING a INTO @a;
ERROR 02000: No data - zero rows fetched, selected, or processed
SELECT @a;
@a
123
UPDATE IGNORE t1 SET a=10 RETURNING a INTO @a;
Warnings:
Warning	1329	No data - zero rows fetched, selected, or processed
SELECT @a;
@a
123
SET @a=NULL;
DROP TABLE t1;
#
# Too many rows updated for various sql_mode values
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
SET sql_mode='';
SET @a=123;
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR 42000: Result consisted of more than one row
SELECT @a;
@a
11
SELECT * FROM t1;
a
10
20
30
SET sql_mode=DEFAULT;
SET @a=123;
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR 42000: Result consisted of more than one row
SELECT @a;
@a
11
SELECT * FROM t1;
a
10
20
30
SET @a=123;
UPDATE IGNORE t1 SET a=a+1 RETURNING a INTO @a;
ERROR 42000: Result consisted of more than one row
SELECT @a;
@a
11
SELECT * FROM t1;
a
10
20
30
SET @a=NULL;
DROP TABLE t1;
#
# Too many rows + CONTINUE HANDLER
#
SET @a=100, @b=200;
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
CREATE PROCEDURE p1()
BEGIN
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
BEGIN
SET @b=@a;
END;
UPDATE t1 SET a=a+1 ORDER BY a RETURNING a INTO @a;
SELECT 'Still here' AS comment;
END;
$$
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
CALL p1();
comment
Still here
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
SET @a=NULL, @b=NULL;
DROP PROCEDURE p1;
DROP TABLE t1;
#
# Too many rows + EXIT HANDLER
#
SET @a=100, @b=200;
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
CREATE PROCEDURE p1()
BEGIN
DECLARE EXIT HANDLER FOR SQLEXCEPTION
BEGIN
SET @b=@a;
RESIGNAL;
END;
UPDATE t1 SET a=a+1 ORDER BY a RETURNING a INTO @a;
SELECT 'Still here' AS comment;
END;
$$
CALL p1();
ERROR 42000: Result consisted of more than one row
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
CALL p1();
ERROR 42000: Result consisted of more than one row
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
CALL p1();
ERROR 42000: Result consisted of more than one row
SELECT @a,@b;
@a	@b
11	11
SELECT * FROM t1;
a
10
20
30
SET @a=NULL, @b=NULL;
DROP PROCEDURE p1;
DROP TABLE t1;
#
# Normal case
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
SET @a=123;
UPDATE t1 SET a=a+1 WHERE a>=30 RETURNING a INTO @a;
SELECT @a;
@a
31
SELECT * FROM t1;
a
10
20
31
SET @a=NULL;
DROP TABLE t1;
#
# Normal case with LIMIT
#
CREATE TABLE t1 (a INT);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int(11) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO t1 VALUES (10),(20),(30);
SET @a=123;
UPDATE t1 SET a=a+1 ORDER BY a LIMIT 1 RETURNING a INTO @a;
SELECT @a;
@a
11
SELECT * FROM t1;
a
11
20
30
SET @a=NULL;
DROP TABLE t1;
SET default_storage_engine=DEFAULT;
#
# Empty table
#
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
SET @a=123;
UPDATE t1 SET a=a+1 WHERE a=0 RETURNING a INTO @a;
ERROR 02000: No data - zero rows fetched, selected, or processed
SELECT @a;
@a
123
SET @a=NULL;
DROP TABLE t1;
#
# Too many rows inside a transaction
#
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (10),(20),(30);
START TRANSACTION;
SET @a=123;
UPDATE t1 SET a=a+1 RETURNING a INTO @a;
ERROR 42000: Result consisted of more than one row
SELECT @a;
@a
11
SELECT * FROM t1;
a
10
20
30
SET @a=NULL;
COMMIT;
DROP TABLE t1;
# End of 13.1 tests
