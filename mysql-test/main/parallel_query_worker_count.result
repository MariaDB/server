SET @s= @@session.parallel_worker_threads;
CREATE TABLE t1 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t1 SELECT seq, seq*2 FROM seq_1_to_200;
CREATE TABLE t2 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t2 SELECT seq, seq*2 FROM seq_1_to_20000;
CREATE TABLE t3 (a INT, b INT) ENGINE=InnoDB;
INSERT INTO t3 SELECT seq, seq*2 FROM seq_1_to_1000;
#
# t1 holds one leaf page. The engine cannot divide it, so a worker would
# read all of it, and the serial path does that for less: parallel is
# declined altogether.
#
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT a, b FROM t1 WHERE b > 0;
ran_in_the_workers	workers_per_query
0	NULL
#
# Two workers is below the floor. Splitting a scan two ways saves less than
# the exchange between the workers and the manager costs -- measured at 0.59
# of the serial speed, and one worker at 0.36 -- so fewer than three is
# declined and the query runs serially, however many leaf pages the table
# has to divide.
#
SET SESSION parallel_worker_threads= 2;
FLUSH STATUS;
SELECT a, b FROM t2 WHERE b > 0;
ran_in_the_workers	workers_per_query
0	NULL
#
# Three is the floor, and t2 spans leaf pages enough to meet it in full
#
SET SESSION parallel_worker_threads= 3;
FLUSH STATUS;
SELECT a, b FROM t2 WHERE b > 0;
ran_in_the_workers	workers_per_query
1	3.0000
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT a, b FROM t2 WHERE b > 0;
ran_in_the_workers	workers_per_query
1	8.0000
#
# t3 spans a few leaf pages: the request is met up to the chunk count, and
# asking for four times as many does not start one more worker
#
SET SESSION parallel_worker_threads= 4;
FLUSH STATUS;
SELECT a, b FROM t3 WHERE b > 0;
SET SESSION parallel_worker_threads= 16;
FLUSH STATUS;
SELECT a, b FROM t3 WHERE b > 0;
same_either_way	below_the_request
1	1
#
# t4's B-tree has a level between its root and its leaves, and the root
# holds only two records. Those two ranges are split into enough pieces
# to keep every worker asked for busy, so the request is met in full
# even though the tree divides the table two ways to begin with.
#
CREATE TABLE t4 (pk CHAR(200) PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t4 SELECT LPAD(seq,200,'x'), seq FROM seq_1_to_6000;
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT a FROM t4 WHERE a > 0;
ran_in_the_workers	workers_per_query
1	8.0000
# and the split is bounded by the worker count. t4 holds about a hundred
# leaf pages, which is what a split that descended all the way would make
# a chunk of each of. The figure is printed rather than only bounded
# because it is what says a re-split covers every sub-tree it descends to.
chunks_per_query	within_three_per_worker
18.0000	1
# every row is read exactly once however the ranges were divided. Reduced
# outside a non-merged derived table, so that the scan being checked is one
# the workers actually ran: written as a bare aggregate the gate would
# refuse the query outright and this would compare the serial answer with
# itself, and t4 is the only table here whose tree is deep enough to be
# re-split at all.
SET SESSION optimizer_switch='derived_merge=off';
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), BIT_XOR(CRC32(pk)) FROM (SELECT pk, a FROM t4) d;
COUNT(*)	SUM(a)	BIT_XOR(CRC32(pk))
6000	18003000	1038235259
SET SESSION parallel_worker_threads= 8;
FLUSH STATUS;
SELECT COUNT(*), SUM(a), BIT_XOR(CRC32(pk)) FROM (SELECT pk, a FROM t4) d;
COUNT(*)	SUM(a)	BIT_XOR(CRC32(pk))
6000	18003000	1038235259
ran_in_the_workers	workers_per_query
1	8.0000
SET SESSION optimizer_switch= default;
#
# The optimizer bounds its divisor by how finely the table can be
# divided, which is its leaf page count: a chunk cannot be smaller than a
# leaf page. The bound is read from the index statistics, so they have to
# have been gathered, and InnoDB reports t3 as a single leaf page, which
# is the count for a table it will not divide at all. So t3 is costed as
# the serial scan it is nearly certain to be, whatever is asked for.
#
ANALYZE TABLE t3 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t3	analyze	status	Engine-independent statistics collected
test.t3	analyze	status	OK
SET SESSION parallel_worker_threads= 0;
SET @c0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
SET SESSION parallel_worker_threads= 16;
SET @c16= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
# expect 1: no discount for a table reported as one leaf page
SELECT @c0 = @c16 AS costed_as_serial;
costed_as_serial
1
#
# t4 has leaf pages to spare and a level under its root to divide them
# by, so its ceiling is those pages, not the two ranges the root starts
# with. Below the ceiling the divisor is the worker count, so the cost
# keeps falling past the two-range mark until the per-worker setup
# outweighs what another worker saves.
#
ANALYZE TABLE t4 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t4	analyze	status	Engine-independent statistics collected
test.t4	analyze	status	OK
SET SESSION parallel_worker_threads= 0;
SET @d0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
SET SESSION parallel_worker_threads= 6;
SET @d6= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
SET SESSION parallel_worker_threads= 8;
SET @d8= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
# expect 1 1: the scan is discounted, and eight workers are still costed
# below six, which the root's two ranges alone could never pay for
SELECT @d0 > @d6 AS parallel_costs_less, @d8 < @d6 AS improves_past_the_root_fanout;
parallel_costs_less	improves_past_the_root_fanout
1	1
#
# the answer does not depend on how many workers were started
#
SET SESSION parallel_worker_threads= 0;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
COUNT(*)	SUM(a)	SUM(b)
200	20100	40200
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
COUNT(*)	SUM(a)	SUM(b)
20000	200010000	400020000
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;
COUNT(*)	SUM(a)	SUM(b)
1000	500500	1001000
SET SESSION parallel_worker_threads= 16;
SELECT COUNT(*), SUM(a), SUM(b) FROM t1;
COUNT(*)	SUM(a)	SUM(b)
200	20100	40200
SELECT COUNT(*), SUM(a), SUM(b) FROM t2;
COUNT(*)	SUM(a)	SUM(b)
20000	200010000	400020000
SELECT COUNT(*), SUM(a), SUM(b) FROM t3;
COUNT(*)	SUM(a)	SUM(b)
1000	500500	1001000
#
# A worker runs the whole join over its chunk, not only the scan, so the
# cost of every table joined after the driving one is divided between the
# workers as well. Costing only the driving table would overstate what the
# plan costs and understate how much parallelism is worth, by exactly the
# part of the join that follows the split table.
#
# t5 is the driving table and needs leaf pages enough for the workers asked
# for; t6 is reached by eq_ref, once per row of t5.
#
CREATE TABLE t5 (pk INT PRIMARY KEY, a INT, b INT) ENGINE=InnoDB;
INSERT INTO t5 SELECT seq, seq % 100, seq FROM seq_1_to_20000;
CREATE TABLE t6 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t6 SELECT seq, seq FROM seq_1_to_20000;
ANALYZE TABLE t5, t6 PERSISTENT FOR ALL;
Table	Op	Msg_type	Msg_text
test.t5	analyze	status	Engine-independent statistics collected
test.t5	analyze	status	OK
test.t6	analyze	status	Engine-independent statistics collected
test.t6	analyze	status	OK
SET SESSION parallel_worker_threads= 0;
SET @drive0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[1]') AS DOUBLE);
SET @inner0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[2]') AS DOUBLE);
SET SESSION parallel_worker_threads= 8;
SET @drive8= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[1]') AS DOUBLE);
SET @inner8= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[2]') AS DOUBLE);
# expect 1 1 8: both tables are discounted, and the joined table by exactly
# the worker count -- it is divided, where the driving table also carries the
# per-row transport factor and the per-worker setup charge, so its own ratio
# is not the worker count and is not checked here
SELECT @drive8 < @drive0 AS driving_discounted,
@inner8 < @inner0 AS joined_table_discounted,
ROUND(@inner0 / @inner8) AS joined_divided_by;
driving_discounted	joined_table_discounted	joined_divided_by
1	1	8
#
# What the manager spends draining the rows is charged per row and is not
# divided by anything, so raising parallel_query_drain_row_cost raises the
# plan's cost by the row count times the increase. 20000 rows and a rise of
# 10 (a thousandth of that internally) is 200.
#
SET @dr= @@parallel_query_drain_row_cost;
SET SESSION parallel_worker_threads= 8;
SET SESSION parallel_query_drain_row_cost= 0;
SET @c0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
SET SESSION parallel_query_drain_row_cost= 10;
SET @c1= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
# expect 1 200: the drain is charged, and by rows times the rise
SELECT @c1 > @c0 AS drain_is_charged, ROUND(@c1 - @c0) AS by_rows_times_rise;
drain_is_charged	by_rows_times_rise
1	200
#
# And it is charged on the rows the join produces, not the rows the driving
# table scans. Here the inner table's predicate leaves about a hundred rows
# of the twenty thousand scanned, so the same rise costs about 1 rather than
# the 200 above -- which is what says the row count is the join's output.
#
SET SESSION parallel_query_drain_row_cost= 0;
SET @j0= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
SET SESSION parallel_query_drain_row_cost= 10;
SET @j1= CAST(JSON_EXTRACT(JSON_EXTRACT(@j,'$**.cost'),'$[0]') AS DOUBLE);
# expect 1 1: charged, and far below what the driving row count would cost
SELECT @j1 > @j0 AS drain_is_charged,
@j1 - @j0 < 20 AS on_output_rows_not_scanned_rows;
drain_is_charged	on_output_rows_not_scanned_rows
1	1
SET SESSION parallel_query_drain_row_cost= @dr;
DROP TABLE t1, t2, t3, t4, t5, t6;
SET SESSION parallel_worker_threads= @s;
