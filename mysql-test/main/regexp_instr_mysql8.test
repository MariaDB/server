--echo #
--echo # MDEV-39520: REGEXP_INSTR: Missing optional arguments
--echo #

--echo # 1. Basic 2-argument form

SELECT REGEXP_INSTR('abba', 'b{2}');
SELECT REGEXP_INSTR('abba', 'x');
SELECT REGEXP_INSTR('hello world', 'world');

--echo #
--echo # NOTE: MySQL 8.0 rejects an empty pattern with
--echo # ER_REGEXP_ILLEGAL_ARGUMENT (error 3685). MariaDB (PCRE2) accepts
--echo # it and matches at every character position. This is pre-existing
--echo # MariaDB behaviour of the 2-argument form, kept as is: see the
--echo # commit message for the list of remaining MySQL 8.0
--echo # incompatibilities.
--echo #

SELECT REGEXP_INSTR('hello', '');
SELECT REGEXP_INSTR('', 'a');
SELECT REGEXP_INSTR('', '');


--echo # 2. Three arguments: pos

SELECT REGEXP_INSTR('abba', 'b{2}', 2);
SELECT REGEXP_INSTR('abba', 'b{2}', 3);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1);
SELECT REGEXP_INSTR('aabba', 'b', 3);
SELECT REGEXP_INSTR('xyzabc', 'abc', 4);
SELECT REGEXP_INSTR('abc', 'c', 3);
SELECT REGEXP_INSTR('abc', 'c', 4);

--echo # 3. Four arguments: occurrence

SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 1);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 2);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 3);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 2, 1);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 2, 2);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 3, 2);

--echo # Repeating pattern
SELECT REGEXP_INSTR('aaa', 'a', 1, 1);
SELECT REGEXP_INSTR('aaa', 'a', 1, 2);
SELECT REGEXP_INSTR('aaa', 'a', 1, 3);
SELECT REGEXP_INSTR('aaa', 'a', 1, 4);

--echo # 4. Five arguments: return_option

SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 1, 0);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 1, 1);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 2, 0);
SELECT REGEXP_INSTR('abbabba', 'b{2}', 1, 2, 1);

SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 0);
SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 1);
SELECT REGEXP_INSTR('abcabc', 'b', 1, 2, 0);
SELECT REGEXP_INSTR('abcabc', 'b', 1, 2, 1);
SELECT REGEXP_INSTR('abcabc', 'z', 1, 1, 1);

--echo # 5. Six arguments: match_type

SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, 'i');
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, 'c');
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, 'ci');
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, 'ic');
SELECT REGEXP_INSTR('a\nb\nc', '^b$', 1, 1, 0, 'm');
SELECT REGEXP_INSTR('a\nb\nc', '^b$', 1, 1, 0, '');
SELECT REGEXP_INSTR('a\nb\nc', 'a.b', 1, 1, 0, 'n');
SELECT REGEXP_INSTR('a\nb\nc', 'a.b', 1, 1, 0, '');
SELECT REGEXP_INSTR('a\nb', '^b$', 1, 1, 0, 'mu');
SELECT REGEXP_INSTR('a\nB\nc', '^b$', 1, 1, 0, 'im');

--echo # 6. Multibyte characters
--echo #
--echo # Hex literals keep this file 100% pure ASCII:
--echo # X'C3A1C3A9C3AD' = 3 utf8mb4 letters,
--echo # X'C3A9' = its 2nd letter, X'C3AD' = its 3rd letter,
--echo # X'CEB1CEB2CEB3CEB4' = 4 Greek letters,
--echo # X'CEB3' = its 3rd letter, X'CEB2' = its 2nd letter.

SET NAMES utf8mb4;

--echo # 'áéí' = X'C3A1C3A9C3AD', 'é' = X'C3A9'
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'C3A9');

--echo # 'áéí' = X'C3A1C3A9C3AD', 'í' = X'C3AD'
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'C3AD');

--echo # 'αβγδ' = X'CEB1CEB2CEB3CEB4', 'γ' = X'CEB3'
SELECT REGEXP_INSTR(_utf8mb4 X'CEB1CEB2CEB3CEB4', _utf8mb4 X'CEB3');

--echo # 'áéíó' = X'C3A1C3A9C3ADC3B3', 'í' = X'C3AD'
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3ADC3B3', _utf8mb4 X'C3AD', 2);

--echo # 'αβγδ' = X'CEB1CEB2CEB3CEB4', 'β' = X'CEB2'
SELECT REGEXP_INSTR(_utf8mb4 X'CEB1CEB2CEB3CEB4', _utf8mb4 X'CEB2', 2);

--echo # 'αβγδ' = X'CEB1CEB2CEB3CEB4', 'β' = X'CEB2'
SELECT REGEXP_INSTR(_utf8mb4 X'CEB1CEB2CEB3CEB4', _utf8mb4 X'CEB2', 1, 1, 1) AS result;

--echo # 7. NULL propagation

SELECT REGEXP_INSTR(NULL,  'a');
SELECT REGEXP_INSTR('abc', NULL);
SELECT REGEXP_INSTR('abc', 'a', NULL);
SELECT REGEXP_INSTR('abc', 'a', 1, NULL);
SELECT REGEXP_INSTR('abc', 'a', 1, 1, NULL);
SELECT REGEXP_INSTR('abc', 'a', 1, 1, 0, NULL);

--echo # 8. Edge cases

--echo # Zero-length match
SELECT REGEXP_INSTR('abc', '', 1, 1);
SELECT REGEXP_INSTR('abc', '', 1, 2);
SELECT REGEXP_INSTR('abc', '', 1, 3);
SELECT REGEXP_INSTR('abc', '', 1, 4);
SELECT REGEXP_INSTR('abc', '', 1, 5);
SELECT REGEXP_INSTR('abc', '(?=c)', 1, 1);
SELECT REGEXP_INSTR('abc', '(?=c)', 1, 2);
SELECT REGEXP_INSTR('aaa', '(?=a)', 1, 1);
SELECT REGEXP_INSTR('aaa', '(?=a)', 1, 2);
SELECT REGEXP_INSTR('aaa', '(?=a)', 1, 3);
SELECT REGEXP_INSTR('aaa', '(?=a)', 1, 4);
SELECT REGEXP_INSTR(_utf8mb4 X'CEB26161', '(?=a)', 1, 2);
SELECT REGEXP_INSTR(_utf8mb4 X'61CEB2CEB2', _utf8mb4 X'283F3DCEB229', 1, 2) AS result;

--echo # Anchored patterns
SELECT REGEXP_INSTR('abcabc', '^abc');
SELECT REGEXP_INSTR('abcabc', 'abc$');
SELECT REGEXP_INSTR('abcabc', '^abc$');

--echo # Alternation
SELECT REGEXP_INSTR('foo bar baz', 'bar|baz', 1, 1);
SELECT REGEXP_INSTR('foo bar baz', 'bar|baz', 1, 2);

--echo # Back-references
SELECT REGEXP_INSTR('aabbaabb', '(a+)(b+)\\1', 1, 1);
SELECT REGEXP_INSTR('aabbaabb', '(a+)(b+)\\1', 1, 2);

--echo # Very long subject
SELECT REGEXP_INSTR(REPEAT('x', 1000), 'x{5}', 1, 1);
SELECT REGEXP_INSTR(REPEAT('x', 1000), 'x{5}', 1, 200);

--echo # case-sensitive vs collation default
SELECT REGEXP_INSTR('Test-abc-abc-abc', 'AB', 1, 3, 0);
SELECT REGEXP_INSTR('Test-abc-abc-abc', 'AB', 1, 3, 0, 'c');

--echo # Non-constant match_type with constant pattern
--echo # The flags change from row to row: 'c' is case-sensitive,
--echo # 'i' is case-insensitive, 'c' again recompiles back.
CREATE TABLE foo (cond VARCHAR(50));
INSERT INTO foo VALUES ('c'), ('i'), ('c');
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, cond) FROM foo;
DROP TABLE foo;

--echo # Prepared statements with changing parameters
PREPARE stmt FROM
"SELECT REGEXP_INSTR(?, ?, 1, ?)";
SET @subject = 'abc abc abc';
SET @pattern = 'abc';
SET @occ = 1;
EXECUTE stmt USING @subject, @pattern, @occ;
SET @occ = 2;
EXECUTE stmt USING @subject, @pattern, @occ;

PREPARE stmt FROM
"SELECT REGEXP_INSTR(?, ?, 1, 1, 0, ?)";
SET @subject = 'Abc abc';
SET @pattern = 'abc';
SET @match = 'c';
EXECUTE stmt USING @subject, @pattern, @match;
SET @match = 'i';
EXECUTE stmt USING @subject, @pattern, @match;

--echo # match_type from 1-row table
CREATE TABLE t1 (cond VARCHAR(10));
INSERT INTO t1 VALUES ('c');
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, cond) FROM t1;
DROP TABLE t1;

CREATE TABLE t1 (
  subject VARCHAR(20),
  pattern VARCHAR(20),
  mt      VARCHAR(10)
);
INSERT INTO t1 VALUES ('Abc abc', 'abc', 'c');
SELECT REGEXP_INSTR(subject, pattern, 1, 1, 0, mt) FROM t1;
UPDATE t1 SET mt='i';
SELECT REGEXP_INSTR(subject, pattern, 1, 1, 0, mt) FROM t1;
DROP TABLE t1;

--echo # 9. Error paths
--echo # pos = 0
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abcabc', 'b', 0);
--echo # negative pos
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abcabc', 'b', -1);
--echo # pos past the end of the subject is not an error, it returns 0
SELECT REGEXP_INSTR('abcabc', 'b', 7);
--echo # occurrence = 0
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abcabc', 'b', 1, 0);
--echo # negative occurrence
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abcabc', 'b', 1, -1);
--echo # return_option = 2
--error ER_WRONG_PARAMETERS_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 2);
--echo # invalid match_type letter in a constant argument
--echo # (the error is raised at prepare time)
--error ER_WRONG_VALUE_FOR_TYPE
SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 0, 'x');
--echo # invalid match_type letter from a column
--echo # (the error is raised at execution time)
CREATE TABLE t_bad_mt (mt VARCHAR(10));
INSERT INTO t_bad_mt VALUES ('x');
--error ER_WRONG_VALUE_FOR_TYPE
SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 0, mt) FROM t_bad_mt;
DROP TABLE t_bad_mt;
--echo # an invalid letter in ucs2 is converted to ASCII before parsing,
--echo # so the error message shows the value
--error ER_WRONG_VALUE_FOR_TYPE
SELECT REGEXP_INSTR('abcabc', 'b', 1, 1, 0, CONVERT('x' USING ucs2));
--echo # a valid letter in ucs2 is parsed correctly, not as raw bytes
SELECT REGEXP_INSTR('Abba', 'ABBA', 1, 1, 0, CONVERT('i' USING ucs2));
--echo # wrong number of arguments
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abc');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT REGEXP_INSTR('abc', 'b', 1, 1, 0, 'i', 2);


--echo # 10. Unsigned pos and occurrence values
--echo # A value above the 32-bit range can never match, it returns 0
SELECT REGEXP_INSTR('abcabc', 'b', CAST(18446744073709551615 AS UNSIGNED)) AS result;
SELECT REGEXP_INSTR('abcabc', 'b', 1, CAST(18446744073709551615 AS UNSIGNED)) AS result;
--echo # small unsigned values work as usual
SELECT REGEXP_INSTR('abcabc', 'b', CAST(2 AS UNSIGNED), CAST(2 AS UNSIGNED)) AS result;
--echo # unsigned values from a table
CREATE TABLE t_unsigned (pos BIGINT UNSIGNED, occ BIGINT UNSIGNED);
INSERT INTO t_unsigned VALUES (18446744073709551615, 1), (1, 18446744073709551615);
SELECT REGEXP_INSTR('abcabc', 'b', pos, occ) FROM t_unsigned;
DROP TABLE t_unsigned;

--echo # 11. NULL arguments from a table, not only literals
CREATE TABLE t_null (
  s  VARCHAR(10),
  p  VARCHAR(10),
  pos INT,
  occ INT,
  ret INT,
  mt  VARCHAR(10)
);
INSERT INTO t_null VALUES
  (NULL,    'b',  1,    1,    0,    'i'),
  ('abcabc', NULL, 1,    1,    0,    'i'),
  ('abcabc', 'b',  NULL, 1,    0,    'i'),
  ('abcabc', 'b',  1,    NULL, 0,    'i'),
  ('abcabc', 'b',  1,    1,    NULL, 'i'),
  ('abcabc', 'b',  1,    1,    0,    NULL);
SELECT REGEXP_INSTR(s, p, pos, occ, ret, mt) FROM t_null;
DROP TABLE t_null;

--echo # 12. Zero-length matches on a multibyte subject
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'', 1, 1);
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'', 1, 3);
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'', 1, 4);
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'', 2);
SELECT REGEXP_INSTR(_utf8mb4 X'C3A1C3A9C3AD', _utf8mb4 X'C3A9', 1, 1, 1) AS result;
--echo # a ucs2 subject is converted internally to utf8mb4
SELECT REGEXP_INSTR(_ucs2 X'006100620063', _ucs2 X'0062');
SELECT REGEXP_INSTR(_ucs2 X'006100620063', _ucs2 X'', 1, 2);

--echo End of 13.2 tests
