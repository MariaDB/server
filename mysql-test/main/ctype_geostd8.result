#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES geostd8 COLLATE geostd8_general_ci;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (geostd8_general_ci,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y_' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (geostd8_general_ci,COERCIBLE) for operation '='
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y+' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (geostd8_general_ci,COERCIBLE) for operation '='
SET NAMES geostd8 COLLATE geostd8_bin;
SELECT Insert_priv FROM mysql.user WHERE Insert_priv='Y' LIMIT 0;
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (geostd8_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
