call mtr.add_suppression("Unsafe statement written to the binary log using statement format");
#
# MDEV-41218 A commit boundary keeps the logging format of its statement
#
# The boundary runs the bodies in a statement of its own.  With
# binlog_format=MIXED that statement is row-based, as every statement
# that may capture a row for the trigger is.  The statement that
# reached the boundary keeps its own format: a CREATE TABLE ... SELECT
# that commits the transaction is logged as a statement, as it is
# when the table has no trigger.
RESET MASTER;
CREATE TABLE tf (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tf_log (u VARCHAR(40)) ENGINE=InnoDB;
CREATE TABLE tf_src (a INT) ENGINE=InnoDB;
INSERT INTO tf_src VALUES (1), (2);
# Without a trigger
BEGIN;
INSERT INTO tf VALUES (1), (2);
CREATE TABLE tf_ctas1 AS SELECT a FROM tf_src;
