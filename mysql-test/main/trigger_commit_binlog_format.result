#
# MDEV-41218 The format of a statement that may capture a row for a
# BEFORE COMMIT trigger
#
# With statement-based logging the replica captures the rows of the
# statements it executes and fires its own triggers; it captures
# nothing from row events.  So that one transaction does not have rows
# of both kinds for one trigger, with binlog_format=MIXED every
# statement that may capture a row for a BEFORE COMMIT trigger is
# logged in row format: a statement on the table and a statement that
# calls a stored function that writes it.  A statement of another
# event than the trigger's is not, and neither is a statement with a
# ROW trigger of the same body.  With binlog_format=STATEMENT all of
# them are logged as statements.
CREATE TABLE tx (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tx_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tx_log (a INT) ENGINE=InnoDB;
CREATE TABLE tx_src (a INT) ENGINE=InnoDB;
INSERT INTO tx_src VALUES (1), (2);
CREATE TRIGGER tx_commit AFTER INSERT ON tx BEFORE COMMIT
INSERT INTO tx_log VALUES (1);
CREATE TRIGGER tx_row_ins AFTER INSERT ON tx_row FOR EACH ROW
INSERT INTO tx_log VALUES (2);
CREATE FUNCTION f_tx(i INT) RETURNS INT
BEGIN
INSERT INTO tx VALUES (i), (i + 1);
RETURN i;
END $$
# binlog_format=MIXED
INSERT INTO tx_row VALUES (1), (2);
INSERT INTO tx VALUES (1), (2);
BEGIN;
INSERT INTO tx VALUES (3), (4);
UPDATE tx SET id= id + 100 WHERE id = 4;
INSERT INTO tx SELECT a + 10 FROM tx_src;
COMMIT;
SELECT f_tx(21);
f_tx(21)
21
