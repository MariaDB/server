#
# MDEV-41218 A statement whose foreign key cascade changes a table that
# has BEFORE COMMIT triggers
#
# Rows changed by a foreign key cascade are not captured.  A statement
# that reaches a table with BEFORE COMMIT triggers only through a
# cascade captures no row for them, so binlog_format=MIXED logs it as
# a statement.  A statement that deletes from that table itself is
# logged in row format.
CREATE TABLE tf_p (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tf_c (id INT PRIMARY KEY, p INT,
FOREIGN KEY (p) REFERENCES tf_p (id) ON DELETE CASCADE)
ENGINE=InnoDB;
INSERT INTO tf_p VALUES (1), (2), (3);
INSERT INTO tf_c VALUES (1, 1), (2, 2), (3, 3), (4, 3);
CREATE TRIGGER tf_c_commit AFTER DELETE ON tf_c BEFORE COMMIT SET @x= 1;
DELETE FROM tf_p WHERE id IN (1, 2);
DELETE FROM tf_c WHERE id IN (3, 4);
