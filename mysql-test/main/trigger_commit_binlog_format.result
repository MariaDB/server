#
# MDEV-41218 A BEFORE COMMIT body that writes a non-transactional table
#
# A statement that may capture a row for the trigger counts as writing
# the table that the body writes, as a statement with a ROW trigger
# does.  With binlog_format=STATEMENT it has the warning that it is
# unsafe inside a transaction and none in autocommit mode, as the
# statement with the ROW trigger.  With binlog_format=MIXED it is
# logged in row format in both, as every statement that may capture
# a row for a BEFORE COMMIT trigger is; the statement with the ROW
# trigger is only inside a transaction.  The ROW trigger is here for
# comparison: its body writes nothing for these rows, as the BEFORE
# COMMIT body, which is not executed yet.
CREATE TABLE tm (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tm_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tm_log (a INT) ENGINE=MyISAM;
CREATE TRIGGER tm_commit AFTER INSERT ON tm BEFORE COMMIT
INSERT INTO tm_log VALUES (1);
CREATE TRIGGER tm_row_ins AFTER INSERT ON tm_row FOR EACH ROW
BEGIN
IF NEW.id > 100 THEN
INSERT INTO tm_log VALUES (2);
END IF;
END $$
# binlog_format=MIXED
INSERT INTO tm_row VALUES (1), (2);
INSERT INTO tm VALUES (1), (2);
BEGIN;
INSERT INTO tm_row VALUES (3), (4);
COMMIT;
BEGIN;
INSERT INTO tm VALUES (3), (4);
COMMIT;
