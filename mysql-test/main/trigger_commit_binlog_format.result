#
# MDEV-41218 An unsafe BEFORE COMMIT body with binlog_format=STATEMENT
#
# Every statement that may capture a row for the trigger is logged as
# a statement and has the warning that it is unsafe, whether or not
# it captures a row, as a statement with a ROW trigger that has such
# a body.  The boundary's statement logs nothing, so the statement
# that reached the boundary has only its own warnings: a COMMIT, a
# DDL statement that commits the transaction and the CALL of a
# procedure that commits it have none.
CREATE TABLE tu (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tu_row (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tu_log (u VARCHAR(40)) ENGINE=InnoDB;
CREATE TABLE tu_src (a INT) ENGINE=InnoDB;
INSERT INTO tu_src VALUES (1), (2);
CREATE TRIGGER tu_row_ins AFTER INSERT ON tu_row FOR EACH ROW
INSERT INTO tu_log VALUES (UUID());
CREATE TRIGGER tu_commit AFTER INSERT ON tu BEFORE COMMIT
INSERT INTO tu_log VALUES (UUID());
CREATE PROCEDURE p_tu() COMMIT;
SET binlog_format= STATEMENT;
# A ROW trigger
INSERT INTO tu_row VALUES (1), (2);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
# A BEFORE COMMIT trigger: a statement that captures rows, one that
# captures none, and the COMMIT
BEGIN;
INSERT INTO tu VALUES (1), (2);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
INSERT INTO tu SELECT 100 FROM DUAL WHERE 1 = 0;
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
COMMIT;
# In autocommit mode
INSERT INTO tu VALUES (3), (4);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
# A DDL statement commits the transaction
BEGIN;
INSERT INTO tu VALUES (5), (6);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
CREATE TABLE tu_ddl (a INT);
BEGIN;
INSERT INTO tu VALUES (7), (8);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
CREATE TABLE tu_ctas AS SELECT a FROM tu_src;
# A procedure commits the transaction
BEGIN;
INSERT INTO tu VALUES (9), (10);
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
CALL p_tu();
