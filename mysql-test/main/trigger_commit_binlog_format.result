#
# MDEV-41218 A commit boundary uses the binlog_format of the session
#
# While it runs a statement that writes no rows, such as COMMIT,
# SAVEPOINT, XA END or a DDL statement, the server sets the session's
# binlog_format to STATEMENT.  The boundary's statement, which runs
# the bodies, decides its format from the value the session has
# outside that statement.  At READ COMMITTED, where InnoDB can only be
# logged in row format, the boundaries below would otherwise fail.
CREATE TABLE tc (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE tc_log (a INT) ENGINE=InnoDB;
CREATE TRIGGER tc_commit AFTER INSERT ON tc BEFORE COMMIT OR SAVEPOINT
INSERT INTO tc_log VALUES (1);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
# COMMIT and SAVEPOINT
BEGIN;
INSERT INTO tc VALUES (1), (2);
SAVEPOINT s1;
INSERT INTO tc VALUES (3), (4);
COMMIT;
# A statement that starts a transaction, and a DDL statement
BEGIN;
INSERT INTO tc VALUES (5), (6);
BEGIN;
INSERT INTO tc VALUES (7), (8);
CREATE VIEW tc_view AS SELECT id FROM tc;
# XA END
XA START 'tc1';
INSERT INTO tc VALUES (9), (10);
XA END 'tc1';
XA COMMIT 'tc1' ONE PHASE;
# Under LOCK TABLES
LOCK TABLES tc WRITE, tc_log WRITE;
BEGIN;
INSERT INTO tc VALUES (11), (12);
COMMIT;
UNLOCK TABLES;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SELECT @@binlog_format;
@@binlog_format
MIXED
SELECT id FROM tc ORDER BY id;
