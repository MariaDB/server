# The same when a statement of a stored procedure commits the
# transaction, in the first and in the second call of the procedure.
# The INSERT is not in the procedure: after a statement that is
# logged in row format, the statements of the same call are too.
CREATE PROCEDURE p_tf()
BEGIN
CREATE TABLE tf_ctas3 AS SELECT a FROM tf_src;
DROP TABLE tf_ctas3;
END $$
BEGIN;
INSERT INTO tf VALUES (5), (6);
CALL p_tf();
BEGIN;
INSERT INTO tf VALUES (7), (8);
CALL p_tf();
