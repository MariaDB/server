--source include/have_partition.inc
--source include/have_innodb.inc

--echo #
--echo # MDEV-XXXXX HANDLER READ NEXT/PREV after a key read on a partitioned table
--echo #

--echo # RANGE partitioning
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY RANGE(a) (PARTITION p0 VALUES LESS THAN (10),
                       PARTITION p1 VALUES LESS THAN (20),
                       PARTITION p2 VALUES LESS THAN (30));
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (7);
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a = (15);
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a = (29);
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (12);
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (8);
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (15);
HANDLER t1 READ a PREV;
HANDLER t1 CLOSE;
DROP TABLE t1;

--echo # HASH partitioning
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY HASH(a) PARTITIONS 3;
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (7);
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a = (15);
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 READ a = (29);
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (12);
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (8);
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (15);
HANDLER t1 READ a PREV;
HANDLER t1 CLOSE;
DROP TABLE t1;

--echo # Single partition
CREATE TABLE t1 (a INT, KEY(a)) ENGINE=InnoDB
PARTITION BY HASH(a);
INSERT INTO t1 VALUES (5),(8),(15),(25);
HANDLER t1 OPEN;
HANDLER t1 READ a = (8);
HANDLER t1 READ a PREV;
HANDLER t1 READ a PREV;
HANDLER t1 READ a = (7);
HANDLER t1 READ a NEXT;
HANDLER t1 READ a NEXT;
HANDLER t1 CLOSE;
DROP TABLE t1;

--echo # End of 11.4 tests
