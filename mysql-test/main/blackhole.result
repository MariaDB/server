#
# Bug #11880012: INDEX_SUBQUERY, BLACKHOLE,
#                HANG IN PREPARING WITH 100% CPU USAGE
#
CREATE TABLE t1(a INT NOT NULL);
INSERT INTO t1 VALUES (1), (2), (3);
CREATE TABLE t2 (a INT UNSIGNED, b INT, UNIQUE KEY (a, b)) ENGINE=BLACKHOLE;
SELECT 1 FROM t1 WHERE a = ANY (SELECT a FROM t2);
1
DROP TABLE t1, t2;
create temporary table t1 (a int) engine=blackhole;
lock table t1 write;
truncate table t1;
select * from t1;
a
unlock tables;
drop temporary table t1;
End of 5.5 tests 
#
# Bug#13948247 DIVISION BY 0 IN GET_BEST_DISJUNCT_QUICK WITH FORCE INDEX GROUP BY
#
CREATE TABLE t1(a INT, b INT, c INT, KEY(c), UNIQUE(a)) ENGINE = BLACKHOLE;
SELECT 0 FROM t1 FORCE INDEX FOR GROUP BY(a) WHERE a = 0 OR b = 0 AND c = 0;
0
DROP TABLE t1;
End of 5.6 tests
CREATE TABLE `t` (
`a` varchar(3000) NOT NULL default '',
PRIMARY KEY  (`a`)
) ENGINE=BLACKHOLE;
DROP TABLE `t`;
End of 10.1 tests
#
# MDEV-30886 Assertion `0' in Protocol::end_statement upon fulltext
# search in blackhole table
#
CREATE TABLE t (f CHAR(255), FULLTEXT KEY (f)) ENGINE=BLACKHOLE;
INSERT INTO t VALUES ('wear'), ('shoes');
SELECT * FROM t WHERE MATCH (f) AGAINST ('wear');
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
SELECT * FROM t WHERE MATCH (f) AGAINST ('wear' WITH QUERY EXPANSION);
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
SELECT * FROM t WHERE MATCH (f) AGAINST ('+wear' IN BOOLEAN MODE);
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
SELECT f, MATCH (f) AGAINST ('wear') FROM t;
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
SELECT COUNT(*) FROM t WHERE MATCH (f) AGAINST ('wear');
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
UPDATE t SET f= 'x' WHERE MATCH (f) AGAINST ('wear');
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
DELETE FROM t WHERE MATCH (f) AGAINST ('wear');
ERROR HY000: The storage engine BLACKHOLE doesn't support FULLTEXT indexes
DROP TABLE t;
# End of 10.11 tests
