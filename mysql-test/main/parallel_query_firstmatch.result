#
# The other strategies are still refused: here DuplicateWeedout.
#
SET optimizer_switch='firstmatch=off,materialization=off,loosescan=off';
EXPLAIN SELECT COUNT(*) FROM fact f
WHERE f.val < 50 AND f.id IN (SELECT o.id FROM other o WHERE o.flag = 1);
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	f	ALL	PRIMARY	NULL	NULL	NULL	20000	Using where
1	PRIMARY	o	ref	id	id	5	test.f.id	2	Using where; Start temporary; End temporary
SET SESSION optimizer_trace=1;
SELECT COUNT(*) FROM fact f
WHERE f.val < 50 AND f.id IN (SELECT o.id FROM other o WHERE o.flag = 1);
SELECT JSON_EXTRACT(trace, '$**.parallel_scan_declined_because') AS why
FROM information_schema.optimizer_trace;
why
["o is read under a semijoin duplicate-elimination strategy other than FirstMatch, which a worker's nested loop does not implement"]
SET SESSION optimizer_trace=@save_trace;
SET optimizer_switch=@save_switch;
SET SESSION optimizer_parallel_setup_cost= @save_cost;
SET SESSION join_cache_level= @save_jcl;
SET SESSION parallel_worker_threads= @save_pwt;
DROP TABLE dim, fact, other;
