#!/bin/bash

set -e

case "$1" in
  remove|disappear)
    # Withdraw from the /etc/mysql/my.cnf alternatives if still registered from
    # previous MySQL variant packaging paradigm.
    if [ -f /usr/share/mysql-common/configure-symlinks ]
    then
      /usr/share/mysql-common/configure-symlinks remove mariadb "/etc/mysql/mariadb.cnf" || true
    fi
    update-alternatives --remove my.cnf "/etc/mysql/mariadb.cnf" 2>/dev/null || true
    ;;
  purge)
    rmdir /etc/mariadb 2>/dev/null || true
    ;;
esac

#DEBHELPER#
