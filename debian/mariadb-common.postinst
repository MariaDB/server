#!/bin/bash

set -e

# cmake/sysconfdir.cmake changes the configuration directory in the
# maintainer scripts to the configured one, except on lines that contain
# old_sysconfdir, and fills in the first package version using it.
old_sysconfdir=/etc/mysql
sysconfdir=/etc/mysql
sysconfdir_move_version=@DEB_SYSCONFDIR_MOVE_VERSION@

case "$1" in
  configure)
    # $sysconfdir/my.cnf is a regular file, not shared with the MySQL
    # variants. Withdraw from the $old_sysconfdir/my.cnf alternatives that
    # versions using the old directory registered.
    if [ -f /usr/share/mysql-common/configure-symlinks ]
    then
      /usr/share/mysql-common/configure-symlinks remove mariadb "$old_sysconfdir/mariadb.cnf" || true
    fi
    update-alternatives --remove my.cnf "$old_sysconfdir/mariadb.cnf" 2>/dev/null || true
    ;;
esac

#DEBHELPER#

# A locally modified $old_sysconfdir/mariadb.cnf was moved to
# $sysconfdir/my.cnf by dpkg-maintscript-helper above. Update its
# references to the files that were moved, see mariadb-common.preinst.
if [ "$1" = "configure" ] && [ "$sysconfdir" != "$old_sysconfdir" ] &&
   [ -n "$2" ] &&
   dpkg --compare-versions "$2" le-nl "$sysconfdir_move_version" &&
   grep --quiet --no-messages "$old_sysconfdir/" "$sysconfdir/my.cnf"
then
  sed -i -E \
    -e "s#$old_sysconfdir/mariadb\.cnf([^[:alnum:]_.-]|\$)#$sysconfdir/my.cnf\1#g" \
    -e "s#$old_sysconfdir/(my\.cnf|debian\.cnf|debian-start|conf\.d|mariadb\.conf\.d)([^[:alnum:]_.-]|\$)#$sysconfdir/\1\2#g" \
    "$sysconfdir/my.cnf"
fi
