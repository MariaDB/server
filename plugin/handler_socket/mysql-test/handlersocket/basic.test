--source include/not_windows_embedded.inc
--source include/have_innodb.inc
--source include/not_asan.inc

call mtr.add_suppression('handlersocket: open_files_limit is too small');

install plugin handlersocket soname 'handlersocket.so';

let HS_SECRET=`select @@handlersocket_plain_secret`;
let HS_PORT=`select @@handlersocket_port`;

--query_vertical select plugin_name, plugin_version, plugin_status, plugin_type, plugin_library, plugin_library_version, plugin_author, plugin_description, plugin_license, plugin_maturity, plugin_auth_version from information_schema.plugins where plugin_name = 'handlersocket'
--replace_result $HS_PORT HS_PORT
select variable_name, if(variable_name like 'handlersocket_plain_secret%', 'HS_SECRET', variable_value) as variable_value from information_schema.global_variables where variable_name like 'handlersocket%' order by variable_name;
select length(@@handlersocket_plain_secret), @@handlersocket_plain_secret = @@handlersocket_plain_secret_wr;

create table t1 (id int primary key, name varchar(100)) engine=innodb;

perl;
use IO::Socket::INET;
my $sock = IO::Socket::INET->new(PeerAddr => '127.0.0.1',
  PeerPort => $ENV{HS_PORT}, Proto => 'tcp') or die "connect(): $!";
# 1) auth:  A <atyp=1> <secret>
# 2) open_index:  P <indexid> <db> <table> <index> <columns>
print $sock "A\t1\t$ENV{HS_SECRET}\nP\t1\ttest\tt1\tPRIMARY\tid,name\n";
print $sock "0\t=\t2147483647\t1\n";
printf "auth: %sopen: %sbad read: %s", scalar(<$sock>), scalar(<$sock>), scalar(<$sock>);
# open_index with a huge list of return fields, then exec with a modop
print $sock "P\t2\ttest\tt1\tPRIMARY\t" . ("id," x 1000000) . "id\n";
print $sock "2\t=\t1\t1\t1\t0\tU\n";
printf "open many: %smodify many: %s", scalar(<$sock>), scalar(<$sock>);
# huge statement id
print $sock "P\t4294967295\ttest\tt1\tPRIMARY\tid\n";
# huge IN list length
print $sock "1\t=\t1\t1\t1\t0\t@\t0\t4294967295\t1\n";
printf "open huge id: %shuge in: %s", scalar(<$sock>), scalar(<$sock>);
EOF

uninstall plugin handlersocket;
drop table t1;

