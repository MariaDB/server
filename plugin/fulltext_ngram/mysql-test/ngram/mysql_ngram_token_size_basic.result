ngram_token_size	2
select * from information_schema.global_variables where variable_name='ngram_token_size';
VARIABLE_NAME	VARIABLE_VALUE
NGRAM_TOKEN_SIZE	2
select * from information_schema.session_variables where variable_name='ngram_token_size';
