--source include/have_innodb.inc

--echo #
--echo # MDEV-10267 Add "ngram" support to MariaDB
--echo #

# Scenario 2 of mysql_ngram_2: CREATE a CJK fulltext index with ngram
# parser when ngram parser is not loaded (--ngram=OFF in
# mysql_ngram_2_off_parser.opt)

# MySQL 8.0 connects with utf8mb4 by default
SET NAMES utf8mb4;

--error ER_FUNCTION_NOT_DEFINED
CREATE TABLE t2 (
        id INT UNSIGNED AUTO_INCREMENT NOT NULL PRIMARY KEY,
        title VARCHAR(200),
	FULLTEXT INDEX ft_title (title) WITH PARSER ngram
) ENGINE=InnoDB DEFAULT CHARACTER SET gb2312 COLLATE gb2312_chinese_ci;

CREATE TABLE t2 (
        id INT UNSIGNED AUTO_INCREMENT NOT NULL PRIMARY KEY,
        title VARCHAR(200)
) ENGINE=InnoDB DEFAULT CHARACTER SET gb2312 COLLATE gb2312_chinese_ci;

--error ER_FUNCTION_NOT_DEFINED
ALTER TABLE t2 ADD FULLTEXT INDEX ft_title (title) WITH PARSER ngram;

DROP TABLE t2;
