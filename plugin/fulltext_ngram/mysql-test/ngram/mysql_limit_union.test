--source include/have_innodb.inc

--echo #
--echo # MDEV-10267 Add "ngram" support to MariaDB
--echo #

# The ngram case of MySQL's innodb_fts.limit_union
# (the rest of that test is innodb_fts.limit_union),
# with 1-grams (mysql_limit_union.opt)

--echo #
--echo # Bug #31228694 FTS QUERY WITH LIMIT CRASH
--echo #

select @@ngram_token_size;

CREATE TABLE t1 (
  id INT(10) unsigned NOT NULL AUTO_INCREMENT,
  name VARCHAR(45) NOT NULL,
  PRIMARY KEY (id) USING BTREE,
  FULLTEXT KEY search_name (name)  WITH PARSER ngram
) ENGINE=InnoDB;

INSERT INTO t1(name) VALUES('x'), ('mx'), ('mx'), ('mx'), ('mx');

SELECT * FROM t1 WHERE MATCH (`name`) AGAINST ('mx*' IN BOOLEAN MODE) LIMIT 3;
DROP TABLE t1;
