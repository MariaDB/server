--source include/have_innodb.inc

--echo #
--echo # MDEV-10267 Add "ngram" support to MariaDB
--echo #

# ngram_token_size is 1 to 10; 0 (mysql_ngram_token_size_0.opt) becomes 1

call mtr.add_suppression("option 'ngram-token-size': signed value 0");
--disable_warnings
select * from information_schema.global_variables where variable_name='ngram_token_size';
--enable_warnings
