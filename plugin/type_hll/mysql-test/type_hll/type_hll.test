--echo #
--echo # Pluggable data type HLL
--echo #

SELECT plugin_name, plugin_type, plugin_status FROM information_schema.plugins
WHERE plugin_name='hll';

--echo #
--echo # Column definition
--echo #

CREATE TABLE t1 (h HLL);
SHOW CREATE TABLE t1;
SELECT column_type, data_type, character_set_name
FROM information_schema.columns WHERE table_name='t1';
DROP TABLE t1;

--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE TABLE t1 (h HLL(10));
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE TABLE t1 (h HLL CHARACTER SET latin1);

--echo #
--echo # Keys are not supported
--echo #

--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
CREATE TABLE t1 (h HLL, KEY(h(10)));
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
CREATE TABLE t1 (h HLL, UNIQUE(h));
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
CREATE TABLE t1 (h HLL, PRIMARY KEY(h(10)));
--error ER_BAD_FT_COLUMN
CREATE TABLE t1 (h HLL, FULLTEXT(h));
CREATE TABLE t1 (id INT, h HLL);
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
ALTER TABLE t1 ADD KEY(h(10));
DROP TABLE t1;

--echo #
--echo # Valid values: EMPTY, EXPLICIT, FULL; binary round trip
--echo #

CREATE TABLE t1 (id INT, h HLL);
INSERT INTO t1 VALUES (1, 0x11);
INSERT INTO t1 VALUES (2, 0x1200000000000000010000000000000002);
INSERT INTO t1 VALUES (3, CONCAT(0x13, REPEAT(0x00, 12288)));
INSERT INTO t1 VALUES (4, CONCAT(0x13, 0x732000, REPEAT(0x00, 12284), 0xcc));
INSERT INTO t1 VALUES (5, NULL);
SELECT id, LENGTH(h), LEFT(HEX(h), 40) FROM t1 ORDER BY id;
SELECT id, MD5(h) FROM t1 ORDER BY id;

--echo #
--echo # Malformed values are rejected
--echo #

--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, '');
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x21);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x10);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x14);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x1100);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x12);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x1200000000000001);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x1200000000000000050000000000000005);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x1200000000000000060000000000000005);
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, CONCAT(0x13, REPEAT(0x00, 12287)));
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, CONCAT(0x13, 0x34, REPEAT(0x00, 12287)));
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 'text');
--error ER_WRONG_VALUE
UPDATE t1 SET h=0x21 WHERE id=1;

--echo # Non-strict mode does not turn the error into a warning
SET @save_sql_mode=@@sql_mode;
SET sql_mode='';
--error ER_WRONG_VALUE
INSERT INTO t1 VALUES (10, 0x21);
SET sql_mode=@save_sql_mode;
--echo # INSERT IGNORE does not turn the error into a warning either
--error ER_WRONG_VALUE
INSERT IGNORE INTO t1 VALUES (10, 0x21);
--error ER_WRONG_VALUE
INSERT IGNORE INTO t1 VALUES (10, 0x11), (11, 0x21);
SELECT COUNT(*) FROM t1 WHERE id IN (10, 11);
DELETE FROM t1 WHERE id IN (10, 11);

--echo # INSERT ... SELECT, LOAD DATA and ALTER from BLOB go through validation
CREATE TABLE t2 (id INT, b LONGBLOB);
INSERT INTO t2 VALUES (20, 0x11), (21, 0x21);
--error ER_WRONG_VALUE
INSERT INTO t1 SELECT * FROM t2;
INSERT INTO t1 SELECT * FROM t2 WHERE id=20;
--error ER_WRONG_VALUE
ALTER TABLE t2 MODIFY b HLL;
DELETE FROM t2 WHERE id=21;
ALTER TABLE t2 MODIFY b HLL;
SHOW CREATE TABLE t2;
DROP TABLE t2;

CREATE TABLE t2 (id INT, b LONGBLOB);
INSERT INTO t2 VALUES (30, 0x11), (31, 0x21);
--disable_query_log
eval SELECT * INTO OUTFILE '$MYSQLTEST_VARDIR/tmp/hll.txt' FROM t2;
--enable_query_log
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--error ER_WRONG_VALUE
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/tmp/hll.txt' INTO TABLE t1
--remove_file $MYSQLTEST_VARDIR/tmp/hll.txt
DROP TABLE t2;
--echo # MyISAM keeps rows written before the failing row; no invalid value is stored
SELECT id, HEX(h) FROM t1 WHERE id >= 10 ORDER BY id;

--echo #
--echo # CAST AS HLL
--echo #

SELECT HEX(CAST(0x11 AS HLL));
--error ER_WRONG_VALUE
SELECT CAST(0x21 AS HLL);
CREATE TABLE t2 AS SELECT CAST(0x11 AS HLL) AS c;
SHOW CREATE TABLE t2;
DROP TABLE t2;
EXPLAIN EXTENDED SELECT CAST(h AS HLL) FROM t1;

--echo #
--echo # Comparison and numeric operations are not supported
--echo #

--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT * FROM t1 WHERE h = h;
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT * FROM t1 WHERE h = 0x11;
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT * FROM t1 WHERE h < h;
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT h + 1 FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT -h FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT ABS(h) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT SUM(h) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST(h AS SIGNED) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT CAST(h AS DOUBLE) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT MAX(h) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT MIN(h) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT GREATEST(h, h) FROM t1;
SELECT h IS NULL FROM t1 ORDER BY id;

--echo #
--echo # CTAS, temporary, derived tables, views, prepared statements
--echo #

CREATE TABLE t2 AS SELECT * FROM t1;
SHOW CREATE TABLE t2;
SELECT id, MD5(h) FROM t2 ORDER BY id;
DROP TABLE t2;

CREATE TEMPORARY TABLE t2 AS SELECT * FROM t1;
SHOW CREATE TABLE t2;
SELECT id, MD5(h) FROM t2 ORDER BY id;
DROP TEMPORARY TABLE t2;

SELECT id, MD5(h) FROM (SELECT * FROM t1) d ORDER BY id;

CREATE VIEW v1 AS SELECT id, h FROM t1;
SELECT id, MD5(h) FROM v1 ORDER BY id;
CREATE TABLE t2 AS SELECT * FROM v1;
SHOW CREATE TABLE t2;
DROP TABLE t2;
DROP VIEW v1;

CREATE TABLE t2 AS SELECT COALESCE(h, h) AS c FROM t1;
SHOW CREATE TABLE t2;
DROP TABLE t2;

CREATE TABLE t2 AS SELECT h FROM t1 UNION ALL SELECT h FROM t1;
SHOW CREATE TABLE t2;
DROP TABLE t2;

PREPARE stmt FROM 'INSERT INTO t1 VALUES (?, ?)';
SET @v= 0x11;
EXECUTE stmt USING 40, @v;
EXECUTE stmt USING 41, @v;
SET @v= 0x21;
--error ER_WRONG_VALUE
EXECUTE stmt USING 42, @v;
DEALLOCATE PREPARE stmt;
SELECT id, HEX(h) FROM t1 WHERE id >= 40 ORDER BY id;

DROP TABLE t1;
