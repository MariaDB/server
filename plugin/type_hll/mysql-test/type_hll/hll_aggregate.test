--echo #
--echo # HLL_BUILD_AGG and HLL_UNION_AGG
--echo #

SET @save_max_recursive_iterations= @@max_recursive_iterations;
SET max_recursive_iterations= 1000000;

CREATE TABLE t1 (id INT, g INT, x INT, b VARBINARY(10));
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 1000)
  SELECT n, n % 4, n % 300, CAST(n % 7 AS BINARY) FROM s;
INSERT INTO t1 VALUES (1001, 0, NULL, NULL);

--echo # Empty and all-NULL input return HLL_EMPTY(), not NULL
SELECT HEX(HLL_BUILD_AGG(x)), HEX(HLL_UNION_AGG(CAST(NULL AS HLL)))
FROM t1 WHERE id < 0;
SELECT HEX(HLL_BUILD_AGG(x)) FROM t1 WHERE x IS NULL;

--echo # Exact EXPLICIT results up to 256, FULL above
SELECT g, HLL_CARDINALITY(HLL_BUILD_AGG(b)) AS c, HLL_INFO(HLL_BUILD_AGG(b))
FROM t1 GROUP BY g;
SELECT HLL_CARDINALITY(HLL_BUILD_AGG(x)) AS c300,
       HLL_INFO(HLL_BUILD_AGG(x)) AS i300,
       HLL_CARDINALITY(HLL_BUILD_AGG(IF(x < 256, x, NULL))) AS c256,
       HLL_INFO(HLL_BUILD_AGG(IF(x < 256, x, NULL))) AS i256,
       HLL_INFO(HLL_BUILD_AGG(IF(x < 257, x, NULL))) AS i257
FROM t1;

--echo # Full build equals the union of the parts (byte for byte)
SELECT MD5(HLL_BUILD_AGG(x)) = (SELECT MD5(HLL_UNION_AGG(h)) FROM
         (SELECT g, HLL_BUILD_AGG(x) AS h FROM t1 GROUP BY g) parts) AS eq_full,
       MD5(HLL_BUILD_AGG(IF(x < 100, x, NULL))) =
       (SELECT MD5(HLL_UNION_AGG(h)) FROM
         (SELECT g, HLL_BUILD_AGG(IF(x < 100, x, NULL)) AS h FROM t1
          GROUP BY g) parts) AS eq_explicit
FROM t1;

--echo # DISTINCT replay gives the same sketch
SELECT MD5(HLL_BUILD_AGG(DISTINCT x)) = MD5(HLL_BUILD_AGG(x)) AS same,
       MD5(HLL_BUILD_AGG(DISTINCT b)) = MD5(HLL_BUILD_AGG(b)) AS same_bin
FROM t1;
--error ER_NOT_SUPPORTED_YET
SELECT HLL_UNION_AGG(DISTINCT HLL_EMPTY()) FROM t1;

--echo # FILTER
SELECT HLL_CARDINALITY(HLL_BUILD_AGG(x) FILTER (WHERE g = 1)) AS c FROM t1;

--echo # GROUP BY, HAVING, ROLLUP, CTE, derived tables
SELECT g, HLL_CARDINALITY(HLL_BUILD_AGG(x)) AS c FROM t1
GROUP BY g HAVING HLL_CARDINALITY(HLL_BUILD_AGG(x)) > 70 ORDER BY g;
SELECT g, HLL_INFO(HLL_BUILD_AGG(b)) FROM t1 GROUP BY g WITH ROLLUP;
WITH c AS (SELECT g, HLL_BUILD_AGG(b) AS h FROM t1 GROUP BY g)
SELECT HLL_CARDINALITY(HLL_UNION_AGG(h)) FROM c;
SELECT HLL_CARDINALITY(HLL_UNION_AGG(h)) FROM
  (SELECT g, HLL_BUILD_AGG(b) AS h FROM t1 GROUP BY g) d;

--echo # CTAS / INSERT ... SELECT store real HLL values
CREATE TABLE t2 AS SELECT g, HLL_BUILD_AGG(x) AS h FROM t1 GROUP BY g;
SHOW CREATE TABLE t2;
INSERT INTO t2 SELECT 10, HLL_BUILD_AGG(b) FROM t1;
SELECT g, HLL_INFO(h) FROM t2 ORDER BY g;
SELECT HLL_CARDINALITY(HLL_UNION_AGG(h)) FROM t2 WHERE g < 10;
DROP TABLE t2;

--echo # Prepared statement re-execution
PREPARE s FROM 'SELECT HLL_CARDINALITY(HLL_BUILD_AGG(x)) FROM t1 WHERE g = ?';
EXECUTE s USING 1;
EXECUTE s USING 2;
EXECUTE s USING 2;
DEALLOCATE PREPARE s;

--echo # Window functions: running frames and moving frames via rescan
CREATE TABLE t2 (id INT, x INT);
INSERT INTO t2 SELECT id, x FROM t1 WHERE id <= 20;
INSERT INTO t2 VALUES (21, 1), (22, 1), (23, NULL);
SELECT id, x,
  HLL_CARDINALITY(HLL_BUILD_AGG(x) OVER (ORDER BY id)) AS running,
  (SELECT COUNT(DISTINCT x) FROM t2 b WHERE b.id <= a.id) AS running_expected,
  HLL_CARDINALITY(HLL_BUILD_AGG(x) OVER (ORDER BY id
    ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)) AS moving,
  (SELECT COUNT(DISTINCT x) FROM t2 b
   WHERE b.id BETWEEN a.id - 2 AND a.id) AS moving_expected
FROM t2 a ORDER BY id;
SELECT COUNT(*) AS mismatches FROM (
  SELECT id,
    MD5(HLL_BUILD_AGG(x) OVER (ORDER BY id
        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)) AS w,
    (SELECT MD5(HLL_BUILD_AGG(x)) FROM t2 b
     WHERE b.id BETWEEN a.id - 1 AND a.id + 1) AS e
  FROM t2 a) d WHERE w <> e;
--echo # Window over a grouped derived table (temporary table default record)
SELECT k, HLL_CARDINALITY(HLL_UNION_AGG(h) OVER ()) AS c FROM
  (SELECT id % 3 AS k, HLL_BUILD_AGG(x) AS h FROM t2 GROUP BY k) d ORDER BY k;
--error ER_NOT_SUPPORTED_YET
SELECT HLL_BUILD_AGG(DISTINCT x) OVER (ORDER BY id) FROM t2;
DROP TABLE t2;

--echo # Unsupported input types
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(1.5) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG('text') FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(CONCAT(x)) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(HLL_EMPTY()) FROM t1;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(POINT(1,1)) FROM t1;
CREATE TABLE t2 (e ENUM('a','b'), s SET('a'), j JSON, d DECIMAL(10,2), bt BIT(3));
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(e) FROM t2;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(s) FROM t2;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(j) FROM t2;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(d) FROM t2;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_BUILD_AGG(bt) FROM t2;
DROP TABLE t2;
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_UNION_AGG(x) FROM t1;
--echo # Binary bytes are accepted but validated
--error ER_WRONG_VALUE
SELECT HLL_UNION_AGG(b) FROM t1;
--echo # Text must be cast to a byte representation explicitly
SELECT HLL_CARDINALITY(HLL_BUILD_AGG(CAST(CONCAT('k', x) AS BINARY))) FROM t1;
DROP TABLE t1;

--echo #
--echo # Statistical accuracy (plan 13.5): fixed deterministic inputs,
--echo # relative error below 4 standard errors (4 * 0.8125%)
--echo #
CREATE TABLE t1 (n INT);
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 100000)
  SELECT n FROM s;
SELECT k, IF(k <= 256, HLL_CARDINALITY(HLL_BUILD_AGG(n)) = k, NULL) AS exact,
       ABS(HLL_CARDINALITY(HLL_BUILD_AGG(n)) - k) / k < 4 * 0.008125 AS within
FROM t1, (SELECT 10 AS k UNION SELECT 100 UNION SELECT 256 UNION SELECT 1000
          UNION SELECT 10000 UNION SELECT 30000 UNION SELECT 50000
          UNION SELECT 80000 UNION SELECT 100000) ks
WHERE n <= k GROUP BY k ORDER BY k;
DROP TABLE t1;

--echo #
--echo # HLL_UNION_AGG over stored sketches: FILTER, NULL sketches,
--echo # HAVING, ROLLUP, prepared statements, window frames
--echo #
CREATE TABLE t1 (n INT);
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 1000)
  SELECT n FROM s;
CREATE TABLE t2 (id INT, g INT, h HLL);
INSERT INTO t2
  SELECT n % 40 + 1, n % 4, HLL_BUILD_AGG(n % 300) FROM t1
  GROUP BY n % 40, n % 4;
INSERT INTO t2 VALUES (41, 0, NULL), (42, 1, NULL), (43, 5, NULL);
DROP TABLE t1;

--echo # FILTER equals WHERE (byte for byte), EXPLICIT and FULL results
SELECT MD5(HLL_UNION_AGG(h) FILTER (WHERE g = 1)) =
       (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 WHERE g = 1) AS eq_explicit,
       HLL_INFO(HLL_UNION_AGG(h) FILTER (WHERE g = 1)) AS i_explicit,
       MD5(HLL_UNION_AGG(h) FILTER (WHERE id <= 18)) =
       (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 WHERE id <= 18) AS eq_full,
       HLL_INFO(HLL_UNION_AGG(h) FILTER (WHERE id <= 18)) AS i_full
FROM t2;
--echo # FILTER rejecting all rows, or keeping only NULL sketches
SELECT HEX(HLL_UNION_AGG(h) FILTER (WHERE g > 100)) AS no_rows,
       HEX(HLL_UNION_AGG(h) FILTER (WHERE h IS NULL)) AS only_nulls
FROM t2;
--echo # FILTER per group
SELECT g, HLL_CARDINALITY(HLL_UNION_AGG(h) FILTER (WHERE id <= 10)) AS c,
       MD5(HLL_UNION_AGG(h) FILTER (WHERE id <= 10)) =
       (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 b
        WHERE b.g = a.g AND b.id <= 10) AS eq
FROM t2 a GROUP BY g ORDER BY g;

--echo # NULL sketches are ignored
SELECT MD5(HLL_UNION_AGG(h)) =
       (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 WHERE h IS NOT NULL) AS same
FROM t2;

--echo # HAVING and ROLLUP (group 5 holds only a NULL sketch)
SELECT g, HLL_CARDINALITY(HLL_UNION_AGG(h)) AS c FROM t2
GROUP BY g HAVING HLL_CARDINALITY(HLL_UNION_AGG(h)) > 0 ORDER BY g;
SELECT g, HLL_INFO(HLL_UNION_AGG(h)) FROM t2 GROUP BY g WITH ROLLUP;

--echo # Prepared statement re-execution
PREPARE s FROM
  'SELECT HLL_INFO(HLL_UNION_AGG(h) FILTER (WHERE id <= ?)) FROM t2';
EXECUTE s USING 4;
EXECUTE s USING 40;
EXECUTE s USING 4;
DEALLOCATE PREPARE s;

--echo # Window functions: running, moving and partitioned frames
SELECT COUNT(*) AS mismatches FROM (
  SELECT id,
    MD5(HLL_UNION_AGG(h) OVER (ORDER BY id)) AS running,
    (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 b
     WHERE b.id <= a.id) AS running_expected,
    MD5(HLL_UNION_AGG(h) OVER (ORDER BY id
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)) AS moving,
    (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 b
     WHERE b.id BETWEEN a.id - 2 AND a.id) AS moving_expected,
    MD5(HLL_UNION_AGG(h) OVER (ORDER BY id
        ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)) AS centered,
    (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 b
     WHERE b.id BETWEEN a.id - 1 AND a.id + 1) AS centered_expected,
    MD5(HLL_UNION_AGG(h) OVER (PARTITION BY g ORDER BY id)) AS part,
    (SELECT MD5(HLL_UNION_AGG(h)) FROM t2 b
     WHERE b.g = a.g AND b.id <= a.id) AS part_expected
  FROM t2 a) d
WHERE running <> running_expected OR moving <> moving_expected OR
      centered <> centered_expected OR part <> part_expected;
SELECT id, g, HLL_CARDINALITY(HLL_UNION_AGG(h) OVER (ORDER BY id
         ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) AS c
FROM t2 WHERE id > 36 ORDER BY id;
DROP TABLE t2;

SET max_recursive_iterations= @save_max_recursive_iterations;
