--echo #
--echo # Scalar HLL functions
--echo #

SELECT HEX(HLL_EMPTY()), HLL_CARDINALITY(HLL_EMPTY()),
       HLL_CARDINALITY_ROUND(HLL_EMPTY()), HLL_FORMAT_VERSION(HLL_EMPTY()),
       HLL_INFO(HLL_EMPTY());

SET @e= CAST(0x1200000000000000010000000000000002 AS HLL);
SET @f= CAST(CONCAT(0x13, 0x732000, REPEAT(0x00, 12284), 0xcc) AS HLL);
SELECT HLL_CARDINALITY(@e), HLL_INFO(@e), HLL_INFO(@f), HLL_FORMAT_VERSION(@f);

--echo # HLL_UNION
SELECT HEX(HLL_UNION(@e, CAST(0x120000000000000003 AS HLL))) AS u;
SELECT HEX(HLL_UNION(@e, @e)) = HEX(@e) AS idempotent;
SELECT HEX(HLL_UNION(@e, HLL_EMPTY())) = HEX(@e) AS identity;
SELECT HLL_INFO(HLL_UNION(@e, @f)) AS explicit_into_full;

--echo # NULL semantics
SELECT HLL_CARDINALITY(NULL), HLL_CARDINALITY_ROUND(NULL), HLL_UNION(NULL, @e),
       HLL_UNION(@e, NULL), HLL_FORMAT_VERSION(NULL), HLL_INFO(NULL);

--echo # HLL_CARDINALITY_ROUND: floor(estimate + 0.5), error when out of range
SELECT HLL_CARDINALITY(@f), HLL_CARDINALITY_ROUND(@f);
--echo # FULL with every register 51 estimates ~2.66e19 > 2^64-1
SET @max= CAST(CONCAT(0x13, REPEAT(0xF33CCF, 4096)) AS HLL);
SELECT HLL_INFO(@max), HLL_CARDINALITY(@max) > 18446744073709551615 AS above;
--error ER_DATA_OUT_OF_RANGE
SELECT HLL_CARDINALITY_ROUND(@max);

--echo # Result data types
CREATE TABLE t1 AS SELECT HLL_EMPTY() AS e, HLL_UNION(@e, @e) AS u,
  HLL_CARDINALITY(@e) AS c, HLL_CARDINALITY_ROUND(@e) AS cr,
  HLL_FORMAT_VERSION(@e) AS v, HLL_INFO(@e) AS i;
SHOW CREATE TABLE t1;
SELECT HEX(e), HEX(u), c, cr, v, i FROM t1;
DROP TABLE t1;

--echo # Arguments: HLL or binary bytes (validated); not numbers or text
SELECT HLL_CARDINALITY(0x11), HLL_CARDINALITY(CAST(0x11 AS HLL));
--error ER_WRONG_VALUE
SELECT HLL_INFO(CAST(1 AS BINARY));
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_CARDINALITY(1);
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_UNION(@e, 'abc');
--error ER_ILLEGAL_PARAMETER_DATA_TYPE_FOR_OPERATION
SELECT HLL_CARDINALITY(DATE'2020-01-01');
--echo # User variables hold HLL values as LONGBLOB
SELECT HLL_CARDINALITY(HLL_UNION(@e, @f)) > 2 AS from_variables;

--echo # Wrong argument count
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT HLL_EMPTY(1);
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT HLL_CARDINALITY();
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT HLL_UNION(@e);

--echo # Malformed and unknown-version values are rejected
--error ER_WRONG_VALUE
SELECT HLL_CARDINALITY(CAST(0x21 AS HLL));
--error ER_WRONG_VALUE
SELECT HLL_FORMAT_VERSION(CAST(0x1100 AS HLL));

--echo # Prepared statements
PREPARE s FROM 'SELECT HLL_CARDINALITY(HLL_UNION(?, ?))';
SET @a= CAST(0x120000000000000001 AS HLL), @b= CAST(0x120000000000000002 AS HLL);
EXECUTE s USING @a, @b;
EXECUTE s USING @a, @a;
DEALLOCATE PREPARE s;
