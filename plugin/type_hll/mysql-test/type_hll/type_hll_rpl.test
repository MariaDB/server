--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--echo #
--echo # Row-based replication round trip of HLL values
--echo #

CREATE TABLE t1 (id INT, h HLL);
INSERT INTO t1 VALUES (1, 0x11);
INSERT INTO t1 VALUES (2, 0x1200000000000000010000000000000002);
INSERT INTO t1 VALUES (3, CONCAT(0x13, 0x732000, REPEAT(0x00, 12284), 0xcc));
INSERT INTO t1 VALUES (4, NULL);
SELECT id, MD5(h) FROM t1 ORDER BY id;

--sync_slave_with_master
SHOW CREATE TABLE t1;
SELECT id, MD5(h) FROM t1 ORDER BY id;

--connection master
DROP TABLE t1;

--source include/rpl_end.inc
