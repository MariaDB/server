  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
# Local types: two associative arrays of the RECORD, then the RECORD variable
DECLARE
TYPE rec_t IS RECORD (a INT, v VARCHAR(5), s MEDIUMTEXT, t TEXT,
e ENUM('a','b','c'), st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
aa1 tab_t;
aa2 tab_t;
r rec_t;
BEGIN
r.a:= 1;
r.v:= 'abcde';
r.s:= RPAD('s', 32767, 's');
r.t:= RPAD('t', 40000, 't');
r.e:= 'b';
r.st:= 'x,y';
SELECT r.a, r.v, LENGTH(r.s) AS s_length, LENGTH(r.t) AS t_length, r.e, r.st;
CREATE TABLE t1 AS SELECT r.a AS a, r.v AS v, r.s AS s, r.t AS t,
r.e AS e, r.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
r.a	r.v	s_length	t_length	r.e	r.st
1	abcde	32767	40000	b	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "a" int(11) DEFAULT NULL,
  "v" varchar(5) DEFAULT NULL,
  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
# Local types: elements of the associative array
DECLARE
TYPE rec_t IS RECORD (a INT, v VARCHAR(5), s MEDIUMTEXT, t TEXT,
e ENUM('a','b','c'), st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
t tab_t;
r rec_t;
BEGIN
r.a:= 1;
r.s:= RPAD('s', 32767, 's');
r.t:= RPAD('t', 40000, 't');
t(1):= r;
r.a:= 2;
r.s:= RPAD('S', 40000, 'S');
t(2):= r;
SELECT t(1).a, LENGTH(t(1).s) AS s_length, LENGTH(t(1).t) AS t_length;
SELECT t(2).a, LENGTH(t(2).s) AS s_length, LENGTH(t(2).t) AS t_length;
END;
$$
t(1).a	s_length	t_length
1	32767	40000
t(2).a	s_length	t_length
2	40000	40000
# Local types in a stored procedure, called twice
CREATE PROCEDURE p1() AS
TYPE rec_t IS RECORD (a INT, v VARCHAR(5), s MEDIUMTEXT, t TEXT,
e ENUM('a','b','c'), st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
t tab_t;
r rec_t;
BEGIN
r.a:= 1;
r.v:= 'abcde';
r.s:= RPAD('s', 32767, 's');
r.t:= RPAD('t', 40000, 't');
r.e:= 'b';
r.st:= 'x,y';
SELECT r.a, r.v, LENGTH(r.s) AS s_length, LENGTH(r.t) AS t_length, r.e, r.st;
CREATE TABLE t1 AS SELECT r.a AS a, r.v AS v, r.s AS s, r.t AS t,
r.e AS e, r.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
CALL p1();
r.a	r.v	s_length	t_length	r.e	r.st
1	abcde	32767	40000	b	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "a" int(11) DEFAULT NULL,
  "v" varchar(5) DEFAULT NULL,
  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
CALL p1();
r.a	r.v	s_length	t_length	r.e	r.st
1	abcde	32767	40000	b	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "a" int(11) DEFAULT NULL,
  "v" varchar(5) DEFAULT NULL,
  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
DROP PROCEDURE p1;
#
# The types are declared in a package body and are shared by several
# routines of the package
#
CREATE PACKAGE pk1 AS
PROCEDURE p1;
PROCEDURE p2;
END;
$$
CREATE PACKAGE BODY pk1 AS
TYPE rec_t IS RECORD (s MEDIUMTEXT, st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
PROCEDURE p1 AS
t tab_t;
r rec_t;
BEGIN
r.s:= RPAD('s', 1000, 's');
r.st:= 'x,y';
t(1):= r;
SELECT LENGTH(t(1).s), t(1).st;
CREATE TABLE t1 AS SELECT r.s AS s, r.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
PROCEDURE p2 AS
t tab_t;
r rec_t;
BEGIN
r.s:= RPAD('s', 2000, 's');
r.st:= 'y';
t(1):= r;
SELECT LENGTH(t(1).s), t(1).st;
END;
END;
$$
CALL pk1.p1();
LENGTH(t(1).s)	t(1).st
1000	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "s" mediumtext DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
CALL pk1.p2();
LENGTH(t(1).s)	t(1).st
2000	y
CALL pk1.p1();
LENGTH(t(1).s)	t(1).st
1000	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "s" mediumtext DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
CALL pk1.p2();
LENGTH(t(1).s)	t(1).st
2000	y
DROP PACKAGE pk1;
