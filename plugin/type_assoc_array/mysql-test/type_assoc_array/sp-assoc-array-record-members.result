# Local types: a RECORD variable, an associative array, another RECORD variable
DECLARE
TYPE rec_t IS RECORD (a INT, v VARCHAR(5), s MEDIUMTEXT, t TEXT,
e ENUM('a','b','c'), st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
r1 rec_t;
t tab_t;
r2 rec_t;
BEGIN
r1.a:= 1;
r1.v:= 'abcde';
r1.s:= RPAD('s', 32767, 's');
r1.t:= RPAD('t', 40000, 't');
r1.e:= 'b';
r1.st:= 'x,y';
SELECT r1.a, r1.v, LENGTH(r1.s) AS s_length, LENGTH(r1.t) AS t_length, r1.e, r1.st;
CREATE TABLE t1 AS SELECT r1.a AS a, r1.v AS v, r1.s AS s, r1.t AS t,
r1.e AS e, r1.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
r2.a:= 1;
r2.v:= 'abcde';
r2.s:= RPAD('s', 32767, 's');
r2.t:= RPAD('t', 40000, 't');
r2.e:= 'b';
r2.st:= 'x,y';
SELECT r2.a, r2.v, LENGTH(r2.s) AS s_length, LENGTH(r2.t) AS t_length, r2.e, r2.st;
CREATE TABLE t1 AS SELECT r2.a AS a, r2.v AS v, r2.s AS s, r2.t AS t,
r2.e AS e, r2.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
r1.a	r1.v	s_length	t_length	r1.e	r1.st
1	abcde	32767	40000	b	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "a" int(11) DEFAULT NULL,
  "v" varchar(5) DEFAULT NULL,
  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
r2.a	r2.v	s_length	t_length	r2.e	r2.st
