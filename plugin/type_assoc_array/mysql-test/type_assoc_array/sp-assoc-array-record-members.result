#
# MDEV-41527 MEDIUMTEXT gets truncated to TINYTEXT in assoc array RECORD field
#
# A RECORD type is used by a variable and by an associative array
# variable (TABLE OF the RECORD). The members of the RECORD must have
# the same data types in any order of the declarations (earlier,
# MEDIUMTEXT and TEXT members were truncated to 255 characters
# after a variable of the associative array type was declared).
#
SET sql_mode=ORACLE;
# The minimal case: only a MEDIUMTEXT member, the types are declared
# locally in the block, the associative array is declared before
# the RECORD variable
DECLARE
TYPE rec_t IS RECORD (s MEDIUMTEXT);
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
t tab_t;
r rec_t;
BEGIN
r.s:= RPAD('s', 1000, 's');
SELECT LENGTH(r.s);
CREATE TABLE t1 AS SELECT r.s AS s;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
LENGTH(r.s)
1000
Table	Create Table
t1	CREATE TABLE "t1" (
  "s" mediumtext DEFAULT NULL
)
# The minimal case with a SET member (earlier, the server crashed
# with an assertion failure in store_lowendian())
DECLARE
TYPE rec_t IS RECORD (st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
t tab_t;
r rec_t;
BEGIN
r.st:= 'x,y';
SELECT r.st;
CREATE TABLE t1 AS SELECT r.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
r.st
x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "st" varchar(3) DEFAULT NULL
)
#
# The associative array and the RECORD variables of the same RECORD type
# in various orders of the declarations, all members of the RECORD
#
# Local types: only the RECORD type
DECLARE
TYPE rec_t IS RECORD (a INT, v VARCHAR(5), s MEDIUMTEXT, t TEXT,
e ENUM('a','b','c'), st SET('x','y'));
TYPE tab_t IS TABLE OF rec_t INDEX BY INTEGER;
r rec_t;
BEGIN
r.a:= 1;
r.v:= 'abcde';
r.s:= RPAD('s', 32767, 's');
r.t:= RPAD('t', 40000, 't');
r.e:= 'b';
r.st:= 'x,y';
SELECT r.a, r.v, LENGTH(r.s) AS s_length, LENGTH(r.t) AS t_length, r.e, r.st;
CREATE TABLE t1 AS SELECT r.a AS a, r.v AS v, r.s AS s, r.t AS t,
r.e AS e, r.st AS st;
SHOW CREATE TABLE t1;
DROP TABLE t1;
END;
$$
r.a	r.v	s_length	t_length	r.e	r.st
1	abcde	32767	40000	b	x,y
Table	Create Table
t1	CREATE TABLE "t1" (
  "a" int(11) DEFAULT NULL,
  "v" varchar(5) DEFAULT NULL,
  "s" mediumtext DEFAULT NULL,
  "t" text DEFAULT NULL,
  "e" varchar(1) DEFAULT NULL,
  "st" varchar(3) DEFAULT NULL
)
