# MDEV-24557 mariadb-dump: import MySQL 8.x users, grants, roles: grants
#
# Imports mysql8_users_dump.sql, a dump of MySQL 26.7.0, and checks grants and identifier handling.
# Recapture it after changing the MySQL-source code (recipe in
# std_data/mysql8_users_setup.sql).
SET NAMES utf8mb4;
CREATE DATABASE IF NOT EXISTS m8_db;
CREATE TABLE m8_db.tab (col_a INT, col_underscore_b INT, plain INT);
CREATE TABLE m8_db.tab2 (id INT PRIMARY KEY, payload TEXT);
USE m8_db;
CREATE PROCEDURE proc_one(IN x INT) BEGIN SELECT x; END$$
CREATE FUNCTION  func_one(x INT) RETURNS INT DETERMINISTIC BEGIN RETURN x*2; END$$
USE test;
CREATE DATABASE IF NOT EXISTS `m8_under_score_db`;
CALL mtr.add_suppression('failed to read private_key.pem: 2 "No such file or directory"');
CALL mtr.add_suppression("Plugin 'caching_sha2_password' is of maturity level gamma");
CREATE USER m8_restore IDENTIFIED BY 'r';
GRANT ALL ON *.* TO m8_restore WITH GRANT OPTION;
GRANT PROXY ON ''@'%' TO m8_restore WITH GRANT OPTION;
NOT FOUND /(?:\A|\n)ERROR (?!1396 )\d/ in m8_import.err
NOT FOUND /(?:\A|\n)ERROR 1396 (?![^\n]*'root'@'localhost')/ in m8_import.err
FOUND 1 /sql_mode restored/ in m8_import.out
# The import role is gone and the restoring user is not left as admin:
SELECT User, Role FROM mysql.roles_mapping
WHERE User='m8_restore' OR Role='mariadb_dump_import_role';
User	Role
DROP USER m8_restore;
# 1. Every m8_* user landed.
SELECT user, host FROM mysql.global_priv WHERE user LIKE 'm8\\_%' ORDER BY user, host;
user	host
m8_admin_chain_root	
m8_all_privs	%
m8_auth_caching_sha2	%
m8_auth_no_pwd	%
m8_auth_sha256	%
m8_col_priv	%
m8_combined	%
m8_db_underscore	%
m8_default_a	
m8_default_b	
m8_default_role_many	%
m8_default_role_one	%
m8_dual_member	%
m8_dumper	%
m8_dyn_all_dropped	%
m8_dyn_flush_collapse	%
m8_dyn_grant_opt	%
m8_dyn_mapped	%
m8_dyn_mixed	%
m8_dyn_unmapped	%
m8_edge@in_name	%
m8_edge_wildcard_host	192.168.%.%
m8_failed_login	%
m8_func_exec	%
m8_host_dual	%
m8_host_dual	localhost
m8_host_localhost	localhost
m8_hybrid	
m8_hybrid	%
m8_hybrid_member	%
m8_lock	%
m8_max_conn	%
m8_multiscope	%
m8_partial_revoke	%
m8_proc_exec	%
m8_proxy_target	%
m8_proxy_user	%
m8_pwd_expire_default	%
m8_pwd_expire_interval	%
m8_pwd_expire_never	%
m8_pwd_expire_now	%
m8_pwd_history	%
m8_pwd_require_current	%
m8_pwd_reuse	%
m8_require_cipher	%
m8_require_ssl	%
m8_require_x509	%
m8_resource_full	%
m8_role*/starslash	
m8_role_a	
m8_role_b	
m8_role_c	
m8_role_d	
m8_role_dual	
m8_role_static	%
m8_routine_admin	%
m8_shared_role	
m8_shared_user_1	%
m8_shared_user_2	%
m8_shared_user_3	%
m8_shared_user_4	%
m8_shared_user_5	%
m8_simple	%
m8_starslash_comment	%
m8_starslash_escaped	%
m8_static_dyn_mix	%
m8_static_priv	%
m8_static_role_mix	%
m8_system_grants	%
m8_unlock	%
m8_usage_only	%
m8_with_attribute	%
m8_with_comment	%
m8_用户	%
# 2. Simple static grants pass through unchanged.
SHOW GRANTS FOR 'm8_simple'@'%';
Grants for m8_simple@%
GRANT `m8_role_a` TO `m8_simple`@`%` WITH ADMIN OPTION
GRANT `m8_role_d` TO `m8_simple`@`%`
GRANT USAGE ON *.* TO `m8_simple`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_simple`@`%`
SHOW GRANTS FOR 'm8_static_priv'@'%';
Grants for m8_static_priv@%
GRANT RELOAD, PROCESS ON *.* TO `m8_static_priv`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT, INSERT, UPDATE, DELETE ON `m8_db`.* TO `m8_static_priv`@`%`
# 3. Dynamic priv mapping (BINLOG_ADMIN -> BINLOG REPLAY/ADMIN).
SHOW GRANTS FOR 'm8_dyn_mapped'@'%';
Grants for m8_dyn_mapped@%
GRANT BINLOG ADMIN, BINLOG REPLAY ON *.* TO `m8_dyn_mapped`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 4. Mixed dynamic priv (some mapped, some not).
SHOW GRANTS FOR 'm8_dyn_mixed'@'%';
Grants for m8_dyn_mixed@%
GRANT CONNECTION ADMIN, BINLOG ADMIN, BINLOG REPLAY, SHOW CREATE ROUTINE ON *.* TO `m8_dyn_mixed`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 5. WITH GRANT OPTION of a translated dynamic privilege is dropped.
SHOW GRANTS FOR 'm8_dyn_grant_opt'@'%';
Grants for m8_dyn_grant_opt@%
GRANT CONNECTION ADMIN, BINLOG ADMIN, BINLOG REPLAY ON *.* TO `m8_dyn_grant_opt`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 6. CREATE ROLE / DROP ROLE static privs dropped.
SHOW GRANTS FOR 'm8_role_static'@'%';
Grants for m8_role_static@%
GRANT USAGE ON *.* TO `m8_role_static`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
SHOW GRANTS FOR 'm8_static_role_mix'@'%';
Grants for m8_static_role_mix@%
GRANT SELECT, INSERT ON *.* TO `m8_static_role_mix`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 7. Identifier parsing: column / db underscores don't false-positive.
SHOW GRANTS FOR 'm8_col_priv'@'%';
Grants for m8_col_priv@%
GRANT USAGE ON *.* TO `m8_col_priv`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT (`col_underscore_b`, `col_a`), UPDATE (`col_a`) ON `m8_db`.`tab` TO `m8_col_priv`@`%`
SHOW GRANTS FOR 'm8_db_underscore'@'%';
Grants for m8_db_underscore@%
GRANT USAGE ON *.* TO `m8_db_underscore`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_under_score_db`.* TO `m8_db_underscore`@`%`
# 8. Identifier parsing: edge-case usernames and hostnames.
SELECT user, host FROM mysql.global_priv
WHERE user IN ('m8 edge space','m8_edge@in_name','m8_edge_wildcard_host')
ORDER BY user, host;
user	host
m8 edge space	%
m8_edge@in_name	%
m8_edge_wildcard_host	192.168.%.%
SHOW GRANTS FOR 'm8_edge_wildcard_host'@'192.168.%.%';
Grants for m8_edge_wildcard_host@192.168.%.%
GRANT USAGE ON *.* TO `m8_edge_wildcard_host`@`192.168.%.%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_edge_wildcard_host`@`192.168.%.%`
# 9. ALL PRIVILEGES expands and survives import.
SHOW GRANTS FOR 'm8_all_privs'@'%';
Grants for m8_all_privs@%
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, SHUTDOWN, PROCESS, FILE, REFERENCES, INDEX, ALTER, SHOW DATABASES, SUPER, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, BINLOG MONITOR, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER, CREATE TABLESPACE, SET USER, CONNECTION ADMIN, REPLICATION SLAVE ADMIN, BINLOG ADMIN, BINLOG REPLAY, SHOW CREATE ROUTINE ON *.* TO `m8_all_privs`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>' WITH GRANT OPTION
# 10. Multi-scope grants for one user.
SHOW GRANTS FOR 'm8_multiscope'@'%';
Grants for m8_multiscope@%
GRANT PROCESS ON *.* TO `m8_multiscope`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_multiscope`@`%`
GRANT INSERT, UPDATE ON `m8_db`.`tab` TO `m8_multiscope`@`%`
# 11. Routine privileges land in mysql.procs_priv.
SELECT User, Host, Db, Routine_name, Routine_type, Proc_priv
FROM mysql.procs_priv
WHERE User LIKE 'm8\\_%'
  ORDER BY User, Host, Routine_type, Routine_name;
User	Host	Db	Routine_name	Routine_type	Proc_priv
m8_func_exec	%	m8_db	func_one	FUNCTION	Execute
m8_proc_exec	%	m8_db	proc_one	PROCEDURE	Execute
m8_shared_role		m8_db	proc_one	PROCEDURE	Execute
SHOW GRANTS FOR 'm8_routine_admin'@'%';
Grants for m8_routine_admin@%
GRANT USAGE ON *.* TO `m8_routine_admin`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT EXECUTE, CREATE ROUTINE, ALTER ROUTINE ON `m8_db`.* TO `m8_routine_admin`@`%`
# 12. PROXY grant lands in mysql.proxies_priv.
SELECT User, Host, Proxied_user, Proxied_host
FROM mysql.proxies_priv
WHERE User='m8_proxy_user'
  ORDER BY User, Host;
User	Host	Proxied_user	Proxied_host
m8_proxy_user	%	m8_proxy_target	%
# 13. USAGE-only user lands with the implicit GRANT USAGE.
SHOW GRANTS FOR 'm8_usage_only'@'%';
Grants for m8_usage_only@%
GRANT USAGE ON *.* TO `m8_usage_only`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 14. System-schema grants (mysql.user, performance_schema.*).
SHOW GRANTS FOR 'm8_system_grants'@'%';
Grants for m8_system_grants@%
GRANT USAGE ON *.* TO `m8_system_grants`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `performance_schema`.* TO `m8_system_grants`@`%`
GRANT SELECT ON `mysql`.`user` TO `m8_system_grants`@`%`
# 15. Same-name-different-host coverage.
SELECT User, Host FROM mysql.global_priv
WHERE User IN ('m8_host_localhost','m8_host_dual')
ORDER BY User, Host;
User	Host
m8_host_dual	%
m8_host_dual	localhost
m8_host_localhost	localhost
SHOW GRANTS FOR 'm8_host_localhost'@'localhost';
Grants for m8_host_localhost@localhost
GRANT USAGE ON *.* TO `m8_host_localhost`@`localhost` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_host_localhost`@`localhost`
SHOW GRANTS FOR 'm8_host_dual'@'localhost';
Grants for m8_host_dual@localhost
GRANT USAGE ON *.* TO `m8_host_dual`@`localhost` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_host_dual`@`localhost`
SHOW GRANTS FOR 'm8_host_dual'@'%';
Grants for m8_host_dual@%
GRANT USAGE ON *.* TO `m8_host_dual`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.`tab2` TO `m8_host_dual`@`%`
# 16. Identifier edge cases: anonymous + embedded quote + UTF-8.
# ORDER BY BINARY for collation-stable byte-level ordering across
# servers running different default collations.
SELECT User, Host FROM mysql.global_priv
WHERE User='' OR User='O\'Brien' OR User='m8_用户'
  ORDER BY BINARY User, Host;
User	Host
	%
	localhost
O'Brien	%
m8_用户	%
SHOW GRANTS FOR 'O\'Brien'@'%';
Grants for O'Brien@%
GRANT USAGE ON *.* TO `O'Brien`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `O'Brien`@`%`
SHOW GRANTS FOR 'm8_用户'@'%';
Grants for m8_用户@%
GRANT USAGE ON *.* TO `m8_用户`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `m8_db`.* TO `m8_用户`@`%`
# 17. Partial REVOKE. m8_partial_revoke has a wide GRANT on *.* and a
#     partial REVOKE on m8_db.*. MariaDB has no equivalent, so only the
#     wide GRANT lands (the dump carries a # WARNING for the REVOKE).
SHOW GRANTS FOR 'm8_partial_revoke'@'%';
Grants for m8_partial_revoke@%
GRANT SELECT, INSERT ON *.* TO `m8_partial_revoke`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
DROP USER ''@'localhost';
ALTER USER 'm8_col_priv'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
ALTER USER 'm8_role_static'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
ALTER USER 'm8_proc_exec'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
# m8_col_priv: SELECT/UPDATE on granted columns; non-granted denied.
connect  c_col, localhost, m8_col_priv, pw, m8_db;
SELECT col_a, col_underscore_b FROM m8_db.tab;
col_a	col_underscore_b
SELECT plain FROM m8_db.tab;
ERROR 42000: SELECT command denied to user 'm8_col_priv'@'localhost' for column 'plain' in table 'tab'
UPDATE m8_db.tab SET col_a = 1 WHERE col_a IS NULL OR col_a IS NOT NULL;
UPDATE m8_db.tab SET plain = 1;
ERROR 42000: UPDATE command denied to user 'm8_col_priv'@'localhost' for column 'plain' in table 'tab'
disconnect c_col;
connection default;
# m8_role_static landed with USAGE only -> CREATE/DROP ROLE denied.
connect  c_rs, localhost, m8_role_static, pw;
CREATE ROLE m8_should_fail_role;
ERROR 42000: Access denied; you need (at least one of) the CREATE USER privilege(s) for this operation
DROP ROLE IF EXISTS m8_role_a;
ERROR 42000: Access denied; you need (at least one of) the CREATE USER privilege(s) for this operation
disconnect c_rs;
connection default;
# m8_proc_exec: EXECUTE works; DROP PROCEDURE denied.
connect  c_proc, localhost, m8_proc_exec, pw, m8_db;
CALL m8_db.proc_one(42);
x
42
DROP PROCEDURE m8_db.proc_one;
ERROR 42000: alter routine command denied to user 'm8_proc_exec'@'%' for routine 'm8_db.proc_one'
disconnect c_proc;
connection default;
DROP DATABASE IF EXISTS m8_db;
DROP DATABASE IF EXISTS `m8_under_score_db`;
# End of 13.1 tests
