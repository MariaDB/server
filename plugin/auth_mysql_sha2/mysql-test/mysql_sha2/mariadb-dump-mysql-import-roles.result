# MDEV-24557 mariadb-dump: import MySQL 5.7+ users, grants, roles: roles
#
# Imports mysql_users_dump.sql, a dump of MySQL 26.7.0, and checks the roles, default roles and hybrid accounts.
# Recapture it after changing the MySQL-source code (recipe in
# std_data/mysql_users_setup.sql).
SET NAMES utf8mb4;
CREATE DATABASE src_db;
CREATE TABLE src_db.tab (col_a INT, col_underscore_b INT, plain INT);
CREATE TABLE src_db.tab2 (id INT PRIMARY KEY, payload TEXT);
USE src_db;
CREATE PROCEDURE proc_one(IN x INT) BEGIN SELECT x; END$$
CREATE FUNCTION  func_one(x INT) RETURNS INT DETERMINISTIC BEGIN RETURN x*2; END$$
USE test;
CREATE DATABASE `src_under_score_db`;
CALL mtr.add_suppression('failed to read private_key.pem: 2 "No such file or directory"');
CALL mtr.add_suppression("Plugin 'caching_sha2_password' is of maturity level gamma");
CREATE USER test_restore IDENTIFIED BY 'r';
GRANT ALL ON *.* TO test_restore WITH GRANT OPTION;
GRANT PROXY ON ''@'%' TO test_restore WITH GRANT OPTION;
NOT FOUND /(?:\A|\n)ERROR (?!1396 )\d/ in src_import.err
NOT FOUND /(?:\A|\n)ERROR 1396 (?![^\n]*'root'@'localhost')/ in src_import.err
FOUND 1 /sql_mode restored/ in src_import.out
# The import role is gone and the restoring user is not left as admin:
SELECT User, Role FROM mysql.roles_mapping
WHERE User='test_restore' OR Role='mariadb_dump_import_role';
User	Role
DROP USER test_restore;
# 1. Roles imported with admin chain preserved.
SELECT User, Host, Role, Admin_option FROM mysql.roles_mapping
WHERE Role LIKE 'src\\_%' OR User LIKE 'src\\_%'
  ORDER BY Role, User, Host;
User	Host	Role	Admin_option
src_name_member	%	Public_0001	N
src_name_member	%	Public_0001_0002	N
src_name_member	%	none_0003	N
src_combined	%	src_default_a	N
src_default_role_many	%	src_default_a	N
src_default_role_many_default_roles		src_default_a	N
src_default_role_one	%	src_default_a	N
src_shared_user_1	%	src_default_a	N
src_shared_user_2	%	src_default_a	N
src_default_role_many	%	src_default_b	N
src_default_role_many_default_roles		src_default_b	N
src_default_role_many	%	src_default_role_many_default_roles	N
src_hybrid_member	%	src_hybrid	N
src_admin_chain_root	%	src_role_a	Y
src_simple	%	src_role_a	Y
src_role_a		src_role_b	Y
src_hybrid		src_role_c	N
src_hybrid	%	src_role_c	N
src_role_b		src_role_c	Y
src_simple	%	src_role_d	N
src_dflt_member	%	src_role_dflt_one	N
src_dflt_member	%	src_role_dflt_two	N
src_role_dflt_one		src_role_dflt_x	N
src_role_dflt_two		src_role_dflt_x	N
src_role_dflt_two		src_role_dflt_y	N
src_dual_member	%	src_role_dual_0004	N
src_dual_member	%	src_role_dual_0005	N
PUBLIC		src_role_mandatory	N
src_shared_user_1	%	src_shared_role	N
src_shared_user_2	%	src_shared_role	Y
src_shared_user_3	%	src_shared_role	N
src_shared_user_4	%	src_shared_role	N
src_shared_user_5	%	src_shared_role	Y
# 1a. Role privileges land on the role
SHOW GRANTS FOR src_role_a;
Grants for src_role_a
GRANT `src_role_b` TO `src_role_a` WITH ADMIN OPTION
GRANT USAGE ON *.* TO `src_role_a`
GRANT SELECT ON `src_db`.* TO `src_role_a`
GRANT `src_role_c` TO `src_role_b` WITH ADMIN OPTION
GRANT USAGE ON *.* TO `src_role_b`
GRANT INSERT ON `src_db`.* TO `src_role_b`
GRANT USAGE ON *.* TO `src_role_c`
GRANT UPDATE ON `src_db`.* TO `src_role_c`
SELECT User, Host FROM mysql.global_priv
WHERE User LIKE 'src\\_role\\_%' OR User LIKE 'src\\_role*/%' ORDER BY User, Host;
User	Host
src_role*/starslash	%
src_role_a	
src_role_a	%
src_role_b	
src_role_b	%
src_role_c	
src_role_c	%
src_role_d	
src_role_d	%
src_role_dflt_one	
src_role_dflt_one	%
src_role_dflt_two	
src_role_dflt_two	%
src_role_dflt_x	
src_role_dflt_x	%
src_role_dflt_y	
src_role_dflt_y	%
src_role_dual	h1
src_role_dual	h2
src_role_dual_0004	
src_role_dual_0005	
src_role_mandatory	
src_role_mandatory	%
src_role_static	%
# 2. Default-role assignment.
SELECT User, Host, default_role
FROM mysql.user
WHERE User IN ('src_default_role_one','src_default_role_many','src_combined')
AND default_role <> ''
  ORDER BY User, Host;
User	Host	default_role
src_combined	%	src_default_a
src_default_role_many	%	src_default_role_many_default_roles
src_default_role_one	%	src_default_a
# 3. Hybrid account (a login user that is also granted as a role): it
#     lands as a user and as a role. The role holds its privileges and
#     role membership, the user has the privileges too. The role is not
#     its default role: a role granted to it is inactive until enabled.
SELECT User, Host, is_role FROM mysql.user
WHERE User LIKE 'src\\_hybrid%' ORDER BY User, Host;
User	Host	is_role
src_hybrid		Y
src_hybrid	%	N
src_hybrid_member	%	N
SHOW GRANTS FOR 'src_hybrid'@'%';
Grants for src_hybrid@%
GRANT `src_role_c` TO `src_hybrid`@`%`
GRANT USAGE ON *.* TO `src_hybrid`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
GRANT SELECT ON `src_db`.`tab` TO `src_hybrid`@`%`
SHOW GRANTS FOR src_hybrid;
Grants for src_hybrid
GRANT `src_role_c` TO `src_hybrid`
GRANT USAGE ON *.* TO `src_hybrid`
GRANT SELECT ON `src_db`.`tab` TO `src_hybrid`
GRANT USAGE ON *.* TO `src_role_c`
GRANT UPDATE ON `src_db`.* TO `src_role_c`
SHOW GRANTS FOR 'src_hybrid_member'@'%';
Grants for src_hybrid_member@%
GRANT `src_hybrid` TO `src_hybrid_member`@`%`
GRANT USAGE ON *.* TO `src_hybrid_member`@`%` IDENTIFIED VIA caching_sha2_password USING '<hash>'
# 4. One role name on two MySQL hosts lands as two roles, each holding
#     its host's privileges, and the accounts as users. The member gets both.
SELECT User, Host, is_role FROM mysql.user WHERE User LIKE 'src\\_role\\_dual%'
  ORDER BY User, Host;
User	Host	is_role
src_role_dual	h1	N
src_role_dual	h2	N
src_role_dual_0004		Y
src_role_dual_0005		Y
SHOW GRANTS FOR src_role_dual_0004;
Grants for src_role_dual_0004
GRANT USAGE ON *.* TO `src_role_dual_0004`
GRANT SELECT ON `src_db`.`tab` TO `src_role_dual_0004`
SHOW GRANTS FOR src_role_dual_0005;
Grants for src_role_dual_0005
GRANT USAGE ON *.* TO `src_role_dual_0005`
GRANT INSERT ON `src_db`.`tab` TO `src_role_dual_0005`
SELECT User, Host, Role FROM mysql.roles_mapping WHERE Role LIKE 'src\\_role\\_dual%'
  ORDER BY Role, User, Host;
User	Host	Role
src_dual_member	%	src_role_dual_0004
src_dual_member	%	src_role_dual_0005
# 5. Several default roles are granted to a role of their own, which is
#     the default role of the user.
SELECT User, Host, Role FROM mysql.roles_mapping
WHERE User='src_default_role_many_default_roles' OR Role='src_default_role_many_default_roles'
  ORDER BY Role, User, Host;
User	Host	Role
src_default_role_many_default_roles		src_default_a
src_default_role_many_default_roles		src_default_b
src_default_role_many	%	src_default_role_many_default_roles
# 6. A mandatory role is granted to PUBLIC.
SELECT User, Host, Role FROM mysql.roles_mapping WHERE Role='src_role_mandatory';
User	Host	Role
PUBLIC		src_role_mandatory
# 7. Role accounts land locked, with no default role.
SELECT User, Host, JSON_VALUE(Priv, '$.account_locked') AS account_locked,
JSON_VALUE(Priv, '$.default_role') AS default_role
FROM mysql.global_priv
WHERE User IN ('src_role_a', 'src_role_b', 'src_role_c') AND Host='%'
  ORDER BY User, Host;
User	Host	account_locked	default_role
src_role_a	%	1	NULL
src_role_b	%	1	NULL
src_role_c	%	1	NULL
# 7a. The default roles of a role account are not dumped: it has none,
#      and several get no role of their own. Its own role grants stay.
SELECT User, Host, JSON_VALUE(Priv, '$.default_role') AS default_role
FROM mysql.global_priv
WHERE User IN ('src_role_dflt_one', 'src_role_dflt_two') AND Host='%'
  ORDER BY User, Host;
User	Host	default_role
src_role_dflt_one	%	NULL
src_role_dflt_two	%	NULL
SELECT User, Role FROM mysql.roles_mapping
WHERE User LIKE 'src\\_role\\_dflt\\_%' OR Role LIKE 'src\\_role\\_dflt\\_%'
  ORDER BY User, Role;
User	Role
src_dflt_member	src_role_dflt_one
src_dflt_member	src_role_dflt_two
src_role_dflt_one	src_role_dflt_x
src_role_dflt_two	src_role_dflt_x
src_role_dflt_two	src_role_dflt_y
# 8. Role names MariaDB cannot use are renamed: PUBLIC and NONE in any
#    letter case, and a name taken by an earlier rename. Privileges and
#    the member follow.
SELECT User, Host, Role FROM mysql.roles_mapping WHERE User='src_name_member'
  ORDER BY Role;
User	Host	Role
src_name_member	%	Public_0001
src_name_member	%	Public_0001_0002
src_name_member	%	none_0003
SHOW GRANTS FOR Public_0001;
Grants for Public_0001
GRANT USAGE ON *.* TO `Public_0001`
GRANT INSERT ON `src_db`.`tab2` TO `Public_0001`
SHOW GRANTS FOR Public_0001_0002;
Grants for Public_0001_0002
GRANT USAGE ON *.* TO `Public_0001_0002`
GRANT DELETE ON `src_db`.`tab2` TO `Public_0001_0002`
SHOW GRANTS FOR none_0003;
Grants for none_0003
GRANT USAGE ON *.* TO `none_0003`
GRANT UPDATE ON `src_db`.`tab2` TO `none_0003`
DROP USER ''@'localhost';
ALTER USER 'src_simple'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
ALTER USER 'src_hybrid'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
ALTER USER 'src_hybrid_member'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('pw');
#  src_simple: schema SELECT works; INSERT denied until src_role_a, which
#  reaches INSERT through src_role_b, is enabled.
connect  c_simple, localhost, src_simple, pw, src_db;
SELECT COUNT(*) AS rows_visible FROM src_db.tab;
rows_visible
0
INSERT INTO src_db.tab VALUES (1,1,1);
ERROR 42000: INSERT command denied to user 'src_simple'@'localhost' for table `src_db`.`tab`
SET ROLE src_role_a;
INSERT INTO src_db.tab VALUES (1,1,1);
SELECT COUNT(*) AS rows_via_role FROM src_db.tab;
rows_via_role
1
disconnect c_simple;
connection default;
DELETE FROM src_db.tab;
# src_admin_chain_root: WITH ADMIN OPTION on src_role_a is preserved.
SELECT User, Host, Admin_option
FROM mysql.roles_mapping
WHERE User='src_admin_chain_root' AND Role='src_role_a';
User	Host	Admin_option
src_admin_chain_root	%	Y
# src_hybrid: has its own privileges, and those of src_role_c once enabled;
# src_hybrid_member gets them through the role.
INSERT INTO src_db.tab VALUES (1,1,1);
connect  c_hyb, localhost, src_hybrid, pw, src_db;
SELECT COUNT(*) AS rows_as_user FROM src_db.tab;
rows_as_user
1
SELECT CURRENT_ROLE();
CURRENT_ROLE()
NULL
UPDATE src_db.tab SET plain=2;
ERROR 42000: UPDATE command denied to user 'src_hybrid'@'localhost' for table `src_db`.`tab`
SET ROLE src_role_c;
UPDATE src_db.tab SET plain=2;
disconnect c_hyb;
connect  c_hm, localhost, src_hybrid_member, pw;
SELECT COUNT(*) FROM src_db.tab;
ERROR 42000: SELECT command denied to user 'src_hybrid_member'@'localhost' for table `src_db`.`tab`
SET ROLE src_hybrid;
SELECT COUNT(*) AS rows_via_role FROM src_db.tab;
rows_via_role
1
UPDATE src_db.tab SET plain=2;
disconnect c_hm;
connection default;
DELETE FROM src_db.tab;
DROP DATABASE src_db;
DROP DATABASE `src_under_score_db`;
# End of 13.1 tests
