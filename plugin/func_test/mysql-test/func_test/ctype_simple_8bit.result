#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SELECT full_collation_name AS name,
collation_tailoring(full_collation_name, 'ascii_alnum') AS alnum,
collation_tailoring(full_collation_name, 'ascii_ident') AS ident,
collation_tailoring(full_collation_name, 'ascii') AS ascii,
'---' AS `---`
FROM INFORMATION_SCHEMA.CHARACTER_SETS AS cs,
INFORMATION_SCHEMA.COLLATION_CHARACTER_SET_APPLICABILITY AS cl
WHERE
cs.character_set_name=cl.character_set_name
AND cs.maxlen=1
AND cs.character_set_name<>'tis620'
  AND cl.collation_name NOT IN
('latin2_czech_cs','cp1250_czech_cs')
ORDER BY cs.character_set_name, cl.collation_name LIKE '%_ci', collation_name;
name	armscii8_bin
alnum	[EMPTY][20]<[DIGITS]<[UPPER]<[LOWER]
ident	[EMPTY][20]<[DIGITS][UPPER]<_<[LOWER]
ascii	ASCII_PAD_BIN
