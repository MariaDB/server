minus_dot_digits	[version 14.0.0]-<.<[digit7]
alnum	[digit7]<[letter7_cs3_LowerFirst]
ident	_<[digit7]<[letter7_cs3_LowerFirst]
ascii	[version 14.0.0]ascii7_uca_cs
