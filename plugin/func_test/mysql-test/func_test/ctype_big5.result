#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET @character_set_name='big5';
SELECT
full_collation_name AS name,
collation_tailoring(full_collation_name, 'none') AS none,
collation_tailoring(full_collation_name, 'ascii_digits') AS digits,
collation_tailoring(full_collation_name, 'ascii_minus_dot_digits') AS minus_dot_digits,
collation_tailoring(full_collation_name, 'ascii_alnum') AS alnum,
collation_tailoring(full_collation_name, 'ascii_ident') AS ident,
collation_tailoring(full_collation_name, 'ascii') AS ascii,
'---' AS `---`
FROM INFORMATION_SCHEMA.COLLATION_CHARACTER_SET_APPLICABILITY
WHERE character_set_name=@character_set_name
ORDER BY collation_name LIKE '%_ci', collation_name;
name	big5_bin
none	
digits	[digit7]
minus_dot_digits	-<.<[digit7]
alnum	[digit7]<[upper7]<[lower7]
ident	[digit7]<[upper7]<_<[lower7]
ascii	ascii7_bin
---	---
name	big5_nopad_bin
none	[nopad]
digits	[nopad][digit7]
minus_dot_digits	[nopad]-<.<[digit7]
alnum	[nopad][digit7]<[upper7]<[lower7]
ident	[nopad][digit7]<[upper7]<_<[lower7]
ascii	[nopad]ascii7_bin
---	---
name	big5_chinese_ci
none	
digits	[digit7]
minus_dot_digits	-<.<[digit7]
alnum	[digit7]<[letter7_ci]
ident	[digit7]<[letter7_ci]<_
ascii	NULL
---	---
name	big5_chinese_nopad_ci
none	[nopad]
digits	[nopad][digit7]
minus_dot_digits	[nopad]-<.<[digit7]
alnum	[nopad][digit7]<[letter7_ci]
ident	[nopad][digit7]<[letter7_ci]<_
ascii	NULL
---	---
SET @character_set_name=NULL;
# End of 11.8 tests
