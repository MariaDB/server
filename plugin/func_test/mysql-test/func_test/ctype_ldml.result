name	utf8mb4_test_520_nopad_ci
digits	[nopad][digit7]
minus_dot_digits	[nopad][version 5.2.0]-<.<[digit7]
alnum	[nopad][digit7]<[letter7_ci]
ident	[nopad]_<[digit7]<[letter7_ci]
ascii	[nopad][version 5.2.0]ascii7_uca_ci
