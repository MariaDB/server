name	utf8mb4_uca1400_test01_as_ci
digits	[digit7]
minus_dot_digits	[version 14.0.0]-<.<[digit7]
alnum	[digit7]<[letter7_ci]
ident	_<[digit7]<[letter7_ci]
ascii	[version 14.0.0]ascii7_uca_ci
---	---
#
# latin1_space_after_letters_ci is a PAD collation where the space
# sorts after the letters, so "ab" is greater than "abc". It must not
# have a tailoring on ALNUM and IDENT, otherwise it would be considered
# compatible with collations where the space sorts before the letters.
#
SELECT 'ab' COLLATE latin1_swedish_ci < 'abc' AS swedish,
'ab' COLLATE latin1_space_after_letters_ci < 'abc' AS space_after;
swedish	space_after
1	0
# End of 11.8 tests
