digits	[digit7]
minus_dot_digits	[version 4.0.0]-<.<[digit7]
alnum	[digit7]<[letter7_ci]
ident	_<[digit7]<[letter7_ci]
ascii	[version 4.0.0]ascii7_uca_ci
---	---
name	utf16_test_ci
digits	[digit7]
minus_dot_digits	[version 4.0.0]-<.<[digit7]
alnum	NULL
ident	NULL
ascii	NULL
