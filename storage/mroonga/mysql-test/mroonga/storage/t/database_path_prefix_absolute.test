--source include/not_embedded.inc
--source ../../include/mroonga/have_mroonga.inc

--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
eval SET GLOBAL mroonga_database_path_prefix =
  "$MYSQL_TMP_DIR/mroonga.data/sub/";
CREATE DATABASE clean_test;
USE clean_test;

CREATE TABLE counts (
  id INT PRIMARY KEY AUTO_INCREMENT
);

--file_exists $MYSQL_TMP_DIR/mroonga.data/sub/clean_test.mrn

DROP TABLE counts;
DROP DATABASE clean_test;
SET GLOBAL mroonga_database_path_prefix = NULL;

USE test;

--rmdir $MYSQL_TMP_DIR/mroonga.data/sub
--rmdir $MYSQL_TMP_DIR/mroonga.data

--source ../../include/mroonga/have_mroonga_deinit.inc
