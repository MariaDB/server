--echo #
--echo # MDEV-41193: ASAN heap-buffer-overflow in ha_connect::CheckCond after select from Connect table
--echo #

--source include/not_embedded.inc

CREATE TABLE t1 ( id INT, val varchar(500)) engine=myisam;
INSERT INTO t1 VALUES (1,'hello'),(2,'world');

# Shrink the CONNECT work area (Sarea) to the minimum allowed size so the
# unbounded write in CheckCond() reaches past the actual malloc'd buffer
# instead of merely wasting slack inside the (much larger) default 64MB area.
SET SESSION connect_work_size = 4194304;   # 4MB, SZWMIN in ha_connect.cc
SET SESSION connect_xtrace = 'QUERY';

# CONNECT external table (type=MYSQL) wrapping the local/self table.
# connect_cond_push is ON by default, so a SELECT with WHERE will invoke
# ha_connect::cond_push() -> CheckCond(). CONNECTION can simply point back
# at this same instance, no real remote server is needed.
--replace_result $MASTER_MYPORT MASTER_MYPORT
eval CREATE TABLE t2 ( id INT, val varchar(500)
) ENGINE=CONNECT table_type=MYSQL
  CONNECTION='mysql://root@127.0.0.1:$MASTER_MYPORT/test/t1';

# WHERE val = '<4.3MB string>' forces CheckCond() to append the
# entire constant (byte-escaped) into filp->Body, which now lives inside the
# 4MB Sarea, overflowing it.
--disable_ps_protocol
SELECT COUNT(*) FROM t2 WHERE val = REPEAT('A', 4300000);
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=Query=SELECT `val` FROM `t1`
--source include/search_pattern_in_file.inc

# WHERE val = '<4.3MB string> AND id = 1 should pass WHERE id = 1 in the filter
# and skip the long string.
SELECT COUNT(*) FROM t2 WHERE val = REPEAT('A', 4300000) AND id = 1;
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=Query=SELECT `id`, `val` FROM `t1` WHERE \(`id`= 1\)
--source include/search_pattern_in_file.inc

SELECT COUNT(*) FROM t2 WHERE id = 1 AND val = REPEAT('A', 4300000);
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=Query=SELECT `id`, `val` FROM `t1` WHERE \(`id`= 1\)
--source include/search_pattern_in_file.inc
--enable_ps_protocol

DROP TABLE t2, t1;

--echo # End of 10.11 tests
