#
# MDEV-41193: ASAN heap-buffer-overflow in ha_connect::CheckCond after select from Connect table
#
CREATE TABLE t1 ( id INT, val varchar(500)) engine=myisam;
INSERT INTO t1 VALUES (1,'hello'),(2,'world');
SET SESSION connect_work_size = 4194304;
SET SESSION connect_xtrace = 'QUERY';
CREATE TABLE t2 ( id INT, val varchar(500)
) ENGINE=CONNECT table_type=MYSQL
CONNECTION='mysql://root@127.0.0.1:MASTER_MYPORT/test/t1';
SELECT COUNT(*) FROM t2 WHERE val = REPEAT('A', 4300000);
COUNT(*)
0
FOUND 1 /Query=SELECT `val` FROM `t1`/ in mysqld.1.err
SELECT COUNT(*) FROM t2 WHERE val = REPEAT('A', 4300000) AND id = 1;
COUNT(*)
0
FOUND 1 /Query=SELECT `id`, `val` FROM `t1` WHERE \(`id`= 1\)/ in mysqld.1.err
SELECT COUNT(*) FROM t2 WHERE id = 1 AND val = REPEAT('A', 4300000);
COUNT(*)
0
FOUND 2 /Query=SELECT `id`, `val` FROM `t1` WHERE \(`id`= 1\)/ in mysqld.1.err
DROP TABLE t2, t1;
# End of 10.11 tests
