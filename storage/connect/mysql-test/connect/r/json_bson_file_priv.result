#
# Test FILE privilege and secure_file_priv enforcement for JSON/BSON file UDFs
#
# Privileged user: path inside secure_file_priv MYSQL_TMP_DIR
select json_file('MYSQL_TMP_DIR/bib0.json', 0) IS NOT NULL AS ok;
ok
1
select bson_file('MYSQL_TMP_DIR/biblio.json', 0) IS NOT NULL AS ok;
ok
1
Warnings:
Warning	1105	File pretty format doesn't match the specified pretty value
select jfile_make('{"test":1}', 'MYSQL_TMP_DIR/out.json', 0) IS NOT NULL AS ok;
ok
1
select bfile_make('{"test":1}', 'MYSQL_TMP_DIR/out.json', 0) IS NOT NULL AS ok;
ok
1
select jbin_file('MYSQL_TMP_DIR/bib0.json') IS NOT NULL AS ok;
ok
1
select bbin_file('MYSQL_TMP_DIR/biblio.json') IS NOT NULL AS ok;
ok
1
select jfile_bjson('MYSQL_TMP_DIR/bib0.json', 'MYSQL_TMP_DIR/out.json', 0) IS NOT NULL AS ok;
ok
1
select jfile_convert('MYSQL_TMP_DIR/biblio.json', 'MYSQL_TMP_DIR/out.json', 1024) IS NOT NULL AS ok;
ok
1
select bfile_bjson('MYSQL_TMP_DIR/bib0.json', 'MYSQL_TMP_DIR/out.json', 0) IS NOT NULL AS ok;
ok
1
select bfile_convert('MYSQL_TMP_DIR/biblio.json', 'MYSQL_TMP_DIR/out.json', 1024) IS NOT NULL AS ok;
ok
1
select jsonget_string('MYSQL_TMP_DIR/secret.json' as jfile_x, '$[0]');
jsonget_string('MYSQL_TMP_DIR/secret.json' as jfile_x, '$[0]')
secret
select bsonget_string('MYSQL_TMP_DIR/secret.json' as bfile_x, '$[0]');
bsonget_string('MYSQL_TMP_DIR/secret.json' as bfile_x, '$[0]')
secret
select bson_array_add('MYSQL_TMP_DIR/secret.json', 1);
bson_array_add('MYSQL_TMP_DIR/secret.json', 1)
["secret",1]
select jfile_make('MYSQL_TMP_DIR/secret.json', 'MYSQL_TMP_DIR/out.json');
jfile_make('MYSQL_TMP_DIR/secret.json', 'MYSQL_TMP_DIR/out.json')
MYSQL_TMP_DIR/out.json
[
	"secret"
]
select bson_test('["test"]', 'MYSQL_TMP_DIR/out.json');
bson_test('["test"]', 'MYSQL_TMP_DIR/out.json')
Ok
[
	"test"
]
