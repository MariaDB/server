CREATE TABLE t1 (c1 INT KEY) ENGINE=DuckDB;
INSERT INTO t1 VALUES (2);
SELECT c1^64 FROM t1;
c1^64
66
SELECT c1 ^ 64 FROM t1;
c1 ^ 64
66
SELECT 2^64 FROM t1;
2^64
66
DROP TABLE t1;
CREATE TABLE t_innodb (c1 INT KEY) ENGINE=InnoDB;
CREATE TABLE t_duckdb (c1 INT KEY) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (2), (17), (-1);
INSERT INTO t_duckdb VALUES (2), (17), (-1);
SELECT c1, c1^64, c1^5 FROM t_innodb ORDER BY c1;
c1	c1^64	c1^5
-1	18446744073709551551	18446744073709551610
2	66	7
17	81	20
SELECT c1, c1^64, c1^5 FROM t_duckdb ORDER BY c1;
c1	c1^64	c1^5
