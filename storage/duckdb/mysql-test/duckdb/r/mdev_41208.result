CREATE TABLE t1 (c1 INT PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO t1 VALUES (1);
SELECT COALESCE(1,'t') FROM t1;
COALESCE(1,'t')
1
SELECT COALESCE(c1,'t') FROM t1;
COALESCE(c1,'t')
1
SELECT IFNULL(1,'t') FROM t1;
IFNULL(1,'t')
1
SET NAMES BINARY;
SELECT COALESCE(1,'t') FROM t1;
COALESCE(1,'t')
1
SELECT COALESCE(c1,'t') FROM t1;
COALESCE(c1,'t')
1
SELECT IFNULL(1,'t') FROM t1;
IFNULL(1,'t')
1
SET NAMES utf8mb4;
CREATE TABLE t2 (c1 VARCHAR(10) CHARACTER SET utf8mb4 PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO t2 VALUES ('ab');
SELECT c1 FROM t2;
c1
ab
SELECT COALESCE(c1, 'z') FROM t2;
COALESCE(c1, 'z')
ab
DROP TABLE t1, t2;
