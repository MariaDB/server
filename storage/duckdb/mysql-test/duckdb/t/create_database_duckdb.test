--source ../include/have_duckdb.inc

CREATE DATABASE IF NOT EXISTS duckdb CHARACTER SET utf8mb4;
USE duckdb;

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  name VARCHAR(32)
) engine=duckdb;

INSERT INTO t1 VALUES (1, 'one');
SELECT * FROM t1;
DROP TABLE t1;

--source ../include/cleanup_duckdb.inc
DROP DATABASE duckdb;
