--source ../include/have_duckdb.inc
--source include/master-slave.inc

--connection master
CREATE DATABASE rpl_dml CHARACTER SET utf8mb4;
USE rpl_dml;
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  v VARCHAR(16),
  untouched VARCHAR(16)
) ENGINE=DuckDB;
INSERT INTO t1 VALUES
  (1, 'one', 'keep-1'),
  (2, 'two', 'keep-2'),
  (3, 'three', 'keep-3');

--sync_slave_with_master
USE rpl_dml;
SELECT * FROM t1 ORDER BY id;

--connection master
UPDATE t1 SET v = 'TWO' WHERE v = 'two';
UPDATE t1 SET id = 30, v = 'moved' WHERE v = 'three';

--sync_slave_with_master
SELECT * FROM t1 ORDER BY id;

--connection master
DELETE FROM t1 WHERE v = 'one';

--sync_slave_with_master
SELECT * FROM t1 ORDER BY id;

--connection master
DELETE FROM t1;

--sync_slave_with_master
SELECT COUNT(*) FROM t1;

--connection master
DROP DATABASE rpl_dml;

--sync_slave_with_master

--source include/rpl_end.inc
