for master_1
for child2
for child3
set spider_same_server_link= 1;
set global spider_same_server_link= 1;
CREATE SERVER srv FOREIGN DATA WRAPPER mysql
OPTIONS (SOCKET "$MASTER_1_MYSOCK", DATABASE 'test', user 'root');
#
# MDEV-10526: Spider pushdown for binary bitwise aggregate functions
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
val_int BIGINT UNSIGNED,
val_bin VARBINARY(4)
) ENGINE=InnoDB;
CREATE TABLE t1_s (
id INT PRIMARY KEY,
val_int BIGINT UNSIGNED,
val_bin VARBINARY(4)
) ENGINE=SPIDER REMOTE_SERVER='srv' REMOTE_TABLE='t1';
INSERT INTO t1 VALUES
(1, 0xF000000000000000, x'F0000000'),
(2, 0x0F00000000000000, x'0F0F0F0F'),
(3, 0x00FF000000000000, x'00FF0000'),
(4, 0x0000FF0000000000, x'0000FF00'),
(5, 0x000000FF000000FF, x'000000FF'),
(6, NULL, NULL);
# Binary mode, pushed down
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	0
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin))
FROM t1_s;
HEX(BIT_OR(val_bin))	HEX(BIT_AND(val_bin))	HEX(BIT_XOR(val_bin))
FFFFFFFF	00000000	FFF0F0F0
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	3
# Integer mode, pushed down
SELECT BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int) FROM t1_s;
BIT_OR(val_int)	BIT_AND(val_int)	BIT_XOR(val_int)
18446744069414584575	0	18446744069414584575
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	6
# Without pushdown the results must be the same
SET spider_direct_aggregate= 0;
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin))
FROM t1_s;
HEX(BIT_OR(val_bin))	HEX(BIT_AND(val_bin))	HEX(BIT_XOR(val_bin))
FFFFFFFF	00000000	FFF0F0F0
SELECT BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int) FROM t1_s;
BIT_OR(val_int)	BIT_AND(val_int)	BIT_XOR(val_int)
18446744069414584575	0	18446744069414584575
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	6
SET spider_direct_aggregate= DEFAULT;
# Aggregates with FILTER (MDEV-24943) are not pushed down
SELECT HEX(BIT_OR(val_bin) FILTER (WHERE id < 3)),
HEX(BIT_AND(val_bin) FILTER (WHERE id > 1)),
BIT_XOR(val_int) FILTER (WHERE id IN (2, 5))
FROM t1_s;
HEX(BIT_OR(val_bin) FILTER (WHERE id < 3))	HEX(BIT_AND(val_bin) FILTER (WHERE id > 1))	BIT_XOR(val_int) FILTER (WHERE id IN (2, 5))
FF0F0F0F	00000000	1080865005785579775
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	6
# GROUP BY - reset_field()/update_field() with direct_add()
CREATE TABLE t2 (
id INT PRIMARY KEY,
grp INT,
val_bin VARBINARY(4),
val_int BIGINT UNSIGNED
) ENGINE=InnoDB;
CREATE TABLE t2_s (
id INT PRIMARY KEY,
grp INT,
val_bin VARBINARY(4),
val_int BIGINT UNSIGNED
) ENGINE=SPIDER REMOTE_SERVER='srv' REMOTE_TABLE='t2';
INSERT INTO t2 VALUES
(1, 1, x'FF000000', 0xFF00000000000000),
(2, 1, x'0F0F0F0F', 0x0F0F0F0F00000000),
(3, 2, x'00FF0000', 0x00FF000000000000),
(4, 2, x'000000FF', 0x000000FF00000000);
# The prepared statement protocol changes Spider_direct_aggregate
SELECT grp,
HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin)),
BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int)
FROM t2_s GROUP BY grp;
grp	HEX(BIT_OR(val_bin))	HEX(BIT_AND(val_bin))	HEX(BIT_XOR(val_bin))	BIT_OR(val_int)	BIT_AND(val_int)	BIT_XOR(val_int)
1	FF0F0F0F	0F000000	F00F0F0F	18378925161421209600	1080863910568919040	17298061250852290560
2	00FF00FF	00000000	00FF00FF	71777214277877760	0	71777214277877760
DROP TABLE t2_s, t2;
# Partial results from several data nodes are merged locally.
# The data node without matching rows returns the neutral value.
CREATE TABLE t3_1 (id INT PRIMARY KEY, val_bin VARBINARY(4)) ENGINE=InnoDB;
CREATE TABLE t3_2 (id INT PRIMARY KEY, val_bin VARBINARY(4)) ENGINE=InnoDB;
CREATE TABLE t3_s (id INT PRIMARY KEY, val_bin VARBINARY(4)) ENGINE=SPIDER
PARTITION BY RANGE (id) (
PARTITION p1 VALUES LESS THAN (10) REMOTE_SERVER="srv" REMOTE_TABLE="t3_1",
PARTITION p2 VALUES LESS THAN MAXVALUE REMOTE_SERVER="srv" REMOTE_TABLE="t3_2");
INSERT INTO t3_s VALUES (1, x'FF00'), (2, x'0FF0'), (11, x'00FF'), (12, x'F00F');
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	18
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin))
FROM t3_s;
HEX(BIT_OR(val_bin))	HEX(BIT_AND(val_bin))	HEX(BIT_XOR(val_bin))
FFFF	0000	0000
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin))
FROM t3_s WHERE val_bin IN (x'FF00', x'0FF0');
HEX(BIT_OR(val_bin))	HEX(BIT_AND(val_bin))	HEX(BIT_XOR(val_bin))
FFF0	0F00	F0F0
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	30
DROP TABLE t3_s, t3_1, t3_2;
# GROUP BY: the partial results of a group come from several data nodes
# (update_field() with direct_add()). The values are shorter than the
# declared length.
CREATE TABLE t4_1 (id INT PRIMARY KEY, grp INT, val_bin VARBINARY(4),
val_int BIGINT UNSIGNED) ENGINE=InnoDB;
CREATE TABLE t4_2 LIKE t4_1;
CREATE TABLE t4_s (id INT PRIMARY KEY, grp INT, val_bin VARBINARY(4),
val_int BIGINT UNSIGNED) ENGINE=SPIDER
PARTITION BY RANGE (id) (
PARTITION p1 VALUES LESS THAN (10) REMOTE_SERVER="srv" REMOTE_TABLE="t4_1",
PARTITION p2 VALUES LESS THAN MAXVALUE REMOTE_SERVER="srv" REMOTE_TABLE="t4_2");
INSERT INTO t4_s VALUES
(1, 1, x'FF00', 0xFF00000000000000), (2, 2, x'0FF0', 0x0FF0), (3, 3, NULL, NULL),
(4, 4, x'1234', 0x1234), (5, 5, NULL, NULL),
(11, 1, x'0FFF', 0x8FFF000000000000), (12, 2, x'F00F', 0xF00F),
(13, 3, x'5678', 0x5678), (14, 4, NULL, NULL), (15, 5, NULL, NULL),
(16, 6, x'ABCD', 0xABCD);
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	30
SELECT grp,
HEX(BIT_OR(val_bin)) AS o, HEX(BIT_AND(val_bin)) AS a,
HEX(BIT_XOR(val_bin)) AS x,
HEX(BIT_OR(val_int)) AS io, HEX(BIT_AND(val_int)) AS ia,
HEX(BIT_XOR(val_int)) AS ix
FROM t4_s GROUP BY grp;
grp	o	a	x	io	ia	ix
1	FFFF	0F00	F0FF	FFFF000000000000	8F00000000000000	70FF000000000000
2	FFFF	0000	FFFF	FFFF	0	FFFF
3	5678	5678	5678	5678	5678	5678
4	1234	1234	1234	1234	1234	1234
5	00000000	FFFFFFFF	00000000	0	FFFFFFFFFFFFFFFF	0
6	ABCD	ABCD	ABCD	ABCD	ABCD	ABCD
SHOW STATUS LIKE 'Spider_direct_aggregate';
Variable_name	Value
Spider_direct_aggregate	96
# Without pushdown the results must be the same
SET spider_direct_aggregate= 0;
SELECT grp,
HEX(BIT_OR(val_bin)) AS o, HEX(BIT_AND(val_bin)) AS a,
HEX(BIT_XOR(val_bin)) AS x,
HEX(BIT_OR(val_int)) AS io, HEX(BIT_AND(val_int)) AS ia,
HEX(BIT_XOR(val_int)) AS ix
FROM t4_s GROUP BY grp;
grp	o	a	x	io	ia	ix
1	FFFF	0F00	F0FF	FFFF000000000000	8F00000000000000	70FF000000000000
2	FFFF	0000	FFFF	FFFF	0	FFFF
3	5678	5678	5678	5678	5678	5678
4	1234	1234	1234	1234	1234	1234
5	00000000	FFFFFFFF	00000000	0	FFFFFFFFFFFFFFFF	0
6	ABCD	ABCD	ABCD	ABCD	ABCD	ABCD
SET spider_direct_aggregate= DEFAULT;
# A data node without rows returns the neutral value of the declared
# length, which is longer than the values of the other data node
# The first data node is empty
DELETE FROM t4_1;
SELECT HEX(BIT_OR(val_bin)) AS o, HEX(BIT_AND(val_bin)) AS a,
HEX(BIT_XOR(val_bin)) AS x,
HEX(BIT_OR(val_int)) AS io, HEX(BIT_AND(val_int)) AS ia,
HEX(BIT_XOR(val_int)) AS ix
FROM t4_s;
o	a	x	io	ia	ix
FFFF	0008	0245	8FFF00000000FFFF	0	8FFF000000000DBA
# The second data node is empty
INSERT INTO t4_1 SELECT id - 10, grp, val_bin, val_int FROM t4_2;
DELETE FROM t4_2;
SELECT HEX(BIT_OR(val_bin)) AS o, HEX(BIT_AND(val_bin)) AS a,
HEX(BIT_XOR(val_bin)) AS x,
HEX(BIT_OR(val_int)) AS io, HEX(BIT_AND(val_int)) AS ia,
HEX(BIT_XOR(val_int)) AS ix
FROM t4_s;
o	a	x	io	ia	ix
FFFF	0008	0245	8FFF00000000FFFF	0	8FFF000000000DBA
# Both data nodes are empty
DELETE FROM t4_1;
SELECT HEX(BIT_OR(val_bin)) AS o, HEX(BIT_AND(val_bin)) AS a,
HEX(BIT_XOR(val_bin)) AS x,
HEX(BIT_OR(val_int)) AS io, HEX(BIT_AND(val_int)) AS ia,
HEX(BIT_XOR(val_int)) AS ix
FROM t4_s;
o	a	x	io	ia	ix
00000000	FFFFFFFF	00000000	0	FFFFFFFFFFFFFFFF	0
DROP TABLE t4_s, t4_1, t4_2;
# A data node returns a partial result that is not an integer
CREATE TABLE t5 (id INT PRIMARY KEY, val VARBINARY(4)) ENGINE=InnoDB;
CREATE TABLE t5_s (id INT PRIMARY KEY, val BIGINT UNSIGNED) ENGINE=SPIDER
REMOTE_SERVER='srv' REMOTE_TABLE='t5';
INSERT INTO t5 VALUES (1, 'abcd'), (2, 'abcd');
# The group by handler would push the whole query down
SET spider_disable_group_by_handler= 1;
SELECT BIT_OR(val) FROM t5_s;
ERROR HY000: Got error 12500 'unknown' from SPIDER
SHOW WARNINGS LIMIT 2;
Level	Code	Message
Warning	1292	Truncated incorrect INTEGER value: 'abcd'
Error	1296	Got error 12500 'unknown' from SPIDER
DROP TABLE t5_s, t5;
# A data node returns a partial result longer than the declared length
CREATE TABLE t5 (id INT PRIMARY KEY, val VARBINARY(8)) ENGINE=InnoDB;
CREATE TABLE t5_s (id INT PRIMARY KEY, val VARBINARY(4)) ENGINE=SPIDER
REMOTE_SERVER='srv' REMOTE_TABLE='t5';
INSERT INTO t5 VALUES (1, 'abcdefgh'), (2, 'abcdefgh');
SELECT BIT_OR(val) FROM t5_s;
ERROR HY000: Got error 12500 'unknown' from SPIDER
SHOW WARNINGS LIMIT 2;
Level	Code	Message
Warning	1292	Truncated incorrect BINARY value: 'abcdefgh'
Error	1296	Got error 12500 'unknown' from SPIDER
SET spider_disable_group_by_handler= DEFAULT;
DROP TABLE t5_s, t5;
DROP TABLE t1_s, t1;
DROP SERVER srv;
for master_1
for child2
for child3
#
# End of 13.2 tests
#
