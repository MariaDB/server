--disable_query_log
--disable_result_log
--source ../../t/test_init.inc
--enable_result_log
--enable_query_log
--source include/have_innodb.inc

set spider_same_server_link= 1;
set global spider_same_server_link= 1;
evalp CREATE SERVER srv FOREIGN DATA WRAPPER mysql
OPTIONS (SOCKET "$MASTER_1_MYSOCK", DATABASE 'test', user 'root');

--echo #
--echo # MDEV-10526: Spider pushdown for binary bitwise aggregate functions
--echo #

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val_int BIGINT UNSIGNED,
  val_bin VARBINARY(4)
) ENGINE=InnoDB;

CREATE TABLE t1_s (
  id INT PRIMARY KEY,
  val_int BIGINT UNSIGNED,
  val_bin VARBINARY(4)
) ENGINE=SPIDER REMOTE_SERVER='srv' REMOTE_TABLE='t1';

INSERT INTO t1 VALUES
  (1, 0xF000000000000000, x'F0000000'),
  (2, 0x0F00000000000000, x'0F0F0F0F'),
  (3, 0x00FF000000000000, x'00FF0000'),
  (4, 0x0000FF0000000000, x'0000FF00'),
  (5, 0x000000FF000000FF, x'000000FF');

--echo # Binary mode
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin)) FROM t1_s;

--echo # Integer mode
SELECT BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int) FROM t1_s;

--echo # NULL handling - BIT_AND/OR/XOR must skip NULL rows
INSERT INTO t1 VALUES (6, NULL, NULL);
SELECT HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin)) FROM t1_s;
SELECT BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int) FROM t1_s;

--echo # Note: the ER_TRUNCATED_WRONG_VALUE warning path in
--echo # spd_db_conn.cc fires when a remote Spider node returns
--echo # non-numeric data for an integer aggregate. This is a
--echo # defensive path that cannot be triggered via normal SQL
--echo # since Spider always returns valid numeric strings for
--echo # BIT_AND/OR/XOR results. It is covered by the no_direct_agg
--echo # combination which exercises the local non-pushdown path.

--echo # GROUP BY - triggers reset_field/update_field direct paths
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  grp INT,
  val_bin VARBINARY(4),
  val_int BIGINT UNSIGNED
) ENGINE=InnoDB;

CREATE TABLE t2_s (
  id INT PRIMARY KEY,
  grp INT,
  val_bin VARBINARY(4),
  val_int BIGINT UNSIGNED
) ENGINE=SPIDER REMOTE_SERVER='srv' REMOTE_TABLE='t2';

INSERT INTO t2 VALUES
  (1, 1, x'FF000000', 0xFF00000000000000),
  (2, 1, x'0F0F0F0F', 0x0F0F0F0F00000000),
  (3, 2, x'00FF0000', 0x00FF000000000000),
  (4, 2, x'000000FF', 0x000000FF00000000);

SELECT grp,
  HEX(BIT_OR(val_bin)), HEX(BIT_AND(val_bin)), HEX(BIT_XOR(val_bin)),
  BIT_OR(val_int), BIT_AND(val_int), BIT_XOR(val_int)
FROM t2_s GROUP BY grp;

DROP TABLE t2_s, t2;

DROP TABLE t1_s, t1;
DROP SERVER srv;

--disable_query_log
--disable_result_log
--source ../../t/test_deinit.inc
--enable_result_log
--enable_query_log

--echo # End of 13.1 tests
