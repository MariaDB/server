--disable_query_log
--disable_result_log
--source ../../t/test_init.inc
--enable_result_log
--enable_query_log
--source include/have_innodb.inc
--source include/have_debug.inc

set spider_same_server_link= 1;
set global spider_same_server_link= 1;
evalp CREATE SERVER srv FOREIGN DATA WRAPPER mysql
OPTIONS (SOCKET "$MASTER_1_MYSOCK", DATABASE 'test', user 'root');

--echo #
--echo # MDEV-10526: Spider pushdown for binary bitwise aggregate functions
--echo #

--echo # The group by handler would push the whole query down
SET spider_disable_group_by_handler= 1;

CREATE TABLE t1 (id INT PRIMARY KEY, val_int BIGINT UNSIGNED,
                 val_bin VARBINARY(4)) ENGINE=InnoDB;
CREATE TABLE t1_s (id INT PRIMARY KEY, val_int BIGINT UNSIGNED,
                   val_bin VARBINARY(4)) ENGINE=SPIDER
REMOTE_SERVER='srv' REMOTE_TABLE='t1';
INSERT INTO t1 VALUES (1, 1, x'FF00'), (2, 2, x'00FF');

--disable_ps2_protocol
--echo # A data node returns NULL as a partial result
--error ER_GET_ERRMSG
SET STATEMENT debug_dbug= '+d,spider_direct_bit_null' FOR
SELECT BIT_OR(val_bin) FROM t1_s;
--error ER_GET_ERRMSG
SET STATEMENT debug_dbug= '+d,spider_direct_bit_null' FOR
SELECT BIT_OR(val_int) FROM t1_s;
SHOW WARNINGS;
SELECT HEX(BIT_OR(val_bin)), BIT_OR(val_int) FROM t1_s;
--enable_ps2_protocol
DROP TABLE t1_s, t1;

SET spider_disable_group_by_handler= DEFAULT;
DROP SERVER srv;

--disable_query_log
--disable_result_log
--source ../../t/test_deinit.inc
--enable_result_log
--enable_query_log

--echo #
--echo # End of 13.2 tests
--echo #
