--disable_query_log
--disable_result_log
--source ../../t/test_init.inc
--enable_result_log
--enable_query_log

set spider_same_server_link= on;
set global spider_same_server_link= on;
evalp CREATE SERVER srv FOREIGN DATA WRAPPER mysql
OPTIONS (SOCKET "$MASTER_1_MYSOCK", DATABASE 'test',user 'root');

create table t1 (a int primary key, b int);
insert into t1 values (1,1),(2,2);
create table t2 (a int primary key, b int) engine=Spider
comment='wrapper "mysql", srv "srv", table "t1"';

update t2 set b=b+10 where a=1 returning b;

drop table t1, t2;
drop server srv;

--disable_query_log
--disable_result_log
--source ../../t/test_deinit.inc
--enable_result_log
--enable_query_log
