#
# MDEV-29676 Dual thread hang in 'closing tables' and 'Waiting for table metadata lock' on Spider CREATE OR REPLACE TABLE
#
for master_1
for child2
for child3
CREATE SERVER srv FOREIGN DATA WRAPPER MYSQL OPTIONS (SOCKET "$MASTER_1_MYSOCK", DATABASE 'test',user 'root');

# length-0 self-reference

CREATE TABLE t (c INT) ENGINE=Spider WRAPPER=mysql, remote_server=srv, remote_table=t;
CREATE OR REPLACE TABLE t (c INT);
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `c` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
DROP TABLE t;

# length-2 self-reference

CREATE TABLE t2 (c int);
CREATE TABLE t1 (c int) ENGINE=Spider WRAPPER=mysql, remote_server="srv",remote_table="t2";
CREATE TABLE t0 (c int) ENGINE=Spider WRAPPER=mysql, remote_server=srv,remote_table="t1";
ALTER TABLE t2 ENGINE=Spider WRAPPER=mysql, remote_server=srv,remote_table="t0";
CREATE OR REPLACE TABLE t0 (c int);
SHOW CREATE TABLE t0;
Table	Create Table
t0	CREATE TABLE `t0` (
  `c` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
CREATE OR REPLACE TABLE t1 (c int);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c` int(11) DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
drop TABLE t0, t1, t2;
