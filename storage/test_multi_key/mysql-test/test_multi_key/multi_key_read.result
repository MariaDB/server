# UPDATE and DELETE with a correlated scalar subquery: the subquery keeps its
# join and join cache, one call per tally row. With an IN subquery that becomes
# a semi-join, the statement runs as a multi-table one, without join caches
# (prepares 0).
REPLACE INTO tally VALUES (3, 0, NULL), (7, 300, NULL), (11, 450, NULL);
